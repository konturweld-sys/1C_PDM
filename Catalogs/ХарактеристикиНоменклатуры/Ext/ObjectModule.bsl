
Процедура ПередЗаписью(Отказ)

	Если НЕ ОбменДанными.Загрузка
	   И Владелец.ИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать Тогда
		Сообщить(
		НСтр("ru = 'Для номенклатуры ""'; en_US = 'There is not accounting by characteristics for ""'") + Владелец + НСтр("ru = '"" не ведется учет по характеристикам.'; en_US = '"" nomenclature.'")+Символы.ПС+
		НСтр("ru = 'Характеристика ""'; en_US = 'The ""'") + Наименование + НСтр("ru = '"" не может быть записана.'; en_US = '"" characteristic cannot be written.'"), СтатусСообщения.Внимание);

	КонецЕсли;

КонецПроцедуры

// Функция формирует наименование характеристики по значениям отдельных свойств
//
Функция СформироватьНаименование(КоллекцияЗначенийСвойств) Экспорт

	Строка = "";

	Для каждого ЭлементКоллекции Из КоллекцияЗначенийСвойств Цикл
		Если ЗначениеЗаполнено(ЭлементКоллекции.Значение) Тогда
			Строка = Строка + ЭлементКоллекции.Значение + ", ";
		КонецЕсли;
	КонецЦикла;

	Строка = Лев(Строка, СтрДлина(Строка) - 2);

	Если ПустаяСтрока(Строка) Тогда
		Строка = НСтр("ru = '<Свойства не назначены>'; en_US = '<Properties are not assigned>'");
	КонецЕсли;

	Возврат Строка;

КонецФункции
