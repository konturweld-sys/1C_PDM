

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	#Если ТолстыйКлиентОбычноеПриложение Тогда 
	Если aps_СтруктураПараметровОповещения.Свойство("itemXDTO") И aps_СтруктураПараметровОповещения.itemXDTO <> Неопределено Тогда 
		itemXDTO = aps_СтруктураПараметровОповещения.itemXDTO;
		
		Номенклатура = Обработки.aps_СозданиеПараметров.Создать().aps_ПолучитьЗначениеПараметраПоСвойствуВXDTO(itemXDTO, ПланыВидовХарактеристик.aps_Свойства.Номенклатура, Ложь);
		Если ЗначениеЗаполнено(Номенклатура) Тогда 
		// В свойствах динамического списка добавлен отбор по владельцу,
		// ему задано представление "ОтборПоВладельцу",
		// элемент отбора не доступен пользователю
		
		Для Каждого ТекущийОтбор Из Список.Отбор.Элементы Цикл
			Если ТекущийОтбор.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный 
			   И ТекущийОтбор.Представление = "ОтборПоВладельцу" Тогда

			   Если Номенклатура.ИспользованиеХарактеристик=Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.ИндивидуальныеДляНоменклатуры Тогда
				ТекущийОтбор.ПравоеЗначение = Номенклатура;
			   ИначеЕсли Номенклатура.ИспользованиеХарактеристик=Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.ОбщиеДляВидаНоменклатуры Тогда
			    ТекущийОтбор.ПравоеЗначение = Номенклатура.ВидНоменклатуры;
			   Иначе 
				 Предупреждение("Для номеклатуры "+Строка(Номенклатура)+" не ведется учет по характеристикам!");
				 Отказ=Истина;
				 Возврат;
			   КонецЕсли;
				ТекущийОтбор.Использование  = Истина;
			КонецЕсли;
		КонецЦикла;	
		КонецЕсли;
	КонецЕсли;
	#КонецЕсли
КонецПроцедуры

