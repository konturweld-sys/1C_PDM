
#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)
	Если ЭтоГруппа Тогда 
		Наименование = СокрЛП(Наименование);
	Иначе 
		ИмяФайла		= ?(ПустаяСтрока(Расширение), СокрЛП(ИмяФайла), СокрЛ(ИмяФайла));
		
		Наименование = ИмяФайла+Расширение;
		
		Подписан	= (Подписи.Количество() > 0);
		Зашифрован	= (СертификатыШифрования.Количество() > 0);
		
		Если ЭтоНовый() Тогда
			Дата = ТекущаяДата();
		КонецЕсли;
		
		//перезаписывать имя файла во внешнем хранилище
		Если Наименование <> Ссылка.Наименование И НЕ ЭтоНовый() Тогда
			Если Константы.aps_РежимХраненияФайлов.Получить() = 1 Тогда 
				aps_РаботаСФайламиСервер.aps_ПереименоватьФайлВХранилище(Ссылка, Наименование);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура ПередУдалением(Отказ)
	Если НЕ ЭтоГруппа И НЕ ДвоичныеДанные.Пустая() Тогда 
		// файлы, ссылающиеся на эти двоичные данные
		ФайлыДвоичныхДанных=aps_РаботаСФайламиСервер.aps_ПолучитьФайлыДвоичныхДанных(ДвоичныеДанные);
		Если ФайлыДвоичныхДанных.Количество()=1 И ФайлыДвоичныхДанных[0]=Ссылка Тогда 
			Попытка
				ДвоичныеДанные.ПолучитьОбъект().Удалить();
			Исключение
				Сообщить(ПараметрыСеанса.aps_ИмяПродукта+НСтр("ru = 'При удалении двоичных данных файла произошла ошибка:'; en_US = 'While deleting binary data of file an error occurred:'")+Символы.ПС+ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
		ИначеЕсли Константы.aps_РежимХраненияФайлов.Получить() = 1 Тогда
			// удалить один файл
			УдалитьИзКаталогаДвоичныхДанных = Истина;
			Для Каждого ФайлДвоичныхДанных Из ФайлыДвоичныхДанных Цикл 
				Если ФайлДвоичныхДанных.Ссылка <> ЭтотОбъект.Ссылка
						И ФайлДвоичныхДанных.ИмяФайла = ЭтотОбъект.ИмяФайла И ФайлДвоичныхДанных.Расширение = ЭтотОбъект.Расширение Тогда 
					// есть другой файл с таким же именем в каталоге двоичных данных
					УдалитьИзКаталогаДвоичныхДанных = Ложь; Прервать;
				КонецЕсли;
			КонецЦикла;
			Если УдалитьИзКаталогаДвоичныхДанных Тогда 	
				// удалить этот файл из каталога двоичных данных (если этот каталог еще существует)
				aps_РаботаСФайламиСервер.aps_УдалитьФайлВХранилище(Ссылка);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти


#Область ПрограммныйИнтерфейс

// Функция проверяет имя файла (папки) на наличие недопустимых символов
//
// Параметры:
//		СтрокаОшибки - возвращаемое сообщение об ошибке
//
// Возвращаемое значение:
//		Истина, если имя корректно, в противном случае Ложь
//
// Пример:
//		СтрокаОшибки = "";
//		ЭтоКорректноеИмя = Объект.ПроверитьИмя(СтрокаОшибки);
//
Функция ПроверитьИмя( СтрокаОшибки = "" ) Экспорт 
	Если ЭтоГруппа Тогда 
		Возврат ПроверитьИмяПапки(СтрокаОшибки);
	Иначе 
		Возврат ПроверитьИмяФайла(СтрокаОшибки);
	КонецЕсли;
КонецФункции

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

Функция ПроверитьИмяФайла( СтрокаОшибки = "" )
	Если ПустаяСтрока(ИмяФайла) Тогда
		СтрокаОшибки=НСтр("ru = 'Имя файла не должно быть пустым!'; en_US = 'Filename must be filled!'");
		Возврат Ложь;
	КонецЕсли;
	
	Наименование = ИмяФайла + Расширение;
	
	Если Найти(Наименование,"*")<>0 ИЛИ
			Найти(Наименование,"|")<>0 ИЛИ
			Найти(Наименование,"\")<>0 ИЛИ
			Найти(Наименование,":")<>0 ИЛИ
			Найти(Наименование,"<")<>0 ИЛИ
			Найти(Наименование,">")<>0 ИЛИ
			Найти(Наименование,"?")<>0 ИЛИ
			Найти(Наименование,"/")<>0 ИЛИ
			Найти(Наименование,"""")<>0 Тогда
		СтрокаОшибки=НСтр("ru = 'Имя файла не должно содержать следующих знаков:'; en_US = 'Filename must not contain the following symbols:'")+" / \ ? < > : "" | *";
		Возврат Ложь;
	КонецЕсли;
	
	Выборка=Справочники.aps_Файлы.Выбрать(Родитель, Владелец);
	Пока Выборка.Следующий() Цикл 
		Если Выборка.Ссылка=Ссылка Тогда 
			Продолжить;
		КонецЕсли;
		
		Если Наименование=Выборка.Наименование Тогда
			СтрокаОшибки=НСтр("ru = 'Файл с именем ""'; en_US = 'The <'")+Наименование+НСтр("ru = '"" уже существует!'; en_US = '> file already exists!'");
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;	
КонецФункции

Функция ПроверитьИмяПапки( СтрокаОшибки = "" )
	Если ПустаяСтрока(Наименование) Тогда
		СтрокаОшибки=НСтр("ru = 'Имя папки не должно быть пустым!'; en_US = 'Folder name must be filled!'");
		Возврат Ложь;
	КонецЕсли;
	
	Если Найти(Наименование,"*")<>0 ИЛИ
			Найти(Наименование,"|")<>0 ИЛИ
			Найти(Наименование,"\")<>0 ИЛИ
			Найти(Наименование,":")<>0 ИЛИ
			Найти(Наименование,"<")<>0 ИЛИ
			Найти(Наименование,">")<>0 ИЛИ
			Найти(Наименование,"?")<>0 ИЛИ
			Найти(Наименование,"/")<>0 ИЛИ
			Найти(Наименование,"""")<>0 Тогда
		СтрокаОшибки=НСтр("ru = 'Имя папки не должно содержать следующих знаков:'; en_US = 'Folder name must not contain the following symbols:'")+" / \ ? < > : "" | *";
		Возврат Ложь;
	КонецЕсли;
	
	Выборка=Справочники.aps_Файлы.Выбрать(Родитель, Владелец);
	Пока Выборка.Следующий() Цикл 
		Если Выборка.Ссылка=Ссылка Тогда 
			Продолжить;
		КонецЕсли;
		
		Если Наименование=Выборка.Наименование Тогда
			СтрокаОшибки=НСтр("ru = 'Папка с именем ""'; en_US = 'The <'")+Наименование+НСтр("ru = '"" уже существует!'; en_US = '> folder already exists!'");
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;	
КонецФункции

#КонецОбласти

