
#Область ОбработчикиСобытийФормы

#Если Не МобильноеПриложениеКлиент Тогда
	
&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	СтрокаПредупреждения = "";
	ПередЗаписьюСервер(Отказ, СтрокаПредупреждения);
	Если НЕ ПустаяСтрока(СтрокаПредупреждения) Тогда
		Предупреждение(СтрокаПредупреждения);
	КонецЕсли;
КонецПроцедуры

#КонецЕсли

#КонецОбласти


#Область ОбработчикиКомандФормы

#Если Не МобильноеПриложениеКлиент Тогда

&НаКлиенте
Процедура ПросмотрСертификата(Команда)
	ТекущаяСтрока = Элементы.Подписи.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Если НЕ aps_РаботаСФайлами.aps_ПодключитьРасширениеРаботыСФайлами() Или
			НЕ aps_РаботаСФайлами.aps_ПодключитьРасширениеРаботыСКриптографией() Тогда 
		Возврат;
	КонецЕсли;
	
	ПерсональныеНастройки = aps_РаботаСФайламиСервер.aps_ПерсональныеНастройки();
	Если ПустаяСтрока(ПерсональныеНастройки.РабочийКаталог) Тогда 
		Предупреждение(НСтр("ru = 'Необходимо указать рабочий каталог в персональных настройках!'; en_US = 'Working directory must be specified in personal settings!'"));
		Возврат;
	КонецЕсли;
	
	ПараметрыКриптографии = ПерсональныеНастройки.ПараметрыКриптографии;
	МенеджерКриптографии = aps_РаботаСФайлами.aps_ПолучитьМенеджерКриптографии(ПараметрыКриптографии);	
	Если МенеджерКриптографии = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	ПодписьДвоичныеДанные = ПолучитьИзВременногоХранилища(ТекущаяСтрока.АдресПодписи);
	СертификатыПодписей = МенеджерКриптографии.ПолучитьСертификатыИзПодписи(ПодписьДвоичныеДанные);
	Если СертификатыПодписей.Количество() > 0 Тогда 
		///////////////////////////////////////////
		// выгрузить сертификат в файл
		СертификатПодписи = СертификатыПодписей[0];
		ПредставлениеСертификата = aps_РаботаСФайлами.aps_ПредставлениеСертификата(СертификатПодписи);
		
		СисИнфо = Новый СистемнаяИнформация();
		КаталогПросмотраФайлов = aps_РаботаСФайлами.aps_ДобавитьПоследнийСлэш(ПерсональныеНастройки.РабочийКаталог)+"{"+Строка(СисИнфо.ИдентификаторКлиента)+"}"+"\";
		
		Попытка
			СоздатьКаталог(КаталогПросмотраФайлов);
		Исключение
			Предупреждение(НСтр("ru = 'Не удалось создать каталог ""'; en_US = 'Cannot create the ""'")+КаталогПросмотраФайлов+НСтр("ru = '"" по причине:'; en_US = '"" folder:'")+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Возврат;
		КонецПопытки;
		
		ИмяФайлаСертификата = КаталогПросмотраФайлов + ПредставлениеСертификата + ".cer";
		СертификатПодписи.Выгрузить(ИмяФайлаСертификата);
		aps_РаботаСФайлами.aps_ЗапуститьПриложение(ИмяФайлаСертификата);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПросмотрСертификатаШифрования(Команда)
	ТекущаяСтрока = Элементы.СертификатыШифрования.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Если НЕ aps_РаботаСФайлами.aps_ПодключитьРасширениеРаботыСФайлами() Или
			НЕ aps_РаботаСФайлами.aps_ПодключитьРасширениеРаботыСКриптографией() Тогда 
		Возврат;
	КонецЕсли;
	
	ПерсональныеНастройки = aps_РаботаСФайламиСервер.aps_ПерсональныеНастройки();
	Если ПустаяСтрока(ПерсональныеНастройки.РабочийКаталог) Тогда 
		Предупреждение(НСтр("ru = 'Необходимо указать рабочий каталог в персональных настройках!'; en_US = 'Working directory must be specified in personal settings!'"));
		Возврат;
	КонецЕсли;
	
	ДвоичныеДанныеСертификата = ПолучитьИзВременногоХранилища(ТекущаяСтрока.АдресСертификата);
	ПредставлениеСертификата  = ТекущаяСтрока.ПредставлениеСертификата;
	
	СертификатПолучателя = Новый СертификатКриптографии(ДвоичныеДанныеСертификата);
	///////////////////////////////////////////
	// выгрузить сертификат в файл
	СисИнфо = Новый СистемнаяИнформация();
	КаталогПросмотраФайлов = aps_РаботаСФайлами.aps_ДобавитьПоследнийСлэш(ПерсональныеНастройки.РабочийКаталог)+"{"+Строка(СисИнфо.ИдентификаторКлиента)+"}"+"\";
	
	Попытка
		СоздатьКаталог(КаталогПросмотраФайлов);
	Исключение
		Предупреждение(НСтр("ru = 'Не удалось создать каталог ""'; en_US = 'Cannot create the ""'")+КаталогПросмотраФайлов+НСтр("ru = '"" по причине:'; en_US = '"" folder:'")+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	
	ИмяФайлаСертификата = КаталогПросмотраФайлов + ПредставлениеСертификата + ".cer";
	СертификатПолучателя.Выгрузить(ИмяФайлаСертификата);
	aps_РаботаСФайлами.aps_ЗапуститьПриложение(ИмяФайлаСертификата);
КонецПроцедуры

&НаКлиенте
Процедура Подписать(Команда)
	Если НЕ aps_РаботаСФайлами.aps_ПодключитьРасширениеРаботыСКриптографией() Тогда 
		Возврат;
	КонецЕсли;
	
	ПерсональныеНастройки = aps_РаботаСФайламиСервер.aps_ПерсональныеНастройки();
	ПараметрыКриптографии = ПерсональныеНастройки.ПараметрыКриптографии;
	СертификатДляПодписиДвоичныеДанные = ПараметрыКриптографии.СертификатДляПодписи;
	Если СертификатДляПодписиДвоичныеДанные = Неопределено Тогда 
		Предупреждение(НСтр("ru = 'Необходимо указать сертификат электронной цифровой подписи в персональных настройках!'; en_US = 'Certificate of digital signature must be specified in personal settings!'"));
		Возврат;
	КонецЕсли;
	
	МенеджерКриптографии = aps_РаботаСФайлами.aps_ПолучитьМенеджерКриптографии(ПараметрыКриптографии);	
	Если МенеджерКриптографии = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	СертификатДляПодписи = Новый СертификатКриптографии(СертификатДляПодписиДвоичныеДанные);
	
	// проверяем, что этим сертификатом файл еще не подписан	
	Если aps_РаботаСФайлами.aps_ФайлУжеПодписан(МенеджерКриптографии, СертификатДляПодписи, Объект.Ссылка) Тогда 
		Предупреждение(НСтр("ru = 'Файл ""'; en_US = 'The ""'")+Объект.Ссылка+НСтр("ru = '"" уже подписан Вашим сертификатом!'; en_US = '"" file is already signed with your certificate!'"));
		Возврат;
	КонецЕсли;
	
	Попытка // формируем подпись и добавляем к файлу
		СтруктураДанныхФайла = Новый Структура("ДвоичныеДанные");
		aps_РаботаСФайламиСервер.aps_ПодготовитьСтруктуруДанныхФайлаПоСсылке(Объект.Ссылка, СтруктураДанныхФайла);
		
		СтруктураПодписи = aps_РаботаСФайлами.aps_СформироватьПодпись(МенеджерКриптографии, СертификатДляПодписи, СтруктураДанныхФайла.ДвоичныеДанные);
		aps_РаботаСФайламиСервер.aps_ДобавитьДанныеЭЦП(Объект.Ссылка, СтруктураПодписи);
	Исключение
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = aps_ПолныеПрава.aps_ПараметрСеанса("aps_ИмяПродукта")+НСтр("ru = 'Не удалось подписать файл по причине:'; en_US = 'Cannot sign the file:'")+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Сообщение.Сообщить();
		Возврат;
	КонецПопытки;
	
	ПоказатьОповещениеПользователя(НСтр("ru = 'Файл ""'; en_US = 'The ""'")+Объект.Ссылка+НСтр("ru = '"" подписан Вашим сертификатом.'; en_US = '"" is signed with your certificate.'"));
	
	КосвенноеИзменениеФайла();
КонецПроцедуры

&НаКлиенте
Процедура УдалитьПодпись(Команда)
	СтрокаПредупреждения = "";
	Если Не ВозможностьУдаленияПодписи(СтрокаПредупреждения) Тогда 
		Предупреждение(СтрокаПредупреждения);
		Возврат;
	КонецЕсли;
	
	УдаляемыеПодписи = Новый Массив;
	Для Каждого ИдентификаторСтроки Из Элементы.Подписи.ВыделенныеСтроки Цикл
		СтрокаПодписи = Подписи.НайтиПоИдентификатору(ИдентификаторСтроки);
		УдаляемыеПодписи.Добавить(Новый Структура("НомерСтроки", СтрокаПодписи.НомерСтроки));
	КонецЦикла;
	
	Если УдаляемыеПодписи.Количество() = 0 Или Вопрос(НСтр("ru = 'Удалить выделенные подписи?'; en_US = 'Delete the selected signstures?'"), РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;	
	
	Попытка
		aps_РаботаСФайламиСервер.aps_УдалитьДанныеЭЦП(Объект.Ссылка, УдаляемыеПодписи);
	Исключение
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = aps_ПолныеПрава.aps_ПараметрСеанса("aps_ИмяПродукта")+НСтр("ru = 'Не удалось удалить подписи по причине:'; en_US = 'Cannot delete signatures:'")+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Сообщение.Сообщить();
		Возврат;
	КонецПопытки;
	
	КосвенноеИзменениеФайла();
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьПодписи(Команда)
	Если НЕ aps_РаботаСФайлами.aps_ПодключитьРасширениеРаботыСФайлами() Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("ФайлСсылка", Объект.Ссылка);
	ОткрытьФорму("Обработка.aps_ФайлыДокумента.Форма.ФормаВыгружаемыхПодписей", ПараметрыФормы);
КонецПроцедуры

&НаКлиенте
Процедура Зашифровать(Команда)
	Если НЕ aps_РаботаСФайлами.aps_ПодключитьРасширениеРаботыСКриптографией() Тогда
		Возврат;
	КонецЕсли;
	
	ФормаВыбораСертификатов = ПолучитьФорму("Обработка.aps_ФайлыДокумента.Форма.ФормаВыбораСертификатов");
	СертификатыПолучателей = ФормаВыбораСертификатов.ОткрытьМодально();
	Если СертификатыПолучателей = Неопределено
			Или Вопрос(НСтр("ru = 'Вы уверены, что хотите зашифровать файл?'; en_US = 'Are you sure you want to encrypt the file?'"), РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ПерсональныеНастройки = aps_РаботаСФайламиСервер.aps_ПерсональныеНастройки();
	ПараметрыКриптографии = ПерсональныеНастройки.ПараметрыКриптографии;
	МенеджерКриптографии = aps_РаботаСФайлами.aps_ПолучитьМенеджерКриптографии(ПараметрыКриптографии);	
	Если МенеджерКриптографии = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	МассивСтруктурСертификатов = aps_РаботаСФайлами.aps_СформироватьМассивСтруктурСертификатов(СертификатыПолучателей);
	
	Попытка
		СтруктураДанныхФайла = Новый Структура("ДвоичныеДанные");
		aps_РаботаСФайламиСервер.aps_ПодготовитьСтруктуруДанныхФайлаПоСсылке(Объект.Ссылка, СтруктураДанныхФайла);

		ЗашифрованныеДвоичныеДанные = МенеджерКриптографии.Зашифровать(СтруктураДанныхФайла.ДвоичныеДанные, СертификатыПолучателей);
		aps_РаботаСФайламиСервер.aps_ИзменитьДанныеШифрования(Объект.Ссылка, ЗашифрованныеДвоичныеДанные, МассивСтруктурСертификатов);
	Исключение
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = aps_ПолныеПрава.aps_ПараметрСеанса("aps_ИмяПродукта")+НСтр("ru = 'Не удалось зашифровать файл по причине:'; en_US = 'Cannot encrypt the file:'")+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Сообщение.Сообщить();
		Возврат;
	КонецПопытки;
	
	ПоказатьОповещениеПользователя(НСтр("ru = 'Файл ""'; en_US = 'The ""'")+Объект.Ссылка+НСтр("ru = '"" зашифрован.'; en_US = '"" file is encrypted.'"));
	КосвенноеИзменениеФайла();
КонецПроцедуры

&НаКлиенте
Процедура Расшифровать(Команда)
	Если НЕ aps_РаботаСФайлами.aps_ПодключитьРасширениеРаботыСКриптографией() Тогда
		Возврат;
	КонецЕсли;
	
	ПерсональныеНастройки = aps_РаботаСФайламиСервер.aps_ПерсональныеНастройки();
	ПараметрыКриптографии = ПерсональныеНастройки.ПараметрыКриптографии;
	МенеджерКриптографии = aps_РаботаСФайлами.aps_ПолучитьМенеджерКриптографии(ПараметрыКриптографии);	
	Если МенеджерКриптографии = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Попытка
		СтруктураДанныхФайла = Новый Структура("ДвоичныеДанные");
		aps_РаботаСФайламиСервер.aps_ПодготовитьСтруктуруДанныхФайлаПоСсылке(Объект.Ссылка, СтруктураДанныхФайла);

		РасшифрованныеДвоичныеДанные = МенеджерКриптографии.Расшифровать(СтруктураДанныхФайла.ДвоичныеДанные);
		aps_РаботаСФайламиСервер.aps_ИзменитьДанныеШифрования(Объект.Ссылка, РасшифрованныеДвоичныеДанные);
	Исключение
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = aps_ПолныеПрава.aps_ПараметрСеанса("aps_ИмяПродукта")+НСтр("ru = 'Не удалось расшифровать файл по причине:'; en_US = 'Cannot decrypt the file:'")+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Сообщение.Сообщить();
		Возврат;
	КонецПопытки;
	
	ПоказатьОповещениеПользователя(НСтр("ru = 'Файл ""'; en_US = 'The ""'")+Объект.Ссылка+НСтр("ru = '"" расшифрован.'; en_US = '"" file is decrypted.'"));
	КосвенноеИзменениеФайла();
КонецПроцедуры

#КонецЕсли

#КонецОбласти


#Область ОбработчикиЭлементовФормы

#Если Не МобильноеПриложениеКлиент Тогда

&НаКлиенте
Процедура СертификатыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ПросмотрСертификатаШифрования(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ВладелецОткрытие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Если ЗначениеЗаполнено(Объект.Владелец) Тогда 
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			aps_ОткрытьВПроводнике(Объект.Владелец);
		#КонецЕсли
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КосвенноеИзменениеФайла()
	ОповеститьОбИзменении(Объект.Ссылка);
	
	Прочитать();
	ОбновитьПодписиНаФорме();
	ОбновитьСертификатыШифрованияНаФорме();
	
	ОтображениеЭлементовФормы();
КонецПроцедуры

#КонецЕсли

#КонецОбласти


#Область ПрочиеПроцедурыИФункции

#Если НЕ МобильноеПриложениеСервер Тогда

&НаСервере
Процедура ОбновитьПодписиНаФорме()
	Подписи.Очистить();
	
	Если Объект.Подписан Тогда 
		МассивСтруктурЭЦП = aps_РаботаСФайламиСервер.aps_ПолучитьВсеЭЦПФайла(Объект.Ссылка);
		Для Каждого СтруктураЭЦП Из МассивСтруктурЭЦП Цикл
			НоваяСтрока = Подписи.Добавить();
			НоваяСтрока.АдресПодписи = ПоместитьВоВременноеХранилище(СтруктураЭЦП.ДвоичныеДанные, ЭтаФорма.УникальныйИдентификатор);
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураЭЦП);
		КонецЦикла;
	КонецЕсли;
	
	ТекстЗаголовка = НСтр("ru = 'ЭЦП'; en_US = 'Digital signature'");
	Если Подписи.Количество() > 0 Тогда
		ТекстЗаголовка = ТекстЗаголовка + " (" + Строка(Подписи.Количество()) + ")";
	КонецЕсли;	
	Элементы.СтраницаЭЦП.Заголовок = ТекстЗаголовка;
КонецПроцедуры

&НаСервере
Процедура ОбновитьСертификатыШифрованияНаФорме()
	СертификатыШифрования.Очистить();
	
	Если Объект.Зашифрован Тогда 
		МассивСтруктурСертификатов = aps_РаботаСФайламиСервер.aps_ПолучитьСертификатыШифрования(Объект.Ссылка);
		Для Каждого СтруктураСертификата Из МассивСтруктурСертификатов Цикл
			НоваяСтрока = СертификатыШифрования.Добавить();
			НоваяСтрока.ПредставлениеСертификата = СтруктураСертификата.Представление;
			НоваяСтрока.АдресСертификата		 = ПоместитьВоВременноеХранилище(СтруктураСертификата.ДвоичныеДанные, ЭтаФорма.УникальныйИдентификатор);
		КонецЦикла;
	КонецЕсли;
	
	ТекстЗаголовка = НСтр("ru = 'Зашифрован для'; en_US = 'Encrypted for'");
	Если СертификатыШифрования.Количество() > 0 Тогда
		ТекстЗаголовка = ТекстЗаголовка + " (" + Строка(СертификатыШифрования.Количество()) + ")";
	КонецЕсли;	
	Элементы.СтраницаЗашифрованДля.Заголовок = ТекстЗаголовка;
КонецПроцедуры

&НаСервере
Процедура ОтображениеЭлементовФормы()
	Если ЗначениеЗаполнено(Объект.Владелец) Тогда 
		ЕстьПравоИзменения = Обработки.aps_ПраваДоступа.Создать().aps_ПроверитьОбъектПрава(Справочники.aps_Права.Изменение, Объект.Владелец, Объект.Владелец.GMOD);
	Иначе 
		ЕстьПравоИзменения = Ложь;
	КонецЕсли;
	
	СейчасРедактируется = ЗначениеЗаполнено(Объект.Редактируется);
	
	ТолькоПросмотр = НЕ ЕстьПравоИзменения ИЛИ СейчасРедактируется;
	
	Элементы.ФормаПодписать.Доступность			= НЕ ТолькоПросмотр И НЕ Объект.Зашифрован;
	Элементы.ФормаЗашифровать.Доступность		= НЕ ТолькоПросмотр И НЕ Объект.Зашифрован;
	Элементы.ФормаРасшифровать.Доступность		= НЕ ТолькоПросмотр И Объект.Зашифрован;
	
	Элементы.ГруппаРедактируется.Видимость = СейчасРедактируется;

	Элементы.ПодписиПодписать.Доступность			= НЕ ТолькоПросмотр И НЕ Объект.Зашифрован;
	Элементы.ПодписиУдалитьПодпись.Доступность		= НЕ ТолькоПросмотр И Объект.Подписан;
	Элементы.ПодписиВыгрузитьПодписи.Доступность	= Объект.Подписан;
	Элементы.ПодписиПросмотрСертификата.Доступность	= Объект.Подписан;
	
	Элементы.СертификатыШифрованияПросмотрСертификата.Доступность = Объект.Зашифрован;
КонецПроцедуры

&НаСервере
Функция ВозможностьУдаленияПодписи(СтрокаОшибки)
	Для Каждого ИдентификаторСтроки Из Элементы.Подписи.ВыделенныеСтроки Цикл
		СтрокаПодписи = Подписи.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если НЕ РольДоступна("aps_Администратор") 
			И СтрокаПодписи.АвторПодписи <> aps_ПолныеПрава.aps_ПараметрСеанса("ТекущийПользователь") Тогда
			СтрокаОшибки = НСтр("ru = 'У Вас нет прав на удаление чужой подписи!'; en_US = 'You have not permissions to delete another's signatures!'");
			Возврат Ложь;
		КонецЕсли; 
	КонецЦикла;
	Возврат Истина;
КонецФункции

&НаСервере
Процедура ПередЗаписьюСервер(Отказ, СтрокаПредупреждения)
	Объект.ИмяФайла = ?(ПустаяСтрока(Объект.Расширение), СокрЛП(Объект.ИмяФайла), СокрЛ(Объект.ИмяФайла));
	
	ЭтотОбъектИБ = РеквизитФормыВЗначение("Объект");
	
	СтрокаОшибки="";
	Если НЕ ЭтотОбъектИБ.ПроверитьИмя(СтрокаОшибки) Тогда 
		СтрокаПредупреждения=НСтр("ru = 'Недопустимое имя! '; en_US = 'Impermissible name! '")+СтрокаОшибки;
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ОбновитьПодписиНаФорме();
	ОбновитьСертификатыШифрованияНаФорме();
	
	ОтображениеЭлементовФормы();
КонецПроцедуры

#КонецЕсли

#КонецОбласти


