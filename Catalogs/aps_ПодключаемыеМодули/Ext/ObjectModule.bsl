#Если НЕ МобильноеПриложениеСервер Тогда
// Функция получает объект обработки по имени метаданных или из временного файла
//
// Параметры:
// 		Нет 
//
// Возвращаемое значение:
// 		ОбработкаОбъект - Объект обработки
//		Неопределено - в случае ошибки	
//
// Пример:
//      ОбработкаМодуля = ЭтотОбъект.ПолучитьОбработку();
//
Функция ПолучитьОбработку() Экспорт
	ОбработкаОбъект = Неопределено;
	
	Попытка
		Если ЭтотОбъект.ХранилищеВнешнейОбработки.Получить() <> Неопределено Тогда
			ВременныйКаталогВыгрузки = КаталогВременныхФайлов() + "1cpdm_temp\";
			СоздатьКаталог(ВременныйКаталогВыгрузки);
			ИмяВременногоФайла = ВременныйКаталогВыгрузки + Строка(Ссылка.УникальныйИдентификатор()) + ".epf";
			ЭтотОбъект.ХранилищеВнешнейОбработки.Получить().Записать(ИмяВременногоФайла);
			ОбработкаОбъект = ВнешниеОбработки.Создать(ИмяВременногоФайла);
			УдалитьФайлы(ИмяВременногоФайла);
			
		Иначе
			Попытка
				ОбработкаОбъект = Вычислить(СтрЗаменить(ЭтотОбъект.Обработка, "Обработка.", "Обработки.") + ".Создать()");
			Исключение
				ОбработкаОбъект = Неопределено;
			КонецПопытки;
		КонецЕсли;
	Исключение
		Сообщить(ПараметрыСеанса.aps_ИмяПродукта + "Ошибка создания обработки подключаемого модуля!" + Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Неопределено;
	КонецПопытки;
			
	Если ОбработкаОбъект <> Неопределено Тогда
		Если ОбработкаОбъект.Метаданные().Реквизиты.Найти("ПодключаемыйМодуль") <> Неопределено Тогда
			ОбработкаОбъект.ПодключаемыйМодуль = ЭтотОбъект.Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ОбработкаОбъект;
КонецФункции // ПолучитьОбработку()

// Процедура заполняет параметры подключаемого модуля по данным обработки
//
// Параметры
// 		Нет 
//  
// Пример:
//      ЭтотОбъект.Автозаполнение();
//
Процедура Автозаполнение() Экспорт 
	ОбработкаОбъект = ПолучитьОбработку();
	МетаданныеОбработки = ОбработкаОбъект.Метаданные();
	
	Наименование = МетаданныеОбработки.Синоним;
	Комментарий  = МетаданныеОбработки.Комментарий;
	
	ИмяОбработки = МетаданныеОбработки.Имя;
	
	Попытка
		ОбработкаОбъект.aps_АвтозаполнениеПараметровПодключаемогоМодуля(ЭтотОбъект);
	Исключение
	КонецПопытки;
КонецПроцедуры

#КонецЕсли

#КонецОбласти