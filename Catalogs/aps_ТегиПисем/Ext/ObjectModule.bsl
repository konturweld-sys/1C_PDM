
#Область ОбработчикиСобытийФормы

Процедура ПередЗаписью(Отказ)
	Если ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
	НайденныйТег = Справочники.aps_ТегиПисем.НайтиПоНаименованию(Наименование, Истина);
	Если НайденныйТег <> Ссылка И НЕ НайденныйТег.Пустая() Тогда
		Сообщить(ПараметрыСеанса.aps_ИмяПродукта + НСтр("ru = 'Тег с наименованием <'; en_US = The <")+ Наименование +НСтр("ru = '> уже существует.'; en_US = '> tag already exists.'"));
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
