
#Область ОбработчикиСобытийФормы

#Если Клиент Тогда 

Процедура ПередЗаписью(Отказ)
	Если ПометкаУдаления Тогда 
		Предупреждение(НСтр("ru = 'Шаблон связи используется системными справочниками PDM.'; en_US = 'The link template is used by system catalogs of PDM.'")+Символы.ПС+
						НСтр("Перед удалением следует произвести замену шаблона."));
		ВыбШаблонСвязи = Неопределено;
		Если ВвестиЗначение(ВыбШаблонСвязи, НСтр("ru = 'Выберите шаблон, на который следует заменить'; en_US = 'Select a template to replace with:'"), Тип("СправочникСсылка.aps_ШаблоныТехнологическихСвязей")) Тогда 
			// Выбрать все ссылки на данный шаблон
			Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
			                      |	aps_ЭлементыТехнологии.Ссылка
			                      |ИЗ
			                      |	Справочник.aps_ЭлементыТехнологии КАК aps_ЭлементыТехнологии
			                      |ГДЕ
			                      |	(НЕ aps_ЭлементыТехнологии.ПометкаУдаления)
			                      |	И aps_ЭлементыТехнологии.ПодчиненныеЭлементыТехнологии.ВидСвязи = &ВидСвязи
			                      |
			                      |ОБЪЕДИНИТЬ ВСЕ
			                      |
			                      |ВЫБРАТЬ
			                      |	aps_ЭлементыСвязей.Ссылка
			                      |ИЗ
			                      |	Справочник.aps_ЭлементыСвязей КАК aps_ЭлементыСвязей
			                      |ГДЕ
			                      |	(НЕ aps_ЭлементыСвязей.ПометкаУдаления)
			                      |	И aps_ЭлементыСвязей.ВидСвязи = &ВидСвязи");
			Запрос.УстановитьПараметр("ВидСвязи", Ссылка);
			МассивСсылок = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку(0);
			
			Попытка
				НачатьТранзакцию();
				
				Для Каждого item Из МассивСсылок Цикл 
					Если ТипЗнч(item)=Тип("СправочникСсылка.aps_ЭлементыСвязей") Тогда 
						item_obj = item.ПолучитьОбъект();
						item_obj.ВидСвязи = ВыбШаблонСвязи;
						item_obj.Записать();
					ИначеЕсли ТипЗнч(item)=Тип("СправочникСсылка.aps_ЭлементыТехнологии") Тогда 
						item_obj = item.ПолучитьОбъект();
						Для Каждого СтрокаТЧ Из item_obj.ПодчиненныеЭлементыТехнологии Цикл 
							Если СтрокаТЧ.ВидСвязи = Ссылка Тогда 
								СтрокаТЧ.ВидСвязи = ВыбШаблонСвязи;
							КонецЕсли;
						КонецЦикла;
						item_obj.Записать();
					КонецЕсли;
				КонецЦикла;
				
				ЗафиксироватьТранзакцию();
			Исключение
				ОтменитьТранзакцию();
				Сообщить(ПараметрыСеанса.aps_ИмяПродукта+НСтр("ru = 'Не удалось произвести замену шаблона связи:'; en_US = 'Cannot replace link template:'")+Символы.ПС+ОписаниеОшибки(), СтатусСообщения.Внимание);
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецЕсли

#КонецОбласти