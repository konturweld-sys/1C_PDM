
&НаКлиенте
Процедура ДобавитьИзИС(Команда)
	#Если ТолстыйКлиентОбычноеПриложение Тогда 
	СтрокаСоединения = Константы.aps_СтрокаСоединенияИС.Получить();
	Если ПустаяСтрока(СтрокаСоединения) Тогда 
		Предупреждение(НСтр("ru = 'Параметры подключения к Инженерному справочнику не заданы!'; en_US = 'Engineering catalog connection settings are not specified!'"));
		Возврат;
	КонецЕсли;
	
	Состояние(НСтр("ru = 'Запуск Инженерного справочника...'; en_US = 'Starting Engineering catalog...'"));
	
	Попытка
		ЗначениеВыбора = Обработки.aps_УправлениеИзделиями.Создать().aps_ВыбратьИзИС(СтрокаСоединения, Справочники.aps_ВидыЭлементов.ВидТехнологическойОперации);
	Исключение
		Предупреждение(ОписаниеОшибки());
	КонецПопытки;
	
	Если ЗначениеВыбора = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	ТекущаяГруппа = Элементы.Список.ТекущаяСтрока;
	
	МодульСозданияПараметров = Обработки.aps_СозданиеПараметров.Создать();
	Для Каждого ОперацияXDTO Из ЗначениеВыбора Цикл
		КодОперации = Строка(МодульСозданияПараметров.aps_ПолучитьЗначениеПараметраПоСвойствуВXDTO(ОперацияXDTO, ПланыВидовХарактеристик.aps_Свойства.КодОперации, Ложь));
		Если Справочники.ТехнологическиеОперации.НайтиПоКоду(КодОперации).Пустая() Тогда 
			НоваяОперация = Справочники.ТехнологическиеОперации.СоздатьЭлемент();
			НоваяОперация.Код = КодОперации;
			НоваяОперация.Наименование = Строка(МодульСозданияПараметров.aps_ПолучитьЗначениеПараметраПоСвойствуВXDTO(ОперацияXDTO, ПланыВидовХарактеристик.aps_Свойства.Наименование, Ложь));
			Если ТекущаяГруппа.ЭтоГруппа Тогда 
				НоваяОперация.Родитель = ТекущаяГруппа;
			Иначе 
				НоваяОперация.Родитель = ТекущаяГруппа.Родитель;
			КонецЕсли;
			НоваяОперация.Записать();
		КонецЕсли;
	КонецЦикла;
	
	Элементы.Список.Обновить();
	#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		Элементы.ФормаДобавитьИзИС.Видимость = Истина;
	#Иначе
		Элементы.ФормаДобавитьИзИС.Видимость = Ложь;
	#КонецЕсли
КонецПроцедуры
