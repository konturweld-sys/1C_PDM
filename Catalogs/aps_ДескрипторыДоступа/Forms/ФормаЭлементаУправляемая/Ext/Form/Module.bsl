
#Область ОбработчикиСобытийЭлементовФормы

#Если Не МобильноеПриложениеКлиент Тогда

&НаКлиенте
Процедура СубъектыПраваПриАктивизацииСтроки(Элемент)
	Если Элемент.ТекущиеДанные <> Неопределено Тогда
		Субъект = Элемент.ТекущиеДанные.СубъектПрава;
		СубъектыПраваПриАктивизацииСтрокиСервер(Элемент.ТекущаяСтрока, Субъект);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СубъектыПраваПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	Отказ = Истина;
	
	Массив = Новый Массив();
	Массив.Добавить(Тип("ПеречислениеСсылка.aps_СистемныеГруппы"));
	Массив.Добавить(Тип("СправочникСсылка.Пользователи"));
	Массив.Добавить(Тип("СправочникСсылка.ГруппыПользователей"));
	
	ВыбСубъект = Неопределено;
	Если ВвестиЗначение(ВыбСубъект, "Выберите субъект права", Новый ОписаниеТипов(Массив)) Тогда
		ДобавитьСубъектСервер(ВыбСубъект);
		Модифицированность = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СубъектыПраваПередУдалением(Элемент, Отказ)
	Отказ = Истина;
	
	ТекущаяСтрока = Элементы.СубъектыПрава.ТекущиеДанные;
	Если ТекущаяСтрока <> Неопределено Тогда
		Если Вопрос("Удалить субъект?", РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
			УдалитьСубъектСервер(ТекущаяСтрока.СубъектПрава);
			СубъектыПрава.Удалить(ТекущаяСтрока);
			Модифицированность = Истина;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
	
&НаКлиенте
Процедура ЗначенияПравДоступаПриИзменении(Элемент)
	Субъект = Элементы.СубъектыПрава.ТекущиеДанные.СубъектПрава;
	ЗначенияПравДоступаПриИзмененииСервер(Субъект);
КонецПроцедуры

&НаКлиенте
Процедура ЗначенияПравДоступаРазрешитьПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.ЗначенияПравДоступа.ТекущиеДанные;
	
	Если ТекущаяСтрока.Запретить = Истина И ТекущаяСтрока.Разрешить = Истина Тогда
		ТекущаяСтрока.Запретить = Ложь;
	КонецЕсли;
	
	Если ТекущаяСтрока.Разрешить = Истина И ТекущаяСтрока.ОбъектПрава = ПравоИзменение Тогда
		СтрокаПросмотр = ЗначенияПравДоступа.НайтиСтроки(Новый Структура("ОбъектПрава", ПравоПросмотр))[0];
		СтрокаПросмотр.Разрешить = Истина;
		СтрокаПросмотр.Запретить = Ложь;
	КонецЕсли;
	
	Если ТекущаяСтрока.Разрешить = Ложь И ТекущаяСтрока.ОбъектПрава = ПравоПросмотр Тогда
		СтрокаИзменение = ЗначенияПравДоступа.НайтиСтроки(Новый Структура("ОбъектПрава", ПравоИзменение))[0];
		СтрокаИзменение.Разрешить = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗначенияПравДоступаЗапретитьПриИзменении(Элемент)
	ТекущаяСтрока = Элементы.ЗначенияПравДоступа.ТекущиеДанные;
	
	Если ТекущаяСтрока.Запретить = Истина И ТекущаяСтрока.Разрешить = Истина Тогда
	    ТекущаяСтрока.Разрешить = Ложь;
	КонецЕсли;
	
	Если ТекущаяСтрока.Запретить = Истина И ТекущаяСтрока.ОбъектПрава = ПравоПросмотр Тогда
		СтрокаИзменение = ЗначенияПравДоступа.НайтиСтроки(Новый Структура("ОбъектПрава", ПравоИзменение))[0];
		СтрокаИзменение.Разрешить = Ложь;
		СтрокаИзменение.Запретить = Истина;
	КонецЕсли;
КонецПроцедуры

#КонецЕсли

#КонецОбласти


#Область ОбработчикиСобытийФормы

#Если Не МобильноеПриложениеСервер Тогда

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Объект.Ссылка.Пустая() Тогда 
		СсылкаНового = Справочники.aps_ДескрипторыДоступа.ПолучитьСсылку();
		Объект.Наименование = Строка(СсылкаНового.УникальныйИдентификатор());
	Иначе 
		СсылкаНового = Объект.Ссылка;
	КонецЕсли;
	
	
	ПравоПросмотр	= Справочники.aps_Права.Просмотр;
	ПравоИзменение	= Справочники.aps_Права.Изменение;
	
	ПриЧтенииНаСервере(Неопределено);
	
	// скопировать дескриптор
	Если ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда 
		Объект.Родитель = Параметры.ЗначениеКопирования.Родитель; // в той же группе
		
		СубъектыИЗначенияПрав = ПолучитьИзВременногоХранилища(АдресСоответствияСубъектовИПрав);
		
		МассивСубъектов = ПолучитьМассивСубъектов(Параметры.ЗначениеКопирования);
		Для Каждого Субъект Из МассивСубъектов Цикл
			СубъектыПрава.Добавить().СубъектПрава = Субъект;
			// набор прав копируемого дескриптора
			локЗначенияПравДоступа = РегистрыСведений.aps_ЗначенияОбъектовПравПолитик.СоздатьНаборЗаписей();
			локЗначенияПравДоступа.Отбор.Источник.Установить(Параметры.ЗначениеКопирования);
			локЗначенияПравДоступа.Отбор.СубъектПрава.Установить(Субъект);
			локЗначенияПравДоступа.Прочитать();
			
			// добавить объекты права, отсутствующие в наборе
			ДобавитьОтсутствующиеПрава(локЗначенияПравДоступа, СсылкаНового, Субъект);
			
			// сортировка списка объектов прав
			ТаблицаЗначенийПрав = локЗначенияПравДоступа.Выгрузить();
			ТаблицаЗначенийПрав.Сортировать("ОбъектПрава");
			// набор прав нового дескриптора
			ТаблицаЗначенийПрав.ЗаполнитьЗначения(СсылкаНового, "Источник");
			локЗначенияПравДоступа.Отбор.Источник.Установить(СсылкаНового);
			локЗначенияПравДоступа.Загрузить(ТаблицаЗначенийПрав);
			
			СубъектыИЗначенияПрав.Вставить(Субъект, Object1С2Строка(локЗначенияПравДоступа));
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	Если ТекущийОбъект.ЭтоНовый() Тогда 
		ТекущийОбъект.УстановитьСсылкуНового(СсылкаНового);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	СубъектыИЗначенияПрав = ПолучитьИзВременногоХранилища(АдресСоответствияСубъектовИПрав);
	Для Каждого СоответствиеСтрокИЗначений Из СубъектыИЗначенияПрав Цикл
		Строка2Object1С(СоответствиеСтрокИЗначений.Значение).Записать();
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	СубъектыИЗначенияПрав = Новый Соответствие;
	СубъектыПрава.Очистить();
	
	МассивСубъектов = ПолучитьМассивСубъектов(СсылкаНового);
	Для Каждого Субъект Из МассивСубъектов Цикл
		СубъектыПрава.Добавить().СубъектПрава = Субъект;
		
		локЗначенияПравДоступа = РегистрыСведений.aps_ЗначенияОбъектовПравПолитик.СоздатьНаборЗаписей();
		локЗначенияПравДоступа.Отбор.Источник.Установить(Справочники.aps_ДескрипторыДоступа.ПустаяСсылка());
		СубъектыИЗначенияПрав.Вставить(Субъект, Object1С2Строка(локЗначенияПравДоступа));
	КонецЦикла;
	
	АдресСоответствияСубъектовИПрав = ПоместитьВоВременноеХранилище(СубъектыИЗначенияПрав, ЭтаФорма.УникальныйИдентификатор);
	
	Если СубъектыПрава.Количество() > 0 Тогда 
		Элементы.СубъектыПрава.ТекущаяСтрока = СубъектыПрава[0].ПолучитьИдентификатор();
	КонецЕсли;
КонецПроцедуры

#КонецЕсли

#КонецОбласти


#Область ПрочиеПроцедурыИФункции

#Если Не МобильноеПриложениеСервер Тогда

&НаСервере
Процедура ДобавитьСубъектСервер(СубъектПрава)
	СубъектыИЗначенияПрав = ПолучитьИзВременногоХранилища(АдресСоответствияСубъектовИПрав);
	Если ЗначениеЗаполнено(СубъектПрава) И (СубъектыИЗначенияПрав.Получить(СубъектПрава)=Неопределено 
			Или Строка2Object1С(СубъектыИЗначенияПрав.Получить(СубъектПрава)).Количество() = 0) Тогда 
		СтрокаСубъекта = СубъектыПрава.Добавить();
		СтрокаСубъекта.СубъектПрава = СубъектПрава;
		
		локЗначенияПравДоступа = РегистрыСведений.aps_ЗначенияОбъектовПравПолитик.СоздатьНаборЗаписей();
		локЗначенияПравДоступа.Отбор.Источник.Установить(Справочники.aps_ДескрипторыДоступа.ПустаяСсылка());
		СубъектыИЗначенияПрав.Вставить(СубъектПрава, Object1С2Строка(локЗначенияПравДоступа));
		
		Элементы.СубъектыПрава.ТекущаяСтрока = СтрокаСубъекта.ПолучитьИдентификатор();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура УдалитьСубъектСервер(СубъектПрава)
	СубъектыИЗначенияПрав = ПолучитьИзВременногоХранилища(АдресСоответствияСубъектовИПрав);
	локЗначенияПравДоступа = Строка2Object1С(СубъектыИЗначенияПрав.Получить(СубъектПрава));
	локЗначенияПравДоступа.Очистить();
	СубъектыИЗначенияПрав.Вставить(СубъектПрава, Object1С2Строка(локЗначенияПравДоступа));
	
	ЗначениеВРеквизитФормы(локЗначенияПравДоступа, "ЗначенияПравДоступа");
КонецПроцедуры

&НаСервере
Процедура СубъектыПраваПриАктивизацииСтрокиСервер(ИдСтроки, Субъект)
	
	СубъектыИЗначенияПрав = ПолучитьИзВременногоХранилища(АдресСоответствияСубъектовИПрав);
	локЗначенияПравДоступа = Строка2Object1С(СубъектыИЗначенияПрав.Получить(Субъект));
	Если Субъект <> Неопределено Тогда
		// обновить или создать списки прав
		Если локЗначенияПравДоступа.Отбор.Источник.Значение = Справочники.aps_ДескрипторыДоступа.ПустаяСсылка() Тогда 
			локЗначенияПравДоступа.Отбор.Источник.Установить(СсылкаНового);
			локЗначенияПравДоступа.Отбор.СубъектПрава.Установить(Субъект);
			локЗначенияПравДоступа.Прочитать();
			
			// добавить объекты права, отсутствующие в наборе
			ДобавитьОтсутствующиеПрава(локЗначенияПравДоступа, СсылкаНового, Субъект);
			
			// сортировка списка объектов прав
			ТаблицаЗначенийПрав = локЗначенияПравДоступа.Выгрузить();
			ТаблицаЗначенийПрав.Сортировать("ОбъектПрава");
			локЗначенияПравДоступа.Загрузить(ТаблицаЗначенийПрав);
		КонецЕсли;
		
		ЗначениеВРеквизитФормы(локЗначенияПравДоступа, "ЗначенияПравДоступа");
	КонецЕсли;
	
	СубъектыИЗначенияПрав.Вставить(Субъект, Object1С2Строка(локЗначенияПравДоступа));
КонецПроцедуры

&НаСервере
Процедура ЗначенияПравДоступаПриИзмененииСервер(Субъект)
	локЗначенияПравДоступа = РеквизитФормыВЗначение("ЗначенияПравДоступа");
	СубъектыИЗначенияПрав = ПолучитьИзВременногоХранилища(АдресСоответствияСубъектовИПрав);
	СубъектыИЗначенияПрав.Вставить(Субъект, Object1С2Строка(локЗначенияПравДоступа));
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьОтсутствующиеПрава(НаборПрав, Источник, Субъект)
	СуществующиеОбъекты = НаборПрав.ВыгрузитьКолонку("ОбъектПрава");
	ВыборкаВсехОбъектовДоступа = Справочники.aps_Права.Выбрать();
	Пока ВыборкаВсехОбъектовДоступа.Следующий() Цикл
		Если СуществующиеОбъекты.Найти( ВыборкаВсехОбъектовДоступа.Ссылка ) = Неопределено Тогда
			ОбъектПрава = НаборПрав.Добавить();
			ОбъектПрава.Источник	 = Источник;
			ОбъектПрава.СубъектПрава = Субъект;
			ОбъектПрава.ОбъектПрава	 = ВыборкаВсехОбъектовДоступа.Ссылка;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьМассивСубъектов(Источник)
	// субъекты прав для данного дескриптора
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	aps_ЗначенияОбъектовПравПолитик.СубъектПрава КАК СубъектПрава
	                      |ИЗ
	                      |	РегистрСведений.aps_ЗначенияОбъектовПравПолитик КАК aps_ЗначенияОбъектовПравПолитик
	                      |ГДЕ
	                      |	aps_ЗначенияОбъектовПравПолитик.Источник = &Источник
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	СубъектПрава");
	Запрос.УстановитьПараметр("Источник", Источник);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку(0);
КонецФункции

#КонецЕсли

#КонецОбласти


