
#Область ОбработчикиСобытийФормы

#Если НЕ МобильноеПриложениеКлиент Тогда
	
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если НЕ ЯАдмин() Тогда
		Отказ=Истина;
		Предупреждение(НСтр("ru = 'Действие доступно только администратору системы!'; en_US = 'The action is available only for administrator of system!'"));
	КонецЕсли;
КонецПроцедуры
#КонецЕсли

#КонецОбласти


#Область ОбработчикиКомандФормы

#Если НЕ МобильноеПриложениеКлиент Тогда
	
&НаКлиенте
Процедура УдалитьНесвязанные(Команда)
	aps_ОбработчикиСобытий.aps_УдалениеНесвязанныхДескрипторов();
	Элементы.Дерево.Обновить();
	Элементы.Список.Обновить();
КонецПроцедуры

#КонецЕсли

#КонецОбласти


#Область ПрочиеПроцедурыИФункции

#Если НЕ МобильноеПриложениеСервер Тогда
&НаСервере
Функция ЯАдмин()
	Возврат aps_ЯАдмин();
КонецФункции

#КонецЕсли

#КонецОбласти


