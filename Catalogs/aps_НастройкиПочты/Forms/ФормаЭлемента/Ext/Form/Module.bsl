
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Элементы.ГруппаПользовательSMTP.Доступность = Объект.ТребуетсяSMTPАутентификация;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ТребуетсяSMTPАутентификацияПриИзменении(Элемент)
	Элементы.ГруппаПользовательSMTP.Доступность = Объект.ТребуетсяSMTPАутентификация;	
	Если Объект.ТребуетсяSMTPАутентификация и ПустаяСтрока(Объект.ИмяПользователяSMTP) Тогда
		Объект.ИмяПользователяSMTP = Объект.ИмяПользователя;
		Объект.ПарольSMTP = Объект.Пароль;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПроверитьСоединение(Команда)
	Если ПроверитьСоединениеСервер() Тогда 
		Предупреждение(НСтр("ru = ""Соединение установлено!""; en = ""Connection established"""));
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ПрочиеПроцедурыИФункции

&НаСервере
Функция ПроверитьСоединениеСервер()
	Попытка
		Почта = Новый ИнтернетПочта;
		
		Профиль = Новый ИнтернетПочтовыйПрофиль;
		Если Объект.ТипСервера = Перечисления.aps_ТипыСерверовПочты.POP3 Тогда
			Профиль.АдресСервераPOP3 = Объект.АдресСервера;
			Профиль.ПортPOP3 = Объект.Порт;
			Профиль.АутентификацияPOP3 = СпособPOP3Аутентификации.Обычная;
			Профиль.Пароль = Объект.Пароль;
			Профиль.Пользователь = Объект.ИмяПользователя;
		Иначе
			Профиль.АдресСервераIMAP = Объект.АдресСервера;
			Профиль.ПортIMAP = Объект.Порт;
			Профиль.ПользовательIMAP = Объект.ИмяПользователя;
			Профиль.ПарольIMAP = Объект.Пароль;
		КонецЕсли;
		
		Профиль.АдресСервераSMTP = Объект.АдресСервераSMTP;
		Профиль.ПортSMTP = Объект.ПортSMTP;
		
		Если Объект.ТребуетсяSMTPАутентификация Тогда
			Профиль.АутентификацияSMTP = СпособSMTPАутентификации.ПоУмолчанию;
			Профиль.ПарольSMTP = Объект.Пароль;
			Профиль.ПользовательSMTP = Объект.ИмяПользователя;
		Иначе
			Профиль.АутентификацияSMTP = СпособSMTPАутентификации.БезАутентификации
		КонецЕсли;
		
		Почта.Подключиться(Профиль);
		Возврат Истина;
	Исключение
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ОписаниеОшибки();
		Сообщение.Сообщить();
		Возврат Ложь;
	КонецПопытки;
КонецФункции

#КонецОбласти

