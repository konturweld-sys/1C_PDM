
&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	Если НЕ ЗначениеЗаполнено(ЭтаФорма.Параметры.Ключ) Тогда 
		Элементы.СписокУпаковок.ТолькоПросмотр = Истина;
	Иначе	
		Элементы.СписокУпаковок.ТолькоПросмотр = Истина;
		ЭлементОтбора = СписокУпаковок.Отбор.Элементы[1];	
		ЭлементОтбора.ПравоеЗначение = Объект.Ссылка;
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Объект.Предопределенный  Тогда 
		ЭтаФорма.ТолькоПросмотр = Истина;
		Элементы.СписокУпаковок.ТолькоПросмотр = Истина;
	Иначе	
		Элементы.СписокУпаковок.ТолькоПросмотр = НЕ ЗначениеЗаполнено(ЭтаФорма.Параметры.Ключ);
		ЭлементОтбора = СписокУпаковок.Отбор.Элементы[1];	
		ЭлементОтбора.ПравоеЗначение = Объект.Ссылка;
	КонецЕсли;	
КонецПроцедуры
