&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	Элементы.ЗаполнитьПоВидуНоменклатуры.Доступность = Не ЗначениеЗаполнено(Объект.ВидНоменклатуры);
	Элементы.ХарактеристикиНоменклатуры.ТолькоПросмотр = НЕ ЗначениеЗаполнено(ЭтаФорма.Параметры.Ключ) ИЛИ Объект.ИспользованиеХарактеристик <> Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.ИндивидуальныеДляНоменклатуры;
	НаборУпаковокПриИзмененииНаСервере();
	ИспользованиеХарактеристикПриИзмененииНаСервере();
	ЕдиницаИзмеренияВеса = Константы.ЕдиницаИзмеренияВеса.Получить();
	ЕдиницаИзмеренияДлины = Константы.ЕдиницаИзмеренияДлины.Получить();
	ЕдиницаИзмеренияОбъема = Константы.ЕдиницаИзмеренияОбъема.Получить();
	ЕдиницаИзмеренияПлощади = Константы.ЕдиницаИзмеренияПлощади.Получить();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ИспользоватьУпаковкиПриИзменении(Неопределено);
	ДополнительныеЕдиницыИзмеренияИспользоватьПриИзменении(Неопределено);
	ЕдиницаИзмеренияПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ВидНоменклатурыПриИзменении(Элемент)
	Элементы.ЗаполнитьПоВидуНоменклатуры.Доступность = ЗначениеЗаполнено(Объект.ВидНоменклатуры);
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоВидуНоменклатуры()
	ЗаполнитьПоВидуНоменклатурыСервер();
	ИспользоватьУпаковкиПриИзменении(Неопределено);
	ИспользованиеХарактеристикПриИзменении(Неопределено);
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьПоВидуНоменклатурыСервер()
	Справочники.Номенклатура.ЗаполнитьПоВидуНоменклатуры(Объект);
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьУпаковкиПриИзменении(Элемент)
	Если Объект.ИспользоватьУпаковки Тогда 
		Элементы.НаборУпаковок.Доступность = ЗначениеЗаполнено(ЭтаФорма.Параметры.Ключ);
	Иначе
		Элементы.НаборУпаковок.Доступность = Ложь;
		Объект.НаборУпаковок = Неопределено;
	КонецЕсли;
	НаборУпаковокПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура НаборУпаковокПриИзменении(Элемент)
	НаборУпаковокПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура НаборУпаковокПриИзмененииНаСервере()
	ЭлементОтбора = СписокУпаковок.КомпоновщикНастроек.Настройки.Отбор.Элементы[1];
	Если Объект.ИспользоватьУпаковки И ЗначениеЗаполнено(Объект.НаборУпаковок) И Объект.НаборУпаковок <> Справочники.НаборыУпаковок.БазовыеЕдиницыИзмерения Тогда 
		Если Объект.НаборУпаковок = Справочники.НаборыУпаковок.ИндивидуальныйДляНоменклатуры Тогда 
			ЭлементОтбора.ПравоеЗначение = Объект.Ссылка;
			Элементы.СписокУпаковок.ТолькоПросмотр = НЕ ЗначениеЗаполнено(ЭтаФорма.Параметры.Ключ);
		Иначе
			ЭлементОтбора.ПравоеЗначение = Объект.НаборУпаковок;
			Элементы.СписокУпаковок.ТолькоПросмотр = Истина;
		КонецЕсли;
	Иначе
		ЭлементОтбора.ПравоеЗначение = Неопределено;
		Элементы.СписокУпаковок.ТолькоПросмотр = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ИспользованиеХарактеристикПриИзменении(Элемент)
	ИспользованиеХарактеристикПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ИспользованиеХарактеристикПриИзмененииНаСервере()
	Элементы.ВладелецХарактеристик.Видимость = Объект.ИспользованиеХарактеристик = ПредопределенноеЗначение("Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.ОбщиеСДругимВидомНоменклатуры");
	Элементы.ХарактеристикиНоменклатуры.ТолькоПросмотр = НЕ ЗначениеЗаполнено(ЭтаФорма.Параметры.Ключ) ИЛИ Объект.ИспользованиеХарактеристик <> ПредопределенноеЗначение("Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.ИндивидуальныеДляНоменклатуры");
	ЭлементОтбора = ХарактеристикиНоменклатуры.КомпоновщикНастроек.Настройки.Отбор.Элементы[0];
	Если Объект.ИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать Тогда
		ЭлементОтбора.ПравоеЗначение = Неопределено;
	ИначеЕсли Объект.ИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.ИндивидуальныеДляНоменклатуры Тогда 
		ЭлементОтбора.ПравоеЗначение = Объект.Ссылка;
	ИначеЕсли Объект.ИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.ОбщиеДляВидаНоменклатуры Тогда
		ЭлементОтбора.ПравоеЗначение = Объект.ВидНоменклатуры;
	ИначеЕсли Объект.ИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.ОбщиеСДругимВидомНоменклатуры Тогда
		ЭлементОтбора.ПравоеЗначение = Объект.ВладелецХарактеристик;
	КонецЕсли;
КонецПроцедуры	

&НаКлиенте
Процедура НаборУпаковокНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ПолучитьСписокНаборовУпаковок(ДанныеВыбора);	
КонецПроцедуры

&НаСервере
Процедура ПолучитьСписокНаборовУпаковок(ДанныеВыбора)
	ЗапросНаборов = Новый Запрос("ВЫБРАТЬ
	                             |	НаборыУпаковок.Ссылка КАК Ссылка
	                             |ИЗ
	                             |	Справочник.НаборыУпаковок КАК НаборыУпаковок
	                             |ГДЕ
	                             |	НаборыУпаковок.ПометкаУдаления
	                             |	И НаборыУпаковок.Ссылка <> ЗНАЧЕНИЕ(Справочник.НаборыУпаковок.БазовыеЕдиницыИзмерения)
	                             |	И (НаборыУпаковок.ЕдиницаИзмерения = &ЕдиницаИзмерения
	                             |			ИЛИ НаборыУпаковок.Предопределенный)" );
	ЗапросНаборов.УстановитьПараметр("ЕдиницаИзмерения", Объект.ЕдиницаИзмерения);
	ДанныеВыбора = Новый СписокЗначений();
	ДанныеВыбора.ЗагрузитьЗначения(ЗапросНаборов.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка")); 
КонецПроцедуры


&НаКлиенте
Процедура ДополнительныеЕдиницыИзмеренияИспользоватьПриИзменении(Элемент)
	ИспользоватьВес = Объект.ВесИспользовать;
	ИспользоватьДлина = Объект.ДлинаИспользовать;
	ИспользоватьОбъем = Объект.ОбъемИспользовать;
	ИспользоватьПлощадь = Объект.ПлощадьИспользовать;
	Элементы.ВесЗнаменатель.Видимость = ИспользоватьВес;
	Элементы.ВесЧислитель.Видимость = ИспользоватьВес;
	Элементы.ВесЕдиницаХранения.Видимость = ИспользоватьВес;
	Элементы.ВесЕдиницаИзмерения.Видимость = ИспользоватьВес;
	Элементы.ВесМожноУказыватьВДокументах.Видимость = ИспользоватьВес;
	Элементы.ДлинаЗнаменатель.Видимость = ИспользоватьДлина;
	Элементы.ДлинаЧислитель.Видимость = ИспользоватьДлина;
	Элементы.ДлинаЕдиницаХранения.Видимость = ИспользоватьДлина;
	Элементы.ДлинаЕдиницаИзмерения.Видимость = ИспользоватьДлина;
	Элементы.ДлинаМожноУказыватьВДокументах.Видимость = ИспользоватьДлина;
	Элементы.ОбъемЗнаменатель.Видимость = ИспользоватьОбъем;
	Элементы.ОбъемЧислитель.Видимость = ИспользоватьОбъем;
	Элементы.ОбъемЕдиницаХранения.Видимость = ИспользоватьОбъем;
	Элементы.ОбъемЕдиницаИзмерения.Видимость = ИспользоватьОбъем;
	Элементы.ОбъемМожноУказыватьВДокументах.Видимость = ИспользоватьОбъем;
	Элементы.ПлощадьЗнаменатель.Видимость = ИспользоватьПлощадь;
	Элементы.ПлощадьЧислитель.Видимость = ИспользоватьПлощадь;
	Элементы.ПлощадьЕдиницаХранения.Видимость = ИспользоватьПлощадь;
	Элементы.ПлощадьЕдиницаИзмерения.Видимость = ИспользоватьПлощадь;
	Элементы.ПлощадьМожноУказыватьВДокументах.Видимость = ИспользоватьПлощадь;
	Если Элемент = Элементы.ВесИспользовать Тогда 
		Если НЕ ЗначениеЗаполнено(Объект.ВесЕдиницаИзмерения) Тогда 
			Объект.ВесЕдиницаИзмерения = ЕдиницаИзмеренияВеса;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Объект.ВесЗнаменатель) Тогда 
			Объект.ВесЗнаменатель = 1;
		КонецЕсли;	
	ИначеЕсли Элемент = Элементы.ДлинаИспользовать Тогда 
		Если НЕ ЗначениеЗаполнено(Объект.ДлинаЕдиницаИзмерения) Тогда 
			Объект.ДлинаЕдиницаИзмерения = ЕдиницаИзмеренияДлины;
		КонецЕсли;	
		Если НЕ ЗначениеЗаполнено(Объект.ДлинаЗнаменатель) Тогда 
			Объект.ДлинаЗнаменатель = 1;
		КонецЕсли;	
	ИначеЕсли Элемент = Элементы.ОбъемИспользовать Тогда 
		Если НЕ ЗначениеЗаполнено(Объект.ОбъемЕдиницаИзмерения) Тогда 
			Объект.ОбъемЕдиницаИзмерения = ЕдиницаИзмеренияОбъема;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Объект.ОбъемЗнаменатель) Тогда 
			Объект.ОбъемЗнаменатель = 1;
		КонецЕсли;	
	ИначеЕсли Элемент = Элементы.ПлощадьИспользовать Тогда 
		Если НЕ ЗначениеЗаполнено(Объект.ПлощадьЕдиницаИзмерения) Тогда 
			Объект.ПлощадьЕдиницаИзмерения = ЕдиницаИзмеренияПлощади;
		КонецЕсли;	
		Если НЕ ЗначениеЗаполнено(Объект.ПлощадьЗнаменатель) Тогда 
			Объект.ПлощадьЗнаменатель = 1;
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ДополнительныеЕдиницыИзмеренияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Если Элемент = Элементы.ВесЕдиницаИзмерения Тогда 
		ТипИзмеряемойВеличины = ПредопределенноеЗначение("Перечисление.ТипыИзмеряемыхВеличин.Вес");
		РеквизитДляИзменения = "ВесЕдиницаИзмерения";
	ИначеЕсли Элемент = Элементы.ДлинаЕдиницаИзмерения Тогда 
		ТипИзмеряемойВеличины = ПредопределенноеЗначение("Перечисление.ТипыИзмеряемыхВеличин.Длина");
		РеквизитДляИзменения = "ДлинаЕдиницаИзмерения";
	ИначеЕсли Элемент = Элементы.ОбъемЕдиницаИзмерения Тогда 
		ТипИзмеряемойВеличины = ПредопределенноеЗначение("Перечисление.ТипыИзмеряемыхВеличин.Объем");
		РеквизитДляИзменения = "ОбъемЕдиницаИзмерения";
	ИначеЕсли Элемент = Элементы.ПлощадьЕдиницаИзмерения Тогда 
		ТипИзмеряемойВеличины = ПредопределенноеЗначение("Перечисление.ТипыИзмеряемыхВеличин.Площадь");
		РеквизитДляИзменения = "ПлощадьЕдиницаИзмерения";
	КонецЕсли;	
	ДополнительнаяЕдиницаИзмерения = ОткрытьФормуМодально("Справочник.УпаковкиЕдиницыИзмерения.Форма.ФормаВыбораЕдиницыИзмерения",Новый Структура("ТипИзмеряемойВеличины",ТипИзмеряемойВеличины),ЭтаФорма);
	Если ДополнительнаяЕдиницаИзмерения <> Неопределено Тогда 
		Объект[РеквизитДляИзменения] = ДополнительнаяЕдиницаИзмерения;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ЕдиницаИзмеренияПриИзменении(Элемент)
	ЕдиницаИзмеренияПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЕдиницаИзмеренияПриИзмененииНаСервере()
	ЭтоВес = Ложь;
	ЭтоДлина = Ложь;
	ЭтоОбъем = Ложь;
	ЭтоПлощадь = Ложь;
	Если Объект.ЕдиницаИзмерения.ТипИзмеряемойВеличины = Перечисления.ТипыИзмеряемыхВеличин.Вес Тогда 
		ЭтоВес = Истина;
		Объект.ВесИспользовать = Истина;
		Объект.ВесЧислитель = 1;
		Объект.ВесЗнаменатель = 1;
		Объект.ВесЕдиницаИзмерения = Объект.ЕдиницаИзмерения; 
	ИначеЕсли Объект.ЕдиницаИзмерения.ТипИзмеряемойВеличины = Перечисления.ТипыИзмеряемыхВеличин.Длина Тогда 	
		ЭтоДлина = Истина;
		Объект.ДлинаИспользовать = Истина;
		Объект.ДлинаЧислитель = 1;
		Объект.ДлинаЗнаменатель = 1;
		Объект.ДлинаЕдиницаИзмерения = Объект.ЕдиницаИзмерения; 
	ИначеЕсли Объект.ЕдиницаИзмерения.ТипИзмеряемойВеличины = Перечисления.ТипыИзмеряемыхВеличин.Объем Тогда 	
		ЭтоОбъем = Истина;
		Объект.ОбъемИспользовать = Истина;
		Объект.ОбъемЧислитель = 1;
		Объект.ОбъемЗнаменатель = 1;
		Объект.ОбъемЕдиницаИзмерения = Объект.ЕдиницаИзмерения;
	ИначеЕсли Объект.ЕдиницаИзмерения.ТипИзмеряемойВеличины = Перечисления.ТипыИзмеряемыхВеличин.Площадь Тогда 	
		ЭтоПлощадь = Истина;
		Объект.ПлощадьИспользовать = Истина;
		Объект.ПлощадьЧислитель = 1;
		Объект.ПлощадьЗнаменатель = 1;
		Объект.ПлощадьЕдиницаИзмерения = Объект.ЕдиницаИзмерения;
	КонецЕсли;
	Элементы.ГруппаЗначенияВес.Видимость = НЕ ЭтоВес;
	Элементы.ГруппаЗначенияДлина.Видимость = НЕ ЭтоДлина;
	Элементы.ГруппаЗначенияОбъем.Видимость = НЕ ЭтоОбъем;
	Элементы.ГруппаЗначенияПлощадь.Видимость = Не ЭтоПлощадь;
	Элементы.ВесИспользовать.ТолькоПросмотр = ЭтоВес;
	Элементы.ДлинаИспользовать.ТолькоПросмотр = ЭтоДлина;
	Элементы.ОбъемИспользовать.ТолькоПросмотр = ЭтоОбъем;
	Элементы.ПлощадьИспользовать.ТолькоПросмотр = ЭтоПлощадь;
КонецПроцедуры	

