&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	Элементы.СписокХарактеристик.ТолькоПросмотр = НЕ ЗначениеЗаполнено(ЭтаФорма.Параметры.Ключ) ИЛИ НЕ Объект.ИспользоватьХарактеристики ИЛИ Объект.ИспользованиеХарактеристик <> Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.ОбщиеДляВидаНоменклатуры;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	 ИспользоватьУпаковкиПриИзменении(Неопределено);
	 ИспользоватьХарактеристикиПриИзменении(Неопределено); 
	 ИспользованиеХарактеристикПриИзменении(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьУпаковкиПриИзменении(Элемент)
	Если Объект.ИспользоватьУпаковки Тогда 
		Элементы.НаборУпаковок.Доступность = ЗначениеЗаполнено(ЭтаФорма.Параметры.Ключ);
	Иначе
		Элементы.НаборУпаковок.Доступность = Ложь;
		Объект.НаборУпаковок = Неопределено;
	КонецЕсли;
	НаборУпаковокПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура НаборУпаковокПриИзменении(Элемент)
	НаборУпаковокПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура НаборУпаковокПриИзмененииНаСервере()
	ЭлементОтбора = СписокУпаковок.КомпоновщикНастроек.Настройки.Отбор.Элементы[1];
	Если Объект.ИспользоватьУпаковки И ЗначениеЗаполнено(Объект.НаборУпаковок) 
	 И НЕ (Объект.НаборУпаковок = Справочники.НаборыУпаковок.ИндивидуальныйДляНоменклатуры
	 ИЛИ Объект.НаборУпаковок = Справочники.НаборыУпаковок.БазовыеЕдиницыИзмерения) Тогда 
		ЭлементОтбора.ПравоеЗначение = Объект.НаборУпаковок;
		Элементы.СписокУпаковок.ТолькоПросмотр = НЕ ЗначениеЗаполнено(ЭтаФорма.Параметры.Ключ);
	Иначе
		ЭлементОтбора.ПравоеЗначение = Неопределено;
		Элементы.СписокУпаковок.ТолькоПросмотр = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ИспользованиеХарактеристикПриИзменении(Элемент)
	Элементы.СписокХарактеристик.ТолькоПросмотр = НЕ ЗначениеЗаполнено(ЭтаФорма.Параметры.Ключ) ИЛИ Объект.ИспользованиеХарактеристик <> ПредопределенноеЗначение("Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.ОбщиеДляВидаНоменклатуры");
	Элементы.ВладелецХарактеристик.Видимость = Объект.ИспользованиеХарактеристик = ПредопределенноеЗначение("Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.ОбщиеСДругимВидомНоменклатуры");
	ИспользованиеХарактеристикПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ИспользованиеХарактеристикПриИзмененииНаСервере()
	ЭлементОтбора = СписокХарактеристик.КомпоновщикНастроек.Настройки.Отбор.Элементы[0];
	Если Объект.ИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать Тогда
		ЭлементОтбора.ПравоеЗначение = Неопределено;
	ИначеЕсли Объект.ИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.ИндивидуальныеДляНоменклатуры Тогда 
		ЭлементОтбора.ПравоеЗначение = Неопределено;
	ИначеЕсли Объект.ИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.ОбщиеДляВидаНоменклатуры Тогда
		ЭлементОтбора.ПравоеЗначение = Объект.Ссылка;
	ИначеЕсли Объект.ИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры.ОбщиеСДругимВидомНоменклатуры Тогда
		ЭлементОтбора.ПравоеЗначение = Объект.ВладелецХарактеристик;
	КонецЕсли;
КонецПроцедуры	

&НаКлиенте
Процедура ИспользоватьХарактеристикиПриИзменении(Элемент)
	Если Объект.ИспользоватьХарактеристики Тогда 
		Элементы.ИспользованиеХарактеристик.Доступность = ЗначениеЗаполнено(ЭтаФорма.Параметры.Ключ);
	Иначе
		Элементы.ИспользованиеХарактеристик.Доступность = Ложь;
		Объект.ИспользованиеХарактеристик = ПредопределенноеЗначение("Перечисление.ВариантыИспользованияХарактеристикНоменклатуры.НеИспользовать");
	КонецЕсли;
	ИспользованиеХарактеристикПриИзмененииНаСервере();	
КонецПроцедуры

&НаКлиенте
Процедура НаборУпаковокНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ПолучитьСписокНаборовУпаковок(ДанныеВыбора);	
КонецПроцедуры

&НаСервере
Процедура ПолучитьСписокНаборовУпаковок(ДанныеВыбора)
	ЗапросНаборов = Новый Запрос("ВЫБРАТЬ
	                             |	НаборыУпаковок.Ссылка КАК Ссылка
	                             |ИЗ
	                             |	Справочник.НаборыУпаковок КАК НаборыУпаковок
	                             |ГДЕ
	                             |	НаборыУпаковок.ПометкаУдаления
	                             |	И НаборыУпаковок.Ссылка <> ЗНАЧЕНИЕ(Справочник.НаборыУпаковок.БазовыеЕдиницыИзмерения)
	                             |	И (НаборыУпаковок.ЕдиницаИзмерения = &ЕдиницаИзмерения
	                             |			ИЛИ НаборыУпаковок.Предопределенный)" );
	ЗапросНаборов.УстановитьПараметр("ЕдиницаИзмерения", Объект.ЕдиницаИзмерения);
	ДанныеВыбора = Новый СписокЗначений();
	ДанныеВыбора.ЗагрузитьЗначения(ЗапросНаборов.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка")); 
КонецПроцедуры




