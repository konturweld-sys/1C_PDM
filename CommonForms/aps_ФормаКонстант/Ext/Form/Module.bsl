#Если НЕ МобильноеПриложениеКлиент Тогда
 
&НаКлиенте
Перем ФайлыВБазе;
 
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ФайлыВБазе = (НаборКонстант.aps_РежимХраненияФайлов = 0);
	ПолеРежимХраненияФайловПриИзменении(Неопределено);
	//Элементы.ПолеПутьКВнешнемуХранилищуДоступность = ДоступностьЭлементов;
	//Элементы.КнопкаКонвертировать.Доступность = ДоступностьЭлементов;	
	//Элементы.КнопкаКонвертироватьВИБ.Доступность = НЕ ДоступностьЭлементов;
КонецПроцедуры

&НаКлиенте
Процедура НадписьРасписаниеОбновлениеДанныхНажатие(Элемент)
	ИмяЗадания = "aps_ОбновлениеДанныхИнформационнойБазы";
	ОткрытьРасписание( ИмяЗадания, ПолучитьРасписаниеРегламентногоЗадания(ИмяЗадания) );
КонецПроцедуры

&НаКлиенте
Процедура НадписьРасписаниеУдалениеНесвязанныхНажатие(Элемент)
	ИмяЗадания = "aps_УдалениеНесвязанныхЭлементовИПараметров";
	ОткрытьРасписание( ИмяЗадания, ПолучитьРасписаниеРегламентногоЗадания(ИмяЗадания) );
КонецПроцедуры

&НаКлиенте
Процедура НадписьРасписаниеСозданиеНоменклатурыНажатие(Элемент)
	ИмяЗадания = "aps_СозданиеНоменклатуры";
	ОткрытьРасписание( ИмяЗадания, ПолучитьРасписаниеРегламентногоЗадания(ИмяЗадания) );
КонецПроцедуры

&НаКлиенте
Процедура НадписьРасписаниеВыполнениеПорученийНажатие(Элемент)
	ИмяЗадания = "aps_ВыполнениеПоручений";
	ОткрытьРасписание( ИмяЗадания, ПолучитьРасписаниеРегламентногоЗадания(ИмяЗадания) );
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьРасписание(ИмяЗадания, Расписание)
	ДиалогРасписания = Новый ДиалогРасписанияРегламентногоЗадания ( Расписание );
	Если ДиалогРасписания.ОткрытьМодально() Тогда
		ЗаписатьРасписаниеРегламентногоЗадания(ИмяЗадания, ДиалогРасписания.Расписание);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПолеРежимХраненияФайловПриИзменении(Элемент)
	ДоступностьЭлементов = (НаборКонстант.aps_РежимХраненияФайлов = 0);
	//Элементы.ПолеПутьКВнешнемуХранилищу.Доступность = НЕ ДоступностьЭлементов И ФайлыВБазе = Истина;
	Элементы.ПолеПутьКВнешнемуХранилищу.Доступность = НЕ ДоступностьЭлементов;
	Элементы.КнопкаКонвертировать.Доступность = НЕ ДоступностьЭлементов И ФайлыВБазе = Истина;
	Элементы.КнопкаКонвертироватьВИБ.Доступность = ДоступностьЭлементов И ФайлыВБазе = Ложь;
	//Элементы.ПолеПутьКВнешнемуХранилищу.Доступность = НЕ Элементы.ПолеПутьКВнешнемуХранилищу.Доступность;
	//Элементы.КнопкаКонвертировать.Доступность = НЕ Элементы.КнопкаКонвертировать.Доступность;
	//Элементы.КнопкаКонвертироватьВИБ.Доступность = НЕ Элементы.КнопкаКонвертироватьВИБ.Доступность;
КонецПроцедуры

&НаКлиенте
#Если НЕ МобильноеПриложениеКлиент Тогда
Процедура ПолеПутьКВнешнемуХранилищуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ВыборКаталога=Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	ВыборКаталога.ПолноеИмяФайла=НаборКонстант.aps_ПутьКВнешнемуХранилищуФайлов;
	Если ВыборКаталога.Выбрать()=Истина Тогда
		НаборКонстант.aps_ПутьКВнешнемуХранилищуФайлов=ВыборКаталога.Каталог;
	КонецЕсли;
КонецПроцедуры
#КонецЕсли
&НаКлиенте
Процедура КонвертироватьВоВнешнееХранилище(Команда)
	Если ПустаяСтрока(НаборКонстант.aps_ПутьКВнешнемуХранилищуФайлов) Тогда
		Предупреждение(НСтр("ru = 'Не указан путь к хранилищу файлов!'; en_US = 'File storage directory is not specified!'"));
		Возврат;
	КонецЕсли;
	
	#Если ТолстыйКлиентОбычноеПриложение ИЛИ ТолстыйКлиентУправляемоеПриложение Тогда
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	aps_Файлы.Ссылка,
	               |	aps_Файлы.ДвоичныеДанные КАК ДвоичныеДанные
	               |ИЗ
	               |	Справочник.aps_Файлы КАК aps_Файлы
	               |ГДЕ
	               |	НЕ aps_Файлы.ЭтоГруппа
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ДвоичныеДанные";
	СписокФайлов = Запрос.Выполнить().Выгрузить();
	
	ФормаИндикатора = ПолучитьОбщуюФорму("ОбщаяФорма.aps_ФормаИндикатора");
	ФормаИндикатора.НадписьПроцесса = НСтр("ru = 'Конвертация файлов во внешнее хранилище...'; en_US = 'Convert files to external storage...'");
	ФормаИндикатора.МаксимальноеЗначение = СписокФайлов.Количество();
	ФормаИндикатора.Открыть();
	
	ПутьКВнешнемуХранилищу = aps_РаботаСФайлами.aps_ДобавитьПоследнийСлэш(НаборКонстант.aps_ПутьКВнешнемуХранилищуФайлов);
	
	ТекущиеДвДанные = Неопределено;
	КаталогФайлаВХранилище = "";
	Для Каждого СтрокаФайла Из СписокФайлов Цикл
		ФайлСсылка = СтрокаФайла.Ссылка;
		ДвДанныеСсылка = СтрокаФайла.ДвоичныеДанные;
		ФормаИндикатора.ЗначениеИндикатора = ФормаИндикатора.ЗначениеИндикатора + 1;
		Если ДвДанныеСсылка.ДвДанные.Получить() = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			Если ДвДанныеСсылка <> ТекущиеДвДанные Тогда
				Если ТекущиеДвДанные <> Неопределено Тогда
					ДвДанныеОбъект = ТекущиеДвДанные.ПолучитьОбъект();
					ДвДанныеОбъект.ДвДанные = Неопределено;
					ДвДанныеОбъект.Записать();
				КонецЕсли;
					
				ТекущиеДвДанные = ДвДанныеСсылка;
				КаталогФайлаВХранилище = ПутьКВнешнемуХранилищу + ДвДанныеСсылка.УникальныйИдентификатор() + "\";
				КаталогОбъект = Новый Файл(КаталогФайлаВХранилище);
				Если КаталогОбъект.Существует() И КаталогОбъект.ЭтоКаталог() Тогда
					УдалитьФайлы(КаталогФайлаВХранилище, "*.*");
				Иначе
					СоздатьКаталог(КаталогФайлаВХранилище);
				КонецЕсли;
			КонецЕсли;
			
			ДвДанныеСсылка.ДвДанные.Получить().Записать(КаталогФайлаВХранилище + ФайлСсылка.Наименование);
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	Если ТекущиеДвДанные <> Неопределено Тогда
		ДвДанныеОбъект = ТекущиеДвДанные.ПолучитьОбъект();
		ДвДанныеОбъект.ДвДанные = Неопределено;
		ДвДанныеОбъект.Записать();
	КонецЕсли;
	
	ФормаИндикатора.Закрыть();
	Предупреждение(НСтр("ru = 'Конвертация файлов завершена!'; en_US = 'Convert files completed!'"));
	
	Элементы.КнопкаКонвертировать.Доступность = Ложь;
	ФайлыВБазе = Ложь;
	#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура КонвертироватьВБазуДанных(Команда)
	#Если ТолстыйКлиентОбычноеПриложение ИЛИ ТолстыйКлиентУправляемоеПриложение Тогда
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	aps_ДвоичныеДанные.Ссылка
	               |ИЗ
	               |	Справочник.aps_ДвоичныеДанные КАК aps_ДвоичныеДанные";
	СписокДвДанных = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	ФормаИндикатора = ПолучитьОбщуюФорму("ОбщаяФорма.aps_ФормаИндикатора");
	ФормаИндикатора.НадписьПроцесса = НСтр("ru = 'Конвертация файлов в информационную базу....'; en_US = 'Convert files to database...'");
	ФормаИндикатора.МаксимальноеЗначение = СписокДвДанных.Количество();
	ФормаИндикатора.Открыть();
	
	Для Каждого ДвДанныеСсылка Из СписокДвДанных Цикл
		ФормаИндикатора.ЗначениеИндикатора = ФормаИндикатора.ЗначениеИндикатора + 1;
		
		Попытка
			ДвДанныеОбъект = ДвДанныеСсылка.ПолучитьОбъект();
			ПутьКВнешнемуХранилищу = aps_РаботаСФайлами.aps_ДобавитьПоследнийСлэш(Константы.aps_ПутьКВнешнемуХранилищуФайлов.Получить());
			КаталогВоВнешнемХранилище = ПутьКВнешнемуХранилищу + Строка(ДвДанныеСсылка.УникальныйИдентификатор()) + "\";
			ПутьКФайлуВХранилище = НайтиФайлы(КаталогВоВнешнемХранилище, "*.*")[0].ПолноеИмя;
			ДвДанныеОбъект.ДвДанные = Новый ХранилищеЗначения(Новый ДвоичныеДанные(ПутьКФайлуВХранилище));
			ДвДанныеОбъект.Записать();
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	ФормаИндикатора.Закрыть();
	Предупреждение(НСтр("ru = 'Конвертация файлов завершена!'; en_US = 'Convert files completed!'"));
	
	Элементы.КнопкаКонвертироватьВИБ.Доступность = Ложь;
	ФайлыВБазе = Истина;
	#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Если НаборКонстант.aps_РежимХраненияФайлов = 1 И ПустаяСтрока(НаборКонстант.aps_ПутьКВнешнемуХранилищуФайлов) Тогда 
		Предупреждение(НСтр("ru = 'Не указан путь к хранилищу файлов!'; en_US = 'File storage directory is not specified!'"));
		Отказ = Истина;
		
	ИначеЕсли НаборКонстант.aps_РежимХраненияФайлов = 0 И НЕ ФайлыВБазе 
		ИЛИ НаборКонстант.aps_РежимХраненияФайлов = 1 И ФайлыВБазе Тогда
		ТекстПредупреждения = ?(НаборКонстант.aps_РежимХраненияФайлов = 0,
								НСтр("ru = 'Не выполнена конвертация файлов в базу данных!'; en_US = 'Files are not converted to infobase!'"),
								НСтр("ru = 'Не выполнена конвертация файлов во внешнее хранилище!'; en_US = 'Files are not converted to external storage!'"));
		Предупреждение(ТекстПредупреждения);
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НадписьНастройкиПочтыНажатие(Элемент)
	ОткрытьФорму("Справочник.aps_НастройкиПочты.ФормаСписка");
КонецПроцедуры

&НаКлиенте
Процедура РасписаниеРассылкиНажатие(Элемент)
	ИмяЗадания = "aps_РассылкаПочтовыхСообщений";
	ОткрытьРасписание( ИмяЗадания, ПолучитьРасписаниеРегламентногоЗадания(ИмяЗадания) );
КонецПроцедуры

&НаКлиенте
Процедура НадписьНастройкиПодключенияИСНажатие(Элемент)
	ФормаПодключения = ПолучитьФорму("ОбщаяФорма.aps_ФормаПодключенияКБазе",, ЭтаФорма);
	ФормаПодключения.СтрокаСоединения = НаборКонстант.aps_СтрокаСоединенияИС;
	СтрокаСоединения = ФормаПодключения.ОткрытьМодально();
	Если СтрокаСоединения <> Неопределено Тогда 
		НаборКонстант.aps_СтрокаСоединенияИС = СтрокаСоединения;
		Модифицированность = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура РассылкаПоЖурналу(Команда)
	aps_ОбработчикиСобытий.aps_РассылкаПоЖурналу();
КонецПроцедуры
#КонецЕсли

#Если НЕ МобильноеПриложениеСервер Тогда
	
&НаСервере
Функция ПолучитьРасписаниеРегламентногоЗадания(ИмяЗадания)
	Возврат РегламентныеЗадания.НайтиПредопределенное(ИмяЗадания).Расписание;
КонецФункции

&НаСервере
Процедура ЗаписатьРасписаниеРегламентногоЗадания(ИмяЗадания, Знач Расписание)
	РегламентноеЗадание = РегламентныеЗадания.НайтиПредопределенное(ИмяЗадания);
	
	РегламентноеЗадание.Расписание = Расписание;
	РегламентноеЗадание.Использование = Истина;
	РегламентноеЗадание.Записать();
КонецПроцедуры

#КонецЕсли

