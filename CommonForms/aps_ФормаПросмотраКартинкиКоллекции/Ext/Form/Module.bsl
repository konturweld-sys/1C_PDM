
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Для i=0 По 99 Цикл 
		Коллекция.Добавить().ИндексКартинки = i;
	КонецЦикла;
	
	Элементы.Коллекция.ТекущаяСтрока = Коллекция.Индекс(Коллекция.Получить(Параметры.ИндексКартинки));
КонецПроцедуры

&НаКлиенте
Процедура КоллекцияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ОповеститьОВыборе(Коллекция.НайтиПоИдентификатору(ВыбраннаяСтрока).ИндексКартинки);
КонецПроцедуры
