
/////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Обработчики событий формы
&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	Если ТипРасположенияИБ = 1 Тогда 
		// файловая база
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("ИмяСервера"));
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("ИмяИБНаСервере"));
	ИначеЕсли ТипРасположенияИБ = 2 Тогда 
		// серверная база                        	
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("КаталогИБ"));
	КонецЕсли;
КонецПроцедуры

#Если НЕ МобильноеПриложениеКлиент Тогда
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПараметрыСоединения = aps_РазбитьСтрокуСоединенияПоПараметрам(СтрокаСоединения);
	ЗаполнитьЗначенияСвойств(ЭтаФорма, ПараметрыСоединения);
	
	Если Не ПустаяСтрока(ИмяИБНаСервере) Или Не ПустаяСтрока(ИмяСервера) Тогда 
		ТипРасположенияИБ = 2;
	Иначе 
		ТипРасположенияИБ = 1;
	КонецЕсли;
	
	ПереключательПриИзменении(Неопределено);
	
	#Если Не ТолстыйКлиентОбычноеПриложение Тогда
	Элементы.ФормаПодключиться.Видимость = Ложь;
	#КонецЕсли	
КонецПроцедуры

&НаКлиенте
Процедура Готово(Команда)
	Если ПроверитьЗаполнение() Тогда 
		Закрыть(СтрокаСоединения);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Подключиться(Команда)
	Если ПроверитьЗаполнение() Тогда 
		Состояние(НСтр("ru = 'Cоединение с Инженерным справочником...'; en_US = 'Connecting to Engineering catalog...'"));
		Попытка
			V82c_Application = Новый COMОбъект("V82c.Application");
			СоединениеУстановлено = V82c_Application.Connect( СтрокаСоединения );
			Если Не СоединениеУстановлено Тогда 
				Предупреждение(НСтр("ru = 'Cоединение не было установлено!'; en_US = 'Not connected!'"));
				Возврат;
			КонецЕсли;
			
			V82c_Application.Visible = Ложь;
			Предупреждение(НСтр("ru = 'Cоединение установлено!'; en_US = 'Connected!'"));
		Исключение
			Предупреждение(ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

/////////////////////////////////////////////////////////////////////////////////////////////////////////////////
// Обработчики событий элементов формы

&НаКлиенте
Процедура ПереключательПриИзменении(Элемент)
	Если ТипРасположенияИБ = 1 Тогда 
		// файловая база
		Элементы.ГруппаРасположение1.Доступность = Истина;
		Элементы.ГруппаРасположение2.Доступность = Ложь;
	ИначеЕсли ТипРасположенияИБ = 2 Тогда 
		// серверная база                        	
		Элементы.ГруппаРасположение1.Доступность = Ложь;
		Элементы.ГруппаРасположение2.Доступность = Истина;
	КонецЕсли;
	
	СформироватьСтрокуСоединения(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура СформироватьСтрокуСоединения(Элемент)
	Если ТипРасположенияИБ = 1 Тогда 
		// файловая база 
		СтрокаСоединения = "File="""+КаталогИБ+""";";
	ИначеЕсли ТипРасположенияИБ = 2 Тогда 
		// серверная база
		СтрокаСоединения = "Srvr="""+ИмяСервера+"""; Ref="""+ИмяИБНаСервере+""";";
	КонецЕсли;
	
	Если НЕ ПустаяСтрока(ИмяПользователя) Тогда 
		СтрокаСоединения = СтрокаСоединения+" usr="""+ИмяПользователя+"""; pwd="""+ПарольПользователя+"""";
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КаталогИБНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	ВыборКаталога = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	ВыборКаталога.Каталог = КаталогИБ;
	Если ВыборКаталога.Выбрать() Тогда
		КаталогИБ = ВыборКаталога.Каталог;
		СформироватьСтрокуСоединения(Неопределено);
	КонецЕсли;
КонецПроцедуры
#КонецЕсли

