
#Если НЕ МобильноеПриложениеСервер Тогда

#Область ОписаниеПеременных	
	
Перем МодульСозданияПараметров Экспорт; 	// Объект обработки aps_СозданиеПараметров
Перем МодульСозданияРевизий Экспорт; 		// Объект обработки aps_СозданиеРевизий
Перем МодульПравДоступа Экспорт; 			// Объект обработки aps_ПраваДоступа

Перем ЗначенияСрокаОтправки;
Перем тзНепереведенныеЭлементы;

#Если Сервер Тогда 
Перем aps_СтруктураПараметровОповещенияНаСервере Экспорт; // Описание структуры параметров событий/оповещений 1C:PDM на сервере
#КонецЕсли

#КонецОбласти


#Область ОбработчикиСобытий

Процедура ПриКопировании(ОбъектКопирования)
	ИндексПоследнейГруппы = 0;
КонецПроцедуры

Процедура СтартПередСтартом(ТочкаМаршрутаБизнесПроцесса, Отказ)
	Если Состояния.Количество()=0 Тогда
		Отказ = Истина;
		Сообщить(ПараметрыСеанса.aps_ИмяПродукта + НСтр("ru = ""Не выбраны элементы, для которых необходимо изменить состояние!""; en_US = ""There are not selected items to change statuses of!"""),СтатусСообщения.Внимание);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ОтветственныйЗаВыполнение) Тогда
		Отказ = Истина;
		Сообщить(ПараметрыСеанса.aps_ИмяПродукта + НСтр("ru = ""Не указан ответственный за выполнение!""; en_US = ""Responcible for execution is not specified!"""),СтатусСообщения.Внимание);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СрокСогласования) И СрокСогласования <= ТекущаяДата() Тогда
		Отказ = Истина;
		Сообщить(ПараметрыСеанса.aps_ИмяПродукта + НСтр("ru = 'Неверно указан срок завершения согласования!'; en_US = 'Deadline is incorrectly specified!'"),СтатусСообщения.Внимание);
	КонецЕсли;
	
	Для Каждого Строка Из СогласующиеЛица Цикл 
		Если НЕ ЗначениеЗаполнено(Строка.Пользователь) Тогда
			Отказ = Истина;
			Сообщить(ПараметрыСеанса.aps_ИмяПродукта + НСтр("ru = ""Не указано согласующее лицо (строка ""; en_US = ""The endorcing person is not specified (""")+Строка.НомерСтроки+НСтр("ru = "")!""; en_US = "" row)!"""),СтатусСообщения.Внимание);
		ИначеЕсли ЗначениеЗаполнено(Строка.Заместитель) И НЕ ЗначениеЗаполнено(Строка.СрокОтправкиЗаместителю) Тогда
			Отказ = Истина;
			Сообщить(ПараметрыСеанса.aps_ИмяПродукта + НСтр("ru = ""Не указан срок перенаправки задачи заместителю (строка ""; en_US = ""Term of sending task to a substitute is not specified (""")+Строка.НомерСтроки+НСтр("ru = "")!""; en_US = "" row)!"""),СтатусСообщения.Внимание);
		ИначеЕсли ЗначениеЗаполнено(Строка.СрокОтправкиЗаместителю) И ТипЗнч(Строка.СрокОтправкиЗаместителю)=Тип("Дата") И Строка.СрокОтправкиЗаместителю <= ТекущаяДата() Тогда
			Отказ = Истина;
			Сообщить(ПараметрыСеанса.aps_ИмяПродукта + НСтр("ru = ""Неверно указан срок перенаправления задачи заместителю (строка ""; en_US = ""Term of sending task to a substitute is incorrectly specified (""")+Строка.НомерСтроки+НСтр("ru = "")!""; en_US = "" row)!"""),СтатусСообщения.Внимание);
		КонецЕсли;
	КонецЦикла;
	
	
	
	Если Отказ = Истина Тогда Возврат; КонецЕсли;
	
	ИндексПоследнейГруппы = 0;
	МассивСтрок = Состояния.НайтиСтроки(Новый Структура("Согласован", Ложь));
	Если МассивСтрок.Количество() > 0 Тогда
		Для Каждого Строка Из МассивСтрок Цикл
			Строка.Согласован = Истина;
		КонецЦикла;
	КонецЕсли;
	
	#Если Клиент Или ВнешнееСоединение Тогда 
		// гл. переменная
	#Иначе
		aps_СтруктураПараметровОповещения=aps_СтруктураПараметровОповещенияНаСервере;
	#КонецЕсли
	
	aps_СтруктураПараметровОповещения.Вставить("itemObject",ЭтотОбъект);
	aps_ОбработчикиСобытий.aps_ВыполнитьСобытие(Перечисления.aps_События.ПриСтартеБПИзмененияСостояний, aps_СтруктураПараметровОповещения);

	
	// отправить ответственному уведомление
	МассивВложений = Новый Массив;
	МассивВложений.Добавить(Ссылка);
	ТемаУведомления = НСтр("ru = ""Изменение состояний элементов""; en_US = ""Status management""")+?(ЗначениеЗаполнено(Комментарий), " ("+Комментарий+")", "");
	ТекстУведомления = НСтр("ru = ""Вы назначены ответственным за бизнес-процесс изменения состояний. Бизнес-процесс находится во вложении.""; en_US = ""You are responsible for the status management process. Process is attached.""");
	
	aps_СоздатьУведомление(, ОтветственныйЗаВыполнение,, ТемаУведомления, 
					ТекстУведомления,, МассивВложений, Истина, Ложь,, Истина);						
	
КонецПроцедуры

Процедура ТребуетсяПодписьПроверкаУсловия(ТочкаМаршрутаБизнесПроцесса, Результат)
	Результат = СогласующиеЛица.Количество()>0;
КонецПроцедуры

Процедура СогласоватьПриСозданииВложенныхБизнесПроцессов(ТочкаМаршрутаБизнесПроцесса, ФормируемыеБизнесПроцессы, Отказ)
	
	БизнесПроцессСогласования=ФормируемыеБизнесПроцессы[0];
	
	i = ИндексПоследнейГруппы;
	Пока i < СогласующиеЛица.Количество() Цикл
		Если СогласующиеЛица[i].ПараллельноСПредыдущим Или (i = ИндексПоследнейГруппы) Тогда
			Если ТипЗнч(СогласующиеЛица[i].Пользователь)=Тип("СправочникСсылка.Пользователи")
			 		ИЛИ ТипЗнч(СогласующиеЛица[i].Пользователь)=Тип("СправочникСсылка.aps_ГруппыИсполнителей") Тогда
				СтрокаСогласующиеЛица = БизнесПроцессСогласования.СогласующиеЛица.Добавить();
				СтрокаСогласующиеЛица.Пользователь = СогласующиеЛица[i].Пользователь;
				СтрокаСогласующиеЛица.Заместитель = СогласующиеЛица[i].Заместитель;
				СтрокаСогласующиеЛица.СрокОтправкиЗаместителю = ПолучитьЗначениеСрокаОтправки(СогласующиеЛица[i].СрокОтправкиЗаместителю);
			Иначе
				// группа пользователей
				Для Каждого СтрокаПользователь Из СогласующиеЛица[i].Пользователь.ПользователиГруппы Цикл
					СтрокаСогласующиеЛица = БизнесПроцессСогласования.СогласующиеЛица.Добавить();
					СтрокаСогласующиеЛица.Пользователь = СтрокаПользователь.Пользователь;
					СтрокаСогласующиеЛица.Заместитель = СогласующиеЛица[i].Заместитель;
					СтрокаСогласующиеЛица.СрокОтправкиЗаместителю = ПолучитьЗначениеСрокаОтправки(СогласующиеЛица[i].СрокОтправкиЗаместителю);
				КонецЦикла;
			КонецЕсли;
			i=i+1;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	ИндексПоследнейГруппы=i;
	Записать();
	
КонецПроцедуры

Процедура ПеревестиВСостояниеСогласованияОбработка(ТочкаМаршрутаБизнесПроцесса)
	#Если Клиент Или ВнешнееСоединение Тогда 
		// гл. переменная
	#Иначе
		aps_СтруктураПараметровОповещения=aps_СтруктураПараметровОповещенияНаСервере;
	#КонецЕсли
	
	ТекущийПользователь=ПараметрыСеанса.ТекущийПользователь;
	ПримененнаяПолитика=ПараметрыСеанса.aps_ПримененнаяПолитика;
	// изменение состояний элементов выполняется от лица системы
	ПараметрыСеанса.ТекущийПользователь=Справочники.Пользователи.ПустаяСсылка();
	aps_ПолныеПрава.aps_ОбновитьПолитикуТекущегоПользователя();
	
	тзНепереведенныеЭлементы.Очистить();
	
	Попытка
		НачатьТранзакцию();
		
			Для Каждого СтрокаСостояния Из Состояния Цикл
				item = СтрокаСостояния.ЭлементСсылка;
				
				ПараметрСостояние=МодульСозданияПараметров.aps_ВспомНайтиПараметрПоСвойству(item, ПланыВидовХарактеристик.aps_Свойства.Состояние);
				Если ПараметрСостояние.Значение <> Перечисления.aps_СостоянияЭлемента.Согласование Тогда 
					Если НЕ ПараметрСостояние.Пустая() Тогда 
						Если НЕ МодульПравДоступа.aps_ПроверитьОбъектПрава( Справочники.aps_Права.Изменение, ПараметрСостояние, ПараметрСостояние.GMOD ) Тогда 
							СтрокаНепереведенного = тзНепереведенныеЭлементы.Добавить();
							СтрокаНепереведенного.ЭлементСсылка		= item;
							СтрокаНепереведенного.ИсходноеСостояние	= СтрокаСостояния.ИсходноеСостояние;
							СтрокаНепереведенного.ЦелевоеСостояние	= Перечисления.aps_СостоянияЭлемента.Согласование;
							СтрокаНепереведенного.Причина = НСтр("ru = ""Параметр <""; en_US = ""The <""")+Строка(ПланыВидовХарактеристик.aps_Свойства.Состояние)+НСтр("ru = "">. ""; en_US = ""> parameter. """)+НСтр("ru = ""Отсутствует право изменения!""; en_US = ""Change permission is missing!""");
							Продолжить;
						КонецЕсли;
					Иначе // нет параметра, проверяем право изменения самого элемента
						Если НЕ МодульПравДоступа.aps_ПроверитьОбъектПрава( Справочники.aps_Права.Изменение, item, item.GMOD ) Тогда 
							СтрокаНепереведенного = тзНепереведенныеЭлементы.Добавить();
							СтрокаНепереведенного.ЭлементСсылка		= item;
							СтрокаНепереведенного.ИсходноеСостояние	= СтрокаСостояния.ИсходноеСостояние;
							СтрокаНепереведенного.ЦелевоеСостояние	= Перечисления.aps_СостоянияЭлемента.Согласование;
							СтрокаНепереведенного.Причина = НСтр("ru = ""Отсутствует право изменения!""; en_US = ""Change permission is missing!""");
							Продолжить;
						КонецЕсли;
					КонецЕсли;
					
					item_obj = item.ПолучитьОбъект();
					aps_СтруктураПараметровОповещения.Вставить("itemObject",item_obj);
					aps_ОбработчикиСобытий.aps_ВыполнитьСобытие(Перечисления.aps_События.ПриПереходеНаСогласование, aps_СтруктураПараметровОповещения);
				
					МодульСозданияПараметров.aps_УстановкаПараметра(item_obj, ПланыВидовХарактеристик.aps_Свойства.Состояние, Перечисления.aps_СостоянияЭлемента.Согласование);
					item_obj.Записать();
				КонецЕсли; // Если ПараметрСостояние.Значение <> Перечисления.aps_СостоянияЭлемента.Согласование Тогда 
			КонецЦикла;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		
		ПараметрыСеанса.ТекущийПользователь=ТекущийПользователь;
		ПараметрыСеанса.aps_ПримененнаяПолитика=ПримененнаяПолитика;
		
		Сообщить(ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
		
	
	Если тзНепереведенныеЭлементы.Количество() > 0 Тогда 
		СтрокаСообщения = ПараметрыСеанса.aps_ИмяПродукта+НСтр("ru = ""Не удалось перевести в состояние согласования следующие элементы:""; en_US = ""Cannot translate following items to the intermediate status:""");
		Для i=0 По тзНепереведенныеЭлементы.Количество()-1 Цикл  
			СтрокаСообщения=СтрокаСообщения+Символы.ПС+Строка(тзНепереведенныеЭлементы[i].ЭлементСсылка)+". "+тзНепереведенныеЭлементы[i].Причина;
		КонецЦикла;
		Сообщить(СтрокаСообщения, СтатусСообщения.Внимание);
	КонецЕсли;
	
	ПараметрыСеанса.ТекущийПользователь=ТекущийПользователь;
	ПараметрыСеанса.aps_ПримененнаяПолитика=ПримененнаяПолитика;
КонецПроцедуры

Процедура ПеревестиВСостояниеОбработка(ТочкаМаршрутаБизнесПроцесса)
	#Если Клиент Или ВнешнееСоединение Тогда 
		// гл. переменная
	#Иначе
		aps_СтруктураПараметровОповещения=aps_СтруктураПараметровОповещенияНаСервере;
	#КонецЕсли
	
	ТекущийПользователь=ПараметрыСеанса.ТекущийПользователь;
	ПримененнаяПолитика=ПараметрыСеанса.aps_ПримененнаяПолитика;
	// изменение состояний элементов выполняется от лица системы
	ПараметрыСеанса.ТекущийПользователь=Справочники.Пользователи.ПустаяСсылка();
	aps_ПолныеПрава.aps_ОбновитьПолитикуТекущегоПользователя();
	
	тзНепереведенныеЭлементы.Очистить();
	
	Попытка
		НачатьТранзакцию();
	
			Для Каждого СтрокаСостояния Из Состояния Цикл
				item = СтрокаСостояния.ЭлементСсылка;
				
				Если НЕ СтрокаСостояния.Согласован Тогда 
					ЦелевоеСостояние = СтрокаСостояния.ИсходноеСостояние;
				Иначе
				    ЦелевоеСостояние = СтрокаСостояния.ЦелевоеСостояние;
				КонецЕсли;
				
				ПараметрСостояние=МодульСозданияПараметров.aps_ВспомНайтиПараметрПоСвойству(item, ПланыВидовХарактеристик.aps_Свойства.Состояние);
				Если ПараметрСостояние.Значение <> ЦелевоеСостояние Тогда 
					Если НЕ ПараметрСостояние.Пустая() Тогда 
						Если НЕ МодульПравДоступа.aps_ПроверитьОбъектПрава( Справочники.aps_Права.Изменение, ПараметрСостояние, ПараметрСостояние.GMOD ) Тогда 
							СтрокаНепереведенного = тзНепереведенныеЭлементы.Добавить();
							СтрокаНепереведенного.ЭлементСсылка		= item;
							СтрокаНепереведенного.ИсходноеСостояние	= ?(СогласующиеЛица.Количество()>0, Перечисления.aps_СостоянияЭлемента.Согласование, СтрокаСостояния.ИсходноеСостояние);
							СтрокаНепереведенного.ЦелевоеСостояние	= ЦелевоеСостояние;
							СтрокаНепереведенного.Причина = НСтр("ru = ""Параметр <""; en_US = ""The <""")+Строка(ПланыВидовХарактеристик.aps_Свойства.Состояние)+НСтр("ru = "">. ""; en_US = ""> parameter. """)+НСтр("ru = ""Отсутствует право изменения!""; en_US = ""Change permission is missing!""");
							Продолжить;
						КонецЕсли;
					Иначе // нет параметра, проверяем право изменения самого элемента
						Если НЕ МодульПравДоступа.aps_ПроверитьОбъектПрава( Справочники.aps_Права.Изменение, item, item.GMOD ) Тогда 
							СтрокаНепереведенного = тзНепереведенныеЭлементы.Добавить();
							СтрокаНепереведенного.ЭлементСсылка		= item;
							СтрокаНепереведенного.ИсходноеСостояние	= ?(СогласующиеЛица.Количество()>0, Перечисления.aps_СостоянияЭлемента.Согласование, СтрокаСостояния.ИсходноеСостояние);
							СтрокаНепереведенного.ЦелевоеСостояние	= ЦелевоеСостояние;
							СтрокаНепереведенного.Причина = НСтр("ru = ""Отсутствует право изменения!""; en_US = ""Change permission is missing!""");
							Продолжить;
						КонецЕсли;
					КонецЕсли;

					item_obj = item.ПолучитьОбъект();
					aps_СтруктураПараметровОповещения.Вставить("itemObject",item_obj); 
					Если ЦелевоеСостояние = Перечисления.aps_СостоянияЭлемента.Разработка Тогда
						aps_ОбработчикиСобытий.aps_ВыполнитьСобытие(Перечисления.aps_События.ПриПереходеВРазработку, aps_СтруктураПараметровОповещения);
					ИначеЕсли ЦелевоеСостояние = Перечисления.aps_СостоянияЭлемента.Архив Тогда
						aps_ОбработчикиСобытий.aps_ВыполнитьСобытие(Перечисления.aps_События.ПриПереходеВАрхив, aps_СтруктураПараметровОповещения);
					ИначеЕсли ЦелевоеСостояние = Перечисления.aps_СостоянияЭлемента.Неиспользуемый Тогда
						aps_ОбработчикиСобытий.aps_ВыполнитьСобытие(Перечисления.aps_События.ПриПереходеВНеиспользуемое, aps_СтруктураПараметровОповещения);
					КонецЕсли;
					
					МодульСозданияПараметров.aps_УстановкаПараметра(item_obj, ПланыВидовХарактеристик.aps_Свойства.Состояние, ЦелевоеСостояние);
					item_obj.Записать();
				КонецЕсли; // Если ПараметрСостояние.Значение <> ЦелевоеСостояние Тогда
				
				
				Если ЦелевоеСостояние=Перечисления.aps_СостоянияЭлемента.Архив Тогда 
					// изменение состояний архивных ревизий
					МассивРевизийИзменения = МодульСозданияРевизий.aps_СформироватьМассивРевизийИзменения(item);
					Для Каждого Ревизия Из МассивРевизийИзменения Цикл
						ПараметрСостояние = МодульСозданияПараметров.aps_ВспомНайтиПараметрПоСвойству(Ревизия, ПланыВидовХарактеристик.aps_Свойства.Состояние);
						Если Ревизия <> item И ПараметрСостояние.Значение = Перечисления.aps_СостоянияЭлемента.Архив Тогда
							Если НЕ ПараметрСостояние.Пустая() Тогда 
								Если НЕ МодульПравДоступа.aps_ПроверитьОбъектПрава( Справочники.aps_Права.Изменение, ПараметрСостояние, ПараметрСостояние.GMOD ) Тогда 
									СтрокаНепереведенного = тзНепереведенныеЭлементы.Добавить();
									СтрокаНепереведенного.ЭлементСсылка		= Ревизия;
									СтрокаНепереведенного.ИсходноеСостояние	= Перечисления.aps_СостоянияЭлемента.Архив;
									СтрокаНепереведенного.ЦелевоеСостояние	= Перечисления.aps_СостоянияЭлемента.Неиспользуемый;
									СтрокаНепереведенного.Причина = НСтр("ru = ""Параметр <""; en_US = ""The <""")+Строка(ПланыВидовХарактеристик.aps_Свойства.Состояние)+НСтр("ru = "">. ""; en_US = ""> parameter. """)+НСтр("ru = ""Отсутствует право изменения!""; en_US = ""Change permission is missing!""");
									Продолжить;
								КонецЕсли;
							Иначе // нет параметра, проверяем право изменения самого элемента
								Если НЕ МодульПравДоступа.aps_ПроверитьОбъектПрава( Справочники.aps_Права.Изменение, Ревизия, Ревизия.GMOD ) Тогда 
									СтрокаНепереведенного = тзНепереведенныеЭлементы.Добавить();
									СтрокаНепереведенного.ЭлементСсылка		= Ревизия;
									СтрокаНепереведенного.ИсходноеСостояние	= Перечисления.aps_СостоянияЭлемента.Архив;
									СтрокаНепереведенного.ЦелевоеСостояние	= Перечисления.aps_СостоянияЭлемента.Неиспользуемый;
									СтрокаНепереведенного.Причина = НСтр("ru = ""Отсутствует право изменения!""; en_US = ""Change permission is missing!""");
									Продолжить;
								КонецЕсли;
							КонецЕсли;
							
							ОбъектРевизии = Ревизия.ПолучитьОбъект();
							aps_СтруктураПараметровОповещения.Вставить("itemObject",ОбъектРевизии); 
							aps_ОбработчикиСобытий.aps_ВыполнитьСобытие(Перечисления.aps_События.ПриПереходеВНеиспользуемое, aps_СтруктураПараметровОповещения);
							
							МодульСозданияПараметров.aps_УстановкаПараметра(ОбъектРевизии, ПланыВидовХарактеристик.aps_Свойства.Состояние, Перечисления.aps_СостоянияЭлемента.Неиспользуемый);
							ОбъектРевизии.Записать();
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;
			
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		
		ПараметрыСеанса.ТекущийПользователь=ТекущийПользователь;
		ПараметрыСеанса.aps_ПримененнаяПолитика=ПримененнаяПолитика;
		
		ВызватьИсключение КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	
	Если тзНепереведенныеЭлементы.Количество() > 0 Тогда 
		СтрокаСообщения = ПараметрыСеанса.aps_ИмяПродукта+НСтр("ru = ""Не удалось перевести в целевое состояние следующие элементы:""; en_US = ""Cannot translate following items to the goal status:""");
		Для i=0 По тзНепереведенныеЭлементы.Количество()-1 Цикл  
			СтрокаСообщения=СтрокаСообщения+Символы.ПС+Строка(тзНепереведенныеЭлементы[i].ЭлементСсылка)+". "+тзНепереведенныеЭлементы[i].Причина;
		КонецЦикла;
		Сообщить(СтрокаСообщения, СтатусСообщения.Внимание);
	КонецЕсли;
	
	ПараметрыСеанса.ТекущийПользователь=ТекущийПользователь;
	ПараметрыСеанса.aps_ПримененнаяПолитика=ПримененнаяПолитика;
КонецПроцедуры

Процедура ВсеУведомленияОтправленыПроверкаУсловия(ТочкаМаршрутаБизнесПроцесса, Результат)
	Результат=(ИндексПоследнейГруппы > СогласующиеЛица.Количество()-1) 
		ИЛИ Состояния.НайтиСтроки(Новый Структура("Согласован", Истина)).Количество()=0;
КонецПроцедуры

Процедура ПеревестиЭлементыПередСозданиемЗадач(ТочкаМаршрутаБизнесПроцесса, ФормируемыеЗадачи, СтандартнаяОбработка)
	ФормируемыеЗадачи.Очистить();
	
	ЗапросЗадачи = Новый Запрос("ВЫБРАТЬ
	                          |	aps_ИзменениеСостоянияЭлементов.Ссылка
	                          |ИЗ
	                          |	Задача.aps_ИзменениеСостоянияЭлементов КАК aps_ИзменениеСостоянияЭлементов
	                          |ГДЕ
	                          |	aps_ИзменениеСостоянияЭлементов.БизнесПроцесс = &БизнесПроцесс
	                          |	И aps_ИзменениеСостоянияЭлементов.ТочкаМаршрута = &ТочкаМаршрута
	                          |	И aps_ИзменениеСостоянияЭлементов.Выполнена");
	ЗапросЗадачи.УстановитьПараметр("БизнесПроцесс", Ссылка);
	ЗапросЗадачи.УстановитьПараметр("ТочкаМаршрута", ТочкаМаршрутаБизнесПроцесса);
	Выборка = ЗапросЗадачи.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		ЗадачаИзменения = Выборка.Ссылка.ПолучитьОбъект();
		ЗадачаИзменения.Выполнена = Ложь;
		ЗадачаИзменения.Состояния.Загрузить(тзНепереведенныеЭлементы);
		ЗадачаИзменения.Записать();
		
	Иначе // создать задачу перевода элементов и отправить ответственному
		ЗадачаИзменения = Задачи.aps_ИзменениеСостоянияЭлементов.СоздатьЗадачу();
		ЗадачаИзменения.БизнесПроцесс = Ссылка;
		ЗадачаИзменения.ТочкаМаршрута = ТочкаМаршрутаБизнесПроцесса;
		ЗадачаИзменения.Наименование = НСтр("ru = ""Изменение состояний элементов""; en_US = ""Status management""");
		ЗадачаИзменения.Дата = ТекущаяДата();
		ЗадачаИзменения.Состояния.Загрузить(тзНепереведенныеЭлементы);
		ЗадачаИзменения.Записать();
		
		МассивВложений = Новый Массив;
		МассивВложений.Добавить(ЗадачаИзменения.Ссылка);
		ТемаУведомления = НСтр("ru = ""Изменение состояний элементов""; en_US = ""Status management""")+?(ЗначениеЗаполнено(Комментарий), " ("+Комментарий+")", "");
		ТекстУведомления = НСтр("ru = ""При переводе элементов в целевое состояние возникли ошибки""; en_US = ""Errors on translating items to the goal statuses""");
		
		aps_СоздатьУведомление(, ОтветственныйЗаВыполнение,, ТемаУведомления, 
						ТекстУведомления,, МассивВложений, Истина, Ложь,, Истина);						
	КонецЕсли;
	
	ФормируемыеЗадачи.Добавить(ЗадачаИзменения.Ссылка);
	
КонецПроцедуры

Процедура ЕстьНепереведенныеЭлементыПроверкаУсловия(ТочкаМаршрутаБизнесПроцесса, Результат)
	Результат = тзНепереведенныеЭлементы.Количество()>0;
КонецПроцедуры


Процедура УведомитьУчастниковОбработка(ТочкаМаршрутаБизнесПроцесса)
	
	МассивВложений=Новый Массив;
	МассивВложений.Добавить(Ссылка);
	
	ОбщийМассивПользователей=Новый Массив();
	
	Для Каждого СтрокаУведомляемыеЛица Из УведомляемыеЛица Цикл
		Если ЗначениеЗаполнено(СтрокаУведомляемыеЛица.Пользователь) Тогда
			Если ТипЗнч(СтрокаУведомляемыеЛица.Пользователь)=Тип("СправочникСсылка.Пользователи") Тогда
				ОбщийМассивПользователей.Добавить(СтрокаУведомляемыеЛица.Пользователь);
			Иначе // группа пользователей
				Для Каждого СтрокаПользователь Из СтрокаУведомляемыеЛица.Пользователь.ПользователиГруппы Цикл 
					ОбщийМассивПользователей.Добавить(СтрокаПользователь.Пользователь);
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если ОбщийМассивПользователей.Найти(Автор)=Неопределено Тогда 
		ОбщийМассивПользователей.Добавить(Автор);
	КонецЕсли;
	
	ТемаУведомления = НСтр("ru = ""Изменение состояний элементов""; en_US = ""Status management""")+?(ЗначениеЗаполнено(Комментарий), " ("+Комментарий+")", "");
	СодержаниеУведомления = НСтр("ru = 'Было произведено изменение состояний элементов.'; en_US = 'Statuses changing of items completed.'");
	
	Для Каждого Пользователь Из ОбщийМассивПользователей Цикл 
		aps_СоздатьУведомление(, Пользователь,, ТемаУведомления, СодержаниеУведомления,, МассивВложений, Ложь, Ложь,, Истина);
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьЗначениеСрокаОтправки(СрокОтправки)
	Если НЕ ЗначениеЗаполнено(СрокОтправки) Или ТипЗнч(СрокОтправки) = Тип("Дата") Тогда
		Возврат СрокОтправки;
	Иначе // строка
		Возврат ТекущаяДата()+ЗначенияСрокаОтправки[СрокОтправки];
	КонецЕсли;
КонецФункции


Процедура ПередЗаписью(Отказ)
	Если НЕ ЗначениеЗаполнено(Дата) Тогда
		Дата = ТекущаяДата();
	КонецЕсли;
		
	// пометить (снять пометку) задачи и вложенные бизнес-процессы
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ
	               |	aps_Поручение.Ссылка,
	               |	aps_Поручение.ПометкаУдаления,
	               |	aps_Поручение.БизнесПроцесс
	               |ИЗ
	               |	Задача.aps_Поручение КАК aps_Поручение
	               |ГДЕ
	               |	ВЫРАЗИТЬ(aps_Поручение.БизнесПроцесс.ВедущаяЗадача КАК Задача.aps_ИзменениеСостоянияЭлементов).БизнесПроцесс = &БизнесПроцесс
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	aps_ИзменениеСостоянияЭлементов.Ссылка,
	               |	aps_ИзменениеСостоянияЭлементов.ПометкаУдаления,
	               |	aps_ИзменениеСостоянияЭлементов.БизнесПроцесс
	               |ИЗ
	               |	Задача.aps_ИзменениеСостоянияЭлементов КАК aps_ИзменениеСостоянияЭлементов
	               |ГДЕ
	               |	aps_ИзменениеСостоянияЭлементов.БизнесПроцесс = &БизнесПроцесс";
	Запрос.УстановитьПараметр("БизнесПроцесс", Ссылка);
	ЗадачиПоБизнесПроцессу = Запрос.Выполнить().Выгрузить();
	Для i=0 По ЗадачиПоБизнесПроцессу.Количество()-1 Цикл 
		Если ЗадачиПоБизнесПроцессу[i].ПометкаУдаления <> ПометкаУдаления Тогда 
			ЗадачиПоБизнесПроцессу[i].Ссылка.ПолучитьОбъект().УстановитьПометкуУдаления(ПометкаУдаления);
		КонецЕсли;
		// вложенный бизнес-процесс согласования
		Если ЗадачиПоБизнесПроцессу[i].БизнесПроцесс <> Ссылка И ЗадачиПоБизнесПроцессу[i].БизнесПроцесс.ПометкаУдаления <> ПометкаУдаления Тогда 
			ЗадачиПоБизнесПроцессу[i].БизнесПроцесс.ПолучитьОбъект().УстановитьПометкуУдаления(ПометкаУдаления);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ЗавершениеПриЗавершении(ТочкаМаршрутаБизнесПроцесса, Отказ)
	Извещение = aps_ПолучитьИИПоСсылкеНаБПИзмененияСостояний(Ссылка);
	Если НЕ Извещение.Пустая() И НЕ Извещение.ПометкаУдаления И НЕ Извещение.Проведен
				И Состояния.Найти(Ложь, "Согласован") = Неопределено Тогда 
		Попытка // провести извещение
			ДокументОбъект=Извещение.ПолучитьОбъект();
			ДокументОбъект.ДополнительныеСвойства.Вставить("ЗавершениеБП", Истина);
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			Отказ=Истина;
			Сообщить(ПараметрыСеанса.aps_ИмяПродукта+КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), СтатусСообщения.Внимание);
		КонецПопытки;
	КонецЕсли;
	
	
	Если НЕ Отказ Тогда 
		#Если Клиент Или ВнешнееСоединение Тогда 
			// гл. переменная
		#Иначе
			aps_СтруктураПараметровОповещения=aps_СтруктураПараметровОповещенияНаСервере;
		#КонецЕсли
		
		aps_СтруктураПараметровОповещения.Вставить("itemObject",ЭтотОбъект);
		aps_ОбработчикиСобытий.aps_ВыполнитьСобытие(Перечисления.aps_События.ПриЗавершенииБПИзмененияСостояний, aps_СтруктураПараметровОповещения);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти


#Область Инициализация

МодульСозданияПараметров = Обработки.aps_СозданиеПараметров.Создать();
МодульСозданияРевизий	 = Обработки.aps_СозданиеРевизий.Создать();
МодульПравДоступа		 = Обработки.aps_ПраваДоступа.Создать();


ЗначенияСрокаОтправки = Новый Соответствие;
ЗначенияСрокаОтправки.Вставить("Через час", 3600); ЗначенияСрокаОтправки.Вставить("In an hour", 3600);
ЗначенияСрокаОтправки.Вставить("Через 3 часа", 10800); ЗначенияСрокаОтправки.Вставить("In three hours", 10800);
ЗначенияСрокаОтправки.Вставить("Через день", 86400); ЗначенияСрокаОтправки.Вставить("In a day", 86400);
ЗначенияСрокаОтправки.Вставить("Через 3 дня", 259200); ЗначенияСрокаОтправки.Вставить("In three days", 259200);
ЗначенияСрокаОтправки.Вставить("Через неделю", 604800); ЗначенияСрокаОтправки.Вставить("In a week", 604800);

тзНепереведенныеЭлементы = Новый ТаблицаЗначений;
тзНепереведенныеЭлементы.Колонки.Добавить("ЭлементСсылка");
тзНепереведенныеЭлементы.Колонки.Добавить("ИсходноеСостояние");
тзНепереведенныеЭлементы.Колонки.Добавить("ЦелевоеСостояние");
тзНепереведенныеЭлементы.Колонки.Добавить("Причина");

#Если Сервер Тогда 
aps_СтруктураПараметровОповещенияНаСервере=Новый Структура();
#КонецЕсли

#КонецОбласти

#КонецЕсли

