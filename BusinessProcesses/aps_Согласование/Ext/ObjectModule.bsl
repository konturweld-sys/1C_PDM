Процедура СогласоватьПередСозданиемЗадач(ТочкаМаршрутаБизнесПроцесса, ФормируемыеЗадачи, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	БПИзменениеСостояния = ВедущаяЗадача.БизнесПроцесс;
	
	Для Каждого Строка Из СогласующиеЛица Цикл
		Для Каждого СтрокаСостояния Из ВедущаяЗадача.БизнесПроцесс.Состояния Цикл
			Если НЕ СтрокаСостояния.Согласован Тогда 
				Продолжить;
			КонецЕсли;
			
			Поручение = Задачи.aps_Поручение.СоздатьЗадачу();
			Поручение.БизнесПроцесс = Ссылка;
			Поручение.ТочкаМаршрута = ТочкаМаршрутаБизнесПроцесса;
			Поручение.Наименование  = "<" + Строка(СтрокаСостояния.ЭлементСсылка) + ">";
			Поручение.Дата			= ТекущаяДата();
			// согласование одного элемента
			СтрокаЭлемента = Поручение.Состояния.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаЭлемента, СтрокаСостояния);
			Поручение.Заместитель				= Строка.Заместитель;
			Поручение.СрокСогласования			= БПИзменениеСостояния.СрокСогласования;
			Поручение.СрокОтправкиЗаместителю	= Строка.СрокОтправкиЗаместителю;
			
			Если ТипЗнч(Строка.Пользователь) = Тип("СправочникСсылка.Пользователи") Тогда
				Поручение.Исполнители.Добавить().Пользователь = Строка.Пользователь;
			Иначе // группа исполнителей
				Для Каждого СтрокаПользователя Из Строка.Пользователь.Исполнители Цикл
					Поручение.Исполнители.Добавить().Пользователь = СтрокаПользователя.Пользователь;
				КонецЦикла;
			КонецЕсли;
			
			Если Поручение.Исполнители.Количество()=1 Тогда 
				Поручение.Исполнитель = Поручение.Исполнители[0].Пользователь; // исполнитель однозначно определен
			КонецЕсли;
			
			Поручение.Записать();
		КонецЦикла;
		
		ТемаУведомления = НСтр("ru = ""Изменение состояний элементов""; en_US = ""Status management""")+?(ЗначениеЗаполнено(БПИзменениеСостояния.Комментарий), " ("+БПИзменениеСостояния.Комментарий+")", "");
		ТекстУведомления = НСтр("ru = ""Вам направлены поручения по изменению состояний элементов. Бизнес-процесс находится во вложении.""; en_US = ""Status management process is attached.""");
		МассивВложений = Новый Массив();
		МассивВложений.Добавить(БПИзменениеСостояния);
		
		Если ТипЗнч(Строка.Пользователь) = Тип("СправочникСсылка.Пользователи") Тогда
			aps_СоздатьУведомление(БПИзменениеСостояния.Автор, Строка.Пользователь,, ТемаУведомления, ТекстУведомления,, МассивВложений, Истина, Ложь,, Истина);
		Иначе //группа исполнителей
			Для Каждого СтрокаПользователя Из Строка.Пользователь.Исполнители Цикл 
				aps_СоздатьУведомление(БПИзменениеСостояния.Автор, Строка.Пользователь,, ТемаУведомления, ТекстУведомления,, МассивВложений, Истина, Ложь,, Истина);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗавершениеПриЗавершении(ТочкаМаршрутаБизнесПроцесса, Отказ)
	
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ
	               |	СогласованныеСостояния.ЭлементСсылка КАК ЭлементСсылка
	               |ИЗ
	               |	Задача.aps_Поручение.Состояния КАК СогласованныеСостояния
	               |ГДЕ
	               |	СогласованныеСостояния.Ссылка.БизнесПроцесс = &БизнесПроцесс
	               |	И (НЕ СогласованныеСостояния.Ссылка.Согласовано)
	               |	И (НЕ СогласованныеСостояния.Ссылка.ПометкаУдаления)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	СогласованныеСостояния.ЭлементСсылка,
	               |	СогласованныеСостояния.ИсходноеСостояние,
	               |	СогласованныеСостояния.ЦелевоеСостояние";
		
	Запрос.УстановитьПараметр("БизнесПроцесс"	, Ссылка);
	СогласованныеСостояния = Запрос.Выполнить().Выгрузить();
		
	Если ЗначениеЗаполнено(ВедущаяЗадача) Тогда 
		ОбъектБизнесПроцесса = ВедущаяЗадача.БизнесПроцесс.ПолучитьОбъект();
		Для Каждого СтрокаСостояния Из ОбъектБизнесПроцесса.Состояния Цикл 
			Если СогласованныеСостояния.Найти(СтрокаСостояния.ЭлементСсылка) <> Неопределено Тогда
				СтрокаСостояния.Согласован = Ложь;
			КонецЕсли;
		КонецЦикла;
		ОбъектБизнесПроцесса.Записать();
	КонецЕсли;
КонецПроцедуры

Процедура СогласоватьОбработкаПроверкиВыполнения(ТочкаМаршрутаБизнесПроцесса, Задача, Результат)
	Результат = Истина;
КонецПроцедуры

