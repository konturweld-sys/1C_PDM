Процедура ОбновитьXDTOПоГоризонтальнойСвязи(МассивXDTO, ПравилоУправления)
	МодульПроводника=Обработки.aps_Проводник.Создать();
	МодульПроводника.aps_ОбновитьМодельXDTOРек(МассивXDTO, ПравилоУправления, 99999, Ложь);
	МассивСпрГеом=Новый Массив;
	Для Каждого itemXDTO Из МассивXDTO Цикл
		aps_НайтиВМоделиXDTO( itemXDTO, Новый Структура("linkType,refLinkGroup",
			Справочники.aps_ШаблоныТехнологическихСвязей.СправочнаяГеометрия, Ложь ), МассивСпрГеом, Истина, Истина );
	КонецЦикла;
	Если МассивСпрГеом.Количество()>0 Тогда	
		ОбновитьXDTOПоГоризонтальнойСвязи( МассивСпрГеом, ПравилоУправления );
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#КонецЕсли