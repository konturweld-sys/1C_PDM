// Функция формирует список всех зависимых файлов активного документа с xdto-моделями изделий и документов
// Параметры:
//		activeDocXDTOСтрока - xdto-строка активного документа
//		ПравилоУправления - правило управления для построения модели изделия
// Возвращаемое значение:
//		ТаблицаЗначений
// Пример:
//		ЗависимыеФайлы = aps_Сервер1.aps_cadПолучитьЗависимыеФайлы( activeDocXDTOСтрока, ПравилоУправления );
//
Функция aps_cadПолучитьЗависимыеФайлы( activeDocXDTOСтрока, ПравилоУправления ) Экспорт 
	АктивныйДокумент=Строка2XDTO(activeDocXDTOСтрока).element;
	
	МодульРаботыСФайлами=Обработки.aps_ФайлыДокумента.Создать();
	МодульПравДоступа=Обработки.aps_ПраваДоступа.Создать();
	
	ПрименяемостьАктДокумента=aps_Итераторы.aps_Применяемость(АктивныйДокумент,, Перечисления.aps_ВидыСвязей.СоставИзделия);
	Если ПрименяемостьАктДокумента.Количество()=0 Тогда 
		ПрименяемостьАктДокумента.Добавить().ЭлементСсылка=АктивныйДокумент;
	КонецЕсли;
	
	МассивИзделийXDTO=Новый Массив();
	Для i=0 По ПрименяемостьАктДокумента.Количество()-1 Цикл 
		itemXDTO=aps_СоздатьОбъектМоделиXDTO(ПрименяемостьАктДокумента[i].ЭлементСсылка);
		МассивИзделийXDTO.Добавить(itemXDTO);
	КонецЦикла;
	
	// построить модель изделия, включая горизонтальные связи "справочная геометрия"
	ОбновитьXDTOПоГоризонтальнойСвязи(МассивИзделийXDTO, ПравилоУправления);
	
	МодельXDTOДляПоискаЗависимых=ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("http://appius.ru/pdm", "item"));
	Для Каждого itemXDTO Из МассивИзделийXDTO Цикл 
		МодельXDTOДляПоискаЗависимых.items.Добавить(itemXDTO);
	КонецЦикла;
	
	ФайлыАктДокумента=aps_РаботаСФайламиСервер.aps_ПолучитьФайлыДокумента(АктивныйДокумент);
	ЗависимыеРасширения=aps_РаботаСФайламиСервер.aps_ПолучитьЗависимыеРасширения(ФайлыАктДокумента.ВыгрузитьКолонку("Расширение"));
	// найти зависимые активные документы в xdto-модели изделия
	ЗависимыеФайлы=МодульРаботыСФайлами.aps_ПоискЗависимыхФайловПоМодели(МодельXDTOДляПоискаЗависимых, ЗависимыеРасширения);
	// добавить файлы активного документа в общий список файлов для выгрузки
	Для i=0 По ФайлыАктДокумента.Количество()-1 Цикл 
		Если ЗависимыеФайлы.Найти(ФайлыАктДокумента[i].Ссылка)=Неопределено Тогда 
			СтрокаЗависимого = ЗависимыеФайлы.Добавить();
			СтрокаЗависимого.itemDocXDTO = activeDocXDTOСтрока;
			
			ИзделиеXDTO = МассивИзделийXDTO[0];
			Если ИзделиеXDTO.element <> АктивныйДокумент Тогда 
				itemXDTO=ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("http://appius.ru/pdm", "item"));
				itemXDTO.element=СериализаторXDTO.ЗаписатьXDTO(ИзделиеXDTO.element);
				СтрокаЗависимого.itemXDTO = XDTO2Строка(itemXDTO);
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(СтрокаЗависимого, ФайлыАктДокумента[i]);
		КонецЕсли;
	КонецЦикла;
	
	i=0;
	Пока i < ЗависимыеФайлы.Количество() Цикл 
		Если ЗависимыеФайлы[i].Невыгружаемый ИЛИ НЕ МодульПравДоступа.aps_ПроверитьОбъектПрава(Справочники.aps_Права.Просмотр, ЗависимыеФайлы[i].Документ, ЗависимыеФайлы[i].Документ.GMOD) Тогда 
			ЗависимыеФайлы.Удалить(i); // исключить из списка невыгружаемые, а также недоступные для просмотра файлы
		Иначе 
			i=i+1;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ЗависимыеФайлы;
КонецФункции

// Функция добавляет параметр к таблице параметров
//
// Параметры
//		ТаблицаПараметров
//		ИмяПараметра
//		ЗначениеПараметра
// Возвращаемое значение:
//		ТаблицаЗначений
// Пример:
//		ТаблицаПараметров = aps_Сервер1.aps_cadДобавитьКПараметрам( ТаблицаПараметров, ИмяПараметра, "" );
//
Функция aps_cadДобавитьКПараметрам( ТаблицаПараметров, ИмяПараметра, ЗначениеПараметра ) Экспорт
	Если ТаблицаПараметров=Неопределено Тогда
		ТаблицаПараметров = Новый ТаблицаЗначений();
		
		ТаблицаПараметров.Колонки.Добавить("Имя"	 , Новый ОписаниеТипов("Строка"));
		ТаблицаПараметров.Колонки.Добавить("Свойство", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.aps_Свойства"));
		ТаблицаПараметров.Колонки.Добавить("Значение");
	КонецЕсли;
	
	ИндексAt=Найти(ИмяПараметра,"@");
	Если ИндексAt>0 Тогда
		ИмяПеременной=Сред(ИмяПараметра,1,ИндексAt-1);
		НаименованиеСвойства=Сред(ИмяПараметра,ИндексAt+1);
	Иначе
		ИмяПеременной=ИмяПараметра;
		НаименованиеСвойства=ИмяПараметра;
	КонецЕсли;
	
	Свойство = ПланыВидовХарактеристик.aps_Свойства.НайтиПоНаименованию(НаименованиеСвойства, Истина);
	Если НЕ Свойство.Пустая() И НЕ Свойство.ЭтоГруппа Тогда 
		СтрокаТаблицы = ТаблицаПараметров.Добавить();
		СтрокаТаблицы.Имя = ИмяПеременной;
		СтрокаТаблицы.Свойство = Свойство;
		СтрокаТаблицы.Значение = aps_ПреобразоватьЗначениеПараметра(ЗначениеПараметра, Свойство.ТипЗначения);
	КонецЕсли;
	
	Возврат ТаблицаПараметров;
КонецФункции

// Создает новый элемент структуры изделия
// Параметры:
//		ТипИзделия - номер типа изделия
//      ТаблицаПараметров - таблица параметров
// Возвращаемое значение
//		Строка xdto
// Пример:
//      СтрокаИзделия = aps_Сервер1.aps_cadСоздатьИзделие( ТипИзделия, ТаблицаПараметров, НайденСуществующий, elementTypeID );
//
Функция aps_cadСоздатьИзделие( ТипИзделия, ТаблицаПараметров, НайденСуществующий, elementTypeID ) Экспорт
	Если НЕ ПустаяСтрока(elementTypeID) Тогда 
		Запрос=Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
		                    |	Идентификаторы.Ссылка
		                    |ИЗ
		                    |	Справочник.aps_ВидыЭлементов.ИдентификаторыCAD КАК Идентификаторы
		                    |ГДЕ
		                    |	Идентификаторы.Идентификатор = &Идентификатор");
		Запрос.УстановитьПараметр("Идентификатор", elementTypeID);
		Выборка=Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда 
			ВидСоздаваемогоИзделия=Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	Если ВидСоздаваемогоИзделия=Неопределено Тогда 
		Если ТипИзделия=1 Тогда
			ВидСоздаваемогоИзделия=Справочники.aps_ВидыЭлементов.Деталь;
		ИначеЕсли ТипИзделия=2 Тогда
			ВидСоздаваемогоИзделия=Справочники.aps_ВидыЭлементов.СбЕдиница;
		ИначеЕсли ТипИзделия=3 Тогда
			ВидСоздаваемогоИзделия=Справочники.aps_ВидыЭлементов.СтИзд;
		ИначеЕсли ТипИзделия=4 Тогда
			ВидСоздаваемогоИзделия=Справочники.aps_ВидыЭлементов.Материал;
		Иначе 
			ВызватьИсключение "ru = 'Тип изделия не определен!'; en_US = 'Item type is undefined!'";
		КонецЕсли;
	КонецЕсли;
	
	созданиеОбъектов = Обработки.aps_СозданиеОбъектов.Создать();
	ДеревоСвойств=Новый ДеревоЗначений;
	созданиеОбъектов.aps_ОбновитьДеревоСвойств(ВидСоздаваемогоИзделия, ДеревоСвойств);
	
	Для Каждого СтрокаТаблицы Из ТаблицаПараметров Цикл 
		СтрокиДереваСвойств=ДеревоСвойств.Строки.НайтиСтроки(Новый Структура("Имя,Свойство",СтрокаТаблицы.Имя,СтрокаТаблицы.Свойство), Истина);
		Если СтрокиДереваСвойств.Количество()=0 Тогда 
			созданиеОбъектов.aps_НеинтерактивноеДобавлениеСвойстваВДерево(СтрокаТаблицы.Свойство, СтрокаТаблицы.Значение, СтрокаТаблицы.Имя,, ДеревоСвойств);
		Иначе 
			СтрокиДереваСвойств[0].Значение=СтрокаТаблицы.Значение; 
		КонецЕсли;
	КонецЦикла;
	
	СуществующийЭлемент=Неопределено;
	Попытка // 2.0.1.7 добавление проверки уникальности элементов в CAD
		НовыйЭлементСтруктуры=созданиеОбъектов.aps_СозданиеОбъектаPDM(ВидСоздаваемогоИзделия, ДеревоСвойств, СуществующийЭлемент);
	Исключение
		Если СуществующийЭлемент<> Неопределено Тогда
			НовыйЭлементСтруктуры=СуществующийЭлемент; НайденСуществующий=Истина;
		Иначе
			ВызватьИсключение;
		КонецЕсли;
	КонецПопытки;
	
	itemXDTO=ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("http://appius.ru/pdm", "item"));
	itemXDTO.element=СериализаторXDTO.ЗаписатьXDTO(НовыйЭлементСтруктуры.Ссылка);
	itemXDTO.elementType=СериализаторXDTO.ЗаписатьXDTO(НовыйЭлементСтруктуры.Ссылка.ВидЭлемента);
	Возврат XDTO2Строка(itemXDTO);
КонецФункции

// Создает новый активный документ
//		
// Параметры:
//		ТипCAD - тип CAD-системы
//		ТипАктивногоДокумента - число 
//		ТаблицаПарамеров - таблица значений
// Возвращаемое значение:
// 		Строка XDTO
// Пример:
//		СтрокаДокумента = aps_Сервер1.aps_cadСоздатьАктивныйДокумент( ТипCAD, ТипАктивногоДокумента, ТаблицаПараметров, НайденСуществующий );
//
Функция aps_cadСоздатьАктивныйДокумент( ТипCAD, ТипАктивногоДокумента, ТаблицаПараметров, НайденСуществующий ) Экспорт
	ВидСоздаваемогоАктДокумента=Неопределено;
	Если ТипCAD=1 Тогда 
		Если ТипАктивногоДокумента=1 Тогда
			ВидСоздаваемогоАктДокумента=Справочники.aps_ВидыЭлементов.АктивныйДокументЧертежSolidWorks;
		ИначеЕсли ТипАктивногоДокумента=2 Тогда 
			ВидСоздаваемогоАктДокумента=Справочники.aps_ВидыЭлементов.АктивныйДокументСборкаSolidWorks;
		ИначеЕсли ТипАктивногоДокумента=3 Тогда 
			ВидСоздаваемогоАктДокумента=Справочники.aps_ВидыЭлементов.АктивныйДокументДетальSolidWorks;
		КонецЕсли;
	ИначеЕсли ТипCAD=2 Тогда 
		Если ТипАктивногоДокумента=1 Тогда
			ВидСоздаваемогоАктДокумента=Справочники.aps_ВидыЭлементов.АктивныйДокументЧертежКОМПАС;
		ИначеЕсли ТипАктивногоДокумента=2 Тогда 
			ВидСоздаваемогоАктДокумента=Справочники.aps_ВидыЭлементов.АктивныйДокументСборкаКОМПАС;
		ИначеЕсли ТипАктивногоДокумента=3 Тогда 
			ВидСоздаваемогоАктДокумента=Справочники.aps_ВидыЭлементов.АктивныйДокументДетальКОМПАС;
		КонецЕсли;
	ИначеЕсли ТипCAD=3 Тогда 
		Если ТипАктивногоДокумента=1 Тогда
			ВидСоздаваемогоАктДокумента=Справочники.aps_ВидыЭлементов.АктивныйДокументЧертежAutoCAD;
		ИначеЕсли ТипАктивногоДокумента=2 Тогда 
			ВидСоздаваемогоАктДокумента=Справочники.aps_ВидыЭлементов.АктивныйДокументСборкаAutoCAD;
		ИначеЕсли ТипАктивногоДокумента=3 Тогда 
			ВидСоздаваемогоАктДокумента=Справочники.aps_ВидыЭлементов.АктивныйДокументДетальAutoCAD;
		КонецЕсли;
	ИначеЕсли ТипCAD=4 Тогда 
		Если ТипАктивногоДокумента=1 Тогда
			ВидСоздаваемогоАктДокумента=Справочники.aps_ВидыЭлементов.АктивныйДокументЧертежInventor;
		ИначеЕсли ТипАктивногоДокумента=2 Тогда 
			ВидСоздаваемогоАктДокумента=Справочники.aps_ВидыЭлементов.АктивныйДокументСборкаInventor;
		ИначеЕсли ТипАктивногоДокумента=3 Тогда 
			ВидСоздаваемогоАктДокумента=Справочники.aps_ВидыЭлементов.АктивныйДокументДетальInventor;
		КонецЕсли;
	ИначеЕсли ТипCAD=5 Тогда 
		Если ТипАктивногоДокумента=1 Тогда
			ВидСоздаваемогоАктДокумента=Справочники.aps_ВидыЭлементов.АктивныйДокументЧертежSolidEdge;
		ИначеЕсли ТипАктивногоДокумента=2 Тогда 
			ВидСоздаваемогоАктДокумента=Справочники.aps_ВидыЭлементов.АктивныйДокументСборкаSolidEdge;
		ИначеЕсли ТипАктивногоДокумента=3 Тогда 
			ВидСоздаваемогоАктДокумента=Справочники.aps_ВидыЭлементов.АктивныйДокументДетальSolidEdge;
		КонецЕсли;
	КонецЕсли;
	
	созданиеОбъектов = Обработки.aps_СозданиеОбъектов.Создать();
	ДеревоСвойств=Новый ДеревоЗначений;
	созданиеОбъектов.aps_ОбновитьДеревоСвойств(ВидСоздаваемогоАктДокумента, ДеревоСвойств);
	
	Для Каждого СтрокаТаблицы Из ТаблицаПараметров Цикл 
		СтрокиДереваСвойств=ДеревоСвойств.Строки.НайтиСтроки(Новый Структура("Имя,Свойство",СтрокаТаблицы.Имя,СтрокаТаблицы.Свойство), Истина);
		Если СтрокиДереваСвойств.Количество()=0 Тогда 
			созданиеОбъектов.aps_НеинтерактивноеДобавлениеСвойстваВДерево(СтрокаТаблицы.Свойство, СтрокаТаблицы.Значение, СтрокаТаблицы.Имя,, ДеревоСвойств);
		Иначе 
			СтрокиДереваСвойств[0].Значение=СтрокаТаблицы.Значение; 
		КонецЕсли;
	КонецЦикла;
	
	СуществующийЭлемент=Неопределено;
	Попытка // 2.0.1.7 добавление проверки уникальности элементов в CAD
		НовыйЭлементСтруктуры=созданиеОбъектов.aps_СозданиеОбъектаPDM(ВидСоздаваемогоАктДокумента, ДеревоСвойств, СуществующийЭлемент);
	Исключение
		Если СуществующийЭлемент<> Неопределено Тогда
			НовыйЭлементСтруктуры=СуществующийЭлемент; НайденСуществующий=Истина;
		Иначе
			ВызватьИсключение;
		КонецЕсли;
	КонецПопытки;
	
	itemXDTO=ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("http://appius.ru/pdm", "item"));
	itemXDTO.element=СериализаторXDTO.ЗаписатьXDTO(НовыйЭлементСтруктуры.Ссылка);
	Возврат XDTO2Строка(itemXDTO);
КонецФункции

// Создает ревизию элемента
//
// Параметры:
//		itemXDTOСтрока - строка 
//		ТаблицаПараметров - таблица значений
// Возвращаемое значение:
//		Строка XDTO
// Пример:
//		СтрокаРевизии = aps_Сервер1.aps_cadСоздатьРевизию( itemXDTOСтрока, ТаблицаПараметров );
//
Функция aps_cadСоздатьРевизию( itemXDTOСтрока, ТаблицаПараметров ) Экспорт
	Изделие = Строка2XDTO(itemXDTOСтрока).element;
	СозданиеОбъектов = Обработки.aps_СозданиеОбъектов.Создать();
	СозданиеРевизий = Обработки.aps_СозданиеРевизий.Создать();
	
	ТаблицаПараметровРевизии = Изделие.Параметры.Выгрузить();
	ТаблицаПараметровРевизии.Колонки.Добавить("Имя");
	ТаблицаПараметровРевизии.Колонки.Добавить("Свойство");
	ТаблицаПараметровРевизии.Колонки.Добавить("Значение");
	ТаблицаПараметровРевизии.Колонки.Добавить("Наследовать");
	
	// Дерево свойств, для автозаполнения значений по умолчанию
	ДеревоСвойств = Новый ДеревоЗначений();
	СозданиеОбъектов.aps_ОбновитьДеревоСвойств(Изделие.ВидЭлемента, ДеревоСвойств);
	
	Для i=0 По ТаблицаПараметровРевизии.Количество()-1 Цикл 
		ТаблицаПараметровРевизии[i].Имя=ТаблицаПараметровРевизии[i].Параметр.Наименование;
		ТаблицаПараметровРевизии[i].Свойство=ТаблицаПараметровРевизии[i].Параметр.Свойство;
		
		СтрокиТаблицы=ТаблицаПараметров.НайтиСтроки(Новый Структура("Имя,Свойство",ТаблицаПараметровРевизии[i].Имя,ТаблицаПараметровРевизии[i].Свойство));
		Если СтрокиТаблицы.Количество() > 0 Тогда 
			// значение параметра из CAD-а
			ТаблицаПараметровРевизии[i].Значение=СтрокиТаблицы[0].Значение;
		Иначе
			// значение параметра от предыдущей ревизии
			ТаблицаПараметровРевизии[i].Значение=ТаблицаПараметровРевизии[i].Параметр.Значение;
		КонецЕсли;
		
		СтрокиДереваСвойств = ДеревоСвойств.Строки.НайтиСтроки(Новый Структура("Имя,Свойство",ТаблицаПараметровРевизии[i].Имя,ТаблицаПараметровРевизии[i].Свойство), Истина);
		Если СтрокиДереваСвойств.Количество() > 0 И ЗначениеЗаполнено(СтрокиДереваСвойств[0].Значение) Тогда 
			ТаблицаПараметровРевизии[i].Значение = СтрокиДереваСвойств[0].Значение;
		КонецЕсли;
	КонецЦикла;
	
	Строка=ТаблицаПараметровРевизии.Найти(ПланыВидовХарактеристик.aps_Свойства.СпособСозданияРевизии,"Свойство");
	Если Строка=Неопределено Тогда 
		Строка=ТаблицаПараметровРевизии.Добавить();
		Строка.Имя=ПланыВидовХарактеристик.aps_Свойства.СпособСозданияРевизии.Наименование;
		Строка.Свойство=ПланыВидовХарактеристик.aps_Свойства.СпособСозданияРевизии;
	КонецЕсли;
	
	Строка.Значение=Справочники.aps_СпособыСозданияРевизий.Изменение;
	
	Строка=ТаблицаПараметровРевизии.Найти(ПланыВидовХарактеристик.aps_Свойства.НомерРевизии,"Свойство");
	Если Строка=Неопределено Тогда 
		Строка=ТаблицаПараметровРевизии.Добавить();
		Строка.Имя=ПланыВидовХарактеристик.aps_Свойства.НомерРевизии.Наименование;
		Строка.Свойство=ПланыВидовХарактеристик.aps_Свойства.НомерРевизии;
	КонецЕсли;
	
	ПредыдущийНомер = СозданиеРевизий.aps_ПолучитьПоследнийНомерРевизииИзменения(Изделие);
	СледующийНомер = 0;
	Попытка
		Выполнить Изделие.ВидЭлемента.КодПоследовательностиРевизийИзменения.ТекстКода;
	Исключение
	КонецПопытки;
	
	Строка.Значение=СледующийНомер;
		
	Попытка
		НоваяРевизия=СозданиеРевизий.aps_СоздатьРевизию( Изделие, ТаблицаПараметровРевизии );
	Исключение
		ВызватьИсключение КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	itemXDTO=ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("http://appius.ru/pdm", "item"));
	itemXDTO.element=СериализаторXDTO.ЗаписатьXDTO(НоваяРевизия.Ссылка);
	Возврат XDTO2Строка(itemXDTO);
КонецФункции

// Добавление связи
//
// Параметры:
//		ТаблицаСвязей - таблица значений
//		parentXDTOСтрока - строка
//		childXDTOСтрока  - строка
//		instanceID - число
//		ГоризонтальнаяСвязь - булево (необязательный)
// Возвращаемое значение:
//		Таблица значений
// Пример:
//		ТаблицаСвязей = aps_Сервер1.aps_cadДобавитьКСвязям( Таблица, parentXDTOСтрока, childXDTOСтрока, instanceID, ГоризонтальнаяСвязь );
//
Функция aps_cadДобавитьКСвязям( ТаблицаСвязей, parentXDTOСтрока, childXDTOСтрока, instanceID, ГоризонтальнаяСвязь=Ложь ) Экспорт
	Если ТаблицаСвязей=Неопределено Тогда
		ТаблицаСвязей = Новый ТаблицаЗначений();
		
		МассивТипов = Новый Массив();
		МассивТипов.Добавить(Тип("СправочникСсылка.aps_ЭлементыИзделия"));
		МассивТипов.Добавить(Тип("СправочникСсылка.aps_ЭлементыТехнологии"));
		МассивТипов.Добавить(Тип("СправочникСсылка.aps_ЭлементыСправочников"));
		
		ТаблицаСвязей.Колонки.Добавить("РодительСсылка"	, Новый ОписаниеТипов(МассивТипов));
		ТаблицаСвязей.Колонки.Добавить("ПотомокСсылка"	, Новый ОписаниеТипов(МассивТипов));
		ТаблицаСвязей.Колонки.Добавить("CadId"			, Новый ОписаниеТипов("Число"));
		// ИБ 22.11.2013 Создание справочной горизонтальной связи
		ТаблицаСвязей.Колонки.Добавить("ГоризонтальнаяСвязь", Новый ОписаниеТипов("Булево"));
	КонецЕсли;
	СтрокаТаблицы = ТаблицаСвязей.Добавить();
	СтрокаТаблицы.РодительСсылка = Строка2XDTO(parentXDTOСтрока).element;
	СтрокаТаблицы.ПотомокСсылка  = Строка2XDTO(childXDTOСтрока).element;
	СтрокаТаблицы.CadId = instanceID;
	// ИБ 22.11.2013
	СтрокаТаблицы.ГоризонтальнаяСвязь=ГоризонтальнаяСвязь;
	Возврат ТаблицаСвязей;
КонецФункции

// Функция синхронизирует связи элементов структуры изделия
//
// Параметры:
//		ТаблицаСвязей - таблица значений
// Возвращаемое значение:
//		нет
// Пример:
//		aps_Сервер1.aps_cadСинхронизацияСвязей( Таблица );
//
Функция aps_cadСинхронизацияСвязей( ТаблицаСвязей ) Экспорт
	
	созданиеОбъектов=Обработки.aps_СозданиеОбъектов.Создать();
	созданиеПараметров=Обработки.aps_СозданиеПараметров.Создать();
    штуки=Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду(796);
	ДеревоСвойствСвязи=созданиеОбъектов.aps_НеинтерактивноеДобавлениеСвойстваВДерево( ПланыВидовХарактеристик.aps_Свойства.Количество, 1, "Количество", штуки);
	созданиеОбъектов.aps_НеинтерактивноеДобавлениеСвойстваВДерево( ПланыВидовХарактеристик.aps_Свойства.ЕдиницыИзмерения, штуки, "Единица измерения",,ДеревоСвойствСвязи );
	
	Запрос=Новый Запрос("ВЫБРАТЬ
	                    |	Связи.Ссылка,
	                    |	Связи.РодительСсылка,
	                    |	Связи.ПотомокСсылка,
	                    |	Связи.CADID,
	                    |	ПараметрКоличество.Количество,
	                    |	ВЫБОР
	                    |		КОГДА Связи.Ссылка.ВидСвязи ССЫЛКА Перечисление.aps_ВидыСвязей
	                    |			ТОГДА ЛОЖЬ
	                    |		ИНАЧЕ ИСТИНА
	                    |	КОНЕЦ КАК ГоризонтальнаяСвязь
	                    |ИЗ
	                    |	(ВЫБРАТЬ
	                    |		aps_ЭлементыСвязей.Ссылка КАК Ссылка,
	                    |		aps_ЭлементыСвязей.РодительСсылка КАК РодительСсылка,
	                    |		aps_ЭлементыСвязей.ПотомокСсылка КАК ПотомокСсылка,
	                    |		aps_ЭлементыСвязей.CADID КАК CADID
	                    |	ИЗ
	                    |		Справочник.aps_ЭлементыСвязей КАК aps_ЭлементыСвязей
	                    |	ГДЕ
	                    |		НЕ aps_ЭлементыСвязей.ПометкаУдаления
	                    |		И aps_ЭлементыСвязей.ВидСвязи В(&ВидыСвязей)
	                    |		И aps_ЭлементыСвязей.РодительСсылка В(&Родители)) КАК Связи
	                    |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	                    |			aps_ЭлементыСвязейПараметры.Ссылка КАК Ссылка,
	                    |			МАКСИМУМ(aps_ЭлементыСвязейПараметры.Параметр.Значение) КАК Количество
	                    |		ИЗ
	                    |			Справочник.aps_ЭлементыСвязей.Параметры КАК aps_ЭлементыСвязейПараметры
	                    |		ГДЕ
	                    |			НЕ aps_ЭлементыСвязейПараметры.Ссылка.ПометкаУдаления
	                    |			И aps_ЭлементыСвязейПараметры.Ссылка.ВидСвязи В(&ВидыСвязей)
	                    |			И aps_ЭлементыСвязейПараметры.Ссылка.РодительСсылка В(&Родители)
	                    |			И aps_ЭлементыСвязейПараметры.Параметр.Свойство = &СвойствоКоличество
	                    |		
	                    |		СГРУППИРОВАТЬ ПО
	                    |			aps_ЭлементыСвязейПараметры.Ссылка) КАК ПараметрКоличество
	                    |		ПО Связи.Ссылка = ПараметрКоличество.Ссылка");
	Запрос.УстановитьПараметр("Родители", ТаблицаСвязей.ВыгрузитьКолонку("РодительСсылка"));
	Запрос.УстановитьПараметр("СвойствоКоличество", ПланыВидовХарактеристик.aps_Свойства.Количество);
	
	МассивВидовСвязей=Новый Массив();
	МассивВидовСвязей.Добавить( перечисления.aps_ВидыСвязей.СоставИзделия );
	МассивВидовСвязей.Добавить( Справочники.aps_ШаблоныТехнологическихСвязей.СправочнаяГеометрия );
	Запрос.УстановитьПараметр("ВидыСвязей", МассивВидовСвязей);
	
	ТаблицаСвязейPDM=Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаТаблицы Из ТаблицаСвязей Цикл 
		Структура=Новый Структура("РодительСсылка, ПотомокСсылка, CADID, ГоризонтальнаяСвязь");
		ЗаполнитьЗначенияСвойств(Структура, СтрокаТаблицы);
		НайденныеСвязи=ТаблицаСвязейPDM.НайтиСтроки(Структура);
		Если НайденныеСвязи.Количество() > 0 Тогда // связь существует
			Если НайденныеСвязи[0].Количество<>1 Тогда 
				// установить значение параметра "Количество" =1
				ОбъектСвязи=НайденныеСвязи[0].Ссылка.ПолучитьОбъект();
				созданиеПараметров.aps_УстановкаПараметра(ОбъектСвязи, ПланыВидовХарактеристик.aps_Свойства.Количество, 1);
				Если ОбъектСвязи.Модифицированность() Тогда 
					ОбъектСвязи.Записать();
				КонецЕсли;
			КонецЕсли;
			
			ТаблицаСвязейPDM.Удалить(НайденныеСвязи[0]); Продолжить;
		КонецЕсли;
		
		Попытка
			
			ОбъектСвязи = созданиеОбъектов.aps_СозданиеЭлементнойСвязи( Справочники.aps_ВидыЭлементов.СвязьСостава,
																		СтрокаТаблицы.РодительСсылка,
																		СтрокаТаблицы.ПотомокСсылка,
																		// ИБ 22.11.2013
																		?(СтрокаТаблицы.ГоризонтальнаяСвязь=Истина,
																		   Справочники.aps_ШаблоныТехнологическихСвязей.СправочнаяГеометрия,
																		   Перечисления.aps_ВидыСвязей.СоставИзделия),
																		ДеревоСвойствСвязи ); // создать новую связь
																		
																					
			ОбъектСвязи.CADID = СтрокаТаблицы.CadId;
			ОбъектСвязи.Записать();
		Исключение	
			ВызватьИсключение НСтр("ru = 'Элемент <'; en_US = 'The <'")+Строка(СтрокаТаблицы.ПотомокСсылка)+НСтр("ru = '>. '; en_US = '> item. '")+КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
	КонецЦикла;
	
	
	////////////////////////////////////////////////////
	// пометить на удаление связи, отсутствующие в CAD-е
	Для Каждого СтрокаТаблицы Из ТаблицаСвязейPDM Цикл 
		Если СтрокаТаблицы.CADID = 0 Тогда 
			Продолжить;
		КонецЕсли;
		
		Попытка
			СтрокаТаблицы.Ссылка.ПолучитьОбъект().УстановитьПометкуУдаления(Истина);
		Исключение
			ВызватьИсключение КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
	КонецЦикла;
	
КонецФункции

// Функция синхронизирует связи элементов с активными документами
//
// Параметры:
//		ТаблицаСвязей - таблица значений
// Возвращаемое значение:
//		нет
// Пример:
//      aps_Сервер1.aps_cadСинхронизацияСвязейАктивныхДокументов( Таблица );
//
Функция aps_cadСинхронизацияСвязейАктивныхДокументов( ТаблицаСвязей ) Экспорт
	
	созданиеОбъектов=Обработки.aps_СозданиеОбъектов.Создать();
	созданиеПараметров=Обработки.aps_СозданиеПараметров.Создать();
	ДеревоСвойствСвязи=Новый ДеревоЗначений;
	
	Запрос=Новый Запрос("ВЫБРАТЬ
	                    |	Связи.РодительСсылка,
	                    |	Связи.ПотомокСсылка
	                    |ИЗ
	                    |	(ВЫБРАТЬ
	                    |		aps_ЭлементыСвязей.РодительСсылка КАК РодительСсылка,
	                    |		aps_ЭлементыСвязей.ПотомокСсылка КАК ПотомокСсылка
	                    |	ИЗ
	                    |		Справочник.aps_ЭлементыСвязей КАК aps_ЭлементыСвязей
	                    |	ГДЕ
	                    |		(НЕ aps_ЭлементыСвязей.ПометкаУдаления)
	                    |		И aps_ЭлементыСвязей.ВидСвязи = ЗНАЧЕНИЕ(Перечисление.aps_ВидыСвязей.СоставИзделия)
	                    |		И aps_ЭлементыСвязей.РодительСсылка В(&Родители)) КАК Связи");
	Запрос.УстановитьПараметр("Родители", ТаблицаСвязей.ВыгрузитьКолонку("РодительСсылка"));
	ТаблицаСвязейPDM=Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаТаблицы Из ТаблицаСвязей Цикл 
		Структура=Новый Структура("РодительСсылка, ПотомокСсылка");
		ЗаполнитьЗначенияСвойств(Структура, СтрокаТаблицы);
		НайденныеСвязи=ТаблицаСвязейPDM.НайтиСтроки(Структура);
		Если НайденныеСвязи.Количество() > 0 Тогда // связь существует
			Продолжить;
		КонецЕсли;
		
		Попытка
			ОбъектСвязи = созданиеОбъектов.aps_СозданиеЭлементнойСвязи( Справочники.aps_ВидыЭлементов.СвязьСостава,
																		СтрокаТаблицы.РодительСсылка,
																		СтрокаТаблицы.ПотомокСсылка,
																		Перечисления.aps_ВидыСвязей.СоставИзделия,
																		ДеревоСвойствСвязи ); // создать новую связь
																		
																					
			ОбъектСвязи.Записать();
		Исключение	
			ВызватьИсключение НСтр("ru = 'Элемент <'; en_US = 'The <'")+Строка(СтрокаТаблицы.ПотомокСсылка)+НСтр("ru = '>. '; en_US = '> item. '")+КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
		
		СтрокаТаблицыPDM=ТаблицаСвязейPDM.Добавить();
		СтрокаТаблицыPDM.РодительСсылка	=СтрокаТаблицы.РодительСсылка;
		СтрокаТаблицыPDM.ПотомокСсылка	=СтрокаТаблицы.ПотомокСсылка;
	КонецЦикла;
	
КонецФункции


// Функция проверяет правильность XDTO
//
// Параметры:
//		itemXDTOСтрока - строка
// Возвращаемое значение:
//		Булево
// Пример:
//      РезультатПроверки = aps_Сервер1.aps_cadПроверитьПравильностьXDTO( itemXDTOСтрока );
//
Функция aps_cadПроверитьПравильностьXDTO( itemXDTOСтрока ) Экспорт
	Попытка
		itemXDTO = Строка2XDTO(itemXDTOСтрока);
		// Проверка на битые объекты. В этом случае элементы помещаются по новой
		Если itemXDTO = Неопределено Тогда
			ВызватьИсключение НСтр("ru = 'Строка XDTO неверна или не найден соответствующий элемент в 1С:PDM'; en_US = 'XDTO string is incorrect or the respective item is not found in 1C:PDM'");
		КонецЕсли;
		Если itemXDTO.element.ПолучитьОбъект()=Неопределено ИЛИ itemXDTO.element.ПометкаУдаления Тогда
			ВызватьИсключение НСтр("ru = 'Элемент изделия неверный'; en_US = 'Incorrect item of product'");
		КонецЕсли;
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки
КонецФункции

// Функция определяет изменен ли файл в базе данных
//
// Параметры:
//		itemXDTOСтрока - строка
//		CRC - число
// Возвращаемое значение:
//		Булево
// Пример:
//		aps_Сервер1.aps_cadФайлВБазеИзменен( itemXDTOСтрока, CRC );
//
Функция aps_cadФайлВБазеИзменен( itemXDTOСтрока, CRC ) Экспорт
	Возврат Справочники.aps_ДвоичныеДанные.НайтиПоРеквизиту("CRC",CRC).Пустая();
КонецФункции

// Функция добавляет параметр к элементу
//
// Параметры:
//		itemXDTOСтрока - строка
//		ИмяПараметра - строка
//		ЗначениеПараметра - произвольный
// Возвращаемое значение:
//		Истина; Строка
// Пример:
//		ПараметрДобавлен = aps_Сервер1.aps_cadДобавитьПараметр( itemXDTOСтрока, ИмяПараметра, ЗначениеПараметра );
// 
Функция aps_cadДобавитьПараметр( itemXDTOСтрока, ИмяПараметра, ЗначениеПараметра ) Экспорт
	itemXDTO = Строка2XDTO(itemXDTOСтрока);
	МодульСозданияПараметров = Обработки.aps_СозданиеПараметров.Создать();
	ИндексAt=Найти(ИмяПараметра,"@");
	Если ИндексAt>0 Тогда
		ИмяПеременной = Сред(ИмяПараметра,1,ИндексAt-1);
		НаименованиеСвойства=Сред(ИмяПараметра,ИндексAt+1);
	Иначе
		ИмяПеременной=Неопределено;
		НаименованиеСвойства=ИмяПараметра;
	КонецЕсли;
	Свойство = ПланыВидовХарактеристик.aps_Свойства.НайтиПоНаименованию(НаименованиеСвойства, Истина);
	Если НЕ Свойство.Пустая() И НЕ Свойство.ЭтоГруппа Тогда
		itemObject = itemXDTO.element.ПолучитьОбъект();
		Попытка 
			МодульСозданияПараметров.aps_УстановкаПараметра(itemObject, Свойство, Свойство.ТипЗначения.ПривестиЗначение(ЗначениеПараметра), ИмяПеременной);
			itemObject.Записать();
		Исключение
			СуществующийЭлемент=Неопределено;
			Если itemObject.ДополнительныеСвойства.Свойство("СуществующийЭлемент", СуществующийЭлемент) Тогда 
				itemXDTO.element = СериализаторXDTO.ЗаписатьXDTO(СуществующийЭлемент);
				Возврат XDTO2Строка(itemXDTO); // вернуть xdto существующего
			Иначе 
				ВызватьИсключение КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			КонецЕсли;
		КонецПопытки;
	КонецЕсли;
	Возврат Истина;
КонецФункции

// Функция получает все правила управления
//
// Параметры: 
//		Нет
// Возвращаемое значение: 
//		Массив ссылок на правила управления
// Пример:
//      ПравилаУправления = aps_Сервер1.aps_ПравилаУправления();
//
Функция aps_cadПолучитьПравилаУправления() Экспорт
	Запрос=Новый Запрос("ВЫБРАТЬ
	                    |	aps_ПравилаУправления.Ссылка
	                    |ИЗ
	                    |	Справочник.aps_ПравилаУправления КАК aps_ПравилаУправления
	                    |ГДЕ
	                    |	(НЕ aps_ПравилаУправления.ПометкаУдаления)
	                    |	И (НЕ aps_ПравилаУправления.ЭтоГруппа)");
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку(0);
КонецФункции

// Функция определяет кем редактируется модель
//
// Параметры:
// 		itemXDTOСтрока  - строка
// Возвращаемое значение:
