// Пример:
//      ИмяПользователя = aps_Сервер1.aps_cadКемРедактируетсяМодель( itemXDTOСтрока );
//
Функция aps_cadКемРедактируетсяМодель( itemXDTOСтрока ) Экспорт
	itemXDTO = Строка2XDTO(itemXDTOСтрока);
	Возврат Строка(itemXDTO.element.РедактирующийПользователь.Наименование);
КонецФункции

// Функция возвращает истина в случае, если элемент редактируется текущим пользователем
//
// Параметры:
//		itemXDTOСтрока
// Возвращаемое значение:
//		Булево
// Пример:
//		МодельРедактируетсяМной = aps_Сервер1.aps_cadМодельРедактируетсяМной( itemXDTOСтрока );
//
Функция aps_cadМодельРедактируетсяМной( itemXDTOСтрока ) Экспорт
	itemXDTO = Строка2XDTO(itemXDTOСтрока);
	Возврат itemXDTO.element.РедактирующийПользователь=ПараметрыСеанса.ТекущийПользователь;
КонецФункции

// Функция возвращает истина в случае, если элемент редактируется текущим пользователем
//
// Параметры:
//		itemXDTOСтрока - строка
// Возвращаемое значение:
//		Булево
// Пример:
//		МодельРедактируется = aps_Сервер1.aps_cadМодельРедактируется( itemXDTOСтрока );
//
Функция aps_cadМодельРедактируется( itemXDTOСтрока ) Экспорт
	itemXDTO = Строка2XDTO(itemXDTOСтрока);
	Возврат itemXDTO.element.РедактирующийПользователь<>Справочники.Пользователи.ПустаяСсылка();
КонецФункции

// Функция возвращает истина в случае, если возможно изменение объекта
//
// Параметры:
//		itemXDTOСтрока
// Возвращаемое значение:
//		Булево
// Пример:
//		РазрешеноИзменять = aps_cadРазрешенаВозможностьИзменения( itemXDTOСтрока );
//
Функция aps_cadРазрешенаВозможностьИзменения( itemXDTOСтрока ) Экспорт
	itemXDTO = Строка2XDTO(itemXDTOСтрока);
	МодульПравДоступа = Обработки.aps_ПраваДоступа.Создать();
	Возврат МодульПравДоступа.aps_ПроверитьОбъектПрава(Справочники.aps_Права.Изменение, itemXDTO.element, itemXDTO.element.GMOD);
КонецФункции

// Функция добавляет к редактируемым моделям объект
// Параметры:
//		itemXDTOСтрока - строка
//		МассивРедактируемых - массив
// Возвращаемое значение:
//		Массив
// Пример:
//		МассивРедактируемых = aps_Сервер1.aps_cadДобавитьКРедактируемымМоделям( МассивРедактируемых, itemXDTOСтрока );
//
Функция aps_cadДобавитьКРедактируемымМоделям( МассивРедактируемых, itemXDTOСтрока ) Экспорт 
	// массив изделий и активных документов для редактирования
	Если МассивРедактируемых=Неопределено Тогда
		МассивРедактируемых=Новый Массив;
	КонецЕсли;
	itemXDTO=Строка2XDTO(itemXDTOСтрока);
	Если МассивРедактируемых.Найти(itemXDTO.element)=Неопределено Тогда 
		МассивРедактируемых.Добавить(itemXDTO.element);
	КонецЕсли;
	Возврат МассивРедактируемых;
КонецФункции

// Функция устанавливает блокировки редактирования
//
// Параметры:
//		МассивРедактируемых	- массив
// Возвращаемое значение:
//		Неопределено
// Пример:
//		aps_Сервер1.aps_cadУстановитьБлокировкиРедактирования( МассивРедактируемых );
//
Функция aps_cadУстановитьБлокировкиРедактирования( МассивРедактируемых ) Экспорт
	
	Если МассивРедактируемых=Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ПространстваБлокировок=Новый Соответствие;
	ПространстваБлокировок.Вставить(Тип("СправочникСсылка.aps_ЭлементыИзделия"	   ), "Справочник.aps_ЭлементыИзделия"	   );
	ПространстваБлокировок.Вставить(Тип("СправочникСсылка.aps_ЭлементыСправочников"), "Справочник.aps_ЭлементыСправочников");
	ПространстваБлокировок.Вставить(Тип("СправочникСсылка.aps_ЭлементыТехнологии"  ), "Справочник.aps_ЭлементыТехнологии"  );
	
	Попытка
		////////////////////////////////////////////////////////////////
		// управляемая блокировка объектов от изменения другими сессиями
		Блокировка=Новый БлокировкаДанных();
		Для i=0 По МассивРедактируемых.Количество()-1 Цикл 
			ЭлементБлокировки=Блокировка.Добавить(ПространстваБлокировок.Получить(ТипЗнч(МассивРедактируемых[i])));
			ЭлементБлокировки.УстановитьЗначение("Ссылка", МассивРедактируемых[i]);
		КонецЦикла;
		
		Блокировка.Заблокировать();
		
		РедактируемыеФайлы=aps_РаботаСФайламиСервер.aps_ПолучитьФайлыДокумента(МассивРедактируемых);
		
		СисИнфо = Новый СистемнаяИнформация();
		ИдентификаторСессии = Строка(СисИнфо.ИдентификаторКлиента)+"/"+Строка(Новый УникальныйИдентификатор());
		
		aps_РаботаСФайламиСервер.aps_УстановитьБлокировкиРедактирования( РедактируемыеФайлы.ВыгрузитьКолонку("Ссылка"), ИдентификаторСессии );
	Исключение
		ВызватьИсключение КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;	
КонецФункции

// Функция снимает блокировки редактирования
//
// Параметры:
//		МассивРедактируемых	- массив
// Возвращаемое значение:
//      Неопределено
// Пример:
//		aps_Сервер1.aps_cadСнятьБлокировкиРедактирования( МассивРедактируемых );
//
Функция aps_cadСнятьБлокировкиРедактирования( МассивРедактируемых ) Экспорт
	Если МассивРедактируемых=Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Попытка
		РедактируемыеФайлы=aps_РаботаСФайламиСервер.aps_ПолучитьФайлыДокумента(МассивРедактируемых);
		aps_РаботаСФайламиСервер.aps_СнятьБлокировкиРедактирования( РедактируемыеФайлы.ВыгрузитьКолонку("Ссылка") );
	Исключение
		ВызватьИсключение КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;	
КонецФункции

// Функция получает редактируемые модели 
//
// Параметры:
//		itemXDTOСтрока - строка
// Возвращаемое значение:
//      Массив
// Пример:
//		МассивРедактируемых = aps_Сервер1.aps_cadПолучитьРедактируемыеМнойМодели( itemXDTOСтрока );
//
Функция aps_cadПолучитьРедактируемыеМнойМодели( itemXDTOСтрока ) Экспорт
	itemXDTO = Строка2XDTO(itemXDTOСтрока);
	itemXDTO.refLinkGroup=Ложь;
	
	МассивИзделийXDTO=Новый Массив();
	МассивИзделийXDTO.Добавить(itemXDTO);
	Обработки.aps_Проводник.Создать().aps_ОбновитьМодельXDTOРек(МассивИзделийXDTO, Неопределено, Неопределено, Ложь);
	МассивИзделийXDTO=aps_СформироватьМассивИзМоделиXDTO(itemXDTO);
	
	МассивРедактируемых=Новый Массив;
	Для i=0 По МассивИзделийXDTO.Количество()-1 Цикл 
		Если МассивИзделийXDTO[i].element<>Неопределено 
				И МассивИзделийXDTO[i].element.РедактирующийПользователь=ПараметрыСеанса.ТекущийПользователь И МассивРедактируемых.Найти(МассивИзделийXDTO[i].element)=Неопределено Тогда 
			МассивРедактируемых.Добавить(МассивИзделийXDTO[i].element);
		КонецЕсли;
	КонецЦикла;
	
	Возврат МассивРедактируемых;
КонецФункции

// Функция получает HTML-информацию об элементе 
//
// Параметры:
//		itemXDTOСтрока - строка
// Возвращаемое значение:
//		Строка
// Пример:
//		HTMLСтрока = aps_Сервер1.aps_cadИнформацияОбЭлементе( itemXDTOСтрока );
//
Функция aps_cadИнформацияОбЭлементе( itemXDTOСтрока ) Экспорт
	МодульСозданияПараметров = Обработки.aps_СозданиеПараметров.Создать();
	МодульПравДоступа = Обработки.aps_ПраваДоступа.Создать();
	
	Если aps_cadПроверитьПравильностьXDTO(itemXDTOСтрока) Тогда
		item = Строка2XDTO(itemXDTOСтрока).element;
		НомерИсполнения=МодульСозданияПараметров.aps_ВспомНайтиПараметрПоСвойству(item,ПланыВидовХарактеристик.aps_Свойства.НомерИсполнения).Значение;
		НомерИзменения=МодульСозданияПараметров.aps_ВспомНайтиПараметрПоСвойству(item,ПланыВидовХарактеристик.aps_Свойства.НомерРевизии).Значение;
		ПолныйИдентификаторРевизии=Строка(НомерИсполнения)+?(ЗначениеЗаполнено(НомерИсполнения) И ЗначениеЗаполнено(НомерИзменения),"/", "")+Строка(НомерИзменения);
		
		HTML = "<table width=100% cellpadding=""5"" cellspacing=""0"">
		|<tr><td>"+Строка(item)+"</td></tr>
		|<tr><td><table style=""font:8pt Verdana"" cellpadding=""1"" cellspacing=""1"">
		|<tr><td><font color=#A1A1A1>Вид документа:</font></td><td width=""100%"">"+Строка(item.ВидЭлемента)+"</td></tr>
		|<tr><td><font color=#A1A1A1>Создан:</font></td><td width=""100%"">"+Строка(item.Дата)+"</td></tr>
		|<tr height=""16px""><td></td><td></td></tr>
		|<tr><td><font color=#A1A1A1>Обозначение:</font></td><td width=""100%"">"+Строка(МодульСозданияПараметров.aps_ВспомНайтиПараметрПоСвойству(item,ПланыВидовХарактеристик.aps_Свойства.Обозначение).Значение)+"</td></tr>
		|<tr><td><font color=#A1A1A1>Наименование:</font></td><td width=""100%"">"+Строка(МодульСозданияПараметров.aps_ВспомНайтиПараметрПоСвойству(item,ПланыВидовХарактеристик.aps_Свойства.Наименование).Значение)+"</td></tr>
		|<tr><td><font color=#A1A1A1>Владелец:</font></td><td width=""100%"">"+?(ЗначениеЗаполнено(item.UID),"<img src=5701>"+Строка(item.UID),"")+"</td></tr>
		|<tr><td><font color=#A1A1A1>Редактируется:</font></td><td width=""100%"">"+?(ЗначениеЗаполнено(item.РедактирующийПользователь),"<img src=7106>"+Строка(item.РедактирующийПользователь),"")+"</td></tr>
		|<tr height=""16px""><td></td><td></td></tr>
		|<tr><td><font color=#A1A1A1>Ревизия:</font></td><td width=""100%"">"+ПолныйИдентификаторРевизии+"</td></tr>
		|<tr><td><font color=#A1A1A1>Тип ревизии:</font></td><td width=""100%"">"+Строка(МодульСозданияПараметров.aps_ВспомНайтиПараметрПоСвойству(item,ПланыВидовХарактеристик.aps_Свойства.СпособСозданияРевизии).Значение)+"</td></tr>
		|<tr><td><font color=#A1A1A1>Состояние:</font></td><td width=""100%"">"+Строка(МодульСозданияПараметров.aps_ВспомНайтиПараметрПоСвойству(item,ПланыВидовХарактеристик.aps_Свойства.Состояние).Значение)+"</td></tr>
		|<tr><td><font color=#A1A1A1>Возможность изменения:</font></td><td width=""100%"">"+?(МодульПравДоступа.aps_ПроверитьОбъектПрава(Справочники.aps_Права.Изменение, item, item.GMOD), "Да", "Нет")+"</td></tr></table>
		|</td></tr></table>";
		
		Возврат HTML;
	КонецЕсли;
	
	Возврат "";
КонецФункции

Функция aps_cadСоздатьСтрокуМоделиXDTO(СсылкаЭлемента) Экспорт

    itemXDTO = aps_СоздатьОбъектМоделиXDTO(СсылкаЭлемента);

    Возврат XDTO2Строка(itemXDTO);

КонецФункции

// Функция возвращает таблицу параметров элемента
// 
// Параметры:
//		itemXDTOСтрока - строка
// Возвращаемое значение:
//		ТаблицаПараметров - таблица значений параметров
// Пример:
//		ТаблицаПараметров = aps_Сервер1.aps_cadПолучитьПараметры( itemXDTOСтрока );
//
Функция aps_cadПолучитьПараметры( itemXDTOСтрока ) Экспорт	
	itemXDTO=Строка2XDTO(itemXDTOСтрока);
	ТаблицаПараметров=Неопределено;
	// инициализация таблицы функцией aps_cadДобавитьКПараметрам
	aps_cadДобавитьКПараметрам(ТаблицаПараметров, "", Неопределено);
	ТаблицаПараметров.Очистить();
	Для Каждого СтрокаПараметра Из itemXDTO.element.Параметры Цикл 
		СтрокаТаблицы=ТаблицаПараметров.Добавить();
		СтрокаТаблицы.Имя=СтрокаПараметра.Параметр.Наименование;
		СтрокаТаблицы.Свойство=СтрокаПараметра.Параметр.Свойство;
		СтрокаТаблицы.Значение=СтрокаПараметра.Параметр.Значение;
	КонецЦикла;
	Возврат ТаблицаПараметров;
КонецФункции

// Процедура обновляет значения параметров элемента по таблице
// 
// Параметры:
//		itemXDTOСтрока - строка
//		ТаблицаПараметров - таблица значений параметров
// Пример:
//      aps_Сервер1.aps_cadОбновитьПараметры( itemXDTOСтрока, ТаблицаПараметров );
//
Процедура aps_cadОбновитьПараметры( itemXDTOСтрока, ТаблицаПараметров ) Экспорт	
	МодульСозданияПараметров=Обработки.aps_СозданиеПараметров.Создать();
	itemXDTO=Строка2XDTO(itemXDTOСтрока);
	
	Попытка
		itemObject=itemXDTO.element.ПолучитьОбъект();
		Для Каждого СтрокаТаблицы Из ТаблицаПараметров Цикл 
			ЗначениеПараметра = aps_ПреобразоватьЗначениеПараметра(СтрокаТаблицы.Значение, СтрокаТаблицы.Свойство.ТипЗначения);
			МодульСозданияПараметров.aps_УстановкаПараметра(itemObject, СтрокаТаблицы.Свойство, ЗначениеПараметра, СтрокаТаблицы.Имя);
		КонецЦикла;
	
	    Если itemObject.Модифицированность() Тогда 
			itemObject.Записать();
		КонецЕсли;
	Исключение
		ВызватьИсключение КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;			
КонецПроцедуры

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

// Обновление моделей XDTO, включая горизонтальные связи
// "справочная геометрия"
