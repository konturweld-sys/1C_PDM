// Процедура удаляет все файлы с виртуального хоста
// Параметры:
//		Нет
// Пример:
//		aps_УправлениеВиртуальнымХостом.aps_УдалитьФайлыСВиртуальногоХоста();
//
Процедура aps_УдалитьФайлыСВиртуальногоХоста() Экспорт 
	////////////////////////////
	// очистить виртуальный хост
	Запрос=Новый Запрос("ВЫБРАТЬ
	                    |	aps_ВиртуальныйХост.Ссылка
	                    |ИЗ
	                    |	Справочник.aps_ВиртуальныйХост КАК aps_ВиртуальныйХост
	                    |ГДЕ
	                    |	aps_ВиртуальныйХост.Родитель = ЗНАЧЕНИЕ(Справочник.aps_ВиртуальныйХост.ПустаяСсылка)");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Попытка
			Выборка.Ссылка.ПолучитьОбъект().Удалить();
		Исключение
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

// Процедура выгружает файлы с виртуального хоста на диск
// Параметры:
//		КаталогВыгрузки - Строка, путь к каталогу выгрузки
//		ДоменноеИмяВиртХоста - Строка, по умолчанию http://virtualappiushost
// Пример:
//		aps_УправлениеВиртуальнымХостом.aps_ВыгрузитьФайлыСВиртуальногоХоста(КаталогВременныхФайлов(), "http://virtualappiushost");
//
Процедура aps_ВыгрузитьФайлыСВиртуальногоХоста( КаталогВыгрузки, ДоменноеИмяВиртХоста, ЭлементФормыИндикатор = Неопределено, РежимПростойВыгрузки = Ложь ) Экспорт
	
	Попытка
		ЗапросФайловХоста = Новый Запрос();
		ЗапросФайловХоста.Текст = "ВЫБРАТЬ
		                          |	aps_ВиртуальныйХост.Ссылка,
		                          |	aps_ВиртуальныйХост.ПолноеИмяФайла,
		                          |	aps_ВиртуальныйХост.Путь,
		                          |	aps_ВиртуальныйХост.ДатаМодификации,
		                          |	aps_ВиртуальныйХост.ТекстШаблона
		                          |ИЗ
		                          |	Справочник.aps_ВиртуальныйХост КАК aps_ВиртуальныйХост
		                          |ГДЕ
		                          |	(НЕ aps_ВиртуальныйХост.ЭтоГруппа)
		                          |	И (НЕ aps_ВиртуальныйХост.ПометкаУдаления)";
		Если НЕ РежимПростойВыгрузки Тогда 
			ЗапросФайловХоста.Текст = ЗапросФайловХоста.Текст + "
		                          |	И (НЕ aps_ВиртуальныйХост.ИмяФайла ПОДОБНО &htm)
		                          |	И (НЕ aps_ВиртуальныйХост.ИмяФайла ПОДОБНО &html)";
			ЗапросФайловХоста.УстановитьПараметр("htm" , "%.htm" );
			ЗапросФайловХоста.УстановитьПараметр("html", "%.html");
		КонецЕсли;
		
		ФайлыХоста = ЗапросФайловХоста.Выполнить().Выгрузить();
		
		Если ЭлементФормыИндикатор <> Неопределено Тогда 
			ЭлементФормыИндикатор.МаксимальноеЗначение = ФайлыХоста.Количество();
		КонецЕсли;
		
		Для Каждого ФайлХоста Из ФайлыХоста Цикл
			Если ЭлементФормыИндикатор <> Неопределено Тогда 
				ЭлементФормыИндикатор.Значение=ЭлементФормыИндикатор.Значение+1;
			КонецЕсли;
			
			СоздатьКаталог(КаталогВыгрузки+СтрЗаменить(ФайлХоста.Путь, ДоменноеИмяВиртХоста, ?(РежимПростойВыгрузки,"","virtualappiushost3")));
			
			ПолноеИмяФайла = КаталогВыгрузки+СтрЗаменить(ФайлХоста.ПолноеИмяФайла, ДоменноеИмяВиртХоста, ?(РежимПростойВыгрузки,"","virtualappiushost3"));
			
			Файл = Новый Файл(ПолноеИмяФайла);
			Если НЕ Файл.Существует() ИЛИ Файл.ПолучитьВремяИзменения()<>ФайлХоста.ДатаМодификации Тогда
				ДвоичныеДанныеФайла=ФайлХоста.Ссылка.ДвоичныеДанные.Получить();
				Если ДвоичныеДанныеФайла<>Неопределено Тогда 
					ДвоичныеДанныеФайла.Записать(ПолноеИмяФайла);
				ИначеЕсли ЗначениеЗаполнено(ФайлХоста.ТекстШаблона) Тогда 
					ТекстовыйДокумент = Новый ТекстовыйДокумент;
					ТекстовыйДокумент.УстановитьТекст(ФайлХоста.ТекстШаблона);
					ТекстовыйДокумент.Записать(ПолноеИмяФайла);
				КонецЕсли;
				
				Файл.УстановитьВремяИзменения(ФайлХоста.ДатаМодификации);
				
				Если НЕ РежимПростойВыгрузки И (ВРЕГ(Файл.Расширение)=".CSS" ИЛИ ВРЕГ(Файл.Расширение)=".JS") Тогда 
					// заменить src в файле
					ТекстовыйДокумент = Новый ТекстовыйДокумент;
					ТекстовыйДокумент.Прочитать(Файл.ПолноеИмя);
					ТекстФайла = СтрЗаменить(ТекстовыйДокумент.ПолучитьТекст(), ДоменноеИмяВиртХоста, СтрЗаменить(КаталогВыгрузки,"\","/")+"virtualappiushost3");
					ТекстовыйДокумент.УстановитьТекст(ТекстФайла);
					ТекстовыйДокумент.Записать(Файл.ПолноеИмя);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
	Исключение
		Сообщить(ПараметрыСеанса.aps_ИмяПродукта+НСтр("ru = 'При выгрузке файлов с виртуального хоста произошла ошибка:'; en_US = 'While downloading files from virtual host an error occurred:'")+Символы.ПС+ОписаниеОшибки(), СтатусСообщения.Внимание);
	КонецПопытки;
	
КонецПроцедуры

// Процедура загружает файлы из каталога на виртуальный хост
// Параметры:
//		ТекущийКаталог - Строка, путь к текущему каталогу на диске
//		ТекущийКаталогХоста - СправочникСсылка.aps_ВиртуальныйХост, родитель для каталога или файла виртуального хоста
//		ДоменноеИмяВиртХоста - Строка, по умолчанию http://virtualappiushost
//		ВКаталогеШаблонов - Булево, признак работы с каталогом шаблонов (TEMPLATES)
// Пример:
//		aps_УправлениеВиртуальнымХостом.aps_ЗагрузитьФайлыНаВиртуальныйХост(КаталогОбъект.ПолноеИмя+"\", Справочники.aps_ВиртуальныйХост.ПустаяСсылка(), "http://virtualappiushost");
//
Процедура aps_ЗагрузитьФайлыНаВиртуальныйХост( ТекущийКаталог, ТекущийКаталогХоста, ДоменноеИмяВиртХоста, ВКаталогеШаблонов = Ложь, НачальныйКаталог = "" ) Экспорт 
	
	Если ПустаяСтрока(НачальныйКаталог) Тогда 
		НачальныйКаталог = ТекущийКаталог;
	КонецЕсли;
	
	МассивФайлов = НайтиФайлы(ТекущийКаталог,"*.*");
	
	Для Каждого Файл Из МассивФайлов Цикл
		
		Если Файл.ЭтоКаталог() Тогда 
			// Создаем папку и читаем содержимое
			НовыйКаталогХоста = Справочники.aps_ВиртуальныйХост.СоздатьГруппу();
			НовыйКаталогХоста.Родитель		= ТекущийКаталогХоста;
			НовыйКаталогХоста.ИмяФайла		= Файл.Имя;
			НовыйКаталогХоста.ПолноеИмяФайла= ДоменноеИмяВиртХоста+"/"+СтрЗаменить(СтрЗаменить(Файл.ПолноеИмя,НачальныйКаталог,""),"\","/");
			НовыйКаталогХоста.Путь			= ДоменноеИмяВиртХоста+"/"+СтрЗаменить(СтрЗаменить(Файл.Путь,НачальныйКаталог,""),"\","/");
			
			НовыйКаталогХоста.Записать();
			
			aps_ЗагрузитьФайлыНаВиртуальныйХост(Файл.ПолноеИмя, НовыйКаталогХоста.Ссылка, ДоменноеИмяВиртХоста, ВРЕГ(Файл.Имя)="TEMPLATES" ИЛИ ВКаталогеШаблонов, НачальныйКаталог);
			
		Иначе 
			НовыйФайлХоста = Справочники.aps_ВиртуальныйХост.СоздатьЭлемент();
			НовыйФайлХоста.Родитель			= ТекущийКаталогХоста;
			НовыйФайлХоста.ДатаМодификации	= Файл.ПолучитьВремяИзменения();
			НовыйФайлХоста.ИмяФайла			= Файл.Имя;
			НовыйФайлХоста.ПолноеИмяФайла	= ДоменноеИмяВиртХоста+"/"+СтрЗаменить(СтрЗаменить(Файл.ПолноеИмя,НачальныйКаталог,""),"\","/");
			НовыйФайлХоста.Путь				= ДоменноеИмяВиртХоста+"/"+СтрЗаменить(СтрЗаменить(Файл.Путь,НачальныйКаталог,""),"\","/");
			
			Если ВКаталогеШаблонов Тогда
				ТекстовыйДокумент = Новый ТекстовыйДокумент;
				ТекстовыйДокумент.Прочитать(Файл.ПолноеИмя);
				НовыйФайлХоста.ТекстШаблона=ТекстовыйДокумент.ПолучитьТекст();
			Иначе
				НовыйФайлХоста.ДвоичныеДанные=Новый ХранилищеЗначения(Новый ДвоичныеДанные(Файл.ПолноеИмя));
			КонецЕсли;
			
			НовыйФайлХоста.Записать();
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Процедура загружает файлы с ftp-сервера во временный каталог на диске
// Параметры:
//		FTPСоединение - предназначен для работы с файлами и каталогами на ftp-сервере
//		ТекущийКаталогFTP - Строка, путь к текущему каталогу на ftp-сервере
//		ТекущийКаталог - Строка, путь к текущему каталогу на диске
// Пример:
//		aps_УправлениеВиртуальнымХостом.aps_ПолучитьФайлыССервераFTP(FTPСоединение, КаталогFTP, ВременныйКаталогВыгрузки);
//
Процедура aps_ПолучитьФайлыССервераFTP( FTPСоединение, ТекущийКаталогFTP, ТекущийКаталог ) Экспорт
	
	МассивФайловНаFTP = FTPСоединение.НайтиФайлы(ТекущийКаталогFTP, "*");
	Для Каждого ФайлFTP Из МассивФайловНаFTP Цикл
		
		Если ФайлFTP.ЭтоКаталог() Тогда
			Каталог = ТекущийКаталог+ФайлFTP.Имя;
			СоздатьКаталог(Каталог);
			aps_ПолучитьФайлыССервераFTP(FTPСоединение, ФайлFTP.ПолноеИмя, Каталог+"\");
		Иначе
			ПолноеИмяФайла = ТекущийКаталог+ФайлFTP.Имя;
			FTPСоединение.Получить(ФайлFTP.ПолноеИмя, ПолноеИмяФайла);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Процедура считает общее число файлов в каталоге
// Параметры:
//		ТекущийКаталог - Строка, путь к текущему каталогу
//		ЧислоФайлов - общее число файлов
//		FTPСоединение - предназначен для работы с файлами и каталогами на ftp-сервере
// Пример:
//      aps_ПолучитьОбщееЧислоФайлов(Файл.ПолноеИмя, ЧислоФайлов, FTPСоединение);
//
Процедура aps_ПолучитьОбщееЧислоФайлов( ТекущийКаталог, ЧислоФайлов, FTPСоединение = Неопределено ) Экспорт
	
	Если FTPСоединение <> Неопределено Тогда 
		МассивФайлов = FTPСоединение.НайтиФайлы(ТекущийКаталог, "*");
	Иначе 
		МассивФайлов = НайтиФайлы(ТекущийКаталог, "*");
	КонецЕсли;
	
	Для Каждого Файл Из МассивФайлов Цикл
		
		Если Файл.ЭтоКаталог() Тогда
			aps_ПолучитьОбщееЧислоФайлов(Файл.ПолноеИмя, ЧислоФайлов, FTPСоединение);
		Иначе
			ЧислоФайлов = ЧислоФайлов + 1;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры


// Процедура получает текст шаблона по имени файла виртуального хоста
// Параметры:
//		ИмяФайлаШаблона - Строка, полное имя файла шаблона на виртуальном хосте
// Возвращаемое значение:
//		Строка - код страницы шаблона
// Пример:
//		ТекстПодложки = aps_УправлениеВиртуальнымХостом.aps_ПолучитьТекстШаблона(virtualappiushost+"/TEMPLATES/basic/layers/catalog_layer.htm", Истина);
//
Функция aps_ПолучитьТекстШаблона( ИмяФайлаШаблона, ИзменитьСсылки = Ложь ) Экспорт 
	Если НЕ ЗначениеЗаполнено(ИмяФайлаШаблона) Тогда
		Возврат "";
	КонецЕсли;
	
	ЗапросФайловХоста = Новый Запрос("ВЫБРАТЬ
	                                 |	aps_ВиртуальныйХост.ТекстШаблона
	                                 |ИЗ
	                                 |	Справочник.aps_ВиртуальныйХост КАК aps_ВиртуальныйХост
	                                 |ГДЕ
	                                 |	(НЕ aps_ВиртуальныйХост.ЭтоГруппа)
	                                 |	И (НЕ aps_ВиртуальныйХост.ПометкаУдаления)
	                                 |	И aps_ВиртуальныйХост.ПолноеИмяФайла = &ПолноеИмяФайла");
	ЗапросФайловХоста.УстановитьПараметр("ПолноеИмяФайла", ИмяФайлаШаблона);
	ВыборкаФайлов = ЗапросФайловХоста.Выполнить().Выбрать();
	Если ВыборкаФайлов.Следующий() Тогда
		ТекстШаблона = ВыборкаФайлов.ТекстШаблона;
		Если ИзменитьСсылки Тогда
			ТекстШаблона = СтрЗаменить(ТекстШаблона, "http://virtualappiushost", СтрЗаменить(КаталогВременныхФайлов(), "\", "/") + "virtualappiushost3");
		КонецЕсли;
		
		Возврат ТекстШаблона;
	Иначе 
		Возврат "";
	КонецЕсли;
КонецФункции

// Процедура получает все HTML-шаблоны в зависимости от настроек системы
// Параметры:
//		Нет
// Возвращаемое значение:
//		ТаблицаЗначений
// Пример:
//		ШаблоныHTML = aps_УправлениеВиртуальнымХостом.aps_ПолучитьВсеШаблоныHTML();
//
Функция aps_ПолучитьВсеШаблоныHTML() Экспорт 
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	aps_ВиртуальныйХост.ПолноеИмяФайла,
	               |	aps_ВиртуальныйХост.ТекстШаблона
	               |ИЗ
	               |	Справочник.aps_ВиртуальныйХост КАК aps_ВиртуальныйХост
	               |ГДЕ
	               |	(aps_ВиртуальныйХост.ИмяФайла ПОДОБНО &htm
	               |			ИЛИ aps_ВиртуальныйХост.ИмяФайла ПОДОБНО &html)";
	Запрос.УстановитьПараметр("htm" , "%.htm" );
	Запрос.УстановитьПараметр("html", "%.html");
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

#КонецЕсли 

#КонецОбласти