// Открывает элементы в окне создания ревизий
//
// Параметры:
//  	itemArray - массив ссылок или объектов XDTO, или один элемент
// Пример:
//		aps_ОткрытьВОкнеСозданияРевизий(ПолучитьВыделенныеОбъекты());
//
Процедура aps_ОткрытьВОкнеСозданияРевизий( Знач itemArray ) Экспорт 
	Если ТипЗнч(itemArray) <> Тип("Массив") Тогда 
		item = itemArray;
		itemArray = Новый Массив;
		itemArray.Добавить(item);
	КонецЕсли;
	
	Если itemArray.Количество() = 0 Тогда 
		Возврат;
	КонецЕсли;
	
	СозданиеРевизий = Обработки.aps_СозданиеРевизий.ПолучитьФорму(,, Новый УникальныйИдентификатор());
	
	Для i=0 По itemArray.Количество()-1 Цикл 
		СтрокаТЧ = СозданиеРевизий.КорневыеЭлементы.Добавить();
		СтрокаТЧ.КорневойЭлемент = itemArray[i];
	КонецЦикла;

	СозданиеРевизий.Открыть();
КонецПроцедуры

// Открывает элементы в новом окне
//
// Параметры:
//  	itemArray - массив ссылок или объектов XDTO, или один элемент
//		ФормаВладелец - форма
// Возвращаемое значение:
//      Форма; Неопределено
// Пример:
//		Форма = aps_ОткрытьВОкнеУправленияИзделиями(activeItem);
//
Функция aps_ОткрытьВОкнеУправленияИзделиями( Знач itemArray, ФормаВладелец = Неопределено ) Экспорт 
	
	Если ТипЗнч(itemArray) <> Тип("Массив") Тогда 
		item = itemArray;
		itemArray = Новый Массив;
		itemArray.Добавить(item);
	КонецЕсли;
	
	Если itemArray.Количество() = 0 Тогда 
		Возврат Неопределено;
	КонецЕсли;
	
	УправлениеИзделиями = Обработки.aps_УправлениеИзделиями.ПолучитьФорму( , ФормаВладелец );
	
	Для i=0 По itemArray.Количество()-1 Цикл 
		СтрокаТЧ = УправлениеИзделиями.КорневыеЭлементы.Добавить();
		СтрокаТЧ.КорневойЭлемент = itemArray[i];
	КонецЦикла;
	
	УправлениеИзделиями.Открыть();
	Возврат УправлениеИзделиями;
	
КонецФункции

// Открывает элементы в новом окне
//
// Параметры:
//  	itemArray - массив ссылок или объектов XDTO, или один элемент
//		ФормаВладелец - форма
// Возвращаемое значение:
//		Форма; Неопределено
// Пример:
//		Форма = aps_ОткрытьВОкнеУправленияТехнологией(activeItem);
//
Функция aps_ОткрытьВОкнеУправленияТехнологией( Знач itemArray, ФормаВладелец = Неопределено ) Экспорт 
	
	Если ТипЗнч(itemArray) <> Тип("Массив") Тогда 
		item = itemArray;
		itemArray = Новый Массив;
		itemArray.Добавить(item);
	КонецЕсли;
	
	Если itemArray.Количество() = 0 Тогда 
		Возврат Неопределено;
	КонецЕсли;
	
	УправлениеТехнологией = Обработки.aps_УправлениеТехнологиейИзготовления.ПолучитьФорму( , ФормаВладелец );
	
	Для i=0 По itemArray.Количество()-1 Цикл 
		СтрокаТЧ = УправлениеТехнологией.КорневыеЭлементы.Добавить();
		СтрокаТЧ.КорневойЭлемент = itemArray[i];
	КонецЦикла;
	
	УправлениеТехнологией.Открыть();
	Возврат УправлениеТехнологией;
	
КонецФункции

// Открывает элементы в новом окне
//
// Параметры:
//		itemArray - массив ссылок или объектов XDTO, или один элемент
//		ФормаВладелец - форма
// Возвращаемое значение:
//		Форма; Неопределено
// Пример:
//		Форма = aps_ОткрытьВПроводнике(activeItem);
//
Функция aps_ОткрытьВПроводнике( Знач itemArray, ФормаВладелец = Неопределено ) Экспорт 
	
	Если ТипЗнч(itemArray) <> Тип("Массив") Тогда 
		item = itemArray;
		itemArray = Новый Массив;
		itemArray.Добавить(item);
	КонецЕсли;
	
	Если itemArray.Количество() = 0 Тогда 
		Возврат Неопределено;
	КонецЕсли;
	
	Проводник = Обработки.aps_Проводник.ПолучитьФорму(,, Новый УникальныйИдентификатор());
	
	Для i=0 По itemArray.Количество()-1 Цикл 
		СтрокаТЧ = Проводник.КорневыеЭлементы.Добавить();
		СтрокаТЧ.КорневойЭлемент = itemArray[i];
	КонецЦикла;
	
	Проводник.Открыть();
	Возврат Проводник;
	
КонецФункции

// Открывает элементы в новом окне
//
// Параметры:
//		itemArray - массив ссылок или объектов XDTO, или один элемент
// Пример:
//      aps_ОткрытьВКТС(МассивВыделенных);
//
Процедура aps_ОткрытьВКТС( Знач itemArray ) Экспорт 
	
	Если ТипЗнч(itemArray) <> Тип("Массив") Тогда 
		item = itemArray;
		itemArray = Новый Массив;
		itemArray.Добавить(item);
	КонецЕсли;
	
	Если itemArray.Количество() = 0 Тогда 
		Возврат;
	КонецЕсли;
	
	ФормаКТС = ПолучитьФорму("Обработка.aps_КонструкторскоТехнологическийСправочник.Форма.ФормаОсновная");
	Если НЕ ФормаКТС.Открыта() Тогда 
		ФормаКТС.Открыть();
		ФормаКТС.ПодключитьОбработчикОжидания("ДеревоПредставленияПриАктивизацииСтрокиОбработчикОжидания", 0.1, Истина);
	КонецЕсли;
	
	Для i = 0 По itemArray.Количество() - 1 Цикл
		Если ТипЗнч(itemArray[i]) = Тип("СправочникСсылка.aps_ЭлементыИзделия") Или 
				ТипЗнч(itemArray[i]) = Тип("СправочникСсылка.aps_ЭлементыСправочников") Или 
					ТипЗнч(itemArray[i]) = Тип("СправочникСсылка.aps_ЭлементыТехнологии") Тогда 
			ФормаКТС.ПоказатьЭлементВДереве(itemArray[i]);
		Иначе 
			ФормаКТС.ПоказатьЭлементВДереве(itemArray[i].element);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Процедура открывает вложение уведомления в зависимости от типа
// Параметры:
//		Вложение - произвольная ссылка
// Пример:
//      aps_ОткрытьВложение(ВыбраннаяСтрока.Вложение);
//
Процедура aps_ОткрытьВложение( Вложение ) Экспорт 
	ТипВложения = ТипЗнч(Вложение);
	Если ТипВложения = Тип("СправочникСсылка.aps_ЭлементыИзделия") Или 
			ТипВложения = Тип("СправочникСсылка.aps_ЭлементыСправочников") Или 
				ТипВложения = Тип("СправочникСсылка.aps_ЭлементыТехнологии") Тогда 
					
		aps_ОткрытьВПроводнике(Вложение);
	ИначеЕсли ЗначениеЗаполнено(Вложение) Тогда 
		Вложение.ПолучитьФорму().Открыть();
	КонецЕсли;
КонецПроцедуры

// Открывает элементы в окне проверки связи с номенклатурой
//
// Параметры:
//		itemArray - массив ссылок или объектов XDTO
// Пример:
//		aps_ВерификацияНоменклатуры(ПолучитьВыделенныеОбъекты());
//
Процедура aps_ВерификацияНоменклатуры( Знач itemArray ) Экспорт 
	Если ТипЗнч(itemArray) <> Тип("Массив") Тогда 
		item = itemArray;
		itemArray = Новый Массив;
		itemArray.Добавить(item);
	КонецЕсли;
	
	Если itemArray.Количество() = 0 Тогда 
		Возврат;
	КонецЕсли;
	
	ВерификацияНоменклатуры = Обработки.aps_ВерификацияНоменклатуры.ПолучитьФорму(,, Новый УникальныйИдентификатор());
	
	Для i=0 По itemArray.Количество()-1 Цикл 
		СтрокаТЧ = ВерификацияНоменклатуры.КорневыеЭлементы.Добавить();
		СтрокаТЧ.КорневойЭлемент = itemArray[i];
	КонецЦикла;

	ВерификацияНоменклатуры.Открыть();
КонецПроцедуры


// Процедура открывает окно со списком файлов для выгрузки
// Параметры:
//		itemXDTO - ОбъектXDTO
// Пример:
//		aps_ВыгрузкаФайловПоМоделиXDTO(activeItemXDTO);
//
Процедура aps_ВыгрузкаФайловПоМоделиXDTO( itemXDTO ) Экспорт
	Если itemXDTO = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	ФормаОбработкиФайлов = Обработки.aps_ФайлыДокумента.ПолучитьФорму(,, Новый УникальныйИдентификатор());
	ФормаОбработкиФайлов.МодельРодителя = itemXDTO;
	МассивЗависимыхДокументов = Новый Массив();
	// в параметр формы передаем массив файлов этого документа с зависимыми файлами
	МассивФайловКВыгрузке = ФормаОбработкиФайлов.ПолучитьФайлыДокумента(Ложь, МассивЗависимыхДокументов);
	Если МассивФайловКВыгрузке.Количество() = 0 Тогда 
		Предупреждение(НСтр("ru = 'Не найдено ни одного файла!'; en_US = 'No file was found!'"));
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("СписокФайлов"			, МассивФайловКВыгрузке);
	ПараметрыФормы.Вставить("Режим"					, 3);
	ПараметрыФормы.Вставить("ВозможностьАрхивации"	, Истина);
	ПараметрыФормы.Вставить("БезЗависимостей"		, Истина);
	
	ФормаСпискаФайлов = ПолучитьФорму("Обработка.aps_ФайлыДокумента.Форма.ФормаВыгружаемыхФайлов", ПараметрыФормы);
	МассивФайловКВыгрузке = ФормаСпискаФайлов.ОткрытьМодально();
	Если МассивФайловКВыгрузке = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КаталогВыгрузкиФайлов	= ФормаСпискаФайлов.КаталогВыгрузки;
	Расшифровать			= ФормаСпискаФайлов.Расшифровать;
	ИмяАрхива				= ?(ФормаСпискаФайлов.ЗапаковатьВАрхив, ФормаСпискаФайлов.ИмяАрхива, "");
	ПарольАрхива			= ?(ФормаСпискаФайлов.ЗапаковатьВАрхив, ФормаСпискаФайлов.Пароль, "");
	
	ФормаОбработкиФайлов.ВыгрузитьФайлыНаДиск(МассивФайловКВыгрузке, КаталогВыгрузкиФайлов, Расшифровать, ИмяАрхива, ПарольАрхива);
КонецПроцедуры


// Вызов формы выбора значения свойства
//
// Параметры:
//		ФормаВладелец - Форма; Неопределено
//		ЭлементУправления - элемент управления, в котором происходит выбор значения, либо произвольный ключ уникальности
//		Свойство - ПланВидовХарактеристикСсылка.aps_Свойства
// Возвращаемое значение:
//		Выбранное значение свойства; Неопределено
// Пример:
//		ЗначениеПараметра = aps_ОткрытьФормуВыбораЗначения(Неопределено, Новый Структура("Значение", ЗначениеПараметра), Свойство);
//
Функция aps_ОткрытьФормуВыбораЗначения(ФормаВладелец, ЭлементУправления, Свойство) Экспорт 
	Попытка        
		// получить объект обработки выбора
		ОбъектОбработкиВыбора = Вычислить(СтрЗаменить(Свойство.ОбработкаВыбораЗначения, "Обработка.", "Обработки.") + ".Создать()");
	Исключение
		Попытка
			// получить форму выбора
			ОбъектОбработкиВыбора = ПолучитьФорму(Свойство.ОбработкаВыбораЗначения,, ФормаВладелец);
		Исключение
			Сообщить(ПараметрыСеанса.aps_ИмяПродукта + НСтр("ru = 'Для свойства <'; en_US = 'The choice processing for the <'") + Свойство.Наименование + НСтр("ru = '> неверно задана обработка выбора'; en_US = '> property is incorrectly specified'"));
			Возврат Неопределено;
		КонецПопытки;
	КонецПопытки;
	
	СтруктураПараметровВыбора = Новый Структура;
	Для Каждого ПараметрВыбора Из Свойство.ПараметрыВыбора Цикл 
		СтруктураПараметровВыбора.Вставить(ПараметрВыбора.Реквизит, ПараметрВыбора.Значение);
	КонецЦикла;
	
	Попытка
		ЗаполнитьЗначенияСвойств(ОбъектОбработкиВыбора, СтруктураПараметровВыбора);
	Исключение
		ТекстEN = "Parameters of the choice processing for the <" + Свойство.Наименование + "> property are incorrectly specified";
		ТекстRU = "Для свойства <" + Свойство.Наименование + "> неверно заданы параметры обработки выбора";
		Сообщить(ПараметрыСеанса.aps_ИмяПродукта + НСтр("ru = """+ТекстRU+"""; en_US = """+ТекстEN+""""));
		Возврат Неопределено
	КонецПопытки;
	
	Если ТипЗнч(ОбъектОбработкиВыбора) = Тип("Форма") Или ТипЗнч(ОбъектОбработкиВыбора) = Тип("УправляемаяФорма") Тогда
		// форма или управляемая форма
		ФормаВыбораЗначения = ОбъектОбработкиВыбора;
		ФормаВыбораЗначения.КлючУникальности = ЭлементУправления;
	Иначе 
		ФормаВыбораЗначения = ОбъектОбработкиВыбора.ПолучитьФорму(, ФормаВладелец, ЭлементУправления);
	КонецЕсли;
	
	Если ФормаВладелец = Неопределено Тогда 
		ВыбранноеЗначение = ФормаВыбораЗначения.ОткрытьМодально();
		Возврат ВыбранноеЗначение;
	Иначе // ФормаВладелец оповещается о выборе
		ФормаВыбораЗначения.Открыть();
		Возврат Неопределено;
	КонецЕсли;
КонецФункции

// Процедура устанавливает картинку кнопки выбора элемента управления
//
// Параметры:
//		ЭлементУправления - элемент управления, для которого необходимо установить картинку кнопки выбора
//		Свойство - ПланВидовХарактеристикСсылка.aps_Свойства
// Пример:
//		aps_УстановитьКартинкуКнопкиВыбора(Элемент.Колонки.Значение.ЭлементУправления, Элемент.ТекущаяСтрока.Свойство);
//
Процедура aps_УстановитьКартинкуКнопкиВыбора(ЭлементУправления, Свойство) Экспорт 
	Если Тип(ЭлементУправления) <> Тип("ПолеВвода") Тогда 
		Возврат;
	КонецЕсли;
	ЭлементУправления.КартинкаКнопкиВыбора = Новый Картинка();
	Если ЗначениеЗаполнено(Свойство) И ЗначениеЗаполнено(Свойство.КартинкаКнопкиВыбора) Тогда
		Попытка
			ЭлементУправления.КартинкаКнопкиВыбора = БиблиотекаКартинок[Свойство.КартинкаКнопкиВыбора];
		Исключение
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры


#Область ПроцедурыРаботыСДеревом

// Процедура сворачивает все элементы дерева кроме выделенной строки и всего что ниже ее
// Параметры:
//		ЭлементФормыДерево - табличное поле дерева
//		Строка - строка табличного поля
// Пример:
//		aps_СвернутьВсеКромеТекущей(ЭлементыФормы.ДеревоСостава, ТекущаяСтрока);
//
Процедура aps_СвернутьВсеКромеТекущей( ЭлементФормыДерево, Строка ) Экспорт 
	СтрокаКРазвороту=Строка;
	СтараяТекущаяСтрока=СтрокаКРазвороту;
	
	Дерево = ЭлементФормыДерево.Значение;
	
	Для i=0 По Дерево.Строки.Количество()-1 Цикл 
		aps_СвернутьДерево(ЭлементФормыДерево, Дерево.Строки[i]);
	КонецЦикла;
	
	Пока СтрокаКРазвороту<>Неопределено Цикл
		ЭлементФормыДерево.Развернуть(СтрокаКРазвороту);
		СтрокаКРазвороту=СтрокаКРазвороту.Родитель;
	КонецЦикла;
	
	ЭлементФормыДерево.ТекущаяСтрока=СтараяТекущаяСтрока;
КонецПроцедуры

// Сворачивает дерево (рекурсивная)	
Процедура aps_СвернутьДерево( ЭлементФормыДерево, Строка )
	ЭлементФормыДерево.Свернуть(Строка);
	Для i=0 По Строка.Строки.Количество()-1 Цикл
		aps_СвернутьДерево(ЭлементФормыДерево, Строка.Строки[i]);
	КонецЦикла;
КонецПроцедуры

#КонецОбласти


#Область ПроцедурыРаботыСФормой

// Процедура выполняет сворачивание/разворачивание элементов форм
//
// Параметры:
//		Видимость - Булево, признак "развернутости" элемента. 
//		ГлавныйЭлемент - Элемент формы который сворачиваем.
//		Главный разделить - Разделитель.
//		Панель формы - панель или главная панель формы.
//		Направление - Строка, направление сворачивания.
//		Подчиненный элемент - Элемент формы противоположный относительно разделителя сворачиваемую элементу.
// Пример:
//		aps_УправлениеВидимостьюЭлементовФормы(	Кнопка.Пометка,
//												ЭлементыФормы.ПанельРевизий,
//												ЭлементыФормы.РазделительГоризонтальный,
//												Панель,
//												"низ");
//
Процедура aps_УправлениеВидимостьюЭлементовФормы(Видимость,ГлавныйЭлемент,ГлавныйРазделитель,ПанельФормы,Направление,ПодчиненныйЭлемент="")   Экспорт
      
      Если Нрег(Направление) =  "лево" Тогда
            
            Если Видимость Тогда
                  // откроем 
                  ГлавныйРазделитель.Свертка=РежимСверткиЭлементаУправления.Нет;
                  ГлавныйЭлемент.Свертка=РежимСверткиЭлементаУправления.Нет;
                  ГлавныйРазделитель.УстановитьПривязку(ГраницаЭлементаУправления.Лево,ГлавныйРазделитель, ГраницаЭлементаУправления.Право);
                  ГлавныйРазделитель.УстановитьПривязку(ГраницаЭлементаУправления.Право,ПанельФормы, ГраницаЭлементаУправления.Лево,ПанельФормы, ГраницаЭлементаУправления.Право);
                  ГлавныйЭлемент.УстановитьПривязку(ГраницаЭлементаУправления.Право,ГлавныйРазделитель,ГраницаЭлементаУправления.Лево);
                  ГлавныйРазделитель.Ширина = 4;
            Иначе      
                  // скроем 
                  ГлавныйЭлемент.УстановитьПривязку(ГраницаЭлементаУправления.Право);
                  ГлавныйРазделитель.УстановитьПривязку(ГраницаЭлементаУправления.Лево,ГлавныйЭлемент,ГраницаЭлементаУправления.Право);
                  ГлавныйРазделитель.УстановитьПривязку(ГраницаЭлементаУправления.Право);
                  ГлавныйЭлемент.Свертка=РежимСверткиЭлементаУправления.Лево;
                  ГлавныйРазделитель.Свертка=РежимСверткиЭлементаУправления.Лево;
            КонецЕсли;
            
      ИначеЕсли Нрег(Направление) = "право" Тогда
            
            Если Видимость Тогда
                  // Показать
                  ГлавныйРазделитель.Свертка = РежимСверткиЭлементаУправления.Нет;
                  ГлавныйЭлемент.Свертка = РежимСверткиЭлементаУправления.Нет;
                  ГлавныйРазделитель.УстановитьПривязку(ГраницаЭлементаУправления.Право, ПанельФормы, ГраницаЭлементаУправления.Лево,  ПанельФормы, ГраницаЭлементаУправления.Право);
                  ГлавныйРазделитель.УстановитьПривязку(ГраницаЭлементаУправления.Лево, ГлавныйРазделитель, ГраницаЭлементаУправления.Право);
                  ГлавныйЭлемент.УстановитьПривязку(ГраницаЭлементаУправления.Лево,ГлавныйРазделитель, ГраницаЭлементаУправления.Право);
                  ГлавныйРазделитель.Ширина = 4;
            Иначе 
                  //скрыть 
                  ГлавныйЭлемент.УстановитьПривязку(ГраницаЭлементаУправления.Лево);
                  ГлавныйРазделитель.УстановитьПривязку(ГраницаЭлементаУправления.Лево);
                  ГлавныйРазделитель.УстановитьПривязку(ГраницаЭлементаУправления.Право, ГлавныйЭлемент, ГраницаЭлементаУправления.Лево);
                  ГлавныйЭлемент.Свертка = РежимСверткиЭлементаУправления.Право;
                  ГлавныйРазделитель.Свертка = РежимСверткиЭлементаУправления.Право;
            КонецЕсли;      
            
      ИначеЕсли Нрег(Направление) = "низ" Тогда
            
            Если Видимость Тогда
                  // Откроем
                  ГлавныйРазделитель.Свертка  = РежимСверткиЭлементаУправления.Нет;
                  ГлавныйЭлемент.Свертка            = РежимСверткиЭлементаУправления.Нет;
                  ГлавныйРазделитель.УстановитьПривязку(ГраницаЭлементаУправления.Верх,ГлавныйРазделитель,ГраницаЭлементаУправления.Низ);
                  ГлавныйРазделитель.УстановитьПривязку(ГраницаЭлементаУправления.Низ,ПанельФормы, ГраницаЭлементаУправления.Верх,ПанельФормы, ГраницаЭлементаУправления.Низ);
                  ГлавныйЭлемент.УстановитьПривязку(ГраницаЭлементаУправления.Верх, ГлавныйРазделитель,ГраницаЭлементаУправления.Низ);
                  ГлавныйРазделитель.Высота       = 4;
            Иначе // Скроем 
                  ГлавныйРазделитель.УстановитьПривязку(ГраницаЭлементаУправления.Верх);
                  ГлавныйЭлемент.УстановитьПривязку(ГраницаЭлементаУправления.Верх);
                  ГлавныйРазделитель.УстановитьПривязку(ГраницаЭлементаУправления.Низ, ГлавныйЭлемент,ГраницаЭлементаУправления.Верх);
                  ГлавныйЭлемент.Свертка             = РежимСверткиЭлементаУправления.Низ;            
                  ГлавныйРазделитель.Свертка      = РежимСверткиЭлементаУправления.Низ;            
            КонецЕсли;
            
            
      ИначеЕсли Нрег(Направление) = "верх" Тогда
            // не тестированно
            Если Видимость Тогда
                  // Откроем
                  ГлавныйРазделитель.Свертка  = РежимСверткиЭлементаУправления.Нет;
                  ГлавныйЭлемент.Свертка            = РежимСверткиЭлементаУправления.Нет;
                  ГлавныйРазделитель.УстановитьПривязку(ГраницаЭлементаУправления.Верх,ГлавныйРазделитель,ГраницаЭлементаУправления.Низ);
                  ГлавныйРазделитель.УстановитьПривязку(ГраницаЭлементаУправления.Низ,ПанельФормы, ГраницаЭлементаУправления.Верх,ПанельФормы, ГраницаЭлементаУправления.Низ);
                  ГлавныйЭлемент.УстановитьПривязку(ГраницаЭлементаУправления.Низ, ГлавныйРазделитель,ГраницаЭлементаУправления.Верх);
                  ГлавныйРазделитель.Высота       = 4;
            Иначе // Скроем 
                  ГлавныйРазделитель.УстановитьПривязку(ГраницаЭлементаУправления.Низ);
                  ГлавныйЭлемент.УстановитьПривязку(ГраницаЭлементаУправления.Низ);
                  ГлавныйРазделитель.УстановитьПривязку(ГраницаЭлементаУправления.Верх, ГлавныйЭлемент,ГраницаЭлементаУправления.низ);
                  ГлавныйЭлемент.Свертка             = РежимСверткиЭлементаУправления.Верх;            
                  ГлавныйРазделитель.Свертка      = РежимСверткиЭлементаУправления.Верх;            
            КонецЕсли;
            
            
   КонецЕсли;

КонецПроцедуры	// обУправлениеВидимостиЭлементов()

#КонецОбласти

#КонецЕсли

#КонецОбласти


#Область ПрограммныйИнтерфейсУправляемоеПриложение

#Если ТолстыйКлиентУправляемоеПриложение Или ТонкийКлиент Или ВебКлиент Тогда
	
// Открывает элементы в новом окне
//
// Параметры:
//		itemArray - массив ссылок или объектов XDTO, или один элемент
// Пример:
//		aps_ОткрытьВПроводнике(activeItem);
Процедура aps_ОткрытьВПроводнике( Знач itemArray ) Экспорт
	Если ТипЗнч(itemArray) <> Тип("Массив") Тогда 
		item = itemArray;
		itemArray = Новый Массив;
		itemArray.Добавить(item);
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("КорневыеЭлементы", itemArray);
	
	ОткрытьФорму("Обработка.aps_Проводник.Форма.ФормаУправляемая", ПараметрыФормы,, Новый УникальныйИдентификатор());
КонецПроцедуры

#КонецЕсли

#КонецОбласти


#Область ПрограммныйИнтерфейсКлиент

#Если Клиент Тогда 

// Показывает пользователю диалог подтверждения выхода из программы.
// Параметры:
//		Отказ - (булево) устанавливается в процедуре, как Истина
//                   если пользователь отказлся от закрытия программы
// Возвращаемое значение:
//		Истина - пользователь отказался от закрытия программы
//		Ложь - пользователь решил закрыть программу, или диалог закрытия не вызывался
// Пример:
//		ВопросПользователюПередЗавершениемРаботыСистемы(Отказ);
//
Функция ВопросПользователюПередЗавершениемРаботыСистемы(Отказ) Экспорт
	
	ЗапрашиватьПодтверждениеПриЗавершенииПрограммы = aps_ПолныеПрава.aps_ПолучитьНастройкуИзХранилищаОбщихНастроек("ОбщиеНастройкиПользователя", "ЗапрашиватьПодтверждениеПриЗавершенииПрограммы");
	Если ЗапрашиватьПодтверждениеПриЗавершенииПрограммы  = Неопределено Тогда 
		ЗапрашиватьПодтверждениеПриЗавершенииПрограммы = Истина;
	КонецЕсли;
	
	БольшеНеЗадаватьЭтотВопрос = НЕ ЗапрашиватьПодтверждениеПриЗавершенииПрограммы;
	Если БольшеНеЗадаватьЭтотВопрос Тогда 
		Возврат Ложь;
	КонецЕсли;
	
	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить("КодВозвратаДиалога."+Строка(КодВозвратаДиалога.Да),	НСтр("ru = 'Завершить'"));
	Кнопки.Добавить("КодВозвратаДиалога."+Строка(КодВозвратаДиалога.Нет),	НСтр("ru = 'Не завершать'"));
	
	Результат = ВопросПользователю(НСтр("ru = 'Завершить работу с программой?'"), Кнопки, , КодВозвратаДиалога.Да, "Завершение работы", 
		КодВозвратаДиалога.Нет, БольшеНеЗадаватьЭтотВопрос);
	Если БольшеНеЗадаватьЭтотВопрос Тогда
		aps_ПолныеПрава.aps_СохранитьНастройкуВХранилищеОбщихНастроек("ОбщиеНастройкиПользователя", "ЗапрашиватьПодтверждениеПриЗавершенииПрограммы", НЕ БольшеНеЗадаватьЭтотВопрос);
	КонецЕсли;
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Отказ = Истина;
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

// Вызывает форму вопроса.
//
// Параметры:
//		ТекстСообщения - строка - текст вопроса для пользователя
//		Кнопки - РежимДиалогаВопрос; СписокЗначений. 
//           Задает состав и текст кнопок диалога, а также, связанные с кнопками значения.
//           При использовании типа СписокЗначений:
//           Значение – содержит значение, связанное с кнопкой. Это значение является возвращаемым значением при выборе кнопки.
//           В качестве значения может использоваться значение перечисления КодВозвратаДиалога, а также другие значения;
//           Примечание: значение должно поддерживать XDTO сериализацию.
//           Представление – задает текст кнопки.
//		Таймаут - значение таймаута в секундах, по истечению этого времени функцию вернет значение КодВозвратаДиалога.Таймаут
//
// Возвращаемое значение:
//		КодВозвратаДиалога
//
// Пример:
//		Результат = ВопросПользователю(НСтр("ru = 'Завершить работу с программой?'"), Кнопки, , КодВозвратаДиалога.Да, "Завершение работы", 
//										КодВозвратаДиалога.Нет, БольшеНеЗадаватьЭтотВопрос);
//
Функция ВопросПользователю(ТекстСообщения, Кнопки, Таймаут = 0, КнопкаПоУмолчанию = Неопределено, Заголовок = "", 
	КнопкаТаймаута = Неопределено, БольшеНеЗадаватьЭтотВопрос = Ложь) Экспорт
	
	БольшеНеЗадаватьЭтотВопрос = Ложь;
	
	Параметры = Новый Структура;
	
	Если ТипЗнч(Кнопки) = Тип("РежимДиалогаВопрос") Тогда
		Если      Кнопки = РежимДиалогаВопрос.ДаНет Тогда
			КнопкиПараметр = "РежимДиалогаВопрос.ДаНет";
		ИначеЕсли Кнопки = РежимДиалогаВопрос.ДаНетОтмена Тогда
			КнопкиПараметр = "РежимДиалогаВопрос.ДаНетОтмена";
		ИначеЕсли Кнопки = РежимДиалогаВопрос.ОК Тогда
			КнопкиПараметр = "РежимДиалогаВопрос.ОК";
		ИначеЕсли Кнопки = РежимДиалогаВопрос.ОКОтмена Тогда
			КнопкиПараметр = "РежимДиалогаВопрос.ОКОтмена";
		ИначеЕсли Кнопки = РежимДиалогаВопрос.ПовторитьОтмена Тогда
			КнопкиПараметр = "РежимДиалогаВопрос.ПовторитьОтмена";
		ИначеЕсли Кнопки = РежимДиалогаВопрос.ПрерватьПовторитьПропустить Тогда
			КнопкиПараметр = "РежимДиалогаВопрос.ПрерватьПовторитьПропустить";
		КонецЕсли;
	Иначе
		КнопкиПараметр = Кнопки;
	КонецЕсли;
	
	Если ТипЗнч(КнопкаПоУмолчанию) = Тип("КодВозвратаДиалога") Тогда
		КнопкаПоУмолчаниюПараметр = "КодВозвратаДиалога." + Строка(КнопкаПоУмолчанию);
	Иначе
		КнопкаПоУмолчаниюПараметр = КнопкаПоУмолчанию;
	КонецЕсли;
	
	Если ТипЗнч(КнопкаТаймаута) = Тип("КодВозвратаДиалога") Тогда
		КнопкаТаймаутаПараметр = "КодВозвратаДиалога." + Строка(КнопкаТаймаута);
	Иначе
		КнопкаТаймаутаПараметр = КнопкаТаймаута;
	КонецЕсли;
	
	Параметры.Вставить("Кнопки",            КнопкиПараметр);
	Параметры.Вставить("Таймаут",           Таймаут);
	Параметры.Вставить("КнопкаПоУмолчанию", КнопкаПоУмолчаниюПараметр);
	Параметры.Вставить("Заголовок",         Заголовок);
	Параметры.Вставить("КнопкаТаймаута",    КнопкаТаймаутаПараметр);
	Параметры.Вставить("ТекстСообщения",    ТекстСообщения);
	
	Результат = ОткрытьФормуМодально("ОбщаяФорма.Вопрос", Параметры);
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		БольшеНеЗадаватьЭтотВопрос = Результат.БольшеНеЗадаватьЭтотВопрос;
		Возврат Результат.Значение;
	Иначе
		Возврат КодВозвратаДиалога.Отмена;
	КонецЕсли;
	
КонецФункции

#КонецЕсли

#КонецОбласти

