// Процедура выполняется при запуске платформы в обычном приложении
//
// Параметры
//		нет
//
Процедура apsВыполнитьПриСтарте1С() Экспорт
	Если РольДоступна("aps_Администратор")			 Или 
		 РольДоступна("aps_ОпытныйПользователь")	 Или
		 РольДоступна("aps_Пользователь")			 Или
		 РольДоступна("aps_УправлениеИзделиями")	 Или 
		 РольДоступна("aps_УправлениеТехнологией")	 Или
		 РольДоступна("aps_УправлениеАрхивом")		 Или 
		 РольДоступна("aps_УправлениеИзменениями")	 Или 
		 РольДоступна("aps_УправлениеНормированием") Тогда
		 
		Если ПараметрыСеанса.ТекущийПользователь.Пустая() Тогда 
			Предупреждение(НСтр("ru = 'Для работы информационной базы 1С:PDM требуется авторизация! Создайте как минимум одного пользователя и повторите вход.'; en_US = 'To work with information base of 1C:PDM authorization required! Create at least one user and login again.'"));
			ЗавершитьРаботуСистемы(Ложь); // безусловное завершение работы программы
			Возврат;
		КонецЕсли;
		
		ТекущаяВерсия = "3.0.3.1";
		Если Константы.aps_ВерсияКонфигурации.Получить()<>ТекущаяВерсия Тогда
			Если НЕ aps_ЯАдмин() Тогда 
				Предупреждение(НСтр("ru = 'Необходимо выполнить вход в систему под пользователем, имеющим роль ""Администратор (PDM)""!'; en_US = 'You need to login as user having the ""Administrator (PDM)"" role!'"));
				ЗавершитьРаботуСистемы(Ложь); // безусловное завершение работы программы
				Возврат;
			КонецЕсли;
			

			УстановитьВерсиюВБазе = Истина;
			Если Константы.aps_ВерсияКонфигурации.Получить()<>"" 
				И Найти(Константы.aps_ВерсияКонфигурации.Получить(), "3.0.3")=0 Тогда
				ЛегальностьПолученияОбновлений = ОткрытьФормуМодально("Обработка.ЛегальностьПолученияОбновлений.Форма",
													Новый Структура("ПоказыватьПредупреждениеОПерезапуске,ПринудительныйЗапуск", Истина, Истина) );
				Если ЛегальностьПолученияОбновлений <> Истина Тогда 
					ЗавершитьРаботуСистемы(Ложь); // безусловное завершение работы программы
					Возврат;
				КонецЕсли;

				
				ПараметрыСеанса.aps_ПроверкаУникальностиВключена = Ложь;
				Сообщить(ПараметрыСеанса.aps_ИмяПродукта+НСтр("ru = 'Выполняется обновление информационной базы до версии '; en_US = 'Updating the information base to '")+ ТекущаяВерсия+НСтр("ru = ''; en_US = ' version'"), СтатусСообщения.Информация);
				
				Попытка
					НачатьТранзакцию();
					
					/////////////////////////////////////////////////////////////////////////////
					// конвертация данных
					Обработки.ОбновлениеИнформационнойБазы.ПолучитьФорму("КонвертацияДанных").ВыполнитьКонвертациюДанных();
					
					ЗафиксироватьТранзакцию();
					ПараметрыСеанса.aps_ПроверкаУникальностиВключена = Истина;
					Сообщить(ПараметрыСеанса.aps_ИмяПродукта+НСтр("ru = 'Обновление информационной базы выполнено'; en_US = 'Information base is updated'"), СтатусСообщения.Информация);
					
					// окно со списком изменений в релизе
					ФормаОписанияОбновлений = Обработки.ОбновлениеИнформационнойБазы.ПолучитьФорму();
					ФормаОписанияОбновлений.Открыть();
				Исключение
					ОтменитьТранзакцию();
					УстановитьВерсиюВБазе = Ложь;
					ПараметрыСеанса.aps_ПроверкаУникальностиВключена = Истина;
					Сообщить(ПараметрыСеанса.aps_ИмяПродукта+НСтр("ru = 'При обновлении информационной базы произошла ошибка:'; en_US = 'When updating the information base an error occurred:'")+Символы.ПС+ОписаниеОшибки(), СтатусСообщения.Внимание);
				КонецПопытки;
			КонецЕсли;
			
			Если УстановитьВерсиюВБазе Тогда 
				Константы.aps_ВерсияКонфигурации.Установить(ТекущаяВерсия);
			КонецЕсли;
			
			// включить проверку уникальности
			Константы.aps_ПроверкаУникальностиВключена.Установить(Истина);
		КонецЕсли; // Если Константы.aps_ВерсияКонфигурации.Получить()<>ТекущаяВерсия Тогда
		
		Если Константы.aps_ПервоначальнаяЗагрузкаВыполнена.Получить()=Ложь Тогда
			Если НЕ aps_ЯАдмин() Тогда 
				Предупреждение(НСтр("ru = 'Необходимо выполнить вход в систему под пользователем, имеющим роль ""Администратор (PDM)""!'; en_US = 'You need to login as user having the ""Administrator (PDM)"" role!'"));
				ЗавершитьРаботуСистемы(Ложь); // безусловное завершение работы программы
				Возврат;
			КонецЕсли;
			
			Если Вопрос(НСтр("ru = 'Будет выполнено первоначальное заполнение базы 1С:PDM. Продолжить?'; en_US = 'The 1C:PDM information base will be initialized. Continue?'"), РежимДиалогаВопрос.ОКОтмена,,КодВозвратаДиалога.ОК) = КодВозвратаДиалога.ОК Тогда
				УстановитьФлагПервоначальнойЗагрузкиВБазе = Истина;
				Сообщить(ПараметрыСеанса.aps_ИмяПродукта+НСтр("ru = 'Выполняется первоначальное заполнение базы для версии '; en_US = 'Initializing information base for '")+ ТекущаяВерсия + НСтр("ru = ''; en_US = ' version'"), СтатусСообщения.Информация);
				
				Попытка
					ИмяФайлаДанных = ПолучитьИмяВременногоФайла(".xml");
					ТекущийПользовательИБ = ПользователиИнформационнойБазы.ТекущийПользователь();
					Если ТекущийПользовательИБ.Язык <> Неопределено И ТекущийПользовательИБ.Язык.КодЯзыка = "en_US" Тогда 
						ДвДанные = ПолучитьОбщийМакет("aps_ПервоначальноеЗаполнениеEn");
					Иначе 
						ДвДанные = ПолучитьОбщийМакет("aps_ПервоначальноеЗаполнение");
					КонецЕсли;
					
					ДвДанные.Записать(ИмяФайлаДанных);
					
					aps_УправлениеВиртуальнымХостом.aps_УдалитьФайлыСВиртуальногоХоста();

					ОбработкаЗагрузки = Обработки.УниверсальныйОбменДаннымиXML.Создать();
					ОбработкаЗагрузки.ЗаписыватьВИнформационнуюБазуТолькоИзмененныеОбъекты = Ложь;
					ОбработкаЗагрузки.ИмяФайлаОбмена = ИмяФайлаДанных;
					ОбработкаЗагрузки.РежимОбмена = "Загрузка";
					ОбработкаЗагрузки.ВыполнитьЗагрузку();
					
					
					ПортСервераСЛК = Константы.aps_ПортСервераСЛК.Получить();
					Если НЕ ЗначениеЗаполнено(ПортСервераСЛК) Тогда 
						Константы.aps_ПортСервераСЛК.Установить(9099);
					КонецЕсли;
					
					Сообщить(ПараметрыСеанса.aps_ИмяПродукта+НСтр("ru = 'Первоначальное заполнение выполнено'; en_US = 'Information base is initialized.'"), СтатусСообщения.Информация);
				Исключение
					УстановитьФлагПервоначальнойЗагрузкиВБазе = Ложь;
					Сообщить(ПараметрыСеанса.aps_ИмяПродукта+НСтр("ru = 'При первоначальном заполнении произошла ошибка:'; en_US = 'When initializing the information base an error occurred:'")+Символы.ПС+ОписаниеОшибки(), СтатусСообщения.Внимание);
				КонецПопытки;
				
				Если УстановитьФлагПервоначальнойЗагрузкиВБазе Тогда 
					Константы.aps_ПервоначальнаяЗагрузкаВыполнена.Установить(Истина);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли; // Если Константы.aps_ПервоначальнаяЗагрузкаВыполнена.Получить()=Ложь Тогда
		
		Если Константы.aps_ПервоначальнаяЗагрузкаВыполнена.Получить()=Ложь Тогда
			Предупреждение(НСтр("ru = 'Для конфигурации не выполнено первоначальное заполнение! Это может повлечь за собой неправильную работу! Выполните первоначальное заполнение!'; en_US = 'The configuration is not initialized! It may result in a malfunction of the system. Please initialize the configuration.'"));
			Возврат;
		КонецЕсли;
		
		
		Состояние(НСтр("ru = 'Запуск системы 1С:PDM...'; en_US = 'Starting 1C:PDM...'"));
		aps_УправлениеВиртуальнымХостом.aps_ВыгрузитьФайлыСВиртуальногоХоста(КаталогВременныхФайлов(), "http://virtualappiushost");
		
		Обработки.aps_РабочийСтолПользователя.ПолучитьФорму().Открыть();
		
		ИнтервалВМинутах=ВосстановитьЗначение("APPIUS_ИнтервалСообщенийОНовыхУведомлениях");
		Если ЗначениеЗаполнено(ИнтервалВМинутах) Тогда 
			ПодключитьОбработчикОжидания("aps_ПроверкаНовыхУведомлений", ИнтервалВМинутах*60);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

