// Функция переводит цвет из схемы RGB в HEX
// Параметры:
//		R - число
//		G - число
//		B - число
// Возвращаемое значение: 
//		Строка
// Пример:
//		backgroundColor	= RGB2HEX(backgroundColorRGB.Красный, backgroundColorRGB.Зеленый, backgroundColorRGB.Синий);
//
Функция RGB2HEX( Знач R, Знач G, Знач B ) Экспорт 
	RHEX = Сред("0123456789ABCDEF",(R-R%16)/16+1,1) + Сред("0123456789ABCDEF",R%16+1,1);
	GHEX = Сред("0123456789ABCDEF",(G-G%16)/16+1,1) + Сред("0123456789ABCDEF",G%16+1,1);
	BHEX = Сред("0123456789ABCDEF",(B-B%16)/16+1,1) + Сред("0123456789ABCDEF",B%16+1,1);
	Возврат RHEX+GHEX+BHEX;
КонецФункции

// Функция переводит цвет из схемы HEX в RGB
// Параметры:
//		HEX - строка
// Возвращаемое значение: 
//		Цвет
// Пример:
//      borderColorRGB	= HEX2RGB(tableObject.style.borderColor);
//
Функция HEX2RGB( Знач HEX ) Экспорт 
	HEX = СтрЗаменить(ВРег(HEX), "#", "");
	Red 	= 16*(Найти("0123456789ABCDEF",Сред(HEX,1,1))-1) + Найти("0123456789ABCDEF",Сред(HEX,2,1))-1;
	Green 	= 16*(Найти("0123456789ABCDEF",Сред(HEX,3,1))-1) + Найти("0123456789ABCDEF",Сред(HEX,4,1))-1;
	Blue 	= 16*(Найти("0123456789ABCDEF",Сред(HEX,5,1))-1) + Найти("0123456789ABCDEF",Сред(HEX,6,1))-1;
	Возврат Новый Цвет(Red,Green,Blue);
КонецФункции

// Преобразует исходный цвет в формат RGB
//
// Параметры:
//  ИсходныйЦвет - Цвет - Цвет который нужно преобразовать
