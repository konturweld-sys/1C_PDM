// Функция форматирования числового значения параметра 
// Параметры: 
//		Значение - число
//		ОписаниеТиповСвойства - ОписаниеТипов
// Возвращаемое значение:
//		Строка
// Пример:
//      ОформлениеСтроки.Ячейки.Значение.УстановитьТекст(aps_ФорматЧисловогоЗначенияПараметра(ДанныеСтроки.Значение, ДанныеСтроки.Свойство.ТипЗначения));
//
Функция aps_ФорматЧисловогоЗначенияПараметра(Значение, ОписаниеТиповСвойства) Экспорт 
	Если ОписаниеТиповСвойства=Неопределено Тогда 
		Возврат Строка(Значение);
	КонецЕсли;
	
	Разрядность=ОписаниеТиповСвойства.КвалификаторыЧисла.Разрядность;
	РазрядностьДробнойЧасти=ОписаниеТиповСвойства.КвалификаторыЧисла.РазрядностьДробнойЧасти;
	ФорматнаяСтрока="ЧЦ="+Строка(Разрядность)+"; ЧДЦ="+Строка(РазрядностьДробнойЧасти);
	Возврат Формат(Значение, ФорматнаяСтрока);
КонецФункции

// Преобразует строковое значение к типу параметра
// Параметры:
//		СтроковоеЗначение - строка
//		ТипЗначения - ОписаниеТипов
// Возвращаемое значение:
//      Произвольное значение
// Пример:
//      СтрокаТаблицы.Значение = aps_ПреобразоватьЗначениеПараметра(ЗначениеПараметра, Свойство.ТипЗначения);
//
Функция aps_ПреобразоватьЗначениеПараметра( СтроковоеЗначение, ТипЗначения ) Экспорт 
	Если ЗначениеЗаполнено(СтроковоеЗначение) Тогда 
		ЗначениеПараметра = ТипЗначения.ПривестиЗначение(СтроковоеЗначение);
		Если ЗначениеЗаполнено(ЗначениеПараметра) Тогда 
			Возврат ЗначениеПараметра;
		ИначеЕсли Справочники.ТипВсеСсылки().СодержитТип(ТипЗначения.Типы()[0]) Тогда 
			// привести значение не удалось, ищем в справочнике по наименованию
			МетаТип = Метаданные.НайтиПоТипу(ТипЗначения.Типы()[0]);
			ЗначениеПараметра = Справочники[МетаТип.Имя].НайтиПоНаименованию(Строка(СтроковоеЗначение));
			Если НЕ ЗначениеПараметра.Пустая() Тогда 
				Возврат ЗначениеПараметра;
			КонецЕсли;
		ИначеЕсли Перечисления.ТипВсеСсылки().СодержитТип(ТипЗначения.Типы()[0]) Тогда 
			// привести значение не удалось, ищем значение перечисления по синониму
			МетаТип = Метаданные.НайтиПоТипу(ТипЗначения.Типы()[0]);
			ПеречислениеМенеджер = Перечисления[МетаТип.Имя];
			Для Каждого ПеречислениеСсылка Из ПеречислениеМенеджер Цикл 
				Если ВРег(СокрЛП(Строка(ПеречислениеСсылка))) = ВРег(СокрЛП(Строка(СтроковоеЗначение))) Тогда 
					Возврат ПеречислениеСсылка;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	Возврат ТипЗначения.ПривестиЗначение();
КонецФункции

// Функция возвращает xml правила конкретизации типового технологического процесса
// Параметры:
//		Изделие - СправочникСсылка.aps_ЭлементыИзделия
// Возвращаемое значение:
//		СправочникСсылка.aps_ПравилаУправления
// Пример:
//		ПравилоУправления=aps_СоздатьПравилоТТП(ИзделиеТТП);
//
Функция aps_СоздатьПравилоТТП( Изделие ) Экспорт 
	ПравилоТТП=Справочники.aps_ПравилаУправления.СоздатьЭлемент();
	ПравилоТТП.Наименование=Строка(Изделие);
	// условие на параметр "Изделие"
	Условие=ПравилоТТП.Условия.Добавить();
	Условие.Свойство					=ПланыВидовХарактеристик.aps_Свойства.Изделие;
	Условие.Значение					=Изделие;
	Условие.ВидСравнения				=Перечисления.aps_ВидыСравнения.Равно;
	Условие.ОбязательноНаличиеПараметра	=Истина;		
	// условие на параметр "Способ создания"
	Условие=ПравилоТТП.Условия.Добавить();
	Условие.Свойство					=ПланыВидовХарактеристик.aps_Свойства.СпособСозданияРевизии;
	Условие.Значение					=Справочники.aps_СпособыСозданияРевизий.Представление;
	Условие.ВидСравнения				=Перечисления.aps_ВидыСравнения.Равно;
	Условие.ОбязательноНаличиеПараметра	=Истина;
	
	Возврат ПравилоТТП;
КонецФункции


// Функция возвращает массив извещений об изменении для данного списка элементов
// (упорядочены по дате)
// 
// Параметры:
//		itemArray - массив элементов
//		ТолькоПроведенные - булево (необязательный)
// Возвращаемое значение:
//		Массив
// Пример:
//		МассивСсылок = aps_ПолучитьИИ(ДокументСсылка, Истина);
//
Функция aps_ПолучитьИИ( Знач itemArray, ТолькоПроведенные = Ложь ) Экспорт 
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ИзмененныеЭлементы.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.aps_ИзвещениеОбИзменении.ИзмененныеЭлементы КАК ИзмененныеЭлементы
	               |ГДЕ
	               |	ИзмененныеЭлементы.ЭлементСсылка В(&ЭлементСсылка)";
	Если ТолькоПроведенные Тогда 
		Запрос.Текст = Запрос.Текст + "
	               |	И ИзмененныеЭлементы.Ссылка.Проведен";
	КонецЕсли;
	Запрос.Текст = Запрос.Текст + "
	               |УПОРЯДОЧИТЬ ПО
	               |	ИзмененныеЭлементы.Ссылка.Дата";
	Запрос.УстановитьПараметр("ЭлементСсылка", itemArray);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
КонецФункции

// Функция возвращает ссылку на извещение об изменении для данного БП изменения состояний
// Параметры:
//		БПСсылка - БизнесПроцессСсылка.aps_ИзменениеСостояния
// Возвращаемое значение:
