// Пример:
//		Извещение = aps_ПолучитьИИПоСсылкеНаБПИзмененияСостояний(Ссылка);
//
Функция aps_ПолучитьИИПоСсылкеНаБПИзмененияСостояний( БПСсылка ) Экспорт 
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ
	               |	aps_ИзвещениеОбИзменении.Ссылка
	               |ИЗ
	               |	Документ.aps_ИзвещениеОбИзменении КАК aps_ИзвещениеОбИзменении
	               |ГДЕ
	               |	aps_ИзвещениеОбИзменении.БПИзменениеСостояния = &БПИзменениеСостояния
