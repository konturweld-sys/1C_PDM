// Функция формирует таблицу событий из справочника
// 
// Параметры
//		ТипСобытия - ПеречислениеСсылка.aps_ТипыСобытий (необязательный)
//		ИмяСобытия - строка (необязательный)
// Возвращаемое значение:
//		ТаблицаЗначений 
// Пример:
//      тзСобытия = aps_ПолучитьСобытия();
//
Функция aps_ПолучитьСобытия( ТипСобытия = Неопределено, ИмяСобытия = "" ) Экспорт 
	ТекстЗапроса= "ВЫБРАТЬ
				  |	aps_События.Ссылка КАК ЭлементСобытия,
				  |	aps_События.Наименование КАК ИмяСобытия,
				  |	aps_События.ТипСобытия КАК ТипСобытия,
				  |	aps_События.КодСобытия КАК КодСобытия,
				  |	aps_События.ВызватьИсключение КАК ВызватьИсключение,
				  |	aps_События.РассылкаВключена КАК РассылкаВключена,
				  |	aps_События.КаскадныеСобытия.(
				  |		Событие КАК ЭлементСобытия,
				  |		Событие.КодСобытия КАК КодСобытия,
				  |		Событие.ВызватьИсключение КАК ВызватьИсключение
				  |	)
				  |ИЗ
				  |	Справочник.aps_События КАК aps_События
				  |ГДЕ
				  |	НЕ aps_События.ПометкаУдаления";
	Если ТипСобытия<>Неопределено Тогда 
		ТекстЗапроса=ТекстЗапроса+"
				  |	И aps_События.ТипСобытия = &ТипСобытия";
	КонецЕсли;
	Если СтрДлина(ИмяСобытия)<>0 Тогда
		ТекстЗапроса=ТекстЗапроса+"
				  |	И aps_События.Наименование=&ИмяСобытия";
	КонецЕсли;
	ТекстЗапроса=ТекстЗапроса+"
				  |УПОРЯДОЧИТЬ ПО
				  |	aps_События.Предопределенный УБЫВ";
	
	Запрос=Новый Запрос(ТекстЗапроса);
	Если ТипСобытия<>Неопределено Тогда 
		Запрос.УстановитьПараметр("ТипСобытия", ТипСобытия);
	КонецЕсли;
	Если СтрДлина(ИмяСобытия)<>0 Тогда
		Запрос.УстановитьПараметр("ИмяСобытия", ИмяСобытия);
	КонецЕсли;
	Запрос.УстановитьПараметр("ТипСобытия", ТипСобытия);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

// Функция получает подчиненные виды для данного вида элемента состава изделия
// Параметры:
//		ВидЭлемента - СправочникСсылка.aps_ВидыЭлементов
// Возвращаемое значение:
//		Массив - массив видов
// Пример:
//		ПодчВиды = aps_ПолучитьПодчиненныеВиды(СтрокаРодитель.ВидЭлемента);
//
Функция aps_ПолучитьПодчиненныеВиды( ВидЭлемента ) Экспорт 
	// Получить массив возможных для подчинения видов
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ПотомкиЭлемента.ЭлементИзСпр КАК ВидЭлемента
	                      |ИЗ
	                      |	Справочник.aps_ПодчинениеЭлементов.ПотомкиЭлемента КАК ПотомкиЭлемента
	                      |ГДЕ
	                      |	ПотомкиЭлемента.Ссылка.ЭлементИзСпр = &ВидЦелевогоЭлемента
	                      |	И НЕ ПотомкиЭлемента.Ссылка.ПометкаУдаления");
	Запрос.УстановитьПараметр("ВидЦелевогоЭлемента", ВидЭлемента);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ВидЭлемента");
КонецФункции

// Функция получает раздел спецификации по виду элемента
// Параметры:
//		ВидЭлемента - СправочникСсылка.aps_ВидыЭлементов
// Возвращаемое значение:
//		СправочникСсылка.aps_ЭлементыИзделия - ссылка на элемент вида "Оформление"
// Пример:
//		СтрокаСпецификации.Раздел = aps_ПолучитьРазделСпецификации(itemXDTO.elementType);
//
Функция aps_ПолучитьРазделСпецификации( ВидЭлемента ) Экспорт 
	Если ВидЭлемента = Справочники.aps_ВидыЭлементов.Деталь Тогда
		Раздел = Справочники.aps_ЭлементыИзделия.Детали;
	ИначеЕсли ВидЭлемента = Справочники.aps_ВидыЭлементов.Документ
				ИЛИ ВидЭлемента = Справочники.aps_ВидыЭлементов.АктивныйДокументЧертежSolidWorks
				ИЛИ ВидЭлемента = Справочники.aps_ВидыЭлементов.АктивныйДокументДетальSolidWorks
				ИЛИ ВидЭлемента = Справочники.aps_ВидыЭлементов.АктивныйДокументСборкаSolidWorks 
				ИЛИ ВидЭлемента = Справочники.aps_ВидыЭлементов.АктивныйДокументЧертежКОМПАС
				ИЛИ ВидЭлемента = Справочники.aps_ВидыЭлементов.АктивныйДокументДетальКОМПАС
				ИЛИ ВидЭлемента = Справочники.aps_ВидыЭлементов.АктивныйДокументСборкаКОМПАС
				ИЛИ ВидЭлемента = Справочники.aps_ВидыЭлементов.АктивныйДокументЧертежAutoCAD
				ИЛИ ВидЭлемента = Справочники.aps_ВидыЭлементов.АктивныйДокументДетальAutoCAD
				ИЛИ ВидЭлемента = Справочники.aps_ВидыЭлементов.АктивныйДокументСборкаAutoCAD
				ИЛИ ВидЭлемента = Справочники.aps_ВидыЭлементов.АктивныйДокументЧертежInventor
				ИЛИ ВидЭлемента = Справочники.aps_ВидыЭлементов.АктивныйДокументДетальInventor
				ИЛИ ВидЭлемента = Справочники.aps_ВидыЭлементов.АктивныйДокументСборкаInventor
				ИЛИ ВидЭлемента = Справочники.aps_ВидыЭлементов.АктивныйДокументЧертежSolidEdge
				ИЛИ ВидЭлемента = Справочники.aps_ВидыЭлементов.АктивныйДокументДетальSolidEdge
				ИЛИ ВидЭлемента = Справочники.aps_ВидыЭлементов.АктивныйДокументСборкаSolidEdge Тогда
				
		Раздел = Справочники.aps_ЭлементыИзделия.Документация;
	ИначеЕсли ВидЭлемента = Справочники.aps_ВидыЭлементов.Комплекс Тогда
		Раздел = Справочники.aps_ЭлементыИзделия.Комплексы;
	ИначеЕсли ВидЭлемента = Справочники.aps_ВидыЭлементов.Комплект Тогда
		Раздел = Справочники.aps_ЭлементыИзделия.Комплекты;
	ИначеЕсли ВидЭлемента = Справочники.aps_ВидыЭлементов.Материал Тогда
		Раздел = Справочники.aps_ЭлементыИзделия.Материалы;
	ИначеЕсли ВидЭлемента = Справочники.aps_ВидыЭлементов.ПрИзд
				ИЛИ ВидЭлемента = Справочники.aps_ВидыЭлементов.ЭлектроРадиоЭлемент Тогда
		Раздел = Справочники.aps_ЭлементыИзделия.ПрочиеИзделия;
	ИначеЕсли ВидЭлемента = Справочники.aps_ВидыЭлементов.СбЕдиница Тогда
		Раздел = Справочники.aps_ЭлементыИзделия.СборочныеЕдиницы;
	ИначеЕсли ВидЭлемента = Справочники.aps_ВидыЭлементов.СтИзд Тогда
		Раздел = Справочники.aps_ЭлементыИзделия.СтандартныеИзделия;
	Иначе
		Раздел = Справочники.aps_ЭлементыИзделия.Прочее;
	КонецЕсли;
	Возврат Раздел;
КонецФункции

// Функция возвращает число для упорядочивания частей спецификации
// Параметры:
//		Часть - СправочникСсылка.aps_ЭлементыИзделия
// Возвращаемое значение:
//		Число
// Пример:
//		СтрокаСпецификации.ПорядокЧасти = aps_ПолучитьПорядокЧасти(СтрокаСпецификации.Часть);
//
Функция aps_ПолучитьПорядокЧасти( Часть ) Экспорт 
	Если НЕ ЗначениеЗаполнено(Часть) Тогда 
		Возврат 0;
	ИначеЕсли Часть = Справочники.aps_ЭлементыИзделия.ДорабатываемоеИзделие Тогда 
		Возврат 1;
	ИначеЕсли Часть = Справочники.aps_ЭлементыИзделия.СнятыеСоставныеЧасти Тогда 
		Возврат 2;
	ИначеЕсли Часть = Справочники.aps_ЭлементыИзделия.ВновьУстанавливаемыеСоставныеЧасти Тогда 
		Возврат 3;
	ИначеЕсли Часть = Справочники.aps_ЭлементыИзделия.УстанавливаютПо Тогда 
		Возврат 4;
	ИначеЕсли Часть = Справочники.aps_ЭлементыИзделия.УстанавливаютПриЭлектромонтаже Тогда 
		Возврат 5;
	Иначе 
		Возврат 6;
	КонецЕсли;
КонецФункции

// Функция возвращает число для упорядочивания разделов спецификации
// Параметры:
//		Раздел - СправочникСсылка.aps_ЭлементыИзделия
// Возвращаемое значение:
//		Число
// Пример:
//		СтрокаСпецификации.ПорядокРаздела = aps_ПолучитьПорядокРаздела(СтрокаСпецификации.Раздел);
//
Функция aps_ПолучитьПорядокРаздела( Раздел ) Экспорт 
	Если НЕ ЗначениеЗаполнено(Раздел) Тогда 
		Возврат 0;
	ИначеЕсли Раздел = Справочники.aps_ЭлементыИзделия.Документация Тогда 
		Возврат 1;
	ИначеЕсли Раздел = Справочники.aps_ЭлементыИзделия.Комплексы Тогда 
		Возврат 2;
	ИначеЕсли Раздел = Справочники.aps_ЭлементыИзделия.СборочныеЕдиницы Тогда 
		Возврат 3;
	ИначеЕсли Раздел = Справочники.aps_ЭлементыИзделия.Детали Тогда 
		Возврат 4;
	ИначеЕсли Раздел = Справочники.aps_ЭлементыИзделия.СтандартныеИзделия Тогда 
		Возврат 5;
	ИначеЕсли Раздел = Справочники.aps_ЭлементыИзделия.ПрочиеИзделия Тогда 
		Возврат 6;
	ИначеЕсли Раздел = Справочники.aps_ЭлементыИзделия.Материалы Тогда 
		Возврат 7;
	ИначеЕсли Раздел = Справочники.aps_ЭлементыИзделия.Комплекты Тогда 
		Возврат 8;
	Иначе 
		Возврат 9;
	КонецЕсли;
КонецФункции

// Функция получает пользовательские разделы спецификации с группировкой по наименованию
// Параметры:
//		Свойство - ПланВидовХарактеристикСсылка.aps_Свойства (необязательный)
// Возвращаемое значение:
//		Массив
// Пример:
//		МассивОформлений=aps_ПолучитьЭлементыОформления(Свойство);
//
Функция aps_ПолучитьЭлементыОформления( Свойство = Неопределено ) Экспорт 
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ЭлементыСвязейПараметры.Параметр.Значение
	               |ИЗ
	               |	Справочник.aps_ЭлементыСвязей.Параметры КАК ЭлементыСвязейПараметры
	               |ГДЕ
	               |	НЕ ЭлементыСвязейПараметры.Ссылка.ПометкаУдаления
	               |	И (ЭлементыСвязейПараметры.Параметр.Значение ССЫЛКА Справочник.aps_ЭлементыИзделия
	               |			ИЛИ ЭлементыСвязейПараметры.Параметр.Значение ССЫЛКА Справочник.aps_ЭлементыСправочников
	               |			ИЛИ ЭлементыСвязейПараметры.Параметр.Значение ССЫЛКА Справочник.aps_ЭлементыТехнологии)
	               |	И ЭлементыСвязейПараметры.Параметр.Значение.ВидЭлемента = &ВидЭлемента
	               |	И НЕ ЭлементыСвязейПараметры.Параметр.Значение.Предопределенный";
	Если Свойство <> Неопределено Тогда 
		Запрос.Текст = Запрос.Текст + "
	               |	И ЭлементыСвязейПараметры.Параметр.Свойство = &Свойство";
		Запрос.УстановитьПараметр("Свойство", Свойство);
	КонецЕсли;
	Запрос.УстановитьПараметр("ВидЭлемента", Справочники.aps_ВидыЭлементов.Оформление);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку(0);
КонецФункции

// Функция получает массив видов документов, соответствующий данному виду элемента
// Параметры:
//		ВидЭлемента - СправочникСсылка.aps_ВидыЭлементов
// Возвращаемое значение:
//		Массив значений типа СправочникСсылка.aps_ЭлементыИзделия
// Пример:
//		СписокВидовДокументов.ЗагрузитьЗначения(aps_ПолучитьПринадлежностьДокументов(parentXDTO.elementType));
//
Функция aps_ПолучитьПринадлежностьДокументов( ВидЭлемента ) Экспорт 
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	aps_ВидыДокументовПринадлежностьДокументов.Ссылка КАК ВидДокумента
	                      |ИЗ
	                      |	Справочник.aps_ВидыДокументов.ПринадлежностьДокументов КАК aps_ВидыДокументовПринадлежностьДокументов
	                      |ГДЕ
	                      |	aps_ВидыДокументовПринадлежностьДокументов.ВидРодительскогоЭлемента = &ВидРодительскогоЭлемента
	                      |	И (НЕ aps_ВидыДокументовПринадлежностьДокументов.Ссылка.ПометкаУдаления)
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	aps_ВидыДокументовПринадлежностьДокументов.Ссылка.Наименование");
	Запрос.УстановитьПараметр("ВидРодительскогоЭлемента", ВидЭлемента);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку(0);
КонецФункции

// Функция получает шаблоны технологических связей, все или для данного вида(-ов) элемента
// Параметры:
//		ВидЭлемента1 - СправочникСсылка.aps_ВидыЭлементов (необязательный)
//		ВидЭлемента2 - СправочникСсылка.aps_ВидыЭлементов (необязательный)
//		ГоризонтальнаяСвязь - Булево (необязательный)
// Возвращаемое значение:
//		Массив
// Пример:
//		ШаблоныСвязей = aps_ПолучитьШаблоныТехнологическихСвязей(parentXDTO.elementType,, Истина);
//
Функция aps_ПолучитьШаблоныТехнологическихСвязей( ВидЭлемента1 = Неопределено, ВидЭлемента2 = Неопределено, ГоризонтальнаяСвязь = Неопределено ) Экспорт 
	
		Запрос = Новый Запрос();
		Запрос.Текст = "ВЫБРАТЬ
		               |	ШаблоныТехнологическихСвязей.Ссылка
		               |ИЗ
		               |	Справочник.aps_ШаблоныТехнологическихСвязей КАК ШаблоныТехнологическихСвязей
		               |ГДЕ
		               |	(НЕ ШаблоныТехнологическихСвязей.ПометкаУдаления)";
		Если ГоризонтальнаяСвязь = Истина Тогда 
			Запрос.Текст = Запрос.Текст + "
					   |	И ШаблоныТехнологическихСвязей.ГоризонтальнаяСвязь = ИСТИНА";
		ИначеЕсли ГоризонтальнаяСвязь = Ложь Тогда 
			Запрос.Текст = Запрос.Текст + "
					   |	И ШаблоныТехнологическихСвязей.ГоризонтальнаяСвязь = ЛОЖЬ";
		КонецЕсли;
					
		Если ВидЭлемента1 <> Неопределено Тогда 
			Запрос.Текст = Запрос.Текст + "
					   |	И ШаблоныТехнологическихСвязей.ВидыЭлементов.ВидЭлемента = &ВидЭлемента1";
			Запрос.УстановитьПараметр("ВидЭлемента1", ВидЭлемента1);
		КонецЕсли;
		Если ВидЭлемента2 <> Неопределено Тогда 
			Запрос.Текст = Запрос.Текст + "
					   |	И ШаблоныТехнологическихСвязей.ПодчиненныеВидыЭлементов.ВидЭлемента = &ВидЭлемента2";
			Запрос.УстановитьПараметр("ВидЭлемента2", ВидЭлемента2);
		КонецЕсли;
		
		Выгрузка = Запрос.Выполнить().Выгрузить();
		
		Возврат Выгрузка.ВыгрузитьКолонку(0);
		
КонецФункции
	
// Функция возвращает последний порядок вывода элементной связи для данного родителя
//
// Параметры:
//		ЭлементРодитель - ссылка на родителя
// Возвращаемое значение:
//      Число
// Пример:
//      Источник.ПорядокВывода = aps_ПолучитьПоследнийПорядокВывода( Источник.РодительСсылка );
//
Функция aps_ПолучитьПоследнийПорядокВывода( ЭлементРодитель ) Экспорт 
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	МАКСИМУМ(aps_ЭлементыСвязей.ПорядокВывода) КАК ПорядокВывода
	                      |ИЗ
	                      |	Справочник.aps_ЭлементыСвязей КАК aps_ЭлементыСвязей
	                      |ГДЕ
	                      |	aps_ЭлементыСвязей.РодительСсылка = &ПарамРодитель
	                      |	И (НЕ aps_ЭлементыСвязей.ПометкаУдаления)");
	Запрос.УстановитьПараметр("ПарамРодитель", ЭлементРодитель);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		ПорядокВывода = ?(Выборка.ПорядокВывода = NULL, 0, Выборка.ПорядокВывода);
	Иначе 
		ПорядокВывода = 0;
	КонецЕсли;
	Возврат ПорядокВывода + 1;
КонецФункции

// Функция проверяет наличие вертикальной связи между переданными элементами
//
// Параметры:
//		РодительСсылка - ссылка на родителя
//		ПотомокСсылка - ссылка на потомка
//		ВидСвязи - ПеречислениеСсылка.aps_ВидыСвязей (необязательный)
// Возвращаемое значение:
//		Булево
// Пример:
//		СвязьУникальна = aps_ВертикальнаяСвязьУникальна(parentItem, МассивПеретаскивания[i].element, Перечисления.aps_ВидыСвязей.Личное);
//
Функция aps_ВертикальнаяСвязьУникальна( РодительСсылка, ПотомокСсылка, ВидСвязи = Неопределено ) Экспорт 
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ
	               |	aps_ВертикальныеСвязи.Ссылка
	               |ИЗ
	               |	Справочник.aps_ВертикальныеСвязи КАК aps_ВертикальныеСвязи
	               |ГДЕ
	               |	aps_ВертикальныеСвязи.РодительСсылка = &ПарамРодитель
	               |	И aps_ВертикальныеСвязи.ПотомокСсылка = &ПарамПотомок
	               |	И (НЕ aps_ВертикальныеСвязи.ПометкаУдаления)";
	Запрос.УстановитьПараметр("ПарамРодитель", РодительСсылка);
	Запрос.УстановитьПараметр("ПарамПотомок", ПотомокСсылка);
	Если ВидСвязи <> Неопределено Тогда 
		Запрос.Текст = Запрос.Текст + " И ВидСвязи = &ПарамВидСвязи";
		Запрос.УстановитьПараметр("ПарамВидСвязи", ВидСвязи);
	КонецЕсли;
	Возврат Запрос.Выполнить().Пустой();
КонецФункции


// Функция помещает XDTO-модель в хранилище моделей
// Параметры:
//		itemXDTO - ОбъектXDTO
//		ВидХранилищаМодели - ПеречислениеСсылка.aps_ВидыСериализованныхМоделей
//		СуществующееХранилище - СправочникСсылка.aps_ХранилищеМоделейXDTO; Неопределено (необязательный)
// Возвращаемое значение:
//		СправочникСсылка.aps_ХранилищеМоделейXDTO
// Пример:
//	    aps_ПоместитьМодельВХранилище(itemXDTO, Перечисления.aps_ВидыСериализованныхМоделей.МодельРабочегоСтола);
//
Функция aps_ПоместитьМодельВХранилище( itemXDTO, ВидХранилищаМодели, СуществующееХранилище = Неопределено ) Экспорт 
	Попытка
		Если СуществующееХранилище <> Неопределено Тогда 
			НовыйОбъектХранилища=СуществующееХранилище.ПолучитьОбъект();
		Иначе 
			НовыйОбъектХранилища=Справочники.aps_ХранилищеМоделейXDTO.СоздатьЭлемент();
		КонецЕсли;
		
		НовыйОбъектХранилища.Дата			= ТекущаяДата();
		НовыйОбъектХранилища.Наименование	= itemXDTO.description;
		НовыйОбъектХранилища.Пользователь	= ПараметрыСеанса.ТекущийПользователь;
		НовыйОбъектХранилища.ВидМодели		= ВидХранилищаМодели;
		НовыйОбъектХранилища.ОбъектXDTO		= XDTO2Строка(itemXDTO);
		НовыйОбъектХранилища.Записать();
		
		Возврат НовыйОбъектХранилища.Ссылка;
	Исключение
		ВызватьИсключение НСтр("ru = 'Ошибка при помещении XDTO-модели в хранилище:'; en_US = 'While putting XDTO model to storage an error occurred:'")+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
КонецФункции

// Функция помещает XDTO-модель в хранилище моделей
// Параметры:
//		itemArray - массив ссылок или объектов XDTO
// Возвращаемое значение:
//		Истина
// Пример:
//      aps_ОтправитьНаРабочийСтол( ТекущаяСтрокаДереваПредставления.ОбъектXDTO );
//
Функция aps_ОтправитьНаРабочийСтол( Знач itemArray ) Экспорт 
	Если ТипЗнч(itemArray) <> Тип("Массив") Тогда 
		item = itemArray;
		itemArray = Новый Массив;
		itemArray.Добавить(item);
	КонецЕсли;
	
	Для i=0 По itemArray.Количество()-1 Цикл 
		Если ТипЗнч(itemArray[i]) = Тип("СправочникСсылка.aps_ЭлементыИзделия") Или 
				ТипЗнч(itemArray[i]) = Тип("СправочникСсылка.aps_ЭлементыСправочников") Или 
					ТипЗнч(itemArray[i]) = Тип("СправочникСсылка.aps_ЭлементыТехнологии") Тогда 
			itemXDTO = aps_СоздатьОбъектМоделиXDTO(itemArray[i]);
		Иначе // объект XDTO-модели
			itemXDTO = itemArray[i];
		КонецЕсли;
		
		Попытка
			aps_ПоместитьМодельВХранилище(itemXDTO, Перечисления.aps_ВидыСериализованныхМоделей.МодельРабочегоСтола);
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	Возврат Истина;
КонецФункции


// Процедура помещает XDTO-модель(и) в буфер копирования
// Параметры:
//		itemArray - массив ссылок или объектов XDTO
// Пример:
//		aps_ПоместитьВБуферКопирования( ТекущаяСтрокаДереваПредставления.ОбъектXDTO );
//
Процедура aps_ПоместитьВБуферКопирования( Знач itemArray ) Экспорт 
	Если ТипЗнч(itemArray) <> Тип("Массив") Тогда 
		item = itemArray;
		itemArray = Новый Массив;
		itemArray.Добавить(item);
	КонецЕсли;
	
	Для i=0 По itemArray.Количество()-1 Цикл 
		Если ТипЗнч(itemArray[i]) = Тип("СправочникСсылка.aps_ЭлементыИзделия") Или 
				ТипЗнч(itemArray[i]) = Тип("СправочникСсылка.aps_ЭлементыСправочников") Или 
					ТипЗнч(itemArray[i]) = Тип("СправочникСсылка.aps_ЭлементыТехнологии") Тогда 
			itemArray[i] = XDTO2Строка( aps_СоздатьОбъектМоделиXDTO(itemArray[i]) );
		Иначе // объект XDTO-модели
			itemArray[i] = XDTO2Строка(itemArray[i]);
		КонецЕсли;
	КонецЦикла;
	ПараметрыСеанса.aps_БуферКопирования=Новый ФиксированныйМассив( itemArray );	
КонецПроцедуры

// Функция получает XDTO-модель(и) из буфера копирования
// Параметры:
//		Нет
// Возвращаемое значение:
//      Массив
// Пример:
//		ЗначениеПеретаскивания = aps_ПолучитьИзБуфераКопирования();
//
Функция aps_ПолучитьИзБуфераКопирования( ) Экспорт 
    МассивXDTO=Новый Массив();
	Для i=0 По ПараметрыСеанса.aps_БуферКопирования.Количество()-1 Цикл 
		МассивXDTO.Добавить( Строка2XDTO( ПараметрыСеанса.aps_БуферКопирования[i] ) );
	КонецЦикла;
	Возврат МассивXDTO;		
КонецФункции


// Функция получает дерево параметров элемента (связи)
// Параметры:
//		item - ссылка на элемент или связь
// Возвращаемое значение:
//		ДеревоЗначений
// Пример:
//      ДеревоПараметров=aps_ПолучитьДеревоПараметров(ЭлементСсылка);
//
Функция aps_ПолучитьДеревоПараметров( item ) Экспорт 
	ТекстЗапроса = "ВЫБРАТЬ
	               |	Параметры.НомерСтроки КАК НомерСтроки,
	               |	Параметры.Параметр.Наименование КАК Имя,
	               |	Параметры.Параметр.Свойство КАК Свойство,
	               |	Параметры.Параметр.Значение КАК Значение,
	               |	Параметры.Параметр КАК Ссылка,
	               |	Параметры.Параметр.ЭтоГруппа КАК ЭтоГруппа,
	               |	Параметры.Параметр.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	               |	Параметры.ЭтоПараметрСвязи КАК ЭтоПараметрСвязи,
	               |	ВЫБОР
	               |		КОГДА Параметры.Параметр.ЭтоГруппа
	               |			ТОГДА 1
	               |		КОГДА Параметры.ЭтоПараметрСвязи
	               |			ТОГДА 2
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК Картинка
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		aps_ЭлементыИзделияПараметры.НомерСтроки КАК НомерСтроки,
	               |		aps_ЭлементыИзделияПараметры.Параметр КАК Параметр,
	               |		&ЭтоПараметрСвязи КАК ЭтоПараметрСвязи
	               |	ИЗ
	               |		Справочник.aps_ЭлементыИзделия.Параметры КАК aps_ЭлементыИзделияПараметры
	               |	ГДЕ
	               |		aps_ЭлементыИзделияПараметры.Ссылка = &СсылкаНаЭлемент
	               |	
	               |	ОБЪЕДИНИТЬ
	               |	
	               |	ВЫБРАТЬ
	               |		МИНИМУМ(aps_ЭлементыИзделияПараметры.НомерСтроки),
	               |		aps_ЭлементыИзделияПараметры.Параметр.Родитель,
	               |		&ЭтоПараметрСвязи
	               |	ИЗ
	               |		Справочник.aps_ЭлементыИзделия.Параметры КАК aps_ЭлементыИзделияПараметры
	               |	ГДЕ
	               |		aps_ЭлементыИзделияПараметры.Ссылка = &СсылкаНаЭлемент
	               |		И aps_ЭлементыИзделияПараметры.Параметр.Родитель <> ЗНАЧЕНИЕ(Справочник.aps_ПараметрыЭлементовИзделия.ПустаяСсылка)
	               |		И aps_ЭлементыИзделияПараметры.Параметр.Родитель <> ЗНАЧЕНИЕ(Справочник.aps_ПараметрыЭлементовТехнологии.ПустаяСсылка)
	               |	
	               |	СГРУППИРОВАТЬ ПО
	               |		aps_ЭлементыИзделияПараметры.Параметр.Родитель) КАК Параметры
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЭтоПараметрСвязи,
	               |	ЭтоГруппа ИЕРАРХИЯ,
	               |	НомерСтроки";
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "aps_ЭлементыИзделия", item.Метаданные().Имя);
	ЗапросПараметров = Новый Запрос;
	ЗапросПараметров.Текст = ТекстЗапроса;
	ЗапросПараметров.УстановитьПараметр("СсылкаНаЭлемент"	, item);
	ЗапросПараметров.УстановитьПараметр("ЭтоПараметрСвязи"	, ТипЗнч(item)=Тип("СправочникСсылка.aps_ЭлементыСвязей"));
	Возврат ЗапросПараметров.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
КонецФункции

// Функция получает дерево параметров элементов ресурса
// Параметры:
//		item - ссылка на элемент или связь
// Возвращаемое значение:
//		ДеревоЗначений
// Пример:
//      ДеревоПараметров = aps_ПолучитьДеревоПараметровЭлементовРесурса(itemXDTO.element);
//
Функция aps_ПолучитьДеревоПараметровЭлементовРесурса( itemResource ) Экспорт 
	ЭлементСсылка = itemResource;
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	Параметры.НомерСтроки КАК НомерСтроки,
	               |	Параметры.Параметр.Наименование КАК Имя,
	               |	Параметры.Параметр.Свойство КАК Свойство,
	               |	Параметры.Параметр.Значение КАК Значение,
	               |	Параметры.Параметр КАК Ссылка,
	               |	Параметры.Параметр.ЭтоГруппа КАК ЭтоГруппа,
	               |	Параметры.Параметр.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	               |	ВЫБОР
	               |		КОГДА Параметры.Параметр.ЭтоГруппа
	               |			ТОГДА 1
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК Картинка,
	               |	Параметры.Общедоступный КАК Общедоступный
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		aps_ЭлементыСправочниковПараметры.НомерСтроки КАК НомерСтроки,
	               |		aps_ЭлементыСправочниковПараметры.Параметр КАК Параметр,
	               |		aps_ЭлементыСправочниковПараметры.Общедоступный КАК Общедоступный
	               |	ИЗ
	               |		Справочник.aps_ЭлементыСправочников.ПараметрыЭлементовРесурса КАК aps_ЭлементыСправочниковПараметры
	               |	ГДЕ
	               |		aps_ЭлементыСправочниковПараметры.Ссылка = &СсылкаНаЭлемент
	               |	
	               |	ОБЪЕДИНИТЬ
	               |	
	               |	ВЫБРАТЬ
	               |		МИНИМУМ(aps_ЭлементыСправочниковПараметры.НомерСтроки),
	               |		aps_ЭлементыСправочниковПараметры.Параметр.Родитель,
	               |		ЛОЖЬ
	               |	ИЗ
	               |		Справочник.aps_ЭлементыСправочников.ПараметрыЭлементовРесурса КАК aps_ЭлементыСправочниковПараметры
	               |	ГДЕ
	               |		aps_ЭлементыСправочниковПараметры.Ссылка = &СсылкаНаЭлемент
	               |		И aps_ЭлементыСправочниковПараметры.Параметр.Родитель <> ЗНАЧЕНИЕ(Справочник.aps_ПараметрыЭлементовИзделия.ПустаяСсылка)
	               |		И aps_ЭлементыСправочниковПараметры.Параметр.Родитель <> ЗНАЧЕНИЕ(Справочник.aps_ПараметрыЭлементовТехнологии.ПустаяСсылка)
	               |	
	               |	СГРУППИРОВАТЬ ПО
	               |		aps_ЭлементыСправочниковПараметры.Параметр.Родитель) КАК Параметры
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЭтоГруппа ИЕРАРХИЯ,
	               |	НомерСтроки";
	ЗапросПараметров = Новый Запрос;
	ЗапросПараметров.Текст = ТекстЗапроса;
	ЗапросПараметров.УстановитьПараметр("СсылкаНаЭлемент"	, ЭлементСсылка);
	Возврат ЗапросПараметров.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
КонецФункции

// Функция получает дерево параметров элементов ресурса
// Параметры:
//		Свойство		- ПланВидовХарактеристикСсылка.aps_Свойства
//		СтрокаШаблон	- Строка, шаблон строки для поиска
//		ВидЭлемента		- СправочникСсылка.aps_ВидыЭлементов, фильтр по виду элемента
// Возвращаемое значение:
//		Массив
// Пример:
//		МассивПодобныхЗначений = aps_ПолучитьПодобныеСтроковыеЗначенияПараметров(Свойство, Элемент.Значение+"%", ВидЭлемента);
//
Функция aps_ПолучитьПодобныеСтроковыеЗначенияПараметров( Свойство, СтрокаШаблон = "", ВидЭлемента = Неопределено ) Экспорт 
	Запрос=Новый Запрос();
	ТекстЗапроса = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ЗначенияПараметров.Значение
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		Параметры.Ссылка КАК Ссылка,
	               |		Параметры.Значение КАК Значение
	               |	ИЗ
	               |		Справочник.aps_ПараметрыЭлементовИзделия КАК Параметры
	               |	ГДЕ
	               |		Параметры.Свойство = &Свойство
	               |		И ВЫРАЗИТЬ(Параметры.Значение КАК СТРОКА) ПОДОБНО &Текст
	               |	
	               |	ОБЪЕДИНИТЬ ВСЕ
	               |	
	               |	ВЫБРАТЬ
	               |		Параметры.Ссылка,
	               |		Параметры.Значение
	               |	ИЗ
	               |		Справочник.aps_ПараметрыЭлементовТехнологии КАК Параметры
	               |	ГДЕ
	               |		Параметры.Свойство = &Свойство
	               |		И ВЫРАЗИТЬ(Параметры.Значение КАК СТРОКА) ПОДОБНО &Текст) КАК ЗначенияПараметров
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			Параметры.Параметр КАК Параметр
	               |		ИЗ
	               |			Справочник.aps_ЭлементыИзделия.Параметры КАК Параметры
	               |		ГДЕ
	               |			НЕ Параметры.Ссылка.ПометкаУдаления
	               |			И &УсловиеВидЭлемента
	               |		
	               |		ОБЪЕДИНИТЬ ВСЕ
	               |		
	               |		ВЫБРАТЬ
	               |			Параметры.Параметр
	               |		ИЗ
	               |			Справочник.aps_ЭлементыСправочников.Параметры КАК Параметры
	               |		ГДЕ
	               |			НЕ Параметры.Ссылка.ПометкаУдаления
	               |			И &УсловиеВидЭлемента
	               |		
	               |		ОБЪЕДИНИТЬ ВСЕ
	               |		
	               |		ВЫБРАТЬ
	               |			Параметры.Параметр
	               |		ИЗ
	               |			Справочник.aps_ЭлементыТехнологии.Параметры КАК Параметры
	               |		ГДЕ
	               |			НЕ Параметры.Ссылка.ПометкаУдаления
	               |			И &УсловиеВидЭлемента) КАК ПараметрыЭлементов
	               |		ПО ЗначенияПараметров.Ссылка = ПараметрыЭлементов.Параметр";
	Запрос.УстановитьПараметр("Свойство", Свойство);
	Запрос.УстановитьПараметр("Текст"	, СтрокаШаблон);
	Если ЗначениеЗаполнено(ВидЭлемента) Тогда 
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеВидЭлемента", "Ссылка.ВидЭлемента = &ВидЭлемента");
		Запрос.УстановитьПараметр("ВидЭлемента", ВидЭлемента);
	Иначе 
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеВидЭлемента", "ИСТИНА");
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
