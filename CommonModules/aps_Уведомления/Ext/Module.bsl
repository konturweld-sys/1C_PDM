// Процедура оповещает пользователя о наличии входящих уведомлений
// Параметры:
//		нет
// Пример:
//		aps_ПроверкаНовыхУведомлений();
//
Процедура aps_ПроверкаНовыхУведомлений() Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	aps_Уведомление.Ссылка КАК Ссылка,
	                      |	aps_Уведомление.Наименование КАК Тема,
	                      |	aps_Уведомление.Отправитель,
	                      |	aps_Уведомление.Дата КАК Дата
	                      |ИЗ
	                      |	Задача.aps_Уведомление КАК aps_Уведомление
	                      |ГДЕ
	                      |	(НЕ aps_Уведомление.ПометкаУдаления)
	                      |	И (НЕ aps_Уведомление.Выполнена)
	                      |	И (НЕ aps_Уведомление.КопияОтправителю)
	                      |	И aps_Уведомление.Получатель = &Получатель");
	Запрос.УстановитьПараметр("Получатель", ПараметрыСеанса.ТекущийПользователь);
	КоличествоУведомлений = Запрос.Выполнить().Выгрузить().Количество();
	
	Если КоличествоУведомлений > 0 Тогда
		СловоПослеЧисла = "";
		
		ОстатокОтДеленияНа100 = КоличествоУведомлений % 100;
		Если ОстатокОтДеленияНа100 >= 11 И ОстатокОтДеленияНа100 <= 19 Тогда 
			СловоПослеЧисла = НСтр("ru = 'входящих уведомлений'; en_US = 'inbox messages'");
		Иначе
			ОстатокОтДеленияНа10 = КоличествоУведомлений % 10;
			Если ОстатокОтДеленияНа10 = 1 Тогда
				Если КоличествоУведомлений = 1 Тогда
					СловоПослеЧисла = НСтр("ru = 'входящее уведомление'; en_US = 'inbox message'");
				Иначе
					СловоПослеЧисла = НСтр("ru = 'входящее уведомление'; en_US = 'inbox messages'");
				КонецЕсли;	
			ИначеЕсли ОстатокОтДеленияНа10 > 1 И ОстатокОтДеленияНа10 < 5 Тогда
				СловоПослеЧисла = НСтр("ru = 'входящих уведомления'; en_US = 'inbox messages'");
			Иначе
				СловоПослеЧисла = НСтр("ru = 'входящих уведомлений'; en_US = 'inbox messages'");
			КонецЕсли;
		КонецЕсли;
		
		ТекстСообщения=НСтр("ru = 'У Вас '; en_US = 'You have '")+Строка(КоличествоУведомлений)+" "+СловоПослеЧисла+"!";
		ПоказатьОповещениеПользователя(ТекстСообщения);

	КонецЕсли;
КонецПроцедуры

// Процедура открывает список входящих уведомлений пользователя
// Параметры:
//		нет
// Пример:
//		aps_ВходящиеУведомления();
//
Процедура aps_ВходящиеУведомления() Экспорт
	Форма = Обработки.aps_РабочийСтолПользователя.ПолучитьФорму();
	Если Форма.Открыта() Тогда
		Форма.ПерейтиКУведомлениям("aps_ВходящиеУведомления");
		Форма.Активизировать();
	Иначе
		Форма.КлючУникальности = "aps_ВходящиеУведомления";
		Форма.Открыть();
	КонецЕсли;
КонецПроцедуры

// Процедура открывает форму нового уведомления
// Параметры:
//		Получатель - СправочникСсылка.Пользователи (необязательный)
// Пример:
//		aps_ОткрытьФормуНовогоУведомления();
//
Процедура aps_ОткрытьФормуНовогоУведомления( Получатель = Неопределено ) Экспорт
	Уведомление = Задачи.aps_Уведомление.СоздатьЗадачу();
	Уведомление.Содержание = РегистрыСведений.aps_ПодписиУведомлений.aps_ПолучитьПодпись(ПараметрыСеанса.ТекущийПользователь);
	Уведомление.Получатель = Получатель;
	Уведомление.ПолучитьФорму().Открыть();
КонецПроцедуры

// Процедура открывает форму нового уведомления для ответа
//
// Параметры:
//		Письмо - ЗадачаСсылка.aps_Уведомление - входящее письмо, на которое отвечаем
//		Пересылка - булево - переслать уведомление (необязательный)
// Пример:
//      aps_Ответить(АктивноеУведомление, Истина);
//
Процедура aps_Ответить( Письмо, Пересылка = Ложь ) Экспорт
	Уведомление = Задачи.aps_Уведомление.СоздатьЗадачу();
	Если Пересылка Тогда // скопировать вложения
		Уведомление.Вложения.Загрузить( Письмо.Вложения.Выгрузить());
	ИначеЕсли ЗначениеЗаполнено(Письмо.Отправитель) Тогда
		Уведомление.Получатель = Письмо.Отправитель;
	КонецЕсли;
	
	Уведомление.Теги.Загрузить( Письмо.Теги.Выгрузить() );
	Уведомление.Наименование = "RE: " + Письмо.Наименование;
	Уведомление.Содержание = НСтр("ru = '<br><hr><br>От: '; en_US = '<br><hr><br>From: '")+ Письмо.Отправитель + НСтр("ru = '<br>Отправлено: '; en_US = '<br>Date: '")+ Письмо.Дата + НСтр("ru = '<br>Тема: '; en_US = '<br>Subject: '")+ Письмо.Наименование + "<hr><p>"+ Письмо.Содержание;
	
	ФормаУведомления = Уведомление.ПолучитьФорму();
	ФормаУведомления.ОтветНаПисьмо = Письмо.Ссылка;
	ФормаУведомления.Открыть();
КонецПроцедуры

// Процедура создает уведомление и добавляет элементы в вложение
// Параметры:
//		itemArray - массив элементов для верификации
// Пример:
//		aps_ПослатьНаВерификацию( ПолучитьВыделенныеОбъекты() );
//
Процедура aps_ПослатьНаВерификацию( Знач itemArray ) Экспорт
	Если ТипЗнч(itemArray) <> Тип("Массив") Тогда 
		item = itemArray;
		itemArray = Новый Массив;
		itemArray.Добавить(item);
	КонецЕсли;
	
	Если itemArray.Количество() = 0 Тогда 
		Возврат;
	КонецЕсли;
	
	// Создание нового уведомления получателю
	Уведомление = Задачи.aps_Уведомление.СоздатьЗадачу();
	Уведомление.Наименование= НСтр("ru = 'Заявка на верификацию'; en_US = 'Verification request'");
	Уведомление.Содержание	= НСтр("ru = 'Прошу проверить связь с номенклатурой.'; en_US = 'Please check the link with nomenclature'");

	Для i=0 По itemArray.Количество()-1 Цикл 
		Если ТипЗнч(itemArray[i]) = Тип("СправочникСсылка.aps_ЭлементыИзделия") Или 
				ТипЗнч(itemArray[i]) = Тип("СправочникСсылка.aps_ЭлементыСправочников") Или 
					ТипЗнч(itemArray[i]) = Тип("СправочникСсылка.aps_ЭлементыТехнологии") Тогда 
			item = itemArray[i];
		Иначе // Объект XDTO-модели
			item = itemArray[i].element;
		КонецЕсли;
		
		Если item.ПолучитьОбъект()=Неопределено Тогда 
			Продолжить;
		КонецЕсли;
		
		Уведомление.Вложения.Добавить().Вложение = item;
	КонецЦикла;
	
	Уведомление.ПолучитьФорму().ОткрытьМодально();
КонецПроцедуры

// Процедура создает бизнес-процесс согласования
// Параметры:
//		itemArray - массив элементов для согласования
// Пример:
//		aps_ПослатьНаСогласование( ПолучитьВыделенныеОбъекты() );
//
Процедура aps_ПослатьНаСогласование( Знач itemArray ) Экспорт
	Если ТипЗнч(itemArray) <> Тип("Массив") Тогда 
		item = itemArray;
		itemArray = Новый Массив;
		itemArray.Добавить(item);
	КонецЕсли;
	
	Если itemArray.Количество() = 0 Тогда 
		Возврат;
	КонецЕсли;

	БизнесПроцессСогласования = БизнесПроцессы.aps_ИзменениеСостояния.СоздатьБизнесПроцесс();
	
	МассивПеретаскивания = Новый Массив();
	Для i=0 По itemArray.Количество()-1 Цикл 
		Если ТипЗнч(itemArray[i]) = Тип("СправочникСсылка.aps_ЭлементыИзделия") Или 
				ТипЗнч(itemArray[i]) = Тип("СправочникСсылка.aps_ЭлементыСправочников") Или 
					ТипЗнч(itemArray[i]) = Тип("СправочникСсылка.aps_ЭлементыТехнологии") Тогда 
			itemXDTO = aps_СоздатьОбъектМоделиXDTO(item);
		Иначе // Объект XDTO-модели
			itemXDTO = itemArray[i];
		КонецЕсли;
		
		Если itemXDTO.element.ПолучитьОбъект()=Неопределено Тогда 
			Продолжить;
		КонецЕсли;
		
		МассивПеретаскивания.Добавить(itemXDTO);
	КонецЦикла;	
	
	ФормаБП = БизнесПроцессСогласования.ПолучитьФорму();
	ФормаБП.Открыть();
	
	ФормаБП.БизнесПроцессОбъект.КорневыеЭлементы.Очистить();
	ФормаБП.ДеревоСостава.Строки.Очистить();
	
	ФормаБП.ОбработкаВыбора(МассивПеретаскивания, Неопределено);
	Если ФормаБП.ДеревоСостава.Строки.Количество() > 0 Тогда 
		ФормаБП.ЭлементыФормы.ДеревоСостава.ТекущаяСтрока = ФормаБП.ДеревоСостава.Строки[0];
	КонецЕсли;
	
КонецПроцедуры

// Процедура устанавливает оформление ячейки для поручения
// Параметры:
//		Поручение - ЗадачаСсылка.aps_Поручение
//		ОформлениеЯчейки - объект ОформлениеЯчейки
// Пример:
//		aps_УстановитьОформлениеЯчейкиДляПоручения(ПоручениеСсылка, ОформлениеСтроки.Ячейки.Ссылка);
//
Процедура aps_УстановитьОформлениеЯчейкиДляПоручения(Поручение, ОформлениеЯчейки) Экспорт 
	
	ТекПользователь = ПараметрыСеанса.ТекущийПользователь;
	
	ИсполнительПоручения = Поручение.Исполнитель;
	ПоручениеСогласовано = Поручение.Согласовано;
	
	Если ТекПользователь = ИсполнительПоручения 
			ИЛИ Поручение.Исполнители.НайтиСтроки(Новый Структура("Пользователь", ТекПользователь)).Количество() > 0 И НЕ Поручение.ВзятоНаРассмотрение Тогда 
		ОформлениеЯчейки.ЦветТекста = WebЦвета.Черный;
	Иначе
		ОформлениеЯчейки.ЦветТекста = WebЦвета.ТемноСерый;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИсполнительПоручения) И ИсполнительПоручения <> ТекПользователь Тогда 
		СтрокаПользователь = Строка(ИсполнительПоручения)+". ";
	Иначе 
		СтрокаПользователь = "";
	КонецЕсли;
	
	Если Поручение.Выполнена Тогда
		ОформлениеЯчейки.ИндексКартинки = ?(ПоручениеСогласовано, 2, 3);
		СтрокаСогласовано = ?(ПоручениеСогласовано, НСтр("en_US='Approved';ru='Принято '"), НСтр("ru = 'Отклонено '; en_US = 'Refused '"));
		СтрокаДатаВыполнения="";
		ОформлениеЯчейки.УстановитьТекст(СтрокаПользователь+СтрокаСогласовано+СтрокаДатаВыполнения+Поручение.Наименование);
		
	ИначеЕсли Поручение.ВзятоНаРассмотрение Тогда
		ОформлениеЯчейки.ИндексКартинки = 1;
		ОформлениеЯчейки.УстановитьТекст(СтрокаПользователь+НСтр("ru = 'На рассмотрении '; en_US = 'Under consideration for '")+aps_ПолучитьПромежутокВремени(ТекущаяДата()-Поручение.ДатаНачалаВыполнения)+" "+Поручение.Наименование);
		
	Иначе
		ОформлениеЯчейки.ИндексКартинки = 0;
		Если Поручение.Исполнители.НайтиСтроки(Новый Структура("Пользователь", ТекПользователь)).Количество() > 0 Тогда
			ОформлениеЯчейки.Шрифт = Новый Шрифт(ОформлениеЯчейки.Шрифт,,,Истина);
		КонецЕсли;
		
		ОформлениеЯчейки.УстановитьТекст(СтрокаПользователь+НСтр("ru = 'Не рассматривалось '; en_US = 'New task '") + Поручение.Наименование);
	КонецЕсли;	
	
	// картинки поручений из коллекции aps_ВидыЭлементов
	ОформлениеЯчейки.ИндексКартинки = ОформлениеЯчейки.ИндексКартинки + 50;
	ОформлениеЯчейки.ОтображатьКартинку=Истина;
КонецПроцедуры

// Процедура устанавливает оформление ячейки для вложения
// Параметры:
//		Вложение - произвольная ссылка
//		ОформлениеЯчейки - объект ОформлениеЯчейки
//		КолонкаТабличногоПоля - колонка табличного поля
// Пример:
//		aps_УстановитьОформлениеЯчейкиДляВложения(Вложение, ОформлениеСтроки.Ячейки.Тема, Элемент.Колонки.Тема);
//
Процедура aps_УстановитьОформлениеЯчейкиДляВложения(Вложение, ОформлениеЯчейки, КолонкаТабличногоПоля) Экспорт
	МетаданныеВложения=Вложение.Метаданные();
	Если Метаданные.Задачи.Найти(МетаданныеВложения.Имя) <> Неопределено Тогда 
		Если МетаданныеВложения.Имя = "aps_Поручение" Тогда
			Если КолонкаТабличногоПоля.КартинкиСтрок<>БиблиотекаКартинок.aps_ВидыЭлементов Тогда 
				КолонкаТабличногоПоля.КартинкиСтрок=БиблиотекаКартинок.aps_ВидыЭлементов;
			КонецЕсли;
			aps_УстановитьОформлениеЯчейкиДляПоручения(Вложение, ОформлениеЯчейки);
		Иначе
			ОформлениеЯчейки.УстановитьТекст(Вложение.Наименование+НСтр("ru = "" от ""; en_US = "" dated """)+Формат(Вложение.Дата, "ДФ=""дд.ММ.гггг ЧЧ:мм"""));
			ОформлениеЯчейки.Картинка=БиблиотекаКартинок.Задача;
		КонецЕсли;
	ИначеЕсли Метаданные.БизнесПроцессы.Найти(МетаданныеВложения.Имя) <> Неопределено Тогда 
		ОформлениеЯчейки.УстановитьТекст(Строка(МетаданныеВложения.Синоним)+?(МетаданныеВложения.ДлинаНомера>0," "+Вложение.Номер,"")+НСтр("ru = "" от ""; en_US = "" dated """)+Строка(Вложение.Дата));
		ОформлениеЯчейки.Картинка=БиблиотекаКартинок.БизнесПроцесс;
	ИначеЕсли Метаданные.Документы.Найти(МетаданныеВложения.Имя) <> Неопределено Тогда 
		Если МетаданныеВложения.Имя="aps_ИзвещениеОбИзменении" Тогда 
			ОформлениеЯчейки.Картинка=БиблиотекаКартинок.aps_Извещение;
		ИначеЕсли МетаданныеВложения.Имя="aps_ЗаявкаНаТиражирование" Тогда 
			ОформлениеЯчейки.Картинка=БиблиотекаКартинок.aps_ЗаявкаНаТиражирование;
		КонецЕсли;
	Иначе // ссылка на элемент
		Если КолонкаТабличногоПоля.КартинкиСтрок<>БиблиотекаКартинок.aps_ВидыЭлементов Тогда 
			КолонкаТабличногоПоля.КартинкиСтрок=БиблиотекаКартинок.aps_ВидыЭлементов;
		КонецЕсли;
		ОформлениеЯчейки.УстановитьТекст(Вложение.Наименование);
		ОформлениеЯчейки.ИндексКартинки=?(Вложение.ИндексКартинки=0, Вложение.ВидЭлемента.ИндексКартинки, Вложение.ИндексКартинки);
	КонецЕсли;
	
	ОформлениеЯчейки.ОтображатьКартинку=Истина;
КонецПроцедуры

#КонецЕсли


#Если (ТолстыйКлиентОбычноеПриложение Или ТолстыйКлиентУправляемоеПриложение Или Сервер) И НЕ МобильноеПриложениеСервер Тогда

// Функция создает новое уведомление
//
// Параметры:
//  ОтКого - пользователь, отправляющий уведомление
//  Кому - пользователь, кому приходит сообщение
//  Копия - информация о пользователях, кому была отправлена копия
//  Тема - тема сообщения 
//  Содержание - содержание сообщения
//  Вложения - массив
//	Приоритет - приоритет уведомления
//	УведомитьОПрочтении - отправитель получит сообщение о том, что письмо было прочтено
//	СистемноеПисьмо - письмо отправлено PDM-системой
// Возвращаемое значение
//		Строка - ЗадачаСсылка.aps_Уведомление, созданное уведомление
// Пример:
//		aps_СоздатьУведомление(Отправитель, Получатель,, ТемаУведомления, ТекстУведомления,, МассивПоручений, Истина, Ложь,, Истина);
//
Функция aps_СоздатьУведомление( ОтКого, Кому, Копия=Неопределено, Тема=Неопределено, Содержание=Неопределено, Теги=Неопределено, Вложения=Неопределено, Приоритет=Неопределено, УведомитьОПрочтении=Ложь, ОтветНаПисьмо=Неопределено, СистемноеПисьмо=Ложь ) Экспорт
	ПисьмоПолучателю = Задачи.aps_Уведомление.СоздатьЗадачу();
	
	ПисьмоПолучателю.Отправитель			= ОтКого;
	ПисьмоПолучателю.Получатель				= Кому;
	ПисьмоПолучателю.Копия					= Копия;
	ПисьмоПолучателю.Наименование			= Тема;
	ПисьмоПолучателю.Содержание				= Содержание;
	ПисьмоПолучателю.Важное					= Приоритет;
	ПисьмоПолучателю.УведомитьОПрочтении	= УведомитьОПрочтении;

	Если ТипЗнч(Вложения) = Тип("Массив") Тогда
		Для Каждого Вложение Из Вложения Цикл
			ПисьмоПолучателю.Вложения.Добавить().Вложение = Вложение;
		КонецЦикла;
	КонецЕсли;
	
	Если ТипЗнч(Теги) = Тип("Массив") Тогда
		Для Каждого Тег Из Теги Цикл
			ПисьмоПолучателю.Теги.Добавить().Тег = Тег;
		КонецЦикла;
	КонецЕсли;
	
	ПисьмоПолучателю.Дата	= ТекущаяДата();
	ПисьмоПолучателю.Записать();
	
	Если ЗначениеЗаполнено(ОтветНаПисьмо) Тогда
		Запись = РегистрыСведений.aps_ОтветыНаУведомления.СоздатьМенеджерЗаписи();
		Запись.Уведомление	= ОтветНаПисьмо;
		Запись.Ответ		= ПисьмоПолучателю.Ссылка;
		Запись.Записать(Истина);
	КонецЕсли;
	
	Если НЕ СистемноеПисьмо Тогда 	// Копия отправителю
		ПисьмоОтправителю = ПисьмоПолучателю.Скопировать();
		ПисьмоОтправителю.Дата				= ТекущаяДата();
		ПисьмоОтправителю.Выполнена			= Истина;
		ПисьмоОтправителю.КопияОтправителю	= Истина;
		ПисьмоОтправителю.Записать();
	КонецЕсли;
	
	Возврат ПисьмоОтправителю;
КонецФункции

// Функция изменяет подпись уведомления, открывая диалог изменения подписи
//
// Параметры:
//		Пользователь
// Возвращаемое значение:
//		нет
// Пример:
//		aps_ИзменитьПодпись( ПараметрыСеанса.ТекущийПользователь );
//
Функция aps_ИзменитьПодпись( Пользователь ) Экспорт
	Запись = РегистрыСведений.aps_ПодписиУведомлений.СоздатьМенеджерЗаписи();
	Запись.Пользователь = Пользователь;
	Запись.Прочитать();
	Если НЕ Запись.Выбран() Тогда 
		Запись.Пользователь = Пользователь;
		Запись.Записать();
	КонецЕсли;
	
	ФормаПодписи = Запись.ПолучитьФорму();
	ФормаПодписи.Заголовок = ФормаПодписи.Заголовок+" ("+Строка(Пользователь)+")";
	ФормаПодписи.Открыть();
КонецФункции

// Функция получает текстовое представление интервала времени по количеству секунд
// Параметры:
//		КоличествоСекунд - Число (в секундах)
// Возвращаемое значение:
//		Строка
// Пример:
//		ПромежутокВремени = aps_ПолучитьПромежутокВремени(ТекущаяДата()-Поручение.ДатаНачалаВыполнения);
//
Функция aps_ПолучитьПромежутокВремени(КоличествоСекунд) Экспорт 
	Если КоличествоСекунд / 86400 >= 1 Тогда
		Возврат Строка(Цел(КоличествоСекунд / 86400))+НСтр("ru = ' дн.'; en_US = ' d.'");
	ИначеЕсли КоличествоСекунд / 3600 >= 1 Тогда
		Возврат Строка(Цел(КоличествоСекунд / 3600))+НСтр("ru = ' ч.'; en_US = ' hr.'");
	Иначе
		Возврат Строка(Цел(КоличествоСекунд / 60))+НСтр("ru = ' мин.'; en_US = ' min.'");
	КонецЕсли;
КонецФункции

// Процедура создает уведомление с вложенными поручениями
//
// Параметры:
//		Отправитель				- СправочникСсылка.Пользователи
//		Получатель				- СправочникСсылка.Пользователи
//		БПИзменениеСостояния	- БизнесПроцессСсылка.aps_ИзменениеСостояния
//		МассивПоручений			- массив значений типа ЗадачаСсылка.aps_Поручение
// Пример:
//		aps_ОтправитьПоручения(ТекПользователь, НовыйИсполнитель, Ссылка, МассивПеренаправленныхПоручений);	
//
Процедура aps_ОтправитьПоручения( Отправитель, Получатель, БПИзменениеСостояния, МассивПоручений ) Экспорт 
	ТемаУведомления = НСтр("ru = ""Изменение состояний элементов""; en_US = ""Status management""")+?(ЗначениеЗаполнено(БПИзменениеСостояния.Комментарий), " ("+БПИзменениеСостояния.Комментарий+")", "");
	ТекстУведомления = НСтр("ru = ""Вам направлены поручения по изменению состояний элементов. Поручения находятся во вложении.""; en_US = ""Tasks of approval process are attached.""");

	aps_СоздатьУведомление(Отправитель, Получатель,, ТемаУведомления, ТекстУведомления,, МассивПоручений, Истина, Ложь,, Истина);
КонецПроцедуры

#КонецЕсли

#КонецОбласти