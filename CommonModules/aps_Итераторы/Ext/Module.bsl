#Если НЕ МобильноеПриложениеСервер Тогда
	
#Область ПрограммныйИнтерфейс	
	
// Итератор вертикальных связей справочника и личных папок
// 
// Параметры:
// 		item - Элемент изделия или технологии, или массив элементов
//		ПравилоУправления - ссылка на элемент справочника ПравилаУправления
//
// Возвращаемое значение:
//		ТаблицаЗначений
//
// Пример:
//		ВертикальныеСвязиПапок	= aps_Итераторы.aps_ВертикальныеСвязиПапок( СписокЭлементов );
//
Функция aps_ВертикальныеСвязиПапок( item, Знач ПравилоУправления = Неопределено, ВключаяПараметры = Истина ) Экспорт 
	Если ТипЗнч(ПравилоУправления) = Тип("Строка") Тогда	// передается строка XML
		ПравилоУправления = Строка2Object1С(ПравилоУправления);
	КонецЕсли;
	
	МассивТипов=Новый Массив;
	МассивТипов.Добавить(Тип("СправочникСсылка.aps_ЭлементыИзделия"));
	МассивТипов.Добавить(Тип("СправочникСсылка.aps_ЭлементыСправочников"));
	МассивТипов.Добавить(Тип("СправочникСсылка.aps_ЭлементыТехнологии"));
	ОписаниеТиповЭлемента=Новый ОписаниеТипов(МассивТипов);
	
	СуществующиеСсылки=Новый ТаблицаЗначений();
	СуществующиеСсылки.Колонки.Добавить("Ссылка", ОписаниеТиповЭлемента);
	Если ТипЗнч(item) = Тип("Массив") Тогда 
		Для i=0 По item.Количество()-1 Цикл 
			СуществующиеСсылки.Добавить().Ссылка = item[i];
		КонецЦикла;
	Иначе
		СуществующиеСсылки.Добавить().Ссылка = item;
	КонецЕсли;
	СуществующиеСсылки.Свернуть("Ссылка");
	
	МенеджерВТ=Новый МенеджерВременныхТаблиц;
	
	ЗапросИтератора=Новый Запрос();
	ЗапросИтератора.МенеджерВременныхТаблиц=МенеджерВТ;
	// Текст запроса для построения временной таблицы
	ЗапросИтератора.Текст="ВЫБРАТЬ
	                      |	ТаблицаСсылок.Ссылка КАК Ссылка
	                      |ПОМЕСТИТЬ ВТСсылки
	                      |ИЗ
	                      |	&Данные КАК ТаблицаСсылок";
	ЗапросИтератора.УстановитьПараметр("Данные",СуществующиеСсылки);
	ЗапросИтератора.Выполнить();
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ВертикальныеСвязиПапок.ЭлементСвязи,
				   |	ВертикальныеСвязиПапок.ЭлементСсылка,
				   |	ВертикальныеСвязиПапок.РодительСсылка,
	               |	ВЫБОР
	               |		КОГДА ВертикальныеСвязиПапок.ОригиналРевизии = НЕОПРЕДЕЛЕНО
	               |			ТОГДА ВертикальныеСвязиПапок.ЭлементСсылка
	               |		ИНАЧЕ ВертикальныеСвязиПапок.ОригиналРевизии
	               |	КОНЕЦ КАК ОригиналРевизии,
	               |	ЛОЖЬ КАК РевизияПодобрана,
				   |	ВертикальныеСвязиПапок.ВидЭлемента,
				   |	ВертикальныеСвязиПапок.КодВидаЭлемента,
	               |	ВертикальныеСвязиПапок.Картинка,
				   |	ВертикальныеСвязиПапок.ПредставлениеЭлемента,
	               |	ВертикальныеСвязиПапок.Владелец,
	               |	ВертикальныеСвязиПапок.Группа,
	               |	ВертикальныеСвязиПапок.HTMLКонтент,
	               |	ВертикальныеСвязиПапок.ВидСвязи,
	               |	0 КАК ПорядокВывода,
	               |	ЛОЖЬ КАК ОбратнаяСвязь";
	Если ВключаяПараметры Тогда 
		ТекстЗапроса = ТекстЗапроса + ",
	               |	ВЫРАЗИТЬ(ВертикальныеСвязиПапок.ЭлементСсылка КАК Справочник.aps_ЭлементыИзделия).Параметры.(Параметр, Параметр.Наименование КАК ИмяПараметра, Параметр.Свойство КАК Свойство, Параметр.Значение КАК Значение, Параметр.ЕдиницаИзмерения КАК ЕдиницаИзмерения, Параметр.Родитель КАК ГруппаПараметров, Параметр.Родитель.Наименование КАК ИмяГруппыПараметров) КАК ПараметрыЭлементаИзделия,
	               |	ВЫРАЗИТЬ(ВертикальныеСвязиПапок.ЭлементСсылка КАК Справочник.aps_ЭлементыСправочников).Параметры.(Параметр, Параметр.Наименование КАК ИмяПараметра, Параметр.Свойство КАК Свойство, Параметр.Значение КАК Значение, Параметр.ЕдиницаИзмерения КАК ЕдиницаИзмерения, Параметр.Родитель КАК ГруппаПараметров, Параметр.Родитель.Наименование КАК ИмяГруппыПараметров) КАК ПараметрыЭлементаСправочника,
	               |	ВЫРАЗИТЬ(ВертикальныеСвязиПапок.ЭлементСсылка КАК Справочник.aps_ЭлементыТехнологии).Параметры.(Параметр, Параметр.Наименование КАК ИмяПараметра, Параметр.Свойство КАК Свойство, Параметр.Значение КАК Значение, Параметр.ЕдиницаИзмерения КАК ЕдиницаИзмерения, Параметр.Родитель КАК ГруппаПараметров, Параметр.Родитель.Наименование КАК ИмяГруппыПараметров) КАК ПараметрыЭлементаТехнологии,
				   |	НЕОПРЕДЕЛЕНО КАК ПараметрыЭлементаСвязи";
	КонецЕсли;
	ТекстЗапроса = ТекстЗапроса + "
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ВертикальныеСвязи.ЭлементСвязи КАК ЭлементСвязи,
				   |		ВертикальныеСвязи.ЭлементСсылка КАК ЭлементСсылка,
				   |		ВертикальныеСвязи.РодительСсылка КАК РодительСсылка,
	               |		ВертикальныеСвязи.ЭлементСсылка.ОригиналРевизии КАК ОригиналРевизии,
	               |		ВертикальныеСвязи.ЭлементСсылка.ВидЭлемента КАК ВидЭлемента,
	               |		ВЫБОР
	               |			КОГДА ВертикальныеСвязи.ЭлементСсылка.ИндексКартинки = 0
	               |				ТОГДА ВертикальныеСвязи.ЭлементСсылка.ВидЭлемента.ИндексКартинки
	               |			ИНАЧЕ ВертикальныеСвязи.ЭлементСсылка.ИндексКартинки
	               |		КОНЕЦ КАК Картинка,
	               |		ВертикальныеСвязи.ЭлементСсылка.Наименование КАК ПредставлениеЭлемента,
	               |		ВертикальныеСвязи.ЭлементСсылка.UID КАК Владелец,
	               |		ВертикальныеСвязи.ЭлементСсылка.GID КАК Группа,
	               |		ВертикальныеСвязи.ЭлементСсылка.HTMLКонтент КАК HTMLКонтент,
	               |		ВертикальныеСвязи.ЭлементСсылка.ВидЭлемента.Код КАК КодВидаЭлемента,
	               |		ВертикальныеСвязи.ВидСвязи КАК ВидСвязи
	               |	ИЗ
	               |		(ВЫБРАТЬ
	               |			aps_ВертикальныеСвязи.Ссылка КАК ЭлементСвязи,
	               |			aps_ВертикальныеСвязи.ПотомокСсылка КАК ЭлементСсылка,
	               |			aps_ВертикальныеСвязи.РодительСсылка КАК РодительСсылка,
	               |			aps_ВертикальныеСвязи.ВидСвязи КАК ВидСвязи
	               |		ИЗ
				   |			ВТСсылки
				   |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.aps_ВертикальныеСвязи КАК aps_ВертикальныеСвязи ПО
				   |			ВТСсылки.Ссылка = aps_ВертикальныеСвязи.РодительСсылка
				   |			И (НЕ aps_ВертикальныеСвязи.ПометкаУдаления)) КАК ВертикальныеСвязи) КАК ВертикальныеСвязиПапок";
	Если ПравилоУправления <> Неопределено И ПравилоУправления.ВидыЭлементовФильтр.Количество() > 0 Тогда 
		ТекстЗапроса = ТекстЗапроса + "
	               |ГДЕ ВертикальныеСвязиПапок.ВидЭлемента В(&ВидыЭлементов)";
		ЗапросИтератора.УстановитьПараметр("ВидыЭлементов", ПравилоУправления.ВидыЭлементовФильтр.ВыгрузитьКолонку(0));
	КонецЕсли;
	ТекстЗапроса = ТекстЗапроса + "
	               |УПОРЯДОЧИТЬ ПО
				   |	ВертикальныеСвязиПапок.РодительСсылка,
	               |	ВертикальныеСвязиПапок.КодВидаЭлемента,
	               |	ВертикальныеСвязиПапок.ПредставлениеЭлемента";
				
	ЗапросИтератора.Текст = ТекстЗапроса;
	РезультатИтератора = ЗапросИтератора.Выполнить().Выгрузить();
	
	Если ПравилоУправления <> Неопределено Тогда 
		
		// Массив элементов для подбора
		МассивЭлементов	= РезультатИтератора.ВыгрузитьКолонку("ОригиналРевизии");
		ПодобранныеРевизииЭлементов	= aps_ПодборРевизийЭлементов(МассивЭлементов, ПравилоУправления);
		
		i = 0;
		Пока i < РезультатИтератора.Количество() Цикл 
			СтрокаРезультата = РезультатИтератора[i];
			
			СтрокаПодобраннойРевизии = ПодобранныеРевизииЭлементов.Найти(СтрокаРезультата.ОригиналРевизии, "ОригиналРевизии");
			// Если ревизия подобрана, заменить оригинальный элемент ревизией
			Если СтрокаПодобраннойРевизии <> Неопределено И СтрокаРезультата.ЭлементСсылка <> СтрокаПодобраннойРевизии.ЭлементСсылка Тогда 
				ЗаполнитьЗначенияСвойств(СтрокаРезультата, СтрокаПодобраннойРевизии);
				СтрокаРезультата.РевизияПодобрана=Истина;
			КонецЕсли;
			
			i = i + 1;
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат РезультатИтератора;
КонецФункции

// Итератор подчиненных элементов (из табличной части)
// 
// Параметры
// 		item - Элемент изделия или технологии, или массив элементов
//		ПравилоУправления - ссылка на элемент справочника ПравилаУправления
//
// Возвращаемое значение:
//		ТаблицаЗначений
// 
// Пример:
//		ПодчиненныеЭлементы = aps_Итераторы.aps_ПодчиненныеЭлементы(parentArray, ПравилоУправления, ВключаяПараметры);
//
Функция aps_ПодчиненныеЭлементы( item, Знач ПравилоУправления = Неопределено, ВключаяПараметры = Истина ) Экспорт 
	Если ТипЗнч(ПравилоУправления) = Тип("Строка") Тогда	// передается строка XML
		ПравилоУправления = Строка2Object1С(ПравилоУправления);
	КонецЕсли;
	
	МассивТипов=Новый Массив;
	МассивТипов.Добавить(Тип("СправочникСсылка.aps_ЭлементыИзделия"));
	МассивТипов.Добавить(Тип("СправочникСсылка.aps_ЭлементыСправочников"));
	МассивТипов.Добавить(Тип("СправочникСсылка.aps_ЭлементыТехнологии"));
	ОписаниеТиповЭлемента=Новый ОписаниеТипов(МассивТипов);
	
	СуществующиеСсылки=Новый ТаблицаЗначений();
	СуществующиеСсылки.Колонки.Добавить("Ссылка", ОписаниеТиповЭлемента);
	Если ТипЗнч(item) = Тип("Массив") Тогда 
		Для i=0 По item.Количество()-1 Цикл 
			СуществующиеСсылки.Добавить().Ссылка = item[i];
		КонецЦикла;
	Иначе
		СуществующиеСсылки.Добавить().Ссылка = item;
	КонецЕсли;
	
	
	МенеджерВТ=Новый МенеджерВременныхТаблиц;
	
	ЗапросИтератора=Новый Запрос();
	ЗапросИтератора.МенеджерВременныхТаблиц=МенеджерВТ;
	// Текст запроса для построения временной таблицы
	ЗапросИтератора.Текст="ВЫБРАТЬ
	                      |	ТаблицаСсылок.Ссылка КАК Ссылка
	                      |ПОМЕСТИТЬ ВТСсылки
	                      |ИЗ
	                      |	&Данные КАК ТаблицаСсылок";
	ЗапросИтератора.УстановитьПараметр("Данные",СуществующиеСсылки);
	ЗапросИтератора.Выполнить();
	// Получаем таблицу из менеджера временных таблиц запроса
	ЗапросИтератора.Текст="ВЫБРАТЬ
						 |	ВЫРАЗИТЬ(Ссылка КАК Справочник.aps_ЭлементыТехнологии).ПодчиненныеЭлементыТехнологии.(Ссылка КАК РодительСсылка, ЭлементСсылка, ВидСвязи, НомерСтроки) КАК ПодчиненныеЭлементыТехнологии,
						 |	ВЫРАЗИТЬ(Ссылка КАК Справочник.aps_ЭлементыСправочников).ЭлементыРесурса.(Ссылка КАК РодительСсылка, ЭлементСсылка, ВидСвязи, НомерСтроки) КАК ЭлементыРесурса
						 |ИЗ
						 |	ВТСсылки";
	СуществующиеСсылки=ЗапросИтератора.Выполнить().Выгрузить();
    // Формируем общую таблицу из полученных табличных частей
	ТаблицаПодчиненных = Неопределено;
	Для i=0 По СуществующиеСсылки.Количество()-1 Цикл 
		Для c=0 По СуществующиеСсылки.Колонки.Количество()-1 Цикл 
			Для Каждого СтрокаПодчинения Из СуществующиеСсылки[i][c] Цикл 
				Если ТаблицаПодчиненных = Неопределено Тогда 
					ТаблицаПодчиненных = СуществующиеСсылки[i][c].Скопировать();
					ТаблицаПодчиненных.Очистить();
				КонецЕсли;
				ЗаполнитьЗначенияСвойств(ТаблицаПодчиненных.Добавить(), СтрокаПодчинения);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	Если ТаблицаПодчиненных = Неопределено Тогда // не выполнять запрос
		РезультатИтератора = Новый ТаблицаЗначений;
		РезультатИтератора.Колонки.Добавить("ЭлементСсылка");
		РезультатИтератора.Колонки.Добавить("РодительСсылка");
		РезультатИтератора.Колонки.Добавить("ОригиналРевизии");
		РезультатИтератора.Колонки.Добавить("РевизияПодобрана");
		РезультатИтератора.Колонки.Добавить("ВидЭлемента");
		РезультатИтератора.Колонки.Добавить("Картинка");
		РезультатИтератора.Колонки.Добавить("ПредставлениеЭлемента");
		РезультатИтератора.Колонки.Добавить("Владелец");
		РезультатИтератора.Колонки.Добавить("Группа");
		РезультатИтератора.Колонки.Добавить("HTMLКонтент");
		РезультатИтератора.Колонки.Добавить("ВидСвязи");
		РезультатИтератора.Колонки.Добавить("ПорядокВывода");
		РезультатИтератора.Колонки.Добавить("ПараметрыЭлементаИзделия");
		РезультатИтератора.Колонки.Добавить("ПараметрыЭлементаСправочника");
		РезультатИтератора.Колонки.Добавить("ПараметрыЭлементаТехнологии");
		Возврат РезультатИтератора;
	КонецЕсли;		
	
	ЗапросИтератора.Текст="ВЫБРАТЬ *
						 |ПОМЕСТИТЬ ВТПодчиненныеЭлементы
						 |ИЗ
						 |	&Данные КАК ТаблицаСсылок";
	ЗапросИтератора.УстановитьПараметр("Данные",ТаблицаПодчиненных);
	ЗапросИтератора.Выполнить();	
	
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	НЕОПРЕДЕЛЕНО КАК ЭлементСвязи,
	               |	ПодчиненныеЭлементы.ЭлементСсылка,
	               |	ПодчиненныеЭлементы.РодительСсылка,
	               |	ВЫБОР
	               |		КОГДА ПодчиненныеЭлементы.ОригиналРевизии = НЕОПРЕДЕЛЕНО
	               |			ТОГДА ПодчиненныеЭлементы.ЭлементСсылка
	               |		ИНАЧЕ ПодчиненныеЭлементы.ОригиналРевизии
	               |	КОНЕЦ КАК ОригиналРевизии,
	               |	ЛОЖЬ КАК РевизияПодобрана,
				   |	ПодчиненныеЭлементы.ВидЭлемента,
				   |	ПодчиненныеЭлементы.КодВидаЭлемента,				   
	               |	ПодчиненныеЭлементы.Картинка,
	               |	ПодчиненныеЭлементы.ПредставлениеЭлемента,
	               |	ПодчиненныеЭлементы.Владелец,
	               |	ПодчиненныеЭлементы.Группа,
	               |	ПодчиненныеЭлементы.HTMLКонтент,
	               |	ПодчиненныеЭлементы.ВидСвязи,
	               |	ПодчиненныеЭлементы.ПорядокВывода,
	               |	ЛОЖЬ КАК ОбратнаяСвязь";
	Если ВключаяПараметры Тогда 
		ТекстЗапроса = ТекстЗапроса + ",
	               |	ВЫРАЗИТЬ(ПодчиненныеЭлементы.ЭлементСсылка КАК Справочник.aps_ЭлементыИзделия).Параметры.(Параметр, Параметр.Наименование КАК ИмяПараметра, Параметр.Свойство КАК Свойство, Параметр.Значение КАК Значение, Параметр.ЕдиницаИзмерения КАК ЕдиницаИзмерения, Параметр.Родитель КАК ГруппаПараметров, Параметр.Родитель.Наименование КАК ИмяГруппыПараметров) КАК ПараметрыЭлементаИзделия,
	               |	ВЫРАЗИТЬ(ПодчиненныеЭлементы.ЭлементСсылка КАК Справочник.aps_ЭлементыСправочников).Параметры.(Параметр, Параметр.Наименование КАК ИмяПараметра, Параметр.Свойство КАК Свойство, Параметр.Значение КАК Значение, Параметр.ЕдиницаИзмерения КАК ЕдиницаИзмерения, Параметр.Родитель КАК ГруппаПараметров, Параметр.Родитель.Наименование КАК ИмяГруппыПараметров) КАК ПараметрыЭлементаСправочника,
	               |	ВЫРАЗИТЬ(ПодчиненныеЭлементы.ЭлементСсылка КАК Справочник.aps_ЭлементыТехнологии).Параметры.(Параметр, Параметр.Наименование КАК ИмяПараметра, Параметр.Свойство КАК Свойство, Параметр.Значение КАК Значение, Параметр.ЕдиницаИзмерения КАК ЕдиницаИзмерения, Параметр.Родитель КАК ГруппаПараметров, Параметр.Родитель.Наименование КАК ИмяГруппыПараметров) КАК ПараметрыЭлементаТехнологии,
				   |	НЕОПРЕДЕЛЕНО КАК ПараметрыЭлементаСвязи";
	КонецЕсли;				   
	ТекстЗапроса = ТекстЗапроса + "
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ПодчиненныеЭлементы.РодительСсылка КАК РодительСсылка,
				   |		ПодчиненныеЭлементы.ЭлементСсылка КАК ЭлементСсылка,
	               |		ПодчиненныеЭлементы.ЭлементСсылка.ОригиналРевизии КАК ОригиналРевизии,
	               |		ПодчиненныеЭлементы.ЭлементСсылка.ВидЭлемента КАК ВидЭлемента,
	               |		ВЫБОР
	               |			КОГДА ПодчиненныеЭлементы.ЭлементСсылка.ИндексКартинки = 0
	               |				ТОГДА ПодчиненныеЭлементы.ЭлементСсылка.ВидЭлемента.ИндексКартинки
	               |			ИНАЧЕ ПодчиненныеЭлементы.ЭлементСсылка.ИндексКартинки
	               |		КОНЕЦ КАК Картинка,
	               |		ПодчиненныеЭлементы.ЭлементСсылка.Наименование КАК ПредставлениеЭлемента,
	               |		ПодчиненныеЭлементы.ЭлементСсылка.UID КАК Владелец,
	               |		ПодчиненныеЭлементы.ЭлементСсылка.GID КАК Группа,
	               |		ПодчиненныеЭлементы.ЭлементСсылка.HTMLКонтент КАК HTMLКонтент,
	               |		ПодчиненныеЭлементы.ЭлементСсылка.ВидЭлемента.Код КАК КодВидаЭлемента,
	               |		ПодчиненныеЭлементы.ВидСвязи КАК ВидСвязи,
	               |		ПодчиненныеЭлементы.НомерСтроки КАК ПорядокВывода,
	               |		ВЫБОР
	               |			КОГДА ПодчиненныеЭлементы.ВидСвязи.Автоупорядочивание
	               |				ТОГДА 0
	               |			ИНАЧЕ ПодчиненныеЭлементы.НомерСтроки
	               |		КОНЕЦ КАК Порядок
	               |	ИЗ
	               |		ВТПодчиненныеЭлементы КАК ПодчиненныеЭлементы) КАК ПодчиненныеЭлементы";
	Если ПравилоУправления <> Неопределено И ПравилоУправления.ВидыЭлементовФильтр.Количество() > 0 Тогда 
		ТекстЗапроса = ТекстЗапроса + "
				   |ГДЕ ПодчиненныеЭлементы.ВидЭлемента В(&ВидыЭлементов)";
		ЗапросИтератора.УстановитьПараметр("ВидыЭлементов", ПравилоУправления.ВидыЭлементовФильтр.ВыгрузитьКолонку(0));
	КонецЕсли;
	ТекстЗапроса = ТекстЗапроса + "
	               |УПОРЯДОЧИТЬ ПО
				   |	ПодчиненныеЭлементы.РодительСсылка,
				   |	ПодчиненныеЭлементы.Порядок,
	               |	ПодчиненныеЭлементы.КодВидаЭлемента,
	               |	ПодчиненныеЭлементы.ПредставлениеЭлемента";
				   
	ЗапросИтератора.Текст = ТекстЗапроса;
	РезультатИтератора = ЗапросИтератора.Выполнить().Выгрузить();
	
	
	Если ПравилоУправления <> Неопределено Тогда 
		
		// Массив элементов для подбора
		МассивЭлементов = РезультатИтератора.ВыгрузитьКолонку("ОригиналРевизии");
		ПодобранныеРевизииЭлементов = aps_ПодборРевизийЭлементов(МассивЭлементов, ПравилоУправления);
		
		i = 0;
		Пока i < РезультатИтератора.Количество() Цикл 
			СтрокаРезультата = РезультатИтератора[i];
			
			СтрокаПодобраннойРевизии = ПодобранныеРевизииЭлементов.Найти(СтрокаРезультата.ОригиналРевизии, "ОригиналРевизии");
			// Если ревизия подобрана, заменить оригинальный элемент ревизией
			Если СтрокаПодобраннойРевизии <> Неопределено И СтрокаРезультата.ЭлементСсылка <> СтрокаПодобраннойРевизии.ЭлементСсылка Тогда 
				ЗаполнитьЗначенияСвойств(СтрокаРезультата, СтрокаПодобраннойРевизии);
				СтрокаРезультата.РевизияПодобрана=Истина;
			КонецЕсли;
			
			i = i + 1;
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат РезультатИтератора;
КонецФункции

// Итератор элементных параметрических связей
// 
// Параметры
// 		item - Элемент изделия или технологии, или массив элементов
//		ПравилоУправления - ссылка на элемент справочника ПравилаУправления
//
// Возвращаемое значение:
//		ТаблицаЗначений
//
// Пример:
//      РезультатИтератора = aps_ЭлементныеСвязи(item, ПравилоУправления);
//
Функция aps_ЭлементныеСвязи( item, Знач ПравилоУправления = Неопределено, ВключаяПараметры = Истина ) Экспорт 
	Если ТипЗнч(ПравилоУправления) = Тип("Строка") Тогда	// передается строка XML
		ПравилоУправления = Строка2Object1С(ПравилоУправления);
	КонецЕсли;
	
	МассивТипов=Новый Массив;
	МассивТипов.Добавить(Тип("СправочникСсылка.aps_ЭлементыИзделия"));
	МассивТипов.Добавить(Тип("СправочникСсылка.aps_ЭлементыСправочников"));
	МассивТипов.Добавить(Тип("СправочникСсылка.aps_ЭлементыТехнологии"));
	МассивТипов.Добавить(Тип("СправочникСсылка.aps_ЭлементыСвязей"));
	ОписаниеТиповЭлемента=Новый ОписаниеТипов(МассивТипов);
	
	СуществующиеСсылки=Новый ТаблицаЗначений();
	СуществующиеСсылки.Колонки.Добавить("Ссылка", ОписаниеТиповЭлемента);
	Если ТипЗнч(item) = Тип("Массив") Тогда 
		Для i=0 По item.Количество()-1 Цикл 
			СуществующиеСсылки.Добавить().Ссылка = item[i];
		КонецЦикла;
	Иначе
		СуществующиеСсылки.Добавить().Ссылка = item;
	КонецЕсли;
	СуществующиеСсылки.Свернуть("Ссылка");
	
	МенеджерВТ=Новый МенеджерВременныхТаблиц;
	
	ЗапросИтератора=Новый Запрос();
	ЗапросИтератора.МенеджерВременныхТаблиц=МенеджерВТ;
	// Текст запроса для построения временной таблицы
	ЗапросИтератора.Текст="ВЫБРАТЬ
	                      |	ТаблицаСсылок.Ссылка КАК Ссылка
	                      |ПОМЕСТИТЬ ВТСсылки
	                      |ИЗ
	                      |	&Данные КАК ТаблицаСсылок";
	ЗапросИтератора.УстановитьПараметр("Данные",СуществующиеСсылки);
	ЗапросИтератора.Выполнить();

	ТекстЗапроса = "ВЫБРАТЬ
	               |	ЭлементныеСвязи.ЭлементСвязи,
	               |	ЭлементныеСвязи.ЭлементСсылка,
	               |	ЭлементныеСвязи.РодительСсылка,
	               |	ВЫБОР
	               |		КОГДА ЭлементныеСвязи.ОригиналРевизии = НЕОПРЕДЕЛЕНО
	               |			ТОГДА ЭлементныеСвязи.ЭлементСсылка
	               |		ИНАЧЕ ЭлементныеСвязи.ОригиналРевизии
	               |	КОНЕЦ КАК ОригиналРевизии,
	               |	ЛОЖЬ КАК РевизияПодобрана,
	               |	ЭлементныеСвязи.ВидЭлемента,
	               |	ЭлементныеСвязи.КодВидаЭлемента,
	               |	ЭлементныеСвязи.Картинка,
	               |	ЭлементныеСвязи.ПредставлениеЭлемента,
	               |	ЭлементныеСвязи.Владелец,
	               |	ЭлементныеСвязи.Группа,
	               |	ЭлементныеСвязи.HTMLКонтент,
	               |	ЭлементныеСвязи.ВидСвязи,
	               |	ЭлементныеСвязи.ОбратнаяСвязь,
	               |	ЭлементныеСвязи.КартинкаСвязи,
	               |	ЭлементныеСвязи.ПредставлениеСвязи,
	               |	ЭлементныеСвязи.КодВидаСвязи,				   
	               |	ЭлементныеСвязи.ПорядокВывода";
	Если ВключаяПараметры Тогда 
		ТекстЗапроса = ТекстЗапроса + ",
				   |	ЭлементныеСвязи.ЭлементСвязи.Параметры.(Параметр, Параметр.Наименование КАК ИмяПараметра, Параметр.Свойство КАК Свойство, Параметр.Значение КАК Значение, Параметр.ЕдиницаИзмерения КАК ЕдиницаИзмерения, Параметр.Родитель КАК ГруппаПараметров, Параметр.Родитель.Наименование КАК ИмяГруппыПараметров) КАК ПараметрыЭлементаСвязи,
				   |	ВЫРАЗИТЬ(ЭлементныеСвязи.ЭлементСсылка КАК Справочник.aps_ЭлементыИзделия).Параметры.(Параметр, Параметр.Наименование КАК ИмяПараметра, Параметр.Свойство КАК Свойство, Параметр.Значение КАК Значение, Параметр.ЕдиницаИзмерения КАК ЕдиницаИзмерения, Параметр.Родитель КАК ГруппаПараметров, Параметр.Родитель.Наименование КАК ИмяГруппыПараметров) КАК ПараметрыЭлементаИзделия,
				   |	ВЫРАЗИТЬ(ЭлементныеСвязи.ЭлементСсылка КАК Справочник.aps_ЭлементыСправочников).Параметры.(Параметр, Параметр.Наименование КАК ИмяПараметра, Параметр.Свойство КАК Свойство, Параметр.Значение КАК Значение, Параметр.ЕдиницаИзмерения КАК ЕдиницаИзмерения, Параметр.Родитель КАК ГруппаПараметров, Параметр.Родитель.Наименование КАК ИмяГруппыПараметров) КАК ПараметрыЭлементаСправочника,
				   |	ВЫРАЗИТЬ(ЭлементныеСвязи.ЭлементСсылка КАК Справочник.aps_ЭлементыТехнологии).Параметры.(Параметр, Параметр.Наименование КАК ИмяПараметра, Параметр.Свойство КАК Свойство, Параметр.Значение КАК Значение, Параметр.ЕдиницаИзмерения КАК ЕдиницаИзмерения, Параметр.Родитель КАК ГруппаПараметров, Параметр.Родитель.Наименование КАК ИмяГруппыПараметров) КАК ПараметрыЭлементаТехнологии";
	КонецЕсли;
	ТекстЗапроса = ТекстЗапроса + "
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ЭлементыСвязей.ЭлементСвязи КАК ЭлементСвязи,
	               |		ЭлементыСвязей.ЭлементСсылка КАК ЭлементСсылка,
	               |		ЭлементыСвязей.РодительСсылка КАК РодительСсылка,
	               |		ЭлементыСвязей.ЭлементСсылка.ОригиналРевизии КАК ОригиналРевизии,
	               |		ЭлементыСвязей.ЭлементСсылка.ВидЭлемента КАК ВидЭлемента,
	               |		ВЫБОР
	               |			КОГДА ЭлементыСвязей.ЭлементСсылка.ИндексКартинки = 0
	               |				ТОГДА ЭлементыСвязей.ЭлементСсылка.ВидЭлемента.ИндексКартинки
	               |			ИНАЧЕ ЭлементыСвязей.ЭлементСсылка.ИндексКартинки
	               |		КОНЕЦ КАК Картинка,
	               |		ЭлементыСвязей.ЭлементСсылка.Наименование КАК ПредставлениеЭлемента,
	               |		ЭлементыСвязей.ЭлементСсылка.UID КАК Владелец,
	               |		ЭлементыСвязей.ЭлементСсылка.GID КАК Группа,
	               |		ЭлементыСвязей.ЭлементСсылка.HTMLКонтент КАК HTMLКонтент,
	               |		ЭлементыСвязей.ЭлементСсылка.ВидЭлемента.Код КАК КодВидаЭлемента,
	               |		ЭлементыСвязей.ЭлементСвязи.ПорядокВывода КАК ПорядокВывода,
	               |		ВЫБОР
	               |			КОГДА ЭлементыСвязей.ВидСвязи.Автоупорядочивание
	               |				ТОГДА 0
	               |			ИНАЧЕ ЭлементыСвязей.ЭлементСвязи.ПорядокВывода
	               |		КОНЕЦ КАК Порядок,
	               |		ВЫБОР
	               |			КОГДА ЭлементыСвязей.ВидСвязи ССЫЛКА Перечисление.aps_ВидыСвязей
	               |				ТОГДА 0
	               |			ИНАЧЕ 1
	               |		КОНЕЦ КАК ПорядокСвязи,
	               |		ЭлементыСвязей.ВидСвязи КАК ВидСвязи,
	               |		ЭлементыСвязей.ВидСвязи.Код КАК КодВидаСвязи,
	               |		ЭлементыСвязей.ОбратнаяСвязь КАК ОбратнаяСвязь,
	               |		ВЫБОР
	               |			КОГДА ЭлементыСвязей.ОбратнаяСвязь
	               |				ТОГДА ЭлементыСвязей.ВидСвязи.ИндексКартинкиОбратнойСвязи
	               |			ИНАЧЕ ЭлементыСвязей.ВидСвязи.ИндексКартинки
	               |		КОНЕЦ КАК КартинкаСвязи,
	               |		ВЫБОР
	               |			КОГДА ЭлементыСвязей.ОбратнаяСвязь
	               |				ТОГДА ЭлементыСвязей.ВидСвязи.НаименованиеОбратнойСвязи
	               |			ИНАЧЕ ЭлементыСвязей.ВидСвязи.Наименование
	               |		КОНЕЦ КАК ПредставлениеСвязи
	               |	ИЗ
				   |		(ВЫБРАТЬ
				   |			aps_ЭлементыСвязей.Ссылка КАК ЭлементСвязи,
				   |			aps_ЭлементыСвязей.ПотомокСсылка КАК ЭлементСсылка,
				   |			aps_ЭлементыСвязей.РодительСсылка КАК РодительСсылка,
				   |			aps_ЭлементыСвязей.ВидСвязи КАК ВидСвязи,
				   |			ЛОЖЬ КАК ОбратнаяСвязь
				   |		ИЗ
				   |			ВТСсылки
				   |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.aps_ЭлементыСвязей КАК aps_ЭлементыСвязей ПО
				   |			ВТСсылки.Ссылка = aps_ЭлементыСвязей.РодительСсылка
				   |			И (НЕ aps_ЭлементыСвязей.ПометкаУдаления)
				   |
				   |		ОБЪЕДИНИТЬ ВСЕ
				   |
				   |		ВЫБРАТЬ
				   |			aps_ЭлементыСвязей.Ссылка,
				   |			aps_ЭлементыСвязей.РодительСсылка,
				   |			aps_ЭлементыСвязей.ПотомокСсылка,
				   |			aps_ЭлементыСвязей.ВидСвязи,
				   |			ИСТИНА
				   |		ИЗ
				   |			ВТСсылки
				   |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.aps_ЭлементыСвязей КАК aps_ЭлементыСвязей ПО
				   |			ВТСсылки.Ссылка = aps_ЭлементыСвязей.ПотомокСсылка
				   |			И (НЕ aps_ЭлементыСвязей.ПометкаУдаления)
				   |			И aps_ЭлементыСвязей.ВидСвязи.ДвунаправленнаяСвязь
				   |			И НЕ aps_ЭлементыСвязей.РодительСсылка ССЫЛКА Справочник.aps_ЭлементыСвязей) КАК ЭлементыСвязей) КАК ЭлементныеСвязи";
	Если ПравилоУправления <> Неопределено И ПравилоУправления.ВидыЭлементовФильтр.Количество() > 0 Тогда 
		ТекстЗапроса = ТекстЗапроса + "
	               |ГДЕ ЭлементныеСвязи.ВидЭлемента В(&ВидыЭлементов)";
		ЗапросИтератора.УстановитьПараметр("ВидыЭлементов", ПравилоУправления.ВидыЭлементовФильтр.ВыгрузитьКолонку(0));
	КонецЕсли;
	ТекстЗапроса = ТекстЗапроса + "
	               |УПОРЯДОЧИТЬ ПО
	               |	ЭлементныеСвязи.РодительСсылка,
	               |	ЭлементныеСвязи.ПорядокСвязи,
	               |	ЭлементныеСвязи.КодВидаСвязи,
	               |	ЭлементныеСвязи.ВидСвязи,
	               |	ЭлементныеСвязи.ОбратнаяСвязь,
	               |	ЭлементныеСвязи.Порядок,
	               |	ЭлементныеСвязи.КодВидаЭлемента,
	               |	ЭлементныеСвязи.ПредставлениеЭлемента";
				   
	ЗапросИтератора.Текст = ТекстЗапроса;
	РезультатИтератора = ЗапросИтератора.Выполнить().Выгрузить();
	
	Если ПравилоУправления <> Неопределено Тогда 
		
		// Массив элементов для подбора
		МассивЭлементов	= РезультатИтератора.ВыгрузитьКолонку("ОригиналРевизии");
		ПодобранныеРевизииЭлементов	= aps_ПодборРевизийЭлементов(МассивЭлементов, ПравилоУправления);
		
		i = 0;
		Пока i < РезультатИтератора.Количество() Цикл 
			СтрокаРезультата = РезультатИтератора[i];
			
			СтрокаПодобраннойРевизии = ПодобранныеРевизииЭлементов.Найти(СтрокаРезультата.ОригиналРевизии, "ОригиналРевизии");
			// Если ревизия подобрана, заменить оригинальный элемент ревизией
			Если СтрокаПодобраннойРевизии <> Неопределено И СтрокаРезультата.ЭлементСсылка <> СтрокаПодобраннойРевизии.ЭлементСсылка Тогда 
				ЗаполнитьЗначенияСвойств(СтрокаРезультата, СтрокаПодобраннойРевизии);
				СтрокаРезультата.РевизияПодобрана=Истина;
			КонецЕсли;
			
			i = i + 1;
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат РезультатИтератора;
КонецФункции

// Итератор связей состава изделия (устарел)
// 
// Параметры
// 		item - Элемент изделия или технологии, или массив элементов
//		ПравилоУправления - ссылка на элемент справочника ПравилаУправления
//
// Возвращаемое значение:
//		ТаблицаЗначений
//
// Пример:
//		СвязиСостава = aps_СвязиСоставаИзделия(item, ПравилоУправления);
//
Функция aps_СвязиСоставаИзделия( item, Знач ПравилоУправления = Неопределено ) Экспорт 
	РезультатИтератора = aps_ЭлементныеСвязи(item, ПравилоУправления);
	
	i = 0;
	Пока i < РезультатИтератора.Количество() Цикл 
		Если РезультатИтератора[i].ВидСвязи <> Перечисления.aps_ВидыСвязей.СоставИзделия Тогда 
			РезультатИтератора.Удалить(i); Продолжить;
		КонецЕсли;
		i = i + 1;
	КонецЦикла;
	
	Возврат РезультатИтератора;
КонецФункции

// Итератор горизонтальных связей технологии (устарел)
// 
// Параметры
// 		item - Элемент изделия или технологии, или массив элементов
//		ПравилоУправления - ссылка на элемент справочника ПравилаУправления
//
// Возвращаемое значение:
//		ТаблицаЗначений
//
// Пример:
//		ГоризонтальныеСвязи = aps_ГоризонтальныеСвязиТехнологии(item, ПравилоУправления);
//
Функция aps_ГоризонтальныеСвязиТехнологии( item, Знач ПравилоУправления = Неопределено ) Экспорт 
	РезультатИтератора = aps_ЭлементныеСвязи(item, ПравилоУправления);
	
	i = 0;
	Пока i < РезультатИтератора.Количество() Цикл 
		Если ТипЗнч(РезультатИтератора[i].ВидСвязи) <> Тип("СправочникСсылка.aps_ШаблоныТехнологическихСвязей") Тогда 
			РезультатИтератора.Удалить(i); Продолжить;
		КонецЕсли;
		i = i + 1;
	КонецЦикла;
	
	Возврат РезультатИтератора;
КонецФункции


// Итератор несвязанных элементов
// 
// Параметры
// 		Пользователь - отбор по владельцу (необязательный)
//		ИгнорироватьРевизии - игнорировать несвязанные ревизии при поиске (необязательный)
//
// Возвращаемое значение:
//		ТаблицаЗначений
//
// Пример:
//		СписокЭлементов = aps_Итераторы.aps_НесвязанныеЭлементы(, Константы.aps_ИгнорироватьНесвязанныеРевизии.Получить()).ВыгрузитьКолонку("ЭлементСсылка");
//
Функция aps_НесвязанныеЭлементы( Пользователь = Неопределено, ИгнорироватьРевизии = Ложь, ЭлементыДляПроверки = Неопределено ) Экспорт 
	Если ЭлементыДляПроверки = Неопределено Тогда 
		ЭлементыДляПроверки = Обработки.aps_Поиск.Создать().aps_Поиск(Новый Структура()).ВыгрузитьКолонку("ЭлементСсылка");
	КонецЕсли;
	
	// применяемость (по связям)
	Применяемость = aps_Применяемость(ЭлементыДляПроверки);
	Применяемость.Колонки.Добавить("Связанный", Новый ОписаниеТипов("Число"));
	Применяемость.ЗаполнитьЗначения(1, "Связанный");
	
	// общие папки
	ОбщиеПапки = aps_ПолучитьОбщиеПапки();
	Для i=0 По ОбщиеПапки.Количество()-1 Цикл 
		Применяемость.Добавить().ПотомокСсылка = ОбщиеПапки[i].ЭлементСсылка;
		Применяемость[Применяемость.Количество()-1].Связанный = 1;
	КонецЦикла;
	
	Для Каждого ЭлементСсылка Из ЭлементыДляПроверки Цикл 
		Применяемость.Добавить().ПотомокСсылка = ЭлементСсылка; // Связанный = 0
	КонецЦикла;
	
	// свернуть с суммированием колонки "Связанный"
	Применяемость.Свернуть("ПотомокСсылка", "Связанный");
	Применяемость = Применяемость.Скопировать(Новый Структура("Связанный", 0));
	
	// другие ссылки (для остальных)
	ТаблицаСсылок = НайтиПоСсылкам(Применяемость.ВыгрузитьКолонку("ПотомокСсылка"));
	МассивПараметровДляПроверки = Новый Массив();
	Для Каждого СтрокаТаблицы Из ТаблицаСсылок Цикл 
		ТипОбъекта = ТипЗнч(СтрокаТаблицы.Данные);
		Если ((Справочники.ТипВсеСсылки().СодержитТип(ТипОбъекта) 
					И (СтрокаТаблицы.Данные.Метаданные().Владельцы.Количество()=0 Или СтрокаТаблицы.Данные.Владелец <> СтрокаТаблицы.Ссылка)
					И ТипОбъекта<>Тип("СправочникСсылка.aps_ВертикальныеСвязи") И ТипОбъекта<>Тип("СправочникСсылка.aps_ЭлементыСвязей"))
				Или Документы.ТипВсеСсылки().СодержитТип(ТипОбъекта)
				Или БизнесПроцессы.ТипВсеСсылки().СодержитТип(ТипОбъекта)
				Или Задачи.ТипВсеСсылки().СодержитТип(ТипОбъекта)) И НЕ СтрокаТаблицы.Данные.ПометкаУдаления Тогда 
			Применяемость.Добавить().ПотомокСсылка = СтрокаТаблицы.Ссылка;
			Применяемость[Применяемость.Количество()-1].Связанный = 1;
		ИначеЕсли (ТипЗнч(СтрокаТаблицы.Данные) = Тип("СправочникСсылка.aps_ПараметрыЭлементовИзделия")
					Или ТипЗнч(СтрокаТаблицы.Данные) = Тип("СправочникСсылка.aps_ПараметрыЭлементовТехнологии")) И НЕ СтрокаТаблицы.Данные.ПометкаУдаления Тогда 
			МассивПараметровДляПроверки.Добавить(СтрокаТаблицы.Данные);
		КонецЕсли;
	КонецЦикла;
	
	Если МассивПараметровДляПроверки.Количество() > 0 Тогда 
		// проверить параметры на связанность
		МассивНесвязанныхПараметров = aps_НесвязанныеПараметры(Неопределено, МассивПараметровДляПроверки);
		Для Каждого ПараметрСсылка Из МассивПараметровДляПроверки Цикл 
			Если МассивНесвязанныхПараметров.Найти(ПараметрСсылка)=Неопределено Тогда 
				// найти элемент в таблице и пометить как связанный
				Применяемость.Добавить().ПотомокСсылка = ПараметрСсылка.Значение;
				Применяемость[Применяемость.Количество()-1].Связанный = 1;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// свернуть с суммированием колонки "Связанный"
	Применяемость.Свернуть("ПотомокСсылка", "Связанный");
	Применяемость = Применяемость.Скопировать(Новый Структура("Связанный", 0));

	
	МассивТипов=Новый Массив;
	МассивТипов.Добавить(Тип("СправочникСсылка.aps_ЭлементыИзделия"));
	МассивТипов.Добавить(Тип("СправочникСсылка.aps_ЭлементыСправочников"));
	МассивТипов.Добавить(Тип("СправочникСсылка.aps_ЭлементыТехнологии"));
	ОписаниеТиповЭлемента=Новый ОписаниеТипов(МассивТипов);

	МенеджерВТ=Новый МенеджерВременныхТаблиц;
	
	ЗапросИтератора=Новый Запрос();
	ЗапросИтератора.МенеджерВременныхТаблиц=МенеджерВТ;
	// Текст запроса для построения временной таблицы
	ЗапросИтератора.Текст="ВЫБРАТЬ
						  |	ТаблицаСсылок.ПотомокСсылка КАК ЭлементСсылка
						  |ПОМЕСТИТЬ ВТСсылки
						  |ИЗ
						  |	&Данные КАК ТаблицаСсылок";
	ЗапросИтератора.УстановитьПараметр("Данные",Применяемость);
	ЗапросИтератора.Выполнить();
	
	ТекстЗапроса="ВЫБРАТЬ
	             |	НесвязанныеЭлементы.ЭлементСсылка КАК ЭлементСсылка,
	             |	НесвязанныеЭлементы.ЭлементСсылка.ВидЭлемента КАК ВидЭлемента,
	             |	НесвязанныеЭлементы.ЭлементСсылка.Наименование КАК ПредставлениеЭлемента,
	             |	ВЫБОР
	             |		КОГДА НесвязанныеЭлементы.ЭлементСсылка.ИндексКартинки = 0
	             |			ТОГДА НесвязанныеЭлементы.ЭлементСсылка.ВидЭлемента.ИндексКартинки
	             |		ИНАЧЕ НесвязанныеЭлементы.ЭлементСсылка.ИндексКартинки
	             |	КОНЕЦ КАК Картинка, *
	             |ИЗ
	             |	(ВЫБРАТЬ РАЗЛИЧНЫЕ * ИЗ ВТСсылки) КАК НесвязанныеЭлементы
	             |ГДЕ
	             |	&УсловиеВладелец
	             |	И &УсловиеОригиналРевизии
	             |
	             |УПОРЯДОЧИТЬ ПО
	             |	НесвязанныеЭлементы.ЭлементСсылка.ВидЭлемента.Код,
	             |	НесвязанныеЭлементы.ЭлементСсылка.Наименование,
	             |	НесвязанныеЭлементы.ЭлементСсылка.Дата УБЫВ";
				 
	Если ИгнорироватьРевизии Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеОригиналРевизии", "ЭлементСсылка.ОригиналРевизии = НЕОПРЕДЕЛЕНО");
	Иначе 
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеОригиналРевизии", "ИСТИНА");
	КонецЕсли;
	
	Если Пользователь <> Неопределено Тогда 
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеВладелец", "ЭлементСсылка.UID = &Пользователь");
		ЗапросИтератора.УстановитьПараметр("Пользователь", Пользователь);
	Иначе 
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеВладелец", "ИСТИНА");
	КонецЕсли;
	
	ЗапросИтератора.Текст = ТекстЗапроса;
	РезультатИтератора = ЗапросИтератора.Выполнить().Выгрузить();
				 
	Возврат РезультатИтератора;
	
КонецФункции

// Итератор несвязанных параметров
// 
// Параметры
//		Пользователь - отбор по владельцу
//		ПараметрыДляПроверки - массив параметров
//
// Возвращаемое значение:
//		ТаблицаЗначений
//
// Пример:
//		НесвязанныеПараметры = aps_Итераторы.aps_НесвязанныеПараметры();
//
Функция aps_НесвязанныеПараметры( Пользователь = Неопределено, ПараметрыДляПроверки = Неопределено ) Экспорт 
	ЗапросИтератора = Новый Запрос();
    ТекстЗапроса = "ВЫБРАТЬ
                   |	НесвязанныеПараметры.Параметр,
                   |	НесвязанныеПараметры.Параметр.Наименование КАК Имя,
                   |	НесвязанныеПараметры.Параметр.Свойство КАК Свойство,
                   |	НесвязанныеПараметры.Параметр.Значение КАК Значение,
                   |	НесвязанныеПараметры.Параметр.ЭтоГруппа КАК ЭтоГруппа,
                   |	ВЫБОР
                   |		КОГДА НесвязанныеПараметры.Параметр.ЭтоГруппа
                   |			ТОГДА 1
                   |		ИНАЧЕ 0
                   |	КОНЕЦ КАК Картинка
                   |ИЗ
                   |	(ВЫБРАТЬ
                   |		НесвязанныеПараметрыГруппировка.Параметр КАК Параметр
                   |	ИЗ
                   |		(ВЫБРАТЬ
                   |			СвязанныеПараметры.Параметр КАК Параметр,
                   |			ИСТИНА КАК Связанный
                   |		ИЗ
                   |			(ВЫБРАТЬ
                   |				aps_ЭлементыИзделияПараметры.Параметр КАК Параметр
                   |			ИЗ
                   |				Справочник.aps_ЭлементыИзделия.Параметры КАК aps_ЭлементыИзделияПараметры
                   |			ГДЕ
                   |				(НЕ aps_ЭлементыИзделияПараметры.Ссылка.ПометкаУдаления)
                   |			
                   |			ОБЪЕДИНИТЬ ВСЕ
                   |			
                   |			ВЫБРАТЬ
                   |				aps_ЭлементыСправочниковПараметры.Параметр
                   |			ИЗ
                   |				Справочник.aps_ЭлементыСправочников.Параметры КАК aps_ЭлементыСправочниковПараметры
                   |			ГДЕ
                   |				(НЕ aps_ЭлементыСправочниковПараметры.Ссылка.ПометкаУдаления)
                   |			
                   |			ОБЪЕДИНИТЬ ВСЕ
                   |			
                   |			ВЫБРАТЬ
                   |				aps_ЭлементыСправочниковПараметрыЭлементовРесурса.Параметр
                   |			ИЗ
                   |				Справочник.aps_ЭлементыСправочников.ПараметрыЭлементовРесурса КАК aps_ЭлементыСправочниковПараметрыЭлементовРесурса
                   |			ГДЕ
                   |				(НЕ aps_ЭлементыСправочниковПараметрыЭлементовРесурса.Ссылка.ПометкаУдаления)
                   |			
                   |			ОБЪЕДИНИТЬ ВСЕ
                   |			
                   |			ВЫБРАТЬ
                   |				aps_ЭлементыТехнологииПараметры.Параметр
                   |			ИЗ
                   |				Справочник.aps_ЭлементыТехнологии.Параметры КАК aps_ЭлементыТехнологииПараметры
                   |			ГДЕ
                   |				(НЕ aps_ЭлементыТехнологииПараметры.Ссылка.ПометкаУдаления)
                   |			
                   |			ОБЪЕДИНИТЬ ВСЕ
                   |			
                   |			ВЫБРАТЬ
                   |				aps_ЭлементыСвязейПараметры.Параметр
                   |			ИЗ
                   |				Справочник.aps_ЭлементыСвязей.Параметры КАК aps_ЭлементыСвязейПараметры
                   |			ГДЕ
                   |				(НЕ aps_ЭлементыСвязейПараметры.Ссылка.ПометкаУдаления)) КАК СвязанныеПараметры
                   |		
                   |		ОБЪЕДИНИТЬ ВСЕ
                   |		
                   |		ВЫБРАТЬ
                   |			СвязанныеГруппыПараметров.Параметр,
                   |			ИСТИНА
                   |		ИЗ
                   |			(ВЫБРАТЬ
                   |				aps_ЭлементыИзделияПараметры.Параметр.Родитель КАК Параметр
                   |			ИЗ
                   |				Справочник.aps_ЭлементыИзделия.Параметры КАК aps_ЭлементыИзделияПараметры
                   |			ГДЕ
                   |				(НЕ aps_ЭлементыИзделияПараметры.Ссылка.ПометкаУдаления)
                   |			
                   |			ОБЪЕДИНИТЬ ВСЕ
                   |			
                   |			ВЫБРАТЬ
                   |				aps_ЭлементыСправочниковПараметры.Параметр.Родитель
                   |			ИЗ
                   |				Справочник.aps_ЭлементыСправочников.Параметры КАК aps_ЭлементыСправочниковПараметры
                   |			ГДЕ
                   |				(НЕ aps_ЭлементыСправочниковПараметры.Ссылка.ПометкаУдаления)
                   |			
                   |			ОБЪЕДИНИТЬ ВСЕ
                   |			
				   |			ВЫБРАТЬ
				   |				aps_ЭлементыСправочниковПараметрыЭлементовРесурса.Параметр.Родитель
				   |			ИЗ
				   |				Справочник.aps_ЭлементыСправочников.ПараметрыЭлементовРесурса КАК aps_ЭлементыСправочниковПараметрыЭлементовРесурса
				   |			ГДЕ
				   |				(НЕ aps_ЭлементыСправочниковПараметрыЭлементовРесурса.Ссылка.ПометкаУдаления)
				   |			
				   |			ОБЪЕДИНИТЬ ВСЕ
                   |			
                   |			ВЫБРАТЬ
                   |				aps_ЭлементыТехнологииПараметры.Параметр.Родитель
                   |			ИЗ
                   |				Справочник.aps_ЭлементыТехнологии.Параметры КАК aps_ЭлементыТехнологииПараметры
                   |			ГДЕ
                   |				(НЕ aps_ЭлементыТехнологииПараметры.Ссылка.ПометкаУдаления)
                   |			
                   |			ОБЪЕДИНИТЬ ВСЕ
                   |			
                   |			ВЫБРАТЬ
                   |				aps_ЭлементыСвязейПараметры.Параметр.Родитель
                   |			ИЗ
                   |				Справочник.aps_ЭлементыСвязей.Параметры КАК aps_ЭлементыСвязейПараметры
                   |			ГДЕ
                   |				(НЕ aps_ЭлементыСвязейПараметры.Ссылка.ПометкаУдаления)) КАК СвязанныеГруппыПараметров
                   |		
                   |		ОБЪЕДИНИТЬ ВСЕ
                   |		
                   |		ВЫБРАТЬ
                   |			aps_ПараметрыЭлементовИзделия.Ссылка,
                   |			ЛОЖЬ
                   |		ИЗ
                   |			Справочник.aps_ПараметрыЭлементовИзделия КАК aps_ПараметрыЭлементовИзделия
                   |		ГДЕ
                   |			(НЕ aps_ПараметрыЭлементовИзделия.ПометкаУдаления)
                   |			И &УсловиеСписокПараметров
                   |		
                   |		ОБЪЕДИНИТЬ ВСЕ
                   |		
                   |		ВЫБРАТЬ
                   |			aps_ПараметрыЭлементовТехнологии.Ссылка,
                   |			ЛОЖЬ
                   |		ИЗ
                   |			Справочник.aps_ПараметрыЭлементовТехнологии КАК aps_ПараметрыЭлементовТехнологии
                   |		ГДЕ
                   |			(НЕ aps_ПараметрыЭлементовТехнологии.ПометкаУдаления)
                   |			И &УсловиеСписокПараметров) КАК НесвязанныеПараметрыГруппировка
                   |	
                   |	СГРУППИРОВАТЬ ПО
                   |		НесвязанныеПараметрыГруппировка.Параметр
                   |	
                   |	ИМЕЮЩИЕ
                   |		МАКСИМУМ(НесвязанныеПараметрыГруппировка.Связанный) = ЛОЖЬ) КАК НесвязанныеПараметры
                   |
                   |УПОРЯДОЧИТЬ ПО
                   |	ЭтоГруппа УБЫВ,
                   |	Имя,
                   |	Свойство";
				   
	Если ПараметрыДляПроверки <> Неопределено Тогда 
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеСписокПараметров", "Ссылка В(&СписокПараметров)");
		ЗапросИтератора.УстановитьПараметр("СписокПараметров", ПараметрыДляПроверки);
	Иначе 
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеСписокПараметров", "ИСТИНА");
	КонецЕсли;
	
	ЗапросИтератора.Текст = ТекстЗапроса;

	РезультатИтератора = ЗапросИтератора.Выполнить().Выгрузить();
	
	Возврат РезультатИтератора;
КонецФункции

// Итератор несвязанных дескрипторов
// 
// Параметры
//		Нет.
//
// Возвращаемое значение:
//		ТаблицаЗначений
//
// Пример:
//		ТаблицаДескрипторов = aps_НесвязанныеДескрипторы();
//
Функция aps_НесвязанныеДескрипторы() Экспорт 
	ЗапросИтератора = Новый Запрос();
	ТекстЗапроса = "ВЫБРАТЬ
	               |	НесвязанныеДескрипторы.Дескриптор,
	               |	НесвязанныеДескрипторы.Дескриптор.Наименование КАК Наименование
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		НесвязанныеДескрипторыГруппировка.Дескриптор КАК Дескриптор
	               |	ИЗ
	               |		(ВЫБРАТЬ
	               |			СвязанныеДескрипторы.Дескриптор КАК Дескриптор,
	               |			ИСТИНА КАК Связанный
	               |		ИЗ
	               |			(ВЫБРАТЬ
	               |				aps_ЭлементыИзделия.MOD КАК Дескриптор
	               |			ИЗ
	               |				Справочник.aps_ЭлементыИзделия КАК aps_ЭлементыИзделия
	               |			ГДЕ
	               |				(НЕ aps_ЭлементыИзделия.ПометкаУдаления)
	               |			
	               |			ОБЪЕДИНИТЬ ВСЕ
	               |			
	               |			ВЫБРАТЬ
	               |				aps_ЭлементыИзделия.GMOD
	               |			ИЗ
	               |				Справочник.aps_ЭлементыИзделия КАК aps_ЭлементыИзделия
	               |			ГДЕ
	               |				(НЕ aps_ЭлементыИзделия.ПометкаУдаления)
	               |			
	               |			ОБЪЕДИНИТЬ ВСЕ
	               |			
	               |			ВЫБРАТЬ
	               |				aps_ЭлементыСправочников.MOD
	               |			ИЗ
	               |				Справочник.aps_ЭлементыСправочников КАК aps_ЭлементыСправочников
	               |			ГДЕ
	               |				(НЕ aps_ЭлементыСправочников.ПометкаУдаления)
	               |			
	               |			ОБЪЕДИНИТЬ ВСЕ
	               |			
	               |			ВЫБРАТЬ
	               |				aps_ЭлементыСправочников.GMOD
	               |			ИЗ
	               |				Справочник.aps_ЭлементыСправочников КАК aps_ЭлементыСправочников
	               |			ГДЕ
	               |				(НЕ aps_ЭлементыСправочников.ПометкаУдаления)
	               |			
	               |			ОБЪЕДИНИТЬ ВСЕ
	               |			
	               |			ВЫБРАТЬ
	               |				aps_ЭлементыТехнологии.MOD
	               |			ИЗ
	               |				Справочник.aps_ЭлементыТехнологии КАК aps_ЭлементыТехнологии
	               |			ГДЕ
	               |				(НЕ aps_ЭлементыТехнологии.ПометкаУдаления)
	               |			
	               |			ОБЪЕДИНИТЬ ВСЕ
	               |			
	               |			ВЫБРАТЬ
	               |				aps_ЭлементыТехнологии.GMOD
	               |			ИЗ
	               |				Справочник.aps_ЭлементыТехнологии КАК aps_ЭлементыТехнологии
	               |			ГДЕ
	               |				(НЕ aps_ЭлементыТехнологии.ПометкаУдаления)
	               |			
	               |			ОБЪЕДИНИТЬ ВСЕ
	               |			
	               |			ВЫБРАТЬ
	               |				aps_ЭлементыСвязей.MOD
	               |			ИЗ
	               |				Справочник.aps_ЭлементыСвязей КАК aps_ЭлементыСвязей
	               |			ГДЕ
	               |				(НЕ aps_ЭлементыСвязей.ПометкаУдаления)
	               |			
	               |			ОБЪЕДИНИТЬ ВСЕ
	               |			
	               |			ВЫБРАТЬ
	               |				aps_ЭлементыСвязей.GMOD
	               |			ИЗ
	               |				Справочник.aps_ЭлементыСвязей КАК aps_ЭлементыСвязей
	               |			ГДЕ
	               |				(НЕ aps_ЭлементыСвязей.ПометкаУдаления)
	               |			
	               |			ОБЪЕДИНИТЬ ВСЕ
	               |			
	               |			ВЫБРАТЬ
	               |				aps_ПараметрыЭлементовИзделия.MOD
	               |			ИЗ
	               |				Справочник.aps_ПараметрыЭлементовИзделия КАК aps_ПараметрыЭлементовИзделия
	               |			ГДЕ
	               |				(НЕ aps_ПараметрыЭлементовИзделия.ПометкаУдаления)
	               |			
	               |			ОБЪЕДИНИТЬ ВСЕ
	               |			
	               |			ВЫБРАТЬ
	               |				aps_ПараметрыЭлементовИзделия.GMOD
	               |			ИЗ
	               |				Справочник.aps_ПараметрыЭлементовИзделия КАК aps_ПараметрыЭлементовИзделия
	               |			ГДЕ
	               |				(НЕ aps_ПараметрыЭлементовИзделия.ПометкаУдаления)
	               |			
	               |			ОБЪЕДИНИТЬ ВСЕ
	               |			
	               |			ВЫБРАТЬ
	               |				aps_ПараметрыЭлементовТехнологии.MOD
	               |			ИЗ
	               |				Справочник.aps_ПараметрыЭлементовТехнологии КАК aps_ПараметрыЭлементовТехнологии
	               |			ГДЕ
	               |				(НЕ aps_ПараметрыЭлементовТехнологии.ПометкаУдаления)
	               |			
	               |			ОБЪЕДИНИТЬ ВСЕ
	               |			
	               |			ВЫБРАТЬ
	               |				aps_ПараметрыЭлементовТехнологии.GMOD
	               |			ИЗ
	               |				Справочник.aps_ПараметрыЭлементовТехнологии КАК aps_ПараметрыЭлементовТехнологии
	               |			ГДЕ
	               |				(НЕ aps_ПараметрыЭлементовТехнологии.ПометкаУдаления)) КАК СвязанныеДескрипторы
	               |		
	               |		ОБЪЕДИНИТЬ ВСЕ
	               |		
	               |		ВЫБРАТЬ
	               |			aps_ДескрипторыДоступа.Ссылка,
	               |			ЛОЖЬ
	               |		ИЗ
	               |			Справочник.aps_ДескрипторыДоступа КАК aps_ДескрипторыДоступа
	               |		ГДЕ
	               |			(НЕ aps_ДескрипторыДоступа.ПометкаУдаления)
	               |			И (НЕ aps_ДескрипторыДоступа.ЭтоГруппа)
	               |			И (НЕ aps_ДескрипторыДоступа.Предопределенный)) КАК НесвязанныеДескрипторыГруппировка
	               |	
	               |	СГРУППИРОВАТЬ ПО
	               |		НесвязанныеДескрипторыГруппировка.Дескриптор
	               |	
	               |	ИМЕЮЩИЕ
	               |		МАКСИМУМ(НесвязанныеДескрипторыГруппировка.Связанный) = ЛОЖЬ) КАК НесвязанныеДескрипторы";
				   
	ЗапросИтератора.Текст = ТекстЗапроса;
	РезультатИтератора = ЗапросИтератора.Выполнить().Выгрузить();
	
	Возврат РезультатИтератора;
КонецФункции

// Итератор несвязанных xdto-моделей
// 
// Параметры
//		Нет.
//
// Возвращаемое значение:
//		ТаблицаЗначений
//
// Пример:
//		ТаблицаМоделейXDTO = aps_НесвязанныеМоделиXDTO();
//
Функция aps_НесвязанныеМоделиXDTO() Экспорт 
	ЗапросИтератора = Новый Запрос();
	ТекстЗапроса = "ВЫБРАТЬ
	               |	НесвязанныеМодели.ХранилищеМодели,
	               |	НесвязанныеМодели.ХранилищеМодели.Пользователь КАК Пользователь
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		НесвязанныеМоделиГруппировка.ХранилищеМодели КАК ХранилищеМодели
	               |	ИЗ
	               |		(ВЫБРАТЬ
	               |			СвязанныеМодели.ХранилищеМодели КАК ХранилищеМодели,
	               |			ИСТИНА КАК Связанный
	               |		ИЗ
	               |			(ВЫБРАТЬ
	               |				МоделиИзвещения.ХранилищеМодели КАК ХранилищеМодели
	               |			ИЗ
	               |				Документ.aps_ИзвещениеОбИзменении.ПользовательскиеИзменения КАК МоделиИзвещения
	               |			ГДЕ
	               |				НЕ МоделиИзвещения.Ссылка.ПометкаУдаления
	               |			
	               |			ОБЪЕДИНИТЬ ВСЕ
	               |			
	               |			ВЫБРАТЬ
	               |				МоделиИзвещения.ХранилищеМоделиДляОтменыИзменений
	               |			ИЗ
	               |				Документ.aps_ИзвещениеОбИзменении.ПользовательскиеИзменения КАК МоделиИзвещения
	               |			ГДЕ
	               |				НЕ МоделиИзвещения.Ссылка.ПометкаУдаления
	               |			
	               |			ОБЪЕДИНИТЬ ВСЕ
	               |			
	               |			ВЫБРАТЬ
	               |				МоделиРабочегоСтола.Ссылка
	               |			ИЗ
	               |				Справочник.aps_ХранилищеМоделейXDTO КАК МоделиРабочегоСтола
	               |			ГДЕ
	               |				НЕ МоделиРабочегоСтола.ПометкаУдаления
	               |				И МоделиРабочегоСтола.ВидМодели = ЗНАЧЕНИЕ(Перечисление.aps_ВидыСериализованныхМоделей.МодельРабочегоСтола)
	               |				И НЕ МоделиРабочегоСтола.Пользователь.ПометкаУдаления) КАК СвязанныеМодели
	               |		
	               |		ОБЪЕДИНИТЬ ВСЕ
	               |		
	               |		ВЫБРАТЬ
	               |			aps_ХранилищеМоделейXDTO.Ссылка,
	               |			ЛОЖЬ
	               |		ИЗ
	               |			Справочник.aps_ХранилищеМоделейXDTO КАК aps_ХранилищеМоделейXDTO
	               |		ГДЕ
	               |			НЕ aps_ХранилищеМоделейXDTO.ПометкаУдаления) КАК НесвязанныеМоделиГруппировка
	               |	
	               |	СГРУППИРОВАТЬ ПО
	               |		НесвязанныеМоделиГруппировка.ХранилищеМодели
	               |	
	               |	ИМЕЮЩИЕ
	               |		МАКСИМУМ(НесвязанныеМоделиГруппировка.Связанный) = ЛОЖЬ) КАК НесвязанныеМодели";
				   
	ЗапросИтератора.Текст = ТекстЗапроса;
	РезультатИтератора = ЗапросИтератора.Выполнить().Выгрузить();
	
	Возврат РезультатИтератора;
КонецФункции

// Итератор применяемости параметров
// 
// Параметры
// 		Параметр - ссылка на параметр
//
// Возвращаемое значение:
//		ТаблицаЗначений
//
// Пример:
//		Применяемость = aps_Итераторы.aps_ПрименяемостьПараметра( item );
//
Функция aps_ПрименяемостьПараметра( Параметр ) Экспорт
	
	Запрос=Новый Запрос("ВЫБРАТЬ
	                    |	Применяемость.ЭлементСсылка,
	                    |	ВЫБОР
	                    |		КОГДА Применяемость.ЭлементСсылка.ИндексКартинки = 0
	                    |			ТОГДА Применяемость.ЭлементСсылка.ВидЭлемента.ИндексКартинки
	                    |		ИНАЧЕ Применяемость.ЭлементСсылка.ИндексКартинки
	                    |	КОНЕЦ КАК Картинка
	                    |ИЗ
	                    |	(ВЫБРАТЬ
	                    |		aps_ЭлементыИзделияПараметры.Ссылка КАК ЭлементСсылка
	                    |	ИЗ
	                    |		Справочник.aps_ЭлементыИзделия.Параметры КАК aps_ЭлементыИзделияПараметры
	                    |	ГДЕ
	                    |		aps_ЭлементыИзделияПараметры.Параметр = &Параметр
	                    |		И НЕ aps_ЭлементыИзделияПараметры.Ссылка.ПометкаУдаления
	                    |	
	                    |	ОБЪЕДИНИТЬ ВСЕ
	                    |	
	                    |	ВЫБРАТЬ
	                    |		aps_ЭлементыТехнологииПараметры.Ссылка
	                    |	ИЗ
	                    |		Справочник.aps_ЭлементыТехнологии.Параметры КАК aps_ЭлементыТехнологииПараметры
	                    |	ГДЕ
	                    |		aps_ЭлементыТехнологииПараметры.Параметр = &Параметр
	                    |		И НЕ aps_ЭлементыТехнологииПараметры.Ссылка.ПометкаУдаления
	                    |	
	                    |	ОБЪЕДИНИТЬ ВСЕ
	                    |	
	                    |	ВЫБРАТЬ
	                    |		aps_ЭлементыСправочниковПараметры.Ссылка
	                    |	ИЗ
	                    |		Справочник.aps_ЭлементыСправочников.Параметры КАК aps_ЭлементыСправочниковПараметры
	                    |	ГДЕ
	                    |		aps_ЭлементыСправочниковПараметры.Параметр = &Параметр
	                    |		И НЕ aps_ЭлементыСправочниковПараметры.Ссылка.ПометкаУдаления
	                    |	
	                    |	ОБЪЕДИНИТЬ ВСЕ
	                    |	
	                    |	ВЫБРАТЬ
	                    |		aps_ЭлементыСправочниковПараметры.Ссылка
	                    |	ИЗ
	                    |		Справочник.aps_ЭлементыСправочников.ПараметрыЭлементовРесурса КАК aps_ЭлементыСправочниковПараметры
	                    |	ГДЕ
	                    |		aps_ЭлементыСправочниковПараметры.Параметр = &Параметр
	                    |		И НЕ aps_ЭлементыСправочниковПараметры.Ссылка.ПометкаУдаления) КАК Применяемость");
						
	Запрос.УстановитьПараметр("Параметр",Параметр);
						
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции
  
// Итератор применяемости элементов по связям
// 
// Параметры
// 		item - Элемент изделия или технологии
//		ПравилоУправления - ссылка на элемент справочника ПравилаУправления
//		ВидСвязи - ПеречислениеСсылка.aps_ВидыСвязей, СправочникСсылка.aps_ШаблоныТехнологическихСвязей
//
// Возвращаемое значение:
//		ТаблицаЗначений
//
// Пример:
//		ПрименяемостьАктДокумента=aps_Итераторы.aps_Применяемость(АктивныйДокумент,, Перечисления.aps_ВидыСвязей.СоставИзделия);
//
Функция aps_Применяемость( item, ПравилоУправления = Неопределено, ВидСвязи = Неопределено ) Экспорт 
	Если ТипЗнч(ПравилоУправления) = Тип("Строка") Тогда	// передается строка XML
		ПравилоУправления = Строка2Object1С(ПравилоУправления);
	КонецЕсли;
	
	МассивТипов=Новый Массив;
	МассивТипов.Добавить(Тип("СправочникСсылка.aps_ЭлементыИзделия"));
	МассивТипов.Добавить(Тип("СправочникСсылка.aps_ЭлементыСправочников"));
	МассивТипов.Добавить(Тип("СправочникСсылка.aps_ЭлементыТехнологии"));
	ОписаниеТиповЭлемента=Новый ОписаниеТипов(МассивТипов);
	
	СуществующиеСсылки=Новый ТаблицаЗначений();
	СуществующиеСсылки.Колонки.Добавить("Ссылка", ОписаниеТиповЭлемента);
	Если ТипЗнч(item) = Тип("Массив") Тогда 
		Для i=0 По item.Количество()-1 Цикл 
			СуществующиеСсылки.Добавить().Ссылка = item[i];
		КонецЦикла;
	Иначе
		СуществующиеСсылки.Добавить().Ссылка = item;
	КонецЕсли;
	СуществующиеСсылки.Свернуть("Ссылка");
	
	МенеджерВТ=Новый МенеджерВременныхТаблиц;
	
	ЗапросИтератора=Новый Запрос();
	ЗапросИтератора.МенеджерВременныхТаблиц=МенеджерВТ;
	// Текст запроса для построения временной таблицы
	ЗапросИтератора.Текст="ВЫБРАТЬ
	                      |	ТаблицаСсылок.Ссылка КАК Ссылка
	                      |ПОМЕСТИТЬ ВТСсылки
	                      |ИЗ
	                      |	&Данные КАК ТаблицаСсылок";
	ЗапросИтератора.УстановитьПараметр("Данные",СуществующиеСсылки);
	ЗапросИтератора.Выполнить();
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	Применяемость.ЭлементСсылка КАК ЭлементСсылка,
	               |	ВЫБОР
	               |		КОГДА Применяемость.ЭлементСсылка.ИндексКартинки = 0
	               |			ТОГДА Применяемость.ЭлементСсылка.ВидЭлемента.ИндексКартинки
	               |		ИНАЧЕ Применяемость.ЭлементСсылка.ИндексКартинки
	               |	КОНЕЦ КАК Картинка,
	               |	Применяемость.ЭлементСсылка.Наименование КАК ПредставлениеЭлемента,
	               |	Применяемость.ПотомокСсылка КАК ПотомокСсылка,
	               |	Применяемость.ВидСвязи КАК ВидСвязи,
	               |	Применяемость.ПредставлениеСвязи КАК ПредставлениеСвязи,
	               |	Применяемость.ОбратнаяСвязь КАК ОбратнаяСвязь
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ВертикальныеСвязи.РодительСсылка КАК ЭлементСсылка,
	               |		ВертикальныеСвязи.ПотомокСсылка КАК ПотомокСсылка,
	               |		ВертикальныеСвязи.ВидСвязи КАК ВидСвязи,
	               |		ПРЕДСТАВЛЕНИЕ(ВертикальныеСвязи.ВидСвязи) КАК ПредставлениеСвязи,
	               |		ЛОЖЬ КАК ОбратнаяСвязь
	               |	ИЗ
	               |		Справочник.aps_ВертикальныеСвязи КАК ВертикальныеСвязи
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТСсылки КАК ВТСсылки
	               |			ПО (ВТСсылки.Ссылка = ВертикальныеСвязи.ПотомокСсылка)
	               |				И (НЕ ВертикальныеСвязи.ПометкаУдаления)
	               |	
	               |	ОБЪЕДИНИТЬ
	               |	
	               |	ВЫБРАТЬ
	               |		ВЫБОР
	               |			КОГДА ЭлементыСвязей.РодительСсылка ССЫЛКА Справочник.aps_ЭлементыСвязей
	               |				ТОГДА ЭлементыСвязей.РодительСсылка.ПотомокСсылка
	               |			ИНАЧЕ ЭлементыСвязей.РодительСсылка
	               |		КОНЕЦ,
	               |		ЭлементыСвязей.ПотомокСсылка,
	               |		ЭлементыСвязей.ВидСвязи,
	               |		ВЫБОР
	               |			КОГДА ЭлементыСвязей.ВидСвязи ССЫЛКА Перечисление.aps_ВидыСвязей
	               |				ТОГДА ПРЕДСТАВЛЕНИЕ(ЭлементыСвязей.ВидСвязи)
	               |			ИНАЧЕ ЭлементыСвязей.ВидСвязи.Наименование
	               |		КОНЕЦ,
	               |		ЛОЖЬ
	               |	ИЗ
	               |		Справочник.aps_ЭлементыСвязей КАК ЭлементыСвязей
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТСсылки КАК ВТСсылки
	               |			ПО (ВТСсылки.Ссылка = ЭлементыСвязей.ПотомокСсылка)
	               |				И (НЕ ЭлементыСвязей.ПометкаУдаления)
	               |	
	               |	ОБЪЕДИНИТЬ
	               |	
	               |	ВЫБРАТЬ
	               |		ЭлементыСвязей.ПотомокСсылка,
	               |		ЭлементыСвязей.РодительСсылка,
	               |		ЭлементыСвязей.ВидСвязи,
	               |		ЭлементыСвязей.ВидСвязи.НаименованиеОбратнойСвязи,
	               |		ИСТИНА
	               |	ИЗ
	               |		Справочник.aps_ЭлементыСвязей КАК ЭлементыСвязей
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТСсылки КАК ВТСсылки
	               |			ПО (ВТСсылки.Ссылка = ЭлементыСвязей.РодительСсылка)
	               |				И (НЕ ЭлементыСвязей.ПометкаУдаления)
	               |				И (ЭлементыСвязей.ВидСвязи.ДвунаправленнаяСвязь)
	               |	
	               |	ОБЪЕДИНИТЬ
	               |	
	               |	ВЫБРАТЬ
	               |		ЭлементыРесурса.Ссылка,
	               |		ЭлементыРесурса.ЭлементСсылка,
	               |		ЭлементыРесурса.ВидСвязи,
	               |		ЭлементыРесурса.ВидСвязи.Наименование,
	               |		ЛОЖЬ
	               |	ИЗ
	               |		Справочник.aps_ЭлементыСправочников.ЭлементыРесурса КАК ЭлементыРесурса
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТСсылки КАК ВТСсылки
	               |			ПО (ВТСсылки.Ссылка = ЭлементыРесурса.ЭлементСсылка)
	               |				И (НЕ ЭлементыРесурса.Ссылка.ПометкаУдаления)
	               |	
	               |	ОБЪЕДИНИТЬ
	               |	
	               |	ВЫБРАТЬ
	               |		ПодчиненныеЭлементыТехнологии.Ссылка,
	               |		ПодчиненныеЭлементыТехнологии.ЭлементСсылка,
	               |		ПодчиненныеЭлементыТехнологии.ВидСвязи,
	               |		ПодчиненныеЭлементыТехнологии.ВидСвязи.Наименование,
	               |		ЛОЖЬ
	               |	ИЗ
	               |		Справочник.aps_ЭлементыТехнологии.ПодчиненныеЭлементыТехнологии КАК ПодчиненныеЭлементыТехнологии
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТСсылки КАК ВТСсылки
	               |			ПО (ВТСсылки.Ссылка = ПодчиненныеЭлементыТехнологии.ЭлементСсылка)
	               |				И (НЕ ПодчиненныеЭлементыТехнологии.Ссылка.ПометкаУдаления)) КАК Применяемость";
	Если ПравилоУправления <> Неопределено И ПравилоУправления.ВидыЭлементовФильтр.Количество() > 0 Тогда 
		ТекстЗапроса = ТекстЗапроса + "
	               |ГДЕ Применяемость.ЭлементСсылка.ВидЭлемента В(&ВидыЭлементов)";
		ЗапросИтератора.УстановитьПараметр("ВидыЭлементов", ПравилоУправления.ВидыЭлементовФильтр.ВыгрузитьКолонку(0));
	КонецЕсли;
	Если ВидСвязи <> Неопределено Тогда 
		ТекстЗапроса = ТекстЗапроса + "
	               |ГДЕ Применяемость.ВидСвязи В(&ВидСвязи)";
		ЗапросИтератора.УстановитьПараметр("ВидСвязи", ВидСвязи);
	КонецЕсли;
	ТекстЗапроса = ТекстЗапроса + "
	               |УПОРЯДОЧИТЬ ПО
	               |	Применяемость.ЭлементСсылка.ВидЭлемента.Код,
	               |	Применяемость.ЭлементСсылка.Наименование";
								   
	ЗапросИтератора.Текст = ТекстЗапроса;			   
	РезультатИтератора = ЗапросИтератора.Выполнить().Выгрузить();
	
	Возврат РезультатИтератора;
КонецФункции


// Итератор редактируемых элементов
// Параметры:
//		Нет
// Возвращаемое значение:
//		ТаблицаЗначений
// Пример:
//		ТаблицаРедактируемых = aps_РедактируемыеЭлементы();
//
Функция aps_РедактируемыеЭлементы() Экспорт
	
	ЗапросИтератора = Новый Запрос;
    ТекстЗапроса = "ВЫБРАТЬ
                   |	РедактируемыеЭлементы.ЭлементСсылка КАК ЭлементСсылка,
	               |	ВЫБОР
	               |		КОГДА РедактируемыеЭлементы.ЭлементСсылка.ИндексКартинки = 0
	               |			ТОГДА РедактируемыеЭлементы.ЭлементСсылка.ВидЭлемента.ИндексКартинки
	               |		ИНАЧЕ РедактируемыеЭлементы.ЭлементСсылка.ИндексКартинки
	               |	КОНЕЦ КАК Картинка,
                   |	РедактируемыеЭлементы.ЭлементСсылка.РедактирующийПользователь КАК РедактирующийПользователь
                   |ИЗ
                   |	(ВЫБРАТЬ
                   |		ЭлементыИзделия.Ссылка КАК ЭлементСсылка
                   |	ИЗ
                   |		Справочник.aps_ЭлементыИзделия КАК ЭлементыИзделия
                   |	ГДЕ
                   |		(НЕ ЭлементыИзделия.ПометкаУдаления)
                   |		И ЭлементыИзделия.РедактирующийПользователь <> ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
                   |	
                   |	ОБЪЕДИНИТЬ
                   |	
                   |	ВЫБРАТЬ
                   |		ЭлементыСправочников.Ссылка
                   |	ИЗ
                   |		Справочник.aps_ЭлементыСправочников КАК ЭлементыСправочников
                   |	ГДЕ
                   |		(НЕ ЭлементыСправочников.ПометкаУдаления)
                   |		И ЭлементыСправочников.РедактирующийПользователь <> ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)
                   |	
                   |	ОБЪЕДИНИТЬ
                   |	
                   |	ВЫБРАТЬ
                   |		ЭлементыТехнологии.Ссылка
                   |	ИЗ
                   |		Справочник.aps_ЭлементыТехнологии КАК ЭлементыТехнологии
                   |	ГДЕ
                   |		(НЕ ЭлементыТехнологии.Ссылка.ПометкаУдаления)
                   |		И ЭлементыТехнологии.РедактирующийПользователь <> ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)) КАК РедактируемыеЭлементы
                   |
                   |УПОРЯДОЧИТЬ ПО
                   |	РедактируемыеЭлементы.ЭлементСсылка.ВидЭлемента.Код,
                   |	РедактируемыеЭлементы.ЭлементСсылка.Наименование";

	ЗапросИтератора.Текст = ТекстЗапроса;			   
	РезультатИтератора = ЗапросИтератора.Выполнить().Выгрузить();
	
	Возврат РезультатИтератора;
		
КонецФункции
	
// Функция подбирает ревизии для заданного массива элементов в соответствии с правилом управления
//
// Параметры:
//		itemArray - Массив
//		ПравилоУправления - СправочникСсылка.aps_ПравилаУправления
//
// Возвращаемое значение:
//		ТаблицаЗначений
//
// Пример:
//		ПодобранныеРевизииЭлементов = aps_ПодборРевизийЭлементов(МассивЭлементов, ПравилоУправления);
//
Функция aps_ПодборРевизийЭлементов( item, Знач ПравилоУправления ) Экспорт
	
	Если ТипЗнч(ПравилоУправления) = Тип("Строка") Тогда // передается строка XML
		ПравилоУправления = Строка2Object1С(ПравилоУправления);
	КонецЕсли;
	
	ЗапросИтератора = Новый Запрос();
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ПодобранныеРевизии.ЭлементСсылка,
	               |	ПодобранныеРевизии.ЭлементСсылка.Дата КАК Дата,
	               |	ВЫБОР
	               |		КОГДА ПодобранныеРевизии.ЭлементСсылка.ОригиналРевизии = НЕОПРЕДЕЛЕНО
	               |			ТОГДА ПодобранныеРевизии.ЭлементСсылка
	               |		ИНАЧЕ ПодобранныеРевизии.ЭлементСсылка.ОригиналРевизии
	               |	КОНЕЦ КАК ОригиналРевизии,
	               |	ПодобранныеРевизии.ЭлементСсылка.HTMLКонтент КАК HTMLКонтент,
	               |	ПодобранныеРевизии.ЭлементСсылка.ВидЭлемента КАК ВидЭлемента,
	               |	ПодобранныеРевизии.ЭлементСсылка.Наименование КАК ПредставлениеЭлемента,
	               |	ПодобранныеРевизии.ЭлементСсылка.UID КАК Владелец,
	               |	ПодобранныеРевизии.ЭлементСсылка.GID КАК Группа,
	               |	ВЫРАЗИТЬ(ПодобранныеРевизии.ЭлементСсылка КАК Справочник.aps_ЭлементыИзделия).Параметры.(
	               |		Параметр КАК Параметр,
	               |		Параметр.Наименование КАК ИмяПараметра,
	               |		Параметр.Свойство КАК Свойство,
	               |		Параметр.Значение КАК Значение,
	               |		Параметр.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	               |		Параметр.Родитель КАК ГруппаПараметров,
	               |		Параметр.Родитель.Наименование КАК ИмяГруппыПараметров
	               |	) КАК ПараметрыЭлементаИзделия,
	               |	ВЫРАЗИТЬ(ПодобранныеРевизии.ЭлементСсылка КАК Справочник.aps_ЭлементыСправочников).Параметры.(
	               |		Параметр КАК Параметр,
	               |		Параметр.Наименование КАК ИмяПараметра,
	               |		Параметр.Свойство КАК Свойство,
	               |		Параметр.Значение КАК Значение,
	               |		Параметр.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	               |		Параметр.Родитель КАК ГруппаПараметров,
	               |		Параметр.Родитель.Наименование КАК ИмяГруппыПараметров
	               |	) КАК ПараметрыЭлементаСправочника,
	               |	ВЫРАЗИТЬ(ПодобранныеРевизии.ЭлементСсылка КАК Справочник.aps_ЭлементыТехнологии).Параметры.(
	               |		Параметр КАК Параметр,
	               |		Параметр.Наименование КАК ИмяПараметра,
	               |		Параметр.Свойство КАК Свойство,
	               |		Параметр.Значение КАК Значение,
	               |		Параметр.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	               |		Параметр.Родитель КАК ГруппаПараметров,
	               |		Параметр.Родитель.Наименование КАК ИмяГруппыПараметров
	               |	) КАК ПараметрыЭлементаТехнологии,
	               |	ОригиналРевизииГруппировка.КоличествоРевизийСОригиналом КАК КоличествоРевизийСОригиналом
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		УдовлетворяющиеСвойства.ЭлементСсылка КАК ЭлементСсылка,
	               |		МАКСИМУМ(УдовлетворяющиеСвойства.Изменение) КАК Изменение,
	               |		МАКСИМУМ(УдовлетворяющиеСвойства.Исполнение) КАК Исполнение
	               |	ИЗ
	               |		(ВЫБРАТЬ
	               |			ПараметрыРевизии.ЭлементСсылка КАК ЭлементСсылка,
	               |			МАКСИМУМ(ПараметрыРевизии.НомерИзменения) КАК Изменение,
	               |			МАКСИМУМ(ПараметрыРевизии.НомерИсполнения) КАК Исполнение,
	               |			ПараметрыРевизии.ГруппаСвойств КАК ГруппаСвойств,
	               |			ПараметрыРевизии.ГруппаПараметров КАК ГруппаПараметров,
	               |			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ &УдовлетворяющееСвойствоПравила) КАК КоличествоУдовлетворяющихСвойств,
	               |			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ &НеобязательноеСвойствоПравила) КАК КоличествоНеобязательныхСвойств
	               |		ИЗ
	               |			(ВЫБРАТЬ
	               |				aps_ЭлементыИзделияПараметры.Ссылка КАК ЭлементСсылка,
	               |				aps_ЭлементыИзделияПараметры.Параметр.Свойство КАК Свойство,
	               |				aps_ЭлементыИзделияПараметры.Параметр.Значение КАК Значение,
	               |				ВЫБОР
	               |					КОГДА aps_ЭлементыИзделияПараметры.Параметр.Свойство.Родитель.УчитыватьГруппировкуСвойств
	               |						ТОГДА aps_ЭлементыИзделияПараметры.Параметр.Свойство.Родитель
	               |					ИНАЧЕ ""ОБЩАЯ_ГРУППА""
	               |				КОНЕЦ КАК ГруппаСвойств,
	               |				ВЫБОР
	               |					КОГДА aps_ЭлементыИзделияПараметры.Параметр.Свойство.Родитель.УчитыватьГруппировкуСвойств
	               |						ТОГДА aps_ЭлементыИзделияПараметры.Параметр.Родитель
	               |					ИНАЧЕ ""ОБЩАЯ_ГРУППА""
	               |				КОНЕЦ КАК ГруппаПараметров,
	               |				ВЫБОР
	               |					КОГДА aps_ЭлементыИзделияПараметры.Параметр.Свойство = &СвойствоНомерИзменения
	               |						ТОГДА aps_ЭлементыИзделияПараметры.Параметр.Значение
	               |					ИНАЧЕ NULL
	               |				КОНЕЦ КАК НомерИзменения,
	               |				ВЫБОР
	               |					КОГДА aps_ЭлементыИзделияПараметры.Параметр.Свойство = &СвойствоНомерИсполнения
	               |						ТОГДА aps_ЭлементыИзделияПараметры.Параметр.Значение
	               |					ИНАЧЕ NULL
	               |				КОНЕЦ КАК НомерИсполнения
	               |			ИЗ
	               |				Справочник.aps_ЭлементыИзделия.Параметры КАК aps_ЭлементыИзделияПараметры
	               |			ГДЕ
	               |				(aps_ЭлементыИзделияПараметры.Ссылка.ОригиналРевизии В (&ОригинальныеЭлементы)
	               |						ИЛИ aps_ЭлементыИзделияПараметры.Ссылка В (&ОригинальныеЭлементы))
	               |				И (НЕ aps_ЭлементыИзделияПараметры.Ссылка.ПометкаУдаления)
	               |			
	               |			ОБЪЕДИНИТЬ ВСЕ
	               |			
	               |			ВЫБРАТЬ
	               |				aps_ЭлементыСправочниковПараметры.Ссылка,
	               |				aps_ЭлементыСправочниковПараметры.Параметр.Свойство,
	               |				aps_ЭлементыСправочниковПараметры.Параметр.Значение,
	               |				ВЫБОР
	               |					КОГДА aps_ЭлементыСправочниковПараметры.Параметр.Свойство.Родитель.УчитыватьГруппировкуСвойств
	               |						ТОГДА aps_ЭлементыСправочниковПараметры.Параметр.Свойство.Родитель
	               |					ИНАЧЕ ""ОБЩАЯ_ГРУППА""
	               |				КОНЕЦ,
	               |				ВЫБОР
	               |					КОГДА aps_ЭлементыСправочниковПараметры.Параметр.Свойство.Родитель.УчитыватьГруппировкуСвойств
	               |						ТОГДА aps_ЭлементыСправочниковПараметры.Параметр.Родитель
	               |					ИНАЧЕ ""ОБЩАЯ_ГРУППА""
	               |				КОНЕЦ,
	               |				ВЫБОР
	               |					КОГДА aps_ЭлементыСправочниковПараметры.Параметр.Свойство = &СвойствоНомерИзменения
	               |						ТОГДА aps_ЭлементыСправочниковПараметры.Параметр.Значение
	               |					ИНАЧЕ NULL
	               |				КОНЕЦ,
	               |				ВЫБОР
	               |					КОГДА aps_ЭлементыСправочниковПараметры.Параметр.Свойство = &СвойствоНомерИсполнения
	               |						ТОГДА aps_ЭлементыСправочниковПараметры.Параметр.Значение
	               |					ИНАЧЕ NULL
	               |				КОНЕЦ
	               |			ИЗ
	               |				Справочник.aps_ЭлементыСправочников.Параметры КАК aps_ЭлементыСправочниковПараметры
	               |			ГДЕ
	               |				(aps_ЭлементыСправочниковПараметры.Ссылка.ОригиналРевизии В (&ОригинальныеЭлементы)
	               |						ИЛИ aps_ЭлементыСправочниковПараметры.Ссылка В (&ОригинальныеЭлементы))
	               |				И (НЕ aps_ЭлементыСправочниковПараметры.Ссылка.ПометкаУдаления)
	               |			
	               |			ОБЪЕДИНИТЬ ВСЕ
	               |			
	               |			ВЫБРАТЬ
	               |				aps_ЭлементыТехнологииПараметры.Ссылка,
	               |				aps_ЭлементыТехнологииПараметры.Параметр.Свойство,
	               |				aps_ЭлементыТехнологииПараметры.Параметр.Значение,
	               |				ВЫБОР
	               |					КОГДА aps_ЭлементыТехнологииПараметры.Параметр.Свойство.Родитель.УчитыватьГруппировкуСвойств
	               |						ТОГДА aps_ЭлементыТехнологииПараметры.Параметр.Свойство.Родитель
	               |					ИНАЧЕ ""ОБЩАЯ_ГРУППА""
	               |				КОНЕЦ,
	               |				ВЫБОР
	               |					КОГДА aps_ЭлементыТехнологииПараметры.Параметр.Свойство.Родитель.УчитыватьГруппировкуСвойств
	               |						ТОГДА aps_ЭлементыТехнологииПараметры.Параметр.Родитель
	               |					ИНАЧЕ ""ОБЩАЯ_ГРУППА""
	               |				КОНЕЦ,
	               |				ВЫБОР
	               |					КОГДА aps_ЭлементыТехнологииПараметры.Параметр.Свойство = &СвойствоНомерИзменения
	               |						ТОГДА aps_ЭлементыТехнологииПараметры.Параметр.Значение
	               |					ИНАЧЕ NULL
	               |				КОНЕЦ,
	               |				ВЫБОР
	               |					КОГДА aps_ЭлементыТехнологииПараметры.Параметр.Свойство = &СвойствоНомерИсполнения
	               |						ТОГДА aps_ЭлементыТехнологииПараметры.Параметр.Значение
	               |					ИНАЧЕ NULL
	               |				КОНЕЦ
	               |			ИЗ
	               |				Справочник.aps_ЭлементыТехнологии.Параметры КАК aps_ЭлементыТехнологииПараметры
	               |			ГДЕ
	               |				(aps_ЭлементыТехнологииПараметры.Ссылка.ОригиналРевизии В (&ОригинальныеЭлементы)
	               |						ИЛИ aps_ЭлементыТехнологииПараметры.Ссылка В (&ОригинальныеЭлементы))
	               |				И (НЕ aps_ЭлементыТехнологииПараметры.Ссылка.ПометкаУдаления)) КАК ПараметрыРевизии
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			ПараметрыРевизии.ЭлементСсылка,
	               |			ПараметрыРевизии.ГруппаСвойств,
	               |			ПараметрыРевизии.ГруппаПараметров) КАК УдовлетворяющиеСвойства
	               |			ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |				Свойства.ГруппаСвойств КАК ГруппаСвойств,
	               |				КОЛИЧЕСТВО(РАЗЛИЧНЫЕ &СвойствоПравила) КАК КоличествоСвойств,
	               |				КОЛИЧЕСТВО(РАЗЛИЧНЫЕ &НеобязательноеСвойствоПравила) КАК КоличествоНеобязательныхСвойств
	               |			ИЗ
	               |				(ВЫБРАТЬ
	               |					aps_Свойства.Ссылка КАК Свойство,
	               |					ВЫБОР
	               |						КОГДА aps_Свойства.Родитель.УчитыватьГруппировкуСвойств
	               |							ТОГДА aps_Свойства.Родитель
	               |						ИНАЧЕ ""ОБЩАЯ_ГРУППА""
	               |					КОНЕЦ КАК ГруппаСвойств
	               |				ИЗ
	               |					ПланВидовХарактеристик.aps_Свойства КАК aps_Свойства) КАК Свойства
	               |			
	               |			СГРУППИРОВАТЬ ПО
	               |				Свойства.ГруппаСвойств) КАК СвойстваГруппировка
	               |			ПО УдовлетворяющиеСвойства.ГруппаСвойств = СвойстваГруппировка.ГруппаСвойств
	               |	ГДЕ
	               |		УдовлетворяющиеСвойства.КоличествоУдовлетворяющихСвойств + СвойстваГруппировка.КоличествоНеобязательныхСвойств - УдовлетворяющиеСвойства.КоличествоНеобязательныхСвойств >= СвойстваГруппировка.КоличествоСвойств
	               |		И &ПоложительноеКоличествоСвойств
	               |	
	               |	СГРУППИРОВАТЬ ПО
	               |		УдовлетворяющиеСвойства.ЭлементСсылка
	               |	
	               |	ИМЕЮЩИЕ
	               |		КОЛИЧЕСТВО(РАЗЛИЧНЫЕ УдовлетворяющиеСвойства.ГруппаСвойств) >= &КоличествоГруппСвойств) КАК ПодобранныеРевизии
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			ОригиналРевизииГруппировка.ОригиналРевизии КАК ОригиналРевизии,
	               |			КОЛИЧЕСТВО(ОригиналРевизииГруппировка.Ссылка) КАК КоличествоРевизийСОригиналом
	               |		ИЗ
	               |			(ВЫБРАТЬ
	               |				aps_ЭлементыИзделия.Ссылка КАК Ссылка,
	               |				ВЫБОР
	               |					КОГДА aps_ЭлементыИзделия.ОригиналРевизии = НЕОПРЕДЕЛЕНО
	               |						ТОГДА aps_ЭлементыИзделия.Ссылка
	               |					ИНАЧЕ aps_ЭлементыИзделия.ОригиналРевизии
	               |				КОНЕЦ КАК ОригиналРевизии
	               |			ИЗ
	               |				Справочник.aps_ЭлементыИзделия КАК aps_ЭлементыИзделия
	               |			ГДЕ
	               |				НЕ aps_ЭлементыИзделия.ПометкаУдаления
	               |						И (aps_ЭлементыИзделия.ОригиналРевизии В (&ОригинальныеЭлементы)
	               |							ИЛИ aps_ЭлементыИзделия.Ссылка В (&ОригинальныеЭлементы))
	               |			
	               |			ОБЪЕДИНИТЬ ВСЕ
	               |			
	               |			ВЫБРАТЬ
	               |				aps_ЭлементыСправочников.Ссылка,
	               |				ВЫБОР
	               |					КОГДА aps_ЭлементыСправочников.ОригиналРевизии = НЕОПРЕДЕЛЕНО
	               |						ТОГДА aps_ЭлементыСправочников.Ссылка
	               |					ИНАЧЕ aps_ЭлементыСправочников.ОригиналРевизии
	               |				КОНЕЦ
	               |			ИЗ
	               |				Справочник.aps_ЭлементыСправочников КАК aps_ЭлементыСправочников
	               |			ГДЕ
	               |				НЕ aps_ЭлементыСправочников.ПометкаУдаления
	               |						И (aps_ЭлементыСправочников.ОригиналРевизии В (&ОригинальныеЭлементы)
	               |							ИЛИ aps_ЭлементыСправочников.Ссылка В (&ОригинальныеЭлементы))
	               |			
	               |			ОБЪЕДИНИТЬ ВСЕ
	               |			
	               |			ВЫБРАТЬ
	               |				aps_ЭлементыТехнологии.Ссылка,
	               |				ВЫБОР
	               |					КОГДА aps_ЭлементыТехнологии.ОригиналРевизии = НЕОПРЕДЕЛЕНО
	               |						ТОГДА aps_ЭлементыТехнологии.Ссылка
	               |					ИНАЧЕ aps_ЭлементыТехнологии.ОригиналРевизии
	               |				КОНЕЦ
	               |			ИЗ
	               |				Справочник.aps_ЭлементыТехнологии КАК aps_ЭлементыТехнологии
	               |			ГДЕ
	               |				НЕ aps_ЭлементыТехнологии.ПометкаУдаления
	               |						И (aps_ЭлементыТехнологии.ОригиналРевизии В (&ОригинальныеЭлементы)
	               |							ИЛИ aps_ЭлементыТехнологии.Ссылка В (&ОригинальныеЭлементы))) КАК ОригиналРевизииГруппировка
	               |		
	               |		СГРУППИРОВАТЬ ПО
	               |			ОригиналРевизииГруппировка.ОригиналРевизии) КАК ОригиналРевизииГруппировка
	               |		ПО (ПодобранныеРевизии.ЭлементСсылка.ОригиналРевизии = ОригиналРевизииГруппировка.ОригиналРевизии
	               |				ИЛИ ПодобранныеРевизии.ЭлементСсылка = ОригиналРевизииГруппировка.ОригиналРевизии)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ОригиналРевизии";
				   
	тзУсловия = ПравилоУправления.Условия.Выгрузить();
	тзУсловия.Сортировать("Свойство");
	
	МассивСвойств = тзУсловия.ВыгрузитьКолонку("Свойство");	// свойства, на которые накладываются условия
	МассивНеобязательныхСвойств = Новый Массив;				// свойства, которые могут отсутствовать
	
	МассивГруппСвойств = Новый Массив;						// группы свойств, на которые накладываются условия
	
	Если тзУсловия.Количество() > 0 Тогда 
		
		ТекстУсловий = "ВЫБОР КОГДА";
	
		ПредСвойство = Неопределено;
		Для i=0 По тзУсловия.Количество()-1 Цикл 
			Условие = тзУсловия[i];
			
			ЗнакСрав = "";
			Если Условие.ВидСравнения = Перечисления.aps_ВидыСравнения.Больше Тогда 
				ЗнакСрав = ">";
			ИначеЕсли Условие.ВидСравнения = Перечисления.aps_ВидыСравнения.БольшеИлиРавно Тогда 
				ЗнакСрав = ">=";
			ИначеЕсли Условие.ВидСравнения = Перечисления.aps_ВидыСравнения.Меньше Тогда 
				ЗнакСрав = "<";
			ИначеЕсли Условие.ВидСравнения = Перечисления.aps_ВидыСравнения.МеньшеИлиРавно Тогда 
				ЗнакСрав = "<=";
			ИначеЕсли Условие.ВидСравнения = Перечисления.aps_ВидыСравнения.Равно Тогда 
				ЗнакСрав = "=";
			ИначеЕсли Условие.ВидСравнения = Перечисления.aps_ВидыСравнения.НеРавно Тогда 
				ЗнакСрав = "<>";
			Иначе 
				Продолжить;
			КонецЕсли;
			
			Если ПредСвойство <> Условие.Свойство Тогда 
				ТекстУсловий = ТекстУсловий + ?(i=0, "", ") ИЛИ") + "
	               |(Свойство = &Свойство" + Строка(i+1);
			КонецЕсли;	   
			
			ТекстУсловий = ТекстУсловий + " И Значение " + ЗнакСрав + " &Значение" + Строка(i+1);
							
			ЗапросИтератора.УстановитьПараметр("Свойство"+Строка(i+1), Условие.Свойство);
			ЗапросИтератора.УстановитьПараметр("Значение"+Строка(i+1), Условие.Значение);
			
			Если НЕ Условие.ОбязательноНаличиеПараметра И МассивНеобязательныхСвойств.Найти(Условие.Свойство)=Неопределено Тогда 
				МассивНеобязательныхСвойств.Добавить(Условие.Свойство);
			КонецЕсли;
			
			ГруппаСвойств = Условие.Свойство.Родитель;
			ГруппаСвойств = ?(ГруппаСвойств.УчитыватьГруппировкуСвойств, ГруппаСвойств, "ОБЩАЯ_ГРУППА");
			Если МассивГруппСвойств.Найти(ГруппаСвойств)=Неопределено Тогда 
				МассивГруппСвойств.Добавить(ГруппаСвойств);
			КонецЕсли;
			
			// запомнить предыдущее свойство
			ПредСвойство = Условие.Свойство;
		КонецЦикла;
		
		ТекстУсловий = ТекстУсловий + ") ТОГДА Свойство ИНАЧЕ NULL КОНЕЦ";
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УдовлетворяющееСвойствоПравила"	, ТекстУсловий);
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&НеобязательноеСвойствоПравила"	, "ВЫБОР КОГДА Свойство В(&НеобязательныеСвойства) ТОГДА Свойство ИНАЧЕ NULL КОНЕЦ");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СвойствоПравила"					, "ВЫБОР КОГДА Свойство В(&Свойства) ТОГДА Свойство ИНАЧЕ NULL КОНЕЦ");
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПоложительноеКоличествоСвойств"	, "КоличествоСвойств > 0");
		
	Иначе // правило без условий
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УдовлетворяющееСвойствоПравила" 	, "NULL");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&НеобязательноеСвойствоПравила"	, "NULL");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СвойствоПравила"					, "NULL");
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПоложительноеКоличествоСвойств"	, "ИСТИНА");
		
	КонецЕсли;
	
	// приоритет выбора ревизий
	Если ПравилоУправления.ПриоритетВыбораРевизии = Перечисления.aps_ПриоритетыВыбораРевизий.ПерваяПоДате Тогда 
		ТекстЗапроса = ТекстЗапроса + ",
				   |	Дата";
	ИначеЕсли ПравилоУправления.ПриоритетВыбораРевизии = Перечисления.aps_ПриоритетыВыбораРевизий.ПоследняяПоДате Тогда 
		ТекстЗапроса = ТекстЗапроса + ",
				   |	Дата УБЫВ";
	ИначеЕсли ПравилоУправления.ПриоритетВыбораРевизии = Перечисления.aps_ПриоритетыВыбораРевизий.ПерваяПоНомеру Тогда 
		ТекстЗапроса = ТекстЗапроса + ",
				   |	Изменение,
				   |	Исполнение";
	ИначеЕсли ПравилоУправления.ПриоритетВыбораРевизии = Перечисления.aps_ПриоритетыВыбораРевизий.ПоследняяПоНомеру Тогда 
		ТекстЗапроса = ТекстЗапроса + ",
				   |	Изменение УБЫВ,
				   |	Исполнение УБЫВ";
	КонецЕсли;
	
	
	ЗапросИтератора.УстановитьПараметр("КоличествоГруппСвойств"			, МассивГруппСвойств.Количество());
	
	ЗапросИтератора.УстановитьПараметр("Свойства"						, МассивСвойств);
	ЗапросИтератора.УстановитьПараметр("НеобязательныеСвойства"			, МассивНеобязательныхСвойств);
	
	ЗапросИтератора.УстановитьПараметр("ОригинальныеЭлементы"			, item);
	ЗапросИтератора.УстановитьПараметр("СвойствоНомерИзменения"			, ПланыВидовХарактеристик.aps_Свойства.НомерРевизии);
	ЗапросИтератора.УстановитьПараметр("СвойствоНомерИсполнения"		, ПланыВидовХарактеристик.aps_Свойства.НомерИсполнения);
	
	ЗапросИтератора.Текст = ТекстЗапроса;
	Возврат ЗапросИтератора.Выполнить().Выгрузить();

КонецФункции

// Функция проверяет уникальность элемента и возвращает таблицу существующих элементов
// 
// Параметры:
// 		item - Элемент изделия или технологии, или объект, сериализованный в строку
//
// Возвращаемое значение:
//		ТаблицаЗначений
//
// Пример:
//		СуществующиеЭлементы = aps_Итераторы.aps_ПроверкаУникальности(Object1С2Строка(Источник));
//
Функция aps_ПроверкаУникальности( Знач item ) Экспорт 
	
	Если ТипЗнч(item) = Тип("Строка") Тогда // передается строка XML
		item = Строка2Object1С(item);
	КонецЕсли;
	
	Если ПустаяСтрока(item.Наименование) И item.Параметры.Количество()=0 Тогда 
		Возврат Новый ТаблицаЗначений; // элемент без параметров с пустым представлением
	КонецЕсли;
	
	
	Запрос = Новый Запрос();
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ПараметрыИзУникальногоНабора.ЭлементСсылка КАК ЭлементСсылка,
	               |	0 КАК ТипПроверки
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		УдовлетворяющиеПараметры.Ссылка.Наименование КАК Имя,
	               |		УдовлетворяющиеПараметры.Ссылка.Свойство КАК Свойство,
	               |		УдовлетворяющиеПараметры.Ссылка.Значение КАК Значение,
	               |		УдовлетворяющиеПараметры.Ссылка КАК Параметр,
	               |		ПараметрыЭлементов.Ссылка КАК ЭлементСсылка,
	               |		ВЫБОР
	               |			КОГДА ПараметрыЭлементов.Ссылка.ОригиналРевизии = НЕОПРЕДЕЛЕНО
	               |				ТОГДА ПараметрыЭлементов.Ссылка
	               |			ИНАЧЕ ПараметрыЭлементов.Ссылка.ОригиналРевизии
	               |		КОНЕЦ КАК ОригиналРевизии
	               |	ИЗ
	               |		(ВЫБРАТЬ
	               |			aps_ПараметрыЭлементовИзделия.Ссылка КАК Ссылка
	               |		ИЗ
	               |			Справочник.aps_ПараметрыЭлементовИзделия КАК aps_ПараметрыЭлементовИзделия
	               |		ГДЕ
	               |			aps_ПараметрыЭлементовИзделия.Наименование В(&Имена)
	               |			И aps_ПараметрыЭлементовИзделия.Свойство В(&Свойства)
				   |			И aps_ПараметрыЭлементовИзделия.Значение В(&Значения)
	               |		
	               |		ОБЪЕДИНИТЬ ВСЕ
	               |		
	               |		ВЫБРАТЬ
	               |			aps_ПараметрыЭлементовТехнологии.Ссылка
	               |		ИЗ
	               |			Справочник.aps_ПараметрыЭлементовТехнологии КАК aps_ПараметрыЭлементовТехнологии
	               |		ГДЕ
	               |			aps_ПараметрыЭлементовТехнологии.Наименование В(&Имена)
	               |			И aps_ПараметрыЭлементовТехнологии.Свойство В(&Свойства)
				   |			И aps_ПараметрыЭлементовТехнологии.Значение В(&Значения)) КАК УдовлетворяющиеПараметры
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |				aps_ЭлементыИзделияПараметры.Ссылка КАК Ссылка,
	               |				aps_ЭлементыИзделияПараметры.Параметр КАК Параметр
	               |			ИЗ
	               |				Справочник.aps_ЭлементыИзделия.Параметры КАК aps_ЭлементыИзделияПараметры
	               |			ГДЕ
	               |				НЕ aps_ЭлементыИзделияПараметры.Ссылка.ПометкаУдаления
	               |				И aps_ЭлементыИзделияПараметры.Ссылка <> &Элемент
	               |				И &УдовлетворяющийВид
	               |			
	               |			ОБЪЕДИНИТЬ ВСЕ
	               |			
	               |			ВЫБРАТЬ
	               |				aps_ЭлементыСправочниковПараметры.Ссылка,
	               |				aps_ЭлементыСправочниковПараметры.Параметр
	               |			ИЗ
	               |				Справочник.aps_ЭлементыСправочников.Параметры КАК aps_ЭлементыСправочниковПараметры
	               |			ГДЕ
	               |				НЕ aps_ЭлементыСправочниковПараметры.Ссылка.ПометкаУдаления
	               |				И aps_ЭлементыСправочниковПараметры.Ссылка <> &Элемент
	               |				И &УдовлетворяющийВид
	               |			
	               |			ОБЪЕДИНИТЬ ВСЕ
	               |			
	               |			ВЫБРАТЬ
	               |				aps_ЭлементыТехнологииПараметры.Ссылка,
	               |				aps_ЭлементыТехнологииПараметры.Параметр
	               |			ИЗ
	               |				Справочник.aps_ЭлементыТехнологии.Параметры КАК aps_ЭлементыТехнологииПараметры
	               |			ГДЕ
	               |				НЕ aps_ЭлементыТехнологииПараметры.Ссылка.ПометкаУдаления
	               |				И aps_ЭлементыТехнологииПараметры.Ссылка <> &Элемент
	               |				И &УдовлетворяющийВид) КАК ПараметрыЭлементов
	               |			ПО УдовлетворяющиеПараметры.Ссылка = ПараметрыЭлементов.Параметр) КАК ПараметрыИзУникальногоНабора
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ПараметрыИзУникальногоНабора.ЭлементСсылка
	               |
	               |ИМЕЮЩИЕ
	               |	(КОЛИЧЕСТВО(РАЗЛИЧНЫЕ &СовпадающийПараметр) = &КоличествоПараметров
	               |			И КОЛИЧЕСТВО(РАЗЛИЧНЫЕ &НаследованныйПараметр) <> &КоличествоПараметров
	               |		ИЛИ КОЛИЧЕСТВО(РАЗЛИЧНЫЕ &СовпадающийПараметрРевизии) = &КоличествоПараметровРевизии
	               |			И КОЛИЧЕСТВО(РАЗЛИЧНЫЕ &НаследованныйПараметрРевизии) <> &КоличествоПараметровРевизии)";
				   
	НастройкаПроверки=item.ВидЭлемента.НастройкаПроверкиУникальности;
	
	МассивИмен	 	=Новый Массив();
	МассивСвойств	=Новый Массив();
	МассивЗначений	=Новый Массив();
	
	// параметры из уникального набора, которых нет или значения которых не заполнены
	ПустыеПараметры = Новый ТаблицаЗначений();
	ПустыеПараметры.Колонки.Добавить("Имя");
	ПустыеПараметры.Колонки.Добавить("Свойство");
	// параметры из уникального набора, которых нет или значения которых не заполнены
	ПустыеПараметрыРевизии = Новый ТаблицаЗначений();
	ПустыеПараметрыРевизии.Колонки.Добавить("Имя");
	ПустыеПараметрыРевизии.Колонки.Добавить("Свойство");
	
	i=0; // всего условий на параметры
	
	// проверка уникальности набора параметров
	УникальныйНаборПараметров=НастройкаПроверки.УникальныйНаборПараметров.Выгрузить();
	УникальныйНаборПараметров.Свернуть("Имя,Свойство");
	
	УсловиеСовпадающийПараметр="";
	УсловиеНаследованныйПараметр="";
	
	КоличествоЗначащихПараметров=0;
	Для Каждого ЭлементНабора Из УникальныйНаборПараметров Цикл 
		Значение=Неопределено;
		Параметр=Неопределено;
		Для j=0 По item.Параметры.Количество()-1 Цикл 
			Если item.Параметры[j].Параметр.Свойство=ЭлементНабора.Свойство
					И item.Параметры[j].Параметр.Наименование=ЭлементНабора.Имя Тогда 
				Значение=item.Параметры[j].Параметр.Значение;
				Параметр=item.Параметры[j].Параметр;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если ЗначениеЗаполнено(Значение) Тогда 
			УсловиеСовпадающийПараметр=УсловиеСовпадающийПараметр+"
			   |	КОГДА ОригиналРевизии <> &Оригинал И Имя = &Имя"+Строка(i+1)+" И Свойство = &Свойство"+Строка(i+1)+" И Значение = &Значение"+Строка(i+1)+" ТОГДА Параметр";
			УсловиеНаследованныйПараметр=УсловиеНаследованныйПараметр+"
			   |	КОГДА ОригиналРевизии <> &Оригинал И Параметр = &Параметр"+Строка(i+1)+" ТОГДА Параметр";
			Запрос.УстановитьПараметр("Имя"		+Строка(i+1), ЭлементНабора.Имя);
			Запрос.УстановитьПараметр("Свойство"+Строка(i+1), ЭлементНабора.Свойство);
			Запрос.УстановитьПараметр("Значение"+Строка(i+1), Значение);
			Запрос.УстановитьПараметр("Параметр"+Строка(i+1), Параметр);
			
			МассивИмен.Добавить(ЭлементНабора.Имя);
			МассивСвойств.Добавить(ЭлементНабора.Свойство);
			МассивЗначений.Добавить(Значение);
			
			КоличествоЗначащихПараметров=КоличествоЗначащихПараметров+1;
		Иначе 
			ПустойПараметр=ПустыеПараметры.Добавить();
			ПустойПараметр.Имя		=ЭлементНабора.Имя;
			ПустойПараметр.Свойство	=ЭлементНабора.Свойство;
		КонецЕсли;
		
		i=i+1;
	КонецЦикла;
	
	
	// проверка уникальности набора параметров ревизии
	УникальныйНаборПараметровРевизии=НастройкаПроверки.УникальныйНаборПараметровРевизии.Выгрузить();
	УникальныйНаборПараметровРевизии.Свернуть("Имя,Свойство");
	
	УсловиеСовпадающийПараметрРевизии="";
	УсловиеНаследованныйПараметрРевизии="";
	
	КоличествоЗначащихПараметровРевизии=0;
	Для Каждого ЭлементНабора Из УникальныйНаборПараметровРевизии Цикл 
		Значение=Неопределено;
		Параметр=Неопределено;
		Для j=0 По item.Параметры.Количество()-1 Цикл 
			Если item.Параметры[j].Параметр.Свойство=ЭлементНабора.Свойство
					И item.Параметры[j].Параметр.Наименование=ЭлементНабора.Имя Тогда 
				Значение=item.Параметры[j].Параметр.Значение;
				Параметр=item.Параметры[j].Параметр;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если ЗначениеЗаполнено(Значение) Тогда 
			УсловиеСовпадающийПараметрРевизии=УсловиеСовпадающийПараметрРевизии+"
			   |	КОГДА ОригиналРевизии = &Оригинал И Имя = &Имя"+Строка(i+1)+" И Свойство = &Свойство"+Строка(i+1)+" И Значение = &Значение"+Строка(i+1)+" ТОГДА Параметр";
			УсловиеНаследованныйПараметрРевизии=УсловиеНаследованныйПараметрРевизии+"
			   |	КОГДА ОригиналРевизии = &Оригинал И Параметр = &Параметр"+Строка(i+1)+" ТОГДА Параметр";
			Запрос.УстановитьПараметр("Имя"		+Строка(i+1), ЭлементНабора.Имя);
			Запрос.УстановитьПараметр("Свойство"+Строка(i+1), ЭлементНабора.Свойство);
			Запрос.УстановитьПараметр("Значение"+Строка(i+1), Значение);
			Запрос.УстановитьПараметр("Параметр"+Строка(i+1), Параметр);
				
			МассивИмен.Добавить(ЭлементНабора.Имя);
			МассивСвойств.Добавить(ЭлементНабора.Свойство);
			МассивЗначений.Добавить(Значение);
			
			КоличествоЗначащихПараметровРевизии=КоличествоЗначащихПараметровРевизии+1;
		Иначе 
			ПустойПараметр=ПустыеПараметрыРевизии.Добавить();
			ПустойПараметр.Имя		=ЭлементНабора.Имя;
			ПустойПараметр.Свойство	=ЭлементНабора.Свойство;
		КонецЕсли;
		
		i=i+1;
	КонецЦикла;
	
	
	Запрос.УстановитьПараметр("Элемент"						, item.Ссылка); // ссылка на проверяемый элемент
	ЗначениеОригинала = ?(ЗначениеЗаполнено(item.ОригиналРевизии), item.ОригиналРевизии, item.Ссылка);
	Запрос.УстановитьПараметр("Оригинал"					, ЗначениеОригинала);
	
	Запрос.УстановитьПараметр("КоличествоПараметров"		, КоличествоЗначащихПараметров);
	Запрос.УстановитьПараметр("КоличествоПараметровРевизии"	, КоличествоЗначащихПараметровРевизии);
	
	Если КоличествоЗначащихПараметровРевизии=0 Тогда 
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СовпадающийПараметрРевизии"	, "NULL");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&НаследованныйПараметрРевизии", "NULL");
	Иначе 
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СовпадающийПараметрРевизии"	, "ВЫБОР"+УсловиеСовпадающийПараметрРевизии		+" ИНАЧЕ NULL КОНЕЦ");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&НаследованныйПараметрРевизии", "ВЫБОР"+УсловиеНаследованныйПараметрРевизии	+" ИНАЧЕ NULL КОНЕЦ");
	КонецЕсли;
	
	Если КоличествоЗначащихПараметров=0 Тогда 
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СовпадающийПараметр"		, "NULL");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&НаследованныйПараметр"	, "NULL");
	Иначе 
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&СовпадающийПараметр"		, "ВЫБОР"+УсловиеСовпадающийПараметр	+" ИНАЧЕ NULL КОНЕЦ");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&НаследованныйПараметр"	, "ВЫБОР"+УсловиеНаследованныйПараметр	+" ИНАЧЕ NULL КОНЕЦ");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Имена"	, МассивИмен);
	Запрос.УстановитьПараметр("Свойства", МассивСвойств);
	Запрос.УстановитьПараметр("Значения", МассивЗначений);
	
	// проверка уникальности представления
	Если (НастройкаПроверки.ПроверятьУникальностьПредставления Или НастройкаПроверки.ПроверятьУникальностьПредставленияРевизии) И НЕ ПустаяСтрока(item.Наименование) Тогда  
		ТекстЗапроса = ТекстЗапроса + "
	               |ОБЪЕДИНИТЬ
	               |
	               |ВЫБРАТЬ
	               |	Элементы.ЭлементСсылка,
	               |	1 КАК ТипПроверки
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		СправочникЭлементов.Ссылка КАК ЭлементСсылка,
	               |		СправочникЭлементов.Наименование КАК Наименование,
	               |		ВЫБОР
	               |			КОГДА СправочникЭлементов.ОригиналРевизии = НЕОПРЕДЕЛЕНО
	               |				ТОГДА СправочникЭлементов.Ссылка
	               |			ИНАЧЕ СправочникЭлементов.ОригиналРевизии
	               |		КОНЕЦ КАК ОригиналРевизии
	               |	ИЗ
	               |		Справочник.aps_ЭлементыИзделия КАК СправочникЭлементов
	               |	ГДЕ
	               |		(НЕ СправочникЭлементов.ПометкаУдаления)
	               |		И СправочникЭлементов.Ссылка <> &Элемент
	               |		И &УдовлетворяющийВид
	               |	
	               |	ОБЪЕДИНИТЬ ВСЕ
	               |	
	               |	ВЫБРАТЬ
	               |		СправочникЭлементов.Ссылка,
	               |		СправочникЭлементов.Наименование,
	               |		ВЫБОР
	               |			КОГДА СправочникЭлементов.ОригиналРевизии = НЕОПРЕДЕЛЕНО
	               |				ТОГДА СправочникЭлементов.Ссылка
	               |			ИНАЧЕ СправочникЭлементов.ОригиналРевизии
	               |		КОНЕЦ
	               |	ИЗ
	               |		Справочник.aps_ЭлементыСправочников КАК СправочникЭлементов
	               |	ГДЕ
	               |		(НЕ СправочникЭлементов.ПометкаУдаления)
	               |		И СправочникЭлементов.Ссылка <> &Элемент
	               |		И &УдовлетворяющийВид
	               |	
	               |	ОБЪЕДИНИТЬ ВСЕ
	               |	
	               |	ВЫБРАТЬ
	               |		СправочникЭлементов.Ссылка,
	               |		СправочникЭлементов.Наименование,
	               |		ВЫБОР
	               |			КОГДА СправочникЭлементов.ОригиналРевизии = НЕОПРЕДЕЛЕНО
	               |				ТОГДА СправочникЭлементов.Ссылка
	               |			ИНАЧЕ СправочникЭлементов.ОригиналРевизии
	               |		КОНЕЦ
	               |	ИЗ
	               |		Справочник.aps_ЭлементыТехнологии КАК СправочникЭлементов
	               |	ГДЕ
	               |		(НЕ СправочникЭлементов.ПометкаУдаления)
	               |		И СправочникЭлементов.Ссылка <> &Элемент
	               |		И &УдовлетворяющийВид) КАК Элементы
				   |ГДЕ 
				   |	&УдовлетворяющееПредставление";

		УсловиеПредставление			= ?(НастройкаПроверки.ПроверятьУникальностьПредставления		, "(ОригиналРевизии <> &Оригинал И Наименование = &Наименование)"	, "ЛОЖЬ");
		УсловиеПредставлениеРевизии		= ?(НастройкаПроверки.ПроверятьУникальностьПредставленияРевизии	, "(ОригиналРевизии = &Оригинал И Наименование = &Наименование)"	, "ЛОЖЬ");
			
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УдовлетворяющееПредставление", "("+УсловиеПредставление+" ИЛИ "+УсловиеПредставлениеРевизии+")");
		Запрос.УстановитьПараметр("Наименование", item.Наименование);
	КонецЕсли;
	
	// проверка принадлежности вида элемента
	Если НастройкаПроверки.ВидыЭлементовДляПроверки.Количество()>0 Тогда 
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УдовлетворяющийВид", "Ссылка.ВидЭлемента В(&ВидыЭлементов)");
		Запрос.УстановитьПараметр("ВидыЭлементов", НастройкаПроверки.ВидыЭлементовДляПроверки.ВыгрузитьКолонку("ВидЭлемента"));
	Иначе 
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УдовлетворяющийВид", "ИСТИНА");
	КонецЕсли;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	СуществующиеЭлементы.ТипПроверки КАК ТипПроверки,
	               |	СуществующиеЭлементы.ЭлементСсылка КАК ЭлементСсылка,
	               |	СуществующиеЭлементы.ЭлементСсылка.ВидЭлемента КАК ВидЭлемента,
	               |	СуществующиеЭлементы.ЭлементСсылка.Наименование КАК ПредставлениеЭлемента,
	               |	ВЫБОР
	               |		КОГДА СуществующиеЭлементы.ЭлементСсылка.ИндексКартинки = 0
	               |			ТОГДА СуществующиеЭлементы.ЭлементСсылка.ВидЭлемента.ИндексКартинки
	               |		ИНАЧЕ СуществующиеЭлементы.ЭлементСсылка.ИндексКартинки
	               |	КОНЕЦ КАК Картинка,
				   |	ВЫБОР
				   |		КОГДА СуществующиеЭлементы.ЭлементСсылка.ОригиналРевизии = НЕОПРЕДЕЛЕНО
				   |			ТОГДА СуществующиеЭлементы.ЭлементСсылка
				   |		ИНАЧЕ СуществующиеЭлементы.ЭлементСсылка.ОригиналРевизии
				   |	КОНЕЦ КАК ОригиналРевизии,
				   |	ВЫРАЗИТЬ(СуществующиеЭлементы.ЭлементСсылка КАК Справочник.aps_ЭлементыИзделия).Параметры.(Параметр, Параметр.Наименование КАК ИмяПараметра, Параметр.Свойство КАК Свойство, Параметр.Значение КАК Значение, Параметр.ЕдиницаИзмерения КАК ЕдиницаИзмерения, Параметр.Родитель КАК ГруппаПараметров, Параметр.Родитель.Наименование КАК ИмяГруппыПараметров) КАК ПараметрыЭлементаИзделия,
				   |	ВЫРАЗИТЬ(СуществующиеЭлементы.ЭлементСсылка КАК Справочник.aps_ЭлементыСправочников).Параметры.(Параметр, Параметр.Наименование КАК ИмяПараметра, Параметр.Свойство КАК Свойство, Параметр.Значение КАК Значение, Параметр.ЕдиницаИзмерения КАК ЕдиницаИзмерения, Параметр.Родитель КАК ГруппаПараметров, Параметр.Родитель.Наименование КАК ИмяГруппыПараметров) КАК ПараметрыЭлементаСправочника,
				   |	ВЫРАЗИТЬ(СуществующиеЭлементы.ЭлементСсылка КАК Справочник.aps_ЭлементыТехнологии).Параметры.(Параметр, Параметр.Наименование КАК ИмяПараметра, Параметр.Свойство КАК Свойство, Параметр.Значение КАК Значение, Параметр.ЕдиницаИзмерения КАК ЕдиницаИзмерения, Параметр.Родитель КАК ГруппаПараметров, Параметр.Родитель.Наименование КАК ИмяГруппыПараметров) КАК ПараметрыЭлементаТехнологии
				   |ИЗ ("+ТекстЗапроса+") КАК СуществующиеЭлементы";
	РезультатИтератора = Запрос.Выполнить().Выгрузить();
	
	i = 0;
	Пока i < РезультатИтератора.Количество() Цикл 
		ИсточникДанных = РезультатИтератора[i];
		
		// выбрать таблицу параметров элемента
		Если ТипЗнч(ИсточникДанных.ЭлементСсылка)=Тип("СправочникСсылка.aps_ЭлементыИзделия") Тогда 
			Параметры = ИсточникДанных.ПараметрыЭлементаИзделия;
		ИначеЕсли ТипЗнч(ИсточникДанных.ЭлементСсылка)=Тип("СправочникСсылка.aps_ЭлементыСправочников") Тогда 
			Параметры = ИсточникДанных.ПараметрыЭлементаСправочника;
		ИначеЕсли ТипЗнч(ИсточникДанных.ЭлементСсылка)=Тип("СправочникСсылка.aps_ЭлементыТехнологии") Тогда 
			Параметры = ИсточникДанных.ПараметрыЭлементаТехнологии;
		КонецЕсли;
		
		Если ИсточникДанных.ТипПроверки = 0 Тогда // найденный по параметрам элемент
			ФлагУдалитьИзРезультатов=Ложь;
			Если ИсточникДанных.ОригиналРевизии = ЗначениеОригинала Тогда // найденный среди ревизий элемент
				НаборПустыхПараметров = ПустыеПараметрыРевизии;
			Иначе 
				НаборПустыхПараметров = ПустыеПараметры;
			КонецЕсли;
			// проверяем, есть ли другие параметры из уникального набора, значения которых заполнены
			Для Каждого ПустойПараметр Из НаборПустыхПараметров Цикл 
				СтрокиПараметров = Параметры.НайтиСтроки(Новый Структура("ИмяПараметра, Свойство", ПустойПараметр.Имя, ПустойПараметр.Свойство));
				Если СтрокиПараметров.Количество() > 0 И ЗначениеЗаполнено(СтрокиПараметров[0].Значение) Тогда 
					ФлагУдалитьИзРезультатов=Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если ФлагУдалитьИзРезультатов Тогда 
				РезультатИтератора.Удалить(i); Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		i = i + 1;
	КонецЦикла;

	РезультатИтератора.Сортировать("ПредставлениеЭлемента");
	Возврат РезультатИтератора;
	
КонецФункции

#КонецОбласти

#КонецЕсли




