// Функция создает новую папку файлов
// Параметры:
//		Документ - ссылка на документ
//		Родитель - СправочникСсылка.aps_Файлы
//		Имя - Строка
// Возвращаемое значение:
//		СправочникСсылка.aps_Файлы
// Пример:
//		ПапкаФайлов = aps_СоздатьПапку(Документ, Родитель, СтруктураДанныхКаталога.ИмяБезРасширения);
//
Функция aps_СоздатьПапку( Документ, Родитель, Имя = "Новая папка" ) Экспорт 
	НоваяПапка=Справочники.aps_Файлы.СоздатьГруппу();
	НоваяПапка.Владелец		= Документ;
	НоваяПапка.Родитель		= Родитель;
	НоваяПапка.Наименование	= Имя;
	НоваяПапка.Записать();
	
	ОписаниеОшибки="";
	Если НЕ НоваяПапка.ПроверитьИмя(ОписаниеОшибки) Тогда 
		ВызватьИсключение ОписаниеОшибки;
	КонецЕсли;
	
	Возврат НоваяПапка.Ссылка;
КонецФункции
	
// Функция импортирует файлы (каталоги) в базу данных. Выполняется в транзакции
// Параметры:
//		Документ 	- Ссылка на документ
//		Родитель 	- СправочникСсылка.aps_Файлы
//		МассивСтруктурФайлов - Массив
// Пример:
//      aps_РаботаСФайламиСервер.aps_ИмпортФайловИКаталогов(Документ, Родитель, ИмпортируемыеФайлы);
//
Процедура aps_ИмпортФайловИКаталогов( Документ, Родитель, МассивСтруктурФайловИКаталогов, ИскатьСуществующиеПапки = Ложь ) Экспорт 
	
	Попытка
		НачатьТранзакцию();
		
		Для Каждого ДанныеФайлаИлиКаталога Из МассивСтруктурФайловИКаталогов Цикл 
			Если ДанныеФайлаИлиКаталога.Свойство("ФайлыИКаталоги") Тогда 
				aps_ИмпортКаталога( Документ, Родитель, ДанныеФайлаИлиКаталога, ИскатьСуществующиеПапки );
			Иначе 
				aps_ИмпортФайла( Документ, Родитель, ДанныеФайлаИлиКаталога );
			КонецЕсли;
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

// Функция импортирует файл в базу данных
// Параметры:
//		Документ 	- Ссылка на документ
//		Родитель 	- СправочникСсылка.aps_Файлы
//		СтруктураДанныхФайла - Структура
// Возвращаемое значение:
//		СправочникСсылка.aps_Файлы
// Пример:
//		aps_РаботаСФайламиСервер.aps_ИмпортФайла(itemXDTO.element,, СтруктураДанныхФайла, CRC);
//
Функция aps_ИмпортФайла( Документ, Родитель, СтруктураДанныхФайла, CRC=Неопределено ) Экспорт 
	Попытка
		НачатьТранзакцию();
		
			НовыйФайл=Справочники.aps_Файлы.СоздатьЭлемент();
			
			НовыйФайл.Владелец			=Документ;
			НовыйФайл.Родитель			=Родитель;
			НовыйФайл.ИмяФайла			=СтруктураДанныхФайла.ИмяБезРасширения;
			НовыйФайл.Расширение		=СтруктураДанныхФайла.Расширение;
			НовыйФайл.ДатаМодификации	=СтруктураДанныхФайла.ДатаМодификации;
			НовыйФайл.Размер			=СтруктураДанныхФайла.Размер;
			
			ДвДанные = ПолучитьИзВременногоХранилища(СтруктураДанныхФайла.АдресДвоичныхДанных);
			
			СистемнаяИнформация = Новый СистемнаяИнформация();
			ВерсияПлатформы = Лев(СистемнаяИнформация.ВерсияПриложения, 3);
			Если ВерсияПлатформы = "8.3" Тогда
				MD5 = "";
				Выполнить("
				|ХешированиеДанных = Новый ХешированиеДанных(ХешФункция.MD5);
				|ХешированиеДанных.Добавить(ДвДанные);
				|MD5 = НРег(СтрЗаменить(Строка(ХешированиеДанных.ХешСумма), "" "", """"));
				|СуществующиеДвоичныеДанные = Справочники.aps_ДвоичныеДанные.НайтиПоРеквизиту(""MD5"", MD5);");
			ИначеЕсли CRC <> Неопределено Тогда 
				СуществующиеДвоичныеДанные = Справочники.aps_ДвоичныеДанные.НайтиПоРеквизиту("CRC", CRC);
			Иначе 
				СуществующиеДвоичныеДанные = Справочники.aps_ДвоичныеДанные.ПустаяСсылка();
			КонецЕсли;
			
			Если НЕ СуществующиеДвоичныеДанные.Пустая() Тогда
				Если СуществующиеДвоичныеДанные.ПометкаУдаления Тогда
					СуществующиеДвоичныеДанные.ПолучитьОбъект().УстановитьПометкуУдаления(Ложь);
				КонецЕсли;
				
				Если Константы.aps_РежимХраненияФайлов.Получить() = 1 Тогда
					// скопировать файл во внешнее хранилище (с другим именем)
					ПутьКВнешнемуХранилищу = aps_РаботаСФайлами.aps_ДобавитьПоследнийСлэш(Константы.aps_ПутьКВнешнемуХранилищуФайлов.Получить());
					КаталогДвоичныхДанныхВХранилище = ПутьКВнешнемуХранилищу + Строка(СуществующиеДвоичныеДанные.УникальныйИдентификатор());
					ПутьКФайлуВХранилище = КаталогДвоичныхДанныхВХранилище + "\" + НовыйФайл.ИмяФайла + НовыйФайл.Расширение;
					ДвДанные.Записать(ПутьКФайлуВХранилище);
				КонецЕсли;
				
				НовыйФайл.ДвоичныеДанные=СуществующиеДвоичныеДанные;
				
			Иначе // пустая ссылка на двоичные данные
				ДвоичныеДанныеФайла=Справочники.aps_ДвоичныеДанные.СоздатьЭлемент();
				GUIDДвоичныхДанных = Новый УникальныйИдентификатор();
				ДвоичныеДанныеФайла.УстановитьСсылкуНового(Справочники.aps_ДвоичныеДанные.ПолучитьСсылку(GUIDДвоичныхДанных));
					
				Если Константы.aps_РежимХраненияФайлов.Получить() = 0 Тогда
					ДвоичныеДанныеФайла.ДвДанные=Новый ХранилищеЗначения(ДвДанные);
				Иначе
					ПутьКВнешнемуХранилищу = aps_РаботаСФайлами.aps_ДобавитьПоследнийСлэш(Константы.aps_ПутьКВнешнемуХранилищуФайлов.Получить());
					КаталогДвоичныхДанныхВХранилище = ПутьКВнешнемуХранилищу + Строка(GUIDДвоичныхДанных);
					ПутьКФайлуВХранилище = КаталогДвоичныхДанныхВХранилище + "\" + НовыйФайл.ИмяФайла + НовыйФайл.Расширение;
					СоздатьКаталог(КаталогДвоичныхДанныхВХранилище); //создать каталог новых двоичных данных
					ДвДанные.Записать(ПутьКФайлуВХранилище);
				КонецЕсли;
				
				Если ВерсияПлатформы = "8.3" Тогда
					Выполнить("
					|ДвоичныеДанныеФайла.MD5 = MD5;
					|ХешированиеДанных = Новый ХешированиеДанных(ХешФункция.CRC32);
					|ХешированиеДанных.Добавить(ДвДанные);
					|ДвоичныеДанныеФайла.CRC = ХешированиеДанных.ХешСумма;");
				ИначеЕсли CRC <> Неопределено Тогда 
					ДвоичныеДанныеФайла.CRC = CRC;
				КонецЕсли;
				
			    ДвоичныеДанныеФайла.Записать();
				НовыйФайл.ДвоичныеДанные=ДвоичныеДанныеФайла.Ссылка;
			КонецЕсли;
			
			НовыйФайл.Записать();
			                                                                            
			ОписаниеОшибки="";
			Если НЕ НовыйФайл.ПроверитьИмя(ОписаниеОшибки) Тогда 
				ВызватьИсключение ОписаниеОшибки;
			КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		Возврат НовыйФайл.Ссылка;
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецФункции

// Функция импортирует каталог в базу данных. Рекурсия
// Параметры:
//		Документ 	- Ссылка на документ
//		Родитель 	- СправочникСсылка.aps_Файлы
//		СтруктураДанныхКаталога - Структура
// Возвращаемое значение:
//		СправочникСсылка.aps_Файлы
// Пример:
//		aps_ИмпортКаталога( Документ, Родитель, ДанныеФайлаИлиКаталога, ИскатьСуществующиеПапки );
//
Функция aps_ИмпортКаталога( Документ, Родитель, СтруктураДанныхКаталога, ИскатьСуществующиеПапки = Ложь ) Экспорт 
	
	ПапкаФайлов = Справочники.aps_Файлы.ПустаяСсылка();
	Если ИскатьСуществующиеПапки Тогда 
		ПапкаФайлов = Справочники.aps_Файлы.НайтиПоНаименованию(СтруктураДанныхКаталога.ИмяБезРасширения, Истина, Родитель, Документ);
	КонецЕсли;
	
	Если ПапкаФайлов.Пустая() Тогда // создать новую папку
		ПапкаФайлов = aps_СоздатьПапку(Документ, Родитель, СтруктураДанныхКаталога.ИмяБезРасширения);
	КонецЕсли;
	
	МассивФайловИКаталогов = СтруктураДанныхКаталога.ФайлыИКаталоги;
	Для i=0 По МассивФайловИКаталогов.Количество()-1 Цикл 
		Если МассивФайловИКаталогов[i].Свойство("ФайлыИКаталоги") Тогда 
			aps_ИмпортКаталога(Документ, ПапкаФайлов, МассивФайловИКаталогов[i], ИскатьСуществующиеПапки);
		Иначе // это файл
			aps_ИмпортФайла(Документ, ПапкаФайлов, МассивФайловИКаталогов[i]);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ПапкаФайлов;
	
КонецФункции


// Процедура импортирует файл в базу данных с обновлением существующего файла
// Параметры:
//		ФайлСсылка	- СправочникСсылка.aps_Файлы,
//		СтруктураДанныхФайла - Структура, данные импортируемого файла
// Пример:
//		aps_РаботаСФайламиСервер.aps_ОбновитьСодержимоеФайла(СуществующийФайл, СтруктураДанныхФайла, CRC);
//
Процедура aps_ОбновитьСодержимоеФайла( ФайлСсылка, СтруктураДанныхФайла, CRC=Неопределено ) Экспорт
	
	Попытка
		НачатьТранзакцию();
		
			ФайлОбъект=ФайлСсылка.ПолучитьОбъект();
			
			ФайлОбъект.ДатаМодификации	=СтруктураДанныхФайла.ДатаМодификации;
			ФайлОбъект.Размер			=СтруктураДанныхФайла.Размер;
			
			ДвДанные = ПолучитьИзВременногоХранилища(СтруктураДанныхФайла.АдресДвоичныхДанных);
			
			СистемнаяИнформация = Новый СистемнаяИнформация();
			ВерсияПлатформы = Лев(СистемнаяИнформация.ВерсияПриложения, 3);
			Если ВерсияПлатформы = "8.3" Тогда
				MD5 = "";
				Выполнить("
				|ХешированиеДанных = Новый ХешированиеДанных(ХешФункция.MD5);
				|ХешированиеДанных.Добавить(ДвДанные);
				|MD5 = НРег(СтрЗаменить(Строка(ХешированиеДанных.ХешСумма), "" "", """"));
				|СуществующиеДвоичныеДанные = Справочники.aps_ДвоичныеДанные.НайтиПоРеквизиту(""MD5"", MD5);");
			ИначеЕсли CRC <> Неопределено Тогда 
				СуществующиеДвоичныеДанные = Справочники.aps_ДвоичныеДанные.НайтиПоРеквизиту("CRC", CRC);
			Иначе 
				СуществующиеДвоичныеДанные = Справочники.aps_ДвоичныеДанные.ПустаяСсылка();
			КонецЕсли;
			
			Если НЕ СуществующиеДвоичныеДанные.Пустая() Тогда
				ДвоичныеДанныеФайла = ФайлОбъект.ДвоичныеДанные;
				ФайлыСтарыхДвоичныхДанных = aps_ПолучитьФайлыДвоичныхДанных(ДвоичныеДанныеФайла);
				Если ДвоичныеДанныеФайла <> СуществующиеДвоичныеДанные 
								И ФайлыСтарыхДвоичныхДанных.Количество() = 1 Тогда 
					ДвоичныеДанныеФайла.ПолучитьОбъект().Удалить(); // удалить старые двоичные данные
				КонецЕсли;
				
				Если СуществующиеДвоичныеДанные.ПометкаУдаления Тогда
					СуществующиеДвоичныеДанные.ПолучитьОбъект().УстановитьПометкуУдаления(Ложь);
				КонецЕсли;
				
				Если Константы.aps_РежимХраненияФайлов.Получить() = 1 Тогда
					// скопировать файл во внешнее хранилище (с другим именем)
					ПутьКВнешнемуХранилищу = aps_РаботаСФайлами.aps_ДобавитьПоследнийСлэш(Константы.aps_ПутьКВнешнемуХранилищуФайлов.Получить());
					КаталогДвоичныхДанныхВХранилище = ПутьКВнешнемуХранилищу + Строка(СуществующиеДвоичныеДанные.УникальныйИдентификатор());
					ПутьКФайлуВХранилище = КаталогДвоичныхДанныхВХранилище + "\" + ФайлОбъект.ИмяФайла + ФайлОбъект.Расширение;
					ДвДанные.Записать(ПутьКФайлуВХранилище);
					
					УдалитьИзКаталогаСтарыхДвоичныхДанных = Истина;
					Для Каждого ФайлСтарыхДвоичныхДанных Из ФайлыСтарыхДвоичныхДанных Цикл 
						Если ФайлСтарыхДвоичныхДанных.Ссылка <> ФайлОбъект.Ссылка
								И ФайлСтарыхДвоичныхДанных.ИмяФайла = ФайлОбъект.ИмяФайла И ФайлСтарыхДвоичныхДанных.Расширение = ФайлОбъект.Расширение Тогда 
							// есть другой файл с таким же именем в каталоге старых двоичных данных
							УдалитьИзКаталогаСтарыхДвоичныхДанных = Ложь; Прервать;
						КонецЕсли;
					КонецЦикла;
					Если УдалитьИзКаталогаСтарыхДвоичныхДанных Тогда 	
						// удалить этот файл из каталога старых двоичных данных (если этот каталог еще существует)
						КаталогСтарыхДвоичныхДанных = ПутьКВнешнемуХранилищу + Строка(ФайлОбъект.ДвоичныеДанные.УникальныйИдентификатор());
						УдалитьФайлы(КаталогСтарыхДвоичныхДанных + "\" + ФайлОбъект.ИмяФайла + ФайлОбъект.Расширение);
					КонецЕсли;
				КонецЕсли;
				
				ФайлОбъект.ДвоичныеДанные=СуществующиеДвоичныеДанные;
				
			Иначе //пустая ссылка на двоичные данные
				ДвоичныеДанныеФайла = ФайлОбъект.ДвоичныеДанные;
				ФайлыСтарыхДвоичныхДанных = aps_ПолучитьФайлыДвоичныхДанных(ДвоичныеДанныеФайла);
				Если ФайлыСтарыхДвоичныхДанных.Количество() = 1 Тогда 
					ДвоичныеДанныеФайла.ПолучитьОбъект().Удалить(); // удалить старые двоичные данные
				КонецЕсли;
				
				ДвоичныеДанныеФайла = Справочники.aps_ДвоичныеДанные.СоздатьЭлемент();
				GUIDДвоичныхДанных = Новый УникальныйИдентификатор();
				ДвоичныеДанныеФайла.УстановитьСсылкуНового(Справочники.aps_ДвоичныеДанные.ПолучитьСсылку(GUIDДвоичныхДанных));
				
				Если Константы.aps_РежимХраненияФайлов.Получить() = 0 Тогда
					ДвоичныеДанныеФайла.ДвДанные=Новый ХранилищеЗначения(ДвДанные);
				Иначе
					ПутьКВнешнемуХранилищу = aps_РаботаСФайлами.aps_ДобавитьПоследнийСлэш(Константы.aps_ПутьКВнешнемуХранилищуФайлов.Получить());
					КаталогДвоичныхДанныхВХранилище = ПутьКВнешнемуХранилищу + Строка(GUIDДвоичныхДанных);
					ПутьКФайлуВХранилище = КаталогДвоичныхДанныхВХранилище + "\" + ФайлОбъект.ИмяФайла + ФайлОбъект.Расширение;
					СоздатьКаталог(КаталогДвоичныхДанныхВХранилище); //создать каталог новых двоичных данных
					ДвДанные.Записать(ПутьКФайлуВХранилище);
					
					УдалитьИзКаталогаСтарыхДвоичныхДанных = Истина;
					Для Каждого ФайлСтарыхДвоичныхДанных Из ФайлыСтарыхДвоичныхДанных Цикл 
						Если ФайлСтарыхДвоичныхДанных.Ссылка <> ФайлОбъект.Ссылка
								И ФайлСтарыхДвоичныхДанных.ИмяФайла = ФайлОбъект.ИмяФайла И ФайлСтарыхДвоичныхДанных.Расширение = ФайлОбъект.Расширение Тогда 
							// есть другой файл с таким же именем в каталоге старых двоичных данных
							УдалитьИзКаталогаСтарыхДвоичныхДанных = Ложь; Прервать;
						КонецЕсли;
					КонецЦикла;
					Если УдалитьИзКаталогаСтарыхДвоичныхДанных Тогда 	
						// удалить этот файл из каталога старых двоичных данных (если этот каталог еще существует)
						КаталогСтарыхДвоичныхДанных = ПутьКВнешнемуХранилищу + Строка(ФайлОбъект.ДвоичныеДанные.УникальныйИдентификатор());
						УдалитьФайлы(КаталогСтарыхДвоичныхДанных + "\" + ФайлОбъект.ИмяФайла + ФайлОбъект.Расширение);
					КонецЕсли;
				КонецЕсли;
				
				Если ВерсияПлатформы = "8.3" Тогда
					Выполнить("
					|ДвоичныеДанныеФайла.MD5 = MD5;
					|ХешированиеДанных = Новый ХешированиеДанных(ХешФункция.CRC32);
					|ХешированиеДанных.Добавить(ДвДанные);
					|ДвоичныеДанныеФайла.CRC = ХешированиеДанных.ХешСумма;");
				ИначеЕсли CRC <> Неопределено Тогда  
					ДвоичныеДанныеФайла.CRC = CRC;
				КонецЕсли;
				
			    ДвоичныеДанныеФайла.Записать();
				ФайлОбъект.ДвоичныеДанные=ДвоичныеДанныеФайла.Ссылка;
			КонецЕсли;
			
			ФайлОбъект.Записать();
			
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры



// Функция формирует структуру данных файла в базе для выгрузки на диск
//
// Параметры:
//		ФайлСсылка	- СправочникСсылка.aps_Файлы
// Возвращаемое значение:
//		Структура
// Пример:
//		СтруктураДанныхФайла=aps_РаботаСФайламиСервер.aps_ПодготовитьСтруктуруДанныхФайлаПоСсылке(ВыгружаемыеФайлы[i].Ссылка);
//
Функция aps_ПодготовитьСтруктуруДанныхФайлаПоСсылке( ФайлСсылка, СтруктураДанныхФайла = Неопределено ) Экспорт 
	Если СтруктураДанныхФайла = Неопределено Тогда 
		СтруктураДанныхФайла = Новый Структура();
		СтруктураДанныхФайла.Вставить("Имя");
		СтруктураДанныхФайла.Вставить("ПолноеИмя");
		СтруктураДанныхФайла.Вставить("ДатаМодификации");
		СтруктураДанныхФайла.Вставить("Размер");
		СтруктураДанныхФайла.Вставить("ДвоичныеДанные");
		СтруктураДанныхФайла.Вставить("АдресДвоичныхДанных");
		СтруктураДанныхФайла.Вставить("Редактируется");
		СтруктураДанныхФайла.Вставить("ИдентификаторСессии");
		СтруктураДанныхФайла.Вставить("Подписан");
		СтруктураДанныхФайла.Вставить("Зашифрован");
		СтруктураДанныхФайла.Вставить("ПравоИзменения");
	КонецЕсли;
	
	// обязательные поля
	СтруктураДанныхФайла.Вставить("Ссылка"	, ФайлСсылка);
	СтруктураДанныхФайла.Вставить("Документ", ФайлСсылка.Владелец);
	
	Если СтруктураДанныхФайла.Свойство("Имя") Тогда 
		СтруктураДанныхФайла.Имя = ФайлСсылка.Наименование;
	КонецЕсли;
	Если СтруктураДанныхФайла.Свойство("ПолноеИмя") Тогда 
		СтруктураДанныхФайла.ПолноеИмя = СтрЗаменить(ФайлСсылка.ПолноеНаименование(),"/","\");
	КонецЕсли;
	Если СтруктураДанныхФайла.Свойство("ДатаМодификации") Тогда 
		СтруктураДанныхФайла.ДатаМодификации = ФайлСсылка.ДатаМодификации;
	КонецЕсли;
	Если СтруктураДанныхФайла.Свойство("Размер") Тогда 
		СтруктураДанныхФайла.Размер = ФайлСсылка.Размер;
	КонецЕсли;
	Если СтруктураДанныхФайла.Свойство("ДвоичныеДанные") Тогда 
		Если Константы.aps_РежимХраненияФайлов.Получить() = 0 Тогда
			СтруктураДанныхФайла.ДвоичныеДанные = ФайлСсылка.ДвоичныеДанные.ДвДанные.Получить();
		Иначе // файлы хранятся во внешнем хранилище
			ПутьКВнешнемуХранилищу = aps_РаботаСФайлами.aps_ДобавитьПоследнийСлэш(Константы.aps_ПутьКВнешнемуХранилищуФайлов.Получить());
			КаталогВоВнешнемХранилище = Строка(ФайлСсылка.ДвоичныеДанные.УникальныйИдентификатор()) + "\";
			ИмяФайлаСРасширением = ФайлСсылка.ИмяФайла + ФайлСсылка.Расширение;
			СтруктураДанныхФайла.ДвоичныеДанные = Новый ДвоичныеДанные(ПутьКВнешнемуХранилищу + КаталогВоВнешнемХранилище + ИмяФайлаСРасширением);
		КонецЕсли;
	КонецЕсли;
	Если СтруктураДанныхФайла.Свойство("АдресДвоичныхДанных") Тогда 
		Если Константы.aps_РежимХраненияФайлов.Получить() = 0 Тогда
			СтруктураДанныхФайла.АдресДвоичныхДанных = ПолучитьНавигационнуюСсылку(ФайлСсылка.ДвоичныеДанные, "ДвДанные");
		Иначе // файлы хранятся во внешнем хранилище
			ПутьКВнешнемуХранилищу = aps_РаботаСФайлами.aps_ДобавитьПоследнийСлэш(Константы.aps_ПутьКВнешнемуХранилищуФайлов.Получить());
			КаталогВоВнешнемХранилище = Строка(ФайлСсылка.ДвоичныеДанные.УникальныйИдентификатор()) + "\";
			ИмяФайлаСРасширением = ФайлСсылка.ИмяФайла + ФайлСсылка.Расширение;
			СтруктураДанныхФайла.АдресДвоичныхДанных = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ПутьКВнешнемуХранилищу + КаталогВоВнешнемХранилище + ИмяФайлаСРасширением));
		КонецЕсли;
	КонецЕсли;
	Если СтруктураДанныхФайла.Свойство("Редактируется") Тогда 
		СтруктураДанныхФайла.Редактируется = ФайлСсылка.Редактируется;
	КонецЕсли;
	Если СтруктураДанныхФайла.Свойство("ИдентификаторСессии") Тогда 
		СтруктураДанныхФайла.ИдентификаторСессии = ФайлСсылка.ИдентификаторCheckOut;
	КонецЕсли;
	Если СтруктураДанныхФайла.Свойство("Подписан") Тогда 
		СтруктураДанныхФайла.Подписан = ФайлСсылка.Подписан;
	КонецЕсли;
	Если СтруктураДанныхФайла.Свойство("Зашифрован") Тогда 
		СтруктураДанныхФайла.Зашифрован = ФайлСсылка.Зашифрован;
	КонецЕсли;
	Если СтруктураДанныхФайла.Свойство("ПравоИзменения") Тогда 
		СтруктураДанныхФайла.ПравоИзменения = Обработки.aps_ПраваДоступа.Создать().aps_ПроверитьОбъектПрава(Справочники.aps_Права.Изменение, ФайлСсылка.Владелец, ФайлСсылка.Владелец.GMOD);
	КонецЕсли;
	
	Возврат СтруктураДанныхФайла;
КонецФункции



// Функция получает все файлы документа
// Параметры:
//		Документ	- ссылка на документ или массив,
//		ТолькоФайлы - Булево, исключить папки файлов
// Возвращаемое значение:
//		ТаблицаЗначений
// Пример:
//		ФайлыДокумента=aps_РаботаСФайламиСервер.aps_ПолучитьФайлыДокумента(АктивныйДокумент);
//
Функция aps_ПолучитьФайлыДокумента( Документ, ТолькоФайлы = Истина ) Экспорт 
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	*, aps_Файлы.Владелец КАК Документ
	                      |ИЗ
	                      |	Справочник.aps_Файлы КАК aps_Файлы
	                      |ГДЕ
	                      |	aps_Файлы.Владелец В(&Владелец)");
	Если ТолькоФайлы Тогда 
		Запрос.Текст = Запрос.Текст + "
	                      |	И НЕ aps_Файлы.ЭтоГруппа";
	КонецЕсли;
    Запрос.Текст = Запрос.Текст + "
	                      |УПОРЯДОЧИТЬ ПО
	                      |	Документ, Наименование";
	
	Запрос.УстановитьПараметр("Владелец", Документ);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

// Функция формирует массив зависимых расширений
// Параметры:
//		Расширения - массив исходных расширений
// Возвращаемое значение:
//		Массив
// Пример:
//		ЗависимыеРасширения=aps_РаботаСФайламиСервер.aps_ПолучитьЗависимыеРасширения(ФайлыАктДокумента.ВыгрузитьКолонку("Расширение"));
//
Функция aps_ПолучитьЗависимыеРасширения( Расширения ) Экспорт 
	Запрос=Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	                    |	ЗависимыеРасширения.Расширение
	                    |ИЗ
	                    |	Справочник.aps_ТипыЗависимыхФайлов.ЗависимыеРасширения КАК ЗависимыеРасширения
	                    |ГДЕ
	                    |	ЗависимыеРасширения.Ссылка.Наименование В(&Расширения)
	                    |	И (НЕ ЗависимыеРасширения.Ссылка.ПометкаУдаления)");
	Запрос.УстановитьПараметр("Расширения", Расширения);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку(0);
КонецФункции

// Функция получает зависимые файлы документа
// Параметры:
//		ЗависимыеДокументы 	- массив документов,
//		ЗависимыеРасширения - массив зависимых расширений
// Возвращаемое значение:
//		ТаблицаЗначений
// Пример:
//		ЗависимыеФайлы = aps_РаботаСФайламиСервер.aps_ПолучитьЗависимыеФайлыДокумента(ЗависимыеДокументы, ЗависимыеРасширения);
//
Функция aps_ПолучитьЗависимыеФайлыДокумента( ЗависимыеДокументы, ЗависимыеРасширения ) Экспорт 
	// таблица файлов по зависимым документам
	ЗависимыеФайлы = aps_ПолучитьФайлыДокумента(ЗависимыеДокументы);
	
	i=0;
	Пока i < ЗависимыеФайлы.Количество() Цикл 
		Зависимый=Ложь;
		Для Каждого ЗавРасширение Из ЗависимыеРасширения Цикл 
			Если ВРЕГ(ЗавРасширение)=ВРЕГ(ЗависимыеФайлы[i].Расширение) Тогда 
				Зависимый=Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если НЕ Зависимый Тогда 
			ЗависимыеФайлы.Удалить(i); Продолжить;
		КонецЕсли;
		
		i=i+1; // перейти к следующему файлу
	КонецЦикла;
	
	Возврат ЗависимыеФайлы;
КонецФункции

// Функция возвращает список исключений при помещении файлов для пользователя
// Параметры:
//		ПользовательСсылка - СправочникСсылка.Пользователи
// Возвращаемое значение:
//		Массив
// Пример:
//		Исключения = aps_РаботаСФайламиСервер.aps_ПолучитьИсключенияПриПомещенииФайлов();
//
Функция aps_ПолучитьИсключенияПриПомещенииФайлов( Знач ПользовательСсылка = Неопределено ) Экспорт 
	Если ПользовательСсылка=Неопределено Тогда 
		ПользовательСсылка=ПараметрыСеанса.ТекущийПользователь;
	КонецЕсли;
	
	Запрос=Новый Запрос("ВЫБРАТЬ
	                    |	ИсключенияПриПомещенииФайлов.Исключение
	                    |ИЗ
	                    |	Справочник.aps_ИсключенияПриПомещенииФайлов.Исключения КАК ИсключенияПриПомещенииФайлов
	                    |ГДЕ
	                    |	(ИсключенияПриПомещенииФайлов.Ссылка.Предопределенный
	                    |			ИЛИ ИсключенияПриПомещенииФайлов.Ссылка.Пользователь = &Пользователь)");
	Запрос.УстановитьПараметр("Пользователь", ПользовательСсылка);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку(0);	
КонецФункции

// Функция возвращает массив файлов в справочнике, редактируемых в данной сессии
// Параметры:
//		ИдентификаторСессии - Строка, идентификатор check-out,
//		возвМассивРедактируемыхДокументов - Массив, возвращаемый массив редактируемых документов
// Возвращаемое значение:
//		Массив
// Пример:
//		МассивРедактируемыхФайлов = aps_РаботаСФайламиСервер.aps_ПолучитьРедактируемыеФайлы(ИдентификаторСессии, МассивРедактируемыхДокументов);
//
Функция aps_ПолучитьРедактируемыеФайлы( ИдентификаторСессии, возвМассивРедактируемыхДокументов = Неопределено ) Экспорт 
	Запрос=Новый Запрос("ВЫБРАТЬ
	                    |	aps_Файлы.Ссылка,
	                    |	aps_Файлы.Владелец КАК Документ
	                    |ИЗ
	                    |	Справочник.aps_Файлы КАК aps_Файлы
	                    |ГДЕ
	                    |	aps_Файлы.ИдентификаторCheckOut = &ИдентификаторСессии");
	Запрос.УстановитьПараметр("ИдентификаторСессии", ИдентификаторСессии);
	РедактируемыеФайлы = Запрос.Выполнить().Выгрузить();
	
	МассивРедактируемыхФайлов = Новый Массив;
	Для i=0 По РедактируемыеФайлы.Количество()-1 Цикл 
		МассивРедактируемыхФайлов.Добавить(РедактируемыеФайлы[i].Ссылка);
		Если возвМассивРедактируемыхДокументов <> Неопределено 
				И возвМассивРедактируемыхДокументов.Найти(РедактируемыеФайлы[i].Документ) = Неопределено Тогда 
			возвМассивРедактируемыхДокументов.Добавить(РедактируемыеФайлы[i].Документ);
		КонецЕсли;
	КонецЦикла;
	
	Возврат МассивРедактируемыхФайлов;
КонецФункции

// Функция получает список файлов по ссылке на справочник двоичных данных
// Параметры:
//		ДвДанныеСсылка - СправочникСсылка.aps_ДвоичныеДанные
// Возвращаемое значение:
//		Массив
// Пример:
//		ФайлыДвоичныхДанных=aps_РаботаСФайламиСервер.aps_ПолучитьФайлыДвоичныхДанных(ДвоичныеДанные);
//
Функция aps_ПолучитьФайлыДвоичныхДанных( ДвДанныеСсылка ) Экспорт 
	ЗапросФайлов = Новый Запрос("ВЫБРАТЬ
								|	aps_Файлы.Ссылка КАК Файл
								|ИЗ
								|	Справочник.aps_Файлы КАК aps_Файлы
								|ГДЕ
								|	aps_Файлы.ДвоичныеДанные = &ДвоичныеДанные");
	ЗапросФайлов.УстановитьПараметр("ДвоичныеДанные", ДвДанныеСсылка);
	Возврат ЗапросФайлов.Выполнить().Выгрузить().ВыгрузитьКолонку(0);
КонецФункции


// Процедура удаляет каталог двоичных данных во внешнем хранилище по ссылке
// Параметры:
//		ДвДанныеСсылка - СправочникСсылка.aps_ДвоичныеДанные
// Пример:
//		aps_РаботаСФайламиСервер.aps_УдалитьКаталогДвоичныхДанныхВХранилище(Ссылка);
//
Процедура aps_УдалитьКаталогДвоичныхДанныхВХранилище( ДвДанныеСсылка ) Экспорт 
	GUIDДвоичныхДанных = ДвДанныеСсылка.УникальныйИдентификатор();
	ПутьКВнешнемуХранилищу = aps_РаботаСФайлами.aps_ДобавитьПоследнийСлэш(Константы.aps_ПутьКВнешнемуХранилищуФайлов.Получить());
	КаталогВоВнешнемХранилище = ПутьКВнешнемуХранилищу + Строка(GUIDДвоичныхДанных);
	Попытка
		УдалитьФайлы(КаталогВоВнешнемХранилище);
	Исключение
	КонецПопытки;
КонецПроцедуры

// Процедура удаляет файл в каталоге двоичных данных во внешнем хранилище по ссылке
// Параметры:
//		ФайлСсылка - СправочникСсылка.aps_Файлы
// Пример:
//		aps_РаботаСФайламиСервер.aps_УдалитьФайлВХранилище(Ссылка);
//
Функция aps_УдалитьФайлВХранилище( ФайлСсылка ) Экспорт 
	GUIDДвоичныхДанных = ФайлСсылка.ДвоичныеДанные.УникальныйИдентификатор();
	ПутьКВнешнемуХранилищу = aps_РаботаСФайлами.aps_ДобавитьПоследнийСлэш(Константы.aps_ПутьКВнешнемуХранилищуФайлов.Получить());
	КаталогВоВнешнемХранилище = ПутьКВнешнемуХранилищу + Строка(GUIDДвоичныхДанных);
	ПолноеИмяФайла = КаталогВоВнешнемХранилище + "\" + ФайлСсылка.Наименование;
	Попытка
		УдалитьФайлы(ПолноеИмяФайла);
	Исключение
	КонецПопытки;
КонецФункции

// Процедура изменяет имя файла в каталоге двоичных данных во внешнем хранилище по ссылке
// Параметры:
//		ФайлСсылка		- СправочникСсылка.aps_Файлы
//		НовоеИмяФайла	- Строка
// Пример:
//		aps_РаботаСФайламиСервер.aps_ПереименоватьФайлВХранилище(Ссылка, Наименование);
//
Процедура aps_ПереименоватьФайлВХранилище( ФайлСсылка, НовоеИмяФайла ) Экспорт 
	GUIDДвоичныхДанных = ФайлСсылка.ДвоичныеДанные.УникальныйИдентификатор();
	ПутьКВнешнемуХранилищу = aps_РаботаСФайлами.aps_ДобавитьПоследнийСлэш(Константы.aps_ПутьКВнешнемуХранилищуФайлов.Получить());
	КаталогВоВнешнемХранилище = ПутьКВнешнемуХранилищу + Строка(GUIDДвоичныхДанных);
	ПолноеИмяФайла = КаталогВоВнешнемХранилище + "\" + ФайлСсылка.Наименование;
	//////////////////////////////////////////////////////////////////////////////////
	// проверить, есть ли другие файлы в базе с таким же именем и дв.данными
	ФайлыДвоичныхДанных = aps_ПолучитьФайлыДвоичныхДанных(ФайлСсылка.ДвоичныеДанные);
	Для Каждого ФайлДвоичныхДанных Из ФайлыДвоичныхДанных Цикл 
		Если ФайлДвоичныхДанных.ИмяФайла = ФайлСсылка.ИмяФайла И ФайлДвоичныхДанных.Расширение = ФайлСсылка.Расширение
					И ФайлДвоичныхДанных <> ФайлСсылка Тогда 
			Попытка
				КопироватьФайл(ПолноеИмяФайла, КаталогВоВнешнемХранилище + "\" + НовоеИмяФайла);
			Исключение
			КонецПопытки;
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	Попытка
		ПереместитьФайл(ПолноеИмяФайла, КаталогВоВнешнемХранилище + "\" + НовоеИмяФайла);
	Исключение
	КонецПопытки;
КонецПроцедуры

#КонецОбласти


#Область CheckOut

// Функция устанавливает блокировки редактирования документов и файлов. Выполняется в транзакции
// Параметры:
//		МассивФайлов - массив элементов справочника aps_Файлы
//		ИдентификаторСессии - Строка, идентификатор сессии check-out
// Пример:
//		aps_РаботаСФайламиСервер.aps_УстановитьБлокировкиРедактирования(МассивФайловДляУстановкиБлокировок, ИдентификаторСессии);
//
Процедура aps_УстановитьБлокировкиРедактирования( МассивФайлов, ИдентификаторСессии ) Экспорт
	
	Попытка
		НачатьТранзакцию();
		
		Для Каждого ФайлСсылка Из МассивФайлов Цикл 
			ДокументСсылка = ФайлСсылка.Владелец;
			
			Если ДокументСсылка.РедактирующийПользователь.Пустая() Тогда 
				// заблокировать документ
				ДокументОбъект=ДокументСсылка.ПолучитьОбъект();
				ДокументОбъект.РедактирующийПользователь=ПараметрыСеанса.ТекущийПользователь;
				ДокументОбъект.Записать();
			КонецЕсли;
			
			// заблокировать этот файл
			ФайлОбъект=ФайлСсылка.ПолучитьОбъект();
			ФайлОбъект.Редактируется=ПараметрыСеанса.ТекущийПользователь;
			ФайлОбъект.ИдентификаторCheckOut=ИдентификаторСессии;
			ФайлОбъект.Записать();
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

// Функция снимает блокировки редактирования документов и файлов. Выполняется в транзакции
// Параметры:
//		МассивФайлов - массив элементов справочника aps_Файлы
// Пример:
//		aps_РаботаСФайламиСервер.aps_СнятьБлокировкиРедактирования(МассивРедактируемыхФайлов);
//
Процедура aps_СнятьБлокировкиРедактирования( МассивФайлов ) Экспорт
	
	Попытка
		НачатьТранзакцию();
		
		Для Каждого ФайлСсылка Из МассивФайлов Цикл 
			ДокументСсылка = ФайлСсылка.Владелец;
			
			Если НЕ ДокументСсылка.РедактирующийПользователь.Пустая() Тогда
				ДокументОбъект=ДокументСсылка.ПолучитьОбъект();
				ДокументОбъект.РедактирующийПользователь=Справочники.Пользователи.ПустаяСсылка();
				ДокументОбъект.Записать();
			КонецЕсли;
			
			ФайлОбъект=ФайлСсылка.ПолучитьОбъект();
			ФайлОбъект.Редактируется=Справочники.Пользователи.ПустаяСсылка();
			ФайлОбъект.ИдентификаторCheckOut="";
			ФайлОбъект.Записать();
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

// Функция сохраняет изменения редактирования в базу данных.
// Выполняется в транзакции
// Параметры:
//		МассивСтруктурФайлов		- массив структур измененных и удаленных файлов
//		ДокументыИФайлыДляИмпорта	- соответствие, ключ - ссылка на документ, значение - массив структур данных файлов для импорта
// Пример:
//		aps_РаботаСФайламиСервер.aps_СохранитьИзмененияРедактированияВБДРевизией( МассивСтруктурИзмененныхФайлов, ДокументыИФайлыДляИмпорта );
//
Процедура aps_СохранитьИзмененияРедактированияВБД( МассивСтруктурФайлов, ДокументыИФайлыДляИмпорта, возвМассивНовыхФайлов = Неопределено ) Экспорт
	
	Попытка
		НачатьТранзакцию();
		////////////////////////////////////////////////////
		// новые файлы
		Для Каждого КиЗ Из ДокументыИФайлыДляИмпорта Цикл 
			ДокументСсылка = КиЗ.Ключ;
			МассивСтруктурФайловДляИмпорта = КиЗ.Значение;
			
			МассивФайловДоИмпорта = aps_ПолучитьФайлыДокумента(ДокументСсылка).ВыгрузитьКолонку("Ссылка");
			aps_ИмпортФайловИКаталогов(ДокументСсылка, Справочники.aps_Файлы.ПустаяСсылка(), МассивСтруктурФайловДляИмпорта, Истина);
			
			МассивФайловПослеИмпорта = aps_ПолучитьФайлыДокумента(ДокументСсылка).ВыгрузитьКолонку("Ссылка");
			Для Каждого ФайлСсылка Из МассивФайловПослеИмпорта Цикл 
				Если возвМассивНовыхФайлов <> Неопределено И МассивФайловДоИмпорта.Найти(ФайлСсылка) = Неопределено Тогда 
					возвМассивНовыхФайлов.Добавить(ФайлСсылка);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
		////////////////////////////////////////////////////
		// измененные и удаленные файлы
		Для Каждого ДанныеФайла Из МассивСтруктурФайлов Цикл 
			Если ДанныеФайла.Свойство("Удален") Тогда 
				ДанныеФайла.Ссылка.ПолучитьОбъект().Удалить();
			Иначе // изменить файл в справочнике
				aps_ОбновитьСодержимоеФайла(ДанныеФайла.Ссылка, ДанныеФайла);
			КонецЕсли;			
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

// Функция сохраняет изменения редактирования в базу данных созданием новых ревизий документов.
// Выполняется в транзакции
// Параметры:
//		МассивСтруктурФайлов		- массив структур измененных и удаленных файлов
//		ДокументыИФайлыДляИмпорта	- соответствие, ключ - ссылка на документ, значение - массив структур данных файлов для импорта
// Пример:
//		aps_РаботаСФайламиСервер.aps_СохранитьИзмененияРедактированияВБДРевизией( МассивСтруктурИзмененныхФайлов, ДокументыИФайлыДляИмпорта );
//
Процедура aps_СохранитьИзмененияРедактированияВБДРевизией( МассивСтруктурФайлов, ДокументыИФайлыДляИмпорта ) Экспорт
	
	СоответствиеРевизий = Новый Соответствие();
	
	Попытка
		НачатьТранзакцию();
		////////////////////////////////////////////////////
		// новые файлы
		Для Каждого КиЗ Из ДокументыИФайлыДляИмпорта Цикл 
			ДокументСсылка = КиЗ.Ключ;
			МассивСтруктурФайловДляИмпорта = КиЗ.Значение;
			
			itemRevision = СоответствиеРевизий.Получить(ДокументСсылка);
			Если itemRevision = Неопределено Тогда 
				itemRevision = aps_СоздатьНовуюВерсиюДокумента(ДокументСсылка);
				СоответствиеРевизий.Вставить(ДокументСсылка, itemRevision);
			КонецЕсли;
			
			aps_ИмпортФайловИКаталогов(itemRevision, Справочники.aps_Файлы.ПустаяСсылка(), МассивСтруктурФайловДляИмпорта, Истина);
		КонецЦикла;
		
		////////////////////////////////////////////////////
		// измененные и удаленные файлы
		Для Каждого ДанныеФайла Из МассивСтруктурФайлов Цикл 
			ДокументСсылка = ДанныеФайла.Документ;
			
			itemRevision = СоответствиеРевизий.Получить(ДокументСсылка);
			Если itemRevision = Неопределено Тогда 
				itemRevision = aps_СоздатьНовуюВерсиюДокумента(ДокументСсылка);
				СоответствиеРевизий.Вставить(ДокументСсылка, itemRevision);
			КонецЕсли;

			////////////////////////////////////////////////////////////////////////////////
			// найти соответствующий файл ревизии по полному имени и обновить его содержимое
			МассивФайловРевизии = aps_ПолучитьФайлыДокумента(itemRevision).ВыгрузитьКолонку("Ссылка");
			Для Каждого ФайлСсылка Из МассивФайловРевизии Цикл 
				Если ФайлСсылка.ПолноеНаименование() = ДанныеФайла.Ссылка.ПолноеНаименование() Тогда 
					Если ДанныеФайла.Свойство("Удален") Тогда 
						ФайлСсылка.ПолучитьОбъект().Удалить();
					Иначе 
						aps_ОбновитьСодержимоеФайла(ФайлСсылка, ДанныеФайла);
					КонецЕсли;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

// Функция создает и возвращает новую версию (ревизию изменения) документа
// Параметры:
//		ДокументСсылка - ссылка на документ (предыдущую версию)
// Возвращаемое значение:
//		СправочникСсылка.aps_ЭлементыИзделия, СправочникСсылка.aps_ЭлементыСправочников, СправочникСсылка.aps_ЭлементыТехнологии
// Пример:
//      itemRevision = aps_СоздатьНовуюВерсиюДокумента(ДокументСсылка);
//
Функция aps_СоздатьНовуюВерсиюДокумента( ДокументСсылка )
	МодульСозданияРевизий = Обработки.aps_СозданиеРевизий.Создать();
	
	// создать ревизию изменения документа
	ТаблицаПараметровРевизии = ДокументСсылка.Параметры.Выгрузить();
	ТаблицаПараметровРевизии.Колонки.Добавить("Имя");
	ТаблицаПараметровРевизии.Колонки.Добавить("Свойство");
	ТаблицаПараметровРевизии.Колонки.Добавить("Значение");
	ТаблицаПараметровРевизии.Колонки.Добавить("Наследовать");
	
	Для i=0 По ТаблицаПараметровРевизии.Количество()-1 Цикл 
		ТаблицаПараметровРевизии[i].Имя			= ТаблицаПараметровРевизии[i].Параметр.Наименование;
		ТаблицаПараметровРевизии[i].Свойство	= ТаблицаПараметровРевизии[i].Параметр.Свойство;
		ТаблицаПараметровРевизии[i].Значение	= ТаблицаПараметровРевизии[i].Параметр.Значение;
		ТаблицаПараметровРевизии[i].Наследовать	= Ложь;
	КонецЦикла;
	
	Строка = ТаблицаПараметровРевизии.Найти(ПланыВидовХарактеристик.aps_Свойства.СпособСозданияРевизии,"Свойство");
	Если Строка = Неопределено Тогда 
		Строка = ТаблицаПараметровРевизии.Добавить();
		Строка.Имя		= ПланыВидовХарактеристик.aps_Свойства.СпособСозданияРевизии.Наименование;
		Строка.Свойство	= ПланыВидовХарактеристик.aps_Свойства.СпособСозданияРевизии;
	КонецЕсли;
	
	Строка.Значение	= Справочники.aps_СпособыСозданияРевизий.Изменение;
	
	Строка = ТаблицаПараметровРевизии.Найти(ПланыВидовХарактеристик.aps_Свойства.НомерРевизии,"Свойство");
	Если Строка = Неопределено Тогда 
		Строка = ТаблицаПараметровРевизии.Добавить();
		Строка.Имя		= ПланыВидовХарактеристик.aps_Свойства.НомерРевизии.Наименование;
		Строка.Свойство	= ПланыВидовХарактеристик.aps_Свойства.НомерРевизии;
	КонецЕсли;
	
	ПредыдущийНомер = МодульСозданияРевизий.aps_ПолучитьПоследнийНомерРевизииИзменения(ДокументСсылка);
	СледующийНомер = 0;
	Попытка
		Выполнить ДокументСсылка.ВидЭлемента.КодПоследовательностиРевизийИзменения.ТекстКода;
	Исключение
	КонецПопытки;
	
	Строка.Значение = СледующийНомер;
	
	itemObject = МодульСозданияРевизий.aps_СоздатьРевизию(ДокументСсылка, ТаблицаПараметровРевизии);
	Возврат itemObject.Ссылка;
КонецФункции

#КонецОбласти


#Область Криптография

// Функция возвращает персональные настройки работы с файлами
// Параметры:
//		Нет
// Возвращаемое значение:
//		Структура
// Пример:
//		СтруктураНастроек = aps_ПерсональныеНастройки();
//
Функция aps_ПерсональныеНастройки() Экспорт 
	ПерсональныеНастройки = Новый Структура();
	
	РабочийКаталог = ХранилищеОбщихНастроек.Загрузить("РабочийКаталог");
	ПерсональныеНастройки.Вставить("РабочийКаталог", ?(РабочийКаталог=Неопределено, "", РабочийКаталог));
	
	ПараметрыКриптографии = Новый Структура;
	
	ПараметрыКриптографии.Вставить("Криптопровайдер"	, Константы.aps_ИмяМодуляКриптографии.Получить());
	ПараметрыКриптографии.Вставить("ТипКриптопровайдера", Константы.aps_ТипМодуляКриптографии.Получить());
	
	// Сертификат ЭЦП из хранилища настроек
	ПараметрыКриптографии.Вставить("СертификатДляПодписи", ХранилищеОбщихНастроек.Загрузить("СертификатДляПодписи"));
	
	ПарольКЗакрытомуКлючу = ХранилищеОбщихНастроек.Загрузить("ПарольКЗакрытомуКлючу");
	ПараметрыКриптографии.Вставить("ПарольКЗакрытомуКлючу", ?(ПарольКЗакрытомуКлючу=Неопределено, "", ПарольКЗакрытомуКлючу));
	
	ПерсональныеНастройки.Вставить("ПараметрыКриптографии", ПараметрыКриптографии);
	Возврат ПерсональныеНастройки;	
КонецФункции

// Получает все электронные цифровые подписи файла
// Параметры:
//		ФайлСсылка - СправочникСсылка.aps_Файлы
// Возвращаемое значение:
//		Массив
// Пример:
//		Подписи = aps_РаботаСФайламиСервер.aps_ПолучитьВсеЭЦПФайла(ФайлСсылка);
//
Функция aps_ПолучитьВсеЭЦПФайла(ФайлСсылка) Экспорт
	
	МассивСтруктурЭЦП = Новый Массив;
	Для Каждого СтрокаПодписи Из ФайлСсылка.Подписи Цикл 
		СтруктураДанныхПодписи = Новый Структура();
		СтруктураДанныхПодписи.Вставить("НомерСтроки"	, СтрокаПодписи.НомерСтроки);
		СтруктураДанныхПодписи.Вставить("ДатаПодписи"	, СтрокаПодписи.ДатаПодписи);
		СтруктураДанныхПодписи.Вставить("АвторПодписи"	, СтрокаПодписи.АвторПодписи);
		СтруктураДанныхПодписи.Вставить("ДвоичныеДанные", СтрокаПодписи.ЭЦП.Получить());
		
		СтруктураДанныхПодписи.Вставить("КомуВыданСертификат", СтрокаПодписи.КомуВыданСертификат);
		
		МассивСтруктурЭЦП.Добавить(СтруктураДанныхПодписи);
	КонецЦикла;
	
	Возврат МассивСтруктурЭЦП;
	
КонецФункции

// Добавляет данные ЭЦП к двоичным данным файла и записывает их
// Параметры:
//		ФайлСсылка - СправочникСсылка.aps_Файлы
//		МассивСтруктурПодписей - массив
// Возвращаемое значение:
//		нет
// Пример:
//      aps_РаботаСФайламиСервер.aps_ДобавитьДанныеЭЦП(Объект.Ссылка, СтруктураПодписи);
//
Функция aps_ДобавитьДанныеЭЦП(ФайлСсылка, Знач МассивСтруктурПодписей) Экспорт
	
	Если ТипЗнч(МассивСтруктурПодписей) = Тип("Структура") Тогда 
		СтруктураДанныхПодписи = МассивСтруктурПодписей;
		МассивСтруктурПодписей = Новый Массив;
		МассивСтруктурПодписей.Добавить(СтруктураДанныхПодписи);
	КонецЕсли;
	
	ФайлОбъект = ФайлСсылка.ПолучитьОбъект();
	
	Для Каждого СтруктураДанныхПодписи Из МассивСтруктурПодписей Цикл 
		СтрокаПодписи = ФайлОбъект.Подписи.Добавить();
		СтрокаПодписи.ДатаПодписи			= СтруктураДанныхПодписи.ДатаПодписи;
		СтрокаПодписи.АвторПодписи			= СтруктураДанныхПодписи.АвторПодписи;
		СтрокаПодписи.КомуВыданСертификат	= СтруктураДанныхПодписи.КомуВыданСертификат;
		
		СтрокаПодписи.ЭЦП = Новый ХранилищеЗначения(СтруктураДанныхПодписи.ДвоичныеДанные);
	КонецЦикла;
	
	ФайлОбъект.Записать();
	
КонецФункции

// Добавляет данные ЭЦП к двоичным данным для нескольких файлов
// Параметры:
//		СоответствиеФайловИСтруктурПодписей - соответствие
// Возвращаемое значение:
//		нет
// Пример:
//		aps_РаботаСФайламиСервер.aps_ДобавитьДанныеЭЦПДляНесколькихФайлов(СформированныеПодписи);
//
Функция aps_ДобавитьДанныеЭЦПДляНесколькихФайлов(СоответствиеФайловИСтруктурПодписей) Экспорт
	
	Попытка
		НачатьТранзакцию();
		
		Для Каждого КиЗ Из СоответствиеФайловИСтруктурПодписей Цикл 
			aps_ДобавитьДанныеЭЦП(КиЗ.Ключ, КиЗ.Значение);
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецФункции

// Удаляет ЭЦП из двоичных данных файла и записывает их
// Параметры:
//		ФайлСсылка - СправочникСсылка.aps_Файлы
//		МассивСтруктурПодписей - массив
// Возвращаемое значение:
//		нет
// Пример:
//      aps_РаботаСФайламиСервер.aps_УдалитьДанныеЭЦП(Объект.Ссылка, УдаляемыеПодписи);
//
Функция aps_УдалитьДанныеЭЦП(ФайлСсылка, Знач МассивСтруктурПодписей) Экспорт
	
	Если ТипЗнч(МассивСтруктурПодписей) = Тип("Структура") Тогда 
		СтруктураДанныхПодписи = МассивСтруктурПодписей;
		МассивСтруктурПодписей = Новый Массив;
		МассивСтруктурПодписей.Добавить(СтруктураДанныхПодписи);
	КонецЕсли;
	
	ФайлОбъект = ФайлСсылка.ПолучитьОбъект();
	
	МассивСтрокТабЧасти = Новый Массив; // массив удаляемых строк табличной части
	Для Каждого СтруктураДанныхПодписи Из МассивСтруктурПодписей Цикл 
		СтрокаТабЧасти = ФайлОбъект.Подписи.Найти(СтруктураДанныхПодписи.НомерСтроки, "НомерСтроки");
		Если СтрокаТабЧасти <> Неопределено Тогда 
			МассивСтрокТабЧасти.Добавить(СтрокаТабЧасти);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаТабЧасти Из МассивСтрокТабЧасти Цикл 
		ФайлОбъект.Подписи.Удалить(СтрокаТабЧасти);
	КонецЦикла;
	
	ФайлОбъект.Записать();
	
КонецФункции

// Удаляет ЭЦП из двоичных данных файла для нескольких файлов
// Параметры:
