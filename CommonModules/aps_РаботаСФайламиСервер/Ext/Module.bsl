// Получает сертификаты получателей, которые смогут расшифровать файл
// Параметры:
//		ФайлСсылка - СправочникСсылка.aps_Файлы
// Возвращаемое значение:
//		Массив
// Пример:
//      МассивСтруктурСертификатов = aps_РаботаСФайламиСервер.aps_ПолучитьСертификатыШифрования(Объект.Ссылка);
//
Функция aps_ПолучитьСертификатыШифрования(ФайлСсылка) Экспорт
	
	МассивСтруктурСертификатов = Новый Массив;
	Для Каждого СтрокаСертификата Из ФайлСсылка.СертификатыШифрования Цикл 
		СтруктураДанныхСертификата = Новый Структура();
		СтруктураДанныхСертификата.Вставить("НомерСтроки"	, СтрокаСертификата.НомерСтроки);
		СтруктураДанныхСертификата.Вставить("Представление"	, СтрокаСертификата.ПредставлениеСертификата);
		СтруктураДанныхСертификата.Вставить("ДвоичныеДанные", СтрокаСертификата.Сертификат.Получить());
		
		МассивСтруктурСертификатов.Добавить(СтруктураДанныхСертификата);
	КонецЦикла;
	
	Возврат МассивСтруктурСертификатов;
	
КонецФункции

// Обновляет содержимое файла и заносит информацию о сертификатах шифрования
// Параметры:
//		ФайлСсылка - СправочникСсылка.aps_Файлы
//		ДвоичныеДанныеШифрования - двоичные данные
//		МассивСтруктурСертификатов - массив (необязательный)
// Возвращаемое значение:
//		нет
// Пример:
//		aps_ИзменитьДанныеШифрования(КиЗ.Ключ, КиЗ.Значение, МассивСтруктурСертификатов);
//
Функция aps_ИзменитьДанныеШифрования(ФайлСсылка, ДвоичныеДанныеШифрования, МассивСтруктурСертификатов = Неопределено) Экспорт
	
	СтруктураДанныхФайла = aps_РаботаСФайламиСервер.aps_ПодготовитьСтруктуруДанныхФайлаПоСсылке(ФайлСсылка);
	СтруктураДанныхФайла.Вставить("АдресДвоичныхДанных", ПоместитьВоВременноеХранилище(ДвоичныеДанныеШифрования));
	aps_РаботаСФайламиСервер.aps_ОбновитьСодержимоеФайла(ФайлСсылка, СтруктураДанныхФайла);
    // записать двоичные данные файла
	aps_ОбновитьСодержимоеФайла(ФайлСсылка, СтруктураДанныхФайла);
	// записать информацию о получателях
	ФайлОбъект = ФайлСсылка.ПолучитьОбъект();
	ФайлОбъект.СертификатыШифрования.Очистить();
	Если МассивСтруктурСертификатов <> Неопределено Тогда 
		Для Каждого СтруктураСертификата Из МассивСтруктурСертификатов Цикл 
			СтрокаСертификата = ФайлОбъект.СертификатыШифрования.Добавить();
			СтрокаСертификата.ПредставлениеСертификата = СтруктураСертификата.Представление;
			СтрокаСертификата.Сертификат = Новый ХранилищеЗначения(СтруктураСертификата.ДвоичныеДанные);
		КонецЦикла;
	КонецЕсли;
	
	ФайлОбъект.Записать();
	
КонецФункции

