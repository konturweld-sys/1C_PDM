
// Функция, возвращает менеджер объектов. 
//
// У модуля установлен режим повторного использования возращаемых объектов 
// "на время сеанса". Это значит, что  в рамках текущего сеанса после первого 
// вызова функции менеджер объектов будет сохранен и при повторных вызовах функции 
// будет возвращаться его сохраненнное значение.
//
// Код функции при этом выполняться не будет.
//
Функция Получить() Экспорт
	Если НЕ ПодключитьВнешнююКомпоненту("ОбщийМакет.КомпонентаСЛК", "Licence") Тогда
		ВызватьИсключение "Ошибка подключения компоненты СЛК на сервере "+ИмяКомпьютера();
	КонецЕсли;
	
	// Создание объекта 
	МенеджерЛицензий = Новый("AddIn.Licence.LicenceExtension20");
	
	ИмяСервераСЛК = Константы.aps_ИмяСервераСЛК.Получить();
	Если Не ЗначениеЗаполнено(ИмяСервераСЛК) Тогда
		ИмяСервераСЛК =  "localhost";
	КонецЕсли;
	
	ПортСервераСЛК = Формат(Константы.aps_ПортСервераСЛК.Получить(), "ЧГ=0");
	Если Не ЗначениеЗаполнено(ПортСервераСЛК) Тогда
		ВызватьИсключение "Не задан порт сервера СЛК в настройках системы";
	КонецЕсли;
	
	// Запуск
	МенеджерЛицензий.ОкноУстановкиСвязи = Ложь;
	МенеджерЛицензий.ПараметрыСвязи = "host=" + ИмяСервераСЛК + ";port=" + ПортСервераСЛК;
	Если НЕ МенеджерЛицензий.Запуск("59CC", Ложь) Тогда
		ВызватьИсключение МенеджерЛицензий.ПолучитьОписаниеОшибки();
	КонецЕсли;
	
	// Создание менеджера объектов
	Попытка
		МенеджерОбъектов = ВнешниеОбработки.Создать(МенеджерЛицензий.МенеджерОбъектов, БезопасныйРежим());
		МенеджерОбъектов.УстановитьМенеджерЛицензий(МенеджерЛицензий);
	Исключение
		ВызватьИсключение "Ошибка создания менеджера объектов СЛК: " + ОписаниеОшибки();
	КонецПопытки;
	
	Возврат МенеджерОбъектов;
	
КонецФункции

// Завершение работы
Процедура Стоп() Экспорт
 ЭтоКлиентСервернаяБаза = Не Найти(ВРег(СтрокаСоединенияИнформационнойБазы()), "FILE=");
 Если ЭтоКлиентСервернаяБаза Тогда
  Попытка
   Менеджер = Получить();
   Менеджер.ОсвободитьЛицензиюСеанса();
  Исключение 
  КонецПопытки
 КонецЕсли;
КонецПроцедуры