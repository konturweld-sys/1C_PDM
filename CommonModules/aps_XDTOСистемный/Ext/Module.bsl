#Если НЕ МобильноеПриложениеСервер Тогда   
	
#Область ПрограммныйИнтерфейс	
	
// Функция определяет, были ли внесены изменения в модель XDTO
// Параметры:
//		itemXDTO - ОбъектXDTO, объект модели XDTO
// Возвращаемое значение:
//		Булево - Истина, если модель была изменена
// Пример:
//		ФлагНаличия = aps_НаличиеИзмененийВМоделиXDTO( itemXDTO );
//
Функция aps_НаличиеИзмененийВМоделиXDTO( parentXDTO ) Экспорт 
	Если parentXDTO.modified=Истина Тогда 
		Возврат Истина;
	КонецЕсли;
	
	Для Каждого itemXDTO Из parentXDTO.items Цикл 
		ФлагНаличия = aps_НаличиеИзмененийВМоделиXDTO( itemXDTO );
		Если ФлагНаличия Тогда 
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
КонецФункции

// Процедура сохраняет изменения в базе данных, внесенные при редактировании рабочей копии
// Параметры:
//		parentXDTO - объект модели XDTO,
//		СтруктураПараметровСобытий - структура параметров оповещения для обработки событий
//		ФлагПроведенияИзвещения - Булево, признак сохранения xdto-модели через извещение
// Пример:
//		aps_СохранитьИзмененияРедактированияXDTO(itemXDTO, СтруктураПараметровСобытий, ФлагПроведенияИзвещения, ФлагПодстановкиЭлементов, ?(КолУровней=Неопределено, Неопределено, КолУровней-1));
//
Процедура aps_СохранитьИзмененияРедактированияXDTO( parentXDTO, СтруктураПараметровСобытий = Неопределено, ФлагПроведенияИзвещения = Ложь, ФлагПодстановкиЭлементов = Ложь, КолУровней = Неопределено ) Экспорт 
	
	Если КолУровней = 0 Тогда 
		Возврат;
	КонецЕсли;
	
	Если parentXDTO.refLinkGroup Тогда 
		Возврат;
	КонецЕсли;
	
	МодульСозданияОбъектов	 = Обработки.aps_СозданиеОбъектов.Создать();
	МодульСозданияПараметров = Обработки.aps_СозданиеПараметров.Создать();
	МодульПравДоступа		 = Обработки.aps_ПраваДоступа.Создать();
	
	Если ФлагПроведенияИзвещения=Истина Тогда 
		ОбъектПраваДляПроверки=Справочники.aps_Права.ИзменениеИИ;
	Иначе 
		ОбъектПраваДляПроверки=Справочники.aps_Права.Изменение;
	КонецЕсли;
	
	/////////////////////////////////////////////////////////////////////////////
	// подготовить структуру параметров оповещения для обработки событий
	itemXDTONotify = parentXDTO.Владелец();
	Если itemXDTONotify<>Неопределено И itemXDTONotify.refLinkGroup Тогда 
		itemXDTONotify=itemXDTONotify.Владелец();
	КонецЕсли;

	Если СтруктураПараметровСобытий <> Неопределено Тогда 
		СтруктураПараметровСобытий.Очистить();
	Иначе 
		СтруктураПараметровСобытий = Новый Структура();
	КонецЕсли;
	СтруктураПараметровСобытий.Вставить("item",?(itemXDTONotify<>Неопределено,itemXDTONotify.element,Неопределено));
	СтруктураПараметровСобытий.Вставить("itemXDTO",itemXDTONotify);
	
	#Если Сервер Тогда 
	// передать структуру параметров оповещения в обработки создания объектов и параметров
	МодульСозданияОбъектов.aps_СтруктураПараметровОповещенияНаСервере = СтруктураПараметровСобытий;
	МодульСозданияПараметров.aps_СтруктураПараметровОповещенияНаСервере = СтруктураПараметровСобытий;
	#КонецЕсли
	
	parentItem = parentXDTO.element;
	
	
	РазрешеноИзменение=Ложь;
	Если parentXDTO.created=Истина Тогда 
		// новый элемент записываем принудительно
		РазрешеноИзменение=Истина;
		
	ИначеЕсли parentXDTO.modified=Истина Тогда 
		// проверяем право изменения родителя
		РазрешеноИзменение=МодульПравДоступа.aps_ПроверитьОбъектПрава(ОбъектПраваДляПроверки, parentItem, parentItem.GMOD);
		
	КонецЕсли;
	
	
	parentObject=Неопределено;
	
	Если parentXDTO.created=Истина Или parentXDTO.modified=Истина Тогда 
		
		aps_ВосстановлениеСсылочнойЦелостностиМоделиXDTO(parentXDTO);
		
		Попытка
			НачатьТранзакцию();
				Если parentXDTO.created=Истина Тогда 
					Если parentXDTO.element.ПолучитьОбъект()<>Неопределено И НЕ parentXDTO.element.ПометкаУдаления Тогда 
						parentObject=parentXDTO.element.ПолучитьОбъект(); // уже создан
					Иначе 
						Если parentXDTO.element.ПометкаУдаления Тогда 
							parentXDTO.element.ПолучитьОбъект().Удалить(); // удалить помеченный на удаление элемент из базы
						КонецЕсли;
						// создать новый элемент
						parentObject=МодульСозданияОбъектов.aps_СозданиеОбъектаPDM(parentXDTO.elementType, Новый ДеревоЗначений(), parentXDTO.element);
					КонецЕсли;
				Иначе // изменить существующий элемент
					parentObject=parentXDTO.element.ПолучитьОбъект();
				КонецЕсли;
				
				
				массивПараметровXDTO=aps_СформироватьМассивПараметровИзМоделиXDTO(parentXDTO,, Ложь); // получить параметры элемента
				массивПараметровИзМодели=Новый Массив(); // массив ссылок на параметры
				Для Каждого parameterXDTO Из массивПараметровXDTO Цикл 
					Если parameterXDTO.property<>Неопределено Тогда 
						массивПараметровИзМодели.Добавить(parameterXDTO.reference);
					КонецЕсли;
				КонецЦикла;
				
				НаборПараметровИзменен=НЕ aps_МассивыРавны(массивПараметровИзМодели, parentObject.Параметры.ВыгрузитьКолонку("Параметр"));
				Если НаборПараметровИзменен Тогда 
					Если РазрешеноИзменение Тогда // очистить набор параметров
						parentObject.Параметры.Очистить();
					Иначе 
						modified=Истина;
					КонецЕсли;					
				КонецЕсли;
				
				МодифицированностьПараметров=Ложь; // если значения параметров менялись, нужно проверить уникальность
				Для Каждого parameterXDTO Из массивПараметровXDTO Цикл 
					группаПараметров=Справочники[parameterXDTO.reference.Метаданные().Имя].ПустаяСсылка();
					Если parameterXDTO.Владелец()<>Неопределено И parameterXDTO.Владелец().Тип()=ФабрикаXDTO.Тип("http://appius.ru/pdm", "parameter") Тогда 
						группаПараметров=parameterXDTO.Владелец().reference;
					КонецЕсли;
					
					Если parameterXDTO.property=Неопределено Или (НаборПараметровИзменен И РазрешеноИзменение) Тогда 
						// создать (наследовать) параметр
						МодульСозданияПараметров.aps_СозданиеПараметра(parentObject, parameterXDTO.description, parameterXDTO.property, parameterXDTO.value, parameterXDTO.property=Неопределено, группаПараметров, parameterXDTO.unit, parameterXDTO.reference);
					КонецЕсли;
					
					МодифицированностьПараметра=ПараметрXDTOИзменен(parameterXDTO, группаПараметров);
					Если МодифицированностьПараметра Тогда 
						Если parameterXDTO.property<>Неопределено И НЕ МодульПравДоступа.aps_ПроверитьОбъектПрава(ОбъектПраваДляПроверки, parameterXDTO.reference, parameterXDTO.reference.GMOD) Тогда 
							// нет права изменения параметра
							Если ОбъектПраваДляПроверки = Справочники.aps_Права.Изменение Тогда 
								СтрокаСообщения = НСтр("ru = 'Отсутствует право изменения!'; en_US = 'Change permission is missing!'");
							Иначе 
								СтрокаСообщения = НСтр("ru = 'Отсутствует право проведения извещения об изменении!'; en_US = 'Permission of posting change request is missing!'");
							КонецЕсли;
							Сообщить(ПараметрыСеанса.aps_ИмяПродукта+НСтр("ru = 'Элемент <'; en_US = 'The <'")+parentXDTO.description+НСтр("ru = '>. Параметр <'; en_US = '> item. The <'")+parameterXDTO.description
								+НСтр("ru = '>. '; en_US = '> parameter. '")+СтрокаСообщения, СтатусСообщения.Внимание);
							parameter_modified=Истина;
							Продолжить;
						КонецЕсли;
					КонецЕсли;
					
					// изменить существующий параметр
					Если МодифицированностьПараметра И МодульСозданияПараметров.aps_ИзменениеПараметра(parameterXDTO.reference, parameterXDTO.description, parameterXDTO.value, группаПараметров, parameterXDTO.unit) Тогда 
						МодифицированностьПараметров=Истина;
					КонецЕсли;
				КонецЦикла;
				
				Если parentObject.ВидЭлемента <> parentXDTO.elementType Тогда 
					Если РазрешеноИзменение Тогда // записать вид элемента
						parentObject.ВидЭлемента = parentXDTO.elementType;
					Иначе 
						modified=Истина;
					КонецЕсли;
				КонецЕсли;
				
				Если parentObject.ИндексКартинки <> parentXDTO.pictureIndex Тогда 
					Если РазрешеноИзменение Тогда // записать индекс картинки
						parentObject.ИндексКартинки = parentXDTO.pictureIndex;
					Иначе 
						modified=Истина;
					КонецЕсли;
				КонецЕсли;
				
				Если parentObject.HTMLКонтент <> parentXDTO.htmlContent Тогда 
					Если РазрешеноИзменение Тогда // записать HTML-контент
						parentObject.HTMLКонтент = parentXDTO.htmlContent;
					Иначе 
						modified=Истина;
					КонецЕсли;
				КонецЕсли;
					
				Если parentXDTO.pictureBinaryData <> Неопределено И parentObject.ОсновноеИзображение.Получить()=Неопределено Тогда
					Если РазрешеноИзменение Тогда // записать основное изображение (для импорта)
						parentObject.ОсновноеИзображение = Новый ХранилищеЗначения(Новый Картинка(parentXDTO.pictureBinaryData.__content));
					Иначе 
						modified=Истина;
					КонецЕсли;
				КонецЕсли;
				
				
				Если parentXDTO.presentation.Количество() > 0 Тогда 
					массивПараметровИзПредставления=parentObject.ПредставлениеЭлемента.ВыгрузитьКолонку("Параметр"); // массив параметров из представления
					Для i=0 По массивПараметровИзПредставления.Количество()-1 Цикл 
						Если ТипЗнч(массивПараметровИзПредставления[i])=Тип("Строка") Тогда 
							массивПараметровИзПредставления[i]=СтрЗаменить(массивПараметровИзПредставления[i]," ",Символы.НПП);
						КонецЕсли;
					КонецЦикла;
					
					Если НЕ aps_МассивыРавны(parentXDTO.presentation, массивПараметровИзПредставления) Тогда 
						Если РазрешеноИзменение Тогда // записать представление из модели (для импорта)
							parentObject.ПредставлениеЭлемента.Очистить();
							Для Каждого ПараметрИлиСтрока Из parentXDTO.presentation Цикл 
								parentObject.ПредставлениеЭлемента.Добавить().Параметр=ПараметрИлиСтрока;
							КонецЦикла;
						Иначе 
							modified=Истина;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				
				Если parentObject.ПредставлениеЭлемента.Количество()=0 Тогда
					Если РазрешеноИзменение Тогда // записать представление по умолчанию для вида
						МодульСозданияОбъектов.aps_СоздатьПредставление(parentObject);
						Если parentObject.ПредставлениеЭлемента.Количество()=0 Тогда 
							parentObject.ПредставлениеЭлемента.Добавить().Параметр=parentXDTO.description;
						КонецЕсли;
					Иначе 
						modified=Истина;
					КонецЕсли;
				КонецЕсли;
				
				
				Если parentObject.Модифицированность() Или МодифицированностьПараметров Тогда 
					parentObject.Записать();
				КонецЕсли;
				
			ЗафиксироватьТранзакцию();
				
			parentXDTO.created=Неопределено;
		Исключение
			ОтменитьТранзакцию();
			Если ТранзакцияАктивна() Тогда 
				ВызватьИсключение КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			КонецЕсли;
			
			Сообщить(ПараметрыСеанса.aps_ИмяПродукта+НСтр("ru = 'Элемент <'; en_US = 'The <'")+parentXDTO.description
				+НСтр("ru = '>. Невозможно записать элемент:'; en_US = '> item. Cannot write the item:'")+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), СтатусСообщения.Внимание);
			parentXDTO.modified=Истина;
				
			СсылкаНовогоИлиСуществующего=Неопределено;	
			Если parentObject<>Неопределено И parentObject.ДополнительныеСвойства.Свойство("СуществующийЭлемент", СсылкаНовогоИлиСуществующего)
						И ФлагПодстановкиЭлементов=Истина Тогда 
				// подставить существующий элемент в xdto-модель для последующего заимствования
				parentXDTO.element = СериализаторXDTO.ЗаписатьXDTO(СсылкаНовогоИлиСуществующего);
				aps_ОбновитьДанныеМоделиXDTO(parentXDTO);
				parentXDTO.items.Очистить();
				
				parentXDTO.created	= Неопределено;
				parentXDTO.modified	= Неопределено;
				
				parentItemXDTO=parentXDTO.Владелец();
				Если parentItemXDTO<>Неопределено Тогда 
					Если parentXDTO.added<>Истина Тогда 
						parentXDTO.replaced=Истина; // отметка замены элемента
					КонецЕсли;
					Если parentItemXDTO.refLinkGroup Тогда 
						parentItemXDTO=parentItemXDTO.Владелец();
					КонецЕсли;
					parentItemXDTO.modified=Истина;
				КонецЕсли;
			КонецЕсли;
			Возврат;
		КонецПопытки;
	КонецЕсли; // Если parentXDTO.created=Истина Или parentXDTO.modified=Истина Тогда  

	Если parentObject <> Неопределено Тогда 
		ТабЧасть = Неопределено;
		Если parentObject.Метаданные().ТабличныеЧасти.Найти("ПодчиненныеЭлементыТехнологии")<>Неопределено Тогда 
			ТабЧасть = parentObject.ПодчиненныеЭлементыТехнологии;
		ИначеЕсли parentObject.Метаданные().ТабличныеЧасти.Найти("ЭлементыРесурса")<>Неопределено Тогда 
			ТабЧасть = parentObject.ЭлементыРесурса;
		КонецЕсли;
		
		Если ТабЧасть<>Неопределено И aps_НайтиВМассивеXDTO(parentXDTO.items, Новый Структура("refLinkGroup", Ложь))<>Неопределено Тогда 
			массивПодчиненныхЭлементовИзМодели=Новый Массив(); массивПодчиненныхВидовСвязейИзМодели=Новый Массив();
			Для Каждого itemXDTO Из parentXDTO.items Цикл 
				Если НЕ itemXDTO.refLinkGroup И НЕ ЗначениеЗаполнено(itemXDTO.link) И itemXDTO.deleted<>Истина Тогда 
					массивПодчиненныхЭлементовИзМодели.Добавить(itemXDTO.element);
					массивПодчиненныхВидовСвязейИзМодели.Добавить(itemXDTO.linkType);
				КонецЕсли;
			КонецЦикла;
			
			СоставПодчиненныхИзменен=(НЕ aps_МассивыРавны(массивПодчиненныхЭлементовИзМодели, ТабЧасть.ВыгрузитьКолонку("ЭлементСсылка"))
										ИЛИ НЕ aps_МассивыРавны(массивПодчиненныхВидовСвязейИзМодели, ТабЧасть.ВыгрузитьКолонку("ВидСвязи")));
			Если СоставПодчиненныхИзменен Тогда 
				Если РазрешеноИзменение Тогда 
					ТабЧасть.Очистить(); // очистить табличную часть подчиненных
				Иначе 
					modified=Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли; // Если parentObject <> Неопределено Тогда 

	
	// право удаления элементов из структуры родителя
	РазрешеноУдалениеИзСтруктуры=Ложь;
	Если РазрешеноИзменение И aps_НайтиВМоделиXDTO(parentXDTO, Новый Структура("deleted", Истина)).Количество() <> 0 Тогда 
		Запрещено=Ложь;
		МодульПравДоступа.aps_ПроверитьОбъектПрава(Справочники.aps_Права.УдалениеИзСтруктуры, parentItem, parentItem.GMOD, Запрещено);
		РазрешеноУдалениеИзСтруктуры=НЕ Запрещено;
		Если НЕ РазрешеноУдалениеИзСтруктуры И НЕ parentXDTO.refLinkGroup Тогда 
			Сообщить(ПараметрыСеанса.aps_ИмяПродукта+НСтр("ru = 'Элемент <'; en_US = 'The <'")+parentXDTO.description+НСтр("ru = '>. Запрещено удаление элементов из структуры!'; en_US = '> item. Deleting items from structure is prohibited!'"), СтатусСообщения.Внимание);
		КонецЕсли;
	КонецЕсли;
	
	
	НомерСтроки  =1; // номер строки в табличной части
	ПорядокВывода=1; // порядок вывода элементной связи
	
	
	
	МассивXDTO=aps_НайтиВМоделиXDTO(parentXDTO, Новый Структура("refLinkGroup", Ложь)); МассивXDTOКУдалению=Новый Массив();
	
	МассивСвязейИзМодели=Новый Массив();
	
	Для Каждого itemXDTO Из МассивXDTO Цикл 
		item=itemXDTO.element;
		
		Если КолУровней = Неопределено Или КолУровней > 0 Тогда 
			aps_СохранитьИзмененияРедактированияXDTO(itemXDTO, СтруктураПараметровСобытий, ФлагПроведенияИзвещения, ФлагПодстановкиЭлементов, ?(КолУровней=Неопределено, Неопределено, КолУровней-1));
		КонецЕсли;
		
		Если itemXDTO.created=Истина Или itemXDTO.element<>item Тогда 
			// не удалось создать новый элемент, пропустить
			modified=Истина;
			Продолжить;
		КонецЕсли;
		
		Если parentXDTO.modified=Истина Тогда 	
			// право удаления элемента
			РазрешеноУдаление=Ложь;
			Если РазрешеноИзменение И РазрешеноУдалениеИзСтруктуры И itemXDTO.deleted=Истина Тогда 
				Запрещено=Ложь;
				МодульПравДоступа.aps_ПроверитьОбъектПрава(Справочники.aps_Права.Удаление, itemXDTO.element, itemXDTO.element.GMOD, Запрещено);
				РазрешеноУдаление=НЕ Запрещено;
				Если НЕ РазрешеноУдаление Тогда 
					Сообщить(ПараметрыСеанса.aps_ИмяПродукта+НСтр("ru = 'Элемент <'; en_US = 'The <'")+itemXDTO.description+НСтр("ru = '>. Запрещено удаление!'; en_US = '> item. Deleting is prohibited!'"), СтатусСообщения.Внимание);
				КонецЕсли;
			КонецЕсли;
			
				
			Если ЗначениеЗаполнено(itemXDTO.link) Тогда 
				Если itemXDTO.deleted=Истина Тогда 
					Если РазрешеноУдаление Тогда 
						Попытка // установить пометку удаления на связь
							itemXDTO.link.ПолучитьОбъект().УстановитьПометкуУдаления(Истина);
							МассивXDTOКУдалению.Добавить(itemXDTO); Продолжить;
						Исключение
							Сообщить(ПараметрыСеанса.aps_ИмяПродукта+НСтр("ru = 'Элемент <'; en_US = 'The <'")+itemXDTO.description
								+НСтр("ru = '>. Невозможно записать связь:'; en_US = '>. Cannot write the link:'")+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), СтатусСообщения.Внимание);
							modified=Истина;
						КонецПопытки;
					Иначе 
						modified=Истина;
					КонецЕсли;
					
				Иначе // создать или изменить связь
				    
					Попытка
						НачатьТранзакцию();
							ОбъектСвязи=Неопределено;
							
							Если itemXDTO.added=Истина Тогда
								Если РазрешеноИзменение Тогда 
									Если itemXDTO.link.ПолучитьОбъект() <> Неопределено И НЕ itemXDTO.link.ПометкаУдаления Тогда 
										ОбъектСвязи=itemXDTO.link.ПолучитьОбъект(); // уже создана
									Иначе 
										Если itemXDTO.link.ПометкаУдаления Тогда 
											itemXDTO.link.ПолучитьОбъект().Удалить(); // удалить помеченную на удаление связь из базы
										КонецЕсли;
										
										Если itemXDTO.linkType = Перечисления.aps_ВидыСвязей.Личное Или itemXDTO.linkType = Перечисления.aps_ВидыСвязей.Справочник Тогда 
											ВидЭлементаСвязи = Неопределено;
										ИначеЕсли itemXDTO.linkType = Перечисления.aps_ВидыСвязей.СоставИзделия Тогда 
											ВидЭлементаСвязи = Справочники.aps_ВидыЭлементов.СвязьСостава;
										Иначе 
											ВидЭлементаСвязи = Справочники.aps_ВидыЭлементов.СвязьТехнологии;
										КонецЕсли;
									
										Если ВидЭлементаСвязи=Неопределено Тогда // создать новую связь
											// вертикальная связь
											ОбъектСвязи=МодульСозданияОбъектов.aps_СозданиеВертикальнойСвязи(parentItem, itemXDTO.element, itemXDTO.linkType, itemXDTO.link);
										Иначе
											// элементная связь
											Если ТипЗнч(itemXDTO.linkType) = Тип("СправочникСсылка.aps_ШаблоныТехнологическихСвязей") И itemXDTO.linkType.КонтекстнаяСвязь
													И ЗначениеЗаполнено(parentXDTO.link) И ТипЗнч(parentXDTO.link) = Тип("СправочникСсылка.aps_ЭлементыСвязей") Тогда 
												РодительСсылка = parentXDTO.link; // родителем будет элементная связь
											Иначе 
												РодительСсылка = parentItem;
											КонецЕсли;
											ОбъектСвязи=МодульСозданияОбъектов.aps_СозданиеЭлементнойСвязи(ВидЭлементаСвязи, РодительСсылка, itemXDTO.element, itemXDTO.linkType, Новый ДеревоЗначений(), itemXDTO.link);
										КонецЕсли;
									КонецЕсли;
								Иначе 
									modified=Истина;
								КонецЕсли; // Если РазрешеноИзменение Тогда 
								
							Иначе // изменить существующую связь
								ОбъектСвязи=itemXDTO.link.ПолучитьОбъект();
							КонецЕсли; 
						
							
							Если itemXDTO.replaced=Истина И ОбъектСвязи<>Неопределено И ОбъектСвязи.ПотомокСсылка<>itemXDTO.element Тогда 
								Если РазрешеноИзменение Тогда // записать ссылку на потомка
									ОбъектСвязи.ПотомокСсылка=itemXDTO.element;
									ОбъектСвязи.ДополнительныеСвойства.Вставить("ПроверитьРекурсивноеВхождение", Истина);
								Иначе 
									modified=Истина;
								КонецЕсли;
							КонецЕсли;
							Если ОбъектСвязи<>Неопределено И ОбъектСвязи.Метаданные().Реквизиты.Найти("ПорядокВывода")<>Неопределено Тогда 
								Если ОбъектСвязи.ПорядокВывода<>ПорядокВывода Тогда 
									Если РазрешеноИзменение Тогда // записать порядок вывода
										ОбъектСвязи.ПорядокВывода=ПорядокВывода;
									Иначе 
										modified=Истина;
									КонецЕсли;
								КонецЕсли;
							КонецЕсли;
						
						    Если ОбъектСвязи<>Неопределено И ОбъектСвязи.Метаданные().ТабличныеЧасти.Найти("Параметры")<>Неопределено Тогда 
								массивПараметровXDTO=aps_СформироватьМассивПараметровИзМоделиXDTO(itemXDTO,, Истина); // получить параметры связи
								массивПараметровИзМодели=Новый Массив(); // массив ссылок на параметры
								Для Каждого parameterXDTO Из массивПараметровXDTO Цикл 
									Если parameterXDTO.property<>Неопределено Тогда 
										массивПараметровИзМодели.Добавить(parameterXDTO.reference);
									КонецЕсли;
								КонецЦикла;
								
								НаборПараметровСвязиИзменен=НЕ aps_МассивыРавны(массивПараметровИзМодели, ОбъектСвязи.Параметры.ВыгрузитьКолонку("Параметр"));
								Если НаборПараметровСвязиИзменен Тогда 
									Если РазрешеноИзменение Тогда // очистить набор параметров
										ОбъектСвязи.Параметры.Очистить();
									Иначе 
										modified=Истина;
									КонецЕсли;
								КонецЕсли;

								МодифицированностьПараметровСвязи=Ложь; 
								Для Каждого parameterXDTO Из массивПараметровXDTO Цикл 
									группаПараметров=Справочники[parameterXDTO.reference.Метаданные().Имя].ПустаяСсылка();
									Если parameterXDTO.Владелец()<>Неопределено И parameterXDTO.Владелец().Тип()=ФабрикаXDTO.Тип("http://appius.ru/pdm", "parameter") Тогда 
										группаПараметров=parameterXDTO.Владелец().reference;
									КонецЕсли;
									
									Если parameterXDTO.property=Неопределено Или (НаборПараметровСвязиИзменен И РазрешеноИзменение) Тогда 
										// создать (наследовать) параметр
										МодульСозданияПараметров.aps_СозданиеПараметра(ОбъектСвязи, parameterXDTO.description, parameterXDTO.property, parameterXDTO.value, parameterXDTO.property=Неопределено, группаПараметров, parameterXDTO.unit, parameterXDTO.reference);
									КонецЕсли;
									
									МодифицированностьПараметраСвязи=ПараметрXDTOИзменен(parameterXDTO, группаПараметров);
									Если МодифицированностьПараметраСвязи Тогда 
										Если parameterXDTO.property<>Неопределено И НЕ МодульПравДоступа.aps_ПроверитьОбъектПрава(ОбъектПраваДляПроверки, parameterXDTO.reference, parameterXDTO.reference.GMOD) Тогда 
											// нет права изменения параметра
											Если ОбъектПраваДляПроверки = Справочники.aps_Права.Изменение Тогда 
												СтрокаСообщения = НСтр("ru = 'Отсутствует право изменения!'; en_US = 'Change permission is missing!'");
											Иначе 
												СтрокаСообщения = НСтр("ru = 'Отсутствует право проведения извещения об изменении!'; en_US = 'Permission of posting change request is missing!'");
											КонецЕсли;
											Сообщить(ПараметрыСеанса.aps_ИмяПродукта+НСтр("ru = 'Элемент <'; en_US = 'The <'")+itemXDTO.description+НСтр("ru = '>. Параметр связи <'; en_US = '> item. The <'")+parameterXDTO.description
												+НСтр("ru = '>. '; en_US = '> link parameter. '")+СтрокаСообщения, СтатусСообщения.Внимание);
											parameter_modified=Истина;
											Продолжить;
										КонецЕсли;
									КонецЕсли;
									
									// изменить существующий параметр
									Если МодифицированностьПараметраСвязи И МодульСозданияПараметров.aps_ИзменениеПараметра(parameterXDTO.reference, parameterXDTO.description, parameterXDTO.value, группаПараметров, parameterXDTO.unit) Тогда 
										МодифицированностьПараметровСвязи=Истина;
									КонецЕсли;
								КонецЦикла;
							КонецЕсли; // Если ОбъектСвязи<>Неопределено И ОбъектСвязи.Метаданные().ТабличныеЧасти.Найти("Параметры")<>Неопределено Тогда
						
							Если ОбъектСвязи<>Неопределено И ОбъектСвязи.Модифицированность() Тогда 
								ОбъектСвязи.Записать();
							КонецЕсли;
							
						ЗафиксироватьТранзакцию();
						
						Если РазрешеноИзменение Тогда 
							itemXDTO.added=Неопределено;
							itemXDTO.replaced=Неопределено;
						КонецЕсли;
						
					Исключение
						ОтменитьТранзакцию();
						Если ТранзакцияАктивна() Тогда 
							ВызватьИсключение КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
						КонецЕсли;
						
						Сообщить(ПараметрыСеанса.aps_ИмяПродукта+НСтр("ru = 'Элемент <'; en_US = 'The <'")+itemXDTO.description
							+НСтр("ru = '>. Невозможно записать связь:'; en_US = '> item. Cannot write the link:'")+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), СтатусСообщения.Внимание);
						modified=Истина;
					КонецПопытки;
				КонецЕсли; // Если itemXDTO.deleted=Истина Тогда
				
				Если itemXDTO.link.Метаданные().Реквизиты.Найти("ПорядокВывода")<>Неопределено Тогда 
					// обновить порядковый номер в модели
					itemXDTO.sequenceNumber=ПорядокВывода;
					ПорядокВывода=ПорядокВывода+1;
				КонецЕсли;
				
				МассивСвязейИзМодели.Добавить(itemXDTO.link);
				
				
			ИначеЕсли НЕ itemXDTO.refLinkGroup И ТабЧасть<>Неопределено Тогда // нет ссылки на связь (из табличной части родителя)
				Если itemXDTO.deleted=Истина Тогда
					Если РазрешеноУдаление Тогда 
						МассивXDTOКУдалению.Добавить(itemXDTO); Продолжить;
					Иначе 
						modified=Истина;
					КонецЕсли;
				КонецЕсли;
				
				Если СоставПодчиненныхИзменен И РазрешеноИзменение Тогда 
					// добавить в табличную часть
					СтрокаТабЧасти = ТабЧасть.Добавить();
					СтрокаТабЧасти.ЭлементСсылка= itemXDTO.element;
					СтрокаТабЧасти.ВидСвязи		= itemXDTO.linkType;
				КонецЕсли;
				
				Если РазрешеноИзменение Тогда
					itemXDTO.added=Неопределено;
					itemXDTO.replaced=Неопределено;
				КонецЕсли;
				
				// обновить порядковый номер в модели
				itemXDTO.sequenceNumber=НомерСтроки;
				НомерСтроки=НомерСтроки+1;
			КонецЕсли; // Если ЗначениеЗаполнено(itemXDTO.link) Тогда
			
		КонецЕсли; // Если parentXDTO.modified=Истина Тогда
	КонецЦикла;
	
	// удаление объектов из xdto-модели
	Для Каждого itemXDTO Из МассивXDTOКУдалению Цикл 
		parentItemXDTO = itemXDTO.Владелец();
		aps_УдалитьИзМассиваXDTO(parentItemXDTO.items, itemXDTO);
		Если parentItemXDTO.refLinkGroup И parentItemXDTO.items.Количество()=0 Тогда 
			aps_УдалитьИзМассиваXDTO(parentItemXDTO.Владелец().items, parentItemXDTO);
		КонецЕсли;
		itemXDTO.deleted=Неопределено;
	КонецЦикла;
	
	Если РазрешеноИзменение Тогда  
		Если parentObject<>Неопределено И parentObject.Модифицированность() Тогда 
			Попытка
				parentObject.ДополнительныеСвойства.Вставить("ПроверитьУникальность", Ложь);
				parentObject.Записать(); // записать состав табличной части
			Исключение
				Если ТранзакцияАктивна() Тогда 
					ВызватьИсключение КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
				КонецЕсли;
				
				Сообщить(ПараметрыСеанса.aps_ИмяПродукта+НСтр("ru = 'Элемент <'; en_US = 'The <'")+parentXDTO.description
					+НСтр("ru = '>. Невозможно записать элемент:'; en_US = '> item. Cannot write the item:'")+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), СтатусСообщения.Внимание);
				parentXDTO.modified=Истина;
				Возврат;
			КонецПопытки;
		КонецЕсли;
		
	КонецЕсли;
	
	
	Если modified<>Истина И parameter_modified<>Истина Тогда 
		parentXDTO.modified=Неопределено; // сбросить флаг модифицированности
	КонецЕсли;
	
	Если НЕ РазрешеноИзменение И modified=Истина Тогда // сообщить о невозможности изменения 
		Если ОбъектПраваДляПроверки = Справочники.aps_Права.Изменение Тогда 
			Сообщить(ПараметрыСеанса.aps_ИмяПродукта+НСтр("ru = 'Элемент <'; en_US = 'The <'")+parentXDTO.description+НСтр("ru = '>. Отсутствует право изменения!'; en_US = '> item. Change permission is missing!'"), СтатусСообщения.Внимание);
		Иначе 
			Сообщить(ПараметрыСеанса.aps_ИмяПродукта+НСтр("ru = 'Элемент <'; en_US = 'The <'")+parentXDTO.description+НСтр("ru = '>. Отсутствует право проведения извещения об изменении!'; en_US = '> item. Permission of posting change request is missing!'"), СтатусСообщения.Внимание);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Процедура отменяет изменения, внесенные при редактировании рабочей копии
// Параметры:
//		parentXDTO - объект модели XDTO
//		ИнверсияИзменений - булево
// Пример:
//		aps_ОтменитьИзмененияРедактированияXDTO(itemXDTO, ИнверсияИзменений);
//
Процедура aps_ОтменитьИзмененияРедактированияXDTO( parentXDTO, ИнверсияИзменений = Ложь ) Экспорт 
	
	parentItemXDTO = ?(parentXDTO.refLinkGroup, parentXDTO.Владелец(), parentXDTO);
	parentItem = parentItemXDTO.element;
	
	ТабЧасть = Неопределено;
	Если parentItem.Метаданные().ТабличныеЧасти.Найти("ПодчиненныеЭлементыТехнологии")<>Неопределено Тогда 
		ТабЧасть = parentItem.ПодчиненныеЭлементыТехнологии;
	ИначеЕсли parentItem.Метаданные().ТабличныеЧасти.Найти("ЭлементыРесурса")<>Неопределено Тогда 
		ТабЧасть = parentItem.ЭлементыРесурса;
	КонецЕсли;
	
	i=0;
	Пока i < parentXDTO.items.Количество() Цикл 
		itemXDTO = parentXDTO.items[i];
		
		aps_ОтменитьИзмененияРедактированияXDTO(itemXDTO, ИнверсияИзменений);
		
		Если itemXDTO.created=Истина ИЛИ itemXDTO.added=Истина Тогда 
			Если ИнверсияИзменений Тогда 
				itemXDTO.deleted=Истина;
				itemXDTO.created=Неопределено;
				itemXDTO.added	=Неопределено;
				i=i+1;
			Иначе 
				parentXDTO.items.Удалить(i);
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		
		Если itemXDTO.replaced=Истина Тогда 
			Если ЗначениеЗаполнено(itemXDTO.link) Тогда 
				itemXDTO.element = СериализаторXDTO.ЗаписатьXDTO(itemXDTO.link.ПотомокСсылка);
			ИначеЕсли ТабЧасть<>Неопределено Тогда 
				СтрокаТабЧасти = ТабЧасть.Найти(itemXDTO.sequenceNumber,"НомерСтроки");
				Если СтрокаТабЧасти <> Неопределено Тогда 
					itemXDTO.element = СериализаторXDTO.ЗаписатьXDTO(СтрокаТабЧасти.ЭлементСсылка);
				КонецЕсли;
			КонецЕсли;
			aps_ОбновитьДанныеМоделиXDTO(itemXDTO);
			itemXDTO.items.Очистить();
			itemXDTO.replaced=?(ИнверсияИзменений, Истина, Неопределено);
		КонецЕсли;
		
		Если itemXDTO.deleted=Истина Тогда 
			itemXDTO.added	=?(ИнверсияИзменений, Истина, Неопределено);
			itemXDTO.deleted=Неопределено;
		КонецЕсли;
		
		Если parentItemXDTO.modified=Истина И ЗначениеЗаполнено(itemXDTO.link) И itemXDTO.link.Метаданные().ТабличныеЧасти.Найти("Параметры") <> Неопределено Тогда 
			aps_УдалитьИзМассиваXDTO(itemXDTO.parameters, Новый Структура("linkParameter", Истина));
			aps_ЗаполнитьПараметрыМоделиПоТабЧасти(itemXDTO, itemXDTO.link.Параметры, Истина);
		КонецЕсли;
		
		Если itemXDTO.refLinkGroup И itemXDTO.items.Количество()=0 Тогда 
			parentXDTO.items.Удалить(i);
			Продолжить;
		КонецЕсли;
		
		i=i+1;
	КонецЦикла;
	
	// восстановить последовательность объектов в модели
	Для i=0 По parentXDTO.items.Количество()-2 Цикл 
		Для j=i+1 По parentXDTO.items.Количество()-1 Цикл 
			Если parentXDTO.items[j].sequenceNumber <> Неопределено И parentXDTO.items[i].sequenceNumber <> Неопределено
						И parentXDTO.items[j].sequenceNumber < parentXDTO.items[i].sequenceNumber Тогда 
				itemXDTO = parentXDTO.items[i];
				parentXDTO.items[i] = parentXDTO.items[j];
				parentXDTO.items[j] = itemXDTO;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Если parentXDTO.modified=Истина И ЗначениеЗаполнено(parentXDTO.element) Тогда 
		// прочитать данные из БД и записать в модель
		aps_ОбновитьДанныеМоделиXDTO(parentXDTO);
		parentXDTO.modified=?(ИнверсияИзменений, Истина, Неопределено);;
	КонецЕсли;
	
КонецПроцедуры

// Процедура находит ссылки типа "Объект не найден" в модели и помечает соответствующими флагами check-out
// (необходимо для корректного принятия изменений)
//
// Параметры:
//		itemXDTO - ОбъектXDTO, объект модели XDTO
// Пример:
//		aps_ВосстановлениеСсылочнойЦелостностиМоделиXDTO(itemXDTO);
//
Процедура aps_ВосстановлениеСсылочнойЦелостностиМоделиXDTO( parentXDTO ) Экспорт 
	МассивТипов=Новый Массив();
	МассивТипов.Добавить(Тип("СправочникСсылка.aps_ЭлементыИзделия"));
	МассивТипов.Добавить(Тип("СправочникСсылка.aps_ЭлементыСправочников"));
	МассивТипов.Добавить(Тип("СправочникСсылка.aps_ЭлементыТехнологии"));
	МассивТипов.Добавить(Тип("СправочникСсылка.aps_ЭлементыСвязей"));
	МассивТипов.Добавить(Тип("СправочникСсылка.aps_ВертикальныеСвязи"));
	ОписаниеТипов=Новый ОписаниеТипов(МассивТипов);
	
	СуществующиеСсылки=Новый ТаблицаЗначений();
	СуществующиеСсылки.Колонки.Добавить("Ссылка", ОписаниеТипов);
	
	МассивXDTO=Новый Массив();
	aps_СформироватьМассивИзМоделиXDTO( parentXDTO, МассивXDTO );
	Для i=0 По МассивXDTO.Количество()-1 Цикл 
		СуществующиеСсылки.Добавить().Ссылка=МассивXDTO[i].element;
		СуществующиеСсылки.Добавить().Ссылка=МассивXDTO[i].link;
	КонецЦикла;
	
	
	МенеджерВТ=Новый МенеджерВременныхТаблиц;
	
	Запрос=Новый Запрос;
	Запрос.МенеджерВременныхТаблиц=МенеджерВТ;
	// Текст запроса для построения временной таблицы
	Запрос.Текст="ВЫБРАТЬ
	             |	ТаблицаСсылок.Ссылка КАК Ссылка
	             |ПОМЕСТИТЬ ВТСсылки
	             |ИЗ
	             |	&Данные КАК ТаблицаСсылок";
	Запрос.УстановитьПараметр("Данные",СуществующиеСсылки);
	Запрос.Выполнить();
	
	// Получаем таблицу из менеджера временных таблиц запроса
	Запрос.Текст="ВЫБРАТЬ
				 |	Ссылка КАК Ссылка, Ссылка.ПометкаУдаления КАК ПометкаУдаления
				 |ИЗ
				 |	ВТСсылки";
	СуществующиеСсылки=Запрос.Выполнить().Выгрузить();
	
	Для Каждого itemXDTO Из МассивXDTO Цикл 
		Если itemXDTO.refLinkGroup Тогда 
			Продолжить;
		КонецЕсли;
		
		parentItemXDTO=itemXDTO.Владелец();
		Если parentItemXDTO<>Неопределено И parentItemXDTO.refLinkGroup=Истина Тогда 
			parentItemXDTO=parentItemXDTO.Владелец();
		КонецЕсли;
		
		Если itemXDTO.element<>Неопределено Тогда 
			itemXDTO.created=Неопределено;
			НайденнаяСсылка=СуществующиеСсылки.Найти(itemXDTO.element);
			Если НайденнаяСсылка.ПометкаУдаления=NULL ИЛИ НайденнаяСсылка.ПометкаУдаления=Истина Тогда 
				itemXDTO.created =Истина;
				itemXDTO.modified=Истина;
				Если parentItemXDTO<>Неопределено Тогда 
					parentItemXDTO.modified=Истина;
				КонецЕсли;
			КонецЕсли;

		КонецЕсли;
			
		Если itemXDTO.link<>Неопределено Тогда 
			itemXDTO.added=Неопределено;
			НайденнаяСсылка=СуществующиеСсылки.Найти(itemXDTO.link);
			Если НайденнаяСсылка.ПометкаУдаления=NULL ИЛИ НайденнаяСсылка.ПометкаУдаления=Истина Тогда 
				itemXDTO.added=Истина;
				Если parentItemXDTO<>Неопределено Тогда 
					parentItemXDTO.modified=Истина;
				КонецЕсли;
			ИначеЕсли itemXDTO.created=Истина Тогда 
				itemXDTO.replaced=Истина; // заменить
				Если parentItemXDTO<>Неопределено Тогда 
					parentItemXDTO.modified=Истина;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

Функция ПараметрXDTOИзменен(parameterXDTO, Группа = Неопределено)
	ПараметрСсылка = parameterXDTO.reference;
	Если ПараметрСсылка.Наименование <> parameterXDTO.description Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если НЕ ПараметрСсылка.ЭтоГруппа Тогда
		Если Группа <> Неопределено И ПараметрСсылка.Родитель <> Группа Тогда 
			Возврат Истина;
		КонецЕсли;
		Если ПараметрСсылка.Значение <> ПараметрСсылка.Свойство.ТипЗначения.ПривестиЗначение(parameterXDTO.value) Тогда
			Возврат Истина;
		КонецЕсли;
		Если ПараметрСсылка.ЕдиницаИзмерения <> parameterXDTO.unit Тогда 
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ложь;
КонецФункции

#КонецОбласти

#КонецЕсли


