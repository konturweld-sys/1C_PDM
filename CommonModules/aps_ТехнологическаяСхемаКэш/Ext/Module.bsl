#Область ПрограммныйИнтерфейс

// Процедура заполняет ошибки в технологии
// Параметры:
//		ЗаписьРегистра - РегистрСведенийЗапись.aps_КэшированныеДанные
// Пример:
//		aps_ТехнологическаяСхемаКэш.ЗаполнениеОшибокТехнологии(ЗаписьРегистра);
//
Процедура ЗаполнениеОшибокТехнологии( ЗаписьРегистра ) Экспорт
	
	Ошибки = Новый Соответствие();
	
	ЕстьОшибки = Ложь;
	ЕстьПредупреждения = Ложь;
	
	Если ЗаписьРегистра.ВидНабора=Перечисления.ERPКорпВидыНаборов.Маршрут Тогда
		Если ЗначениеЗаполнено(ЗаписьРегистра.ЭлементСсылка2) Тогда
			Если НЕ ЗначениеЗаполнено(ЗаписьРегистра.ВремяВыполнения) Тогда
				Ошибки.Вставить(Перечисления.ПредупрежденияИОшибкиERP.ПредупреждениеНезаполненоШтучноеВремя);
				ЕстьПредупреждения = Истина;
			КонецЕсли;			
			Если НЕ ЗначениеЗаполнено(ЗаписьРегистра.РабочийЦентр) Тогда
				Ошибки.Вставить(Перечисления.ПредупрежденияИОшибкиERP.ПредупреждениеНезаполненРабочийЦентр);
				ЕстьПредупреждения = Истина;
			КонецЕсли;			
			Если НЕ ЗначениеЗаполнено(ЗаписьРегистра.ВидОперации) Тогда
				Ошибки.Вставить(Перечисления.ПредупрежденияИОшибкиERP.НезаполненВидОперации);
			    ЕстьОшибки = Истина;
			ИначеЕсли ЗаписьРегистра.ВидОперации.НормаВремени = 0 Тогда
				Ошибки.Вставить(Перечисления.ПредупрежденияИОшибкиERP.НезаполненаНормаВремениВВидеОперации);
				ЕстьПредупреждения = Истина;
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЗаписьРегистра.ВидСвязи) 
			 И (ЗаписьРегистра.ВидСвязи = Справочники.aps_ШаблоныТехнологическихСвязей.ОсновныеМатериалы
			 ИЛИ ЗаписьРегистра.ВидСвязи = Справочники.aps_ШаблоныТехнологическихСвязей.Комплектование)
			 ИЛИ ЗаписьРегистра.ВидНабора = Перечисления.ERPКорпВидыНаборов.ВыходноеИзделие Тогда
		
			Если НЕ ЗначениеЗаполнено(ЗаписьРегистра.Номенклатура) Тогда
				Ошибки.Вставить(Перечисления.ПредупрежденияИОшибкиERP.НесвязанСНоменклатурой);
				ЕстьОшибки = Истина;
			КонецЕсли;			
			Если НЕ ЗначениеЗаполнено(ЗаписьРегистра.Количество) Тогда
				Ошибки.Вставить(Перечисления.ПредупрежденияИОшибкиERP.КоличествоРавноНулю);
				ЕстьОшибки = Истина;
			КонецЕсли;			
			Если НЕ ЗначениеЗаполнено(ЗаписьРегистра.ЕдиницаИзмерения) Тогда
				Ошибки.Вставить(Перечисления.ПредупрежденияИОшибкиERP.НезаданаЕдиницаИзмерения);
				ЕстьОшибки = Истина;
			КонецЕсли;			
		КонецЕсли;
		
		Если Константы.aps_ТехСхемаПередаватьТолькоАрхивные.Получить() = Истина И 
			 ЗначениеЗаполнено(ЗаписьРегистра.Состояние) И 
			 ЗаписьРегистра.Состояние<>Перечисления.aps_СостоянияЭлемента.Архив Тогда 
			Ошибки.Вставить(Перечисления.ПредупрежденияИОшибкиERP.СостояниеЭлементаНеАрхив);
			ЕстьОшибки = Истина;
		КонецЕсли;
			
	КонецЕсли;
	
	Если ЕстьОшибки Тогда
		ЗаписьРегистра.ЕстьОшибкиИлиПредупреждения = 1;
	ИначеЕсли ЕстьПредупреждения Тогда
		ЗаписьРегистра.ЕстьОшибкиИлиПредупреждения = 2;
	КонецЕсли;
	
	ЗаписьРегистра.ОшибкиИПредупреждения = Новый ХранилищеЗначения(Ошибки);
	
КонецПроцедуры

// Табличный итератор элементных связей
// Параметры:
//		Таблица - таблица значений
//		ПравилоУправления - СправочникСсылка.aps_ПравилаУправления (необязательный)
//		ВключаяПараметры - булево (необязательный)
//		ВидСвязи1 - СправочникСсылка.aps_ШаблоныТехнологическихСвязей (необязательный)
//		ВидСвязи2 - СправочникСсылка.aps_ШаблоныТехнологическихСвязей (необязательный)
//		ВидСвязи3 - СправочникСсылка.aps_ШаблоныТехнологическихСвязей (необязательный)
// Возвращаемое значение:
//		ТаблицаЗначений
// Пример:
//      ПрименяемостьИзделий = локЭлементныеСвязиПоФильтру( ТаблицаИзделий,, , Истина, Справочники.aps_ШаблоныТехнологическихСвязей.ИзготавливаемыеРазбираемыеИзделия);
//
Функция локЭлементныеСвязиПоФильтру( Таблица, Знач ПравилоУправления = Неопределено, ВключаяПараметры=Истина, ОбратныеСвязи=Ложь, ВидСвязи1=Неопределено, ВидСвязи2=Неопределено, ВидСвязи3=Неопределено) Экспорт
	Если Таблица.Количество() = 0 Тогда
		Возврат Таблица;
	КонецЕсли;
	
	Если ТипЗнч(ПравилоУправления) = Тип("Строка") Тогда	// передается строка XML
		ПравилоУправления = Строка2Object1С(ПравилоУправления);
	КонецЕсли;

	ЗапросИтератора=Новый Запрос();

	ТекстЗапроса = "ВЫБРАТЬ
	                      |	ТаблицаСсылок.ЭлементСсылка КАК Ссылка
	                      |ПОМЕСТИТЬ ВТСсылки
	                      |ИЗ
	                      |	&Данные КАК ТаблицаСсылок;
						  |////
						  | ВЫБРАТЬ
	               |	ЭлементныеСвязи.ЭлементСвязи,
	               |	ЭлементныеСвязи.ЭлементСсылка,
	               |	ЭлементныеСвязи.РодительСсылка,
				   |	ЭлементныеСвязи.ВидРодителя,
	               |	ВЫБОР
	               |		КОГДА ЭлементныеСвязи.ОригиналРевизии = НЕОПРЕДЕЛЕНО
	               |			ТОГДА ЭлементныеСвязи.ЭлементСсылка
	               |		ИНАЧЕ ЭлементныеСвязи.ОригиналРевизии
	               |	КОНЕЦ КАК ОригиналРевизии,
	               |	ЛОЖЬ КАК РевизияПодобрана,
	               |	ЭлементныеСвязи.ВидЭлемента,
	               |	ЭлементныеСвязи.КодВидаЭлемента,
	               |	ЭлементныеСвязи.Картинка,
	               |	ЭлементныеСвязи.ПредставлениеЭлемента,
	               |	ЭлементныеСвязи.Владелец,
	               |	ЭлементныеСвязи.Группа,
	               |	ЭлементныеСвязи.HTMLКонтент,
	               |	ЭлементныеСвязи.ВидСвязи,
	               |	ЭлементныеСвязи.ОбратнаяСвязь,
	               |	ЭлементныеСвязи.КартинкаСвязи,
	               |	ЭлементныеСвязи.ПредставлениеСвязи,
	               |	ЭлементныеСвязи.КодВидаСвязи,				   
	               |	ЭлементныеСвязи.ПорядокВывода";
	Если ВключаяПараметры Тогда 
		Если ОбратныеСвязи = Истина Тогда
			ТекстЗапроса = ТекстЗапроса + ",
				   |	ЭлементныеСвязи.ЭлементСвязи.Параметры.(Параметр, Параметр.Наименование КАК ИмяПараметра, Параметр.Свойство КАК Свойство, Параметр.Значение КАК Значение, Параметр.ЕдиницаИзмерения КАК ЕдиницаИзмерения, Параметр.Родитель КАК ГруппаПараметров, Параметр.Родитель.Наименование КАК ИмяГруппыПараметров) КАК ПараметрыЭлементаСвязи,
				   |	ВЫРАЗИТЬ(ЭлементныеСвязи.РодительСсылка КАК Справочник.aps_ЭлементыИзделия).Параметры.(Параметр, Параметр.Наименование КАК ИмяПараметра, Параметр.Свойство КАК Свойство, Параметр.Значение КАК Значение, Параметр.ЕдиницаИзмерения КАК ЕдиницаИзмерения, Параметр.Родитель КАК ГруппаПараметров, Параметр.Родитель.Наименование КАК ИмяГруппыПараметров) КАК ПараметрыЭлементаИзделия,
				   |	ВЫРАЗИТЬ(ЭлементныеСвязи.РодительСсылка КАК Справочник.aps_ЭлементыСправочников).Параметры.(Параметр, Параметр.Наименование КАК ИмяПараметра, Параметр.Свойство КАК Свойство, Параметр.Значение КАК Значение, Параметр.ЕдиницаИзмерения КАК ЕдиницаИзмерения, Параметр.Родитель КАК ГруппаПараметров, Параметр.Родитель.Наименование КАК ИмяГруппыПараметров) КАК ПараметрыЭлементаСправочника,
				   |	ВЫРАЗИТЬ(ЭлементныеСвязи.РодительСсылка КАК Справочник.aps_ЭлементыТехнологии).Параметры.(Параметр, Параметр.Наименование КАК ИмяПараметра, Параметр.Свойство КАК Свойство, Параметр.Значение КАК Значение, Параметр.ЕдиницаИзмерения КАК ЕдиницаИзмерения, Параметр.Родитель КАК ГруппаПараметров, Параметр.Родитель.Наименование КАК ИмяГруппыПараметров) КАК ПараметрыЭлементаТехнологии,
				   |	ЭлементныеСвязи.ЭлементСвязи.Параметры.(Параметр, Параметр.Наименование КАК ИмяПараметра, Параметр.Свойство КАК Свойство, Параметр.Значение КАК Значение, Параметр.ЕдиницаИзмерения КАК ЕдиницаИзмерения, Параметр.Родитель КАК ГруппаПараметров, Параметр.Родитель.Наименование КАК ИмяГруппыПараметров) КАК ПараметрыЭлементаСвязиПотомка,
				   |	ВЫРАЗИТЬ(ЭлементныеСвязи.ЭлементСсылка КАК Справочник.aps_ЭлементыИзделия).Параметры.(Параметр, Параметр.Наименование КАК ИмяПараметра, Параметр.Свойство КАК Свойство, Параметр.Значение КАК Значение, Параметр.ЕдиницаИзмерения КАК ЕдиницаИзмерения, Параметр.Родитель КАК ГруппаПараметров, Параметр.Родитель.Наименование КАК ИмяГруппыПараметров) КАК ПараметрыЭлементаИзделияПотомка,
				   |	ВЫРАЗИТЬ(ЭлементныеСвязи.ЭлементСсылка КАК Справочник.aps_ЭлементыСправочников).Параметры.(Параметр, Параметр.Наименование КАК ИмяПараметра, Параметр.Свойство КАК Свойство, Параметр.Значение КАК Значение, Параметр.ЕдиницаИзмерения КАК ЕдиницаИзмерения, Параметр.Родитель КАК ГруппаПараметров, Параметр.Родитель.Наименование КАК ИмяГруппыПараметров) КАК ПараметрыЭлементаСправочникаПотомка,
				   |	ВЫРАЗИТЬ(ЭлементныеСвязи.ЭлементСсылка КАК Справочник.aps_ЭлементыТехнологии).Параметры.(Параметр, Параметр.Наименование КАК ИмяПараметра, Параметр.Свойство КАК Свойство, Параметр.Значение КАК Значение, Параметр.ЕдиницаИзмерения КАК ЕдиницаИзмерения, Параметр.Родитель КАК ГруппаПараметров, Параметр.Родитель.Наименование КАК ИмяГруппыПараметров) КАК ПараметрыЭлементаТехнологииПотомка";
		Иначе
			ТекстЗапроса = ТекстЗапроса + ",
				   |	ЭлементныеСвязи.ЭлементСвязи.Параметры.(Параметр, Параметр.Наименование КАК ИмяПараметра, Параметр.Свойство КАК Свойство, Параметр.Значение КАК Значение, Параметр.ЕдиницаИзмерения КАК ЕдиницаИзмерения, Параметр.Родитель КАК ГруппаПараметров, Параметр.Родитель.Наименование КАК ИмяГруппыПараметров) КАК ПараметрыЭлементаСвязи,
				   |	ВЫРАЗИТЬ(ЭлементныеСвязи.ЭлементСсылка КАК Справочник.aps_ЭлементыИзделия).Параметры.(Параметр, Параметр.Наименование КАК ИмяПараметра, Параметр.Свойство КАК Свойство, Параметр.Значение КАК Значение, Параметр.ЕдиницаИзмерения КАК ЕдиницаИзмерения, Параметр.Родитель КАК ГруппаПараметров, Параметр.Родитель.Наименование КАК ИмяГруппыПараметров) КАК ПараметрыЭлементаИзделия,
				   |	ВЫРАЗИТЬ(ЭлементныеСвязи.ЭлементСсылка КАК Справочник.aps_ЭлементыСправочников).Параметры.(Параметр, Параметр.Наименование КАК ИмяПараметра, Параметр.Свойство КАК Свойство, Параметр.Значение КАК Значение, Параметр.ЕдиницаИзмерения КАК ЕдиницаИзмерения, Параметр.Родитель КАК ГруппаПараметров, Параметр.Родитель.Наименование КАК ИмяГруппыПараметров) КАК ПараметрыЭлементаСправочника,
				   |	ВЫРАЗИТЬ(ЭлементныеСвязи.ЭлементСсылка КАК Справочник.aps_ЭлементыТехнологии).Параметры.(Параметр, Параметр.Наименование КАК ИмяПараметра, Параметр.Свойство КАК Свойство, Параметр.Значение КАК Значение, Параметр.ЕдиницаИзмерения КАК ЕдиницаИзмерения, Параметр.Родитель КАК ГруппаПараметров, Параметр.Родитель.Наименование КАК ИмяГруппыПараметров) КАК ПараметрыЭлементаТехнологии";
		КонецЕсли;		   
	КонецЕсли;
	ТекстЗапроса = ТекстЗапроса + "
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ЭлементыСвязей.ЭлементСвязи КАК ЭлементСвязи,
	               |		ЭлементыСвязей.ЭлементСсылка КАК ЭлементСсылка,
	               |		ЭлементыСвязей.РодительСсылка КАК РодительСсылка,
				   |		ЭлементыСвязей.РодительСсылка.ВидЭлемента КАК ВидРодителя,
	               |		ЭлементыСвязей.ЭлементСсылка.ОригиналРевизии КАК ОригиналРевизии,
	               |		ЭлементыСвязей.ЭлементСсылка.ВидЭлемента КАК ВидЭлемента,
	               |		ВЫБОР
	               |			КОГДА ЭлементыСвязей.ЭлементСсылка.ИндексКартинки = 0
	               |				ТОГДА ЭлементыСвязей.ЭлементСсылка.ВидЭлемента.ИндексКартинки
	               |			ИНАЧЕ ЭлементыСвязей.ЭлементСсылка.ИндексКартинки
	               |		КОНЕЦ КАК Картинка,
	               |		ЭлементыСвязей.ЭлементСсылка.Наименование КАК ПредставлениеЭлемента,
	               |		ЭлементыСвязей.ЭлементСсылка.UID КАК Владелец,
	               |		ЭлементыСвязей.ЭлементСсылка.GID КАК Группа,
	               |		ЭлементыСвязей.ЭлементСсылка.HTMLКонтент КАК HTMLКонтент,
	               |		ЭлементыСвязей.ЭлементСсылка.ВидЭлемента.Код КАК КодВидаЭлемента,
	               |		ЭлементыСвязей.ЭлементСвязи.ПорядокВывода КАК ПорядокВывода,
	               |		ВЫБОР
	               |			КОГДА ЭлементыСвязей.ВидСвязи.Автоупорядочивание
	               |				ТОГДА 0
	               |			ИНАЧЕ ЭлементыСвязей.ЭлементСвязи.ПорядокВывода
	               |		КОНЕЦ КАК Порядок,
	               |		ВЫБОР
	               |			КОГДА ЭлементыСвязей.ВидСвязи ССЫЛКА Перечисление.aps_ВидыСвязей
	               |				ТОГДА 0
	               |			ИНАЧЕ 1
	               |		КОНЕЦ КАК ПорядокСвязи,
	               |		ЭлементыСвязей.ВидСвязи КАК ВидСвязи,
	               |		ЭлементыСвязей.ВидСвязи.Код КАК КодВидаСвязи,
	               |		ЭлементыСвязей.ОбратнаяСвязь КАК ОбратнаяСвязь,
	               |		ВЫБОР
	               |			КОГДА ЭлементыСвязей.ОбратнаяСвязь
	               |				ТОГДА ЭлементыСвязей.ВидСвязи.ИндексКартинкиОбратнойСвязи
	               |			ИНАЧЕ ЭлементыСвязей.ВидСвязи.ИндексКартинки
	               |		КОНЕЦ КАК КартинкаСвязи,
	               |		ВЫБОР
	               |			КОГДА ЭлементыСвязей.ОбратнаяСвязь
	               |				ТОГДА ЭлементыСвязей.ВидСвязи.НаименованиеОбратнойСвязи
	               |			ИНАЧЕ ЭлементыСвязей.ВидСвязи.Наименование
	               |		КОНЕЦ КАК ПредставлениеСвязи
	               |	ИЗ";
	Если ОбратныеСвязи = Истина Тогда
	    ТекстЗапроса = ТекстЗапроса + "
				   |		(ВЫБРАТЬ
				   |			aps_ЭлементыСвязей.Ссылка КАК ЭлементСвязи,
				   |			aps_ЭлементыСвязей.РодительСсылка КАК ЭлементСсылка,
				   |			aps_ЭлементыСвязей.ПотомокСсылка КАК РодительСсылка,
				   |			aps_ЭлементыСвязей.ВидСвязи КАК ВидСвязи,
				   |			ИСТИНА КАК ОбратнаяСвязь
				   |		ИЗ
				   |			ВТСсылки
				   |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.aps_ЭлементыСвязей КАК aps_ЭлементыСвязей ПО
				   |			ВТСсылки.Ссылка = aps_ЭлементыСвязей.ПотомокСсылка
				   |			И (НЕ aps_ЭлементыСвязей.ПометкаУдаления)
				   |			И НЕ aps_ЭлементыСвязей.РодительСсылка ССЫЛКА Справочник.aps_ЭлементыСвязей) КАК ЭлементыСвязей) КАК ЭлементныеСвязи"
	Иначе			   
		ТекстЗапроса = ТекстЗапроса + "
				   |		(ВЫБРАТЬ
				   |			aps_ЭлементыСвязей.Ссылка КАК ЭлементСвязи,
				   |			aps_ЭлементыСвязей.ПотомокСсылка КАК ЭлементСсылка,
				   |			aps_ЭлементыСвязей.РодительСсылка КАК РодительСсылка,
				   |			aps_ЭлементыСвязей.ВидСвязи КАК ВидСвязи,
				   |			ЛОЖЬ КАК ОбратнаяСвязь
				   |		ИЗ
				   |			ВТСсылки
				   |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.aps_ЭлементыСвязей КАК aps_ЭлементыСвязей ПО
				   |			ВТСсылки.Ссылка = aps_ЭлементыСвязей.РодительСсылка
				   |			И (НЕ aps_ЭлементыСвязей.ПометкаУдаления)) КАК ЭлементыСвязей) КАК ЭлементныеСвязи";	
	КонецЕсли;
			   
	Если ПравилоУправления <> Неопределено И ПравилоУправления.ВидыЭлементовФильтр.Количество() > 0 Тогда 
		ТекстЗапроса = ТекстЗапроса + "
	               |ГДЕ ЭлементныеСвязи.ВидЭлемента В(&ВидыЭлементов)
				   |	И (ЭлементныеСвязи.ВидСвязи = &ВидСвязи1
				   |		ИЛИ ЭлементныеСвязи.ВидСвязи = &ВидСвязи2
				   |		ИЛИ ЭлементныеСвязи.ВидСвязи = &ВидСвязи3)";
		ЗапросИтератора.УстановитьПараметр("ВидыЭлементов", ПравилоУправления.ВидыЭлементовФильтр.ВыгрузитьКолонку(0));
	Иначе
		ТекстЗапроса = ТекстЗапроса + "
	               |ГДЕ (ЭлементныеСвязи.ВидСвязи = &ВидСвязи1
				   |	ИЛИ ЭлементныеСвязи.ВидСвязи = &ВидСвязи2
				   |	ИЛИ ЭлементныеСвязи.ВидСвязи = &ВидСвязи3)";
	КонецЕсли;
	ЗапросИтератора.УстановитьПараметр("ВидСвязи1", ВидСвязи1);
	ЗапросИтератора.УстановитьПараметр("ВидСвязи2", ВидСвязи2);
	ЗапросИтератора.УстановитьПараметр("ВидСвязи3", ВидСвязи3);
	ТекстЗапроса = ТекстЗапроса + "
	               |УПОРЯДОЧИТЬ ПО
	               |	ЭлементныеСвязи.РодительСсылка,
	               |	ЭлементныеСвязи.ПорядокСвязи,
	               |	ЭлементныеСвязи.КодВидаСвязи,
	               |	ЭлементныеСвязи.ВидСвязи,
	               |	ЭлементныеСвязи.ОбратнаяСвязь,
	               |	ЭлементныеСвязи.Порядок,
	               |	ЭлементныеСвязи.КодВидаЭлемента,
	               |	ЭлементныеСвязи.ПредставлениеЭлемента";
	ЗапросИтератора.УстановитьПараметр("Данные",Таблица);					   
	ЗапросИтератора.Текст = ТекстЗапроса;
	РезультатИтератора = ЗапросИтератора.Выполнить().Выгрузить();
	
	Если ПравилоУправления <> Неопределено Тогда 
		
		// Массив элементов для подбора
		МассивЭлементов	= РезультатИтератора.ВыгрузитьКолонку("ОригиналРевизии");
		ПодобранныеРевизииЭлементов	= aps_Итераторы.aps_ПодборРевизийЭлементов(МассивЭлементов, ПравилоУправления);
		
		i = 0;
		Пока i < РезультатИтератора.Количество() Цикл 
			СтрокаРезультата = РезультатИтератора[i];
			
			СтрокаПодобраннойРевизии = ПодобранныеРевизииЭлементов.Найти(СтрокаРезультата.ОригиналРевизии, "ОригиналРевизии");
			// Если ревизия подобрана, заменить оригинальный элемент ревизией
			Если СтрокаПодобраннойРевизии <> Неопределено И СтрокаРезультата.ЭлементСсылка <> СтрокаПодобраннойРевизии.ЭлементСсылка Тогда 
				ЗаполнитьЗначенияСвойств(СтрокаРезультата, СтрокаПодобраннойРевизии);
				СтрокаРезультата.РевизияПодобрана=Истина;
			КонецЕсли;
			
			i = i + 1;
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат РезультатИтератора;
КонецФункции

// Функция заполнения кеширующего регистра данными по технологии
// Параметры:
//		ТаблицаИзделий - таблица значений
// Возвращаемое значение:
//      ТаблицаЗначений
// Пример:
//		ТаблицаРезультата=локКэшироватьТехнологию( ТаблицаВходящая );
//
Функция локКэшироватьТехнологию( ТаблицаИзделий ) Экспорт
	Если ТаблицаИзделий.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
		
	
	ТаблицаИзделий.Свернуть("ЭлементСсылка","Уровень");
	ПрименяемостьИзделий = локЭлементныеСвязиПоФильтру( ТаблицаИзделий,, , Истина, Справочники.aps_ШаблоныТехнологическихСвязей.ИзготавливаемыеРазбираемыеИзделия);
	Если ПрименяемостьИзделий.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	// ТТП //
	ПрименяемостьИзделий.Колонки.Добавить("Изделие", Новый ОписаниеТипов("СправочникСсылка.aps_ЭлементыИзделия, СправочникСсылка.aps_ЭлементыСправочников, СправочникСсылка.aps_ЭлементыТехнологии"));
	Для Каждого СтрокаПрименяемости Из ПрименяемостьИзделий Цикл
		// заполнить изделие только если изделие относится к ревизии операции/техпроцесса
		Если СтрокаПрименяемости.ЭлементСсылка <> СтрокаПрименяемости.ОригиналРевизии Тогда
			СтрокаПрименяемости.Изделие = СтрокаПрименяемости.РодительСсылка;
		КонецЕсли;
	КонецЦикла;
	/////////
	ТаблицаМаршрутов		= ПрименяемостьИзделий.Скопировать(Новый Структура("ВидЭлемента", Справочники.aps_ВидыЭлементов.Маршрут));
	ТаблицаТехпроцессов		= ПрименяемостьИзделий.Скопировать(Новый Структура("ВидЭлемента", Справочники.aps_ВидыЭлементов.ТехнологическийПроцесс));
	ТаблицаОпераций			= ПрименяемостьИзделий.Скопировать(Новый Структура("ВидЭлемента", Справочники.aps_ВидыЭлементов.ТехнологическаяОперация));
	ТаблицаПунктовМаршрута 	= ПрименяемостьИзделий.Скопировать(Новый Структура("ВидЭлемента", Справочники.aps_ВидыЭлементов.ПунктОбработки));
	
	Для Каждого СтрокаОперации Из ТаблицаОпераций Цикл
		ПараметрСпособСоздания = СтрокаОперации.ПараметрыЭлементаТехнологииПотомка.Найти(ПланыВидовХарактеристик.aps_Свойства.СпособСозданияРевизии, "Свойство");
		Если ПараметрСпособСоздания <> Неопределено 
				И ПараметрСпособСоздания.Значение = Справочники.aps_СпособыСозданияРевизий.Представление Тогда
			СтрокаОперации.ЭлементСсылка = СтрокаОперации.ОригиналРевизии;
		КонецЕсли;
	КонецЦикла;
	
	ПрименяемостьОпераций = локПрименяемостьПодчиненныхЭлементовСРевизиями(ТаблицаОпераций);	
	Для Каждого СтрокаПрименяемости Из ПрименяемостьОпераций Цикл
		Если СтрокаПрименяемости.ВидЭлемента = Справочники.aps_ВидыЭлементов.ТехнологическийПроцесс Тогда
			ЗаполнитьЗначенияСвойств(ТаблицаТехпроцессов.Добавить(), СтрокаПрименяемости);
		Иначе
			ЗаполнитьЗначенияСвойств(ТаблицаПунктовМаршрута.Добавить(), СтрокаПрименяемости);
		КонецЕсли;
	КонецЦикла;
	
	ПрименяемостьТехпроцессов = локПрименяемостьПодчиненныхЭлементовСРевизиями(ТаблицаТехпроцессов, Справочники.aps_ШаблоныТехнологическихСвязей.СсылочныеТехпроцессы);
	Для Каждого СтрокаПунктаМаршрута Из ПрименяемостьТехпроцессов Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаПунктовМаршрута.Добавить(), СтрокаПунктаМаршрута);
	КонецЦикла;
	
	ПрименяемостьПунктовМаршрута = локПрименяемостьПодчиненныхЭлементовСРевизиями(ТаблицаПунктовМаршрута, Справочники.aps_ШаблоныТехнологическихСвязей.ПунктыМаршрута);
	Для Каждого СтрокаМаршрута Из ПрименяемостьПунктовМаршрута Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаМаршрутов.Добавить(), СтрокаМаршрута);
	КонецЦикла;
	
	ТаблицаПунктовМаршрута = локПодчиненныеЭлементыСРевизиями(ТаблицаМаршрутов); // получили пункты маршрута
	// техпроцессы, прикрепленные к пунктам маршрута
	ТаблицаПунктовМаршрутаСвернутая=ТаблицаПунктовМаршрута.Скопировать();
	ТаблицаПунктовМаршрутаСвернутая.Свернуть("ЭлементСсылка, Изделие, ВидСвязи");
	ТехпроцессыНаПунктахМаршрута = локЭлементныеСвязиПоФильтруСРевизиями(ТаблицаПунктовМаршрутаСвернутая,,, Справочники.aps_ШаблоныТехнологическихСвязей.СсылочныеТехпроцессы);
	// вставляем строки техпроцессов под соответствующие строки пунктов маршрута
	max_j = ТаблицаПунктовМаршрута.Количество() - 1;
	Для j = 0 По max_j Цикл
		rev_j = max_j - j; // обход в обратном порядке, чтобы не нарушалась индексация строк пунктов маршрута после вставки строк техпроцессов
		СтрокиТехпроцессов = ТехпроцессыНаПунктахМаршрута.НайтиСтроки(Новый Структура("РодительСсылка", ТаблицаПунктовМаршрута[rev_j].ЭлементСсылка));
		max_i = СтрокиТехпроцессов.Количество() - 1;
		Для i = 0 По max_i Цикл 
			rev_i = max_i - i; // обход в обратном порядке, чтобы вставить в таблицу в правильном порядке
			НоваяСтрокаТехпроцесса = ?(rev_j = max_j, ТаблицаПунктовМаршрута.Добавить(), ТаблицаПунктовМаршрута.Вставить(rev_j + 1));
			ЗаполнитьЗначенияСвойств(НоваяСтрокаТехпроцесса, СтрокиТехпроцессов[rev_i]);
		КонецЦикла;
	КонецЦикла;
	// операции на пунктах маршрута и операции техпроцессов на пунктах маршрута
	ТаблицаОпераций = локПодчиненныеЭлементыСРевизиями(ТаблицаПунктовМаршрута);
	// в колонку "РодительСсылка" вместо техпроцессов подставляем соответствующие пункты маршрута
	Для Каждого СтрокаОперации Из ТаблицаОпераций Цикл
		Если СтрокаОперации.ВидРодителя = Справочники.aps_ВидыЭлементов.ТехнологическийПроцесс Тогда
			СтрокаТехпроцесса = ТехпроцессыНаПунктахМаршрута.Найти(СтрокаОперации.РодительСсылка, "ЭлементСсылка");
			Если СтрокаТехпроцесса <> Неопределено Тогда
				СтрокаОперации.РодительСсылка = СтрокаТехпроцесса.РодительСсылка;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	///// ТТП /////
	ОперацииТехпроцессов = локПодчиненныеЭлементыСРевизиями(ТаблицаТехпроцессов);
	///////////////
	Для Каждого СтрокаОперации Из ОперацииТехпроцессов Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаОпераций.Добавить(), СтрокаОперации);
	КонецЦикла;
	
	ТаблицаСодержанияОпераций = локПодчиненныеЭлементы( ТаблицаОпераций );
		
	ТаблицаРодителей = ТаблицаОпераций.Скопировать();	
		
	
	Для i = 0 По ТаблицаПунктовМаршрута.Количество() - 1 Цикл
		ТаблицаРодителей.Добавить().ЭлементСсылка=ТаблицаПунктовМаршрута[i].ЭлементСсылка;
	КонецЦикла;
	Для i = 0 По ТаблицаМаршрутов.Количество() - 1 Цикл
		ТаблицаРодителей.Добавить().ЭлементСсылка=ТаблицаМаршрутов[i].ЭлементСсылка;
	КонецЦикла;
	Для i = 0 По ТаблицаТехпроцессов.Количество() - 1 Цикл
		ТаблицаРодителей.Добавить().ЭлементСсылка=ТаблицаТехпроцессов[i].ЭлементСсылка;
	КонецЦикла;                             
	Для i = 0 По ТаблицаСодержанияОпераций.Количество() - 1 Цикл
		ТаблицаРодителей.Добавить().ЭлементСсылка=ТаблицаСодержанияОпераций[i].ЭлементСсылка;
	КонецЦикла;
	
	ТаблицаРодителей.Свернуть("ЭлементСсылка");
	ТаблицаКомплектованияОсновныхМатериаловСТО = локЭлементныеСвязиПоФильтру(ТаблицаРодителей,, ,, Справочники.aps_ШаблоныТехнологическихСвязей.Комплектование,
																						Справочники.aps_ШаблоныТехнологическихСвязей.ОсновныеМатериалы,
																						Справочники.aps_ШаблоныТехнологическихСвязей.СредстваОснащения);
	ТаблицаКомплектованияОсновныхМатериаловСТО.Колонки.Добавить("Уровень", Новый ОписаниеТипов("Число") );
																						
	// найти маршрут или техпроцесс для каждого изделия
	ПрименяемостьИзделий.Колонки.Добавить("ТехпроцессИлиМаршрут");
	ПрименяемостьИзделий.Колонки.Добавить("НомерОперации");
	Для Каждого СтрокаПрименяемости Из ПрименяемостьИзделий Цикл
		Если СтрокаПрименяемости.ВидЭлемента = Справочники.aps_ВидыЭлементов.Маршрут Тогда
			СтрокаПрименяемости.ТехпроцессИлиМаршрут = СтрокаПрименяемости.ЭлементСсылка;
			
		ИначеЕсли СтрокаПрименяемости.ВидЭлемента = Справочники.aps_ВидыЭлементов.ТехнологическийПроцесс Тогда
			СтрокиПрименяемостиТехпроцесса = ТехпроцессыНаПунктахМаршрута.НайтиСтроки(Новый Структура("ЭлементСсылка, ВидСвязи", СтрокаПрименяемости.ЭлементСсылка, Справочники.aps_ШаблоныТехнологическихСвязей.СсылочныеТехпроцессы)); //связь с пунктом маршрута
			Если СтрокиПрименяемостиТехпроцесса.Количество() > 0 Тогда // техпроцесс связан с пунктом маршрута
				СтрокаПунктаМаршрута = ТаблицаПунктовМаршрута.Найти(СтрокиПрименяемостиТехпроцесса[0].РодительСсылка, "ЭлементСсылка"); //находим маршрут по пункту маршрута
				СтрокаПрименяемости.ТехпроцессИлиМаршрут = СтрокаПунктаМаршрута.РодительСсылка;
			Иначе // техпроцесс не связан с пунктом маршрута
				СтрокаПрименяемости.ТехпроцессИлиМаршрут = СтрокаПрименяемости.ЭлементСсылка;
			КонецЕсли;
			
		ИначеЕсли СтрокаПрименяемости.ВидЭлемента = Справочники.aps_ВидыЭлементов.ТехнологическаяОперация Тогда //операция
			СтрокаОперации = ТаблицаОпераций.Найти(СтрокаПрименяемости.ЭлементСсылка, "ЭлементСсылка");
			Если СтрокаОперации <> Неопределено Тогда
				// операция пункта маршрута
				СтрокаПунктаМаршрута = ТаблицаПунктовМаршрута.Найти(СтрокаОперации.РодительСсылка, "ЭлементСсылка");
				Если СтрокаПунктаМаршрута <> Неопределено Тогда
					СтрокаПрименяемости.ТехпроцессИлиМаршрут = СтрокаПунктаМаршрута.РодительСсылка; //маршрут
				Иначе
					СтрокаТехпроцесса = ТаблицаТехпроцессов.Найти(СтрокаОперации.РодительСсылка, "ЭлементСсылка");
					Если СтрокаТехпроцесса <> Неопределено Тогда
						СтрокаПрименяемости.ТехпроцессИлиМаршрут = СтрокаТехпроцесса.ЭлементСсылка;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			Иначе // пункт маршрута
               СтрокаПунктаМаршрута = ТаблицаПунктовМаршрута.Найти(СтрокаПрименяемости.ЭлементСсылка, "ЭлементСсылка");
               Если СтрокаПунктаМаршрута <> Неопределено Тогда
                    СтрокаПрименяемости.ТехпроцессИлиМаршрут = СтрокаПунктаМаршрута.РодительСсылка; //маршрут
               КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	///////////////////////////////////////////////////////////////////////////////////////////////
	// запись в регистр
	
	// стереть данные для изделий
	Для Каждого Изделие Из ТаблицаИзделий Цикл
		НаборЗаписей = РегистрыСведений.aps_КэшированныеДанные.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ЭлементСсылка.Установить(Изделие.ЭлементСсылка);
		НаборЗаписей.Отбор.ВидНабора.Установить(Перечисления.ERPКорпВидыНаборов.Маршрут);
		НаборЗаписей.Очистить();
		НаборЗаписей.Записать();
		
		НаборЗаписей = РегистрыСведений.aps_КэшированныеДанные.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ЭлементСсылка.Установить(Изделие.ЭлементСсылка);
		НаборЗаписей.Отбор.ВидНабора.Установить(Перечисления.ERPКорпВидыНаборов.Техпроцесс);
		НаборЗаписей.Очистить();
		НаборЗаписей.Записать();
		
		НаборЗаписей = РегистрыСведений.aps_КэшированныеДанные.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ЭлементСсылка.Установить(Изделие.ЭлементСсылка);
		НаборЗаписей.Отбор.ВидНабора.Установить(Перечисления.ERPКорпВидыНаборов.ВыходноеИзделие);
		НаборЗаписей.Очистить();
		НаборЗаписей.Записать();
	КонецЦикла;	
	
	/////////////////////////////////
	// заполнение в прямом порядке //
	Для i = 0 По ПрименяемостьИзделий.Количество() - 1 Цикл
		СтрокаПрименяемости = ПрименяемостьИзделий[i];
		Изделие = СтрокаПрименяемости.РодительСсылка;
		ТехпроцессИлиМаршрут = СтрокаПрименяемости.ТехпроцессИлиМаршрут;
		
		
		// Получить КОИД техпроцесса или маршрута
		КОИД=Обработки.aps_СозданиеПараметров.Создать().aps_ВспомНайтиПараметрПоСвойству(ТехпроцессИлиМаршрут, ПланыВидовХарактеристик.aps_Свойства.КОИД);
		Если КОИД<>Неопределено Тогда
			КОИД=КОИД.Значение;
		КонецЕсли;
		// Поиск в исходной таблице строки и уровнем
		СтрокаСУровнем=ТаблицаИзделий.Найти(Изделие);
		Если СтрокаСУровнем<>Неопределено Тогда
			Уровень=СтрокаСУровнем.Уровень;
		Иначе
			Уровень=0;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ТехпроцессИлиМаршрут) Тогда
			Продолжить;
		КонецЕсли;
		
		НаборЗаписей = РегистрыСведений.aps_КэшированныеДанные.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ЭлементСсылка.Установить(Изделие);
		НомерЗаписи = 0;
		
		ВидНабора = Неопределено;
		ПерваяОперация = Неопределено;
		ПоследняяОперация = Неопределено;
		
		ПоляСтруктуры="НомерОперации, Подразделение, ВидОперации, РабочийЦентр, ВремяВыполнения, ПодготовительноеВремя, ПунктМаршрута, ЕдиницаИзмеренияВремени, КОИД, Профессия, РазрядРабот, УсловияТруда";
		ПараметрыПервойОперации = Новый Структура(ПоляСтруктуры);
		ПараметрыПоследнейОперации = Новый Структура(ПоляСтруктуры);
		Если ТехпроцессИлиМаршрут.ВидЭлемента = Справочники.aps_ВидыЭлементов.Маршрут Тогда
			// маршрут
			ВидНабора = Перечисления.ERPКорпВидыНаборов.Маршрут;
			НаборЗаписей.Отбор.ВидНабора.Установить(ВидНабора);
			
			МассивСтрокПунктов = ТаблицаПунктовМаршрута.НайтиСтроки(Новый Структура("РодительСсылка", ТехпроцессИлиМаршрут));
			КоличествоПунктов = МассивСтрокПунктов.Количество();
			Для i_Пункт = 0 По КоличествоПунктов - 1 Цикл
				СтрокаПунктаМаршрута = МассивСтрокПунктов[i_Пункт];
				
				// Получить подразделение пункта
				Подразделение=СтрокаПунктаМаршрута.ПараметрыЭлементаТехнологии.Найти(ПланыВидовХарактеристик.aps_Свойства.Подразделение, "Свойство");
				Если Подразделение<>Неопределено Тогда
					Подразделение=Подразделение.Значение;
				КонецЕсли;
				// Получить КОИД пункта
				локКОИД=СтрокаПунктаМаршрута.ПараметрыЭлементаТехнологии.Найти(ПланыВидовХарактеристик.aps_Свойства.КОИД, "Свойство");
				Если локКОИД<>Неопределено И локКОИД.Значение>0 Тогда
					КОИД=локКОИД.Значение;
				КонецЕсли;
				
				
				НоменклатураПолуфабриката = Неопределено;
				ХарактеристикаПолуфабриката = Неопределено;
				
				// номенклатура и характеристика полубфариката
				СтрокаПараметра = СтрокаПунктаМаршрута.ПараметрыЭлементаТехнологии.Найти(ПланыВидовХарактеристик.aps_Свойства.Номенклатура, "Свойство");
				Если СтрокаПараметра <> Неопределено Тогда
					НоменклатураПолуфабриката = СтрокаПараметра.Значение;
				КонецЕсли;
				СтрокаПараметра = СтрокаПунктаМаршрута.ПараметрыЭлементаТехнологии.Найти(ПланыВидовХарактеристик.aps_Свойства.ХарактеристикаНоменклатуры, "Свойство");
				Если СтрокаПараметра <> Неопределено Тогда
					ХарактеристикаПолуфабриката = СтрокаПараметра.Значение;
				КонецЕсли;
				
				// операции пункта маршрута
				МассивСтрокОпераций = ТаблицаОпераций.НайтиСтроки(Новый Структура("РодительСсылка", СтрокаПунктаМаршрута.ЭлементСсылка));
				КоличествоОпераций = МассивСтрокОпераций.Количество();
				ПерваяОперацияДобавлена = Ложь; // истина, если первая операция не имеет комплектования, но добавлена в набор записей с основным материалом
				
				Для i_Операция = 0 По КоличествоОпераций - 1 Цикл 
					СтрокаОперации = МассивСтрокОпераций[i_Операция];
					НомерОперации = Неопределено;
					ВидОперации = Неопределено;
					РабочийЦентр = Неопределено;
					ВремяВыполнения = Неопределено;
					ПодготовительноеВремя=Неопределено;
					
					// заполнение номера операции
					СтрокаПараметра = СтрокаОперации.ПараметрыЭлементаТехнологии.Найти(ПланыВидовХарактеристик.aps_Свойства.НомерОперации, "Свойство");
					Если СтрокаПараметра <> Неопределено Тогда
						НомерОперации = СтрокаПараметра.Значение;
					КонецЕсли;
					// параметры операции
					СтрокаПараметра = СтрокаОперации.ПараметрыЭлементаТехнологии.Найти(ПланыВидовХарактеристик.aps_Свойства.Операция, "Свойство");
					Если СтрокаПараметра <> Неопределено Тогда
						ВидОперации = СтрокаПараметра.Значение;
					КонецЕсли;
					СтрокаПараметра = СтрокаОперации.ПараметрыЭлементаТехнологии.Найти(ПланыВидовХарактеристик.aps_Свойства.РабочийЦентр, "Свойство");
					Если СтрокаПараметра <> Неопределено Тогда
						РабочийЦентр = СтрокаПараметра.Значение;
					КонецЕсли;
					СтрокаПараметра = СтрокаОперации.ПараметрыЭлементаТехнологии.Найти(ПланыВидовХарактеристик.aps_Свойства.ВремяШТ, "Свойство");			
					Если СтрокаПараметра <> Неопределено Тогда
						ВремяВыполнения = СтрокаПараметра.Значение;
						ЕдиницаИзмеренияВремени=СтрокаПараметра.ЕдиницаИзмерения;
					КонецЕсли;
					СтрокаПараметра = СтрокаОперации.ПараметрыЭлементаТехнологии.Найти(ПланыВидовХарактеристик.aps_Свойства.ВремяПЗ, "Свойство");			
					Если СтрокаПараметра <> Неопределено Тогда
						ПодготовительноеВремя=СтрокаПараметра.Значение;
					КонецЕсли;
					
					СтрокаПараметра = СтрокаОперации.ПараметрыЭлементаТехнологии.Найти(ПланыВидовХарактеристик.aps_Свойства.Профессия, "Свойство");			
					Если СтрокаПараметра <> Неопределено Тогда
						Профессия=СтрокаПараметра.Значение;
					КонецЕсли;
						СтрокаПараметра = СтрокаОперации.ПараметрыЭлементаТехнологии.Найти(ПланыВидовХарактеристик.aps_Свойства.РР, "Свойство");			
					Если СтрокаПараметра <> Неопределено Тогда
						РазрядРабот=СтрокаПараметра.Значение;
					КонецЕсли;
					СтрокаПараметра = СтрокаОперации.ПараметрыЭлементаТехнологии.Найти(ПланыВидовХарактеристик.aps_Свойства.УТ, "Свойство");			
					Если СтрокаПараметра <> Неопределено Тогда
						УсловияТруда=СтрокаПараметра.Значение;
					КонецЕсли;

					// устанавливаем минуты для времени по-умолчани
					Если НЕ ЗначениеЗаполнено(ЕдиницаИзмеренияВремени) Тогда
						ЕдиницаИзмеренияВремени=Перечисления.ЕдиницыИзмеренияВремени.Минута;
					КонецЕсли;

					
					Если i_Пункт = 0 И i_Операция = 0 Тогда // первая операция на первом пункте
						ПерваяОперация = СтрокаОперации.ЭлементСсылка;
						ПараметрыПервойОперации.НомерОперации = НомерОперации;
						ПараметрыПервойОперации.Подразделение = Подразделение;
						ПараметрыПервойОперации.ВидОперации = ВидОперации;
						ПараметрыПервойОперации.РабочийЦентр = РабочийЦентр;
						ПараметрыПервойОперации.ВремяВыполнения = ВремяВыполнения;
						ПараметрыПервойОперации.ПодготовительноеВремя = ПодготовительноеВремя;
						ПараметрыПервойОперации.ЕдиницаИзмеренияВремени=ЕдиницаИзмеренияВремени;
						ПараметрыПервойОперации.ПунктМаршрута=СтрокаПунктаМаршрута.ЭлементСсылка;
						ПараметрыПервойОперации.КОИД=КОИД;
						
						ПараметрыПервойОперации.Профессия=Профессия;
						ПараметрыПервойОперации.РазрядРабот=РазрядРабот;
						ПараметрыПервойОперации.УсловияТруда=УсловияТруда;

						
						// основной материал техпроцесса или маршрута
						СтрокиОсновныхМатериалов = ТаблицаКомплектованияОсновныхМатериаловСТО.НайтиСтроки(Новый Структура("РодительСсылка", ТехпроцессИлиМаршрут));
						Для Каждого СтрокаМатериала Из СтрокиОсновныхМатериалов Цикл
							
							// Заполнение уровня комплектования
							СтрокаМатериала.Уровень=Уровень+1;
							НомерЗаписи = НомерЗаписи + 1;

							НоваяЗапись = НаборЗаписей.Добавить();
							НоваяЗапись.ЭлементСсылка = Изделие;
							НоваяЗапись.НомерЗаписи = НомерЗаписи;
							НоваяЗапись.ВидНабора = ВидНабора;
							НоваяЗапись.ПотомокСсылка = ТехпроцессИлиМаршрут;
							// ИБ 
							НоваяЗапись.ЭлементСсылка1=СтрокаПунктаМаршрута.ЭлементСсылка; // пункт маршрута
							// КИБ
							НоваяЗапись.ЭлементСсылка2 = ПерваяОперация;
							НоваяЗапись.ЭлементСсылка3 = СтрокаМатериала.ЭлементСсылка; // материал
							
							ЗаполнитьПараметрыКомплектования(НоваяЗапись, СтрокаМатериала);
							
							// параметры операции
							НоваяЗапись.НомерОперации = ПараметрыПервойОперации.НомерОперации;
							НоваяЗапись.ВидОперации = ПараметрыПервойОперации.ВидОперации;
							НоваяЗапись.РабочийЦентр = ПараметрыПервойОперации.РабочийЦентр;
							НоваяЗапись.ВремяВыполнения=ПараметрыПервойОперации.ВремяВыполнения;
							НоваяЗапись.ПодготовительноеВремя=ПараметрыПервойОперации.ПодготовительноеВремя;
							НоваяЗапись.ЕдиницаИзмеренияВремени=ЕдиницаИзмеренияВремени;
							НоваяЗапись.Профессия	=ПараметрыПервойОперации.Профессия;
							НоваяЗапись.РазрядРабот	=ПараметрыПервойОперации.РазрядРабот;
							НоваяЗапись.УсловияТруда=ПараметрыПервойОперации.УсловияТруда;
							
							// параметры пункта маршрута
							НоваяЗапись.Подразделение = ПараметрыПервойОперации.Подразделение;
							НоваяЗапись.КОИД=КОИД;
							
							ЗаписатьВерсииДанных( НоваяЗапись, Изделие.ИндексВерсии,
								?(ЗначениеЗаполнено(НоваяЗапись.ПотомокСсылка), НоваяЗапись.ПотомокСсылка.ИндексВерсии, 0),
								?(ЗначениеЗаполнено(НоваяЗапись.ЭлементСсылка1), НоваяЗапись.ЭлементСсылка1.ИндексВерсии, 0),
								?(ЗначениеЗаполнено(НоваяЗапись.ЭлементСсылка2), НоваяЗапись.ЭлементСсылка2.ИндексВерсии, 0),
								?(ЗначениеЗаполнено(НоваяЗапись.ЭлементСсылка3), НоваяЗапись.ЭлементСсылка3.ИндексВерсии, 0));
							
							ПерваяОперацияДобавлена = Истина;
						КонецЦикла;
					КонецЕсли;
					
					Если i_Пункт = КоличествоПунктов - 1 И i_Операция = КоличествоОпераций - 1 Тогда // последняя операция на последнем пункте
						ПоследняяОперация = СтрокаОперации.ЭлементСсылка;
						ПараметрыПоследнейОперации.НомерОперации = НомерОперации;
						ПараметрыПоследнейОперации.Подразделение = Подразделение;
						ПараметрыПоследнейОперации.ВидОперации = ВидОперации;
						ПараметрыПоследнейОперации.РабочийЦентр = РабочийЦентр;
						ПараметрыПоследнейОперации.ВремяВыполнения = ВремяВыполнения;
						ПараметрыПоследнейОперации.ПодготовительноеВремя=ПодготовительноеВремя;
						ПараметрыПоследнейОперации.ЕдиницаИзмеренияВремени=ЕдиницаИзмеренияВремени;
						ПараметрыПоследнейОперации.ПунктМаршрута=СтрокаПунктаМаршрута;
						ПараметрыПоследнейОперации.Профессия	=Профессия;
						ПараметрыПоследнейОперации.РазрядРабот	=РазрядРабот;
						ПараметрыПоследнейОперации.УсловияТруда=УсловияТруда;
						ПараметрыПоследнейОперации.КОИД=КОИД;
					КонецЕсли;
				
					СтрокиКомплектованияИСТО = ТаблицаКомплектованияОсновныхМатериаловСТО.НайтиСтроки(Новый Структура("РодительСсылка", СтрокаОперации.ЭлементСсылка));
					Для Каждого СтрокаКомплектованияИСТО Из СтрокиКомплектованияИСТО Цикл
						
						// Заполнение уровня комплектования
						СтрокаКомплектованияИСТО.Уровень=Уровень+1;
					    НомерЗаписи = НомерЗаписи + 1;
						
						НоваяЗапись = НаборЗаписей.Добавить();
						НоваяЗапись.ЭлементСсылка = Изделие;
						НоваяЗапись.НомерЗаписи = НомерЗаписи;
						НоваяЗапись.ВидНабора = ВидНабора;
						НоваяЗапись.ПотомокСсылка = ТехпроцессИлиМаршрут;
						НоваяЗапись.ЭлементСсылка1 = СтрокаПунктаМаршрута.ЭлементСсылка; // пункт маршрута
						НоваяЗапись.ЭлементСсылка2 = СтрокаОперации.ЭлементСсылка; // операция
						НоваяЗапись.ЭлементСсылка3 = СтрокаКомплектованияИСТО.ЭлементСсылка; // элемент комплектования
						
						ЗаполнитьПараметрыКомплектования(НоваяЗапись, СтрокаКомплектованияИСТО);
						
						// параметры операции
						НоваяЗапись.НомерОперации = НомерОперации;
						НоваяЗапись.ВидОперации = ВидОперации;
						НоваяЗапись.ВремяВыполнения = ВремяВыполнения;
						НоваяЗапись.ПодготовительноеВремя=ПодготовительноеВремя;
						НоваяЗапись.ЕдиницаИзмеренияВремени=ЕдиницаИзмеренияВремени;
						НоваяЗапись.РабочийЦентр = РабочийЦентр;
						НоваяЗапись.Профессия	=Профессия;
						НоваяЗапись.РазрядРабот	=РазрядРабот;
						НоваяЗапись.УсловияТруда=УсловияТруда;
						
						// параметры пункта маршрута
						НоваяЗапись.Подразделение = Подразделение;
						НоваяЗапись.КОИД=КОИД;
						НоваяЗапись.НоменклатураПолуфабриката = НоменклатураПолуфабриката;
						НоваяЗапись.ХарактеристикаПолуфабриката = ХарактеристикаПолуфабриката;
						
						ЗаписатьВерсииДанных( НоваяЗапись, Изделие.ИндексВерсии,
							?(ЗначениеЗаполнено(НоваяЗапись.ПотомокСсылка), НоваяЗапись.ПотомокСсылка.ИндексВерсии, 0),
							?(ЗначениеЗаполнено(НоваяЗапись.ЭлементСсылка1), НоваяЗапись.ЭлементСсылка1.ИндексВерсии, 0),
							?(ЗначениеЗаполнено(НоваяЗапись.ЭлементСсылка2), НоваяЗапись.ЭлементСсылка2.ИндексВерсии, 0),
							?(ЗначениеЗаполнено(НоваяЗапись.ЭлементСсылка3), НоваяЗапись.ЭлементСсылка3.ИндексВерсии, 0));
								
					КонецЦикла;
					
					// содержание операции
					МассивСтрокПереходов = ТаблицаСодержанияОпераций.НайтиСтроки(Новый Структура("РодительСсылка", СтрокаОперации.ЭлементСсылка));
