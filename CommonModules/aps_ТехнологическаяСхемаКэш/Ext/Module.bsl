		ЗаписьВыходноеИзделие.Характеристика = ?(СтрокаПараметра <> Неопределено, СтрокаПараметра.Значение, Неопределено);
		СтрокаПараметра = ТаблицаПараметров.Найти(ПланыВидовХарактеристик.aps_Свойства.Состояние, "Свойство");
		ЗаписьВыходноеИзделие.Состояние = ?(СтрокаПараметра <> Неопределено, СтрокаПараметра.Значение, Неопределено);
		
		// Записать значение свойства "Непланируемый"
		// В константе "ERPКорпПараметрУзла" должен быть задан булевый параметр, отвечающий за
		// то, что элемент не будет учитываться при планировании производства. Истина -- если не будет
		СтрокаПараметра = ТаблицаПараметров.Найти(
		Константы.aps_ТехСхемаПараметрУзла.Получить(), "Свойство");
		ЗаписьВыходноеИзделие.Непланируемый = ?(СтрокаПараметра <> Неопределено, СтрокаПараметра.Значение, Неопределено);
		///////////////////////////////////////////////
		
		ЗаписьВыходноеИзделие.ЭлементСсылка2 = ПоследняяОперация;
		ЗаписьВыходноеИзделие.Подразделение = ПараметрыПоследнейОперации.Подразделение;
		ЗаписьВыходноеИзделие.НомерОперации = ПараметрыПоследнейОперации.НомерОперации;
		ЗаписьВыходноеИзделие.ВидОперации = ПараметрыПоследнейОперации.ВидОперации;
		ЗаписьВыходноеИзделие.РабочийЦентр = ПараметрыПоследнейОперации.РабочийЦентр;
		ЗаписьВыходноеИзделие.ВремяВыполнения = ПараметрыПоследнейОперации.ВремяВыполнения;
		ЗаписьВыходноеИзделие.ПодготовительноеВремя = ПараметрыПоследнейОперации.ПодготовительноеВремя;
		ЗаписьВыходноеИзделие.ЕдиницаИзмеренияВремени=ЕдиницаИзмеренияВремени;
		ЗаписьВыходноеИзделие.ЭлементСсылка1=ПараметрыПоследнейОперации.ПунктМаршрута;
		
		ЗаписатьВерсииДанных( ЗаписьВыходноеИзделие, Изделие.ИндексВерсии,
						  ?(ЗначениеЗаполнено(ЗаписьВыходноеИзделие.ПотомокСсылка), ЗаписьВыходноеИзделие.ПотомокСсылка.ИндексВерсии, 0),
						  ?(ЗначениеЗаполнено(ЗаписьВыходноеИзделие.ЭлементСсылка1), ЗаписьВыходноеИзделие.ЭлементСсылка1.ИндексВерсии, 0),
						  ?(ЗначениеЗаполнено(ЗаписьВыходноеИзделие.ЭлементСсылка2), ЗаписьВыходноеИзделие.ЭлементСсылка2.ИндексВерсии, 0),
						  ?(ЗначениеЗаполнено(ЗаписьВыходноеИзделие.ЭлементСсылка3), ЗаписьВыходноеИзделие.ЭлементСсылка3.ИндексВерсии, 0));
		ЗаписьВыходноеИзделие.Записать();
	КонецЦикла;  
	
	ТаблицаКомплектованияОсновныхМатериаловСТО.Свернуть( "ЭлементСсылка", "Уровень" );
	ТаблицаКомплектованияОсновныхМатериаловСТО.Колонки.Добавить("Статус", Новый ОписаниеТипов("ПеречислениеСсылка.СтатусФормированияERP"));
	Возврат ТаблицаКомплектованияОсновныхМатериаловСТО;
КонецФункции

// Итератор применяемости подчиненных элементов с ревизиями
// Параметры:
//		ИсхТаблица - таблица значений
//		ВключаяПараметры - булево (необязательный)
//		ВидСвязи - СправочникСсылка.aps_ШаблоныТехнологическихСвязей (необязательный)
// Возвращаемое значение:
//		ТаблицаЗначений
// Пример:
//		ПрименяемостьПунктовМаршрута = локПрименяемостьПодчиненныхЭлементовСРевизиями(ТаблицаПунктовМаршрута, Справочники.aps_ШаблоныТехнологическихСвязей.ПунктыМаршрута);
//
Функция локПрименяемостьПодчиненныхЭлементовСРевизиями(ИсхТаблица, ВключаяПараметры=Истина, ВидСвязи=Неопределено) Экспорт
	Если ИсхТаблица.Количество() = 0 Тогда
		Возврат ИсхТаблица;
	КонецЕсли;
	
	Таблица=ИсхТаблица.Скопировать();
	Таблица.Свернуть("ЭлементСсылка, Изделие");
	
	МенеджерВТ=Новый МенеджерВременныхТаблиц;
	
	ЗапросИтератора=Новый Запрос();
	ЗапросИтератора.МенеджерВременныхТаблиц=МенеджерВТ;
	// Текст запроса для построения временной таблицы
	ЗапросИтератора.Текст="ВЫБРАТЬ
	                      |	ТаблицаСсылок.ЭлементСсылка КАК Ссылка,
						  | ТаблицаСсылок.Изделие КАК Изделие
	                      |ПОМЕСТИТЬ ВТСсылки
	                      |ИЗ
	                      |	&Данные КАК ТаблицаСсылок";
	ЗапросИтератора.УстановитьПараметр("Данные",Таблица);
	ЗапросИтератора.Выполнить();
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	Применяемость.РодительСсылка КАК РодительСсылка,
				   |	Применяемость.РодительСсылка.ВидЭлемента КАК ВидРодителя,
	               |	ВЫБОР
	               |		КОГДА Применяемость.РодительСсылка.ИндексКартинки = 0
	               |			ТОГДА Применяемость.РодительСсылка.ВидЭлемента.ИндексКартинки
	               |		ИНАЧЕ Применяемость.РодительСсылка.ИндексКартинки
	               |	КОНЕЦ КАК Картинка,
	               |	Применяемость.РодительСсылка.Наименование КАК ПредставлениеЭлемента,
	               |	Применяемость.ЭлементСсылка КАК ЭлементСсылка,
				   |	Применяемость.ЭлементСсылка.ВидЭлемента КАК ВидЭлемента,
				   |	ВЫБОР
	               |		КОГДА Применяемость.ОригиналРевизии = НЕОПРЕДЕЛЕНО
	               |			ТОГДА Применяемость.ЭлементСсылка
	               |		ИНАЧЕ Применяемость.ОригиналРевизии
	               |	КОНЕЦ КАК ОригиналРевизии,
	               |	Применяемость.ВидСвязи КАК ВидСвязи,
	               |	Применяемость.ПредставлениеСвязи КАК ПредставлениеСвязи,
	               |	Применяемость.ОбратнаяСвязь КАК ОбратнаяСвязь,
				   |	Применяемость.Изделие КАК Изделие
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ПодчиненныеЭлементыТехнологии.Ссылка КАК ЭлементСсылка,
	               |		ПодчиненныеЭлементыТехнологии.ЭлементСсылка КАК РодительСсылка,
				   |		ПодчиненныеЭлементыТехнологии.ЭлементСсылка.ОригиналРевизии КАК ОригиналРевизии,
	               |		ПодчиненныеЭлементыТехнологии.ВидСвязи КАК ВидСвязи,
	               |		ПодчиненныеЭлементыТехнологии.ВидСвязи.Наименование КАК ПредставлениеСвязи,
				   |		ВТСсылки.Изделие КАК Изделие,
	               |		ЛОЖЬ КАК ОбратнаяСвязь
	               |	ИЗ
	               |		Справочник.aps_ЭлементыТехнологии.ПодчиненныеЭлементыТехнологии КАК ПодчиненныеЭлементыТехнологии
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТСсылки КАК ВТСсылки
	               |			ПО (ВТСсылки.Ссылка = ПодчиненныеЭлементыТехнологии.ЭлементСсылка)
	               |				И (НЕ ПодчиненныеЭлементыТехнологии.Ссылка.ПометкаУдаления)) КАК Применяемость";
	Если ВидСвязи <> Неопределено Тогда 
		ТекстЗапроса = ТекстЗапроса + "
	               |ГДЕ Применяемость.ВидСвязи В(&ВидСвязи)";
		ЗапросИтератора.УстановитьПараметр("ВидСвязи", ВидСвязи);
	КонецЕсли;
	ТекстЗапроса = ТекстЗапроса + "
	               |УПОРЯДОЧИТЬ ПО
	               |	Применяемость.ЭлементСсылка.ВидЭлемента.Код,
	               |	Применяемость.ЭлементСсылка.Наименование";
								   
	ЗапросИтератора.Текст = ТекстЗапроса;			   
	РезультатИтератора = ЗапросИтератора.Выполнить().Выгрузить();
	
	ПравилоУправления = Справочники.aps_ПравилаУправления.СоздатьЭлемент();
	Условие = ПравилоУправления.Условия.Добавить();
	Условие.Свойство					=ПланыВидовХарактеристик.aps_Свойства.СпособСозданияРевизии;
	Условие.Значение					=Справочники.aps_СпособыСозданияРевизий.Представление;
	Условие.ВидСравнения				=Перечисления.aps_ВидыСравнения.Равно;
	Условие.ОбязательноНаличиеПараметра	=Истина;
	
	МассивСтрокДляПоискаРевизий = Новый Массив();
	МассивЭлементов = Новый Массив();
	Для Каждого СтрокаРезультата Из РезультатИтератора Цикл
		Если СтрокаРезультата.Изделие <> Неопределено Тогда
			МассивСтрокДляПоискаРевизий.Добавить(СтрокаРезультата); // ссылка на строку
			МассивЭлементов.Добавить(СтрокаРезультата.ОригиналРевизии);
		КонецЕсли;
	КонецЦикла;	
	
	ПодобранныеРевизииЭлементов = aps_Итераторы.aps_ПодборРевизийЭлементов(МассивЭлементов, ПравилоУправления);
	
	i = 0;
	Пока i < МассивСтрокДляПоискаРевизий.Количество() Цикл 
		СтрокаРезультата = МассивСтрокДляПоискаРевизий[i];
		
		СтрокиРевизий = ПодобранныеРевизииЭлементов.НайтиСтроки(Новый Структура("ОригиналРевизии", СтрокаРезультата.ОригиналРевизии));
		Для Каждого СтрокаПодобраннойРевизии Из СтрокиРевизий Цикл
			ПараметрИзделие = СтрокаПодобраннойРевизии.ПараметрыЭлементаТехнологии.Найти(ПланыВидовХарактеристик.aps_Свойства.Изделие, "Свойство");
			Если ПараметрИзделие <> Неопределено 
					И ПараметрИзделие.Значение = СтрокаРезультата.Изделие Тогда
				ЗаполнитьЗначенияСвойств(СтрокаРезультата, СтрокаПодобраннойРевизии);
				СтрокаРезультата.РевизияПодобрана=Истина;	
			КонецЕсли;
		КонецЦикла;
		
		i = i + 1;
	КонецЦикла;
	
	Возврат РезультатИтератора;
КонецФункции

// Итератор подчиненных элементов с ревизиями
// Параметры:
//		Таблица - таблица значений
//		ВключаяПараметры - булево (необязательный)
// Возвращаемое значение:
//		ТаблицаЗначений
// Пример:
//		ТаблицаПунктовМаршрута = локПодчиненныеЭлементыСРевизиями(ТаблицаМаршрутов); 
//
Функция локПодчиненныеЭлементыСРевизиями(Таблица, ВключаяПараметры=Истина) Экспорт
	Если Таблица.Количество() = 0 Тогда
		Возврат Таблица;
	КонецЕсли;
	
	МассивТипов=Новый Массив;
	МассивТипов.Добавить(Тип("СправочникСсылка.aps_ЭлементыИзделия"));
	МассивТипов.Добавить(Тип("СправочникСсылка.aps_ЭлементыСправочников"));
	МассивТипов.Добавить(Тип("СправочникСсылка.aps_ЭлементыТехнологии"));
	ОписаниеТиповЭлемента=Новый ОписаниеТипов(МассивТипов);
	
	МенеджерВТ=Новый МенеджерВременныхТаблиц;
	
	ЗапросИтератора=Новый Запрос();
	ЗапросИтератора.МенеджерВременныхТаблиц=МенеджерВТ;
	// Текст запроса для построения временной таблицы
	ЗапросИтератора.Текст="ВЫБРАТЬ
	                      |	ТаблицаСсылок.ЭлементСсылка КАК Ссылка,
						  | ТаблицаСсылок.Изделие КАК Изделие
	                      |ПОМЕСТИТЬ ВТСсылки
	                      |ИЗ
	                      |	&Данные КАК ТаблицаСсылок";
	ЗапросИтератора.УстановитьПараметр("Данные",Таблица);
	ЗапросИтератора.Выполнить();
	// Получаем таблицу из менеджера временных таблиц запроса
	ЗапросИтератора.Текст="ВЫБРАТЬ
						 |	ВЫРАЗИТЬ(Ссылка КАК Справочник.aps_ЭлементыТехнологии).ПодчиненныеЭлементыТехнологии.(Ссылка КАК РодительСсылка, ЭлементСсылка, ВидСвязи, НомерСтроки) КАК ПодчиненныеЭлементыТехнологии,
						 |	Изделие КАК Изделие
						 |ИЗ
						 |	ВТСсылки";
	СуществующиеСсылки=ЗапросИтератора.Выполнить().Выгрузить();
    // Формируем общую таблицу из полученных табличных частей
	ТаблицаПодчиненных = Неопределено;
	Для i=0 По СуществующиеСсылки.Количество()-1 Цикл 
		Для Каждого СтрокаПодчинения Из СуществующиеСсылки[i].ПодчиненныеЭлементыТехнологии Цикл 
			Если ТаблицаПодчиненных = Неопределено Тогда 
				ТаблицаПодчиненных = СуществующиеСсылки[i].ПодчиненныеЭлементыТехнологии.Скопировать();
				ТаблицаПодчиненных.Колонки.Добавить("Изделие", Новый ОписаниеТипов("СправочникСсылка.aps_ЭлементыИзделия, СправочникСсылка.aps_ЭлементыСправочников, СправочникСсылка.aps_ЭлементыТехнологии"));
				ТаблицаПодчиненных.Очистить();
			КонецЕсли;
			НоваяСтрока = ТаблицаПодчиненных.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПодчинения);
			НоваяСтрока.Изделие = СуществующиеСсылки[i].Изделие;
		КонецЦикла;
	КонецЦикла;
	
	Если ТаблицаПодчиненных = Неопределено Тогда // не выполнять запрос
		РезультатИтератора = Новый ТаблицаЗначений;
		РезультатИтератора.Колонки.Добавить("ЭлементСсылка",Новый ОписаниеТипов("СправочникСсылка.aps_ЭлементыИзделия, СправочникСсылка.aps_ЭлементыСправочников, СправочникСсылка.aps_ЭлементыТехнологии"));
		РезультатИтератора.Колонки.Добавить("РодительСсылка",Новый ОписаниеТипов("СправочникСсылка.aps_ЭлементыИзделия, СправочникСсылка.aps_ЭлементыСправочников, СправочникСсылка.aps_ЭлементыТехнологии"));
		РезультатИтератора.Колонки.Добавить("ВидРодителя");
		РезультатИтератора.Колонки.Добавить("ОригиналРевизии");
		РезультатИтератора.Колонки.Добавить("РевизияПодобрана");
		РезультатИтератора.Колонки.Добавить("ВидЭлемента");
		РезультатИтератора.Колонки.Добавить("Картинка");
		РезультатИтератора.Колонки.Добавить("ПредставлениеЭлемента");
		РезультатИтератора.Колонки.Добавить("Владелец");
		РезультатИтератора.Колонки.Добавить("Группа");
		РезультатИтератора.Колонки.Добавить("HTMLКонтент");
		РезультатИтератора.Колонки.Добавить("ВидСвязи");
		РезультатИтератора.Колонки.Добавить("ПорядокВывода");
		РезультатИтератора.Колонки.Добавить("ПараметрыЭлементаИзделия");
		РезультатИтератора.Колонки.Добавить("ПараметрыЭлементаСправочника");
		РезультатИтератора.Колонки.Добавить("ПараметрыЭлементаТехнологии");
		РезультатИтератора.Колонки.Добавить("Изделие");
		Возврат РезультатИтератора;
	КонецЕсли;		
	
	ЗапросИтератора.Текст="ВЫБРАТЬ *
						 |ПОМЕСТИТЬ ВТПодчиненныеЭлементы
						 |ИЗ
						 |	&Данные КАК ТаблицаСсылок";
	ЗапросИтератора.УстановитьПараметр("Данные",ТаблицаПодчиненных);
	ЗапросИтератора.Выполнить();	
	
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	НЕОПРЕДЕЛЕНО КАК ЭлементСвязи,
	               |	ПодчиненныеЭлементы.ЭлементСсылка,
	               |	ПодчиненныеЭлементы.РодительСсылка,
				   |	ПодчиненныеЭлементы.ВидРодителя,
	               |	ВЫБОР
	               |		КОГДА ПодчиненныеЭлементы.ОригиналРевизии = НЕОПРЕДЕЛЕНО
	               |			ТОГДА ПодчиненныеЭлементы.ЭлементСсылка
	               |		ИНАЧЕ ПодчиненныеЭлементы.ОригиналРевизии
	               |	КОНЕЦ КАК ОригиналРевизии,
	               |	ЛОЖЬ КАК РевизияПодобрана,
				   |	ПодчиненныеЭлементы.ВидЭлемента,
				   |	ПодчиненныеЭлементы.КодВидаЭлемента,				   
	               |	ПодчиненныеЭлементы.Картинка,
	               |	ПодчиненныеЭлементы.ПредставлениеЭлемента,
	               |	ПодчиненныеЭлементы.Владелец,
	               |	ПодчиненныеЭлементы.Группа,
	               |	ПодчиненныеЭлементы.HTMLКонтент,
	               |	ПодчиненныеЭлементы.ВидСвязи,
	               |	ПодчиненныеЭлементы.ПорядокВывода,
	               |	ЛОЖЬ КАК ОбратнаяСвязь,
				   |	ПодчиненныеЭлементы.Изделие КАК Изделие";
	Если ВключаяПараметры Тогда 
		ТекстЗапроса = ТекстЗапроса + ",
				   |	ВЫРАЗИТЬ(ПодчиненныеЭлементы.ЭлементСсылка КАК Справочник.aps_ЭлементыИзделия).Параметры.(Параметр, Параметр.Наименование КАК ИмяПараметра, Параметр.Свойство КАК Свойство, Параметр.Значение КАК Значение, Параметр.ЕдиницаИзмерения КАК ЕдиницаИзмерения, Параметр.Родитель КАК ГруппаПараметров, Параметр.Родитель.Наименование КАК ИмяГруппыПараметров) КАК ПараметрыЭлементаИзделия,
				   |	ВЫРАЗИТЬ(ПодчиненныеЭлементы.ЭлементСсылка КАК Справочник.aps_ЭлементыСправочников).Параметры.(Параметр, Параметр.Наименование КАК ИмяПараметра, Параметр.Свойство КАК Свойство, Параметр.Значение КАК Значение, Параметр.ЕдиницаИзмерения КАК ЕдиницаИзмерения, Параметр.Родитель КАК ГруппаПараметров, Параметр.Родитель.Наименование КАК ИмяГруппыПараметров) КАК ПараметрыЭлементаСправочника,
				   |	ВЫРАЗИТЬ(ПодчиненныеЭлементы.ЭлементСсылка КАК Справочник.aps_ЭлементыТехнологии).Параметры.(Параметр, Параметр.Наименование КАК ИмяПараметра, Параметр.Свойство КАК Свойство, Параметр.Значение КАК Значение, Параметр.ЕдиницаИзмерения КАК ЕдиницаИзмерения, Параметр.Родитель КАК ГруппаПараметров, Параметр.Родитель.Наименование КАК ИмяГруппыПараметров) КАК ПараметрыЭлементаТехнологии,
				   |	НЕОПРЕДЕЛЕНО КАК ПараметрыЭлементаСвязи";
	КонецЕсли;				   
	ТекстЗапроса = ТекстЗапроса + "
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ПодчиненныеЭлементы.РодительСсылка КАК РодительСсылка,
				   |		ПодчиненныеЭлементы.РодительСсылка.ВидЭлемента КАК ВидРодителя,
				   |		ПодчиненныеЭлементы.ЭлементСсылка КАК ЭлементСсылка,
	               |		ПодчиненныеЭлементы.ЭлементСсылка.ОригиналРевизии КАК ОригиналРевизии,
	               |		ПодчиненныеЭлементы.ЭлементСсылка.ВидЭлемента КАК ВидЭлемента,
	               |		ВЫБОР
	               |			КОГДА ПодчиненныеЭлементы.ЭлементСсылка.ИндексКартинки = 0
	               |				ТОГДА ПодчиненныеЭлементы.ЭлементСсылка.ВидЭлемента.ИндексКартинки
	               |			ИНАЧЕ ПодчиненныеЭлементы.ЭлементСсылка.ИндексКартинки
	               |		КОНЕЦ КАК Картинка,
	               |		ПодчиненныеЭлементы.ЭлементСсылка.Наименование КАК ПредставлениеЭлемента,
	               |		ПодчиненныеЭлементы.ЭлементСсылка.UID КАК Владелец,
	               |		ПодчиненныеЭлементы.ЭлементСсылка.GID КАК Группа,
	               |		ПодчиненныеЭлементы.ЭлементСсылка.HTMLКонтент КАК HTMLКонтент,
	               |		ПодчиненныеЭлементы.ЭлементСсылка.ВидЭлемента.Код КАК КодВидаЭлемента,
	               |		ПодчиненныеЭлементы.ВидСвязи КАК ВидСвязи,
	               |		ПодчиненныеЭлементы.НомерСтроки КАК ПорядокВывода,
	               |		ВЫБОР
	               |			КОГДА ПодчиненныеЭлементы.ВидСвязи.Автоупорядочивание
	               |				ТОГДА 0
	               |			ИНАЧЕ ПодчиненныеЭлементы.НомерСтроки
	               |		КОНЕЦ КАК Порядок,
				   |		ПодчиненныеЭлементы.Изделие КАК Изделие
	               |	ИЗ
				   |		ВТПодчиненныеЭлементы КАК ПодчиненныеЭлементы) КАК ПодчиненныеЭлементы";
	ТекстЗапроса = ТекстЗапроса + "
	               |УПОРЯДОЧИТЬ ПО
				   |	ПодчиненныеЭлементы.РодительСсылка,
				   |	ПодчиненныеЭлементы.Порядок,
	               |	ПодчиненныеЭлементы.КодВидаЭлемента,
	               |	ПодчиненныеЭлементы.ПредставлениеЭлемента";
				   
	ЗапросИтератора.Текст = ТекстЗапроса;
	РезультатИтератора = ЗапросИтератора.Выполнить().Выгрузить();
	
	ПравилоУправления = Справочники.aps_ПравилаУправления.СоздатьЭлемент();
	Условие = ПравилоУправления.Условия.Добавить();
	Условие.Свойство					=ПланыВидовХарактеристик.aps_Свойства.СпособСозданияРевизии;
	Условие.Значение					=Справочники.aps_СпособыСозданияРевизий.Представление;
	Условие.ВидСравнения				=Перечисления.aps_ВидыСравнения.Равно;
	Условие.ОбязательноНаличиеПараметра	=Истина;
	
	МассивСтрокДляПоискаРевизий = Новый Массив();
	МассивЭлементов = Новый Массив();
	Для Каждого СтрокаРезультата Из РезультатИтератора Цикл
		Если СтрокаРезультата.Изделие <> Неопределено Тогда
			МассивСтрокДляПоискаРевизий.Добавить(СтрокаРезультата); // ссылка на строку
			МассивЭлементов.Добавить(СтрокаРезультата.ОригиналРевизии);
		КонецЕсли;
	КонецЦикла;
	
	ПодобранныеРевизииЭлементов = aps_Итераторы.aps_ПодборРевизийЭлементов(МассивЭлементов, ПравилоУправления);
	
	i = 0;
	Пока i < МассивСтрокДляПоискаРевизий.Количество() Цикл 
		СтрокаРезультата = МассивСтрокДляПоискаРевизий[i];
		
		СтрокиРевизий = ПодобранныеРевизииЭлементов.НайтиСтроки(Новый Структура("ОригиналРевизии", СтрокаРезультата.ОригиналРевизии));
		Для Каждого СтрокаПодобраннойРевизии Из СтрокиРевизий Цикл
			ПараметрИзделие = СтрокаПодобраннойРевизии.ПараметрыЭлементаТехнологии.Найти(ПланыВидовХарактеристик.aps_Свойства.Изделие, "Свойство");
			Если ПараметрИзделие <> Неопределено 
					И ПараметрИзделие.Значение = СтрокаРезультата.Изделие Тогда
				ЗаполнитьЗначенияСвойств(СтрокаРезультата, СтрокаПодобраннойРевизии);
				СтрокаРезультата.РевизияПодобрана=Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		i = i + 1;
	КонецЦикла;
	
	Возврат РезультатИтератора;
КонецФункции

// Табличный итератор подчиненных элементов
// Параметры:
//		Таблица - таблица значений
//		ПравилоУправления - СправочникСсылка.aps_ПравилаУправления (необязательный)
//		ВключаяПараметры - булево (необязательный)
//		ОбратныеСвязи - булево (необязательный)
// Возвращаемое значение:
//		ТаблицаЗначений
// Пример:
//		ТаблицаСодержанияОпераций = локПодчиненныеЭлементы( ТаблицаОпераций );
//
Функция локПодчиненныеЭлементы( Таблица, Знач ПравилоУправления = Неопределено, ВключаяПараметры = Истина, ОбратныеСвязи = Ложь) Экспорт 
	Если Таблица.Количество() = 0 Тогда
		Возврат Таблица;
	КонецЕсли;
	
	Если ТипЗнч(ПравилоУправления) = Тип("Строка") Тогда	// передается строка XML
		ПравилоУправления = Строка2Object1С(ПравилоУправления);
	КонецЕсли;
	
	МассивТипов=Новый Массив;
	МассивТипов.Добавить(Тип("СправочникСсылка.aps_ЭлементыИзделия"));
	МассивТипов.Добавить(Тип("СправочникСсылка.aps_ЭлементыСправочников"));
	МассивТипов.Добавить(Тип("СправочникСсылка.aps_ЭлементыТехнологии"));
	ОписаниеТиповЭлемента=Новый ОписаниеТипов(МассивТипов);
	
		
	
	МенеджерВТ=Новый МенеджерВременныхТаблиц;
	
	ЗапросИтератора=Новый Запрос();
	ЗапросИтератора.МенеджерВременныхТаблиц=МенеджерВТ;
	// Текст запроса для построения временной таблицы
	ЗапросИтератора.Текст="ВЫБРАТЬ
	                      |	ТаблицаСсылок.ЭлементСсылка КАК Ссылка
	                      |ПОМЕСТИТЬ ВТСсылки
	                      |ИЗ
	                      |	&Данные КАК ТаблицаСсылок";
	ЗапросИтератора.УстановитьПараметр("Данные",Таблица);
	ЗапросИтератора.Выполнить();
	// Получаем таблицу из менеджера временных таблиц запроса
	ЗапросИтератора.Текст="ВЫБРАТЬ
						 |	ВЫРАЗИТЬ(Ссылка КАК Справочник.aps_ЭлементыТехнологии).ПодчиненныеЭлементыТехнологии.(Ссылка КАК РодительСсылка, ЭлементСсылка, ВидСвязи, НомерСтроки) КАК ПодчиненныеЭлементыТехнологии
						 |ИЗ
						 |	ВТСсылки";
	СуществующиеСсылки=ЗапросИтератора.Выполнить().Выгрузить();
    // Формируем общую таблицу из полученных табличных частей
	ТаблицаПодчиненных = Неопределено;
	Для i=0 По СуществующиеСсылки.Количество()-1 Цикл 
		Для c=0 По СуществующиеСсылки.Колонки.Количество()-1 Цикл 
			Для Каждого СтрокаПодчинения Из СуществующиеСсылки[i][c] Цикл 
				Если ТаблицаПодчиненных = Неопределено Тогда 
					ТаблицаПодчиненных = СуществующиеСсылки[i][c].Скопировать();
					ТаблицаПодчиненных.Очистить();
				КонецЕсли;
				ЗаполнитьЗначенияСвойств(ТаблицаПодчиненных.Добавить(), СтрокаПодчинения);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	Если ТаблицаПодчиненных = Неопределено Тогда // не выполнять запрос
		РезультатИтератора = Новый ТаблицаЗначений;
		РезультатИтератора.Колонки.Добавить("ЭлементСсылка");
		РезультатИтератора.Колонки.Добавить("РодительСсылка");
		РезультатИтератора.Колонки.Добавить("ВидРодителя");
		РезультатИтератора.Колонки.Добавить("ОригиналРевизии");
		РезультатИтератора.Колонки.Добавить("РевизияПодобрана");
		РезультатИтератора.Колонки.Добавить("ВидЭлемента");
		РезультатИтератора.Колонки.Добавить("Картинка");
		РезультатИтератора.Колонки.Добавить("ПредставлениеЭлемента");
		РезультатИтератора.Колонки.Добавить("Владелец");
		РезультатИтератора.Колонки.Добавить("Группа");
		РезультатИтератора.Колонки.Добавить("HTMLКонтент");
		РезультатИтератора.Колонки.Добавить("ВидСвязи");
		РезультатИтератора.Колонки.Добавить("ПорядокВывода");
		РезультатИтератора.Колонки.Добавить("ПараметрыЭлементаИзделия");
		РезультатИтератора.Колонки.Добавить("ПараметрыЭлементаСправочника");
		РезультатИтератора.Колонки.Добавить("ПараметрыЭлементаТехнологии");
		Возврат РезультатИтератора;
	КонецЕсли;		
	
	ЗапросИтератора.Текст="ВЫБРАТЬ *
						 |ПОМЕСТИТЬ ВТПодчиненныеЭлементы
						 |ИЗ
						 |	&Данные КАК ТаблицаСсылок";
	ЗапросИтератора.УстановитьПараметр("Данные",ТаблицаПодчиненных);
	ЗапросИтератора.Выполнить();	
	
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	НЕОПРЕДЕЛЕНО КАК ЭлементСвязи,
	               |	ERPКэшПодчиненныеЭлементы.ЭлементСсылка,
	               |	ERPКэшПодчиненныеЭлементы.РодительСсылка,
				   |	ERPКэшПодчиненныеЭлементы.ВидРодителя,
	               |	ВЫБОР
	               |		КОГДА ERPКэшПодчиненныеЭлементы.ОригиналРевизии = НЕОПРЕДЕЛЕНО
	               |			ТОГДА ERPКэшПодчиненныеЭлементы.ЭлементСсылка
	               |		ИНАЧЕ ERPКэшПодчиненныеЭлементы.ОригиналРевизии
	               |	КОНЕЦ КАК ОригиналРевизии,
	               |	ЛОЖЬ КАК РевизияПодобрана,
				   |	ERPКэшПодчиненныеЭлементы.ВидЭлемента,
				   |	ERPКэшПодчиненныеЭлементы.КодВидаЭлемента,				   
	               |	ERPКэшПодчиненныеЭлементы.Картинка,
	               |	ERPКэшПодчиненныеЭлементы.ПредставлениеЭлемента,
	               |	ERPКэшПодчиненныеЭлементы.Владелец,
	               |	ERPКэшПодчиненныеЭлементы.Группа,
	               |	ERPКэшПодчиненныеЭлементы.HTMLКонтент,
	               |	ERPКэшПодчиненныеЭлементы.ВидСвязи,
	               |	ERPКэшПодчиненныеЭлементы.ПорядокВывода,
	               |	ЛОЖЬ КАК ОбратнаяСвязь";
	Если ВключаяПараметры Тогда 
		ТекстЗапроса = ТекстЗапроса + ",
	               |	ВЫРАЗИТЬ(ERPКэшПодчиненныеЭлементы.ЭлементСсылка КАК Справочник.aps_ЭлементыИзделия).Параметры.(Параметр, Параметр.Наименование КАК ИмяПараметра, Параметр.Свойство КАК Свойство, Параметр.Значение КАК Значение, Параметр.ЕдиницаИзмерения КАК ЕдиницаИзмерения, Параметр.Родитель КАК ГруппаПараметров, Параметр.Родитель.Наименование КАК ИмяГруппыПараметров) КАК ПараметрыЭлементаИзделия,
	               |	ВЫРАЗИТЬ(ERPКэшПодчиненныеЭлементы.ЭлементСсылка КАК Справочник.aps_ЭлементыСправочников).Параметры.(Параметр, Параметр.Наименование КАК ИмяПараметра, Параметр.Свойство КАК Свойство, Параметр.Значение КАК Значение, Параметр.ЕдиницаИзмерения КАК ЕдиницаИзмерения, Параметр.Родитель КАК ГруппаПараметров, Параметр.Родитель.Наименование КАК ИмяГруппыПараметров) КАК ПараметрыЭлементаСправочника,
	               |	ВЫРАЗИТЬ(ERPКэшПодчиненныеЭлементы.ЭлементСсылка КАК Справочник.aps_ЭлементыТехнологии).Параметры.(Параметр, Параметр.Наименование КАК ИмяПараметра, Параметр.Свойство КАК Свойство, Параметр.Значение КАК Значение, Параметр.ЕдиницаИзмерения КАК ЕдиницаИзмерения, Параметр.Родитель КАК ГруппаПараметров, Параметр.Родитель.Наименование КАК ИмяГруппыПараметров) КАК ПараметрыЭлементаТехнологии,
				   |	НЕОПРЕДЕЛЕНО КАК ПараметрыЭлементаСвязи";
	КонецЕсли;				   
	ТекстЗапроса = ТекстЗапроса + "
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ERPКэшПодчиненныеЭлементы.РодительСсылка КАК РодительСсылка,
				   |		ERPКэшПодчиненныеЭлементы.РодительСсылка.ВидЭлемента КАК ВидРодителя,
				   |		ERPКэшПодчиненныеЭлементы.ЭлементСсылка КАК ЭлементСсылка,
	               |		ERPКэшПодчиненныеЭлементы.ЭлементСсылка.ОригиналРевизии КАК ОригиналРевизии,
	               |		ERPКэшПодчиненныеЭлементы.ЭлементСсылка.ВидЭлемента КАК ВидЭлемента,
	               |		ВЫБОР
	               |			КОГДА ERPКэшПодчиненныеЭлементы.ЭлементСсылка.ИндексКартинки = 0
	               |				ТОГДА ERPКэшПодчиненныеЭлементы.ЭлементСсылка.ВидЭлемента.ИндексКартинки
	               |			ИНАЧЕ ERPКэшПодчиненныеЭлементы.ЭлементСсылка.ИндексКартинки
	               |		КОНЕЦ КАК Картинка,
	               |		ERPКэшПодчиненныеЭлементы.ЭлементСсылка.Наименование КАК ПредставлениеЭлемента,
	               |		ERPКэшПодчиненныеЭлементы.ЭлементСсылка.UID КАК Владелец,
	               |		ERPКэшПодчиненныеЭлементы.ЭлементСсылка.GID КАК Группа,
	               |		ERPКэшПодчиненныеЭлементы.ЭлементСсылка.HTMLКонтент КАК HTMLКонтент,
	               |		ERPКэшПодчиненныеЭлементы.ЭлементСсылка.ВидЭлемента.Код КАК КодВидаЭлемента,
	               |		ERPКэшПодчиненныеЭлементы.ВидСвязи КАК ВидСвязи,
	               |		ERPКэшПодчиненныеЭлементы.НомерСтроки КАК ПорядокВывода,
	               |		ВЫБОР
	               |			КОГДА ERPКэшПодчиненныеЭлементы.ВидСвязи.Автоупорядочивание
	               |				ТОГДА 0
	               |			ИНАЧЕ ERPКэшПодчиненныеЭлементы.НомерСтроки
	               |		КОНЕЦ КАК Порядок
	               |	ИЗ
	               |		ВТПодчиненныеЭлементы КАК ERPКэшПодчиненныеЭлементы) КАК ERPКэшПодчиненныеЭлементы";
	Если ПравилоУправления <> Неопределено И ПравилоУправления.ВидыЭлементовФильтр.Количество() > 0 Тогда 
		ТекстЗапроса = ТекстЗапроса + "
				   |ГДЕ ERPКэшПодчиненныеЭлементы.ВидЭлемента В(&ВидыЭлементов)";
		ЗапросИтератора.УстановитьПараметр("ВидыЭлементов", ПравилоУправления.ВидыЭлементовФильтр.ВыгрузитьКолонку(0));
	КонецЕсли;
	ТекстЗапроса = ТекстЗапроса + "
	               |УПОРЯДОЧИТЬ ПО
				   |	ERPКэшПодчиненныеЭлементы.РодительСсылка,
				   |	ERPКэшПодчиненныеЭлементы.Порядок,
	               |	ERPКэшПодчиненныеЭлементы.КодВидаЭлемента,
	               |	ERPКэшПодчиненныеЭлементы.ПредставлениеЭлемента";
				   
	ЗапросИтератора.Текст = ТекстЗапроса;
	РезультатИтератора = ЗапросИтератора.Выполнить().Выгрузить();
	
	Возврат РезультатИтератора;
КонецФункции

// Табличный итератор применяемости
// Параметры:
// 		ИсхТаблица - таблица значений
//		ПравилоУправления - СправочникСсылка.aps_ПравилаУправления
//		ВидСвязи - СправочникСсылка.aps_ШаблоныТехнологическихСвязей
// Возвращаемое значение:
//		ТаблицаЗначений
// Пример:
//		ПрименяемостьПунктовМаршрута = локПрименяемостьПодчиненныхЭлементов(ТаблицаПунктовМаршрута, Справочники.aps_ШаблоныТехнологическихСвязей.ПунктыМаршрута);
//
Функция локПрименяемостьПодчиненныхЭлементов( ИсхТаблица, ПравилоУправления = Неопределено, ВидСвязи = Неопределено ) Экспорт 
	Если ТипЗнч(ПравилоУправления) = Тип("Строка") Тогда	// передается строка XML
		ПравилоУправления = Строка2Object1С(ПравилоУправления);
	КонецЕсли;
	
	Таблица=ИсхТаблица.Скопировать();
	Таблица.Свернуть("ЭлементСсылка");
	
	МенеджерВТ=Новый МенеджерВременныхТаблиц;
	
	ЗапросИтератора=Новый Запрос();
	ЗапросИтератора.МенеджерВременныхТаблиц=МенеджерВТ;
	// Текст запроса для построения временной таблицы
	ЗапросИтератора.Текст="ВЫБРАТЬ
	                      |	ТаблицаСсылок.ЭлементСсылка КАК Ссылка
	                      |ПОМЕСТИТЬ ВТСсылки
	                      |ИЗ
	                      |	&Данные КАК ТаблицаСсылок";
	ЗапросИтератора.УстановитьПараметр("Данные",Таблица);
	ЗапросИтератора.Выполнить();
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	Применяемость.РодительСсылка КАК РодительСсылка,
				   |	Применяемость.РодительСсылка.ВидЭлемента КАК ВидРодителя,
	               |	ВЫБОР
	               |		КОГДА Применяемость.РодительСсылка.ИндексКартинки = 0
	               |			ТОГДА Применяемость.РодительСсылка.ВидЭлемента.ИндексКартинки
	               |		ИНАЧЕ Применяемость.РодительСсылка.ИндексКартинки
	               |	КОНЕЦ КАК Картинка,
	               |	Применяемость.РодительСсылка.Наименование КАК ПредставлениеЭлемента,
	               |	Применяемость.ЭлементСсылка КАК ЭлементСсылка,
				   |	Применяемость.ЭлементСсылка.ВидЭлемента КАК ВидЭлемента,
	               |	Применяемость.ВидСвязи КАК ВидСвязи,
	               |	Применяемость.ПредставлениеСвязи КАК ПредставлениеСвязи,
	               |	Применяемость.ОбратнаяСвязь КАК ОбратнаяСвязь
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ПодчиненныеЭлементыТехнологии.Ссылка КАК ЭлементСсылка,
	               |		ПодчиненныеЭлементыТехнологии.ЭлементСсылка КАК РодительСсылка,
	               |		ПодчиненныеЭлементыТехнологии.ВидСвязи КАК ВидСвязи,
	               |		ПодчиненныеЭлементыТехнологии.ВидСвязи.Наименование КАК ПредставлениеСвязи,
	               |		ЛОЖЬ КАК ОбратнаяСвязь
	               |	ИЗ
	               |		Справочник.aps_ЭлементыТехнологии.ПодчиненныеЭлементыТехнологии КАК ПодчиненныеЭлементыТехнологии
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТСсылки КАК ВТСсылки
	               |			ПО (ВТСсылки.Ссылка = ПодчиненныеЭлементыТехнологии.ЭлементСсылка)
	               |				И (НЕ ПодчиненныеЭлементыТехнологии.Ссылка.ПометкаУдаления)) КАК Применяемость";
	Если ПравилоУправления <> Неопределено И ПравилоУправления.ВидыЭлементовФильтр.Количество() > 0 Тогда 
		ТекстЗапроса = ТекстЗапроса + "
	               |ГДЕ Применяемость.ЭлементСсылка.ВидЭлемента В(&ВидыЭлементов)";
		ЗапросИтератора.УстановитьПараметр("ВидыЭлементов", ПравилоУправления.ВидыЭлементовФильтр.ВыгрузитьКолонку(0));
	КонецЕсли;
	Если ВидСвязи <> Неопределено Тогда 
		ТекстЗапроса = ТекстЗапроса + "
	               |ГДЕ Применяемость.ВидСвязи В(&ВидСвязи)";
		ЗапросИтератора.УстановитьПараметр("ВидСвязи", ВидСвязи);
	КонецЕсли;
	ТекстЗапроса = ТекстЗапроса + "
	               |УПОРЯДОЧИТЬ ПО
	               |	Применяемость.ЭлементСсылка.ВидЭлемента.Код,
	               |	Применяемость.ЭлементСсылка.Наименование";
								   
	ЗапросИтератора.Текст = ТекстЗапроса;			   
	РезультатИтератора = ЗапросИтератора.Выполнить().Выгрузить();
	
	Возврат РезультатИтератора;
КонецФункции

// Получает элементные связи вместе с ревизиями
// Параметры:
//		ИсхТаблица - таблица значений
//		ВключаяПараметры - булево (необязательный)
//		ОбратныеСвязи - булево (необязательный)
//		ВидСвязи1 - СправочникСсылка.aps_ШаблоныТехнологическихСвязей (необязательный)
//		ВидСвязи2 - СправочникСсылка.aps_ШаблоныТехнологическихСвязей (необязательный)
//		ВидСвязи3 - СправочникСсылка.aps_ШаблоныТехнологическихСвязей (необязательный)
// Возвращаемое значение:
//		ТаблицаЗначений
// Пример:
//      ТехпроцессыНаПунктахМаршрута = локЭлементныеСвязиПоФильтруСРевизиями(ТаблицаПунктовМаршрутаСвернутая,,, Справочники.aps_ШаблоныТехнологическихСвязей.СсылочныеТехпроцессы);
//
Функция локЭлементныеСвязиПоФильтруСРевизиями( ИсхТаблица, ВключаяПараметры=Истина, ОбратныеСвязи=Ложь, ВидСвязи1=Неопределено, ВидСвязи2=Неопределено, ВидСвязи3=Неопределено) Экспорт
	Если ИсхТаблица.Количество() = 0 Тогда
		Возврат ИсхТаблица;
	КонецЕсли;
	
	Таблица=ИсхТаблица.Скопировать();
	Таблица.Свернуть("ЭлементСсылка, Изделие");
	
	ЗапросИтератора=Новый Запрос();
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ТаблицаСсылок.ЭлементСсылка КАК Ссылка,
	               |	ТаблицаСсылок.Изделие КАК Изделие
	               |ПОМЕСТИТЬ ВТСсылки
	               |ИЗ
	               |	&Данные КАК ТаблицаСсылок;
				   |//////////
				   |ВЫБРАТЬ
	               |	ЭлементныеСвязи.ЭлементСвязи,
	               |	ЭлементныеСвязи.ЭлементСсылка,
	               |	ЭлементныеСвязи.РодительСсылка,
				   |	ЭлементныеСвязи.ВидРодителя,
	               |	ВЫБОР
	               |		КОГДА ЭлементныеСвязи.ОригиналРевизии = НЕОПРЕДЕЛЕНО
	               |			ТОГДА ЭлементныеСвязи.ЭлементСсылка
	               |		ИНАЧЕ ЭлементныеСвязи.ОригиналРевизии
	               |	КОНЕЦ КАК ОригиналРевизии,
	               |	ЛОЖЬ КАК РевизияПодобрана,
	               |	ЭлементныеСвязи.ВидЭлемента,
	               |	ЭлементныеСвязи.КодВидаЭлемента,
	               |	ЭлементныеСвязи.Картинка,
	               |	ЭлементныеСвязи.ПредставлениеЭлемента,
	               |	ЭлементныеСвязи.Владелец,
	               |	ЭлементныеСвязи.Группа,
	               |	ЭлементныеСвязи.HTMLКонтент,
	               |	ЭлементныеСвязи.ВидСвязи,
	               |	ЭлементныеСвязи.ОбратнаяСвязь,
	               |	ЭлементныеСвязи.КартинкаСвязи,
	               |	ЭлементныеСвязи.ПредставлениеСвязи,
	               |	ЭлементныеСвязи.КодВидаСвязи,				   
	               |	ЭлементныеСвязи.ПорядокВывода,
				   |	ЭлементныеСвязи.Изделие";
	Если ВключаяПараметры Тогда 
		Если ОбратныеСвязи = Истина Тогда
			ТекстЗапроса = ТекстЗапроса + ",
				   |	ЭлементныеСвязи.ЭлементСвязи.Параметры.(Параметр, Параметр.Наименование КАК ИмяПараметра, Параметр.Свойство КАК Свойство, Параметр.Значение КАК Значение, Параметр.ЕдиницаИзмерения КАК ЕдиницаИзмерения, Параметр.Родитель КАК ГруппаПараметров, Параметр.Родитель.Наименование КАК ИмяГруппыПараметров) КАК ПараметрыЭлементаСвязи,
				   |	ВЫРАЗИТЬ(ЭлементныеСвязи.РодительСсылка КАК Справочник.aps_ЭлементыИзделия).Параметры.(Параметр, Параметр.Наименование КАК ИмяПараметра, Параметр.Свойство КАК Свойство, Параметр.Значение КАК Значение, Параметр.ЕдиницаИзмерения КАК ЕдиницаИзмерения, Параметр.Родитель КАК ГруппаПараметров, Параметр.Родитель.Наименование КАК ИмяГруппыПараметров) КАК ПараметрыЭлементаИзделия,
				   |	ВЫРАЗИТЬ(ЭлементныеСвязи.РодительСсылка КАК Справочник.aps_ЭлементыСправочников).Параметры.(Параметр, Параметр.Наименование КАК ИмяПараметра, Параметр.Свойство КАК Свойство, Параметр.Значение КАК Значение, Параметр.ЕдиницаИзмерения КАК ЕдиницаИзмерения, Параметр.Родитель КАК ГруппаПараметров, Параметр.Родитель.Наименование КАК ИмяГруппыПараметров) КАК ПараметрыЭлементаСправочника,
				   |	ВЫРАЗИТЬ(ЭлементныеСвязи.РодительСсылка КАК Справочник.aps_ЭлементыТехнологии).Параметры.(Параметр, Параметр.Наименование КАК ИмяПараметра, Параметр.Свойство КАК Свойство, Параметр.Значение КАК Значение, Параметр.ЕдиницаИзмерения КАК ЕдиницаИзмерения, Параметр.Родитель КАК ГруппаПараметров, Параметр.Родитель.Наименование КАК ИмяГруппыПараметров) КАК ПараметрыЭлементаТехнологии";
		Иначе
			ТекстЗапроса = ТекстЗапроса + ",
				   |	ЭлементныеСвязи.ЭлементСвязи.Параметры.(Параметр, Параметр.Наименование КАК ИмяПараметра, Параметр.Свойство КАК Свойство, Параметр.Значение КАК Значение, Параметр.ЕдиницаИзмерения КАК ЕдиницаИзмерения, Параметр.Родитель КАК ГруппаПараметров, Параметр.Родитель.Наименование КАК ИмяГруппыПараметров) КАК ПараметрыЭлементаСвязи,
				   |	ВЫРАЗИТЬ(ЭлементныеСвязи.ЭлементСсылка КАК Справочник.aps_ЭлементыИзделия).Параметры.(Параметр, Параметр.Наименование КАК ИмяПараметра, Параметр.Свойство КАК Свойство, Параметр.Значение КАК Значение, Параметр.ЕдиницаИзмерения КАК ЕдиницаИзмерения, Параметр.Родитель КАК ГруппаПараметров, Параметр.Родитель.Наименование КАК ИмяГруппыПараметров) КАК ПараметрыЭлементаИзделия,
				   |	ВЫРАЗИТЬ(ЭлементныеСвязи.ЭлементСсылка КАК Справочник.aps_ЭлементыСправочников).Параметры.(Параметр, Параметр.Наименование КАК ИмяПараметра, Параметр.Свойство КАК Свойство, Параметр.Значение КАК Значение, Параметр.ЕдиницаИзмерения КАК ЕдиницаИзмерения, Параметр.Родитель КАК ГруппаПараметров, Параметр.Родитель.Наименование КАК ИмяГруппыПараметров) КАК ПараметрыЭлементаСправочника,
				   |	ВЫРАЗИТЬ(ЭлементныеСвязи.ЭлементСсылка КАК Справочник.aps_ЭлементыТехнологии).Параметры.(Параметр, Параметр.Наименование КАК ИмяПараметра, Параметр.Свойство КАК Свойство, Параметр.Значение КАК Значение, Параметр.ЕдиницаИзмерения КАК ЕдиницаИзмерения, Параметр.Родитель КАК ГруппаПараметров, Параметр.Родитель.Наименование КАК ИмяГруппыПараметров) КАК ПараметрыЭлементаТехнологии";
		КонецЕсли;		   
	КонецЕсли;
	ТекстЗапроса = ТекстЗапроса + "
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ЭлементыСвязей.ЭлементСвязи КАК ЭлементСвязи,
	               |		ЭлементыСвязей.ЭлементСсылка КАК ЭлементСсылка,
	               |		ЭлементыСвязей.РодительСсылка КАК РодительСсылка,
				   |		ЭлементыСвязей.РодительСсылка.ВидЭлемента КАК ВидРодителя,
	               |		ЭлементыСвязей.ЭлементСсылка.ОригиналРевизии КАК ОригиналРевизии,
	               |		ЭлементыСвязей.ЭлементСсылка.ВидЭлемента КАК ВидЭлемента,
	               |		ВЫБОР
	               |			КОГДА ЭлементыСвязей.ЭлементСсылка.ИндексКартинки = 0
	               |				ТОГДА ЭлементыСвязей.ЭлементСсылка.ВидЭлемента.ИндексКартинки
	               |			ИНАЧЕ ЭлементыСвязей.ЭлементСсылка.ИндексКартинки
	               |		КОНЕЦ КАК Картинка,
	               |		ЭлементыСвязей.ЭлементСсылка.Наименование КАК ПредставлениеЭлемента,
	               |		ЭлементыСвязей.ЭлементСсылка.UID КАК Владелец,
	               |		ЭлементыСвязей.ЭлементСсылка.GID КАК Группа,
	               |		ЭлементыСвязей.ЭлементСсылка.HTMLКонтент КАК HTMLКонтент,
	               |		ЭлементыСвязей.ЭлементСсылка.ВидЭлемента.Код КАК КодВидаЭлемента,
	               |		ЭлементыСвязей.ЭлементСвязи.ПорядокВывода КАК ПорядокВывода,
	               |		ВЫБОР
	               |			КОГДА ЭлементыСвязей.ВидСвязи.Автоупорядочивание
	               |				ТОГДА 0
	               |			ИНАЧЕ ЭлементыСвязей.ЭлементСвязи.ПорядокВывода
	               |		КОНЕЦ КАК Порядок,
	               |		ВЫБОР
	               |			КОГДА ЭлементыСвязей.ВидСвязи ССЫЛКА Перечисление.aps_ВидыСвязей
	               |				ТОГДА 0
	               |			ИНАЧЕ 1
	               |		КОНЕЦ КАК ПорядокСвязи,
	               |		ЭлементыСвязей.ВидСвязи КАК ВидСвязи,
	               |		ЭлементыСвязей.ВидСвязи.Код КАК КодВидаСвязи,
	               |		ЭлементыСвязей.ОбратнаяСвязь КАК ОбратнаяСвязь,
	               |		ВЫБОР
	               |			КОГДА ЭлементыСвязей.ОбратнаяСвязь
	               |				ТОГДА ЭлементыСвязей.ВидСвязи.ИндексКартинкиОбратнойСвязи
	               |			ИНАЧЕ ЭлементыСвязей.ВидСвязи.ИндексКартинки
	               |		КОНЕЦ КАК КартинкаСвязи,
	               |		ВЫБОР
	               |			КОГДА ЭлементыСвязей.ОбратнаяСвязь
	               |				ТОГДА ЭлементыСвязей.ВидСвязи.НаименованиеОбратнойСвязи
	               |			ИНАЧЕ ЭлементыСвязей.ВидСвязи.Наименование
	               |		КОНЕЦ КАК ПредставлениеСвязи,
				   |		ЭлементыСвязей.Изделие КАК Изделие
	               |	ИЗ";
	Если ОбратныеСвязи = Истина Тогда
	    ТекстЗапроса = ТекстЗапроса + "
				   |		(ВЫБРАТЬ
				   |			aps_ЭлементыСвязей.Ссылка КАК ЭлементСвязи,
				   |			aps_ЭлементыСвязей.РодительСсылка КАК ЭлементСсылка,
				   |			aps_ЭлементыСвязей.ПотомокСсылка КАК РодительСсылка,
				   |			aps_ЭлементыСвязей.ВидСвязи КАК ВидСвязи,
				   |			ИСТИНА КАК ОбратнаяСвязь,
				   |			ВТСсылки.Изделие КАК Изделие
				   |		ИЗ
				   |			ВТСсылки
				   |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.aps_ЭлементыСвязей КАК aps_ЭлементыСвязей ПО
				   |			ВТСсылки.Ссылка = aps_ЭлементыСвязей.ПотомокСсылка
				   |			И (НЕ aps_ЭлементыСвязей.ПометкаУдаления)
				   |			И НЕ aps_ЭлементыСвязей.РодительСсылка ССЫЛКА Справочник.aps_ЭлементыСвязей) КАК ЭлементыСвязей) КАК ЭлементныеСвязи"
	Иначе			   
		ТекстЗапроса = ТекстЗапроса + "
				   |		(ВЫБРАТЬ
				   |			aps_ЭлементыСвязей.Ссылка КАК ЭлементСвязи,
				   |			aps_ЭлементыСвязей.ПотомокСсылка КАК ЭлементСсылка,
				   |			aps_ЭлементыСвязей.РодительСсылка КАК РодительСсылка,
				   |			aps_ЭлементыСвязей.ВидСвязи КАК ВидСвязи,
				   |			ЛОЖЬ КАК ОбратнаяСвязь,
				   |			ВТСсылки.Изделие КАК Изделие
				   |		ИЗ
				   |			ВТСсылки
				   |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.aps_ЭлементыСвязей КАК aps_ЭлементыСвязей ПО
				   |			ВТСсылки.Ссылка = aps_ЭлементыСвязей.РодительСсылка
				   |			И (НЕ aps_ЭлементыСвязей.ПометкаУдаления)) КАК ЭлементыСвязей) КАК ЭлементныеСвязи";	
	КонецЕсли;
			   
	ТекстЗапроса = ТекстЗапроса + "
	               |ГДЕ (ЭлементныеСвязи.ВидСвязи = &ВидСвязи1
				   |	ИЛИ ЭлементныеСвязи.ВидСвязи = &ВидСвязи2
				   |	ИЛИ ЭлементныеСвязи.ВидСвязи = &ВидСвязи3)";
	ЗапросИтератора.УстановитьПараметр("ВидСвязи1", ВидСвязи1);
	ЗапросИтератора.УстановитьПараметр("ВидСвязи2", ВидСвязи2);
	ЗапросИтератора.УстановитьПараметр("ВидСвязи3", ВидСвязи3);
	ТекстЗапроса = ТекстЗапроса + "
	               |УПОРЯДОЧИТЬ ПО
	               |	ЭлементныеСвязи.РодительСсылка,
	               |	ЭлементныеСвязи.ПорядокСвязи,
	               |	ЭлементныеСвязи.КодВидаСвязи,
	               |	ЭлементныеСвязи.ВидСвязи,
	               |	ЭлементныеСвязи.ОбратнаяСвязь,
	               |	ЭлементныеСвязи.Порядок,
	               |	ЭлементныеСвязи.КодВидаЭлемента,
	               |	ЭлементныеСвязи.ПредставлениеЭлемента";
				   
	ЗапросИтератора.Текст = ТекстЗапроса;
	ЗапросИтератора.УстановитьПараметр("Данные",Таблица);
	РезультатИтератора = ЗапросИтератора.Выполнить().Выгрузить();
	
	ПравилоУправления = Справочники.aps_ПравилаУправления.СоздатьЭлемент();
	Условие = ПравилоУправления.Условия.Добавить();
	Условие.Свойство					=ПланыВидовХарактеристик.aps_Свойства.СпособСозданияРевизии;
	Условие.Значение					=Справочники.aps_СпособыСозданияРевизий.Представление;
	Условие.ВидСравнения				=Перечисления.aps_ВидыСравнения.Равно;
	Условие.ОбязательноНаличиеПараметра	=Истина;
	
	МассивСтрокДляПоискаРевизий = Новый Массив();
	МассивЭлементов = Новый Массив();
	Для Каждого СтрокаРезультата Из РезультатИтератора Цикл
		Если СтрокаРезультата.Изделие <> Неопределено Тогда
			МассивСтрокДляПоискаРевизий.Добавить(СтрокаРезультата); //ссылка на строку
			МассивЭлементов.Добавить(СтрокаРезультата.ОригиналРевизии);
		КонецЕсли;
	КонецЦикла;	
	
	ПодобранныеРевизииЭлементов = aps_Итераторы.aps_ПодборРевизийЭлементов(МассивЭлементов, ПравилоУправления);
	
	i = 0;
	Пока i < МассивСтрокДляПоискаРевизий.Количество() Цикл 
		СтрокаРезультата = МассивСтрокДляПоискаРевизий[i];
		
		СтрокиРевизий = ПодобранныеРевизииЭлементов.НайтиСтроки(Новый Структура("ОригиналРевизии", СтрокаРезультата.ОригиналРевизии));
		Для Каждого СтрокаПодобраннойРевизии Из СтрокиРевизий Цикл
			ПараметрИзделие = СтрокаПодобраннойРевизии.ПараметрыЭлементаТехнологии.Найти(ПланыВидовХарактеристик.aps_Свойства.Изделие, "Свойство");
			Если ПараметрИзделие <> Неопределено 
					И ПараметрИзделие.Значение = СтрокаРезультата.Изделие Тогда
				ЗаполнитьЗначенияСвойств(СтрокаРезультата, СтрокаПодобраннойРевизии);
				СтрокаРезультата.РевизияПодобрана=Истина;	
			КонецЕсли;
		КонецЦикла;
		
		i = i + 1;
	КонецЦикла;
		
	Возврат РезультатИтератора;
КонецФункции

// Фоновое задание формирования состава изделия
// Параметры:
//		ТаблицаЭлементов - таблица значений
// Пример:
//		aps_ТехнологическаяСхемаКэш.КэшированиеТолькоСоставРек_ФЗ( НаборЗаписейКЗапуску.Выгрузить() );
//
Процедура КэшированиеТолькоСоставРек_ФЗ( ТаблицаЭлементов ) Экспорт
	Если ТаблицаЭлементов.Количество() = 0 Тогда 
		Возврат;
	КонецЕсли;
	ЭтоФайловаяБаза = ( Найти(Врег(СтрокаСоединенияИнформационнойБазы()), "FILE=") = 1 );
	МассивВыходныхИзделий = Новый Массив();

	ИгнорируемыеВидыСостава = Новый Массив;
	ИгнорируемыеВидыСостава.Добавить(Справочники.aps_ВидыЭлементов.Документ);
	ИгнорируемыеВидыСостава.Добавить(Справочники.aps_ВидыЭлементов.АктивныйДокументЧертежSolidWorks);
	ИгнорируемыеВидыСостава.Добавить(Справочники.aps_ВидыЭлементов.АктивныйДокументДетальSolidWorks);
	ИгнорируемыеВидыСостава.Добавить(Справочники.aps_ВидыЭлементов.АктивныйДокументСборкаSolidWorks);
	ИгнорируемыеВидыСостава.Добавить(Справочники.aps_ВидыЭлементов.АктивныйДокументЧертежКОМПАС);
	ИгнорируемыеВидыСостава.Добавить(Справочники.aps_ВидыЭлементов.АктивныйДокументДетальКОМПАС);
	ИгнорируемыеВидыСостава.Добавить(Справочники.aps_ВидыЭлементов.АктивныйДокументСборкаКОМПАС);
	ИгнорируемыеВидыСостава.Добавить(Справочники.aps_ВидыЭлементов.АктивныйДокументЧертежAutoCAD);
	ИгнорируемыеВидыСостава.Добавить(Справочники.aps_ВидыЭлементов.АктивныйДокументДетальAutoCAD);
	ИгнорируемыеВидыСостава.Добавить(Справочники.aps_ВидыЭлементов.АктивныйДокументСборкаAutoCAD);
	ИгнорируемыеВидыСостава.Добавить(Справочники.aps_ВидыЭлементов.АктивныйДокументЧертежInventor);
	ИгнорируемыеВидыСостава.Добавить(Справочники.aps_ВидыЭлементов.АктивныйДокументДетальInventor);
	ИгнорируемыеВидыСостава.Добавить(Справочники.aps_ВидыЭлементов.АктивныйДокументСборкаInventor);
	ИгнорируемыеВидыСостава.Добавить(Справочники.aps_ВидыЭлементов.АктивныйДокументЧертежSolidEdge);
	ИгнорируемыеВидыСостава.Добавить(Справочники.aps_ВидыЭлементов.АктивныйДокументДетальSolidEdge);
	ИгнорируемыеВидыСостава.Добавить(Справочники.aps_ВидыЭлементов.АктивныйДокументСборкаSolidEdge);
	
	РезультатИтератора = aps_ТехнологическаяСхемаКэш.локЭлементныеСвязиПоФильтру( ТаблицаЭлементов, Неопределено, Истина, Ложь, Перечисления.aps_ВидыСвязей.СоставИзделия);
		
	КоличествоСтрок = РезультатИтератора.Количество();
	Если КоличествоСтрок = 0 Тогда 
		Возврат;
	КонецЕсли;
	
	ЭлементСсылка = Неопределено;
	НаборЗаписей = Неопределено;
	Для i=0 По КоличествоСтрок - 1 Цикл
		СтрокаРезультата = РезультатИтератора[i];
		Если ИгнорируемыеВидыСостава.Найти(СтрокаРезультата.ВидЭлемента) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаРезультата.РодительСсылка <> ЭлементСсылка Тогда
			Если НаборЗаписей <> Неопределено Тогда
				НаборЗаписей.Записать();
			КонецЕсли;
			ЭлементСсылка = СтрокаРезультата.РодительСсылка;
			// удалить существующие записи
			НаборЗаписей = РегистрыСведений.aps_КэшированныеДанные.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.ЭлементСсылка.Установить(ЭлементСсылка);
			НаборЗаписей.Прочитать();
			НаборЗаписей.Очистить();
			
			НаборЗаписейВИ = РегистрыСведений.aps_КэшированныеДанные.СоздатьНаборЗаписей();
			НаборЗаписейВИ.Отбор.ВидНабора.Установить(Перечисления.ERPКорпВидыНаборов.ВыходноеИзделие);
			НаборЗаписейВИ.Отбор.ЭлементСсылка.Установить(ЭлементСсылка);
			НаборЗаписейВИ.Прочитать();
			Если НаборЗаписейВИ.Количество() = 0 Тогда
				МассивВыходныхИзделий.Добавить(ЭлементСсылка);
			КонецЕсли;
		КонецЕсли;
		
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.ЭлементСсылка = ЭлементСсылка;
		НоваяЗапись.НомерЗаписи = i + 1;
		
		ВидРодителя=СтрокаРезультата.РодительСсылка.ВидЭлемента;
		ВидПотомка=СтрокаРезультата.ЭлементСсылка.ВидЭлемента;
		Если ВидПотомка=Справочники.aps_ВидыЭлементов.ПакетЗамены Или
		     ВидПотомка=Справочники.aps_ВидыЭлементов.ВариантЗамены Или
			 ВидРодителя=Справочники.aps_ВидыЭлементов.ВариантЗамены Тогда
			 НоваяЗапись.ВидНабора = Перечисления.ERPКорпВидыНаборов.Замены;
		Иначе
			 НоваяЗапись.ВидНабора = Перечисления.ERPКорпВидыНаборов.Состав;
		КонецЕсли;
		НоваяЗапись.ЭлементСсылка3 = СтрокаРезультата.ЭлементСсылка;
		НоваяЗапись.ВидСвязи = СтрокаРезультата.ВидСвязи;
		
		СтрокаПараметра = СтрокаРезультата.ПараметрыЭлементаСвязи.Найти(ПланыВидовХарактеристик.aps_Свойства.Количество, "Свойство");
		Если СтрокаПараметра <> Неопределено Тогда
			НоваяЗапись.Количество = СтрокаПараметра.Значение;
		Иначе
			СтрокаПараметра = СтрокаРезультата.ПараметрыЭлементаСвязи.Найти(ПланыВидовХарактеристик.aps_Свойства.НормаРасхода, "Свойство");
			Если СтрокаПараметра <> Неопределено Тогда
				НоваяЗапись.Количество = СтрокаПараметра.Значение;
			КонецЕсли;
		КонецЕсли;
		
		СтрокаПараметра = СтрокаРезультата.ПараметрыЭлементаСвязи.Найти(ПланыВидовХарактеристик.aps_Свойства.ЕдиницыИзмерения, "Свойство");
		Если СтрокаПараметра <> Неопределено Тогда
			НоваяЗапись.ЕдиницаИзмерения = СтрокаПараметра.Значение;
		КонецЕсли;
		
		СтрокаПараметра = СтрокаРезультата.ПараметрыЭлементаИзделия.Найти(ПланыВидовХарактеристик.aps_Свойства.Номенклатура, "Свойство");
		Если СтрокаПараметра <> Неопределено Тогда
			НоваяЗапись.Номенклатура = СтрокаПараметра.Значение;
		Иначе
			СтрокаПараметра = СтрокаРезультата.ПараметрыЭлементаСправочника.Найти(ПланыВидовХарактеристик.aps_Свойства.Номенклатура, "Свойство");
			Если СтрокаПараметра <> Неопределено Тогда
				НоваяЗапись.Номенклатура = СтрокаПараметра.Значение;
			КонецЕсли;
		КонецЕсли;
		СтрокаПараметра = СтрокаРезультата.ПараметрыЭлементаИзделия.Найти(ПланыВидовХарактеристик.aps_Свойства.ХарактеристикаНоменклатуры, "Свойство");
		Если СтрокаПараметра <> Неопределено Тогда
			НоваяЗапись.Характеристика = СтрокаПараметра.Значение;
		Иначе
			СтрокаПараметра = СтрокаРезультата.ПараметрыЭлементаСправочника.Найти(ПланыВидовХарактеристик.aps_Свойства.ХарактеристикаНоменклатуры, "Свойство");
			Если СтрокаПараметра <> Неопределено Тогда
				НоваяЗапись.Характеристика = СтрокаПараметра.Значение;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	Если НаборЗаписей <> Неопределено Тогда
		НаборЗаписей.Записать();
	КонецЕсли;
	
	ПараметрыВыходныхИзделий = aps_ТехнологическаяСхемаСервисы.ПолучитьПараметрыЭлементов(МассивВыходныхИзделий);
	Для Каждого ЭлементСсылка Из МассивВыходныхИзделий Цикл 
		МенеджерЗаписи = РегистрыСведений.aps_КэшированныеДанные.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ЭлементСсылка = ЭлементСсылка;
		МенеджерЗаписи.НомерЗаписи = 1;
		МенеджерЗаписи.ВидНабора = Перечисления.ERPКорпВидыНаборов.ВыходноеИзделие;
		МенеджерЗаписи.ПотомокСсылка = ЭлементСсылка;
		МенеджерЗаписи.Количество = 1;
		МенеджерЗаписи.ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("796");
		СтрокаТаблицыПараметров = ПараметрыВыходныхИзделий.Найти(ЭлементСсылка, "Ссылка");
		Если СтрокаТаблицыПараметров <> Неопределено Тогда
			СтрокаПараметра = СтрокаТаблицыПараметров.ПараметрыЭлементаИзделия.Найти(ПланыВидовХарактеристик.aps_Свойства.Номенклатура, "Свойство");
			Если СтрокаПараметра <> Неопределено Тогда
				МенеджерЗаписи.Номенклатура = СтрокаПараметра.Значение;
			Иначе
				СтрокаПараметра = СтрокаТаблицыПараметров.ПараметрыЭлементаСправочника.Найти(ПланыВидовХарактеристик.aps_Свойства.Номенклатура, "Свойство");
				Если СтрокаПараметра <> Неопределено Тогда
					МенеджерЗаписи.Номенклатура = СтрокаПараметра.Значение;
				КонецЕсли;
			КонецЕсли;
			СтрокаПараметра = СтрокаТаблицыПараметров.ПараметрыЭлементаИзделия.Найти(ПланыВидовХарактеристик.aps_Свойства.ХарактеристикаНоменклатуры, "Свойство");
			Если СтрокаПараметра <> Неопределено Тогда
				МенеджерЗаписи.Характеристика = СтрокаПараметра.Значение;
			Иначе
				СтрокаПараметра = СтрокаТаблицыПараметров.ПараметрыЭлементаСправочника.Найти(ПланыВидовХарактеристик.aps_Свойства.ХарактеристикаНоменклатуры, "Свойство");
				Если СтрокаПараметра <> Неопределено Тогда
					МенеджерЗаписи.Характеристика = СтрокаПараметра.Значение;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		МенеджерЗаписи.Записать();
	КонецЦикла;
	
	РезультатИтератора.Свернуть("ЭлементСсылка");
	
	Если РезультатИтератора.Количество()>0 Тогда
		Если ЭтоФайловаяБаза Тогда 
			КэшированиеТолькоСоставРек_ФЗ( РезультатИтератора );
		Иначе
			МассивПараметров = Новый Массив();
			МассивПараметров.Добавить(РезультатИтератора);
			ФоновоеЗадание = ФоновыеЗадания.Выполнить("aps_ТехнологическаяСхемаКэш.КэшированиеТолькоСоставРек_ФЗ", МассивПараметров);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Процедура фоновой обработки списка изделий
//
// Параметры:
//		ТаблицаВходящая – таблица значений
// Пример:
//		КэшированиеВсегоПоток_ФЗ( ИсхТаблица );
//
Процедура КэшированиеВсегоПоток_ФЗ( ТаблицаВходящая ) Экспорт
	ТаблицаРезультата=локКэшироватьТехнологию( ТаблицаВходящая );
	Если ТаблицаРезультата<>Неопределено И ТаблицаРезультата.Количество()>0 Тогда
		ТаблицаРезультата.ЗаполнитьЗначения( Перечисления.СтатусФормированияERP.Ожидает, "Статус" );
		
		ИдентификаторЗадания=Строка(Новый УникальныйИдентификатор()); 
		ТаблицаРезультата.Колонки.Добавить("КлючЗадания", Новый ОписаниеТипов("Строка") );
		ТаблицаРезультата.ЗаполнитьЗначения( ИдентификаторЗадания, "КлючЗадания" );
	
		НаборЗаписей=РегистрыСведений.aps_ДанныеВыполненияФоновыхЗаданий.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Статус.Установить(Перечисления.СтатусФормированияERP.Ожидает);
		НаборЗаписей.Отбор.КлючЗадания.Установить( ИдентификаторЗадания );
		НаборЗаписей.Загрузить( ТаблицаРезультата );
		НаборЗаписей.Записать(Ложь);
	КонецЕсли;
КонецПроцедуры

// Главное фоновое задание по кэшированию
//
// Параметры:
//		УправляющийGUID - идентификатор фонового задания
// Пример:
//		aps_ТехнологическаяСхемаКэш.КэшированиеВсего_ФЗ( КлючЗадания );
//
Процедура КэшированиеВсего_ФЗ(УправляющийGUID) Экспорт
	
	ЧислоПотоков=Константы.aps_ТехСхемаЧислоПотоковОбработки.Получить();
	Если ЧислоПотоков<=0 Тогда
		ЧислоПотоков=1;
	КонецЕсли;
	
	ЭтоФайловаяБаза = ( Найти(Врег(СтрокаСоединенияИнформационнойБазы()), "FILE=") = 1 );
	
	
	локТаблицаЗаписейКЗапуску=Новый ТаблицаЗначений;
	массивЛокальныхЗаданий=Новый Массив();
	
	Пока Истина Цикл
		// Читаем в таблицу элементы ожидающие обработки
		НаборЗаписейКЗапуску = РегистрыСведений.aps_ДанныеВыполненияФоновыхЗаданий.СоздатьНаборЗаписей();
		НаборЗаписейКЗапуску.Отбор.Статус.Установить(Перечисления.СтатусФормированияERP.Ожидает);
		НаборЗаписейКЗапуску.Прочитать();
		
	Если НаборЗаписейКЗапуску.Количество()=0 Тогда
		Прервать;
	КонецЕсли;
		локТаблицаЗаписейКЗапуску = НаборЗаписейКЗапуску.Выгрузить();
		НаборЗаписейКЗапуску.Очистить();
		НаборЗаписейКЗапуску.Записать();
		// Формируем новый набор записей для фоновых заданий
		локТаблицаЗаписейКЗапуску.Свернуть("ЭлементСсылка, Статус","Уровень");

		// Количество элементов, обрабатываемых каждым потоком
		Количество=Цел(локТаблицаЗаписейКЗапуску.Количество()/ЧислоПотоков);
		// Остаток от количества
		Хвост=локТаблицаЗаписейКЗапуску.Количество()%ЧислоПотоков;
		
		Для j=0 По ЧислоПотоков-1 Цикл
			// Формирование строк для j-го потока
			МассивСтрок=Новый Массив();
			Для i=j*Количество По Количество*(j+1)-1 Цикл
				МассивСтрок.Добавить(локТаблицаЗаписейКЗапуску[i]);
			КонецЦикла;
			// Добавить к последнему потоку элементы не вошедшие в целое количество
			Если j=ЧислоПотоков-1 Тогда
					Для i=0 По Хвост-1 Цикл
						МассивСтрок.Добавить(локТаблицаЗаписейКЗапуску[локТаблицаЗаписейКЗапуску.Количество()-1 -i]);
					КонецЦикла;
			КонецЕсли;
			
			Если МассивСтрок.Количество()>0 Тогда
				ИсхТаблица=локТаблицаЗаписейКЗапуску.Скопировать(МассивСтрок);
				Если ЭтоФайловаяБаза Тогда 
					КэшированиеВсегоПоток_ФЗ( ИсхТаблица );
				Иначе
					МассивПараметров = Новый Массив();
					МассивПараметров.Добавить(ИсхТаблица);
					ФоновоеЗадание = ФоновыеЗадания.Выполнить("aps_ТехнологическаяСхемаКэш.КэшированиеВсегоПоток_ФЗ", МассивПараметров);
					МассивЛокальныхЗаданий.Добавить(ФоновоеЗадание);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла; // По потокам
		
		Если НЕ ЭтоФайловаяБаза Тогда
			ФоновыеЗадания.ОжидатьЗавершения(МассивЛокальныхЗаданий);
		КонецЕсли;
		Если локТаблицаЗаписейКЗапуску.Количество()>0 Тогда 
			локТаблицаЗаписейКЗапуску.ЗаполнитьЗначения(Перечисления.СтатусФормированияERP.Завершен, "Статус");
			локКол=локТаблицаЗаписейКЗапуску.Количество()-1;
			Для i=0 по локКол Цикл
				revi=локКол-i;
				
				МЗ=РегистрыСведений.aps_ДанныеВыполненияФоновыхЗаданий.СоздатьМенеджерЗаписи();
				МЗ.Статус=локТаблицаЗаписейКЗапуску[revi].Статус;
				МЗ.ЭлементСсылка=локТаблицаЗаписейКЗапуску[revi].ЭлементСсылка;
				МЗ.Прочитать();
				
				МЗ1=РегистрыСведений.aps_ДанныеВыполненияФоновыхЗаданий.СоздатьМенеджерЗаписи();
				МЗ1.Статус=Перечисления.СтатусФормированияERP.ОстановленПоОшибке;
				МЗ1.ЭлементСсылка=локТаблицаЗаписейКЗапуску[revi].ЭлементСсылка;
				МЗ1.Прочитать();
			
				Если мз.Выбран() ИЛИ мз1.Выбран() Тогда
					локТаблицаЗаписейКЗапуску.Удалить( revi );
				КонецЕсли;
			КонецЦикла;				
			НаборЗаписейКЗапуску = РегистрыСведений.aps_ДанныеВыполненияФоновыхЗаданий.СоздатьНаборЗаписей();
			НаборЗаписейКЗапуску.Отбор.Статус.Установить(Перечисления.СтатусФормированияERP.Завершен);
			НаборЗаписейКЗапуску.Загрузить(локТаблицаЗаписейКЗапуску);
			НаборЗаписейКЗапуску.Записать(Ложь);
		КонецЕсли;                       
	КонецЦикла; // По записям регистра
КонецПроцедуры

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

// Записать версии даных
Процедура ЗаписатьВерсииДанных( Куда, В1,В2,В3,В4,В5 )
	Куда.ИндексВерсии=В1+В2+В3+В4+В5;
КонецПроцедуры

Процедура ЗаполнитьПараметрыКомплектования(ЗаписьРегистра, СтрокаКомплектования)
	// элемент комплектования, материал - ЗаписьРегистра.ЭлементСсылка3
	// количество, единица измерения
	СтрокаПараметра = СтрокаКомплектования.ПараметрыЭлементаСвязи.Найти(ПланыВидовХарактеристик.aps_Свойства.Количество, "Свойство");
	Если СтрокаПараметра <> Неопределено Тогда
		ЗаписьРегистра.Количество = СтрокаПараметра.Значение;
		ЗаписьРегистра.ЕдиницаИзмерения = СтрокаПараметра.ЕдиницаИзмерения;
	Иначе
		СтрокаПараметра = СтрокаКомплектования.ПараметрыЭлементаСвязи.Найти(ПланыВидовХарактеристик.aps_Свойства.НормаРасхода, "Свойство");
		Если СтрокаПараметра <> Неопределено Тогда
			ЗаписьРегистра.Количество = СтрокаПараметра.Значение;
			ЗаписьРегистра.ЕдиницаИзмерения = СтрокаПараметра.ЕдиницаИзмерения;
		КонецЕсли;
	КонецЕсли;  
		
	// номенклатура
	Если ТипЗнч(ЗаписьРегистра.ЭлементСсылка3) = Тип("СправочникСсылка.aps_ЭлементыИзделия") Тогда
		СтрокаПараметра = СтрокаКомплектования.ПараметрыЭлементаИзделия.Найти(ПланыВидовХарактеристик.aps_Свойства.Номенклатура, "Свойство");
		ЗаписьРегистра.Номенклатура = ?(СтрокаПараметра <> Неопределено, СтрокаПараметра.Значение, Неопределено);
	ИначеЕсли ТипЗнч(ЗаписьРегистра.ЭлементСсылка3) = Тип("СправочникСсылка.aps_ЭлементыСправочников") Тогда
		СтрокаПараметра = СтрокаКомплектования.ПараметрыЭлементаСправочника.Найти(ПланыВидовХарактеристик.aps_Свойства.Номенклатура, "Свойство");
		ЗаписьРегистра.Номенклатура = ?(СтрокаПараметра <> Неопределено, СтрокаПараметра.Значение, Неопределено);
	КонецЕсли;
	// характеристика
	Если ТипЗнч(ЗаписьРегистра.ЭлементСсылка3) = Тип("СправочникСсылка.aps_ЭлементыИзделия") Тогда
		СтрокаПараметра = СтрокаКомплектования.ПараметрыЭлементаИзделия.Найти(ПланыВидовХарактеристик.aps_Свойства.ХарактеристикаНоменклатуры, "Свойство");
		ЗаписьРегистра.Характеристика = ?(СтрокаПараметра <> Неопределено, СтрокаПараметра.Значение, Неопределено);
	ИначеЕсли ТипЗнч(ЗаписьРегистра.ЭлементСсылка3) = Тип("СправочникСсылка.aps_ЭлементыСправочников") Тогда
		СтрокаПараметра = СтрокаКомплектования.ПараметрыЭлементаСправочника.Найти(ПланыВидовХарактеристик.aps_Свойства.ХарактеристикаНоменклатуры, "Свойство");
		ЗаписьРегистра.Характеристика = ?(СтрокаПараметра <> Неопределено, СтрокаПараметра.Значение, Неопределено);
	КонецЕсли;
	// состояние
	Если ТипЗнч(ЗаписьРегистра.ЭлементСсылка3) = Тип("СправочникСсылка.aps_ЭлементыИзделия") Тогда
		СтрокаПараметра = СтрокаКомплектования.ПараметрыЭлементаИзделия.Найти(ПланыВидовХарактеристик.aps_Свойства.Состояние, "Свойство");
		ЗаписьРегистра.Состояние = ?(СтрокаПараметра <> Неопределено, СтрокаПараметра.Значение, Неопределено);
	ИначеЕсли ТипЗнч(ЗаписьРегистра.ЭлементСсылка3) = Тип("СправочникСсылка.aps_ЭлементыСправочников") Тогда
		СтрокаПараметра = СтрокаКомплектования.ПараметрыЭлементаСправочника.Найти(ПланыВидовХарактеристик.aps_Свойства.Состояние, "Свойство");
		ЗаписьРегистра.Состояние = ?(СтрокаПараметра <> Неопределено, СтрокаПараметра.Значение, Неопределено);
	КонецЕсли;
	
	ЗаписьРегистра.ВидСвязи = СтрокаКомплектования.ВидСвязи;
КонецПроцедуры

#КонецОбласти

#КонецЕсли