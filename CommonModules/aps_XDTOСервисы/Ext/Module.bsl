// Функция сериализует XSD-схему в строку XML
// Параметры:
// 		XDTO - объект XDTO
// Возвращаемое значение:
//		Строка
// Пример:
//     XDS2Строка( xsd )
Функция XSD2Строка( XSD ) Экспорт 
	Если XSD = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку();
	ЗаписьDOM = Новый ЗаписьDOM;
	XSD.ОбновитьЭлементDOM();
	ЗаписьDOM.Записать(XSD.ДокументDOM, ЗаписьXML);
	Возврат ЗаписьXML.Закрыть();
КонецФункции

// Функция десериализует строку XML в XSD-схему
// Параметры:
// 		XDTO - объект XDTO
// Возвращаемое значение:
//		xsd
// Пример:
//      Строка2XSD( Строка )
Функция Строка2XSD( ИсхСтрока ) Экспорт 
	Если ПустаяСтрока( ИсхСтрока ) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ИсхСтрока);
	
	ПостроительDOM = Новый ПостроительDOM;
	ДокументDOM = ПостроительDOM.Прочитать(ЧтениеXML);
	ПостроительСхем = Новый ПостроительСхемXML;
	Возврат ПостроительСхем.СоздатьСхемуXML(ДокументDOM);
КонецФункции

// Функция создает объекты параметров по дереву значений и добавляет их в модель XDTO
// Параметры:
//		itemXDTO - объект модели XDTO
//		СтрокиДерева  - КоллекцияСтрокДереваЗначений
// Возвращаемое значение:
//		Нет
// Пример:
//		aps_ЗаполнитьПараметрыМоделиПоДереву( parameterXDTO, СтрокаДерева.Строки );
Функция aps_ЗаполнитьПараметрыМоделиПоДереву( itemXDTO, СтрокиДерева ) Экспорт 
	Для Каждого СтрокаДерева Из СтрокиДерева Цикл 
		parameterXDTO = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("http://appius.ru/pdm", "parameter"));
		
		parameterXDTO.reference		= СериализаторXDTO.ЗаписатьXDTO(СтрокаДерева.Ссылка);
		parameterXDTO.description	= СтрокаДерева.Имя;
		parameterXDTO.linkParameter = СтрокаДерева.ЭтоПараметрСвязи;
		
		Если ЗначениеЗаполнено(СтрокаДерева.Свойство) Тогда 
			parameterXDTO.property		= СтрокаДерева.Свойство;
			parameterXDTO.unit			= СтрокаДерева.ЕдиницаИзмерения;
			
			ЗначениеПараметра = СтрокаДерева.Значение;
			parameterXDTO.value = ?(ЗначениеЗаполнено(ЗначениеПараметра), СериализаторXDTO.ЗаписатьXDTO(ЗначениеПараметра), Неопределено);
		Иначе // группа параметров
			aps_ЗаполнитьПараметрыМоделиПоДереву( parameterXDTO, СтрокаДерева.Строки );
		КонецЕсли;
		
		itemXDTO.parameters.Добавить(parameterXDTO);
	КонецЦикла;
КонецФункции

// Функция преобразует ДанныеФормыСтрокаДерева в объект XDTO
// Параметры:
//		ЭлементДерева - ДанныеФормыЭлементДерева
//		КолУровней - Число, Неопределено. Если Неопределено, преобразует все уровни
// Возвращаемое значение:
//		ОбъектXDTO
// Пример:
//		 parentXDTO = ЭлементДерева2XDTO(СтрокаДерева);
Функция ЭлементДерева2XDTO( ЭлементДерева, КолУровней = 0 ) Экспорт
	
	ИсточникДанных = Новый Структура;
	
	Если ЭлементДерева.ЭлементСсылка = Неопределено Тогда
		
		ИсточникДанных.Вставить("КартинкаСвязи"		, ЭлементДерева.Картинка);
		ИсточникДанных.Вставить("ПредставлениеСвязи", Строка(ЭлементДерева.ВидСвязи));
		ИсточникДанных.Вставить("ВидСвязи"			, ЭлементДерева.ВидСвязи);
		
		// html-шаблоны
		ИсточникДанных.Вставить("ФайлШаблонаПросмотраСвязи"	, "");
		ИсточникДанных.Вставить("ФайлШаблонаДействийСвязи"	, "");
		
		itemXDTO = aps_СоздатьОбъектМоделиXDTO(ЭлементДерева.ВидСвязи, ИсточникДанных);
		
	Иначе 
		
		// html-шаблоны
		ИсточникДанных.Вставить("ФайлШаблонаПросмотра"		, "");
		ИсточникДанных.Вставить("ФайлШаблонаРедактирования"	, "");
		ИсточникДанных.Вставить("ФайлШаблонаДействий"		, "");
		
		ИсточникДанных.Вставить("ЭлементСсылка"		, ЭлементДерева.ЭлементСсылка);
		ИсточникДанных.Вставить("ВидЭлемента"		, ЭлементДерева.ВидЭлемента);
		ИсточникДанных.Вставить("Картинка"			, ЭлементДерева.Картинка);
		ИсточникДанных.Вставить("ПредставлениеЭлемента", ЭлементДерева.Представление);
		ИсточникДанных.Вставить("Владелец"			, Неопределено);
		ИсточникДанных.Вставить("Группа"			, Неопределено);
		ИсточникДанных.Вставить("HTMLКонтент"		, Неопределено);
		ИсточникДанных.Вставить("ПорядокВывода"		, ЭлементДерева.ПорядокВывода);
		
		Если ТипЗнч(ИсточникДанных.ЭлементСсылка)=Тип("СправочникСсылка.aps_ЭлементыИзделия") Тогда 
			ИсточникДанных.Вставить("ПараметрыЭлементаИзделия"		, Новый ТаблицаЗначений);
		ИначеЕсли ТипЗнч(ИсточникДанных.ЭлементСсылка)=Тип("СправочникСсылка.aps_ЭлементыСправочников") Тогда 
			ИсточникДанных.Вставить("ПараметрыЭлементаСправочника"	, Новый ТаблицаЗначений);
		Иначе 
			ИсточникДанных.Вставить("ПараметрыЭлементаТехнологии"	, Новый ТаблицаЗначений);
		КонецЕсли;
	
		itemXDTO = aps_СоздатьОбъектМоделиXDTO(ЭлементДерева.ЭлементСсылка, ИсточникДанных);
		itemXDTO.link		= ?(ЗначениеЗаполнено(ЭлементДерева.ЭлементСвязи), СериализаторXDTO.ЗаписатьXDTO(ЭлементДерева.ЭлементСвязи), Неопределено);
		itemXDTO.linkType	= ?(ЗначениеЗаполнено(ЭлементДерева.ВидСвязи), СериализаторXDTO.ЗаписатьXDTO(ЭлементДерева.ВидСвязи), Неопределено);
		
		aps_ЗаполнитьПараметрыМоделиПоДереву(itemXDTO, ДанныеФормыВЗначение(ЭлементДерева.Параметры, Тип("ДеревоЗначений")).Строки);
		
	КонецЕсли;
		
	Если КолУровней = Неопределено Или КолУровней > 0 Тогда 
		Для Каждого ПодчиненныйЭлементДерева Из ЭлементДерева.ПолучитьЭлементы() Цикл
			itemXDTO.items.Добавить(ЭлементДерева2XDTO(ПодчиненныйЭлементДерева, ?(КолУровней<>Неопределено, КолУровней-1, КолУровней)));
		КонецЦикла;
	КонецЕсли;
	
	Возврат itemXDTO;
КонецФункции

#КонецОбласти

#КонецЕсли


