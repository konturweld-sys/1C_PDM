// Главное фоновое задание по созданию спецификаций
// Параметры:
//		нет
// Пример:
//      aps_ТехнологическаяСхема.ФормированиеРСиМК_ФЗ();
//
Процедура ФормированиеРСиМК_ФЗ() Экспорт
	ЧислоПотоков=Константы.aps_ТехСхемаЧислоПотоковОбработки.Получить();
	Если ЧислоПотоков<=0 Тогда
		ЧислоПотоков=1;
	КонецЕсли;
	// Число элементов больше которых требуется параллельность
	КоэффициентПараллельности=Константы.aps_ТехСхемаКоэффициентПараллельностиСозданияСпецификаций.Получить();
	Если КоэффициентПараллельности<ЧислоПотоков Тогда
		КоэффициентПараллельности=ЧислоПотоков;
	КонецЕсли;
    ЭтоФайловаяБаза = ( Найти(Врег(СтрокаСоединенияИнформационнойБазы()), "FILE=") = 1 );
	локТаблицаЗаписейКЗапуску=Новый ТаблицаЗначений;
	массивЛокальныхЗаданий=Новый Массив();
	КомлпИСпец=Новый Соответствие;
	Пока Истина Цикл
		// Получаем из регистра элементы для которых нужно создать спецификации
		НаборЗаписейКЗапуску = РегистрыСведений.aps_ДанныеВыполненияФоновыхЗаданий.СоздатьНаборЗаписей();
		НаборЗаписейКЗапуску.Отбор.Статус.Установить(Перечисления.СтатусФормированияERP.Завершен);
		НаборЗаписейКЗапуску.Прочитать();
		Если НаборЗаписейКЗапуску.Количество()=0 Тогда
			Прервать;
		КонецЕсли;
		локТаблицаЗаписейКЗапуску = НаборЗаписейКЗапуску.Выгрузить();
		// Сортируем элементы так, чтобы верхний уровень был в начале
		локТаблицаЗаписейКЗапуску.Свернуть("ЭлементСсылка, Статус","Уровень");
		локТаблицаЗаписейКЗапуску.Сортировать("Уровень Убыв");
		
		Если локТаблицаЗаписейКЗапуску.Количество()=0 Тогда
			Возврат;
		КонецЕсли;
		
		// Получаем все строки максимального (листы) уровня (они после сортировки вверху)
		СтрокиТекущегоУровня=локТаблицаЗаписейКЗапуску.НайтиСтроки(Новый Структура("Уровень",локТаблицаЗаписейКЗапуску[0].Уровень));
		
		// Число строк одного уровня больше коэффициента параллельности - используем параллельность
		Если СтрокиТекущегоУровня.Количество()<КоэффициентПараллельности Тогда // Не используем параллельность
			ЧислоПотоков=1;
			Количество=СтрокиТекущегоУровня.Количество();
			Хвост=0;
		Иначе // Используем параллельность
			// Количество элементов, обрабатываемых каждым потоком
			Количество=Цел(СтрокиТекущегоУровня.Количество()/ЧислоПотоков);
			// Остаток от количества
			Хвост=СтрокиТекущегоУровня.Количество()%ЧислоПотоков;
		КонецЕсли;
		
		// Формируем 
		НаборСформированныхСпец=РегистрыСведений.aps_ДанныеВыполненияФоновыхЗаданий.СоздатьНаборЗаписей();
		НаборСформированныхСпец.Отбор.Статус.Установить(Перечисления.СтатусФормированияERP.СпецификацииСформированы);
		НаборСформированныхСпец.Прочитать();
        ТаблицаСпецификаций=НаборСформированныхСпец.Выгрузить();
		
		Для j=0 По ЧислоПотоков-1 Цикл
			// Формирование строк для j-го потока
			МассивСтрок=Новый Массив();
			Для i=j*Количество По Количество*(j+1)-1 Цикл
				МассивСтрок.Добавить(СтрокиТекущегоУровня[i]);
			КонецЦикла;
			// Добавить к последнему потоку элементы не вошедшие в целове количество
			Если j=ЧислоПотоков-1 И Хвост>0 Тогда
					Для i=0 По Хвост-1 Цикл
						МассивСтрок.Добавить(СтрокиТекущегоУровня[СтрокиТекущегоУровня.Количество()-1 -i]);
					КонецЦикла;
			КонецЕсли;
			
			Если МассивСтрок.Количество()>0 Тогда
				// Копируем строки и даем как параметр процедуре
				ИсхТаблица=локТаблицаЗаписейКЗапуску.Скопировать(МассивСтрок);
				//Если ЭтоФайловаяБаза Тогда 
					ФормированиеРСиМКПоток_ФЗ( ИсхТаблица, ТаблицаСпецификаций );
				//Иначе
				//	МассивПараметров = Новый Массив();
				//	МассивПараметров.Добавить(ИсхТаблица);
