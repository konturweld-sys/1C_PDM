// На основании профессии, разряда работ и условий труда формирует запись в справочнике видов работ
//
// Параметры:
//		Профессия - СправочникСсылка.ПрофессииРабочих
//		РазрядРабот - число
//		УсловияТруда - ПеречислениеСсылка.aps_УсловияТруда
// Возвращаемое значение:
//		СправочникСсылка.ВидыРаботСотрудников; Неопределено
// Пример:
//		ВидРабот=СоздатьИлиНайтиВидыРабот( Профессия, РазрядРабот, УсловияТруда );
//
Функция СоздатьИлиНайтиВидыРабот( Профессия, РазрядРабот, УсловияТруда )
	Если Профессия<>Неопределено И НЕ Профессия.Пустая() Тогда
		КодВидаРабот= СокрЛП(Профессия.Код);
		НаименованиеВидаРабот=Профессия.Наименование;
		Если РазрядРабот>0 Тогда
			 КодВидаРабот=КодВидаРабот+" "+Строка(РазрядРабот);
			 НаименованиеВидаРабот=НаименованиеВидаРабот+", разряд "+Строка(РазрядРабот);
		Иначе
			 КодВидаРабот=КодВидаРабот+" X";
		КонецЕсли;
			 
		Если УсловияТруда<>Неопределено Тогда
			КодВидаРабот=КодВидаРабот+" "+Строка(УсловияТруда);	
			Если УсловияТруда=Перечисления.aps_УсловияТруда.НормальныеУсловия Тогда 
				НаименованиеВидаРабот=НаименованиеВидаРабот+", НУ";
			Иначе
				НаименованиеВидаРабот=НаименованиеВидаРабот+", ВУ";
			КонецЕсли;
		Иначе
			КодВидаРабот=КодВидаРабот+" X";	
		КонецЕсли;			
		Если СтрДлина(КодВидаРабот)>0 Тогда
			ВидРабот=Справочники.ВидыРаботСотрудников.НайтиПоКоду( КодВидаРабот );
			Если ВидРабот.Пустая() Тогда
				ВидРабот=Справочники.ВидыРаботСотрудников.СоздатьЭлемент();
				ВидРабот.ЕдиницаИзмерения=Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду( 356 );
				ВидРабот.Код=КодВидаРабот;
				ВидРабот.Наименование=НаименованиеВидаРабот;
				ВидРабот.Записать();
				ВидРабот=ВидРабот.Ссылка;
			ИначеЕсли ВидРабот.ПометкаУдаления Тогда
				ВидРабот.ПолучитьОбъект().УстановитьПометкуУдаления( Ложь );
			КонецЕсли;
			Возврат ВидРабот;
		КонецЕсли;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
КонецФункции

// На основании соответствия (ВидРЦ,(Тшт,Тпз,ЕдИзм)) заполняет ТЧ по загрузке
// видов РЦ в этапе
//
// Параметры:
//		Этап - текущий этап
//		Соотв - соответствие видов РЦ
// Пример:
//		ЗаполнитьВремяВидовРЦЭтапа( УП2Этап, ВидыРЦЭтапа );
//
Процедура ЗаполнитьВремяВидовРЦЭтапа( Этап, Соотв )
	Для Каждого КлючИЗначение Из Соотв Цикл
		ВидРЦ=Этап.ВидыРабочихЦентров.Добавить();
		ВидРЦ.ВидРабочегоЦентра=КлючИЗначение.Ключ;
		ВидРЦ.ВремяРаботы=КлючИЗначение.Значение.ТШТ+КлючИЗначение.Значение.ТПЗ
		/?(Этап.ОдновременноПроизводимоеКоличествоЕдиницПартийИзделий=0,1,Этап.ОдновременноПроизводимоеКоличествоЕдиницПартийИзделий);
		ВидРЦ.ЕдиницаИзмерения=КлючИЗначение.Значение.ЕдИзм;
	КонецЦикла;
	Этап.ДлительностьЭтапа=0;  // в секундах
	// Расчет общей длительности этапа (вспомогательный функционал)
	Для i=0 По Этап.ВидыРабочихЦентров.Количество()-1 Цикл
		Этап.ДлительностьЭтапа=Этап.ДлительностьЭтапа+aps_ТехнологическаяСхемаСервисы.ПолучитьВремяВСекундах(Этап.ВидыРабочихЦентров[i].ВремяРаботы,Этап.ВидыРабочихЦентров[i].ЕдиницаИзмерения );
	КонецЦикла;
	Этап.ДлительностьЭтапа=Цел(aps_ТехнологическаяСхемаСервисы.ПолучитьВремяВЕдиницеИзмерения(Этап.ДлительностьЭтапа,перечисления.ЕдиницыИзмеренияВремени.День));
	Этап.ДлительностьЭтапа=?(Этап.ДлительностьЭтапа=0,1,Этап.ДлительностьЭтапа);
КонецПроцедуры

// Процедура заполняет трудоемкость в ТЧ этапа или МК
//
// Параметры:
//		ТрудозатратыТЧ - табличная часть 
//		Профессия - профессия PDM
//		Разряд - раздря работ PDM
//  	УсловияТруда - условия труда
//  	ШтучноКалькВремяСек - штучно-калькуляционное время в секундах
//		ЭтапИлиОперация - СправочникСсылка.ЭтапыПроизводства
// Пример:
//      ЗаполнитьТрудозатраты(  УП2ТекущаяМК.Трудозатраты, 
//											Маршрут[i].Профессия, 
//											Маршрут[i].РазрядРабот,
//											Маршрут[i].УсловияТруда,  
//											ВремяОперацииСек,
//											УП2ТекущаяОперация );
//
Процедура ЗаполнитьТрудозатраты(	ТрудозатратыТЧ, 
									Профессия,
									РазрядРабот,
									УсловияТруда,
									ШтучноКалькВремяСек,
									ЭтапИлиОперация )
	// Создать элемент вида работ на основании профессии, РР и УТ									
	ВидРабот=СоздатьИлиНайтиВидыРабот( Профессия, РазрядРабот, УсловияТруда );
	Если ВидРабот<>Неопределено И НЕ ВидРабот.Пустая() Тогда
		// Рассчитать количество норм
		НормоСекунды=aps_ТехнологическаяСхемаСервисы.ПолучитьВремяВСекундах( 1, Перечисления.ЕдиницыИзмеренияВремени.Час );
		КоличествоНорм=?(НормоСекунды>0,ШтучноКалькВремяСек/НормоСекунды,0); 
		// Найти существующий вид работ в ТЧ
		ТР=ТрудозатратыТЧ.Найти( ВидРабот );
		Если ТР=Неопределено Тогда // если нет - добавить
			ТР=ТрудозатратыТЧ.Добавить();
			ТР.ВидРабот=ВидРабот;
			ТР.Количество=КоличествоНорм;
			Если ТипЗнч( ТрудозатратыТЧ )=Тип( "СправочникТабличнаяЧасть.МаршрутныеКарты.Трудозатраты" ) Тогда
				ТР.Операция=ЭтапИлиОперация.ПолучитьСсылкуНового();
			Иначе
				ТР.Этап=ЭтапИлиОперация.ПолучитьСсылкуНового();
				ТР.ЭтапРедактирование=ЭтапИлиОперация.ПолучитьСсылкуНового();
			КонецЕсли;		
		Иначе // найдено - суммируем количество
			ТР.Количество=ТР.Количество+КоличествоНорм;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

