#Область ПрограммныйИнтерфейс

// Поиск упаковки, соответствующей единицы по классификатору
//
// Параметры:
//		Номенклатура
//		ЕдиницаПоКлассификатору
// Возвращаемое значение:
//		СправочникСсылка.УпаковкиНоменклатуры
//
Функция ПоискУпаковкиПоЕдиницеИзм( Номенклатура, ЕдиницаПоКлассиф ) Экспорт
	УпаковкаНоменклатуры=Справочники.УпаковкиЕдиницыИзмерения.ПустаяСсылка();
	Если ЕдиницаПоКлассиф<>Номенклатура.ЕдиницаИзмерения Тогда
		УпаковкаНоменклатуры=Справочники.УпаковкиЕдиницыИзмерения.НайтиПоРеквизиту("ЕдиницаИзмерения",ЕдиницаПоКлассиф,,Номенклатура);
		Если УпаковкаНоменклатуры.Пустая() Тогда
			НаборУпаковки=Номенклатура.ВидНоменклатуры.НаборУпаковок;
			Если НЕ НаборУпаковки.Пустая()  Тогда
				УпаковкаНоменклатуры=Справочники.УпаковкиЕдиницыИзмерения.НайтиПоРеквизиту(
									 "ЕдиницаИзмерения",ЕдиницаПоКлассиф,,НаборУпаковки);	
				Возврат УпаковкаНоменклатуры;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат УпаковкаНоменклатуры;
КонецФункции

// Функция принимая таблицу ссылок, получает исходные данные из регистра кешированных данных
// по составу и технологии
//
// Параметры:
//		ТаблицаСсылок – Таблица изделий.
// Возвращаемое значение:
//		Таблица кэширующего регистра
// Пример:
//		ТаблицаНабораРегистра=ПолучитьДанныеРегистраКэшированныхДанных( Таблица );
//
Функция ПолучитьДанныеРегистраКэшированныхДанных(ТаблицаСсылок) Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	ТаблицаСсылок.ЭлементСсылка КАК Ссылка
	                      |ПОМЕСТИТЬ ВТСсылки
	                      |ИЗ
	                      |	&Данные КАК ТаблицаСсылок
	                      |;
	                      |
	                      |////////////////////////////////////////////////////////////////////////////////
	                      |ВЫБРАТЬ
	                      |	aps_КэшированныеДанные.ЭлементСсылка,
	                      |	aps_КэшированныеДанные.НомерЗаписи,
	                      |	aps_КэшированныеДанные.ВидНабора,
	                      |	aps_КэшированныеДанные.ПотомокСсылка,
	                      |	aps_КэшированныеДанные.ВидСвязи,
	                      |	aps_КэшированныеДанные.Количество,
	                      |	aps_КэшированныеДанные.ЕдиницаИзмерения,
	                      |	aps_КэшированныеДанные.Упаковка,
	                      |	aps_КэшированныеДанные.ЭлементСсылка1,
	                      |	aps_КэшированныеДанные.ЭлементСсылка2,
	                      |	aps_КэшированныеДанные.ЭлементСсылка3,
	                      |	aps_КэшированныеДанные.Номенклатура,
	                      |	aps_КэшированныеДанные.Характеристика,
	                      |	aps_КэшированныеДанные.НомерОперации,
	                      |	aps_КэшированныеДанные.ВидОперации,
	                      |	aps_КэшированныеДанные.РабочийЦентр,
	                      |	aps_КэшированныеДанные.ВремяВыполнения,
	                      |	aps_КэшированныеДанные.Подразделение,
	                      |	aps_КэшированныеДанные.НоменклатураПолуфабриката,
	                      |	aps_КэшированныеДанные.ХарактеристикаПолуфабриката,
	                      |	aps_КэшированныеДанные.Непланируемый,
	                      |	aps_КэшированныеДанные.ЕдиницаИзмеренияВремени,
	                      |	aps_КэшированныеДанные.ПодготовительноеВремя,
	                      |	aps_КэшированныеДанные.РазрядРабот,
	                      |	aps_КэшированныеДанные.Профессия,
	                      |	aps_КэшированныеДанные.УсловияТруда,
	                      |	aps_КэшированныеДанные.КОИД
	                      |ИЗ
	                      |	ВТСсылки КАК ВТСсылки
	                      |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.aps_КэшированныеДанные КАК aps_КэшированныеДанные
	                      |		ПО ВТСсылки.Ссылка = aps_КэшированныеДанные.ЭлементСсылка
	                      |ГДЕ
	                      |	(aps_КэшированныеДанные.ВидНабора = ЗНАЧЕНИЕ(Перечисление.ERPКорпВидыНаборов.ВыходноеИзделие)
	                      |			ИЛИ aps_КэшированныеДанные.ВидНабора = ЗНАЧЕНИЕ(Перечисление.ERPКорпВидыНаборов.Маршрут)
	                      |			ИЛИ aps_КэшированныеДанные.ВидНабора = ЗНАЧЕНИЕ(Перечисление.ERPКорпВидыНаборов.Техпроцесс)
	                      |			ИЛИ aps_КэшированныеДанные.ВидНабора = ЗНАЧЕНИЕ(Перечисление.ERPКорпВидыНаборов.Состав))");
	Запрос.УстановитьПараметр("Данные",ТаблицаСсылок);				 
	ТаблицаДанных = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаДанных;
КонецФункции

// Фоновое задание для создания спецификаций
//
// Параметры:
//		Таблица - Исходная таблица
//		ТаблицаСпецификаций - сформированные на предыдущем уровне
// Пример:
//      ФормированиеРСиМКПоток_ФЗ( ИсхТаблица, ТаблицаСпецификаций );
//
Процедура ФормированиеРСиМКПоток_ФЗ( Таблица, ТаблицаСпецификаций ) Экспорт
		// Удаление подлежащих обработке элементов из регистра	
		Для Каждого ЗавершенныйЭлемент из Таблица Цикл
			МЗ=РегистрыСведений.aps_ДанныеВыполненияФоновыхЗаданий.СоздатьМенеджерЗаписи();
			МЗ.Статус=Перечисления.СтатусФормированияERP.Завершен;
			МЗ.ЭлементСсылка=ЗавершенныйЭлемент.ЭлементСсылка;
			МЗ.Удалить();
		КонецЦикла;
		// Отдаем эти строки на получение данных из регистра
		ТаблицаНабораРегистра=ПолучитьДанныеРегистраКэшированныхДанных( Таблица );
		// Обрабатываем эти строки
		Инд=0;
		Пока Инд<=ТаблицаНабораРегистра.Количество()-1 Цикл
			НайденныеСтроки=ТаблицаНабораРегистра.НайтиСтроки( Новый Структура("ЭлементСсылка", ТаблицаНабораРегистра[Инд].ЭлементСсылка ) ); 
			Попытка
				Строка=локЗаполнениеРСиМК( ТаблицаНабораРегистра.Скопировать( НайденныеСтроки ),ТаблицаСпецификаций );
				// Записываем в регистр информацию о выполненном элементе						
				МЗ=РегистрыСведений.aps_ДанныеВыполненияФоновыхЗаданий.СоздатьМенеджерЗаписи();
				МЗ.Статус=Перечисления.СтатусФормированияERP.СпецификацииСформированы;
				МЗ.ЭлементСсылка=ТаблицаНабораРегистра[Инд].ЭлементСсылка;
				МЗ.РесурснаяСпецификация=Строка.Спецификация;
				МЗ.НоваяСпецификация=Строка.ЭтоНовыйСпецификация;
				МЗ.Записать(Истина);
			Исключение
				// В случае ошибки повторно записываем элемент в регистр
				МЗ=РегистрыСведений.aps_ДанныеВыполненияФоновыхЗаданий.СоздатьМенеджерЗаписи();
				МЗ.Статус=Перечисления.СтатусФормированияERP.Завершен;
				МЗ.ЭлементСсылка=ТаблицаНабораРегистра[Инд].ЭлементСсылка;
				МЗ.Записать(Истина);
				ВызватьИсключение;
			КонецПопытки;				
			// Записываем новый менеджер записи уже со спецификациями и техкартами
			Инд=Инд+НайденныеСтроки.Количество();
		КонецЦикла;
КонецПроцедуры

// Создание ресурсных спецификаций и маршрутных карт
//
// Параметры:
//		ИсхТабл - Отбор кэшированной таблицы
//		ТаблицаСпецификаций - существ. спецификации
// Возвращаемое значение:
//		Структура
// Пример:
//		Строка=локЗаполнениеРСиМК( ТаблицаНабораРегистра.Скопировать( НайденныеСтроки ),ТаблицаСпецификаций );
//
Функция локЗаполнениеРСиМК( ИсхТабл, ТаблицаСпецификаций, СоздаватьНовые=Истина ) Экспорт 
	
	СтруктураДанныхERP = Новый Структура("Спецификация, ТехнологическаяКарта, ЭтоНовыйСпецификация, ЭтоНовыйТехнологическаяКарта, МассивИсхКомлп");
	
	СозданныеОбъектыМассив =Новый Массив();

	
	///////////////////////////////////////////////////////////
	// создание спецификаций и технологических карт производства             	
	РесурснаяСпецификация=aps_ТехнологическаяСхемаСервисы.СоздатьОбъект( Справочники.РесурсныеСпецификации );
	aps_ТехнологическаяСхемаСервисы.ВставитьВМассивСУникальностью( СозданныеОбъектыМассив,  РесурснаяСпецификация );
	
	
	ИсходныеКомплектующие	= РесурснаяСпецификация.МатериалыИУслуги;
	ВыходныеИзделия			= РесурснаяСпецификация.ВыходныеИзделия;
	
	ОсновнаяТехнологическаяКарта =Неопределено; // Справочники.МаршрутныеКарты.СоздатьЭлемент();
	МаршрутТехнологическойКарты  =Неопределено; //ОсновнаяТехнологическаяКарта.Маршрут;
		
	ВыходныеИзделия=ИсхТабл.НайтиСтроки(Новый Структура("ВидНабора", Перечисления.ERPКорпВидыНаборов.ВыходноеИзделие ));
	
	Если ВыходныеИзделия.Количество()=0 Тогда
		Возврат Неопределено;
	Иначе		
		ВыходноеИзделие=ВыходныеИзделия[0];
	КонецЕсли;
	
	// Спецификация типа "Узел"
	ЭтоУзел=ВыходноеИзделие.Непланируемый;
	
	
	Маршрут=ИсхТабл.НайтиСтроки(Новый Структура("ВидНабора", Перечисления.ERPКорпВидыНаборов.Маршрут ));
	
	ТекущаяОперация=Неопределено;
	ОперацияМаршрутаТехКарты=Неопределено;
	
	НоменклатураПФ  =Неопределено; // если <>Неопределено, то это спецификация на полуфабрикат
	ХарактеристикаПФ=Неопределено;
	
	// Устанавливаем флаг формирования по составу изделия, если не найдена технология
		
	ФормироватьПоСоставуИзделия=?(Маршрут.Количество()=0,Истина,Константы.aps_ТехСхемаФормироватьПоСоставу.Получить());
	
	//////////////////////////////////////////////////////////////////
	// Заполнение исх. комплектующих по составу изделия
	//////////////////////////////////////////////////////////////////
	Если ФормироватьПоСоставуИзделия Тогда
		Состав=ИсхТабл.НайтиСтроки(Новый Структура("ВидНабора", Перечисления.ERPКорпВидыНаборов.Состав ));
		Если Состав.Количество()>0 Тогда 
			Для i=0 По Состав.Количество()-1 Цикл
					//ИсходнаяКомплектующая=ИсходныеКомплектующие.Добавить();
					
					Спец=Неопределено;
					Строка=ТаблицаСпецификаций.Найти( Состав[i].ЭлементСсылка3, "ЭлементСсылка" );
					Если Строка<>Неопределено Тогда
						Спец=Строка.РесурснаяСпецификация;
					КонецЕсли;
					aps_ТехнологическаяСхемаСервисы.ЗаполнитьИсхКомплектующие( ИсходныеКомплектующие,
							Состав[i].Номенклатура,
							Состав[i].Характеристика,Состав[i].Количество,
							Состав[i].Упаковка, Неопределено, Спец ); 
				КонецЦикла;
		КонецЕсли;
	Иначе
		// Формируем имя маршрутных карт и ресурсных спецификаций		
		ВариантНаименованияСпецификации = Константы.aps_ТехСхемаНаименованиеСпецификации.Получить();
		Если ВариантНаименованияСпецификации = 0 Тогда //представление маршрута/техпроцесса
			НаименованиеСпецификации=Строка(ВыходныеИзделия[0].ПотомокСсылка);
			НаименованиеТехКарты = НаименованиеСпецификации;
		ИначеЕсли ВариантНаименованияСпецификации = 1 Тогда //представление изделия
			НаименованиеСпецификации=Строка(ВыходныеИзделия[0].ЭлементСсылка);
			НаименованиеТехКарты="Изг. "+НаименованиеСпецификации;
		ИначеЕсли ВариантНаименованияСпецификации = 2 Тогда //представление номенклатуры
			НаименованиеСпецификации=Строка(ВыходныеИзделия[0].Номенклатура);
			НаименованиеТехКарты="Изг. "+НаименованиеСпецификации;
		КонецЕсли;	

		РесурснаяСпецификация.Наименование=НаименованиеСпецификации;
		
		// Соответствие видов рабочих центров. В него входят вид РЦ как ключи время его работы как 
		// структура из двух полей ТШТ и ТПЗ
		ВидыРЦЭтапа=Новый Соответствие();
		
		Если Маршрут.Количество()>0 Тогда
			МаршрутPDM=Маршрут[0].ПотомокСсылка;
			
			НомерОперации=1;
			
			i=0; ТекущийПунктМаршрута=Неопределено; 
			
			УП2Этап=Неопределено;
			
			// Номер текущего обрабатываемого этапа
			iЭтапа=1;
			// Текущая маршрутная карта этапа (Объект)
			УП2ТекущаяМК=Неопределено;
			// Текущая операция этапа (Объект)
			УП2ТекущаяОперация=Неопределено;
			
			ТекущаяОперацияPDM=Неопределено;
			ТекущийПунктPDM=Неопределено;
			
			
			
			
			Пока i<=Маршрут.Количество()-1 Цикл
				// Смотрим пункты маршрута в технологии. Если это первый пункт или следующий -- создаем этап и записывает предыдущую МК
				Если ЗначениеЗаполнено( Маршрут[i].ЭлементСсылка1 ) И Маршрут[i].ЭлементСсылка1<>ТекущийПунктPDM Тогда
				 	
					УП2ТекущаяМК=Неопределено;
					
				 	Если УП2ТекущаяОперация<>Неопределено Тогда
						УП2ТекущаяОперация.НомерСледующейОперации=0;
						УП2ТекущаяОперация=Неопределено;
					КонецЕсли;
					
					Если УП2Этап<>Неопределено Тогда
						ЗаполнитьВремяВидовРЦЭтапа( УП2Этап, ВидыРЦЭтапа );
						ВидыРЦЭтапа.Очистить();
					КонецЕсли;
					// Создаем новый этап
					УП2Этап=aps_ТехнологическаяСхемаСервисы.СоздатьОбъект( Справочники.ЭтапыПроизводства );
					aps_ТехнологическаяСхемаСервисы.ВставитьВМассивСУникальностью( СозданныеОбъектыМассив,  УП2Этап );
				    УП2Этап.Наименование=Строка(Маршрут[i].ЭлементСсылка1); // здесь ЭлементСсылка1 - пункт
				 	УП2Этап.Подразделение=Маршрут[i].Подразделение;
				 	УП2Этап.НомерЭтапа=iЭтапа; iЭтапа=iЭтапа+1;
				 	УП2Этап.НомерСледующегоЭтапа=iЭтапа;
					УП2Этап.Владелец=РесурснаяСпецификация.ПолучитьСсылкуНового();
					УП2Этап.ОдновременноПроизводимоеКоличествоЕдиницПартийИзделий=?(Маршрут[i].КОИД=0,1,Маршрут[i].КОИД);
					УП2Этап.МаксимальноеКоличествоЕдиницПартийИзделия=УП2Этап.ОдновременноПроизводимоеКоличествоЕдиницПартийИзделий;
					
					УП2Этап.ЕдиницаИзмеренияПредварительногоБуфера=Перечисления.ЕдиницыИзмеренияВремени.Час;
					УП2Этап.ЕдиницаИзмеренияЗавершающегоБуфера=Перечисления.ЕдиницыИзмеренияВремени.Час;

					// Сбрасываем номер текущей операции
				 	НомерТекущейОперации=1;
					// Устанавливаем текущий пункт
					ТекущийПунктPDM=Маршрут[i].ЭлементСсылка1;
				КонецЕсли;
				// Если i-й элемент маршрута операция и эта операция не равна обработанной (может быть одна и та же операция, например из-за комплектования)
				Если ЗначениеЗаполнено( Маршрут[i].ЭлементСсылка2 )
					 И Маршрут[i].ЭлементСсылка2.ВидЭлемента=Справочники.aps_ВидыЭлементов.ТехнологическаяОперация 
					 И ТекущаяОперацияPDM<>Маршрут[i].ЭлементСсылка2 Тогда
					 
					 Если УП2ТекущаяМК=Неопределено Тогда
					 	 	УП2ТекущаяМК=aps_ТехнологическаяСхемаСервисы.СоздатьОбъект( Справочники.МаршрутныеКарты );
							aps_ТехнологическаяСхемаСервисы.ВставитьВМассивСУникальностью( СозданныеОбъектыМассив,  УП2ТекущаяМК );
						 	УП2ТекущаяМК.Наименование=НаименованиеТехКарты+"/"+ УП2Этап.Наименование;
							УП2ТекущаяМК.Статус=Перечисления.СтатусыМаршрутныхКарт.Действует;
							УП2ТекущаяМК.Ответственный=ПараметрыСеанса.ТекущийПользователь;
							УП2ТекущаяМК.НачалоДействия=ТекущаяДата();
							УП2ТекущаяМК.ДляВидаИзделий=ВыходныеИзделия[0].Номенклатура.ВидНоменклатуры;
