// Проверяет, подключено ли расширение работы с файлами. Если расширение не подключено,
// предлагает пользователю установить его в веб-клиенте.
//
// Параметры:
//		Нет
// Возвращаемое значение:
//		Булево
// Пример:
//		РасширениеПодключено = aps_РаботаСФайлами.aps_ПодключитьРасширениеРаботыСФайлами();
//
Функция aps_ПодключитьРасширениеРаботыСФайлами() Экспорт
	
#Если Не ВебКлиент Тогда
	Возврат Истина;  // код работает только в веб клиенте
#КонецЕсли

    РасширениеПодключено = ПодключитьРасширениеРаботыСФайлами();
	Если РасширениеПодключено Тогда
		Возврат Истина; // расширение уже подключено и готово к работе
	КонецЕсли;	

	// задать вопрос об установке расширения работы с файлами
	Если Вопрос(НСтр("ru = 'Для работы с файловыми функциями на веб-клиенте необходимо установить расширение работы с файлами.'; en_US = 'The expansion of work with files must be installed to work with file functions in web client.'") + Символы.ПС +
						НСтр("ru = 'Установить и подключить?'; en_US = 'Install and enable it?'"), РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда 
		УстановитьРасширениеРаботыСФайлами();
	    РасширениеПодключено = ПодключитьРасширениеРаботыСФайлами();
		Если РасширениеПодключено Тогда
			Возврат Истина; // расширение успешно подключено
		КонецЕсли;	
	КонецЕсли;
	
	Предупреждение(НСтр("ru = 'Расширение работы с файлами не подключено! Файловые функции будут недоступны.'; en_US = 'The expansion of work with files is not enabled! File functions will be unavailable.'"));
	
	Возврат Ложь; // не удалось установить расширение, либо отказ в диалоге
	
КонецФункции // aps_ПодключитьРасширениеРаботыСФайлами

