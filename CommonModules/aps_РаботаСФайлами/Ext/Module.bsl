//
Функция aps_ДобавитьПоследнийСлэш(Каталог) Экспорт 
	Если КодСимвола(Каталог,СтрДлина(Каталог))<>КодСимвола("\") Тогда 
		Возврат Каталог+"\";
	Иначе
		Возврат Каталог;
	КонецЕсли;
КонецФункции	

