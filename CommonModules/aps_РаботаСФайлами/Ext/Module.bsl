// Функция возвращает индекс картинки файла по расширению. Заимствована из конфигурации 1С:Документооборот и модифицирована
// Параметры:
//		Расширение - Строка
// Возвращаемое значение: 
//		Число
// Пример:
//		НоваяСтрокаСписка.КартинкаРасширения=aps_РаботаСФайлами.aps_ПолучитьПиктограммуФайлаПоРасширению(Файл.Расширение);
//
Функция aps_ПолучитьПиктограммуФайлаПоРасширению(Знач Расширение) Экспорт
	Расширение=НРег(Расширение)+";";
	
	Если Найти(".dt;.1cd;.cf;.cfu;",Расширение) <> 0 Тогда
		Возврат 3; // Файлы 1С
	ИначеЕсли Найти(".mxl;",Расширение) <> 0 Тогда
		Возврат 4; // Табличный Файл 
	ИначеЕсли Найти(".txt;.log;.ini;",Расширение) <> 0 Тогда
		Возврат 5; // Текстовый Файл
	ИначеЕсли Найти(".epf;",Расширение) <> 0 Тогда
		Возврат 6; //Внешние обработки
	ИначеЕсли Найти(".ico;.wmf;.emf;",Расширение) <> 0 Тогда
		Возврат 7; // Картинки
	ИначеЕсли Найти(".htm;.html;.url;.mht;.mhtml;",Расширение) <> 0 Тогда
		Возврат 8; // HTML
	ИначеЕсли Найти(".doc;.dot;.rtf;.docx;",Расширение) <> 0 Тогда
		Возврат 9; // Файл Microsoft Word 
	ИначеЕсли Найти(".xls;.xlw;.xlsx;",Расширение) <> 0 Тогда
		Возврат 10; // Файл Microsoft Excel
	ИначеЕсли Найти(".ppt;.pps;",Расширение) <> 0 Тогда
		Возврат 11; // Файл Microsoft PowerPoint
	ИначеЕсли Найти(".vsd;",Расширение) <> 0 Тогда
		Возврат 12; // Файл Microsoft Visio
	ИначеЕсли Найти(".mpp;",Расширение) <> 0 Тогда
		Возврат 13; // Файл Microsoft Visio
	ИначеЕсли Найти(".mdb;.adp;.mda;.mde;.ade;",Расширение) <> 0 Тогда
		Возврат 14; // База данных Microsoft Access
	ИначеЕсли Найти(".xml;",Расширение) <> 0 Тогда
		Возврат 15; // xml
	ИначеЕсли Найти(".msg;",Расширение) <> 0 Тогда
		Возврат 16; // Письмо электронной почты
	ИначеЕсли Найти(".zip;.rar;.arj;.cab;.lzh;.ace;",Расширение) <> 0 Тогда
		Возврат 17; // Архивы
	ИначеЕсли Найти(".exe;.com;.bat;.cmd;",Расширение) <> 0 Тогда
		Возврат 18; // Исполняемые файлы
	ИначеЕсли Найти(".grs;",Расширение) <> 0 Тогда
		Возврат 19; // Графическая схема
	ИначеЕсли Найти(".geo;",Расширение) <> 0 Тогда
		Возврат 20; // Географическая схема
	ИначеЕсли Найти(".jpg;.jpeg;.jp2;.jpe;",Расширение) <> 0 Тогда
		Возврат 21; // jpg
	ИначеЕсли Найти(".bmp;.dib;",Расширение) <> 0 Тогда
		Возврат 22; // bmp
	ИначеЕсли Найти(".tif;",Расширение) <> 0 Тогда
		Возврат 23; // tif
	ИначеЕсли Найти(".gif;",Расширение) <> 0 Тогда
		Возврат 24; // gif
	ИначеЕсли Найти(".png;",Расширение) <> 0 Тогда
		Возврат 25; // png
	ИначеЕсли Найти(".pdf;",Расширение) <> 0 Тогда
		Возврат 26; // pdf
	ИначеЕсли Найти(".odt;",Расширение) <> 0 Тогда
		Возврат 27; // Open Office writer
	ИначеЕсли Найти(".odf;",Расширение) <> 0 Тогда
		Возврат 28; // Open Office math
	ИначеЕсли Найти(".odp;",Расширение) <> 0 Тогда
		Возврат 29; // Open Office Impress
	ИначеЕсли Найти(".odg;",Расширение) <> 0 Тогда
		Возврат 30; // Open Office draw
	ИначеЕсли Найти(".ods;",Расширение) <> 0 Тогда
		Возврат 31; // Open Office calc
	ИначеЕсли Найти(".mp3;.wma;",Расширение) <> 0 Тогда
		Возврат 32;
	ИначеЕсли Найти(".erf;",Расширение) <> 0 Тогда
		Возврат 33; // Внешние отчеты
	ИначеЕсли Найти(".avi;.wmv;.mpg;.mpeg;",Расширение) <> 0 Тогда	
		Возврат 34; // Медиа-файлы
	ИначеЕсли Найти(".par;",Расширение) <> 0 Тогда
	    Возврат 35; // Деталь SolidEdge
	ИначеЕсли Найти(".asm;",Расширение) <> 0 Тогда
	    Возврат 36; // Сборка SolidEdge
	ИначеЕсли Найти(".dft;",Расширение) <> 0 Тогда
	    Возврат 37; // Чертеж SolidEdge
	ИначеЕсли Найти(".sldprt;",Расширение) <> 0 Тогда
	    Возврат 38; // Деталь SolidWorks
	ИначеЕсли Найти(".sldasm;",Расширение) <> 0 Тогда
	    Возврат 39; // Сборка SolidWorks
	ИначеЕсли Найти(".slddrw;",Расширение) <> 0 Тогда
	    Возврат 40; // Чертеж SolidWorks
	ИначеЕсли Найти(".m3d;",Расширение) <> 0 Тогда		
	    Возврат 41; // Деталь КОМПАС
	ИначеЕсли Найти(".a3d;",Расширение) <> 0 Тогда		
	    Возврат 42; // Сборка КОМПАС
	ИначеЕсли Найти(".cdw;",Расширение) <> 0 Тогда		
	    Возврат 43; // Чертеж КОМПАС
	ИначеЕсли Найти(".ipt;",Расширение) <> 0 Тогда		
	    Возврат 44; // Деталь Inventor
	ИначеЕсли Найти(".iam;",Расширение) <> 0 Тогда		
	    Возврат 45; // Сборка Inventor
	ИначеЕсли Найти(".idw;",Расширение) <> 0 Тогда		
	    Возврат 46; // Чертеж Inventor
	ИначеЕсли Найти(".dwg;",Расширение) <> 0 Тогда		
	    Возврат 47; // Чертеж AutoCAD
	Иначе
		Возврат 2;
	КонецЕсли;
КонецФункции

// Функция получает и возвращает расширение файла по имени
// Параметры:
//		ИмяФайла - строка
// Возвращаемое значение:
//		строка
// Пример:
//		РасширениеФайла = aps_РаботаСФайлами.aps_ВспомПолучитьРасширениеФайлаПоИмени(ПолноеИмяФайла);
//
Функция aps_ВспомПолучитьРасширениеФайлаПоИмени(Знач ИмяФайла) Экспорт 
	i = Найти (ИмяФайла,".");
	Пока i > 0 Цикл
		ИмяФайла = Сред(ИмяФайла, i+1);
		i = Найти( ИмяФайла, "." );
	КонецЦикла;
	Возврат ИмяФайла;
КонецФункции

// Функция проверяет строку на наличие обратного слеша в конце, при необходимости добавляет его
//
// Параметры:
//		Каталог - Строка, путь к каталогу
// Возвращаемое значение:
//		Строка, путь к каталогу с обратным слешем в конце
// Пример:
