#Область ОбщиеПроцедурыИФункцииРаботыСФайлами	
	
// Процедура импортирует файлы и каталоги с диска
// Параметры:
//		Документ			- ссылка на документ
//		Родитель			- ссылка на файловую папку, в которую будут импортированы файлы и каталоги
//		МассивФайловНаДиске	- массив из значений типа Файл, файлы для импорта
// Пример:
//		aps_РаботаСФайлами.aps_ИмпортФайловИКаталоговСДиска(item, ТекущаяПапка, МассивФайловДляИмпорта);
//
Процедура aps_ИмпортФайловИКаталоговСДиска(Документ, Родитель, МассивФайловНаДиске) Экспорт
	
	Попытка
		ИмпортируемыеФайлы = Новый Массив;
		Для Каждого ФайлНаДиске Из МассивФайловНаДиске Цикл 
			СтруктураДанныхФайла = aps_ПодготовитьСтруктуруДанныхФайла(ФайлНаДиске);
			Если СтруктураДанныхФайла <> Неопределено Тогда 
				ИмпортируемыеФайлы.Добавить(СтруктураДанныхФайла);
			КонецЕсли;
		КонецЦикла;
		
		Если ИмпортируемыеФайлы.Количество() > 0 Тогда 
			Состояние(НСтр("ru = 'Помещение файлов в базу данных...'; en_US = 'Loading files to database...'"));
			aps_РаботаСФайламиСервер.aps_ИмпортФайловИКаталогов(Документ, Родитель, ИмпортируемыеФайлы);
		КонецЕсли;
		
	Исключение
		Сообщить(aps_ПолныеПрава.aps_ПараметрСеанса("aps_ИмяПродукта")+НСтр("ru = 'При выполнении операции произошла ошибка:'; en_US = 'While executing the operation an error occurred:'")+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке()),СтатусСообщения.Внимание);
	КонецПопытки;
	
КонецПроцедуры

// Функция выгружает файлы из базы данных на диск
// Параметры:
//		КаталогВыгрузки		- путь к каталогу на диске, куда будут выгружены файлы
//		МассивФайлов		- массив ссылок на файлы, которые нужно выгрузить
//		ПараметрыВыгрузки	- структура дополнительных параметров
// Возвращаемое значение:
//		Соответствие файлов в базе и полных имен файлов на диске
// Пример:
//		ВыгруженныеФайлы = aps_РаботаСФайлами.aps_ВыгрузкаФайловНаДиск(КаталогВременныхФайлов(), МассивФайлов, ПараметрыВыгрузкиФайла);
//
Функция aps_ВыгрузкаФайловНаДиск(КаталогВыгрузки, МассивФайлов, ПараметрыВыгрузки) Экспорт 
	
	РежимПерезаписи = ПараметрыВыгрузки.РежимПерезаписи;
	
	// соответствие элементов справочника и полных имен файлов на диске после выгрузки
	СоответствиеВыгруженныхФайлов = Новый Соответствие();
	
	МассивФайловДляУстановкиБлокировок = Новый Массив;
	
	Попытка
		Для Каждого ФайлСсылка Из МассивФайлов Цикл
			Состояние(НСтр("ru = 'Обрабатывается файл ""'; en_US = 'Processing the ""'")+Строка(ФайлСсылка)+НСтр("ru = '""...'; en_US = '"" file...'"));
			
			ДанныеФайлаДляВыгрузки = aps_РаботаСФайламиСервер.aps_ПодготовитьСтруктуруДанныхФайлаПоСсылке(ФайлСсылка);
			ОтносительныйПутьКФайлу = Лев(ДанныеФайлаДляВыгрузки.ПолноеИмя, СтрДлина(ДанныеФайлаДляВыгрузки.ПолноеИмя) - СтрДлина(ДанныеФайлаДляВыгрузки.Имя));
			КаталогВыгрузкиФайла = aps_ДобавитьПоследнийСлэш(КаталогВыгрузки) + ОтносительныйПутьКФайлу;
			
			СоздатьКаталог(КаталогВыгрузкиФайла);
			
			ПолноеИмяФайла = КаталогВыгрузкиФайла+ДанныеФайлаДляВыгрузки.Имя;
			Файл = Новый Файл(ПолноеИмяФайла);
			
			СоответствиеВыгруженныхФайлов.Вставить(ФайлСсылка, ПолноеИмяФайла);
			
			Если Файл.Существует() Тогда 
				Если РежимПерезаписи = 4 Тогда
					Продолжить;
				КонецЕсли;
				
				Если РежимПерезаписи <> 2 Тогда
					ФормаПерезаписи=ПолучитьФорму("Обработка.aps_ФайлыДокумента.Форма.ФормаСуществованияФайла", Новый Структура("ПолноеИмяФайла", ПолноеИмяФайла));
					РежимПерезаписи=ФормаПерезаписи.ОткрытьМодально();
					РежимПерезаписи=?(РежимПерезаписи=Неопределено,0,РежимПерезаписи);
					Если РежимПерезаписи = 4 Или РежимПерезаписи = 3 Тогда
						Продолжить;
					КонецЕсли;
				КонецЕсли;
				
				Файл.УстановитьТолькоЧтение(Ложь); // для перезаписи
			КонецЕсли;
			
			Если ДанныеФайлаДляВыгрузки.Зашифрован И ПараметрыВыгрузки.Расшифровать Тогда 
				МенеджерКриптографии = ПараметрыВыгрузки.МенеджерКриптографии;
				Попытка // расшифровать данные и заменить адрес в структуре данных файла
					РасшифрованныеДвоичныеДанные = МенеджерКриптографии.Расшифровать(ДанныеФайлаДляВыгрузки.ДвоичныеДанные);
					ДанныеФайлаДляВыгрузки.ДвоичныеДанные		= РасшифрованныеДвоичныеДанные;
					ДанныеФайлаДляВыгрузки.АдресДвоичныхДанных	= ПоместитьВоВременноеХранилище(РасшифрованныеДвоичныеДанные);
				Исключение
					Сообщить(aps_ПолныеПрава.aps_ПараметрСеанса("aps_ИмяПродукта")+НСтр("ru = 'Не удалось расшифровать файл ""'; en_US = 'Cannot decrypt the ""'")+ДанныеФайлаДляВыгрузки.ПолноеИмя+НСтр("ru = '"".'; en_US = '"" file.'"), СтатусСообщения.Внимание);
				КонецПопытки;
			КонецЕсли;
			
			ВыгружаемыеФайлы = Новый Массив;
			Описание = Новый ОписаниеПередаваемогоФайла(ПолноеИмяФайла, ДанныеФайлаДляВыгрузки.АдресДвоичныхДанных);
			ВыгружаемыеФайлы.Добавить(Описание);
			
			Если ПолучитьФайлы(ВыгружаемыеФайлы,,, Ложь) Тогда 
				Файл = Новый Файл(ПолноеИмяФайла);
				Файл.УстановитьВремяИзменения(ДанныеФайлаДляВыгрузки.ДатаМодификации);
				
				ФайлУжеРедактируется = ЗначениеЗаполнено(ДанныеФайлаДляВыгрузки.Редактируется);
				ВозможностьРедактирования = НЕ ДанныеФайлаДляВыгрузки.Подписан И НЕ ДанныеФайлаДляВыгрузки.Зашифрован
												И ДанныеФайлаДляВыгрузки.ПравоИзменения;
					
				Если ПараметрыВыгрузки.ТолькоЧтение <> Неопределено Тогда 
					Файл.УстановитьТолькоЧтение(ПараметрыВыгрузки.ТолькоЧтение);
					
				ИначеЕсли (ФайлУжеРедактируется И ДанныеФайлаДляВыгрузки.ИдентификаторСессии <> ПараметрыВыгрузки.ИдентификаторСессии) // редактируется в другой сессии
								Или НЕ ВозможностьРедактирования Тогда 
					Файл.УстановитьТолькоЧтение(Истина);
				КонецЕсли;
				
				Если НЕ ФайлУжеРедактируется И ВозможностьРедактирования Тогда 
					МассивФайловДляУстановкиБлокировок.Добавить(ФайлСсылка);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Состояние(НСтр("en_US='Files downloaded.';ru='Выгрузка файлов завершена.'"));
		
		Если ПараметрыВыгрузки.УстановитьБлокировки И МассивФайловДляУстановкиБлокировок.Количество() > 0 Тогда 
			// установить блокировки редактирования файлов
			Состояние(НСтр("ru = 'Установка блокировок редактирования...'; en_US = 'Locking to edit...'"));
			aps_РаботаСФайламиСервер.aps_УстановитьБлокировкиРедактирования(МассивФайловДляУстановкиБлокировок, ПараметрыВыгрузки.ИдентификаторСессии);
		КонецЕсли;
		
		Возврат СоответствиеВыгруженныхФайлов;
		
	Исключение
		Сообщить(aps_ПолныеПрава.aps_ПараметрСеанса("aps_ИмяПродукта")+НСтр("ru = 'При выполнении операции произошла ошибка:'; en_US = 'While executing the operation an error occurred:'")+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке()),СтатусСообщения.Внимание);
	КонецПопытки;
	
	Возврат Неопределено;
	
КонецФункции

// Функция выгружает файлы из базы данных на диск
// Параметры:
//		Нет
// Возвращаемое значение:
//		Структура
// Пример:
//		ПараметрыВыгрузкиФайла = aps_РаботаСФайлами.aps_СформироватьСтруктуруПараметровВыгрузки();
//
Функция aps_СформироватьСтруктуруПараметровВыгрузки() Экспорт 
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ТолькоЧтение"			, Неопределено);
	СтруктураПараметров.Вставить("РежимПерезаписи"		, 0);
	СтруктураПараметров.Вставить("ИдентификаторСессии"	, "");
	СтруктураПараметров.Вставить("УстановитьБлокировки"	, Ложь);
	СтруктураПараметров.Вставить("Расшифровать"			, Ложь);
	СтруктураПараметров.Вставить("МенеджерКриптографии"	, Ложь);
	Возврат СтруктураПараметров;
КонецФункции

#Если Не ВебКлиент И НЕ МобильноеПриложениеКлиент Тогда
	
// Процедура создает zip-архив из файлов на диске
// Параметры:
//		МассивФайловНаДиске	- массив из значений типа Файл, файлы для архивации
//		ПараметрыZipАрхива	- структура параметров zip-архива
// Пример:
//		aps_РаботаСФайлами.aps_АрхивацияФайлов(ВремКаталогАрхивации, СтруктураZipАрхива);
//
Процедура aps_АрхивацияФайлов(КаталогФайловДляАрхивации, ПараметрыZipАрхива) Экспорт 
	
	Попытка
		ZipАрхив = Новый ЗаписьZipФайла(ПараметрыZipАрхива.ПолноеИмяФайла, ПараметрыZipАрхива.Пароль);
		
		Состояние(НСтр("ru = 'Добавление файлов в архив...'; en_US = 'Packing files to archive...'"));
		ZipАрхив.Добавить(КаталогФайловДляАрхивации+"\*.*", РежимСохраненияПутейZIP.СохранятьОтносительныеПути, РежимОбработкиПодкаталоговZIP.ОбрабатыватьРекурсивно);
		ZipАрхив.Записать();
		Состояние(НСтр("ru = 'Архивация файлов завершена.'; en_US = 'Packing files to archive is finished.'"));
		
	Исключение
		Сообщить(aps_ПолныеПрава.aps_ПараметрСеанса("aps_ИмяПродукта")+НСтр("ru = 'При выполнении операции произошла ошибка:'; en_US = 'While executing the operation an error occurred:'")+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке()),СтатусСообщения.Внимание);
	КонецПопытки;
	
КонецПроцедуры

#КонецЕсли

// Функция формирует структуру данных файла на диске для передачи на сервер.
// Рекурсия для каталогов
//
// Параметры:
//		ФайлНаДиске	- значение типа Файл, файл на диске,
//		МассивПолныхИменФайлов (необязательный) - Массив, полные имена файлов, для которых сформировать структуру
// Возвращаемое значение:
//		Структура
// Пример:
//		СтруктураДанныхФайла = aps_ПодготовитьСтруктуруДанныхФайла(ФайлНаДиске, НовыеФайлыДокумента);
//
Функция aps_ПодготовитьСтруктуруДанныхФайла(ФайлНаДиске, МассивПолныхИменФайлов = Неопределено) Экспорт 
	Если Не ФайлНаДиске.Существует() Тогда 
		ВызватьИсключение НСтр("ru = 'Файл ""'; en_US = 'The ""'")+ФайлНаДиске.ПолноеИмя+НСтр("ru = '"" отсутствует на диске'; en_US = '"" file is not found'");
	КонецЕсли;
	
	Если ФайлНаДиске.ЭтоКаталог() Тогда 
		Если МассивПолныхИменФайлов <> Неопределено Тогда 
			// Проверяем, есть ли внутри этого каталога и его подкаталогов нужные файлы
			МассивФайловИКаталогов=НайтиФайлы(ФайлНаДиске.ПолноеИмя, "*.*", Истина);
			Найдено = Ложь;
			Для i=0 По МассивФайловИКаталогов.Количество()-1 Цикл 
				Если МассивПолныхИменФайлов.Найти(МассивФайловИКаталогов[i].ПолноеИмя) <> Неопределено Тогда 
					Найдено = Истина; Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если Не Найдено Тогда 
				Возврат Неопределено; // не импортируем каталог
			КонецЕсли;
		КонецЕсли;
		
		МассивФайловИКаталогов=НайтиФайлы(ФайлНаДиске.ПолноеИмя, "*.*");
		МассивСтруктурФайловИКаталогов=Новый Массив;
		Для i=0 По МассивФайловИКаталогов.Количество()-1 Цикл 
			СтруктураДанныхФайлаВЭтомКаталоге = aps_ПодготовитьСтруктуруДанныхФайла(МассивФайловИКаталогов[i], МассивПолныхИменФайлов);
			Если СтруктураДанныхФайлаВЭтомКаталоге <> Неопределено Тогда 
				МассивСтруктурФайловИКаталогов.Добавить(СтруктураДанныхФайлаВЭтомКаталоге);
			КонецЕсли;
		КонецЦикла;
		
		СтруктураДанныхКаталога = Новый Структура;
		СтруктураДанныхКаталога.Вставить("ИмяБезРасширения"	, ФайлНаДиске.Имя);
		СтруктураДанныхКаталога.Вставить("ФайлыИКаталоги"	, МассивСтруктурФайловИКаталогов);
		
		Возврат СтруктураДанныхКаталога;
		
	Иначе // это файл
		
		Если МассивПолныхИменФайлов <> Неопределено И МассивПолныхИменФайлов.Найти(ФайлНаДиске.ПолноеИмя) = Неопределено Тогда 
			Возврат Неопределено; // не импортируем файл
		КонецЕсли;
		
		Состояние(НСтр("ru = 'Обрабатывается файл ""'; en_US = 'Processing the ""'")+ФайлНаДиске.Имя+НСтр("ru = '"" ('; en_US = '"" file ('")+Строка(ФайлНаДиске.Размер())+НСтр("ru = ' байт)...'; en_US = ' bytes)...'"));
		
		ПомещаемыеФайлы = Новый Массив;
		Описание = Новый ОписаниеПередаваемогоФайла(ФайлНаДиске.ПолноеИмя, "");
		ПомещаемыеФайлы.Добавить(Описание);
		
		ПомещенныеФайлы = Новый Массив;
		Если НЕ ПоместитьФайлы(ПомещаемыеФайлы, ПомещенныеФайлы,, Ложь) Тогда 
			Возврат Неопределено; // отказ
		КонецЕсли;
		
		СтруктураДанныхФайла = Новый Структура;
		СтруктураДанныхФайла.Вставить("ИмяБезРасширения"	, ФайлНаДиске.ИмяБезРасширения);
		СтруктураДанныхФайла.Вставить("ПолноеИмя"			, ФайлНаДиске.ПолноеИмя);
		СтруктураДанныхФайла.Вставить("Расширение"			, ФайлНаДиске.Расширение);
		СтруктураДанныхФайла.Вставить("ДатаМодификации"		, ФайлНаДиске.ПолучитьВремяИзменения());
		СтруктураДанныхФайла.Вставить("ТолькоЧтение"		, ФайлНаДиске.ПолучитьТолькоЧтение());
		СтруктураДанныхФайла.Вставить("Размер"				, ФайлНаДиске.Размер());
		
		СтруктураДанныхФайла.Вставить("АдресДвоичныхДанных"	, ПомещенныеФайлы[0].Хранение);
		
		Возврат СтруктураДанныхФайла;
	КонецЕсли;
КонецФункции


// Функция предназначена для открытия файла соответствующим приложением
// Параметры:
//		СтрокаКоманды - командная строка для запуска приложения либо имя файла, ассоциированного с некоторым приложением
// Пример:
//		aps_РаботаСФайлами.aps_ЗапуститьПриложение(ИмяФайлаСертификата);
//
Процедура aps_ЗапуститьПриложение(Знач СтрокаКоманды) Экспорт 
	Попытка 
		СисИнфо = Новый СистемнаяИнформация;
		Если СисИнфо.ТипПлатформы = ТипПлатформы.Windows_x86 ИЛИ СисИнфо.ТипПлатформы = ТипПлатформы.Windows_x86_64 Тогда
			СтрокаКоманды = СтрЗаменить(СтрокаКоманды, "/", "\");
		КонецЕсли;	
		
		ЗапуститьПриложение(СтрокаКоманды);
	Исключение
		Предупреждение(ИнформацияОбОшибке().Описание);
	КонецПопытки;
КонецПроцедуры // aps_ЗапуститьПриложение()

#КонецОбласти


#Область CheckOut

// Процедура завершает сессию редактирования файлов документа без сохранения изменений
//
// Параметры:
//		ИдентификаторСессии	- Строка, идентификатор сессии редактирования
//		КаталогСессии		- Строка, путь к каталогу данной сессии редактирования
// Пример:
//		aps_РаботаСФайлами.aps_ОтменитьИзмененияРедактирования(ИдентификаторСессии, КаталогСессии);
//
Процедура aps_ОтменитьИзмененияРедактирования(ИдентификаторСессии, КаталогСессии) Экспорт 
	
	СисИнфо = Новый СистемнаяИнформация();
	Если Найти(ИдентификаторСессии, Строка(СисИнфо.ИдентификаторКлиента)) = 0
			И Вопрос(НСтр("ru = 'Возможно, этот документ был взят на редактирование на другом компьютере!'; en_US = 'This document may be taken to edit on the other computer!'")+Символы.ПС+
						НСтр("ru = 'Вы действительно хотите отменить изменения?'; en_US = 'Do you really want to cancel changes?'"),РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	МассивРедактируемыхДокументов = Новый Массив;
	МассивРедактируемыхФайлов = aps_РаботаСФайламиСервер.aps_ПолучитьРедактируемыеФайлы(ИдентификаторСессии, МассивРедактируемыхДокументов);
	Если МассивРедактируемыхДокументов.Количество() > 1 
			И Вопрос(НСтр("ru = 'В текущей сессии редактируются файлы нескольких документов. Отменить изменения всех файлов?'; en_US = 'Files of several documents are edited in the current session. Cancel changes of all files?'"),РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Нет Тогда 
		Возврат;
	КонецЕсли;
	
	Попытка
		Состояние(НСтр("Снятие блокировок редактирования..."));
		aps_РаботаСФайламиСервер.aps_СнятьБлокировкиРедактирования(МассивРедактируемыхФайлов);
		
		Состояние("ru = 'Удаление каталога сессии редактирования...'; en_US = 'Deleting directory of editing session...'");
		Попытка
			УдалитьФайлы(КаталогСессии);
		Исключение
		КонецПопытки;

		Состояние(НСтр("ru = 'Редактирование завершено.'; en_US = 'Editing is finished.'"));
		
	Исключение
		Сообщить(aps_ПолныеПрава.aps_ПараметрСеанса("aps_ИмяПродукта")+НСтр("ru = 'При выполнении операции произошла ошибка:'; en_US = 'While executing the operation an error occurred:'")+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке()),СтатусСообщения.Внимание);
	КонецПопытки;
			
КонецПроцедуры

// Процедура завершает сессию редактирования файлов документа с сохранением изменений
//
// Параметры:
//		ИдентификаторСессии		- Строка, идентификатор сессии редактирования
//		КаталогСессии			- Строка, путь к каталогу данной сессии редактирования
//		ЗакончитьРедактирование	- Булево, завершение сессии редактирования
// Пример:
//		aps_РаботаСФайлами.aps_СохранитьИзмененияРедактирования(ИдентификаторСессии, КаталогСессии, Кнопка.Имя = "Сохранить");
//
Процедура aps_СохранитьИзмененияРедактирования(ИдентификаторСессии, КаталогСессии, ЗакончитьРедактирование = Ложь, СохранитьРевизией = Ложь) Экспорт 
	СисИнфо = Новый СистемнаяИнформация();
	Если Найти(ИдентификаторСессии, Строка(СисИнфо.ИдентификаторКлиента)) = 0
			И Вопрос(НСтр("ru = 'Возможно, этот документ был взят на редактирование на другом компьютере!'; en_US = 'This document may be taken to edit on the other computer!'")+Символы.ПС+
						НСтр("ru = 'Вы действительно хотите сохранить изменения?'; en_US = 'Do you really want to save changes?'"),РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	КаталогСессииНаДиске = Новый Файл(КаталогСессии);
	Если НЕ КаталогСессииНаДиске.Существует() Тогда 
		Предупреждение(НСтр("ru = 'Каталог ""'; en_US = 'The ""'")+КаталогСессии+НСтр("ru = '"" не обнаружен на данном компьютере!'; en_US = '"" directory is not found on this computer!'"));
		Возврат;
	КонецЕсли;
	
	МассивРедактируемыхДокументов = Новый Массив;
	МассивРедактируемыхФайлов = aps_РаботаСФайламиСервер.aps_ПолучитьРедактируемыеФайлы(ИдентификаторСессии, МассивРедактируемыхДокументов);
	Если МассивРедактируемыхДокументов.Количество() > 1 
			И Вопрос(НСтр("ru = 'В текущей сессии редактируются файлы нескольких документов. Сохранить изменения всех файлов?'; en_US = 'Files of several documents are edited in the current session. Save changes of all files?'"),РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Нет Тогда 
		Возврат;
	КонецЕсли;
	
	//////////////////////////////////////////////
	// поиск новых файлов
	
	Состояние(НСтр("ru = 'Сканирование каталога сессии редактирования...'; en_US = 'Scanning directory of editing session...'"));
	
	МассивСтруктурРедактируемыхФайлов = Новый Массив;
	Для Каждого ФайлВБазе Из МассивРедактируемыхФайлов Цикл 
		ДанныеФайлаВБазе = Новый Структура("Имя, ПолноеИмя, ДатаМодификации, Размер, АдресДвоичныхДанных");
		aps_РаботаСФайламиСервер.aps_ПодготовитьСтруктуруДанныхФайлаПоСсылке(ФайлВБазе, ДанныеФайлаВБазе);
		МассивСтруктурРедактируемыхФайлов.Добавить(ДанныеФайлаВБазе);
	КонецЦикла;

	НовыеФайлы = Новый Массив;
	Исключения = aps_РаботаСФайламиСервер.aps_ПолучитьИсключенияПриПомещенииФайлов();
	
	МассивФайловНаДиске = НайтиФайлы(КаталогСессии, "*.*", Истина);
	Для Каждого ФайлНаДиске Из МассивФайловНаДиске Цикл 
		Если ФайлНаДиске.ЭтоКаталог() Тогда 
			Продолжить;
		КонецЕсли;
		
		ЭтоРедактируемыйФайл = Ложь;
		Для Каждого ДанныеФайлаВБазе Из МассивСтруктурРедактируемыхФайлов Цикл 
			Если ФайлНаДиске.ПолноеИмя = КаталогСессии + ДанныеФайлаВБазе.ПолноеИмя Тогда 
				ЭтоРедактируемыйФайл = Истина; Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ЭтоРедактируемыйФайл Тогда 
			Продолжить;
		КонецЕсли;
		
		ЭтоИсключение = Ложь;
		Для Каждого СтрокаИсключения Из Исключения Цикл 
			Если Найти(ФайлНаДиске.Расширение, СтрокаИсключения) > 0
					ИЛИ Найти(ФайлНаДиске.Путь, СтрокаИсключения) > 0
					ИЛИ Найти(ФайлНаДиске.ПолноеИмя, СтрокаИсключения) > 0 Тогда 
				ЭтоИсключение = Истина; Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ЭтоИсключение Тогда 
			Продолжить;
		КонецЕсли;

		НовыеФайлы.Добавить(ФайлНаДиске.ПолноеИмя);
	КонецЦикла;
	
	
	ДокументыИФайлыДляИмпорта = Новый Соответствие;
	
	Если НовыеФайлы.Количество() > 0 Тогда 
		// открыть форму списка новых файлов
		ПараметрыФормы = Новый Структура();
		ПараметрыФормы.Вставить("СписокДокументов"	, МассивРедактируемыхДокументов);
		ПараметрыФормы.Вставить("СписокФайлов"		, НовыеФайлы);
		ПараметрыФормы.Вставить("ВКаталоге"			, КаталогСессии);
		ДокументыИФайлыДляИмпорта = ОткрытьФормуМодально("Обработка.aps_ФайлыДокумента.Форма.ФормаНовыхФайлов", ПараметрыФормы);
		Если ДокументыИФайлыДляИмпорта = Неопределено Тогда 
			Возврат;
		КонецЕсли;
		
		Для Каждого РедактируемыйДокумент Из МассивРедактируемыхДокументов Цикл 
			НовыеФайлыДокумента = ДокументыИФайлыДляИмпорта.Получить(РедактируемыйДокумент);
			Если НовыеФайлыДокумента = Неопределено Тогда 
				Продолжить; // для данного документа нет новых файлов
			КонецЕсли;
			
			// структура данных новых файлов и каталогов для текущего документа
			МассивСтруктурНовыхФайлов = Новый Массив;
			МассивФайловНаДиске = НайтиФайлы(КаталогСессии, "*.*");
			Для Каждого ФайлНаДиске Из МассивФайловНаДиске Цикл
				СтруктураДанныхФайла = aps_ПодготовитьСтруктуруДанныхФайла(ФайлНаДиске, НовыеФайлыДокумента);
				Если СтруктураДанныхФайла <> Неопределено Тогда 
					МассивСтруктурНовыхФайлов.Добавить(СтруктураДанныхФайла);
				КонецЕсли;
			КонецЦикла;
			
			ДокументыИФайлыДляИмпорта.Вставить(РедактируемыйДокумент, МассивСтруктурНовыхФайлов);
		КонецЦикла;
	КонецЕсли;
	
	//////////////////////////////////////////////
	// получить измененные и удаленные файлы
	
	МассивФайловДляСнятияБлокировок	= Новый Массив;
	МассивСтруктурИзмененныхФайлов	= Новый Массив;
	Для Каждого ДанныеФайлаВБазе Из МассивСтруктурРедактируемыхФайлов Цикл
		ФайлВБазе	= ДанныеФайлаВБазе.Ссылка;
		ФайлНаДиске	= Новый Файл(КаталогСессии + ДанныеФайлаВБазе.ПолноеИмя);
		Если ФайлНаДиске.Существует() Тогда 
			Если ФайлНаДиске.ПолучитьВремяИзменения() <> ДанныеФайлаВБазе.ДатаМодификации 
											Или ФайлНаДиске.Размер() <> ДанныеФайлаВБазе.Размер Тогда
				// структура измененного файла
				ДанныеФайлаНаДиске = aps_ПодготовитьСтруктуруДанныхФайла(ФайлНаДиске);
				ЗаполнитьЗначенияСвойств(ДанныеФайлаВБазе, ДанныеФайлаНаДиске);
				МассивСтруктурИзмененныхФайлов.Добавить(ДанныеФайлаВБазе);
			КонецЕсли;
			
			МассивФайловДляСнятияБлокировок.Добавить(ФайлВБазе);
			
		ИначеЕсли ЗакончитьРедактирование Тогда 
			ДанныеФайлаВБазе.Вставить("Удален", Истина);
			МассивСтруктурИзмененныхФайлов.Добавить(ДанныеФайлаВБазе);
			
			Если СохранитьРевизией Тогда // файл будет удален у ревизии
				МассивФайловДляСнятияБлокировок.Добавить(ФайлВБазе);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	
	Попытка
		Состояние(НСтр("ru = 'Помещение изменений в базу данных...'; en_US = 'Saving changes to database...'"));
		Если СохранитьРевизией Тогда 
			aps_РаботаСФайламиСервер.aps_СохранитьИзмененияРедактированияВБДРевизией( МассивСтруктурИзмененныхФайлов, ДокументыИФайлыДляИмпорта );
		Иначе 
			МассивФайловДляУстановкиБлокировок = Новый Массив();
			aps_РаботаСФайламиСервер.aps_СохранитьИзмененияРедактированияВБД( МассивСтруктурИзмененныхФайлов, ДокументыИФайлыДляИмпорта, МассивФайловДляУстановкиБлокировок );
		КонецЕсли;
		
		Если ЗакончитьРедактирование Тогда
			//////////////////////////////////////////////////////////////////////
			// снять блокировки и удалить файлы данной сессии из рабочего каталога
			
			Состояние(НСтр("ru = 'Снятие блокировок редактирования...'; en_US = 'Unlocking to edit...'"));
			aps_РаботаСФайламиСервер.aps_СнятьБлокировкиРедактирования(МассивФайловДляСнятияБлокировок);
			
			Состояние(НСтр("ru = Удаление каталога сессии редактирования...'; en_US = 'Deleting directory of editing session...'"));
			Попытка
				УдалитьФайлы(КаталогСессии);
			Исключение
			КонецПопытки;
			
			Состояние(НСтр("ru = 'Редактирование завершено.'; en_US = 'Editing is finished.'"));
			
		ИначеЕсли МассивФайловДляУстановкиБлокировок <> Неопределено 
					И МассивФайловДляУстановкиБлокировок.Количество() > 0 Тогда // заблокировать помещенные файлы
			Состояние(НСтр("ru = 'Установка блокировок редактирования новых файлов...'; en_US = 'Locking new files to edit...'"));
			aps_РаботаСФайламиСервер.aps_УстановитьБлокировкиРедактирования(МассивФайловДляУстановкиБлокировок, ИдентификаторСессии);
		КонецЕсли;
		
	Исключение
		Сообщить(aps_ПолныеПрава.aps_ПараметрСеанса("aps_ИмяПродукта")+НСтр("ru = 'При выполнении операции произошла ошибка:'; en_US = 'While executing the operation an error occurred:'")+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке()),СтатусСообщения.Внимание);
	КонецПопытки;

КонецПроцедуры

#КонецОбласти


#Область КриптографияКлиент

#Если Не ВебКлиент И НЕ МобильноеПриложениеКлиент Тогда
// Возвращает менеджер криптографии с заданными настройками
// Параметры:
//		СтруктураПараметров - структура параметров менеджера криптографии
// Возвращаемое значение:
//		Менеджер криптографии
// Пример:
//		МенеджерКриптографии = aps_РаботаСФайлами.aps_ПолучитьМенеджерКриптографии(ПараметрыКриптографии);	
//
Функция aps_ПолучитьМенеджерКриптографии(СтруктураПараметров) Экспорт 
	Попытка
		МенеджерКриптографии = Новый МенеджерКриптографии(СтруктураПараметров.Криптопровайдер, "", СтруктураПараметров.ТипКриптопровайдера);
		МенеджерКриптографии.ПарольДоступаКЗакрытомуКлючу = СтруктураПараметров.ПарольКЗакрытомуКлючу;
		Возврат МенеджерКриптографии;
	Исключение
		Предупреждение(НСтр("ru = 'Модуль криптографии не найден!'; en_US = 'Cryptography module is not found!'"));
	КонецПопытки;
	
	Возврат Неопределено;
КонецФункции
#КонецЕсли

// Формирует и возвращает структуру данных подписи
// Параметры:
//		МенеджерКриптографии - менеджер криптографии
//		СертификатЭЦП - сертификат криптографии
//		ДвоичныеДанныеФайла - двоичные данные
// Возвращаемое значение:
//		структура
// Пример:
//		СтруктураПодписи = aps_РаботаСФайлами.aps_СформироватьПодпись(МенеджерКриптографии, СертификатЭЦП, СтруктураДанныхФайла.ДвоичныеДанные);
//
Функция aps_СформироватьПодпись(МенеджерКриптографии, СертификатЭЦП, ДвоичныеДанныеФайла) Экспорт
	
	ДвоичныеДанныеПодписи = МенеджерКриптографии.Подписать(ДвоичныеДанныеФайла, СертификатЭЦП);
	
	УстановившийПодпись = aps_ПолныеПрава.aps_ПараметрСеанса("ТекущийПользователь");
	КомуВыданСертификат = aps_ПредставлениеПользователяСертификата(СертификатЭЦП.Субъект);
	
	СтруктураДанныхПодписи = Новый Структура;
	СтруктураДанныхПодписи.Вставить("ДатаПодписи"			, ТекущаяДата());
	СтруктураДанныхПодписи.Вставить("АвторПодписи"			, УстановившийПодпись);
	СтруктураДанныхПодписи.Вставить("ДвоичныеДанные"		, ДвоичныеДанныеПодписи);
	
	СтруктураДанныхПодписи.Вставить("КомуВыданСертификат"	, КомуВыданСертификат);
	
	Возврат СтруктураДанныхПодписи;	
	
КонецФункции

// Формирует подпись файла и добавляет к двоичным данным
// Параметры:
//		МенеджерКриптографии - менеджер криптографии
//		СертификатЭЦП - сертификат криптографии
//		ФайлСсылка - СправочникСсылка.aps_Файлы
// Возвращаемое значение:
//		булево
// Пример:
//		ФайлПодписанСертификатом = aps_РаботаСФайлами.aps_ФайлУжеПодписан(МенеджерКриптографии, СертификатЭЦП, ФайлСсылка);
//
Функция aps_ФайлУжеПодписан(МенеджерКриптографии, СертификатЭЦП, ФайлСсылка) Экспорт

	Подписи = aps_РаботаСФайламиСервер.aps_ПолучитьВсеЭЦПФайла(ФайлСсылка);
	Для Каждого Подпись Из Подписи Цикл
		СертификатыПодписей = МенеджерКриптографии.ПолучитьСертификатыИзПодписи(Подпись.ДвоичныеДанные);
		Если СертификатыПодписей.Количество() > 0 И СертификатЭЦП = СертификатыПодписей[0] Тогда 
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;	
	
КонецФункции

// Процедура подписи нескольких файлов
// Параметры:
//		МенеджерКриптографии - менеджер криптографии
//		СертификатЭЦП - сертификат криптографии
//		МассивФайлов - массив ссылок на файлы
// Пример:
//		aps_РаботаСФайлами.aps_ПодписатьНесколькоФайлов(МенеджерКриптографии, СертификатДляПодписи, ФайлыДокумента);
//
Процедура aps_ПодписатьНесколькоФайлов(МенеджерКриптографии, СертификатЭЦП, МассивФайлов) Экспорт
	
	СформированныеПодписи = Новый Соответствие;
	
	Попытка
		Для Каждого ФайлСсылка Из МассивФайлов Цикл 
			Состояние(НСтр("ru = 'Обрабатывается файл ""'; en_US = 'Processing the ""'")+Строка(ФайлСсылка)+НСтр("ru = '""...'; en_US = '"" file...'"));
			
			// проверяем, что этим сертификатом файл еще не подписан
			Если aps_РаботаСФайлами.aps_ФайлУжеПодписан(МенеджерКриптографии, СертификатЭЦП, ФайлСсылка) Тогда 
				Продолжить;
			КонецЕсли;
			
			СтруктураДанныхФайла = Новый Структура("ДвоичныеДанные, Зашифрован");
			aps_РаботаСФайламиСервер.aps_ПодготовитьСтруктуруДанныхФайлаПоСсылке(ФайлСсылка, СтруктураДанныхФайла);
			Если СтруктураДанныхФайла.Зашифрован Тогда 
				Сообщить(НСтр("ru = 'Файл ""'; en_US = 'The ""'")+Строка(ФайлСсылка)+НСтр("ru = '"" зашифрован. Подписать файл нельзя!'; en_US = '"" file is encrypted. It is impossible to sign the file!'"));
				Продолжить;
			КонецЕсли;
			
			СтруктураПодписи = aps_РаботаСФайлами.aps_СформироватьПодпись(МенеджерКриптографии, СертификатЭЦП, СтруктураДанныхФайла.ДвоичныеДанные);
			СформированныеПодписи.Вставить(ФайлСсылка, СтруктураПодписи);
		КонецЦикла;
		
		Состояние(НСтр("ru = 'Добавление сформированных подписей к файлам...'; en_US = 'Adding formed signatures to files...'"));
		aps_РаботаСФайламиСервер.aps_ДобавитьДанныеЭЦПДляНесколькихФайлов(СформированныеПодписи);
	Исключение
		Сообщить(aps_ПолныеПрава.aps_ПараметрСеанса("aps_ИмяПродукта")
			+НСтр("ru = 'Не удалось подписать файлы по причине:'; en_US = 'Cannot sign files because:'")+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), СтатусСообщения.Внимание);
		Возврат;
	КонецПопытки;
	
	Состояние(НСтр("ru = 'Процесс подписи файлов завершен.'; en_US = 'Files signing is finished!'"));
	
КонецПроцедуры

// Процедура шифрования нескольких файлов
// Параметры:
//		МенеджерКриптографии - менеджер криптографии
//		МассивФайлов - массив ссылок на файлы
// Пример:	
//		aps_РаботаСФайлами.aps_ЗашифроватьНесколькоФайлов(МенеджерКриптографии, ФайлыДокумента);
//
Процедура aps_ЗашифроватьНесколькоФайлов(МенеджерКриптографии, МассивФайлов) Экспорт
	
	ФормаВыбораСертификатов = ПолучитьФорму("Обработка.aps_ФайлыДокумента.Форма.ФормаВыбораСертификатов");
	СертификатыПолучателей = ФормаВыбораСертификатов.ОткрытьМодально();
	Если СертификатыПолучателей = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	МассивСтруктурСертификатов = aps_РаботаСФайлами.aps_СформироватьМассивСтруктурСертификатов(СертификатыПолучателей);
	
	ДанныеШифрования = Новый Соответствие;
	
	Попытка
		Для Каждого ФайлСсылка Из МассивФайлов Цикл 
			Состояние(НСтр("ru = 'Обрабатывается файл ""'; en_US = 'Processing the ""'")+Строка(ФайлСсылка)+НСтр("ru = '""...'; en_US = '"" file...'"));
			
			СтруктураДанныхФайла = Новый Структура("ДвоичныеДанные");
			aps_РаботаСФайламиСервер.aps_ПодготовитьСтруктуруДанныхФайлаПоСсылке(ФайлСсылка, СтруктураДанныхФайла);

			ЗашифрованныеДвоичныеДанные = МенеджерКриптографии.Зашифровать(СтруктураДанныхФайла.ДвоичныеДанные, СертификатыПолучателей);
			ДанныеШифрования.Вставить(ФайлСсылка, ЗашифрованныеДвоичныеДанные);
		КонецЦикла;
		
		Состояние(НСтр("ru = 'Выполняется шифрование файлов...'; en_US = 'Encrypting files...'"));
		aps_РаботаСФайламиСервер.aps_ИзменитьДанныеШифрованияДляНесколькихФайлов(ДанныеШифрования, МассивСтруктурСертификатов);
	Исключение
		Сообщить(aps_ПолныеПрава.aps_ПараметрСеанса("aps_ИмяПродукта")
			+НСтр("ru = 'Не удалось зашифровать файлы по причине:'; en_US = 'Cannot encrypt files because:'")+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), СтатусСообщения.Внимание);
		Возврат;
	КонецПопытки;
	
	Состояние(НСтр("ru = 'Шифрование файлов завершено.'; en_US = 'Files encrypting is finished.'"));
	
КонецПроцедуры

// Процедура расшифровки нескольких файлов
// Параметры:
//		МенеджерКриптографии - менеджер криптографии
//		МассивФайлов - массив ссылок на файлы
// Пример:
//      aps_РаботаСФайлами.aps_РасшифроватьНесколькоФайлов(МенеджерКриптографии, ФайлыДокумента);
Процедура aps_РасшифроватьНесколькоФайлов(МенеджерКриптографии, МассивФайлов) Экспорт
	
	МассивСтруктурСертификатов = Новый Массив;
	
	ДанныеШифрования = Новый Соответствие;
	
	Попытка
		Для Каждого ФайлСсылка Из МассивФайлов Цикл 
			Состояние(НСтр("ru = 'Обрабатывается файл ""'; en_US = 'Processing the ""'")+Строка(ФайлСсылка)+НСтр("ru = '""...'; en_US = '"" file...'"));
			
			СтруктураДанныхФайла = Новый Структура("ДвоичныеДанные");
			aps_РаботаСФайламиСервер.aps_ПодготовитьСтруктуруДанныхФайлаПоСсылке(ФайлСсылка, СтруктураДанныхФайла);

			РасшифрованныеДвоичныеДанные = МенеджерКриптографии.Расшифровать(СтруктураДанныхФайла.ДвоичныеДанные);
			ДанныеШифрования.Вставить(ФайлСсылка, РасшифрованныеДвоичныеДанные);
		КонецЦикла;
		
		Состояние(НСтр("ru = 'Выполняется расшифровка файлов...'; en_US = 'Decrypting files...'"));
		aps_РаботаСФайламиСервер.aps_ИзменитьДанныеШифрованияДляНесколькихФайлов(ДанныеШифрования, МассивСтруктурСертификатов);
	Исключение
		Сообщить(aps_ПолныеПрава.aps_ПараметрСеанса("aps_ИмяПродукта")
			+НСтр("ru = 'Не удалось расшифровать файлы по причине:'; en_US = 'Cannot decrypt files because:'")+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), СтатусСообщения.Внимание);
		Возврат;
	КонецПопытки;
	
	Состояние(НСтр("ru = 'Расшифровка файлов завершена.'; en_US = 'Files decrypting is finished.'"));
	
КонецПроцедуры

#КонецОбласти


