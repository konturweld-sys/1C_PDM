#Область КриптографияСервер

// Формирует строковое представление сертификата
// Параметры:
//		Сертификат - сертификат криптографии
//		СоСрокомДействия - булево (необязательный)
// Возвращаемое значение:
//		строка
// Пример:
//      ПредставлениеСертификата = aps_РаботаСФайлами.aps_ПредставлениеСертификата(СертификатПодписи);
//
Функция aps_ПредставлениеСертификата(Сертификат, СоСрокомДействия = Ложь) Экспорт 
	ПредставлениеСубъекта = aps_ПредставлениеПользователяСертификата(Сертификат.Субъект);
	ПредставлениеИздателя = aps_ПредставлениеПользователяСертификата(Сертификат.Издатель);
	
	Представление = ПредставлениеСубъекта+НСтр("ru = ', выдан '; en_US = ', issued by '")+ПредставлениеИздателя;
	
	Если СоСрокомДействия Тогда 
		Представление = Представление+НСтр("ru = ', действителен до '; en_US = ', valid until '")+Формат(Сертификат.ДатаОкончания, "ДФ=dd.MM.yyyy");
	КонецЕсли;
	Возврат Представление;
КонецФункции

// Формирует строковое представление пользователя сертификата
// Параметры:
//		СтруктураПользователя - структура
// Возвращаемое значение:
//      строка
// Пример:
//      ПредставлениеСубъекта = aps_ПредставлениеПользователяСертификата(Сертификат.Субъект);
//
Функция aps_ПредставлениеПользователяСертификата(СтруктураПользователя) Экспорт
	Представление = "";
	CN = "";
	Если СтруктураПользователя.Свойство("CN", CN) Тогда
		Представление = Представление + CN;
	КонецЕсли;	
	Org = "";
	Если СтруктураПользователя.Свойство("O", Org) Тогда
		Представление = Представление + ", " + Org;
	КонецЕсли;	
	OU = "";
	Если СтруктураПользователя.Свойство("OU", OU) Тогда
		Представление = Представление + ", " + OU;
	КонецЕсли;	
	
	Возврат Представление;
КонецФункции

// Формирует массив структур сертификатов шифрования для сохранения в файл
// Параметры:
//		МассивСертификатов - массив
// Возвращаемое значение:
//		массив
// Пример:
//      МассивСтруктурСертификатов = aps_РаботаСФайлами.aps_СформироватьМассивСтруктурСертификатов(СертификатыПолучателей);
//
Функция aps_СформироватьМассивСтруктурСертификатов(МассивСертификатов) Экспорт 
	МассивСтруктурСертификатов = Новый Массив;
	Для Каждого Сертификат Из МассивСертификатов Цикл
		СтруктураСертификата = Новый Структура;
		СтруктураСертификата.Вставить("Представление"	, aps_ПредставлениеСертификата(Сертификат));
		СтруктураСертификата.Вставить("ДвоичныеДанные"	, Сертификат.Выгрузить());
		МассивСтруктурСертификатов.Добавить(СтруктураСертификата);
	КонецЦикла;
	
	Возврат МассивСтруктурСертификатов;
КонецФункции

#КонецОбласти




