#Если НЕ МобильноеПриложениеСервер Тогда
	
#Область ПрограммныйИнтерфейс	
	
// Получает спецификации действующие для указанных подразделения, номенклатуры на дату начала производства
// Спецификация является действующей, если
//  - у нее статус Действует
//  - период ее действия включает начало производства
//
// Параметры
//  НачалоПроизводства	- Дата - дата начала производства, на эту дату спецификация должна быть действующей
//  Номенклатура		- СправочникСсылка.Номенклатура - производимое изделие
//  Характеристика		- СправочникСсылка.ХарактеристикиНоменклатуры - характеристика производимого изделия
//  Подразделение		- СправочникСсылка.СтруктураПредприятия - подразделение за которым закреплено обеспечение изделием (необязательный)
//  СтрокаПоиска		- Строка - строка, содержащаяся в наименовании (необязательный)
//
// Возвращаемое значение:
//   СписокЗначений - свойства, которые можно использовать для автовыбора
//
// Пример:
//	 ДействующиеСпецификации = ПолучитьСписокДействующихСпецификаций(Номенклатура, Характеристика, НачалоПроизводства);
//
Функция ПолучитьСписокДействующихСпецификаций(Номенклатура, Характеристика, НачалоПроизводства, Подразделение = Неопределено, СтрокаПоиска = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	РесурсныеСпецификацииВыходныеИзделия.Ссылка КАК Спецификация,
	               |	РесурсныеСпецификацииВыходныеИзделия.Ссылка.Представление КАК СпецификацияПредставление,
	               |	МАКСИМУМ(ВЫБОР
	               |			КОГДА ЕСТЬNULL(ОсновныеСпецификацииНоменклатураХарактеристикаПодразделение.Спецификация, ЕСТЬNULL(ОсновныеСпецификацииНоменклатураХарактеристика.Спецификация, ЕСТЬNULL(ОсновныеСпецификацииНоменклатураПодразделение.Спецификация, ЕСТЬNULL(ОсновныеСпецификацииНоменклатура.Спецификация, ЗНАЧЕНИЕ(Справочник.РесурсныеСпецификации.ПустаяСсылка))))) <> ЗНАЧЕНИЕ(Справочник.РесурсныеСпецификации.ПустаяСсылка)
	               |				ТОГДА ИСТИНА
	               |			ИНАЧЕ ЛОЖЬ
	               |		КОНЕЦ) КАК Основная,
	               |	МАКСИМУМ(ВЫБОР
	               |			КОГДА НЕ ОсновныеСпецификацииНоменклатураХарактеристикаПодразделение.Спецификация ЕСТЬ NULL 
	               |				ТОГДА 0
	               |			КОГДА НЕ ОсновныеСпецификацииНоменклатураХарактеристика.Спецификация ЕСТЬ NULL 
	               |				ТОГДА 1
	               |			КОГДА НЕ ОсновныеСпецификацииНоменклатураПодразделение.Спецификация ЕСТЬ NULL 
	               |				ТОГДА 2
	               |			КОГДА НЕ ОсновныеСпецификацииНоменклатура.Спецификация ЕСТЬ NULL 
	               |				ТОГДА 3
	               |			ИНАЧЕ 100
	               |		КОНЕЦ) КАК ПриоритетОсновная,
	               |	РесурсныеСпецификацииВыходныеИзделия.Ссылка.МногоэтапныйПроизводственныйПроцесс КАК МногоэтапныйПроизводственныйПроцесс,
	               |	РесурсныеСпецификацииВыходныеИзделия.Ссылка.ОптимальноеКоличествоПередачиМеждуЭтапами КАК ОптимальноеКоличествоПередачиМеждуЭтапами
	               |ИЗ
	               |	Справочник.РесурсныеСпецификации.ВыходныеИзделия КАК РесурсныеСпецификацииВыходныеИзделия
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОсновныеСпецификации КАК ОсновныеСпецификацииНоменклатураХарактеристикаПодразделение
	               |		ПО (ОсновныеСпецификацииНоменклатураХарактеристикаПодразделение.Спецификация = РесурсныеСпецификацииВыходныеИзделия.Ссылка)
	               |			И (ОсновныеСпецификацииНоменклатураХарактеристикаПодразделение.Номенклатура = &Номенклатура)
	               |			И (ОсновныеСпецификацииНоменклатураХарактеристикаПодразделение.Характеристика = &Характеристика)
	               |			И (ОсновныеСпецификацииНоменклатураХарактеристикаПодразделение.Подразделение = &Подразделение)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОсновныеСпецификации КАК ОсновныеСпецификацииНоменклатураХарактеристика
	               |		ПО (ОсновныеСпецификацииНоменклатураХарактеристика.Спецификация = РесурсныеСпецификацииВыходныеИзделия.Ссылка)
	               |			И (ОсновныеСпецификацииНоменклатураХарактеристика.Номенклатура = &Номенклатура)
	               |			И (ОсновныеСпецификацииНоменклатураХарактеристика.Характеристика = &Характеристика)
	               |			И (ОсновныеСпецификацииНоменклатураХарактеристика.Подразделение = ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка))
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОсновныеСпецификации КАК ОсновныеСпецификацииНоменклатураПодразделение
	               |		ПО (ОсновныеСпецификацииНоменклатураПодразделение.Спецификация = РесурсныеСпецификацииВыходныеИзделия.Ссылка)
	               |			И (ОсновныеСпецификацииНоменклатураПодразделение.Номенклатура = &Номенклатура)
	               |			И (ОсновныеСпецификацииНоменклатураПодразделение.Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка))
	               |			И (ОсновныеСпецификацииНоменклатураПодразделение.Подразделение = &Подразделение)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОсновныеСпецификации КАК ОсновныеСпецификацииНоменклатура
	               |		ПО (ОсновныеСпецификацииНоменклатура.Спецификация = РесурсныеСпецификацииВыходныеИзделия.Ссылка)
	               |			И (ОсновныеСпецификацииНоменклатура.Номенклатура = &Номенклатура)
	               |			И (ОсновныеСпецификацииНоменклатура.Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка))
	               |			И (ОсновныеСпецификацииНоменклатура.Подразделение = ЗНАЧЕНИЕ(Справочник.СтруктураПредприятия.ПустаяСсылка))
	               |ГДЕ
	               |	РесурсныеСпецификацииВыходныеИзделия.Ссылка.Статус = ЗНАЧЕНИЕ(Перечисление.СтатусыСпецификаций.Действует)
	               |	И РесурсныеСпецификацииВыходныеИзделия.Номенклатура = &Номенклатура
	               |	И (РесурсныеСпецификацииВыходныеИзделия.Характеристика = &Характеристика
	               |			ИЛИ РесурсныеСпецификацииВыходныеИзделия.Характеристика = ЗНАЧЕНИЕ(Справочник.ХарактеристикиНоменклатуры.ПустаяСсылка))
	               |	И (РесурсныеСпецификацииВыходныеИзделия.Ссылка.НачалоДействия = ДАТАВРЕМЯ(1, 1, 1)
	               |			ИЛИ РесурсныеСпецификацииВыходныеИзделия.Ссылка.НачалоДействия <= &НачалоПроизводства
	               |			ИЛИ &НачалоПроизводства = ДАТАВРЕМЯ(1, 1, 1))
	               |	И (РесурсныеСпецификацииВыходныеИзделия.Ссылка.КонецДействия = ДАТАВРЕМЯ(1, 1, 1)
	               |			ИЛИ РесурсныеСпецификацииВыходныеИзделия.Ссылка.КонецДействия > &НачалоПроизводства
	               |			ИЛИ &НачалоПроизводства = ДАТАВРЕМЯ(1, 1, 1))
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	РесурсныеСпецификацииВыходныеИзделия.Ссылка,
	               |	РесурсныеСпецификацииВыходныеИзделия.Ссылка.Представление,
	               |	РесурсныеСпецификацииВыходныеИзделия.Ссылка.МногоэтапныйПроизводственныйПроцесс,
	               |	РесурсныеСпецификацииВыходныеИзделия.Ссылка.ОптимальноеКоличествоПередачиМеждуЭтапами
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ПриоритетОсновная,
	               |	СпецификацияПредставление";
				   
	Если СтрокаПоиска <> Неопределено Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "//СтрокаПоиска", "И РесурсныеСпецификацииВыходныеИзделия.Ссылка.Наименование ПОДОБНО &Текст");
		Запрос.УстановитьПараметр("Текст", "%" + СокрЛП(СтрокаПоиска) + "%");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Номенклатура",       Номенклатура);
	Запрос.УстановитьПараметр("Характеристика",     Характеристика);
	Запрос.УстановитьПараметр("НачалоПроизводства", НачалоПроизводства);
	Запрос.УстановитьПараметр("Подразделение",      ?(Подразделение <> Неопределено, Подразделение, Справочники.СтруктураПредприятия.ПустаяСсылка()));
	
	СписокДействующихСпецификаций = Запрос.Выполнить().Выгрузить();
	
	Возврат СписокДействующихСпецификаций;
	
КонецФункции

// Переводит время из заданных единиц времени в секунды
// Параметры:
//		Время - число
//		ЕдиницаИзмеренияВремени - ПеречислениеСсылка.ЕдиницыИзмеренияВремени
// ВозвращаемоеЗначение:
//		Число
// Пример:
//      ВремяВСекундах = aps_ТехнологическаяСхемаСервисы.ПолучитьВремяВСекундах( УП2ТекущаяОперация.ВремяВыполнения, УП2ТекущаяОперация.ВремяВыполненияЕдИзм );
//
Функция ПолучитьВремяВСекундах(Время, ЕдиницаИзмеренияВремени) Экспорт
	
	Если Время = 0 Тогда
		
		Возврат 0;
		
	КонецЕсли;
	
	Если ЕдиницаИзмеренияВремени = ПредопределенноеЗначение("Перечисление.ЕдиницыИзмеренияВремени.Сутки") 
		ИЛИ ЕдиницаИзмеренияВремени = ПредопределенноеЗначение("Перечисление.ЕдиницыИзмеренияВремени.День") Тогда
		
		ВремяВСекундах = Время * 86400; // 60 * 60 * 24
		
	ИначеЕсли ЕдиницаИзмеренияВремени = ПредопределенноеЗначение("Перечисление.ЕдиницыИзмеренияВремени.Минута") Тогда
		
		ВремяВСекундах = Время * 60;
		
	ИначеЕсли ЕдиницаИзмеренияВремени = ПредопределенноеЗначение("Перечисление.ЕдиницыИзмеренияВремени.Час") Тогда
		
		ВремяВСекундах = Время * 3600; // 60 * 60;
		
	ИначеЕсли ЕдиницаИзмеренияВремени = ПредопределенноеЗначение("Перечисление.ЕдиницыИзмеренияВремени.Секунда") Тогда
		
		ВремяВСекундах = Время;
		
	Иначе
		
		ВремяВСекундах = 0;
		
	КонецЕсли;

	Возврат ВремяВСекундах;
	
КонецФункции

// Переводит время в секундах во время в заданных единицах времени
// Параметры:
//		ВремяВСекундах - число
//		ЕдиницаИзмеренияВремени - ПеречислениеСсылка.ЕдиницыИзмеренияВремени
// Возвращаемое значение:
//		Число
// Пример:
//	    Этап.ДлительностьЭтапа = Цел(aps_ТехнологическаяСхемаСервисы.ПолучитьВремяВЕдиницеИзмерения(Этап.ДлительностьЭтапа, Перечисления.ЕдиницыИзмеренияВремени.День));
//
Функция ПолучитьВремяВЕдиницеИзмерения(ВремяВСекундах, ЕдиницаИзмеренияВремени) Экспорт
	
	Если ВремяВСекундах = 0 Тогда
		
		Возврат 0;
		
	КонецЕсли;
	
	Если ЕдиницаИзмеренияВремени = ПредопределенноеЗначение("Перечисление.ЕдиницыИзмеренияВремени.Сутки")
		ИЛИ ЕдиницаИзмеренияВремени = ПредопределенноеЗначение("Перечисление.ЕдиницыИзмеренияВремени.День") Тогда
		
		Время = ВремяВСекундах / 86400; // 60 / 60 / 24;
		
	ИначеЕсли ЕдиницаИзмеренияВремени = ПредопределенноеЗначение("Перечисление.ЕдиницыИзмеренияВремени.Минута") Тогда
		
		Время = ВремяВСекундах / 60;
		
	ИначеЕсли ЕдиницаИзмеренияВремени = ПредопределенноеЗначение("Перечисление.ЕдиницыИзмеренияВремени.Час") Тогда
		
		Время = ВремяВСекундах / 3600; // 60 / 60;
		
	Иначе
		
		Время = 0;
		
	КонецЕсли;

	Возврат  Время;
	
КонецФункции

Функция aps_ПолучитьКоэфициентПереводаКЕдиницеХранения(ЕдИзм, Номенклатура) Экспорт
	Если ЕдИзм = Номенклатура.ЕдиницаИзмерения Тогда 
		Возврат 1;
	Иначе
		Если Не ЗначениеЗаполнено(Номенклатура.ЕдиницаИзмерения) Тогда 
			ВызватьИсключение "Не установлена единица хранения.";
		ИначеЕсли ЗначениеЗаполнено(ЕдИзм.ТипИзмеряемойВеличины) Тогда
			Если ЕдИзм.ТипИзмеряемойВеличины <> Перечисления.ТипыИзмеряемыхВеличин.Упаковка Тогда 
			    Если ЕдИзм.ТипИзмеряемойВеличины = Номенклатура.ЕдиницаИзмерения.ТипИзмеряемойВеличины Тогда 
					Возврат (ЕдИзм.Числитель*Номенклатура.ЕдиницаИзмерения.Знаменатель)/(ЕдИзм.Знаменатель*Номенклатура.ЕдиницаИзмерения.Числитель);
				ИначеЕсли ЕдИзм.ТипИзмеряемойВеличины = Перечисления.ТипыИзмеряемыхВеличин.Вес Тогда 
					Если НЕ Номенклатура.ВесИспользовать Тогда 
						ВызватьИсключение "Единица измерения Веса не используется.";
					ИначеЕсли НЕ Номенклатура.ВесМожноУказыватьВДокументах Тогда 
						ВызватьИсключение "Единица измерения Веса указана справочно.";
					КонецЕсли;
					Возврат (ЕдИзм.Числитель*Номенклатура.ВесЕдиницаИзмерения.Знаменатель)/(ЕдИзм.Знаменатель*Номенклатура.ВесЕдиницаИзмерения.Числитель)*(Номенклатура.ВесЗнаменатель/Номенклатура.ВесЧислитель);
				ИначеЕсли ЕдИзм.ТипИзмеряемойВеличины = Перечисления.ТипыИзмеряемыхВеличин.Длина Тогда 
					Если НЕ Номенклатура.ДлинаИспользовать Тогда 
						ВызватьИсключение "Единица измерения Длины не используется.";
					ИначеЕсли НЕ Номенклатура.ДлинаМожноУказыватьВДокументах Тогда 
						ВызватьИсключение "Единица измерения Длина указана справочно.";
					КонецЕсли;
					Возврат (ЕдИзм.Числитель*Номенклатура.ДлинаЕдиницаИзмерения.Знаменатель)/(ЕдИзм.Знаменатель*Номенклатура.ДлинаЕдиницаИзмерения.Числитель)*(Номенклатура.ДлинаЗнаменатель/Номенклатура.ДлинаЧислитель);	
				ИначеЕсли ЕдИзм.ТипИзмеряемойВеличины = Перечисления.ТипыИзмеряемыхВеличин.Объем Тогда 
					Если НЕ Номенклатура.ОбъемИспользовать Тогда 
						ВызватьИсключение "Единица измерения Объема не используется.";
					ИначеЕсли НЕ Номенклатура.ОбъемМожноУказыватьВДокументах Тогда 
						ВызватьИсключение "Единица измерения Объема указана справочно.";
					КонецЕсли;
					Возврат (ЕдИзм.Числитель*Номенклатура.ОбъемЕдиницаИзмерения.Знаменатель)/(ЕдИзм.Знаменатель*Номенклатура.ОбъемЕдиницаИзмерения.Числитель)*(Номенклатура.ОбъемЗнаменатель/Номенклатура.ОбъемЧислитель);
				ИначеЕсли ЕдИзм.ТипИзмеряемойВеличины = Перечисления.ТипыИзмеряемыхВеличин.Площадь Тогда 
					Если НЕ Номенклатура.ПлощадьИспользовать Тогда 
						ВызватьИсключение "Единица измерения Площади не используется.";
					ИначеЕсли НЕ Номенклатура.ПлощадьМожноУказыватьВДокументах Тогда 
						ВызватьИсключение "Единица измерения Площади указана справочно.";
					КонецЕсли;
					Возврат (ЕдИзм.Числитель*Номенклатура.ПлощадьЕдиницаИзмерения.Знаменатель)/(ЕдИзм.Знаменатель*Номенклатура.ПлощадьЕдиницаИзмерения.Числитель)*(Номенклатура.ПлощадьЗнаменатель/Номенклатура.ПлощадьЧислитель);	
				КонецЕсли;
			Иначе
				Если ЕдИзм.ТипУпаковки = Перечисления.ТипыУпаковокНоменклатуры.Конечная или ЕдИзм.ТипУпаковки = Перечисления.ТипыУпаковокНоменклатуры.Составная Тогда 
					Возврат ЕдИзм.Числитель/ЕдИзм.Знаменатель;
				Иначе
					Возврат ЕдИзм.Знаменатель/ЕдИзм.Числитель;
				КонецЕсли;
			КонецЕсли;	
		Иначе
			ВызватьИсключение "Для единицы <" + Строка(ЕдИзм) + "> не установлен тип измеряемой величины.";
		КонецЕсли;	
	КонецЕсли;	
КонецФункции

Функция aps_ПересчитатьВеличины(Количество, Знач ЕдИзм, Знач КЕдИзм, Номенклатура) Экспорт
	Попытка 
		Если ЕдИзм = КЕдИзм Тогда 
			Возврат Количество;
		Иначе	
			Возврат Количество * aps_ПолучитьКоэфициентПереводаКЕдиницеХранения(ЕдИзм, Номенклатура)/aps_ПолучитьКоэфициентПереводаКЕдиницеХранения(КЕдИзм, Номенклатура);
		КонецЕсли;	
	Исключение
		Сообщить(aps_ПолныеПрава.aps_ПараметрСеанса("aps_ИмяПродукта") + "Номенклатура """ + Строка(Номенклатура) + """. При пересчёте из <" + Строка(ЕдИзм) + "> в <" + Строка(КЕдИзм) + "> произошла ошибка:"+Символы.ПС + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), СтатусСообщения.Внимание);
		Возврат Неопределено;
	КонецПопытки;	
КонецФункции

// Заполняет выходные изделия в ТЧ МК или РС
//
// Параметры:
//		ВыхИзделияТЧ - табличная часть
//		Номенклатура - СправочникСсылка.Номенклатура
//		Характеристика - СправочникСсылка.ХарактеристикиНоменклатуры
//		Количество  - число
//		Упаковка - СправочникСсылка.УпаковкиНоменклатуры
//		ЕдиницаИзмерения - СправочникСсылка.КлассификаторЕдиницИзмерения
//		ЭтапИлиОперация - СправочникСсылка.ТехнологическиеОперации, СправочникСсылка.ЭтапыПроизводства
// Пример:
//		aps_ТехнологическаяСхемаСервисы.ЗаполнитьВыходныеИзделия( УП2ТекущаяМК.ВыходныеИзделия,
//				  		  ВыходноеИзделие.Номенклатура,												
//						  ВыходноеИзделие.Характеристика,
//						  ВыходноеИзделие.Количество,
//						  ВыходноеИзделие.Упаковка,
//						  ВыходноеИзделие.ЕдиницаИзмерения,
//						  УП2ТекущаяОперация );
//
Процедура ЗаполнитьВыходныеИзделия( ВыхИзделияТЧ, Номенклатура, Характеристика, Количество, Упаковка, ЕдиницаИзмерения, ЭтапИлиОперация ) Экспорт
	ВыходноеИзделие=ВыхИзделияТЧ.Добавить();
	ВыходноеИзделие.Номенклатура			 	=Номенклатура;
	ВыходноеИзделие.Характеристика				=Характеристика;
	Если ЗначениеЗаполнено( Упаковка ) Тогда
		ВыходноеИзделие.Упаковка=Упаковка;
		ВыходноеИзделие.КоличествоУпаковок=Количество;
	Иначе
		ВыходноеИзделие.Количество=РегистрыСведений.aps_КоэффициентыПересчетаВеличин.aps_ПересчитатьВеличины(
		Количество, ЕдиницаИзмерения, Номенклатура.ЕдиницаИзмерения );
		ВыходноеИзделие.КоличествоУпаковок=Количество;
	КонецЕсли;
	ВыходноеИзделие.ДоляСтоимости = 1;
	
	Если ЭтапИлиОперация<>Неопределено Тогда
		Если Тип(ВыхИзделияТЧ)=Тип("СправочникТабличнаяЧасть.РесурсныеСпецификации.ВыходныеИзделия") Тогда
			ВыходноеИзделие.Этап=ЭтапИлиОперация.ПолучитьСсылкуНового();
			ВыходноеИзделие.ЭтапРедактирование=ЭтапИлиОперация.ПолучитьСсылкуНового();
		Иначе
			ВыходноеИзделие.Операция=ЭтапИлиОперация.ПолучитьСсылкуНового();
			ВыходноеИзделие.ОперацияРедактирование=ЭтапИлиОперация.ПолучитьСсылкуНового();
		КонецЕсли;		
	КонецЕсли;
КонецПроцедуры

// Создает и устанавливает ссылку нового элемента у указанного справочник менеджера
// Параметры:
//		СправочникМенеджер - СправочникМенеджер.<ИмяСправочника>
// Возвращаемое значение:
//		СправочникСсылка.<ИмяСправочника>
// Пример:
//		РесурснаяСпецификация = aps_ТехнологическаяСхемаСервисы.СоздатьОбъект( Справочники.РесурсныеСпецификации );
//
Функция СоздатьОбъект( СправочникМенеджер ) Экспорт
	ЭлементСпр=СправочникМенеджер.СоздатьЭлемент();
	ЭлементСпр.УстановитьСсылкуНового( СправочникМенеджер.ПолучитьСсылку( Новый УникальныйИдентификатор() ));
	Возврат ЭлементСпр;
КонецФункции

// Вставляет в массив
// Параметры:
//		Массив - массив
//		Элемент - произвольное значение
// Пример:
//      aps_ТехнологическаяСхемаСервисы.ВставитьВМассивСУникальностью( СозданныеОбъектыМассив,  РесурснаяСпецификация );
//
Процедура ВставитьВМассивСУникальностью( Массив, Элемент ) Экспорт   
	Для Каждого СущЭлемент Из Массив Цикл
		Если СущЭлемент=Элемент Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	Массив.Добавить( Элемент );
Конецпроцедуры

// Заполняет исходные комплектующие в ТЧ МК или РС
//
// Параметры:
//		ИсхКомплектующие - табличная часть
//		Номенклатура - СправочникСсылка.Номенклатура
//		Характеристика  - СправочникСсылка.ХарактеристикиНоменклатуры
//		Количество - число
//		Упаковка - СправочникСсылка.УпаковкиНоменклатуры
//		ЕдиницаИзмерения - СправочникСсылка.КлассификаторЕдиницИзмерения
//		ЭтапИлиОперация  - СправочникСсылка.ТехнологическиеОперации, СправочникСсылка.ЭтапыПроизводства
//		Спецификация - СправочникСсылка.РесурсныеСпецификации
//
// Пример:
//		aps_ТехнологическаяСхемаСервисы.ЗаполнитьИсхКомплектующие( ИсходныеКомплектующие,
//							Состав[i].Номенклатура,
//							Состав[i].Характеристика,Состав[i].Количество,
//							Состав[i].Упаковка, Неопределено, Спец );
//
Процедура ЗаполнитьИсхКомплектующие( 	ИсхКомплектующие, 
										Номенклатура,
										Характеристика,
										Количество,
										Упаковка,
										ЕдиницаИзмерения,
										ЭтапИлиОперация,
										Спецификация=Неопределено ) Экспорт   
	ИсхКомпл=ИсхКомплектующие.Добавить();
	ИсхКомпл.Номенклатура			 	=Номенклатура;
	ИсхКомпл.Характеристика				=Характеристика;
	ИсхКомпл.СтатьяКалькуляции = Константы.aps_ТехСхемаСтатьяКалькуляцииКомплектующие.Получить();
	Если Упаковка<>Неопределено И НЕ Упаковка.Пустая() Тогда
		ИсхКомпл.Упаковка=Упаковка;
		ИсхКомпл.КоличествоУпаковок=Количество;
	Иначе
		ИсхКомпл.Количество = aps_ПересчитатьВеличины(Количество, ЕдиницаИзмерения, Номенклатура.ЕдиницаИзмерения, Номенклатура);
		ИсхКомпл.КоличествоУпаковок = Количество;
	КонецЕсли;
	
	Если ТипЗнч( ИсхКомплектующие )=Тип( "СправочникТабличнаяЧасть.МаршрутныеКарты.МатериалыИУслуги" ) Тогда
		ИсхКомпл.Операция=ЭтапИлиОперация.ПолучитьСсылкуНового();
	ИначеЕсли  ЭтапИлиОперация<>Неопределено Тогда
		ИсхКомпл.Этап=ЭтапИлиОперация.ПолучитьСсылкуНового();
		ИсхКомпл.ЭтапРедактирование=ЭтапИлиОперация.ПолучитьСсылкуНового();
	КонецЕсли;
	
	Если Спецификация<>Неопределено Тогда 	
		ИсхКомпл.СпецификацияПолуфабриката=Спецификация;
		ИсхКомпл.ПроизводитсяВПроцессе=Истина;
	КонецЕсли;
КонецПроцедуры

// Получает параметры элементов
// Параметры:
//		МассивЭлементов - массив
// Возвращаемое значение:
//		ТаблицаЗначений
// Пример:
//      ПараметрыВыходныхИзделий = aps_ТехнологическаяСхемаСервисы.ПолучитьПараметрыЭлементов(МассивВыходныхИзделий);
//
Функция ПолучитьПараметрыЭлементов(МассивЭлементов) Экспорт
	ТаблицаСсылок = Новый ТаблицаЗначений;
	ТаблицаСсылок.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("СправочникСсылка.aps_ЭлементыИзделия, СправочникСсылка.aps_ЭлементыСправочников, СправочникСсылка.aps_ЭлементыТехнологии"));
	Для Каждого ЭлементСсылка Из МассивЭлементов Цикл
		ТаблицаСсылок.Добавить().Ссылка = ЭлементСсылка;
	КонецЦикла;
	
	Запрос = Новый Запрос();
	МенеджерВТ = Новый МенеджерВременныхТаблиц();
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
	Запрос.Текст="ВЫБРАТЬ
	             |	ТаблицаСсылок.Ссылка КАК Ссылка
	             |ПОМЕСТИТЬ ВТСсылки
	             |ИЗ
	             |	&Данные КАК ТаблицаСсылок";
	Запрос.УстановитьПараметр("Данные", ТаблицаСсылок);
	Запрос.Выполнить();
	
	Запрос.Текст = "ВЫБРАТЬ
				   |	ВТСсылки.Ссылка,
				   |	ВЫРАЗИТЬ(ВТСсылки.Ссылка КАК Справочник.aps_ЭлементыИзделия).Параметры.(Параметр, Параметр.Наименование КАК ИмяПараметра, Параметр.Свойство КАК Свойство, Параметр.Значение КАК Значение, Параметр.ЕдиницаИзмерения КАК ЕдиницаИзмерения, Параметр.Родитель КАК ГруппаПараметров, Параметр.Родитель.Наименование КАК ИмяГруппыПараметров) КАК ПараметрыЭлементаИзделия,
				   |	ВЫРАЗИТЬ(ВТСсылки.Ссылка КАК Справочник.aps_ЭлементыСправочников).Параметры.(Параметр, Параметр.Наименование КАК ИмяПараметра, Параметр.Свойство КАК Свойство, Параметр.Значение КАК Значение, Параметр.ЕдиницаИзмерения КАК ЕдиницаИзмерения, Параметр.Родитель КАК ГруппаПараметров, Параметр.Родитель.Наименование КАК ИмяГруппыПараметров) КАК ПараметрыЭлементаСправочника,
				   |	ВЫРАЗИТЬ(ВТСсылки.Ссылка КАК Справочник.aps_ЭлементыТехнологии).Параметры.(Параметр, Параметр.Наименование КАК ИмяПараметра, Параметр.Свойство КАК Свойство, Параметр.Значение КАК Значение, Параметр.ЕдиницаИзмерения КАК ЕдиницаИзмерения, Параметр.Родитель КАК ГруппаПараметров, Параметр.Родитель.Наименование КАК ИмяГруппыПараметров) КАК ПараметрыЭлементаТехнологии
				   |ИЗ
				   |	ВТСсылки";
				   
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

// Процедура выполняет обмен из удаленной базы в эту
// Параметры:
//		Настройки - СправочникСсылка.aps_НастройкаОбменаERP
// Пример:
//		aps_ТехнологическаяСхемаСервисы.ОбменятьсяИзУдаленнойВЭту( Ссылка );
//
Процедура ОбменятьсяИзУдаленнойВЭту( Настройки ) Экспорт
	ERPCOM=Новый COMОбъект(Настройки.ВерсияПлатформы+".COMConnector");
	Если Настройки.УдаленнаяБазаЕстьФайловая Тогда
		ERP=ERPCOM.Connect("File="""+Настройки.УдаленнаяКаталог+";Usr="""+Настройки.УдаленноеИмяПользователя+
		""";Pwd="""+Настройки.УдаленныйПарольПользователя+"""");
	Иначе
		ERP=ERPCOM.Connect("Srvr="""+
		Настройки.УдаленныйСервер+""";Ref="""+Настройки.УдаленнаяБаза+""";Usr="""+
		Настройки.УдаленноеИмяПользователя+""";Pwd="""+Настройки.УдаленныйПарольПользователя+"""");	
	КонецЕсли;

	COMОбработка=ERP.Обработки.УниверсальныйОбменДаннымиXML.Создать();
	COMОбработка.ТипИнформационнойБазыДляПодключения=Ложь;
	COMОбработка.АутентификацияWindowsИнформационнойБазыДляПодключения=Ложь;

	СтруктураСоедЭтойБазы=aps_РазбитьСтрокуСоединенияПоПараметрам( СтрокаСоединенияИнформационнойБазы() );
	ПутьКФайловойБазе="";
	Если СтруктураСоедЭтойБазы.Свойство("КаталогИБ",  ПутьКФайловойБазе ) Тогда
		COMОбработка.КаталогИнформационнойБазыДляПодключения=ПутьКФайловойБазе;
		COMОбработка.ТипИнформационнойБазыДляПодключения=Истина;
	Иначе
		COMОбработка.ИмяСервераИнформационнойБазыДляПодключения=СтруктураСоедЭтойБазы.ИмяСервера;
		COMОбработка.ИмяИнформационнойБазыНаСервереДляПодключения=СтруктураСоедЭтойБазы.ИмяИБНаСервере;
		COMОбработка.ТипИнформационнойБазыДляПодключения=Ложь;
	КонецЕсли;

	COMОбработка.ИмяФайлаПротоколаОбмена=КаталогВременныхФайлов()+"1cexchange_log.txt";
	COMОбработка.ПользовательИнформационнойБазыДляПодключения=Настройки.ПользовательЭтойБазы;
	COMОбработка.ПарольИнформационнойБазыДляПодключения=Настройки.ПарольЭтойБазы;
	COMОбработка.ВерсияПлатформыИнформационнойБазыДляПодключения=Настройки.ВерсияПлатформы;
	COMОбработка.НепосредственноеЧтениеВИБПриемнике=Истина;
	COMОбработка.ИмяФайлаПравилОбмена="ЗаглушкаДляОбработки";
	COMОбработка.ЗагрузитьПравилаОбмена( Настройки.ПравилаИзУдаленнойВЭту, "Строка" );
	COMPDMУзел=ERP.ПланыОбмена.ОбменPDM.НайтиПоКоду("PDM");
	УстановитьУзелОбменаУСтрокДерева( COMОбработка.ТаблицаПравилВыгрузки.Строки, COMPDMУзел ); 
	COMОбработка.ВыполнитьВыгрузку();
	COMОбработка=Неопределено; ERP=Неопределено; ERPCOM=Неопределено;
КонецПроцедуры	

// Процедура выполняет обмен из этой базы в удаленную
// Параметры:
//		Настройки - СправочникСсылка.aps_НастройкаОбменаERP
// Пример:
//		aps_ТехнологическаяСхемаСервисы.ОбменятьсяИзЭтойВУдаленную( Ссылка );
//
Процедура ОбменятьсяИзЭтойВУдаленную(Настройки) Экспорт
	Обработка=Обработки.УниверсальныйОбменДаннымиXML.Создать();
	Обработка.ТипИнформационнойБазыДляПодключения=Ложь;
	Обработка.АутентификацияWindowsИнформационнойБазыДляПодключения=Ложь;

	Обработка.ТипИнформационнойБазыДляПодключения=Настройки.УдаленнаяБазаЕстьФайловая;
	Если Настройки.УдаленнаяБазаЕстьФайловая Тогда
		Обработка.КаталогИнформационнойБазыДляПодключения=Настройки.УдаленнаяКаталог;
	Иначе
		Обработка.ИмяСервераИнформационнойБазыДляПодключения=Настройки.УдаленныйСервер;
		Обработка.ИмяИнформационнойБазыНаСервереДляПодключения=Настройки.УдаленнаяБаза;
	КонецЕсли;

	Обработка.ПользовательИнформационнойБазыДляПодключения=Настройки.УдаленноеИмяПользователя;
	Обработка.ПарольИнформационнойБазыДляПодключения=Настройки.УдаленныйПарольПользователя;
	Обработка.ВерсияПлатформыИнформационнойБазыДляПодключения=Настройки.ВерсияПлатформы;
	Обработка.НепосредственноеЧтениеВИБПриемнике=Истина;
	Обработка.ИмяФайлаПравилОбмена="ЗаглушкаДляОбработки";
	Обработка.ИмяФайлаПротоколаОбмена=КаталогВременныхФайлов()+"1cexchange_log2.txt";
	Обработка.ЗагрузитьПравилаОбмена( Настройки.ПравилаИзЭтойВУдаленную, "Строка" );
	UP2=ПланыОбмена.ОбменERP.НайтиПоКоду("UP2");
	УстановитьУзелОбменаУСтрокДерева( Обработка.ТаблицаПравилВыгрузки.Строки, UP2 ); 
	Обработка.ВыполнитьВыгрузку();
КонецПроцедуры



#КонецОбласти


#Область СлужебныеПроцедурыИФункции

Процедура УстановитьУзелОбменаУСтрокДерева(Строки, УзелОбмена)
	
	Для Каждого Строка Из Строки Цикл
		
		Если Строка.ЭтоГруппа Тогда
			
			УстановитьУзелОбменаУСтрокДерева(Строка.Строки, УзелОбмена);
			
		Иначе
			
			Строка.СсылкаНаУзелОбмена = УзелОбмена;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти


#КонецЕсли