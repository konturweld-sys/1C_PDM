
#Область ПрограммныйИнтерфейс

// Функция получает подпись уведомления для пользователя
// Параметры:
//		Пользователь - СправочникСсылка.Пользователи
// Возвращаемое значение:
//		Строка
// Пример:
//		Уведомление.Содержание = РегистрыСведений.aps_ПодписиУведомлений.aps_ПолучитьПодпись(ПараметрыСеанса.ТекущийПользователь);
//
Функция aps_ПолучитьПодпись( Пользователь ) Экспорт
	Записи = РегистрыСведений.aps_ПодписиУведомлений.СоздатьНаборЗаписей();
	Записи.Отбор.Пользователь.Установить(Пользователь);
	Записи.Прочитать();
	
	Если Записи.Количество() = 0 Тогда
		Возврат "";
	Иначе 
		Возврат Записи[0].Подпись;
	КонецЕсли;
КонецФункции

#КонецОбласти