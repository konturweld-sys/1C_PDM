
#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, Замещение)
	// Поиск упаковки для единицы измерения
	Для Каждого ЗР Из ЭтотОбъект Цикл
		Если ЗР.ВидНабора=Перечисления.ERPКорпВидыНаборов.ВыходноеИзделие Или
			 ЗР.ВидСвязи=Справочники.aps_ШаблоныТехнологическихСвязей.Комплектование Тогда
			ЗР.Упаковка=aps_ТехнологическаяСхема.ПоискУпаковкиПоЕдиницеИзм( ЗР.Номенклатура, ЗР.ЕдиницаИзмерения );
		КонецЕсли;
	КонецЦикла;
	// Проверка на ошибки
	Если Константы.aps_ТехСхемаИгнорироватьОшибки.Получить()=Ложь Тогда 
		ФлагОднократнойЗаписи=Ложь;
		Для Каждого ЗаписьРегистра Из ЭтотОбъект Цикл
			Если ЗаписьРегистра.ВидНабора = Перечисления.ERPКорпВидыНаборов.ВыходноеИзделие
				 ИЛИ ЗаписьРегистра.ВидНабора = Перечисления.ERPКорпВидыНаборов.Маршрут
				 ИЛИ ЗаписьРегистра.ВидНабора = Перечисления.ERPКорпВидыНаборов.Техпроцесс Тогда
				 aps_ТехнологическаяСхемаКэш.ЗаполнениеОшибокТехнологии(ЗаписьРегистра);
				 Если ЗаписьРегистра.ЕстьОшибкиИлиПредупреждения>0 И
					  ФлагОднократнойЗаписи=Ложь Тогда
					  МЗ=РегистрыСведений.aps_ДанныеВыполненияФоновыхЗаданий.СоздатьМенеджерЗаписи();
					  МЗ.Статус=Перечисления.СтатусФормированияERP.ОстановленПоОшибке;
					  МЗ.ЭлементСсылка=ЗаписьРегистра.ЭлементСсылка;
					  мз.Записать();
					  ФлагОднократнойЗаписи=Истина;
				 КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти