
#Область ПрограммныйИнтерфейс

// Функция выполняет пересчет значения в другую единицу измерения
// Параметры:
//		Значение - число, значение пересчета
//		ЕдиницаЗначения - СправочникСсылка.КлассификаторЕдиницИзмерения
//		ЕдиницаПересчета - СправочникСсылка.КлассификаторЕдиницИзмерения
// ВозвращаемоеЗначение:
//		Число
// Пример:
//      ВыходноеИзделие.Количество=РегистрыСведений.aps_КоэффициентыПересчетаВеличин.aps_ПересчитатьВеличины(
//				Количество, ЕдиницаИзмерения, Номенклатура.ЕдиницаИзмерения );
//		
Функция aps_ПересчитатьВеличины( Значение, ЕдиницаЗначения, ЕдиницаПересчета ) Экспорт
	Если ЕдиницаЗначения=Неопределено Или
		 ЕдиницаПересчета=Неопределено Или
		 ЕдиницаЗначения=ЕдиницаПересчета Тогда
		 Возврат Значение;
	КонецЕсли;
	ЗаписьПересчета=РегистрыСведений.aps_КоэффициентыПересчетаВеличин.СоздатьМенеджерЗаписи();
	ЗаписьПересчета.Единица1=ЕдиницаЗначения;
	ЗаписьПересчета.Единица2=ЕдиницаПересчета;
	ЗаписьПересчета.Прочитать();
	Если Не ЗаписьПересчета.Выбран() Тогда
		ЗаписьПересчета.Единица1=ЕдиницаПересчета;
		ЗаписьПересчета.Единица2=ЕдиницаЗначения;
		ЗаписьПересчета.Прочитать();
		Если ЗаписьПересчета.Выбран() Тогда
			Возврат Значение*?(ЗаписьПересчета.Коэффициент=0,1,ЗаписьПересчета.Коэффициент);
		Иначе
			Возврат Значение;
		КонецЕсли;
	Иначе
		Возврат Значение/?(ЗаписьПересчета.Коэффициент=0,1,ЗаписьПересчета.Коэффициент);
	КонецЕсли;
	
КонецФункции

#КонецОбласти