<Объект Нпп="316" Тип="СправочникСсылка.aps_События" ИмяПравила="aps_События00001"><Ссылка Нпп="316">
	<Свойство Имя="{УникальныйИдентификатор}" Тип="Строка">
		<Значение>72f959a2-5c40-11e0-b585-0007e9314c80</Значение>
	</Свойство>
	<Свойство Имя="Наименование" Тип="Строка">
		<Значение>После создания позиции номенклатуры</Значение>
	</Свойство>
	<Свойство Имя="ЭтоГруппа" Тип="Булево">
		<Значение>false</Значение>
	</Свойство>
</Ссылка>
	<Свойство Имя="КодСобытия" Тип="Строка">
		<Значение>item = ?(aps_СтруктураПараметровОповещения.Свойство("item"),aps_СтруктураПараметровОповещения.item,Неопределено);
ЭлементНоменклатуры = ?(aps_СтруктураПараметровОповещения.Свойство("itemObject"),aps_СтруктураПараметровОповещения.itemObject,Неопределено);

// Создание единицы измерения
ЕдиницаИзм=Справочники.ЕдиницыИзмерения.НайтиПоРеквизиту("ЕдиницаПоКлассификатору",ЭлементНоменклатуры.БазоваяЕдиницаИзмерения,,ЭлементНоменклатуры.Ссылка);
Если ЕдиницаИзм.Пустая() Тогда
    
        ЕдиницаИзм=Справочники.ЕдиницыИзмерения.СоздатьЭлемент();
        ЕдиницаИзм.Владелец=ЭлементНоменклатуры.Ссылка;
        ЕдиницаИзм.Наименование=ЭлементНоменклатуры.БазоваяЕдиницаИзмерения.Наименование;
        ЕдиницаИзм.Коэффициент=1;
        ЕдиницаИзм.ЕдиницаПоКлассификатору=ЭлементНоменклатуры.БазоваяЕдиницаИзмерения;
        
        ЕдиницаИзм.Записать();
    
КонецЕсли;</Значение>
	</Свойство>
	<Свойство Имя="ПометкаУдаления" Тип="Булево">
		<Значение>false</Значение>
	</Свойство><Свойство Имя="Родитель" Тип="СправочникСсылка.aps_События">
	<Пусто/>
</Свойство><Свойство Имя="ТипСобытия" Тип="ПеречислениеСсылка.aps_События">
	<Значение>ПослеСозданияНоменклатуры</Значение>
</Свойство><ТабличнаяЧасть Имя="КаскадныеСобытия"/>
</Объект>
