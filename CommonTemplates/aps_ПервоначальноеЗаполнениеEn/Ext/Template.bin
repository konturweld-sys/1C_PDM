<Объект Нпп="305" Тип="СправочникСсылка.aps_События" ИмяПравила="aps_События00001"><Ссылка Нпп="305">
	<Свойство Имя="{УникальныйИдентификатор}" Тип="Строка">
		<Значение>48743eab-0606-11e1-8cf1-00271344f318</Значение>
	</Свойство>
	<Свойство Имя="Наименование" Тип="Строка">
		<Значение>APPIUS.PDM.StateManagement.StateChange</Значение>
	</Свойство>
	<Свойство Имя="ЭтоГруппа" Тип="Булево">
		<Значение>false</Значение>
	</Свойство>
</Ссылка>
	<Свойство Имя="КодСобытия" Тип="Строка">
		<Значение>////////////////////////////////////////////////////////////////////////////
// Доступные параметры события в стр-ре aps_СтруктураПараметровОповещения
////////////////////////////////////////////////////////////////////////////
// Дата - дата и время записи в журнал информации о событии
// Пользователь - пользователь от имени которого событие было записано в журнал
// Компьютер - имя компьютера
// Событие - имя события в журнале (наименование)
// Данные - данные, связанные с записью в журнал
// Комментарий - текстовый комментарий
// Почта - объект интернет-почта проверенный, с установленным соединением
// НастройкаПочты - ссылка на текущую настройку почты, заданную в константе

// Гл. переменная "Событие" - ссылка на это событие

Сообщение=Новый ИнтернетПочтовоеСообщение;
ОбратныйАдрес=Сообщение.ОбратныйАдрес.Добавить(aps_СтруктураПараметровОповещения.НастройкаПочты.Адрес);
ОбратныйАдрес.ОтображаемоеИмя=aps_СтруктураПараметровОповещения.НастройкаПочты.Адрес;
Сообщение.ИмяОтправителя=aps_СтруктураПараметровОповещения.НастройкаПочты.Адрес;
// формирование списка получателей
	Для i=0 По Событие.ЭлементСобытия.Рассылка.Количество()-1 Цикл
		Адрес = Сообщение.Получатели.Добавить(Событие.ЭлементСобытия.Рассылка[i].Адрес);
		Адрес.ОтображаемоеИмя=Строка(Событие.ЭлементСобытия.Рассылка[i].ОтображаемоеИмя);
    КонецЦикла;			
	Сообщение.Тема="Изменено состояние элементов !!!";
	
	ТекстРассылки=Событие.ЭлементСобытия.ФормаРассылки;
	ТекстРассылки=ТекстРассылки+aps_СтруктураПараметровОповещения.Комментарий;
	Сообщение.Тексты.Добавить(ТекстРассылки, ТипТекстаПочтовогоСообщения.HTML);

	aps_СтруктураПараметровОповещения.Почта.Послать( Сообщение );</Значение>
	</Свойство>
	<Свойство Имя="ПометкаУдаления" Тип="Булево">
		<Значение>false</Значение>
	</Свойство><Свойство Имя="Родитель" Тип="СправочникСсылка.aps_События">
	<Пусто/>
</Свойство><Свойство Имя="ТипСобытия" Тип="ПеречислениеСсылка.aps_События">
	<Пусто/>
</Свойство><ТабличнаяЧасть Имя="КаскадныеСобытия"/>
</Объект>
