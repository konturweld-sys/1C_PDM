<Объект Нпп="311" Тип="СправочникСсылка.aps_События" ИмяПравила="aps_События00001"><Ссылка Нпп="311">
	<Свойство Имя="{УникальныйИдентификатор}" Тип="Строка">
		<Значение>d7414dbe-72f2-11df-9035-005056c00008</Значение>
	</Свойство>
	<Свойство Имя="Наименование" Тип="Строка">
		<Значение>Создание новой позиции номенклатуры</Значение>
	</Свойство>
	<Свойство Имя="ЭтоГруппа" Тип="Булево">
		<Значение>false</Значение>
	</Свойство>
</Ссылка>
	<Свойство Имя="КодСобытия" Тип="Строка">
		<Значение>item = ?(aps_СтруктураПараметровОповещения.Свойство("item"),aps_СтруктураПараметровОповещения.item,Неопределено);
ЭлементНоменклатуры = ?(aps_СтруктураПараметровОповещения.Свойство("itemObject"),aps_СтруктураПараметровОповещения.itemObject,Неопределено);

Если ЭлементНоменклатуры.ВидНоменклатуры.Пустая() Тогда
	ЭлементНоменклатуры.ВидНоменклатуры = Справочники.ВидыНоменклатуры.НайтиПоРеквизиту("ТипНоменклатуры", Перечисления.ТипыНоменклатуры.Товар);
КонецЕсли;

Если ЭлементНоменклатуры.ВидВоспроизводства.Пустая() Тогда
	Если item &lt;&gt; Неопределено И (item.ВидЭлемента = Справочники.aps_ВидыЭлементов.Деталь
									ИЛИ item.ВидЭлемента = Справочники.aps_ВидыЭлементов.Комплекс
									ИЛИ item.ВидЭлемента = Справочники.aps_ВидыЭлементов.Комплект
									ИЛИ item.ВидЭлемента = Справочники.aps_ВидыЭлементов.СбЕдиница) Тогда 
		ЭлементНоменклатуры.ВидВоспроизводства = Перечисления.ВидыВоспроизводстваНоменклатуры.Производство;
	Иначе
		ЭлементНоменклатуры.ВидВоспроизводства = Перечисления.ВидыВоспроизводстваНоменклатуры.Закупка;
	КонецЕсли;
КонецЕсли;

Если ЭлементНоменклатуры.БазоваяЕдиницаИзмерения.Пустая() Тогда
	Если item &lt;&gt; Неопределено И item.ВидЭлемента = Справочники.aps_ВидыЭлементов.Материал Тогда
		ЭлементНоменклатуры.БазоваяЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду(166); // килограммы
	Иначе
		ЭлементНоменклатуры.БазоваяЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду(796); // штуки
	КонецЕсли;
КонецЕсли;</Значение>
	</Свойство>
	<Свойство Имя="ПометкаУдаления" Тип="Булево">
		<Значение>false</Значение>
	</Свойство><Свойство Имя="Родитель" Тип="СправочникСсылка.aps_События">
	<Пусто/>
</Свойство><Свойство Имя="ТипСобытия" Тип="ПеречислениеСсылка.aps_События">
	<Значение>ПриСозданииНоменклатуры</Значение>
</Свойство><ТабличнаяЧасть Имя="КаскадныеСобытия"/>
</Объект>
