		<Значение>УвеличениеНомераИзменения</Значение>
	</Свойство>
	<Свойство Имя="{УникальныйИдентификатор}" Тип="Строка">
		<Значение>e8973cbe-1cf7-44be-8732-855ae713c18c</Значение>
	</Свойство>
	<Свойство Имя="Наименование" Тип="Строка">
		<Значение>Revision</Значение>
	</Свойство>
</Ссылка>
	<Свойство Имя="ПометкаУдаления" Тип="Булево">
		<Значение>false</Значение>
	</Свойство>
	<Свойство Имя="ТекстКода" Тип="Строка">
		<Значение>// Вам доступны следующие переменные:
// ПредыдущийНомер - строка предыдущего номера
Попытка
	СледующийНомер = Число(ПредыдущийНомер) + 1;
Исключение
	СледующийНомер = 1;
КонецПопытки;</Значение>
	</Свойство>
</Объект>
<Объект Нпп="353" Тип="СправочникСсылка.aps_КодыПоследовательностейНомеровРевизий" ИмяПравила="aps_КодыПоследовательностейНомеровРевизий"><Ссылка Нпп="353">
	<Свойство Имя="{ИмяПредопределенногоЭлемента}" Тип="Строка">
		<Значение>УвеличениеНомераИсполнения</Значение>
	</Свойство>
	<Свойство Имя="{УникальныйИдентификатор}" Тип="Строка">
		<Значение>be9f082a-f842-457e-a638-948c7d3b5b71</Значение>
	</Свойство>
	<Свойство Имя="Наименование" Тип="Строка">
		<Значение>Family table</Значение>
	</Свойство>
</Ссылка>
	<Свойство Имя="ПометкаУдаления" Тип="Булево">
		<Значение>false</Значение>
	</Свойство>
	<Свойство Имя="ТекстКода" Тип="Строка">
		<Значение>// Вам доступны следующие переменные:
// ПредыдущийНомер - строка предыдущего номера
Попытка
    Если ТипЗнч( ПредыдущийНомер )=Тип("Строка") Тогда
        Если СтрДлина( ПредыдущийНомер )=0 Тогда
            СледующийНомер="01";
        Иначе
            Хвост=Сред( ПредыдущийНомер, 3 );
            Номер=СтрЗаменить( ПредыдущийНомер, Хвост, "");
            Если КодСимвола(ПредыдущийНомер)=КодСимвола("0") Тогда
                 Номер=Сред( Номер, 2);
            Иначе
                 Номер=Сред( Номер, 1, 2);
             КонецЕсли;
            СледующийНомер=Строка( Число( Номер ) + 1 ); 
            Если СтрДлина( СледующийНомер ) &lt;=1 Тогда
                СледующийНомер="0"+СледующийНомер;
            КонецЕсли;
            СледующийНомер=СледующийНомер+Хвост;
        КонецЕсли;
    Иначе
        СледующийНомер = Число(ПредыдущийНомер) + 1;
    КонецЕсли;
Исключение
    СледующийНомер = 1;
КонецПопытки;</Значение>
	</Свойство>
</Объект>
