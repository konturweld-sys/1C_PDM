		<Значение>http://virtualappiushost/TEMPLATES/docs/</Значение>
	</Свойство>
	<Свойство Имя="ЭтоГруппа" Тип="Булево">
		<Значение>true</Значение>
	</Свойство>
</Ссылка>
</Свойство>
	<Свойство Имя="ТекстШаблона" Тип="Строка">
		<Значение>&lt;html&gt;
&lt;head&gt;
&lt;meta http-equiv="Content-Type" content="text/html; charset=windows-1251"&gt;
&lt;title&gt;1C:PDM Управление инженерными данными, версия 2.0. (c) 2009, Фирма "1С", Группа компаний APPIUS. www.appius.ru&lt;/title&gt;
	&lt;link rel="stylesheet" type="text/css" href="http://virtualappiushost/core/appius.css"/&gt;
&lt;/head&gt;

&lt;body class="layerBodyStyle"&gt;
    
&lt;table border="0" cellpadding="5" cellspacing="5" width="100%" height="100%"&gt;
			&lt;tr&gt;
			&lt;td class="grayTextStyle"&gt;Номенклатура&lt;/td&gt;			&lt;/tr&gt;
			&lt;tr&gt;
				&lt;td class="appiusTextStyle"&gt;&lt;p&gt;Свойство "Номенклатура" используется для связи элемента электронной структуры изделия и позиции общего номенклатурного справочника с которым работает система ERP. Если
				 на предприятии планируется дальнейший производственный учет заполнение этого свойства необходимо. Однако при разработке эскизного проекта изделия, либо прорабтки, данное свойство можно не заполнять Для правильной работы с номенклатурой обратитесь к документации на ERP-систему и к документации 1C:PDM.&lt;/p&gt;&lt;/td&gt;  
			&lt;/tr&gt;
			&lt;/table&gt;
&lt;/table&gt;
    
    
&lt;/body&gt;

&lt;/html&gt;</Значение>
	</Свойство>
</Объект>
