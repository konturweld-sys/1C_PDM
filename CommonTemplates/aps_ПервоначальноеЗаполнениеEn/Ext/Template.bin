	<Свойство Имя="КодСобытия" Тип="Строка">
		<Значение>
// Назначение групповой политики элемента на параметры
itemObject = aps_СтруктураПараметровОповещения.itemObject;
Для Каждого СтрокаПараметра Из itemObject.Параметры Цикл
	ОбъектПараметра = СтрокаПараметра.Параметр.ПолучитьОбъект();
	ОбъектПараметра.GMOD = itemObject.GMOD;
	ОбъектПараметра.Записать();
КонецЦикла;
// Назначение групповой политики элемента на параметры связей
МассивСвязей = aps_Итераторы.aps_ЭлементныеСвязи(itemObject.Ссылка, Неопределено).ВыгрузитьКолонку("ЭлементСвязи");
Для Каждого СвязьСсылка Из МассивСвязей Цикл
	Для Каждого СтрокаПараметра Из СвязьСсылка.Параметры Цикл
		ОбъектПараметра = СтрокаПараметра.Параметр.ПолучитьОбъект();
		ОбъектПараметра.GMOD = itemObject.GMOD;
		ОбъектПараметра.Записать();
	КонецЦикла;
КонецЦикла;</Значение>
