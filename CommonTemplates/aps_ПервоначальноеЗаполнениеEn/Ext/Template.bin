<Объект Нпп="308" Тип="СправочникСсылка.aps_События" ИмяПравила="aps_События00001"><Ссылка Нпп="308">
	<Свойство Имя="{УникальныйИдентификатор}" Тип="Строка">
		<Значение>cf16be88-0553-11e1-8ed3-00271344f318</Значение>
	</Свойство>
	<Свойство Имя="Наименование" Тип="Строка">
