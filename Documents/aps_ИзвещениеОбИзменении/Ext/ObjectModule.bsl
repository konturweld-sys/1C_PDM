#Область ОбработчикиСобытий

#Если (ТолстыйКлиентОбычноеПриложение Или Сервер) И Не МобильноеПриложениеСервер Тогда

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	ФлагЗавершенияБП=(ДополнительныеСвойства.Свойство("ЗавершениеБП") И ДополнительныеСвойства.ЗавершениеБП=Истина);
	
	Если БПИзменениеСостояния.Пустая() 
			ИЛИ ФлагЗавершенияБП И БПИзменениеСостояния.Состояния.Найти(Ложь, "Согласован")=Неопределено Тогда
			
		Если БПИзменениеСостояния.Пустая()  Тогда 
			// ответственный за проведение документа
			Ответственный = ПараметрыСеанса.ТекущийПользователь;
		КонецЕсли;
			
		Если НЕ ПровестиИзвещение() Тогда 
			Отказ=Истина; Возврат;
		Иначе
			
			ДатаПроведения = ТекущаяДата(); // фактическая дата проведения ИИ
			
			#Если Клиент Или ВнешнееСоединение Тогда 
				// гл. переменная
			#Иначе
				aps_СтруктураПараметровОповещения=aps_СтруктураПараметровОповещенияНаСервере;
			#КонецЕсли
			
			aps_СтруктураПараметровОповещения.Вставить("itemObject",ЭтотОбъект);
			aps_ОбработчикиСобытий.aps_ВыполнитьСобытие(Перечисления.aps_События.ПриПроведенииИИ, aps_СтруктураПараметровОповещения);
			
			Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;
									 
	Иначе // не проводим документ, пока не завершится бизнес-процесс
		// ответственный за проведение документа
		Ответственный = ПараметрыСеанса.ТекущийПользователь;
		
		Проведен = Ложь;
		Записать(РежимЗаписиДокумента.Запись);
		
		Если НЕ БПИзменениеСостояния.Стартован Тогда 
			Попытка // запуск бизнес-процесса
				БПИзменениеСостояния.ПолучитьОбъект().Старт();
			Исключение
				Сообщить(ПараметрыСеанса.aps_ИмяПродукта+НСтр("ru = 'Не удалось запустить бизнес-процесс по причине:'; en_US = 'Failed to start the business process because of:'")+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), СтатусСообщения.Внимание);
				Отказ=Истина; Возврат;
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	Если НЕ ОтменитьИзвещение() Тогда 
		Отказ=Истина; Возврат;
	КонецЕсли;
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если ЭтоНовый() Тогда 
		#Если Клиент Или ВнешнееСоединение Тогда 
			// гл. переменная
		#Иначе
			aps_СтруктураПараметровОповещения=aps_СтруктураПараметровОповещенияНаСервере;
		#КонецЕсли
		
		aps_СтруктураПараметровОповещения.Вставить("itemObject",ЭтотОбъект);
		aps_ОбработчикиСобытий.aps_ВыполнитьСобытие(Перечисления.aps_События.ПриСозданииИИ, aps_СтруктураПараметровОповещения);
	КонецЕсли;
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	Для i=0 По ПользовательскиеИзменения.Количество()-1 Цикл 
		ОбъектХранилищаМодели=ПользовательскиеИзменения[i].ХранилищеМодели;
		ОбъектХранилищаМодели.ПолучитьОбъект().УстановитьПометкуУдаления(ПометкаУдаления);
		ОбъектХранилищаМодели=ПользовательскиеИзменения[i].ХранилищеМоделиДляОтменыИзменений;
		ОбъектХранилищаМодели.ПолучитьОбъект().УстановитьПометкуУдаления(ПометкаУдаления);
	КонецЦикла;
КонецПроцедуры

#КонецЕсли

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

#Если (ТолстыйКлиентОбычноеПриложение Или Сервер) И Не МобильноеПриложениеСервер Тогда

// Функция проводит извещение об изменении
//
// Параметры:
//		ДеревоИзменений - ДеревоЗначений
//
// Возвращаемое значение:
//		Булево - Истина, в случае успешного принятия изменений
Функция ПровестиИзвещение() Экспорт
	
	ТекущийПользователь=ПараметрыСеанса.ТекущийПользователь;
	ПримененнаяПолитика=ПараметрыСеанса.aps_ПримененнаяПолитика;
	// проведение извещения выполняется от лица владельца извещения
	ПараметрыСеанса.ТекущийПользователь=Ответственный;
	aps_ПолныеПрава.aps_ОбновитьПолитикуТекущегоПользователя();
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда 
		// гл. переменная
	#Иначе
		aps_СтруктураПараметровОповещения=aps_СтруктураПараметровОповещенияНаСервере;
	#КонецЕсли
	
	ЕстьОшибки=Ложь;
	
	// пользовательские изменения
	Для i=0 По ПользовательскиеИзменения.Количество()-1 Цикл 
		Попытка // десериализация из строки XML
			itemXDTO = Строка2XDTO(ПользовательскиеИзменения[i].ХранилищеМодели.ОбъектXDTO);
		Исключение
			Продолжить;
		КонецПопытки;
		
		Если itemXDTO <> Неопределено Тогда
			МассивПодчиненныхXDTO=aps_СформироватьМассивИзМоделиXDTO(itemXDTO);
			Для Каждого childItemXDTO Из МассивПодчиненныхXDTO Цикл 
				Если childItemXDTO.modified=Истина 
						И НЕ БПИзменениеСостояния.Пустая() И БПИзменениеСостояния.Состояния.Найти(childItemXDTO.element) <> Неопределено Тогда 
					// установить значение параметра "Состояние" в xdto-модели
					АктуальноеСостояние = МодульСозданияПараметров.aps_ВспомНайтиПараметрПоСвойству(childItemXDTO.element, ПланыВидовХарактеристик.aps_Свойства.Состояние).Значение;
					МодульСозданияПараметров.aps_УстановитьЗначениеПараметраПоСвойствуВXDTO(childItemXDTO, ПланыВидовХарактеристик.aps_Свойства.Состояние, АктуальноеСостояние);
				КонецЕсли;
			КонецЦикла;
			
			// сохранение xdto-модели пользовательских изменений
			aps_СохранитьИзмененияРедактированияXDTO(itemXDTO, aps_СтруктураПараметровОповещения, Истина);
			Если aps_НаличиеИзмененийВМоделиXDTO(itemXDTO) Тогда 
				ЕстьОшибки=Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	// измененные элементы
	Для Каждого СтрокаИзмененного Из ИзмененныеЭлементы Цикл 
		itemXDTO = aps_СоздатьОбъектМоделиXDTO(СтрокаИзмененного.ЭлементСсылка);
		// установить значения параметров ИИ в xdto-модели
		МодульСозданияПараметров.aps_УстановитьЗначениеПараметраПоСвойствуВXDTO(itemXDTO, ПланыВидовХарактеристик.aps_Свойства.ИзвещениеОбИзменении 	, Ссылка);
		МодульСозданияПараметров.aps_УстановитьЗначениеПараметраПоСвойствуВXDTO(itemXDTO, ПланыВидовХарактеристик.aps_Свойства.НомерИзменения		 	, СтрокаИзмененного.НомерИзменения);
		МодульСозданияПараметров.aps_УстановитьЗначениеПараметраПоСвойствуВXDTO(itemXDTO, ПланыВидовХарактеристик.aps_Свойства.ИзмененныеЛисты		 	, СтрокаИзмененного.ИзмененныеЛисты);
		МодульСозданияПараметров.aps_УстановитьЗначениеПараметраПоСвойствуВXDTO(itemXDTO, ПланыВидовХарактеристик.aps_Свойства.Подпись				 	, СтрокаИзмененного.Подпись);
		МодульСозданияПараметров.aps_УстановитьЗначениеПараметраПоСвойствуВXDTO(itemXDTO, ПланыВидовХарактеристик.aps_Свойства.ДатаВнесенияИзменения	, СтрокаИзмененного.ДатаВнесенияИзменения);
		
		// сохранение xdto-модели измененного элемента
		aps_СохранитьИзмененияРедактированияXDTO(itemXDTO, aps_СтруктураПараметровОповещения, Истина);
		Если aps_НаличиеИзмененийВМоделиXDTO(itemXDTO) Тогда 
			ЕстьОшибки=Истина;
		КонецЕсли;
	КонецЦикла;
	
	ПараметрыСеанса.ТекущийПользователь=ТекущийПользователь;
	ПараметрыСеанса.aps_ПримененнаяПолитика=ПримененнаяПолитика;
	
	
	Если ЕстьОшибки Тогда 
		Возврат Ложь;
	КонецЕсли;
	
	
	// создание и добавление архивных документов в карточку учета
	Для Каждого СтрокаИзмененного Из ИзмененныеЭлементы Цикл 
		item = СтрокаИзмененного.ЭлементСсылка;
		СтрокаСообщения = НСтр("ru = 'Элемент <'; en_US = 'The <'")+Строка(item)+НСтр("ru = '>. '; en_US = '> item. '");
		
		Если НЕ МодульБумАрхива.aps_НайтиКарточкуУчета(item).Пустая() Тогда 
			Попытка
				МодульБумАрхива.aps_СоздатьКарточкуУчета(item);
			Исключение
				СтрокаСообщения = СтрокаСообщения+НСтр("ru = 'При создании карточки учета произошла ошибка:'; en_US = 'Cannot create the archive card:'");
				Сообщить(ПараметрыСеанса.aps_ИмяПродукта+СтрокаСообщения+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), СтатусСообщения.Внимание);
				Возврат Ложь;
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
КонецФункции

// Функция отменяет проведение извещения об изменении
//
// Параметры:
//		ДеревоИзменений - ДеревоЗначений
//
// Возвращаемое значение:
//		Булево - Истина, в случае успешной отмены изменений
Функция ОтменитьИзвещение() Экспорт 
	
	ТекущийПользователь=ПараметрыСеанса.ТекущийПользователь;
	ПримененнаяПолитика=ПараметрыСеанса.aps_ПримененнаяПолитика;
	// отмена проведения извещения выполняется от лица владельца извещения
	ПараметрыСеанса.ТекущийПользователь=Ответственный;
	aps_ПолныеПрава.aps_ОбновитьПолитикуТекущегоПользователя();
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда 
		// гл. переменная
	#Иначе
		aps_СтруктураПараметровОповещения=aps_СтруктураПараметровОповещенияНаСервере;
	#КонецЕсли
	
	ЕстьОшибки=Ложь;
	
	Для i=0 По ПользовательскиеИзменения.Количество()-1 Цикл 
		Попытка // десериализация из строки XML
			itemXDTO = Строка2XDTO(ПользовательскиеИзменения[i].ХранилищеМоделиДляОтменыИзменений.ОбъектXDTO);
		Исключение
			Продолжить;
		КонецПопытки;
		
		Если itemXDTO <> Неопределено Тогда 
			aps_СохранитьИзмененияРедактированияXDTO(itemXDTO, aps_СтруктураПараметровОповещения, Истина);
			Если aps_НаличиеИзмененийВМоделиXDTO(itemXDTO) Тогда 
				ЕстьОшибки=Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ПараметрыСеанса.ТекущийПользователь=ТекущийПользователь;
	ПараметрыСеанса.aps_ПримененнаяПолитика=ПримененнаяПолитика;
	
	
	Если ЕстьОшибки Тогда 
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;
	
КонецФункции

// Процедура заполняет печатную форму извещения об изменении
//
// Параметры:
//  	КодСодержания 	- Строка, html-код содержания изменений
//		ИмяМакета		- Строка, имя макета печатной формы
//		ИмяФайла		- Строка, имя сформированного файла
//
// Возвращаемое значение:
//		нет
//
// Пример:
//		СформироватьПечатнуюФормуИИ(локКодСодержания, "МакетИИВертикальная", ИмяФайла);
//		
Процедура СформироватьПечатнуюФормуИИ(Знач КодСодержания, ИмяМакета, ИмяФайла) Экспорт
	МассивФайлов=Новый Массив;
	
	ПолноеИмяФайла=КаталогВременныхФайлов()+"1cpdm_temp\"+ИмяФайла;
	МассивФайлов=НайтиФайлы(ПолноеИмяФайла);
	ПолучитьМакет(ИмяМакета).Записать(ПолноеИмяФайла);
		
	Попытка
		Word = Новый COMОбъект("Word.Application");
	Исключение
		ВызватьИсключение НСтр("ru = 'Невозможно установить соединение с Microsoft Word!'; en_US = 'Cannot connect to Microsoft Word!'");
 	КонецПопытки;
 
	Попытка 
		Word.Documents.Open(ПолноеИмяФайла);
		Document = Word.ActiveDocument;
		Document.Activate();
		Document.Bookmarks("НаименованиеПредприятия").Range.InsertAfter(Константы.aps_НаименованиеОрганизации.Получить());
		Document.Bookmarks("НаименованиеПодразделения").Range.InsertAfter(Строка(Подразделение));
		Document.Bookmarks("НомерИзвещения1").Range.InsertAfter(СокрЛП(Номер));
		Document.Bookmarks("НомерИзвещения2").Range.InsertAfter(СокрЛП(Номер)); 
		Document.Bookmarks("ДатаВыпуска").Range.InsertAfter(Формат(Дата, "ДФ=dd.MM.yyyy"));
		Document.Bookmarks("СрокИзм").Range.InsertAfter(Формат(СрокИзменения, "ДФ=dd.MM.yyyy"));
		Document.Bookmarks("ПричинаИзменения").Range.InsertAfter(Строка(Причина));
		Document.Bookmarks("КодПричины").Range.InsertAfter(Строка(КодПричины));
		Document.Bookmarks("УказаниеОЗаделе").Range.InsertAfter(Строка(УказанияОЗаделе)); 
		Document.Bookmarks("УказаниеОВнедрении").Range.InsertAfter(УказаниеОВнедрении);
		Document.Bookmarks("Составил").Range.InsertAfter(Строка(Владелец));
		Document.Bookmarks("ИзменениеВнес").Range.InsertAfter(Строка(БПИзменениеСостояния.ОтветственныйЗаВыполнение));
		Если ИзмененныеЭлементы.Количество()=1 тогда 
			Document.Bookmarks("Изм1").Range.InsertAfter(Строка(ИзмененныеЭлементы[0].НомерИзменения));
			Document.Bookmarks("Изм2").Range.InsertAfter(Строка(ИзмененныеЭлементы[0].НомерИзменения));
		ИначеЕсли ИзмененныеЭлементы.Количество()>1 тогда
			НомераИзменений=Новый ТаблицаЗначений;
			НомераИзменений=ИзмененныеЭлементы.ВыгрузитьКолонки("НомерИзменения");
			НомераИзменений.Свернуть("НомерИзменения");
			Если НомераИзменений.Количество()=1 тогда
				Document.Bookmarks("Изм1").Range.InsertAfter(Строка(ИзмененныеЭлементы[0].НомерИзменения));
				Document.Bookmarks("Изм2").Range.InsertAfter(Строка(ИзмененныеЭлементы[0].НомерИзменения));
			Иначе
				Document.Bookmarks("Изм1").Range.InsertAfter("-");
				Document.Bookmarks("Изм2").Range.InsertAfter("-");
			КонецЕсли;
		КонецЕсли;
		
		ДокументHTML = Новый ТекстовыйДокумент;
		
		// колонтитул не может быть больше половины страницы по высоте, поэтому добавляем лишний параграф
		ПозицияBODY=Найти(ВРег(КодСодержания), "<BODY>");
		КодСодержания=Лев(КодСодержания, ПозицияBODY+5)+"<P>&nbsp;</P>"+Сред(КодСодержания, ПозицияBODY+6);
		ДокументHTML.ДобавитьСтроку(КодСодержания);
		
		ИмяВременногоФайлов=ПолучитьИмяВременногоФайла("htm");
		ДокументHTML.Записать(ИмяВременногоФайлов);
		Document.ActiveWindow.Selection.InsertFile( ИмяВременногоФайлов,, False );
		УдалитьФайлы(ИмяВременногоФайлов);
  
		Для Каждого Bookmark Из Document.Bookmarks Цикл
			Bookmark.Delete();
		КонецЦикла;
   
		Document.Save();
		Word.Visible = True;
		Word.Activate();
		Word.Selection.GoTo(1, 2, , "1");
  
	Исключение
		Word.Quit(false);
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

#КонецЕсли

#КонецОбласти


#Область Инициализация

#Если (ТолстыйКлиентОбычноеПриложение Или Сервер) И Не МобильноеПриложениеСервер Тогда

МодульСозданияОбъектов	 = Обработки.aps_СозданиеОбъектов.Создать();
МодульСозданияПараметров = Обработки.aps_СозданиеПараметров.Создать();

МодульБумАрхива = Обработки.aps_КарточкиУчетаДокументов.Создать();

#Если Сервер Тогда 
aps_СтруктураПараметровОповещенияНаСервере=Новый Структура();
#КонецЕсли

#КонецЕсли

#КонецОбласти