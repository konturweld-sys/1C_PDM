
#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, Режим)
	СтрокаОшибки = "";
	Если Не ЗначениеЗаполнено(Абонент) Тогда
		СтрокаОшибки = НСтр("ru = 'Необходимо указать абонента!'; en_US = 'Subscriber must be specified!'") + Символы.ПС;
	КонецЕсли;
	
	БлокировкаДанных = Новый БлокировкаДанных;
	ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрНакопления.aps_ТиражированиеКопий");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.УстановитьЗначение("Абонент", Абонент);
	ЭлементБлокировки.УстановитьЗначение("ВидОперации", Перечисления.aps_ВидыОпераций.Возврат);
	ЭлементБлокировки.ИсточникДанных = ДокументыВозврата;
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Документ", "Документ");
	БлокировкаДанных.Заблокировать();
	
	Для Каждого ТекСтрокаДокументы Из ДокументыВозврата Цикл
		Если ТекСтрокаДокументы.Документ.Пустая() ИЛИ ТекСтрокаДокументы.КарточкаУчета.Пустая() Тогда
			СтрокаОшибки = СтрокаОшибки + НСтр("ru = 'Строка '; en_US = ''") + ТекСтрокаДокументы.НомерСтроки + НСтр("ru = '. Не заполнены обязательные поля.'; en_US = ' row. Required fields are not specified.'") + Символы.ПС;
		КонецЕсли;
		
		Движение = Движения.aps_ТиражированиеКопий.Добавить();
		Движение.ВидОперации	= Перечисления.aps_ВидыОпераций.Возврат;
		Движение.ВидДвижения	= ВидДвиженияНакопления.Приход;
		Движение.ВидОперации	= Перечисления.aps_ВидыОпераций.Возврат;
		Движение.Период			= Дата;
		Движение.Документ		= ТекСтрокаДокументы.Документ;
		Движение.Абонент		= Абонент;
		Движение.Количество		= ТекСтрокаДокументы.Количество;
	КонецЦикла;
	
	Если НЕ ПустаяСтрока(СтрокаОшибки) Тогда
		Сообщить(ПараметрыСеанса.aps_ИмяПродукта + СтрокаОшибки);
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
