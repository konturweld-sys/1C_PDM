
#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДокументОснования)
	Если ТипЗнч(ДокументОснования) = Тип("ДокументСсылка.aps_ИзвещениеОбИзменении") Тогда
		ЗаявкаНаТиражирование = Документы.aps_ЗаявкаНаТиражирование.НайтиПоРеквизиту("Основание", ДокументОснования);
		Если ЗаявкаНаТиражирование.Пустая() Тогда
			Заказчик = ДокументОснования.Подразделение;
			Основание = ДокументОснования;
			
			МассивИзмененных = Основание.ИзмененныеЭлементы.ВыгрузитьКолонку("ЭлементСсылка");
			Для Каждого ЭлементСсылка Из МассивИзмененных Цикл 
				АрхивныйДокумент = Обработки.aps_КарточкиУчетаДокументов.Создать().aps_НайтиАрхивныйДокумент(ЭлементСсылка);
				Если НЕ АрхивныйДокумент.Пустая() Тогда
					НоваяСтрока = ДокументыКВыдаче.Добавить();
					НоваяСтрока.КарточкаУчета	= АрхивныйДокумент.Владелец;
					НоваяСтрока.Документ		= АрхивныйДокумент;
					НоваяСтрока.Количество		= 1;
				КонецЕсли;
			КонецЦикла;
			
			ПолучитьФорму().Открыть();
		Иначе
			ЗаявкаНаТиражирование.ПолучитьФорму().Открыть();
		КонецЕсли;
	ИначеЕсли ТипЗнч(ДокументОснования) = Тип("ДокументСсылка.aps_ВозвратДокументации") Тогда
		Заказчик = ДокументОснования.Абонент;
		Для Каждого Строка Из ДокументОснования.ДокументыВозврата Цикл
			НоваяСтрока = ДокументыКВыдаче.Добавить();
			НоваяСтрока.Абонент = ДокументОснования.Абонент;
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	СтрокаОшибки = "";
	Если Не ЗначениеЗаполнено(Заказчик) Тогда
		СтрокаОшибки = НСтр("ru = 'Не заполнен заказчик!'; en_US = 'Customer is not specified!'") + Символы.ПС;
	КонецЕсли;
	
	БлокировкаДанных = Новый БлокировкаДанных;
	ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрНакопления.aps_ТиражированиеКопий");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.УстановитьЗначение("Основание", Ссылка);
	ЭлементБлокировки.УстановитьЗначение("ВидОперации", Перечисления.aps_ВидыОпераций.Заявка);
	ЭлементБлокировки.ИсточникДанных = ДокументыКВыдаче;
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Документ", "Документ");
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Абонент", "Абонент");
	БлокировкаДанных.Заблокировать();
	
	Для Каждого СтрокаКВыдаче Из ДокументыКВыдаче Цикл 
		Если СтрокаКВыдаче.Количество <> 0 Тогда
			Если НЕ ЗначениеЗаполнено(СтрокаКВыдаче.Абонент) ИЛИ НЕ ЗначениеЗаполнено(СтрокаКВыдаче.КарточкаУчета)
					ИЛИ НЕ ЗначениеЗаполнено(СтрокаКВыдаче.Документ) Тогда
				
				СтрокаОшибки = СтрокаОшибки + НСтр("ru = 'Строка '; en_US = ''") + СтрокаКВыдаче.НомерСтроки + НСтр("ru = '. Не заполнены обязательные поля.'; en_US = ' row. Required fields are not specified.'") + Символы.ПС;
			КонецЕсли;
			
			Движение = Движения.aps_ТиражированиеКопий.Добавить();
			Движение.ВидДвижения	= ВидДвиженияНакопления.Приход;
			Движение.ВидОперации	= Перечисления.aps_ВидыОпераций.Заявка;
			Движение.Период			= Дата;
			Движение.Документ		= СтрокаКВыдаче.Документ;
			Движение.Абонент		= СтрокаКВыдаче.Абонент;
			Движение.Основание		= Ссылка;
			Движение.Количество		= СтрокаКВыдаче.Количество;
		КонецЕсли;
	КонецЦикла;     
	
	Если НЕ ПустаяСтрока(СтрокаОшибки) Тогда
		Сообщить(ПараметрыСеанса.aps_ИмяПродукта + СтрокаОшибки);
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
