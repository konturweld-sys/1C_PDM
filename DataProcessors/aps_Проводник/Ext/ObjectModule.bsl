#Если Не МобильноеПриложениеСервер Тогда
	
#Область ОписаниеПеременных

Перем ФормаОбработки Экспорт; // Основная форма обработки

Перем ВидСвязиРевизии Экспорт; // Шаблон технологической связи "Ревизии"

Перем СсылкаОбщиеПапки Экспорт; // Ссылка справочника "Элементы справочников", виртуальный каталог "Общие папки"
Перем СсылкаНесвязанные Экспорт; // Ссылка справочника "Элементы справочников", виртуальный каталог "Несвязанные элементы"

Перем ВидЭлементаПапка Экспорт; // Вид элемента "Папка"
Перем ВидЭлементаЛичнаяПапка Экспорт; // Вид элемента "Личная папка"

#КонецОбласти


#Область ПрограммныйИнтерфейс

// Процедура обновляет модель данных для данного объекта
// Параметры:
//		parentXDTO - ОбъектXDTO, объект модели XDTO
//		ПравилоУправления - СправочникСсылка.aps_ПравилаУправления, Строка
//		ИгнорироватьНесвязанныеРевизии - Булево
// Пример:
//		aps_ОбновитьМодельXDTO(itemXDTO, ПравилоУправления);
//
Процедура aps_ОбновитьМодельXDTO( parentXDTO, Знач ПравилоУправления = Неопределено, ИгнорироватьНесвязанныеРевизии = Ложь ) Экспорт 
	
	Если parentXDTO.element = СсылкаОбщиеПапки Тогда 
		
		ОбщиеПапки = aps_ПолучитьОбщиеПапки();

		Для i=0 По ОбщиеПапки.Количество()-1 Цикл 
			itemXDTO = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("http://appius.ru/pdm", "item"));
			itemXDTO.element		= СериализаторXDTO.ЗаписатьXDTO(ОбщиеПапки[i].ЭлементСсылка);
			itemXDTO.elementType	= ВидЭлементаПапка;
			itemXDTO.description	= ОбщиеПапки[i].ПредставлениеЭлемента;
			itemXDTO.pictureIndex	= ОбщиеПапки[i].Картинка;
			itemXDTO.refLinkGroup	= Ложь;
			
			parentXDTO.items.Добавить(itemXDTO);
		КонецЦикла;
		
	ИначеЕсли parentXDTO.element = СсылкаНесвязанные Тогда 	
		
		НесвязанныеЭлементы = aps_Итераторы.aps_НесвязанныеЭлементы(ПараметрыСеанса.ТекущийПользователь, ИгнорироватьНесвязанныеРевизии);
		Для i=0 По НесвязанныеЭлементы.Количество()-1 Цикл 
			itemXDTO = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("http://appius.ru/pdm", "item"));
			itemXDTO.element		= СериализаторXDTO.ЗаписатьXDTO(НесвязанныеЭлементы[i].ЭлементСсылка);
			itemXDTO.elementType	= НесвязанныеЭлементы[i].ВидЭлемента;
			itemXDTO.description	= НесвязанныеЭлементы[i].ПредставлениеЭлемента;
			itemXDTO.pictureIndex	= НесвязанныеЭлементы[i].Картинка;
			itemXDTO.refLinkGroup	= Ложь;
			
			parentXDTO.items.Добавить(itemXDTO);
		КонецЦикла;
		
	ИначеЕсли ЗначениеЗаполнено( parentXDTO.element ) Тогда 
		
		parentXDTOArray=Новый Массив;
		parentXDTOArray.Добавить(parentXDTO);
		aps_ОбновитьМодельXDTOРек(parentXDTOArray, ПравилоУправления, 1);
		
	КонецЕсли;
	
КонецПроцедуры

// Процедура рекурсивно обновляет модель данных для массива объектов
// Параметры:
//		parentXDTOArray - массив объектов XDTO-модели
//		ПравилоУправления - СправочникСсылка.aps_ПравилаУправления, Строка
//		КолУровней (необязательный) - Число или Неопределено, число уровней для построения
//		ВключаяПараметры - Булево, заполнить параметры в XDTO-модели
// Пример:
//		aps_ОбновитьМодельXDTOРек(parentXDTOArray, ПравилоУправления, 1);
//
Процедура aps_ОбновитьМодельXDTOРек( parentXDTOArray, Знач ПравилоУправления = Неопределено, КолУровней = Неопределено, ВключаяПараметры = Истина, МассивИтераторов = Неопределено, СоответствиеЭлементовИПрав = Неопределено ) Экспорт 
	
	#Если Клиент Тогда 
		ОбработкаПрерыванияПользователя();
	#КонецЕсли
	
	Если КолУровней = 0 Тогда 
		Возврат;
	КонецЕсли;
	
	Если parentXDTOArray.Количество() = 0 Тогда 
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ПравилоУправления)=Тип("СправочникОбъект.aps_ПравилаУправления") Тогда 
		// сериализация в строку XML для передачи на сервер
		ПравилоУправления = Object1С2Строка(ПравилоУправления);
	КонецЕсли;
	
	// сформировать массив родителей
	parentArray = Новый Массив; parentTypesArray = Новый Массив;
	Для Каждого parentXDTO Из parentXDTOArray Цикл 
		Если ЗначениеЗаполнено(parentXDTO.element) Тогда 
			parentArray.Добавить(parentXDTO.element);	// элемент-родитель
			parentTypesArray.Добавить(parentXDTO.elementType);
		КонецЕсли;
		Если ЗначениеЗаполнено(parentXDTO.link) И ТипЗнч(parentXDTO.linkType)=Тип("СправочникСсылка.aps_ШаблоныТехнологическихСвязей") Тогда 
			parentArray.Добавить(parentXDTO.link);		// связь-родитель
		КонецЕсли;
	КонецЦикла;
	
	Если parentArray.Количество()=1 Тогда 
		parentArray=parentArray[0];
	КонецЕсли;
	
	Если МассивИтераторов = Неопределено Тогда 
		МассивИтераторов = Новый Массив();
		МассивИтераторов.Добавить("aps_ПодчиненныеЭлементы");
		МассивИтераторов.Добавить("aps_ЭлементныеСвязи");
		Если parentTypesArray.Найти(ВидЭлементаПапка)<>Неопределено 
					Или parentTypesArray.Найти(ВидЭлементаЛичнаяПапка)<>Неопределено Тогда 
			МассивИтераторов.Добавить("aps_ВертикальныеСвязиПапок");
		КонецЕсли;
	КонецЕсли;
	
	// вызвать итераторы для массива элементов
	МассивРезультатов = Новый Массив();
	Для Каждого Итератор Из МассивИтераторов Цикл 
		РезультатыИтератора = Вычислить("aps_Итераторы."+Итератор+"( parentArray, ПравилоУправления, ВключаяПараметры )");
		Если РезультатыИтератора.Количество() > 0 Тогда 
			МассивРезультатов.Добавить(РезультатыИтератора);
		КонецЕсли;
	КонецЦикла;
	
	// результатов нет вообще
	Если МассивРезультатов.Количество() = 0  Тогда 
		Возврат;
	КонецЕсли;
	
	// массив подчиненных объектов
	childXDTOArray = Новый Массив;
	
	Если СоответствиеЭлементовИПрав = Неопределено Тогда 
		СоответствиеЭлементовИПрав = Новый Соответствие;
	КонецЕсли;
	
	Для Каждого parentXDTO Из parentXDTOArray Цикл 
		
		Если parentXDTO.refLinkGroup Тогда 
			Продолжить;
		КонецЕсли;
		
		СтруктураОтбораСтрок = Новый Структура("РодительСсылка", parentXDTO.element);
		
		локМассивРезультатов = Новый Массив();
		Для Каждого Результат Из МассивРезультатов Цикл 
			локМассивРезультатов.Добавить(Результат.НайтиСтроки(СтруктураОтбораСтрок));
		КонецЦикла;
		
		ПросмотрРазрешен = СоответствиеЭлементовИПрав.Получить(parentXDTO.element);
		Если ПросмотрРазрешен = Неопределено Тогда 
			ПросмотрРазрешен = МодульПравДоступа.aps_ПроверитьОбъектПрава(Справочники.aps_Права.Просмотр, parentXDTO.element, parentXDTO.element.GMOD);
			СоответствиеЭлементовИПрав.Вставить(parentXDTO.element, ПросмотрРазрешен);
		КонецЕсли;
		
		Если НЕ ПросмотрРазрешен Тогда 
			Продолжить;
		КонецЕсли;

		Для i=0 По локМассивРезультатов.Количество()-1 Цикл 
			локРезультат = локМассивРезультатов[i];
			
			локРезультат2 = МассивРезультатов[i].Скопировать(Новый Структура("РодительСсылка", parentXDTO.link));
			Если локРезультат2.Количество() > 0 Тогда 
				Для Каждого СтрокаРезультата Из локРезультат Цикл 
					ЗаполнитьЗначенияСвойств(локРезультат2.Добавить(), СтрокаРезультата);
				КонецЦикла;
				
				локРезультат2.Сортировать("КодВидаСвязи, ВидСвязи, ОбратнаяСвязь, ПорядокВывода, КодВидаЭлемента, ПредставлениеЭлемента");
				локРезультат = локРезультат2;
			КонецЕсли;

			
			itemRefXDTO=Неопределено;
			
			ВидСвязи=Неопределено; ОбратнаяСвязь=Неопределено;
			Для Каждого СтрокаРезультата Из локРезультат Цикл 
				Если parentXDTO.Владелец() <> Неопределено И parentXDTO.Владелец().refLinkGroup И КолУровней = Неопределено
						И СтрокаРезультата.ВидСвязи = Перечисления.aps_ВидыСвязей.СоставИзделия Тогда 
					Продолжить;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(СтрокаРезультата.ЭлементСвязи) И parentXDTO.link = СтрокаРезультата.ЭлементСвязи Тогда 
					Продолжить;
				КонецЕсли;
				
				Если ВидСвязи <> СтрокаРезультата.ВидСвязи ИЛИ (ОбратнаяСвязь <> СтрокаРезультата.ОбратнаяСвязь) Тогда 
					ВидСвязи = СтрокаРезультата.ВидСвязи;
					ОбратнаяСвязь = СтрокаРезультата.ОбратнаяСвязь;
					Если ТипЗнч(ВидСвязи) = Тип("СправочникСсылка.aps_ШаблоныТехнологическихСвязей") И ЗначениеЗаполнено(СтрокаРезультата.ЭлементСвязи) Тогда
						itemRefXDTO = aps_СоздатьОбъектМоделиXDTO(ВидСвязи, СтрокаРезультата);
						parentXDTO.items.Добавить(itemRefXDTO);
					КонецЕсли;
				КонецЕсли;
				
				itemXDTO = aps_СоздатьОбъектМоделиXDTO(СтрокаРезультата.ЭлементСсылка, СтрокаРезультата, ВключаяПараметры);
				Если ЗначениеЗаполнено(СтрокаРезультата.ЭлементСвязи) Тогда 
					itemXDTO.link = СериализаторXDTO.ЗаписатьXDTO(СтрокаРезультата.ЭлементСвязи);
				КонецЕсли;
				
				itemXDTO.linkType		= СериализаторXDTO.ЗаписатьXDTO(СтрокаРезультата.ВидСвязи);
				itemXDTO.sequenceNumber	= СтрокаРезультата.ПорядокВывода;
				
				Если СтрокаРезультата.РевизияПодобрана=Истина Тогда 
					itemXDTO.revised = Истина;
				КонецЕсли;
				
				Если ВключаяПараметры Тогда // Параметры связи
					aps_ЗаполнитьПараметрыМоделиПоТаблице(itemXDTO, СтрокаРезультата.ПараметрыЭлементаСвязи, Истина);
				КонецЕсли;
				
				Если itemRefXDTO <> Неопределено Тогда 
					itemRefXDTO.items.Добавить(itemXDTO);
				Иначе 
					parentXDTO.items.Добавить(itemXDTO);
				КонецЕсли;
				
				Если ОбратнаяСвязь <> Истина Тогда 
					// добавить подчиненный объект в общий массив
					childXDTOArray.Добавить(itemXDTO);
				КонецЕсли;
			КонецЦикла;

		КонецЦикла;
		
	КонецЦикла;
	
	Если КолУровней = Неопределено Или КолУровней > 1 Тогда
		i = 0;
		Пока i < childXDTOArray.Количество() Цикл 
			parentXDTO = childXDTOArray[i].Владелец();
			УдалитьИзМассива=Ложь;
			Пока parentXDTO <> Неопределено Цикл 
				Если parentXDTO.element=childXDTOArray[i].element Тогда 
					УдалитьИзМассива=Истина;
					Прервать;
				КонецЕсли;
				parentXDTO=parentXDTO.Владелец();
			КонецЦикла;
			Если УдалитьИзМассива Тогда 
				childXDTOArray.Удалить(i);
			Иначе 
				i=i+1;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// вызвать рекурсивно для подчиненных объектов
	aps_ОбновитьМодельXDTOРек(childXDTOArray, ПравилоУправления, ?(КолУровней=Неопределено,Неопределено,КолУровней-1), ВключаяПараметры, МассивИтераторов, СоответствиеЭлементовИПрав);
	
КонецПроцедуры

// Процедура обновляет дерево представления по модели данных
// Параметры:
//		parentXDTO - объект модели XDTO
//		СтрокиДереваПредставления - строки дерева представления формы для обновления (необязательный)
//		ПараметрыОтображения - структура параметров отображения дерева (необязательный)
// Пример:
//		aps_ОбновитьДеревоПоМоделиXDTO(parentXDTO, СтрокаРодителя.Строки, СтруктураПараметровОтображения);
//
Процедура aps_ОбновитьДеревоПоМоделиXDTO( parentXDTO, СтрокиДереваПредставления, ПараметрыОтображения = Неопределено ) Экспорт 
	ФлагПервичногоЗаполнения = (СтрокиДереваПредставления.Количество() = 0);
	
	insert=0;
	itemXDTOArray = Новый Массив();
	Для Каждого itemXDTO Из parentXDTO.items Цикл 
		Если ПараметрыОтображения <> Неопределено 
						И ПараметрыОтображения.Свойство("БезГоризонтальныхСвязей") И ПараметрыОтображения.БезГоризонтальныхСвязей=Истина Тогда 
			// Отображать без горизонтальных связей
			Если itemXDTO.refLinkGroup Тогда 
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Если ПараметрыОтображения <> Неопределено 
						И ПараметрыОтображения.Свойство("БезЭлементовРесурса") И ПараметрыОтображения.БезЭлементовРесурса = Истина Тогда 
			// Отображать без элементов ресурса
			Если НЕ itemXDTO.refLinkGroup И НЕ parentXDTO.refLinkGroup 
						И parentXDTO.elementType=Справочники.aps_ВидыЭлементов.Ресурс И itemXDTO.linkType=Справочники.aps_ШаблоныТехнологическихСвязей.Ресурсы Тогда 
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Если ПараметрыОтображения <> Неопределено
						И ПараметрыОтображения.Свойство("ТолькоВертикальныеСвязи") И ПараметрыОтображения.ТолькоВертикальныеСвязи=Истина Тогда 
			// Отображать только личные папки
			Если ЗначениеЗаполнено(itemXDTO.linkType)
					И itemXDTO.linkType<>Перечисления.aps_ВидыСвязей.Личное И itemXDTO.linkType<>Перечисления.aps_ВидыСвязей.Справочник Тогда 
				Продолжить;
			КонецЕсли;			
		КонецЕсли;

		
		Если ПараметрыОтображения <> Неопределено
						И ПараметрыОтображения.Свойство("ТолькоСборки") И ПараметрыОтображения.ТолькоСборки=Истина Тогда 
			// Отображать только сборки (для горизонтальных связей фильтр не действует)
			Если НЕ itemXDTO.refLinkGroup И НЕ parentXDTO.refLinkGroup 
						И itemXDTO.elementType <> Справочники.aps_ВидыЭлементов.Комплекс
						И itemXDTO.elementType <> Справочники.aps_ВидыЭлементов.СбЕдиница
						И itemXDTO.elementType <> Справочники.aps_ВидыЭлементов.Комплект Тогда 
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Если ПараметрыОтображения <> Неопределено 
						И ПараметрыОтображения.Свойство("БезПовторов") И ПараметрыОтображения.БезПовторов=Истина Тогда 
			СтрокаПовтор = СтрокиДереваПредставления.Найти(itemXDTO.element, "ЭлементСсылка");
			// Отображать без повторов
			Если НЕ itemXDTO.refLinkGroup И СтрокаПовтор <> Неопределено 
					И СтрокаПовтор.ОбъектXDTO <> itemXDTO И СтрокаПовтор.ОбъектXDTO.Владелец() <> Неопределено Тогда 
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		СтрокаДереваПредставления = ?(ФлагПервичногоЗаполнения, Неопределено, СтрокиДереваПредставления.Найти(itemXDTO, "ОбъектXDTO"));
		Если СтрокаДереваПредставления = Неопределено Тогда 
			СтрокаДереваПредставления = СтрокиДереваПредставления.Вставить(insert);
		ИначеЕсли insert <> СтрокиДереваПредставления.Индекс(СтрокаДереваПредставления) Тогда 
			СтрокиДереваПредставления.Сдвинуть(СтрокаДереваПредставления, insert-СтрокиДереваПредставления.Индекс(СтрокаДереваПредставления));
		КонецЕсли;
		
		itemXDTOArray.Добавить(itemXDTO);
		
		insert=insert+1;
		
		СтрокаДереваПредставления.ОбъектXDTO	= itemXDTO;
		
		Если НЕ itemXDTO.refLinkGroup Тогда 
			СтрокаДереваПредставления.Картинка			= itemXDTO.pictureIndex;
			СтрокаДереваПредставления.ЭлементСсылка		= itemXDTO.element;
		Иначе // Группа горизонтальных связей
			СтрокаДереваПредставления.Картинка			= itemXDTO.pictureIndex;
			СтрокаДереваПредставления.ВетвьПостроена	= Истина;
			
			// Вызвать рекурсивно функцию
			aps_ОбновитьДеревоПоМоделиXDTO(itemXDTO, СтрокаДереваПредставления.Строки, ПараметрыОтображения);
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ ФлагПервичногоЗаполнения Тогда 
		i=0;
		Пока i < СтрокиДереваПредставления.Количество() Цикл 
			СтрокаДереваПредставления = СтрокиДереваПредставления[i];
			Если itemXDTOArray.Найти(СтрокаДереваПредставления.ОбъектXDTO) = Неопределено Тогда 
				Если СтрокаДереваПредставления.Строки.Количество() > 0 Тогда 
					СтрокаДереваПредставления.Строки.Очистить();
				КонецЕсли;
				СтрокиДереваПредставления.Удалить(СтрокаДереваПредставления);
			Иначе 
				i=i+1;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	
	// отображение ревизий в дереве
	ПоказыватьРевизииВДереве=Ложь;
	Если ПараметрыОтображения<>Неопределено И ПараметрыОтображения.Свойство("СРевизиями") Тогда 
		ПоказыватьРевизииВДереве=(ПараметрыОтображения.СРевизиями=Истина);
	КонецЕсли;
	
	Если ПоказыватьРевизииВДереве И ЗначениеЗаполнено(parentXDTO.element)
				И НЕ (parentXDTO.Владелец()<>Неопределено И parentXDTO.Владелец().refLinkGroup И parentXDTO.Владелец().linkType=ВидСвязиРевизии) Тогда 
		item=parentXDTO.element;
		ОригиналРевизии=?(ЗначениеЗаполнено(item.ОригиналРевизии), item.ОригиналРевизии, item);
		Ревизии=МодульСозданияРевизий.aps_ПолучитьРевизииЭлемента(ОригиналРевизии,, Истина);
		Если Ревизии.Количество() > 0 Тогда 
			// добавить оригинал в список
			СтрокаОригинала=Ревизии.Вставить(0);
			СтрокаОригинала.Картинка		= ?(ОригиналРевизии.ИндексКартинки=0, ОригиналРевизии.ВидЭлемента.ИндексКартинки, ОригиналРевизии.ИндексКартинки);
			СтрокаОригинала.ЭлементСсылка	= ОригиналРевизии;
			СтрокаОригинала.ВидЭлемента		= ОригиналРевизии.ВидЭлемента;
			
			itemRefXDTO=aps_СоздатьОбъектМоделиXDTO(ВидСвязиРевизии);
			itemRefXDTO.description="Ревизии";
            // создать объекты xdto ревизий
			Для i=0 По Ревизии.Количество()-1 Цикл 
				Если Ревизии[i].ЭлементСсылка=item Тогда 
					Продолжить; // этот же элемент
				КонецЕсли;
				
				itemXDTO = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("http://appius.ru/pdm", "item"));
				itemXDTO.element		= СериализаторXDTO.ЗаписатьXDTO(Ревизии[i].ЭлементСсылка);
				itemXDTO.elementType	= СериализаторXDTO.ЗаписатьXDTO(Ревизии[i].ВидЭлемента);
				itemXDTO.description	= Строка(Ревизии[i].ЭлементСсылка);
				itemXDTO.pictureIndex	= Ревизии[i].Картинка;
				itemXDTO.refLinkGroup	= Ложь;
				
				itemRefXDTO.items.Добавить(itemXDTO);
			КонецЦикла;
			
			СтрокаГруппировкиРевизий=СтрокиДереваПредставления.Добавить();
			СтрокаГруппировкиРевизий.ОбъектXDTO		= itemRefXDTO;
			СтрокаГруппировкиРевизий.ВетвьПостроена	= Истина;
			// обновить строку группировки ревизий по модели xdto (третьим параметром - Неопределено)
			aps_ОбновитьДеревоПоМоделиXDTO(itemRefXDTO, СтрокаГруппировкиРевизий.Строки, Неопределено);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
	
// Процедура обновляет дерево представления по модели данных целиком
// Параметры:
//		parentXDTO - объект модели XDTO
//		СтрокиДереваПредставления - строки дерева представления формы для обновления (необязательный)
//		ПараметрыОтображения - структура параметров отображения дерева (необязательный)
// Пример:
//		aps_ОбновитьДеревоПоМоделиXDTOРек( itemXDTO, СтрокаДереваПредставления.Строки, СтруктураПараметровОтображения );
//
Процедура aps_ОбновитьДеревоПоМоделиXDTOРек( parentXDTO, СтрокиДереваПредставления, ПараметрыОтображения = Неопределено ) Экспорт 
	
	Если НЕ parentXDTO.refLinkGroup Тогда 
		aps_ОбновитьДеревоПоМоделиXDTO(parentXDTO, СтрокиДереваПредставления, ПараметрыОтображения);
	КонецЕсли;
	
	Для Каждого СтрокаДереваПредставления Из СтрокиДереваПредставления Цикл 
		itemXDTO = СтрокаДереваПредставления.ОбъектXDTO;
		
		aps_ОбновитьДеревоПоМоделиXDTOРек(itemXDTO, СтрокаДереваПредставления.Строки, ПараметрыОтображения);
		СтрокаДереваПредставления.ВетвьПостроена = itemXDTO.items.Количество()>0;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти


#Область УправляемаяФорма

// Процедура обновляет дерево представления по модели данных целиком
// Параметры:
//		parentXDTO		- объект модели XDTO
//		СтрокиДерева	- ДанныеФормыКоллекцияЭлементовДерева для обновления
//		КолУровней		- число уровней для обновления
// Пример:
//		ЭтотОбъект.aps_ОбновитьЭлементыДереваПоМоделиXDTOРек( parentXDTO, Подстроки, Уровней, ПоказатьРевизии );
//
Процедура aps_ОбновитьЭлементыДереваПоМоделиXDTOРек( parentXDTO, СтрокиДерева, Знач КолУровней = Неопределено, ПоказатьРевизииРодителя = Истина ) Экспорт 
	Для Каждого itemXDTO Из parentXDTO.items Цикл 
		СтрокаДерева = СтрокиДерева.Добавить();
		aps_ЗаполнитьЭлементДереваПоМоделиXDTO(itemXDTO, СтрокаДерева);
		
		Если КолУровней = Неопределено Или КолУровней > 1 Или itemXDTO.refLinkGroup Тогда 
			ПодстрокиДерева = СтрокаДерева.ПолучитьЭлементы();
			aps_ОбновитьЭлементыДереваПоМоделиXDTOРек( itemXDTO, ПодстрокиДерева, ?(КолУровней=Неопределено, КолУровней, КолУровней-1) );
			СтрокаДерева.ВетвьПостроена = (itemXDTO.items.Количество() > 0);
		КонецЕсли;
	КонецЦикла;
	
	
	Если ПоказатьРевизииРодителя И ЗначениеЗаполнено(parentXDTO.element) Тогда 
		item=parentXDTO.element;
		ОригиналРевизии=?(ЗначениеЗаполнено(item.ОригиналРевизии), item.ОригиналРевизии, item);
		Ревизии=МодульСозданияРевизий.aps_ПолучитьРевизииЭлемента(ОригиналРевизии,, Истина);
		Если Ревизии.Количество() > 0 Тогда 
			// добавить оригинал в список
			СтрокаОригинала=Ревизии.Вставить(0);
			СтрокаОригинала.Картинка		= ?(ОригиналРевизии.ИндексКартинки=0, ОригиналРевизии.ВидЭлемента.ИндексКартинки, ОригиналРевизии.ИндексКартинки);
			СтрокаОригинала.ЭлементСсылка	= ОригиналРевизии;
			СтрокаОригинала.ВидЭлемента		= ОригиналРевизии.ВидЭлемента;
			
			itemRefXDTO=aps_СоздатьОбъектМоделиXDTO(ВидСвязиРевизии);
			itemRefXDTO.description=НСтр("ru = ""Ревизии""; en_US = ""Revisions""");
			itemRefXDTO.pictureIndex=10;
            // создать объекты xdto ревизий
			Для i=0 По Ревизии.Количество()-1 Цикл 
				Если Ревизии[i].ЭлементСсылка=item Тогда 
					Продолжить; // этот же элемент
				КонецЕсли;
				
				itemXDTO = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("http://appius.ru/pdm", "item"));
				itemXDTO.element		= СериализаторXDTO.ЗаписатьXDTO(Ревизии[i].ЭлементСсылка);
				itemXDTO.elementType	= СериализаторXDTO.ЗаписатьXDTO(Ревизии[i].ВидЭлемента);
				itemXDTO.description	= Строка(Ревизии[i].ЭлементСсылка);
				itemXDTO.pictureIndex	= Ревизии[i].Картинка;
				itemXDTO.refLinkGroup	= Ложь;
				
				itemRefXDTO.items.Добавить(itemXDTO);
			КонецЦикла;
			
			СтрокаГруппировкиРевизий=СтрокиДерева.Добавить();
			aps_ЗаполнитьЭлементДереваПоМоделиXDTO(itemRefXDTO, СтрокаГруппировкиРевизий);
			СтрокаГруппировкиРевизий.ВетвьПостроена=Истина;
			// обновить строку группировки ревизий по модели xdto
			aps_ОбновитьЭлементыДереваПоМоделиXDTOРек(itemRefXDTO, СтрокаГруппировкиРевизий.ПолучитьЭлементы(), 1, Ложь);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Функция заполняет дерево параметров по данным списка XDTO
// Параметры:
//		itemXDTO - объект XDTO-модели
//		ЭлементДерева - ДанныеФормыЭлементДерева
// Пример:
//		ЭтотОбъект.aps_ЗаполнитьЭлементДереваПоМоделиXDTO(МассивXDTO[i], КорневаяСтрокаДерева);
//
Процедура aps_ЗаполнитьЭлементДереваПоМоделиXDTO( itemXDTO, ЭлементДерева ) Экспорт 
	Если НЕ itemXDTO.refLinkGroup Тогда 
		ЭлементДерева.Картинка			= itemXDTO.pictureIndex;
		ЭлементДерева.ЭлементСсылка		= itemXDTO.element;
		ЭлементДерева.ВидЭлемента		= itemXDTO.elementType;
		ЭлементДерева.Представление		= itemXDTO.description;
		ЭлементДерева.ЭлементСвязи		= itemXDTO.link;
		ЭлементДерева.ВидСвязи			= itemXDTO.linkType;
		ЭлементДерева.ПорядокВывода		= itemXDTO.sequenceNumber;
		
		СтрокиПараметров = ЭлементДерева.Параметры.ПолучитьЭлементы();
	Иначе // группа горизонтальных связей
		ЭлементДерева.Картинка			= itemXDTO.pictureIndex;
		ЭлементДерева.Представление		= itemXDTO.description + " (" + Строка(itemXDTO.items.Количество()) + ")";
		ЭлементДерева.ВидСвязи			= itemXDTO.linkType;
	КонецЕсли;
КонецПроцедуры

// Функция заполняет дерево параметров по данным списка XDTO
// Параметры:
//		СписокXDTO - список параметров модели XDTO
//		СтрокиДерева - ДанныеФормыКоллекцияЭлементовДерева для обновления (необязательный)
// Пример:
//		aps_ЗаполнитьДеревоПараметровПоСпискуXDTO( ПараметрXDTO.parameters, ПодстрокиДерева );
//
Процедура aps_ЗаполнитьДеревоПараметровПоСпискуXDTO( СписокXDTO, СтрокиДерева ) Экспорт 
	Для Каждого ПараметрXDTO Из СписокXDTO Цикл
		СтрокаДерева = СтрокиДерева.Добавить();
		Если ЗначениеЗаполнено(ПараметрXDTO.property)Тогда
			СтрокаДерева.Ссылка			  = ПараметрXDTO.reference;
			СтрокаДерева.Имя			  = ПараметрXDTO.description;
			СтрокаДерева.Свойство		  = ПараметрXDTO.property;
			СтрокаДерева.Значение 		  = ПараметрXDTO.value;
			СтрокаДерева.ЕдиницаИзмерения = ПараметрXDTO.unit;
			СтрокаДерева.ЭтоПараметрСвязи = ПараметрXDTO.linkParameter;
		Иначе
			СтрокаДерева.Имя			  = ПараметрXDTO.description;
			СтрокаДерева.Ссылка			  = ПараметрXDTO.reference;
			СтрокаДерева.ЭтоПараметрСвязи = ПараметрXDTO.linkParameter;
			
			ПодстрокиДерева = СтрокаДерева.ПолучитьЭлементы();
			
			aps_ЗаполнитьДеревоПараметровПоСпискуXDTO( ПараметрXDTO.parameters, ПодстрокиДерева );
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры


// Функция создает новый элемент определенного вида
// Параметры:
//		parentItem - СправочникСсылка.aps_ЭлементыСправочников, папка
//		ВидСоздаваемого (необязательный)  - СправочникСсылка.aps_ВидыЭлементов
// Возвращаемое значение:
//		Булево - элемент(-ы) создан(-ы) или нет
// Пример:
//		СозданныеЭлементы = aps_ИнтерактивноеСозданиеЭлемента(parentItem, ВидСоздаваемого);
//
Функция aps_ИнтерактивноеСозданиеЭлемента( parentItem, ВидСоздаваемого ) Экспорт 
	СозданныеЭлементы = Новый Массив();
	
	Если ВидСоздаваемого = Справочники.aps_ВидыЭлементов.ПапкаСправочника Тогда 
		// Создать папку
		НаименованиеПапки = МодульСозданияОбъектов.ПолучитьФорму("ФормаСозданияПапки").ОткрытьМодально();
		Если НЕ ПустаяСтрока(НаименованиеПапки) Тогда
			Попытка
				НачатьТранзакцию();
				    ДеревоСвойствПапки = Новый ДеревоЗначений;
					МодульСозданияОбъектов.aps_ОбновитьДеревоСвойств( ВидСоздаваемого, ДеревоСвойствПапки );
					
					СтрокаСвойства = ДеревоСвойствПапки.Строки.Найти(ПланыВидовХарактеристик.aps_Свойства.Наименование, "Свойство", Истина);
					Если СтрокаСвойства <> Неопределено Тогда 
						СтрокаСвойства.Значение = НаименованиеПапки;
					Иначе // Добавить свойство "Наименование" в дерево в случае отсутствия
						МодульСозданияОбъектов.aps_НеинтерактивноеДобавлениеСвойстваВДерево(ПланыВидовХарактеристик.aps_Свойства.Наименование, НаименованиеПапки,,, ДеревоСвойствПапки);
					КонецЕсли;
					
					СозданныйОбъект = МодульСозданияОбъектов.aps_СозданиеОбъектаPDM( Справочники.aps_ВидыЭлементов.ПапкаСправочника, 
																									ДеревоСвойствПапки );
					
				ЗафиксироватьТранзакцию();
				
				СозданныеЭлементы.Добавить(СозданныйОбъект.Ссылка);
			Исключение
				ОтменитьТранзакцию();
				Сообщить(ПараметрыСеанса.aps_ИмяПродукта+НСтр("ru = ""Не удалось создать папку:""; en_US = ""Cannot create folder:""")+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), СтатусСообщения.Внимание);
			КонецПопытки;
		КонецЕсли;
		
	Иначе
		// Создать элемент
		МодульСозданияОбъектов.aps_УстановитьСозданиеОпределенногоВида(ВидСоздаваемого);
		МодульСозданияОбъектов.ПолучитьФорму(, ФормаОбработки).ОткрытьМодально();
		СозданныеЭлементы = МодульСозданияОбъектов.СозданныеЭлементы.ВыгрузитьКолонку("СозданныйЭлемент");
	КонецЕсли;
	
	Возврат СозданныеЭлементы;
КонецФункции

// Функция создает новую элементную связь данного вида
// Параметры:
//		item			 - СправочникСсылка.aps_ЭлементыИзделия, aps_ЭлементыТехнологии, aps_ЭлементыСправочников
//		parentItem		 - СправочникСсылка.aps_ЭлементыИзделия, aps_ЭлементыТехнологии, aps_ЭлементыСправочников
//		ВидСвязи		 - СправочникСсылка.aps_ШаблоныТехнологическихСвязей, ПеречислениеСсылка.aps_ВидыСвязей
//		МодельИсточник 	 - ОбъектXDTO, источник данных для заполнения параметров связи
// Возвращаемое значение:
//		СправочникСсылка.aps_ВертикальныеСвязи,
//		СправочникСсылка.aps_ЭлементыСвязей,
//		Ложь, если элемент не был добавлен
// Пример:
//		СозданнаяСвязь = aps_ИнтерактивноеДобавлениеЭлемента(МассивПеретаскивания[i].element, parentItem, ВыбШаблонСвязи, МассивПеретаскивания[i]);
//
Функция aps_ИнтерактивноеДобавлениеЭлемента( item, parentItem, ВидСвязи, МодельИсточник = Неопределено ) Экспорт 
	
	Если ВидСвязи = Перечисления.aps_ВидыСвязей.Справочник Или ВидСвязи = Перечисления.aps_ВидыСвязей.Личное Тогда 
		
		Попытка	
			СозданнаяСвязь = МодульСозданияОбъектов.aps_СозданиеВертикальнойСвязи( parentItem, item, ВидСвязи );
			Возврат СозданнаяСвязь.Ссылка;
		Исключение
			Сообщить(ПараметрыСеанса.aps_ИмяПродукта+НСтр("ru = ""Не удалось заимствовать <""; en_US = ""Cannot adopt the <""")+item.Наименование+">:"+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), СтатусСообщения.Внимание);
		КонецПопытки;
		
	ИначеЕсли ТипЗнч(ВидСвязи)=Тип("СправочникСсылка.aps_ШаблоныТехнологическихСвязей") И ВидСвязи.ГоризонтальнаяСвязь Тогда 
		
		Попытка
			НачатьТранзакцию();
				ДеревоСвойствСвязи = Новый ДеревоЗначений;
				МодульСозданияОбъектов.aps_ОбновитьДеревоСвойств(Справочники.aps_ВидыЭлементов.СвязьТехнологии, ДеревоСвойствСвязи, ВидСвязи);
				
				Если МодельИсточник <> Неопределено Тогда // заполнение дерева свойств связи по параметрам связи источника
					МассивПараметровXDTO=aps_СформироватьМассивПараметровИзМоделиXDTO(МодельИсточник);
					Для Каждого parameterXDTO Из МассивПараметровXDTO Цикл 
						Если parameterXDTO.linkParameter=Истина И parameterXDTO.property<>Неопределено Тогда 
							СтрокаСвойства = ДеревоСвойствСвязи.Строки.Найти(parameterXDTO.property, "Свойство", Истина);
							Если СтрокаСвойства <> Неопределено Тогда 
								СтрокаСвойства.Значение			= ?(ЗначениеЗаполнено(parameterXDTO.value), parameterXDTO.value, СтрокаСвойства.Значение);
								СтрокаСвойства.ЕдиницаИзмерения	= ?(ЗначениеЗаполнено(parameterXDTO.unit), parameterXDTO.unit, СтрокаСвойства.ЕдиницаИзмерения);
							КонецЕсли;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
				
				СозданнаяСвязь=МодульСозданияОбъектов.aps_СозданиеЭлементнойСвязи( Справочники.aps_ВидыЭлементов.СвязьТехнологии, parentItem, item, ВидСвязи, ДеревоСвойствСвязи );
				
			ЗафиксироватьТранзакцию();
			Возврат СозданнаяСвязь.Ссылка;
		Исключение
			ОтменитьТранзакцию();
			Сообщить(ПараметрыСеанса.aps_ИмяПродукта+НСтр("ru = ""Не удалось заимствовать элемент по связи <""; en_US = ""Cannot adopt item by the <""")+Строка(ВидСвязи)+НСтр("ru = "">:""; en_US = ""> link:""")+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), СтатусСообщения.Внимание);
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат Ложь;
КонецФункции


// Процедура рекурсивно устанавливает (снимает) флажки для строк дерева значений
// Параметры:
//		Строка - СтрокаДереваЗначений,
//		ЗначениеФлажка	- Булево
//		КолУровней (необязательный) - Число
// Пример:
//		aps_УстановитьФлажкиРек(ТекущаяСтрокаДерева, ЗначениеФлажка, ?(Найти(Кнопка.Имя,"ОдинУровень")>0, 1, Неопределено));
//
Процедура aps_УстановитьФлажкиРек( Строка, ЗначениеФлажка, КолУровней = Неопределено ) Экспорт
	Если КолУровней = 0 Тогда 
		Возврат;
	КонецЕсли;
	
	Для Каждого ПодчСтрока Из Строка.Строки Цикл
		Если ЗначениеЗаполнено(ПодчСтрока.ЭлементСсылка) Тогда 
			Если ДоступныеВидыЭлементов.Количество()=0 Или ДоступныеВидыЭлементов.Найти(ПодчСтрока.ЭлементСсылка.ВидЭлемента) <> Неопределено Тогда 
				ПодчСтрока.Выбран = ЗначениеФлажка;
			КонецЕсли;
		КонецЕсли;
		aps_УстановитьФлажкиРек(ПодчСтрока, ЗначениеФлажка, ?(КолУровней=Неопределено,Неопределено,КолУровней-1));
	КонецЦикла;
КонецПроцедуры

