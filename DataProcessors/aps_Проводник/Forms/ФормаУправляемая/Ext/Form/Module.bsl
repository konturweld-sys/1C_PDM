
#Если НЕ МобильноеПриложениеКлиент Тогда

#Область ОписаниеПеременных	
	
&НаКлиенте
Перем ИдентификаторВыбраннойСтроки;

#КонецОбласти


#Область ОбработчикиСобытийДерева 

&НаКлиенте
Процедура ДеревоПриАктивизацииСтроки(Элемент)
	ТекущаяСтрока = Элемент.ТекущиеДанные;
	Если ТекущаяСтрока <> Неопределено Тогда 
		Если ТекущаяСтрока.ЭлементСсылка=СсылкаОбщиеПапки Или ТекущаяСтрока.ЭлементСсылка=СсылкаНесвязанные Тогда 
			activeItem = Неопределено;
		Иначе 
			activeItem = ТекущаяСтрока.ЭлементСсылка;
		КонецЕсли;
		
		Если НЕ ТекущаяСтрока.ВетвьПостроена Тогда
			Если activeItem <> СсылкаНесвязанные
						Или Вопрос(НСтр("ru = 'Поиск несвязанных элементов может занять продолжительное время. Продолжить?'; en_US = 'Search of unlinked items may require long time to be completed. Continue?'"), РежимДиалогаВопрос.ДаНет)=КодВозвратаДиалога.Да Тогда 
				ИдентификаторТекСтроки = ТекущаяСтрока.ПолучитьИдентификатор();
				ПерестроитьСтрокуДерева(ИдентификаторТекСтроки);
				Элементы.Дерево.Развернуть(ИдентификаторТекСтроки);
			КонецЕсли;
		КонецЕсли;
		
		aps_СтруктураПараметровОповещения.Очистить();
		aps_СтруктураПараметровОповещения.Вставить("item", activeItem);
		aps_СтруктураПараметровОповещения.Вставить("itemTree", ТекущаяСтрока);
		aps_СтруктураПараметровОповещения.Вставить("ФормаИсточник", ЭтаФорма);
		
		СтрокаРодителя = ТекущаяСтрока.ПолучитьРодителя();
		Если СтрокаРодителя <> Неопределено И СтрокаРодителя.ЭлементСсылка = Неопределено Тогда 
			СтрокаРодителя = СтрокаРодителя.ПолучитьРодителя();
		КонецЕсли;
		
		aps_СтруктураПараметровОповещения.Вставить("parentItemTree", СтрокаРодителя);
		Оповестить("AppiusWindowGeneralNotify", aps_СтруктураПараметровОповещения, ЭтаФорма);
		
		ОбновитьЗаголовокОкна();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)	
	Если ОдиночныйВыбор	И (ДоступныеВидыЭлементов.Количество()=0 ИЛИ 
			ДоступныеВидыЭлементов.НайтиПоЗначению(Дерево.НайтиПоИдентификатору(ВыбраннаяСтрока).ВидЭлемента)<>Неопределено) Тогда 
		// Выбрать текущий элемент		
		Дерево.НайтиПоИдентификатору(ВыбраннаяСтрока).Выбран = Истина;
		КнопкаВыбрать(Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоВыбранПриИзменении(Элемент)
	Если НЕ ОдиночныйВыбор Или НЕ Элементы.Дерево.ТекущиеДанные.Выбран Тогда 
		Возврат;
	КонецЕсли;
	
	ИдентификаторТекСтроки = Элементы.Дерево.ТекущаяСтрока;
	
	Если ИдентификаторВыбраннойСтроки <> Неопределено И ИдентификаторВыбраннойСтроки <> ИдентификаторТекСтроки Тогда 
		Строка = Дерево.НайтиПоИдентификатору(ИдентификаторВыбраннойСтроки);
		Если Строка <> Неопределено Тогда 
			Строка.Выбран = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	ИдентификаторВыбраннойСтроки = ИдентификаторТекСтроки;
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КнопкаОткрытьПроводник(Команда)
	Если Элементы.Дерево.ТекущиеДанные.ЭлементСсылка = Неопределено
			Или Элементы.Дерево.ТекущиеДанные.ЭлементСсылка = СсылкаОбщиеПапки
			Или Элементы.Дерево.ТекущиеДанные.ЭлементСсылка = СсылкаНесвязанные Тогда 
		Возврат;
	КонецЕсли;
	
	aps_ОткрытьВПроводнике(Элементы.Дерево.ТекущиеДанные.ЭлементСсылка);
КонецПроцедуры

&НаКлиенте
Процедура КнопкаПерестроить(Команда)
	ТекущаяСтрока = Элементы.Дерево.ТекущиеДанные;
	Если ТекущаяСтрока <> Неопределено И ТекущаяСтрока.ЭлементСсылка <> Неопределено Тогда 
		ИдентификаторТекСтроки = Элементы.Дерево.ТекущаяСтрока;
		ПерестроитьСтрокуДерева(ИдентификаторТекСтроки);
		Элементы.Дерево.Развернуть(ИдентификаторТекСтроки);
		ДеревоПриАктивизацииСтроки(Элементы.Дерево);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КнопкаРазвернутьВсе(Команда)
	ТекущаяСтрока = Элементы.Дерево.ТекущиеДанные;
	Если ТекущаяСтрока <> Неопределено И ТекущаяСтрока.ЭлементСсылка <> Неопределено Тогда
		Состояние(НСтр("ru = 'Дерево разворачивается. Пожалуйста, подождите...'; en_US = 'The tree is expanding. Please wait...'"));
		// нужно перестроить текущую строку
		ИдентификаторТекСтроки = ТекущаяСтрока.ПолучитьИдентификатор();
		ПерестроитьСтрокуДерева(ИдентификаторТекСтроки, Неопределено);
		РазвернутьДерево(ТекущаяСтрока);
		ДеревоПриАктивизацииСтроки(Элементы.Дерево);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КнопкаСвернутьВсеКромеТекущей(Команда)
	ИдСтаройТекущейСтроки = Элементы.Дерево.ТекущаяСтрока;
	СтрокаКРазвороту = Дерево.НайтиПоИдентификатору(ИдСтаройТекущейСтроки);
	
	КорневыеЭлементыДерева = Дерево.ПолучитьЭлементы();
	Для i=0 По КорневыеЭлементыДерева.Количество()-1 Цикл 
		СвернутьДерево(КорневыеЭлементыДерева[i]);
	КонецЦикла;
	
	Пока СтрокаКРазвороту<>Неопределено Цикл
		Элементы.Дерево.Развернуть(СтрокаКРазвороту.ПолучитьИдентификатор());
		СтрокаКРазвороту=СтрокаКРазвороту.ПолучитьРодителя();
	КонецЦикла;
	
	Элементы.Дерево.ТекущаяСтрока=ИдСтаройТекущейСтроки;
КонецПроцедуры

&НаКлиенте
Процедура КнопкаВыбрать(Команда)
	СтрокаПредупреждения = "";
	ВыбранныеЭлементы = ВыбратьЭлементы(СтрокаПредупреждения);
	Если ВыбранныеЭлементы <> Неопределено Тогда 
		ОповеститьОВыборе(ВыбранныеЭлементы);
	Иначе 
		Предупреждение(СтрокаПредупреждения);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КнопкиОтметить(Команда)	
	ТекущаяСтрока = Элементы.Дерево.ТекущиеДанные;
	Если ТекущаяСтрока <> Неопределено Тогда 
		ТекущаяСтрока.Выбран = Истина;
		УстановитьФлажки(Элементы.Дерево.ТекущаяСтрока, Истина, ?(Команда.Имя="КнопкаОтметитьОдинУровень",1,Неопределено));
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КнопкиСнять(Команда)
	ТекущаяСтрока = Элементы.Дерево.ТекущиеДанные;
	Если ТекущаяСтрока <> Неопределено Тогда 
		ТекущаяСтрока.Выбран = Ложь;
		УстановитьФлажки(Элементы.Дерево.ТекущаяСтрока, Ложь, ?(Команда.Имя="КнопкаСнятьОдинУровень",1,Неопределено));
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СвернутьДерево(Строка)
	Подстроки = Строка.ПолучитьЭлементы();
	Элементы.Дерево.Свернуть(Строка.ПолучитьИдентификатор());
	Для i=0 По Подстроки.Количество()-1 Цикл
		СвернутьДерево(Подстроки[i]);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьДерево(Строка)
	Элементы.Дерево.Развернуть(Строка.ПолучитьИдентификатор(), Истина);
КонецПроцедуры

&НаКлиенте
Процедура КнопкаРазделЛичныеПапки(Команда)
	Если РежимВыбора И ТолькоКорневые Тогда
		Предупреждение(НСтр("ru = 'Проводник находится в режиме выбора элементов, источник которых уже определен. Выберите один или несколько элементов из представленных!';"+
						"en_US = 'The explorer is in mode of selecting items from specified source. Select one or several of presented items!'"));
		Возврат;
	КонецЕсли;
	
	Если ТекущийРаздел = "aps_ЛичныеПапки" Тогда 
		Возврат;
    КонецЕсли;
	
	ПерейтиКЛичнымПапкамСервер();
	
	ИдентификаторСтроки = Дерево.ПолучитьЭлементы()[0].ПолучитьИдентификатор();
	Элементы.Дерево.ТекущаяСтрока = ИдентификаторСтроки;
	Элементы.Дерево.Развернуть(ИдентификаторСтроки);
КонецПроцедуры

&НаКлиенте
Процедура КнопкаРазделСправочник(Команда)
	Если РежимВыбора И ТолькоКорневые Тогда
		Предупреждение(НСтр("ru = 'Проводник находится в режиме выбора элементов, источник которых уже определен. Выберите один или несколько элементов из представленных!';"+
						"en_US = 'The explorer is in mode of selecting items from specified source. Select one or several of presented items!'"));
		Возврат;
	КонецЕсли;
	
	Если ТекущийРаздел = "aps_Справочник" Тогда 
		Возврат;
	КонецЕсли;

	ПерейтиКСправочникуСервер();
	
	ИдентификаторСтроки = Дерево.ПолучитьЭлементы()[0].ПолучитьИдентификатор();
	Элементы.Дерево.ТекущаяСтрока = ИдентификаторСтроки;
	Элементы.Дерево.Развернуть(ИдентификаторСтроки);
КонецПроцедуры

#КонецОбласти


#Область ПрочиеПроцедурыИФункцииНаКлиенте

&НаКлиенте
Процедура ОбновитьЗаголовокОкна()
	ТекущаяСтрока=Элементы.Дерево.ТекущиеДанные;
	Пока ТекущаяСтрока.ПолучитьРодителя()<>Неопределено Цикл 
		ТекущаяСтрока=ТекущаяСтрока.ПолучитьРодителя();
	КонецЦикла;
	
	Заголовок=НСтр("ru = 'Проводник: '; en_US = 'Item explorer: '")+ТекущаяСтрока.Представление;
КонецПроцедуры

#КонецОбласти

#КонецЕсли

#Если НЕ МобильноеПриложениеСервер Тогда
	
#Область ОбработчикиСобытийФормыНаСервере	
	
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЭтотОбъектИБ = РеквизитФормыВЗначение("Объект");
	
	Попытка // папка, в которой находятся все личные папки пользователя
		СсылкаЛичнаяПапка = ЭтотОбъектИБ.МодульСозданияОбъектов.aps_НайтиИлиСоздатьПапкуПользователя( ПараметрыСеанса.ТекущийПользователь );
	Исключение
		Сообщить(ПараметрыСеанса.aps_ИмяПродукта+НСтр("ru = ""Не удалось создать Вашу личную папку! Убедитесь в правильности первоначального заполения информационной базы.""; en_US = ""Cannot create your private folder! Please make sure that infobase is correctly initialized.""")+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), СтатусСообщения.Внимание);
	КонецПопытки;
	
	СсылкаОбщиеПапки	= ЭтотОбъектИБ.СсылкаОбщиеПапки;
	СсылкаНесвязанные	= ЭтотОбъектИБ.СсылкаНесвязанные;
	
	АдресДереваЛичныхПапок = ПоместитьВоВременноеХранилище(Неопределено, ЭтаФорма.УникальныйИдентификатор);
	АдресДереваСправочника = ПоместитьВоВременноеХранилище(Неопределено, ЭтаФорма.УникальныйИдентификатор);
	
	
	Если Параметры.Свойство("КорневыеЭлементы") Тогда
		КорневыеЭлементы = Параметры.КорневыеЭлементы;
		
		КорневыеСтрокиДерева = Дерево.ПолучитьЭлементы();

		МассивXDTO = Новый Массив();
		Для Каждого КорневойЭлемент Из КорневыеЭлементы Цикл 
			Если ТипЗнч(КорневойЭлемент)=Тип("Строка") Тогда 
				itemXDTO = Строка2XDTO(КорневойЭлемент);
			Иначе 
				itemXDTO = aps_СоздатьОбъектМоделиXDTO(КорневойЭлемент);
			КонецЕсли;
			МассивXDTO.Добавить(itemXDTO);
		КонецЦикла;
		
		Для i=0 По МассивXDTO.Количество()-1 Цикл 
			КорневаяСтрокаДерева = КорневыеСтрокиДерева.Добавить();
			ЭтотОбъектИБ.aps_ЗаполнитьЭлементДереваПоМоделиXDTO(МассивXDTO[i], КорневаяСтрокаДерева);
			ЭтотОбъектИБ.aps_ОбновитьЭлементыДереваПоМоделиXDTOРек(МассивXDTO[i], КорневаяСтрокаДерева.ПолучитьЭлементы(), Неопределено);
		КонецЦикла;
	КонецЕсли; // Если Параметры.Свойство("КорневыеЭлементы") Тогда
	
	
	Если Дерево.ПолучитьЭлементы().Количество() = 0 Тогда 
		ПерейтиКЛичнымПапкамСервер(); // открыть личные папки
	КонецЕсли;
		
	Для Каждого Элемент Из УсловноеОформление.Элементы Цикл
		Если Элемент.Представление = "ОтображатьФлажок" Тогда
			Если Параметры.Свойство("ДоступныеВидыЭлементов") И Параметры.ДоступныеВидыЭлементов.Количество() > 0 Тогда
				Если ТипЗнч(Параметры.ДоступныеВидыЭлементов) = Тип("СписокЗначений")
						И ТипЗнч(Параметры.ДоступныеВидыЭлементов[0].Значение) = Тип("Строка") Тогда
					Для Каждого ЭлементСписка Из Параметры.ДоступныеВидыЭлементов Цикл
						ДоступныеВидыЭлементов.Добавить(Строка2Object1С(ЭлементСписка.Значение).Ссылка);
					КонецЦикла;
				Иначе
					ДоступныеВидыЭлементов.ЗагрузитьЗначения(Параметры.ДоступныеВидыЭлементов);
				КонецЕсли;
				Элемент.Отбор.Элементы[0].ПравоеЗначение = ДоступныеВидыЭлементов.Скопировать();
			Иначе
				Элемент.Использование = Ложь;
			КонецЕсли;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	РежимВыбора    = ?(Параметры.Свойство("РежимВыбора"), Параметры.РежимВыбора, Ложь);
	ОдиночныйВыбор = ?(Параметры.Свойство("ОдиночныйВыбор"), Параметры.ОдиночныйВыбор, Ложь);
	ВыбиратьXDTO   = ?(Параметры.Свойство("ВыбиратьXDTO"), Параметры.ВыбиратьXDTO, Ложь);
	ТолькоКорневые = ?(Параметры.Свойство("ТолькоКорневые"), Параметры.ТолькоКорневые, Ложь);
	
	Элементы.ДеревоГруппаВыбрать.Видимость = РежимВыбора;
	Элементы.ДеревоКонтекстноеМенюГруппаВыбрать.Видимость = РежимВыбора;
	Элементы.ДеревоВыбран.Видимость = РежимВыбора;
	Элементы.ДеревоГруппаОтметить.Видимость	= РежимВыбора И НЕ ОдиночныйВыбор;
	Элементы.ДеревоГруппаСнять.Видимость	= РежимВыбора И НЕ ОдиночныйВыбор;
	Элементы.ДеревоКонтекстноеМенюГруппаОтметить.Видимость	= РежимВыбора И НЕ ОдиночныйВыбор;
	Элементы.ДеревоКонтекстноеМенюГруппаСнять.Видимость		= РежимВыбора И НЕ ОдиночныйВыбор;
	
	Элементы.ДеревоКонтекстноеМенюГруппаСнять.Видимость		= РежимВыбора И НЕ ОдиночныйВыбор;
КонецПроцедуры

#КонецОбласти

#Область ПрочиеПроцедурыИФункцииНаСервере

&НаСервере
Функция ПерестроитьСтрокуДерева(ИдентификаторСтроки, Уровней = 1)
	ЭтотОбъектИБ = РеквизитФормыВЗначение("Объект");
	
	СтрокаДерева = Дерево.НайтиПоИдентификатору( ИдентификаторСтроки );
	// очистить подчиненные элементы
	Подстроки = СтрокаДерева.ПолучитьЭлементы();
	Подстроки.Очистить();
	
	parentXDTO = ЭлементДерева2XDTO(СтрокаДерева);
	aps_ОбновитьДанныеМоделиXDTO(parentXDTO);
	
	СтрокаДерева.Параметры.ПолучитьЭлементы().Очистить();
	ЭтотОбъектИБ.aps_ЗаполнитьЭлементДереваПоМоделиXDTO(parentXDTO, СтрокаДерева);
	
	МассивXDTO = Новый Массив();
	МассивXDTO.Добавить(parentXDTO);
	// обновить модель данных
	Если МассивXDTO.Количество() = 1 И (МассивXDTO[0].element = СсылкаОбщиеПапки Или МассивXDTO[0].element = СсылкаНесвязанные) Тогда 
		ЭтотОбъектИБ.aps_ОбновитьМодельXDTO( МассивXDTO[0], Неопределено );
		Если Уровней = Неопределено Или Уровней > 1 Тогда 
			ЭтотОбъектИБ.aps_ОбновитьМодельXDTOРек( МассивXDTO[0].items, Неопределено, ?(Уровней=Неопределено, Неопределено, Уровней-1), Ложь );
		КонецЕсли;
	Иначе 
		ЭтотОбъектИБ.aps_ОбновитьМодельXDTOРек( МассивXDTO, Неопределено, Уровней, Ложь );
	КонецЕсли;
	
	СтрокаРодителя=СтрокаДерева.ПолучитьРодителя();
	ПоказатьРевизии=(СтрокаРодителя=Неопределено Или СтрокаРодителя.ВидСвязи<>ЭтотОбъектИБ.ВидСвязиРевизии);
	ЭтотОбъектИБ.aps_ОбновитьЭлементыДереваПоМоделиXDTOРек( parentXDTO, Подстроки, Уровней, ПоказатьРевизии );
	СтрокаДерева.ВетвьПостроена = Истина;
	
	Возврат Истина;
КонецФункции

&НаСервере
Функция СериализоватьXDTO(ИдентификаторСтроки, Уровней = Неопределено)
	itemXDTO = ЭлементДерева2XDTO(Дерево.НайтиПоИдентификатору(ИдентификаторСтроки), Уровней);
	Возврат XDTO2Строка(itemXDTO);
КонецФункции

&НаСервере
Функция ВыбратьЭлементы(СтрокаПредупреждения)
	ВыбранныеЭлементы = Новый Массив();
	
	ВыбранныеСтроки = ПолучитьВыбранныеСтроки(Дерево.ПолучитьЭлементы());
	Для Каждого ВыбраннаяСтрока Из ВыбранныеСтроки Цикл
		Если ВыбиратьXDTO Тогда 
			ВыбранныеЭлементы.Добавить(СериализоватьXDTO(ВыбраннаяСтрока.ПолучитьИдентификатор(), 1));
		Иначе 	
			ВыбранныеЭлементы.Добавить(ВыбраннаяСтрока.ЭлементСсылка);
		КонецЕсли;
	КонецЦикла;

	Если ВыбранныеЭлементы.Количество() = 0 Тогда
		СтрокаПредупреждения=НСтр("ru = 'Не выбрано ни одного элемента!'; en_US = 'No item was selected!'");
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ?(ОдиночныйВыбор, ВыбранныеЭлементы[0], ВыбранныеЭлементы);
	
КонецФункции

&НаСервере
Функция ПолучитьВыбранныеСтроки(Строки, МассивВыбранныхСтрок = Неопределено)
	Если МассивВыбранныхСтрок = Неопределено Тогда 
		МассивВыбранныхСтрок = Новый Массив;
	КонецЕсли;
	
	Для Каждого Строка Из Строки Цикл
		Если Строка.Выбран = Истина Тогда
			МассивВыбранныхСтрок.Добавить(Строка);
		КонецЕсли;
		ПолучитьВыбранныеСтроки(Строка.ПолучитьЭлементы(), МассивВыбранныхСтрок);
	КонецЦикла;
	
	Возврат МассивВыбранныхСтрок;
КонецФункции

&НаСервере
Процедура УстановитьФлажки(ИдентификаторСтроки, ЗначениеФлажка, КолУровней)
	ТекСтрока = Дерево.НайтиПоИдентификатору(ИдентификаторСтроки);
	УстановитьФлажкиРек(ТекСтрока, ЗначениеФлажка, КолУровней);
КонецПроцедуры

&НаСервере
// Процедура рекурсивно устанавливает (снимает) флажки для строк дерева значений
// Параметры:
//		Строка - СтрокаДереваЗначений,
//		ЗначениеФлажка	- Булево
//		КолУровней (необязательный) - Число
Процедура УстановитьФлажкиРек( Строка, ЗначениеФлажка, КолУровней = Неопределено )
	Если КолУровней = 0 Тогда 
		Возврат;
	КонецЕсли;
	
	Подстроки = Строка.ПолучитьЭлементы();
	Для Каждого Подстрока Из Подстроки Цикл
		Если ЗначениеЗаполнено(Подстрока.ЭлементСсылка) Тогда 
			Если ДоступныеВидыЭлементов.Количество()=0 Или ДоступныеВидыЭлементов.НайтиПоЗначению(Подстрока.ВидЭлемента) <> Неопределено Тогда 
				Подстрока.Выбран = ЗначениеФлажка;
			КонецЕсли;
		КонецЕсли;
		УстановитьФлажкиРек(Подстрока, ЗначениеФлажка, ?(КолУровней=Неопределено, Неопределено, КолУровней-1));
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПерейтиКЛичнымПапкамСервер() 
		
	Если ТекущийРаздел = "aps_Справочник" Тогда 
		ДеревоСправочникаГотовое = РеквизитФормыВЗначение("Дерево", Тип("ДеревоЗначений"));
		ПоместитьВоВременноеХранилище(ДеревоСправочникаГотовое, АдресДереваСправочника);
	КонецЕсли;

    ДеревоЛичныхПапокГотовое = ПолучитьИзВременногоХранилища(АдресДереваЛичныхПапок);
	Если ДеревоЛичныхПапокГотовое <> Неопределено Тогда 
		// Перейти к готовому дереву
		ЗначениеВРеквизитФормы(ДеревоЛичныхПапокГотовое, "Дерево");
	Иначе 
		ЭтотОбъектИБ = РеквизитФормыВЗначение("Объект");
	
		КорневыеСтрокиДерева = Дерево.ПолучитьЭлементы();
		КорневыеСтрокиДерева.Очистить();
		
		Если ЗначениеЗаполнено(СсылкаЛичнаяПапка) Тогда 
			itemXDTO = aps_СоздатьОбъектМоделиXDTO(СсылкаЛичнаяПапка);
			
			КорневаяСтрокаДерева = КорневыеСтрокиДерева.Добавить();
			ЭтотОбъектИБ.aps_ЗаполнитьЭлементДереваПоМоделиXDTO(itemXDTO, КорневаяСтрокаДерева);
		КонецЕсли;
		
		
		itemXDTO = aps_СоздатьОбъектМоделиXDTO(СсылкаОбщиеПапки);
		itemXDTO.description	= НСтр("ru = 'Общие папки'; en_US = 'Shared folders'");
		itemXDTO.pictureIndex	= 8;
		
		КорневаяСтрокаДерева = КорневыеСтрокиДерева.Добавить();
		ЭтотОбъектИБ.aps_ЗаполнитьЭлементДереваПоМоделиXDTO(itemXDTO, КорневаяСтрокаДерева);
		
		itemXDTO = aps_СоздатьОбъектМоделиXDTO(СсылкаНесвязанные);
		itemXDTO.description	= НСтр("ru = 'Несвязанные элементы'; en_US = 'Unlinked items'");
		itemXDTO.pictureIndex	= 9;
	
		КорневаяСтрокаДерева = КорневыеСтрокиДерева.Добавить();
		ЭтотОбъектИБ.aps_ЗаполнитьЭлементДереваПоМоделиXDTO(itemXDTO, КорневаяСтрокаДерева);
	КонецЕсли;
	
	ТекущийРаздел = "aps_ЛичныеПапки";
		
КонецПроцедуры

&НаСервере
Процедура ПерейтиКСправочникуСервер() 
	
	Если ТекущийРаздел = "aps_ЛичныеПапки" Тогда 
		ДеревоЛичныхПапокГотовое = РеквизитФормыВЗначение("Дерево", Тип("ДеревоЗначений"));
		ПоместитьВоВременноеХранилище(ДеревоЛичныхПапокГотовое, АдресДереваЛичныхПапок);
	КонецЕсли;

	ДеревоСправочникаГотовое = ПолучитьИзВременногоХранилища(АдресДереваСправочника);
	Если ДеревоСправочникаГотовое <> Неопределено Тогда 
		// Перейти к готовому дереву
		ЗначениеВРеквизитФормы(ДеревоСправочникаГотовое, "Дерево");
	Иначе 
		ЭтотОбъектИБ = РеквизитФормыВЗначение("Объект");
	
		КорневыеЭлементы = aps_ПолучитьКорневыеПапкиСправочника();
		МассивXDTOДляПостроения = Новый Массив();
		Для Каждого КорневойЭлемент Из КорневыеЭлементы Цикл 
			itemXDTO = aps_СоздатьОбъектМоделиXDTO(КорневойЭлемент);
			МассивXDTOДляПостроения.Добавить(itemXDTO);
		КонецЦикла;
		
		КорневыеСтрокиДерева = Дерево.ПолучитьЭлементы();
		КорневыеСтрокиДерева.Очистить();

		Для Каждого itemXDTO Из МассивXDTOДляПостроения Цикл 
			КорневаяСтрокаДерева = КорневыеСтрокиДерева.Добавить();
			ЭтотОбъектИБ.aps_ЗаполнитьЭлементДереваПоМоделиXDTO(itemXDTO, КорневаяСтрокаДерева);
			ЭтотОбъектИБ.aps_ОбновитьЭлементыДереваПоМоделиXDTOРек(itemXDTO, КорневаяСтрокаДерева.ПолучитьЭлементы(), 2);
		КонецЦикла;
	КонецЕсли;
	
	ТекущийРаздел = "aps_Справочник";
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли