#Область ОписаниеПеременных

#Если Сервер И НЕ МобильноеПриложениеСервер Тогда 
Перем aps_СтруктураПараметровОповещенияНаСервере Экспорт; // Описание структуры параметров событий/оповещений 1C:PDM на сервере
#КонецЕсли

#КонецОбласти


#Область ПрограммныйИнтерфейс

#Если НЕ МобильноеПриложениеСервер Тогда
// Процедура заполняет данные по номенклатуре в дереве структуры изделия. Рекурсия
// Параметры:
//		itemXDTO		- объект модели XDTO
//		СтрокаДерева	- СтрокаДереваЗначений 
// Пример:
//		aps_ЗаполнитьНоменклатуруВДеревеРек(Строка.ОбъектXDTO, Строка);
Процедура aps_ЗаполнитьНоменклатуруВДеревеРек( itemXDTO, СтрокаДерева ) Экспорт
	СтрокаДерева.Номенклатура				= МодульСозданияПараметров.aps_ПолучитьЗначениеПараметраПоСвойствуВXDTO(itemXDTO, ПланыВидовХарактеристик.aps_Свойства.Номенклатура);
	СтрокаДерева.ХарактеристикаНоменклатуры	= МодульСозданияПараметров.aps_ПолучитьЗначениеПараметраПоСвойствуВXDTO(itemXDTO, ПланыВидовХарактеристик.aps_Свойства.ХарактеристикаНоменклатуры);
	
	Для i=0 По СтрокаДерева.Строки.Количество()-1 Цикл
		aps_ЗаполнитьНоменклатуруВДеревеРек(СтрокаДерева.Строки[i].ОбъектXDTO, СтрокаДерева.Строки[i]);
	КонецЦикла;
КонецПроцедуры

// Процедура создает позиции номенклатуры по дереву структуры изделия. Рекурсия
// Параметры:
//		itemXDTO			- объект модели XDTO
//		РежимПодбора		- булево
//		РодительНоменклатуры- СправочникСсылка.Номенклатура
//	Пример:
//		aps_СоздатьНоменклатуруРек(ТекущаяСтрока.ОбъектXDTO, РежимПодбора, РодительНоменклатуры);
Процедура aps_СоздатьНоменклатуруРек( itemXDTO, РежимПодбора = Ложь, РодительНоменклатуры = Неопределено ) Экспорт 
	#Если Клиент Или ВнешнееСоединение Тогда 
		// гл. переменная
	#Иначе
		aps_СтруктураПараметровОповещения=aps_СтруктураПараметровОповещенияНаСервере;
	#КонецЕсли
	
	aps_СтруктураПараметровОповещения.Очистить();
	aps_СтруктураПараметровОповещения.Вставить("itemXDTO", itemXDTO);
	
	Если НЕ itemXDTO.refLinkGroup Тогда 
		parameterXDTO=МодульСозданияПараметров.aps_ВспомНайтиПараметрПоСвойствуВXDTO(itemXDTO, ПланыВидовХарактеристик.aps_Свойства.Номенклатура);
		Если parameterXDTO<>Неопределено И НЕ ЗначениеЗаполнено(parameterXDTO.value) Тогда 
			
			НоменклатураСсылка=Справочники.Номенклатура.НайтиПоНаименованию(itemXDTO.description, Истина);
			Если НоменклатураСсылка.Пустая() И НЕ РежимПодбора Тогда // создать новую позицию номенклатуры
				СтруктураПолейНоменклатуры = Новый Структура;
				СтруктураПолейНоменклатуры.Вставить("Наименование"		, itemXDTO.description);
				СтруктураПолейНоменклатуры.Вставить("НаименованиеПолное", itemXDTO.description);
				СтруктураПолейНоменклатуры.Вставить("Родитель"			, РодительНоменклатуры);
				
				Попытка	
					НоменклатураСсылка=МодульСозданияОбъектов.aps_СозданиеПозицииНоменклатуры(СтруктураПолейНоменклатуры, itemXDTO.element, Ложь).Ссылка;
				Исключение
					Сообщить(ПараметрыСеанса.aps_ИмяПродукта+НСтр("ru = ""Для элемента <""; en_US = ""Cannot create a nomenclature item for the <""")+itemXDTO.description+НСтр("ru = ""> не удалось создать позицию номенклатуры:""; en_US = ""> item:""")+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), СтатусСообщения.Внимание);
				КонецПопытки;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(НоменклатураСсылка) Тогда 
				МодульСозданияПараметров.aps_УстановитьЗначениеПараметраПоСвойствуВXDTO(itemXDTO, ПланыВидовХарактеристик.aps_Свойства.Номенклатура, НоменклатураСсылка);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
		
	Для i=0 По itemXDTO.items.Количество()-1 Цикл 
		aps_СоздатьНоменклатуруРек(itemXDTO.items[i], РежимПодбора);
	КонецЦикла;
	
КонецПроцедуры
#КонецЕсли

#КонецОбласти


#Область Инициализация

#Если Сервер И НЕ МобильноеПриложениеСервер Тогда 
aps_СтруктураПараметровОповещенияНаСервере=Новый Структура();
#КонецЕсли

#КонецОбласти
