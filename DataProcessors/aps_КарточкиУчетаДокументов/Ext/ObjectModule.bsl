
#Область ОписаниеПеременных

Перем ВидыЭлементовДляУчета Экспорт; // Массив видов элементов, для которых создаются карточки учета

#КонецОбласти


#Область ПрограммныйИнтерфейс

// Процедура заполняет данные по карточкам учета в дереве структуры изделия. Рекурсия
// Параметры:
//		itemXDTO		- объект модели XDTO
//		СтрокаДерева	- СтрокаДереваЗначений 
// Пример:
//		aps_ЗаполнитьКарточкиУчетаВДеревеРек(Строка.ОбъектXDTO, Строка);
Процедура aps_ЗаполнитьКарточкиУчетаВДеревеРек( itemXDTO, СтрокаДерева ) Экспорт
	
	Если ЗначениеЗаполнено(itemXDTO.element) Тогда 
		СтрокаДерева.КарточкаУчета = aps_НайтиАрхивныйДокумент(itemXDTO.element).Владелец;
	КонецЕсли;
	
	Для i=0 По СтрокаДерева.Строки.Количество()-1 Цикл
		aps_ЗаполнитьКарточкиУчетаВДеревеРек(СтрокаДерева.Строки[i].ОбъектXDTO, СтрокаДерева.Строки[i]);
	КонецЦикла;
КонецПроцедуры

// Процедура создает карточки учета документов по дереву структуры изделия. Рекурсия
// Параметры:
//		Строки - КоллекцияСтрокДереваЗначений 
//		ИнвентарнаяКнига - СправочникСсылка.aps_ИнвентарныеКниги, инвентарная книга
// Пример:
//		aps_СоздатьКарточкиУчетаРек(ДеревоСостава.Строки, ИнвентарнаяКнига);
Процедура aps_СоздатьКарточкиУчетаРек( Строки, ИнвентарнаяКнига ) Экспорт 
	
	Для Каждого Строка Из Строки Цикл
		childItemXDTO = Строка.ОбъектXDTO;
		parentItemXDTO = Строка.ОбъектXDTO.Владелец();
		Если parentItemXDTO<>Неопределено И parentItemXDTO.refLinkGroup Тогда 
			parentItemXDTO=parentItemXDTO.Владелец();
		КонецЕсли;
		
		Если Строка.ЗначениеФлажка И Строка.КарточкаУчета.Пустая() И ВидыЭлементовДляУчета.Найти(childItemXDTO.elementType) <> Неопределено Тогда 
			Строка.КарточкаУчета = aps_СоздатьКарточкуУчета(childItemXDTO.element,
															?(parentItemXDTO=Неопределено, Неопределено, parentItemXDTO.element),
															ИнвентарнаяКнига);
		КонецЕсли;
		
		aps_СоздатьКарточкиУчетаРек(Строка.Строки, ИнвентарнаяКнига);
	КонецЦикла;
	
КонецПроцедуры


// Функция создания новой карточки учета
// Параметры:
//  	Документ - СправочникСсылка.aps_ЭлементыИзделия, ссылка на документ
//  	Изделие  - СправочникСсылка.aps_ЭлементыИзделия, ссылка на элемент, содержащий документ
//		ИнвКнига - СправочникСсылка.aps_ИнвентарныеКниги, инвентарная книга
//
// Возвращаемое значение:
//		СправочникСсылка.aps_ИнвентарныеКниги
//
// Пример:
//		Строка.КарточкаУчета = aps_СоздатьКарточкуУчета(childItemXDTO.element,
//															?(parentItemXDTO=Неопределено, Неопределено, parentItemXDTO.element),
//															ИнвентарнаяКнига);
Функция aps_СоздатьКарточкуУчета( Документ, Изделие = Неопределено, ИнвКнига = Неопределено ) Экспорт
	Если НЕ ЗначениеЗаполнено(Документ) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	АрхивныйДокумент = aps_НайтиАрхивныйДокумент(Документ);
	Если НЕ АрхивныйДокумент.Пустая() Тогда
		Возврат АрхивныйДокумент.Владелец;
	КонецЕсли;
	
	КарточкаУчета = aps_НайтиКарточкуУчета(Документ);
	Если НЕ КарточкаУчета.Пустая() Тогда // Карточка существует для ревизии документа
		НовыйАрхивныйДокумент = Справочники.aps_АрхивныеДокументы.СоздатьЭлемент();
		НовыйАрхивныйДокумент.Владелец	= КарточкаУчета;
		НовыйАрхивныйДокумент.Документ	= Документ;
		НовыйАрхивныйДокумент.Записать();
		
		Возврат КарточкаУчета;
	Иначе // Создание новой карточки учета
		
		НоваяКарточкаУчета = Справочники.aps_ИнвентарныеКниги.СоздатьЭлемент();
		
		Если ЗначениеЗаполнено(Изделие) Тогда
			НоваяКарточкаУчета.НаименованиеИзделия = Изделие.Наименование;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ИнвКнига) Тогда
			НоваяКарточкаУчета.Родитель = ИнвКнига;
		КонецЕсли;
		
		НоваяКарточкаУчета.УстановитьНовыйКод();
		НоваяКарточкаУчета.Наименование = СокрЛП(СокрЛП(НоваяКарточкаУчета.Код)+" "+СокрЛП(Документ.Наименование));
		
		НоваяКарточкаУчета.Записать();
		
		НовыйАрхивныйДокумент = Справочники.aps_АрхивныеДокументы.СоздатьЭлемент();
		НовыйАрхивныйДокумент.Владелец		= НоваяКарточкаУчета.Ссылка;
		НовыйАрхивныйДокумент.Документ		= Документ;
		НовыйАрхивныйДокумент.Записать();
		
		Возврат НоваяКарточкаУчета.Ссылка;
	КонецЕсли;
КонецФункции

// Функция поиска существующей карточки учета
// Параметры:
//  	Документ - СправочникСсылка.aps_ЭлементыИзделия 
// Возвращаемое значение:
//		СправочникСсылка.aps_ИнвентарныеКниги
// Пример:
//		КарточкаУчета = aps_НайтиКарточкуУчета(Документ);
Функция aps_НайтиКарточкуУчета( Документ ) Экспорт
	РевизииДокумента = МодульСозданияРевизий.aps_СформироватьМассивРевизийИзменения(Документ.Ссылка);
	
	// Поиск существующей карточки учета
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	aps_АрхивныеДокументы.Владелец КАК КарточкаУчета
	               |ИЗ
	               |	Справочник.aps_АрхивныеДокументы КАК aps_АрхивныеДокументы
	               |ГДЕ
	               |	aps_АрхивныеДокументы.Документ В(&РевизииДокумента)
	               |	И (НЕ aps_АрхивныеДокументы.ПометкаУдаления)";
	Запрос.УстановитьПараметр("РевизииДокумента", РевизииДокумента);
	
	Результат = Запрос.Выполнить().Выгрузить();
	Если Результат.Количество() > 0 Тогда
		Возврат Результат[0].КарточкаУчета;
	Иначе
		Возврат Справочники.aps_ИнвентарныеКниги.ПустаяСсылка();
	КонецЕсли;
КонецФункции

// Функция поиска существующей карточки учета
// Параметры:
//  	Документ - СправочникСсылка.aps_ЭлементыИзделия 
// Возвращаемое значение:
//		СправочникСсылка.aps_ИнвентарныеКниги
// Пример:
//		СтрокаДерева.КарточкаУчета = aps_НайтиАрхивныйДокумент(itemXDTO.element).Владелец;
Функция aps_НайтиАрхивныйДокумент( Документ ) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	aps_АрхивныеДокументы.Ссылка КАК АрхивныйДокумент
	               |ИЗ
	               |	Справочник.aps_АрхивныеДокументы КАК aps_АрхивныеДокументы
	               |ГДЕ
	               |	aps_АрхивныеДокументы.Документ = &Документ
	               |	И (НЕ aps_АрхивныеДокументы.ПометкаУдаления)";
	
	Запрос.УстановитьПараметр("Документ", Документ);
	
	Результат = Запрос.Выполнить().Выгрузить();
	Если Результат.Количество() > 0 Тогда
		Возврат Результат[0].АрхивныйДокумент;
	Иначе
		Возврат Справочники.aps_АрхивныеДокументы.ПустаяСсылка();
	КонецЕсли;
КонецФункции

// Функция получает документ карточки учета с последним изменением
// Параметры:
//  	КарточкаУчета - СправочникСсылка.aps_ИнвентарныеКниги
// Возвращаемое значение:
//		СправочникСсылка.aps_АрхивныеДокументы
// Пример:
//		Документ = aps_ПолучитьПоследнийДокументКарточки(КарточкаУчета);
Функция aps_ПолучитьПоследнийДокументКарточки( КарточкаУчета ) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	aps_АрхивныеДокументы.Ссылка
	               |ИЗ
	               |	Справочник.aps_АрхивныеДокументы КАК aps_АрхивныеДокументы
	               |ГДЕ
	               |	aps_АрхивныеДокументы.Владелец = &Владелец
	               |	И (НЕ aps_АрхивныеДокументы.ПометкаУдаления)
	               |АВТОУПОРЯДОЧИВАНИЕ";
	Запрос.УстановитьПараметр("Владелец", КарточкаУчета);
	
	Результат = Запрос.Выполнить().Выгрузить();
	Если Результат.Количество() > 0 Тогда
		Возврат Результат[Результат.Количество()-1].Ссылка;
	Иначе
		Возврат Справочники.aps_АрхивныеДокументы.ПустаяСсылка();
	КонецЕсли;
КонецФункции

