#Область ОписаниеПеременных

Перем ВидыЭлементовБезПозиции Экспорт; // массив элементов, для которых не заполняется позиция

#КонецОбласти


#Область ПрограммныйИнтерфейс

// Процедура обновляет модель данных для данного объекта
// Параметры:
//		parentXDTO - ОбъектXDTO, объект модели XDTO
//		ПравилоУправления - СправочникСсылка.aps_ПравилаУправления, Строка
// Пример:
//		aps_ОбновитьМодельXDTO( itemXDTO, ПравилоУправления );
//
Процедура aps_ОбновитьМодельXDTO( parentXDTO, Знач ПравилоУправления = Неопределено ) Экспорт
	
	Попытка	
		aps_ПолныеПрава.aps_ПроверитьЛицензиюСеанса();
	Исключение
		ВызватьИсключение ОписаниеОшибки();
	КонецПопытки;

	
	parentXDTOArray=Новый Массив;
	parentXDTOArray.Добавить(parentXDTO);
	Проводник.aps_ОбновитьМодельXDTOРек(parentXDTOArray, ПравилоУправления, 1);
	
КонецПроцедуры

// Процедура рекурсивно обновляет модель данных для массива объектов
// Параметры:
//		parentXDTOArray - массив объектов XDTO-модели
//		ПравилоУправления - СправочникСсылка.aps_ПравилаУправления, Строка
//		КолУровней (необязательный) - Число или Неопределено, число уровней для построения
// Пример:
//		aps_ОбновитьМодельXDTOРек(МассивXDTOДляПостроения, ПравилоУправления);
//
Процедура aps_ОбновитьМодельXDTOРек( parentXDTOArray, Знач ПравилоУправления = Неопределено, КолУровней = Неопределено, ВключаяПараметры = Истина ) Экспорт
	Проводник.aps_ОбновитьМодельXDTOРек(parentXDTOArray, ПравилоУправления, КолУровней, ВключаяПараметры);
КонецПроцедуры

// Процедура обновляет дерево представления по модели данных
// Параметры:
//		parentXDTO - объект модели XDTO
//		СтрокиДереваПредставления - строки дерева представления формы для обновления (необязательный)
//		ПараметрыОтображения - структура параметров отображения дерева (необязательный)
// Пример:
//      aps_ОбновитьДеревоПоМоделиXDTO(itemXDTO, СтрокаДереваПредставления.Строки, СтруктураПараметровОтображения);
//
Процедура aps_ОбновитьДеревоПоМоделиXDTO( parentXDTO, СтрокиДереваПредставления, ПараметрыОтображения = Неопределено ) Экспорт 
	Проводник.aps_ОбновитьДеревоПоМоделиXDTO(parentXDTO, СтрокиДереваПредставления, ПараметрыОтображения);
КонецПроцедуры

// Процедура обновляет дерево представления по модели данных целиком
// Параметры:
//		parentXDTO - объект модели XDTO
//		СтрокиДереваПредставления - строки дерева представления формы для обновления (необязательный)
//		ПараметрыОтображения - структура параметров отображения дерева (необязательный)
// Пример:
//		aps_ОбновитьДеревоПоМоделиXDTOРек(itemXDTO, СтрокаДереваПредставления.Строки, СтруктураПараметровОтображения);
//
Процедура aps_ОбновитьДеревоПоМоделиXDTOРек( parentXDTO, СтрокиДереваПредставления, ПараметрыОтображения = Неопределено ) Экспорт 
	Проводник.aps_ОбновитьДеревоПоМоделиXDTOРек(parentXDTO, СтрокиДереваПредставления, ПараметрыОтображения);
КонецПроцедуры


// Процедура оформляет спецификацию с помощью разделов
// Параметры:
//		parentXDTO			- объект модели XDTO
//		Сортировать			- Булево, сортировать элементы внутри части/раздела
//		НазначитьРазделы	- Булево, установить разделы спецификации
// Пример:
//		aps_ОформитьСпецификацию(itemXDTO, Истина, Истина, Истина);
//
Процедура aps_ОформитьСпецификацию( parentXDTO, Сортировать = Ложь, НазначитьРазделы = Ложь, СоздатьПараметрыСвязи = Ложь ) Экспорт 
	
	parentItemXDTO=?(parentXDTO.refLinkGroup, parentXDTO.Владелец(), parentXDTO);
	parentItem=parentItemXDTO.element;
	
	тзСпецификация = Новый ТаблицаЗначений;
	тзСпецификация.Колонки.Добавить("КодГруппы");
	тзСпецификация.Колонки.Добавить("КодВидаЭлемента");
	тзСпецификация.Колонки.Добавить("КодВидаДокумента");
	тзСпецификация.Колонки.Добавить("ШифрДокумента");
	тзСпецификация.Колонки.Добавить("ПозицияЧисловая");
	тзСпецификация.Колонки.Добавить("Обозначение");
	тзСпецификация.Колонки.Добавить("НомерИсполнения");
	тзСпецификация.Колонки.Добавить("Наименование");
	тзСпецификация.Колонки.Добавить("ПредставлениеЭлемента");
	
	тзСпецификация.Колонки.Добавить("Часть");
	тзСпецификация.Колонки.Добавить("ПорядокЧасти");
	тзСпецификация.Колонки.Добавить("Раздел");
	тзСпецификация.Колонки.Добавить("ПорядокРаздела");
	
	тзСпецификация.Колонки.Добавить("ПорядокВывода");
	тзСпецификация.Колонки.Добавить("ОбъектXDTO");
	
	// Заполнить таблицу по модели для последующей сортировки
	Для i=0 По parentXDTO.items.Количество()-1 Цикл
		itemXDTO = parentXDTO.items[i];
		Если itemXDTO.linkType <> Перечисления.aps_ВидыСвязей.СоставИзделия Тогда 
			СтрокаСпецификации = тзСпецификация.Добавить();
			СтрокаСпецификации.ОбъектXDTO = itemXDTO;
			СтрокаСпецификации.ПорядокЧасти		= 99999; // другие связи в конец таблицы
			СтрокаСпецификации.ПорядокВывода	= i;
			Продолжить;
		КонецЕсли;
		
		СтрокаСпецификации = тзСпецификация.Добавить();
		
		СтрокаСпецификации.Часть = МодульСозданияПараметров.aps_ПолучитьЗначениеПараметраПоСвойствуВXDTO(itemXDTO, ПланыВидовХарактеристик.aps_Свойства.Часть, Истина);
		СтрокаСпецификации.ПорядокЧасти = aps_ПолучитьПорядокЧасти(СтрокаСпецификации.Часть);
		
		СтрокаСпецификации.Раздел = МодульСозданияПараметров.aps_ПолучитьЗначениеПараметраПоСвойствуВXDTO(itemXDTO, ПланыВидовХарактеристик.aps_Свойства.Раздел, Истина);
		Если НазначитьРазделы И НЕ ЗначениеЗаполнено(СтрокаСпецификации.Раздел) Тогда 
			// получить раздел по умолчанию для вида элемента
			СтрокаСпецификации.Раздел = aps_ПолучитьРазделСпецификации(itemXDTO.elementType);
		КонецЕсли;
		
		СтрокаСпецификации.ПорядокРаздела = aps_ПолучитьПорядокРаздела(СтрокаСпецификации.Раздел);
		
		СтрокаСпецификации.КодВидаЭлемента	= itemXDTO.elementType.Код;
		
		Группа = МодульСозданияПараметров.aps_ПолучитьЗначениеПараметраПоСвойствуВXDTO(itemXDTO, ПланыВидовХарактеристик.aps_Свойства.Группа);
		СтрокаСпецификации.КодГруппы = ?(ЗначениеЗаполнено(Группа), Группа.Код, "");
		
		ВидДокумента = МодульСозданияПараметров.aps_ПолучитьЗначениеПараметраПоСвойствуВXDTO(itemXDTO, ПланыВидовХарактеристик.aps_Свойства.ВидДокумента);
		СтрокаСпецификации.КодВидаДокумента	= ?(ЗначениеЗаполнено(ВидДокумента), ВидДокумента.Код, "");
		
		СтрокаСпецификации.ШифрДокумента = Строка(МодульСозданияПараметров.aps_ПолучитьЗначениеПараметраПоСвойствуВXDTO(itemXDTO, ПланыВидовХарактеристик.aps_Свойства.ШифрДокумента));
		
		Позиция=МодульСозданияПараметров.aps_ПолучитьЗначениеПараметраПоСвойствуВXDTO(itemXDTO, ПланыВидовХарактеристик.aps_Свойства.Позиция, Истина);
		Попытка
			ПозицияЧисловая = Число(Позиция);
		Исключение
			ПозицияЧисловая = ""; // в конец
		КонецПопытки;

		СтрокаСпецификации.ПозицияЧисловая=ПозицияЧисловая;
		
 		СтрокаСпецификации.Обозначение				= Строка(МодульСозданияПараметров.aps_ПолучитьЗначениеПараметраПоСвойствуВXDTO(itemXDTO, ПланыВидовХарактеристик.aps_Свойства.Обозначение));
		СтрокаСпецификации.НомерИсполнения			= Строка(МодульСозданияПараметров.aps_ПолучитьЗначениеПараметраПоСвойствуВXDTO(itemXDTO, ПланыВидовХарактеристик.aps_Свойства.НомерИсполнения));
		СтрокаСпецификации.Наименование				= Строка(МодульСозданияПараметров.aps_ПолучитьЗначениеПараметраПоСвойствуВXDTO(itemXDTO, ПланыВидовХарактеристик.aps_Свойства.Наименование));
		СтрокаСпецификации.ПредставлениеЭлемента	= itemXDTO.description;
		СтрокаСпецификации.ОбъектXDTO				= itemXDTO;
		СтрокаСпецификации.ПорядокВывода			= i;
	КонецЦикла;
	
	тзСпецификация.Сортировать("ПорядокЧасти, Часть, ПорядокРаздела, Раздел"+?(Сортировать, ", КодГруппы, ПозицияЧисловая, КодВидаЭлемента, Обозначение, НомерИсполнения, КодВидаДокумента, ШифрДокумента, Наименование, ПредставлениеЭлемента", "")+", ПорядокВывода");
	
	
	СправочникПараметровСвязи = МодульСозданияПараметров.aps_ПолучитьСправочникПараметров(Справочники.aps_ВидыЭлементов.СвязьСостава);
	
	ДеревоСвойствСвязи=Новый ДеревоЗначений;
	МодульСозданияОбъектов.aps_ОбновитьДеревоСвойств(Справочники.aps_ВидыЭлементов.СвязьСостава, ДеревоСвойствСвязи);
	
	parentXDTO.items.Очистить();
	
	i = 0;
	Пока i < тзСпецификация.Количество() Цикл
		СтрокаСпецификации = тзСпецификация[i];
		
		itemXDTO = СтрокаСпецификации.ОбъектXDTO;
		
		Если itemXDTO.linkType <> Перечисления.aps_ВидыСвязей.СоставИзделия Тогда 
			parentXDTO.items.Добавить(itemXDTO);
			i = i + 1;
			Продолжить;
			
		ИначеЕсли СоздатьПараметрыСвязи Тогда 
			// связь состава изделия
			// добавление отсутствующих параметров связи (для изделий, созданных PLM-компонентами)
			локДеревоСвойствСвязи=ДеревоСвойствСвязи.Скопировать();
			СтрокиДереваСвойств=локДеревоСвойствСвязи.Строки.НайтиСтроки(Новый Структура("ЭтоГруппа", Ложь), Истина);
			Для Каждого СтрокаДереваСвойств Из СтрокиДереваСвойств Цикл 
				Если МодульСозданияПараметров.aps_ВспомНайтиПараметрПоСвойствуВXDTO(itemXDTO, СтрокаДереваСвойств.Свойство, Истина) <> Неопределено Тогда 
					// уже есть такой параметр связи
					СтрокаРодителя=СтрокаДереваСвойств.Родитель;
					Если СтрокаРодителя<>Неопределено Тогда 
						СтрокаРодителя.Строки.Удалить(СтрокаДереваСвойств);
						Если СтрокаРодителя.ЭтоГруппа И СтрокаРодителя.Строки.Количество()=0 И СтрокаРодителя.Родитель = Неопределено Тогда 
							// удалить пустую группу
							локДеревоСвойствСвязи.Строки.Удалить(СтрокаРодителя);
						КонецЕсли;
					Иначе
						локДеревоСвойствСвязи.Строки.Удалить(СтрокаДереваСвойств);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			
			// создание параметров связи по дереву
			МодульСозданияОбъектов.aps_СозданиеПараметровXDTOПоДереву(локДеревоСвойствСвязи.Строки, itemXDTO, Истина, СправочникПараметровСвязи);
		КонецЕсли;
		
		// установить раздел спецификации в параметр связи
		МодульСозданияПараметров.aps_УстановитьЗначениеПараметраПоСвойствуВXDTO(itemXDTO, ПланыВидовХарактеристик.aps_Свойства.Раздел, СтрокаСпецификации.Раздел, Истина);
		parentXDTO.items.Добавить(itemXDTO);
		i = i + 1;
	КонецЦикла;
	
	parentItemXDTO.modified=Истина;
	
КонецПроцедуры

// Процедура группирует одинаковые элементы в структуре изделия с подсчетом общего количества
// Параметры:
//		parentXDTO - объект модели XDTO
// Пример:
//		aps_СгруппироватьОдинаковые(itemXDTO);
//
Процедура aps_СгруппироватьОдинаковые( parentXDTO ) Экспорт 
	
	i=0;
	Пока i < parentXDTO.items.Количество()-1 Цикл 
		Если parentXDTO.items[i].linkType=Перечисления.aps_ВидыСвязей.СоставИзделия И parentXDTO.items[i].deleted<>Истина Тогда 
			// количество
			ОбщееКоличество=МодульСозданияПараметров.aps_ПолучитьЗначениеПараметраПоСвойствуВXDTO(parentXDTO.items[i], ПланыВидовХарактеристик.aps_Свойства.Количество);
			Попытка 
				ОбщееКоличество=Число(ОбщееКоличество);
			Исключение
				ОбщееКоличество=1;
			КонецПопытки;
			// примечание
			ОбщееПримечание=Строка(МодульСозданияПараметров.aps_ПолучитьЗначениеПараметраПоСвойствуВXDTO(parentXDTO.items[i], ПланыВидовХарактеристик.aps_Свойства.Примечание));
			// поз. обозначение
			ОбщееПозОбозначение=Строка(МодульСозданияПараметров.aps_ПолучитьЗначениеПараметраПоСвойствуВXDTO(parentXDTO.items[i], ПланыВидовХарактеристик.aps_Свойства.ПозиционноеОбозначение));
			
			CADID = Мин(parentXDTO.items[i].link.CADID, 1);
			
			Сгруппировано = Ложь;
			
			j=i+1;
			Пока j < parentXDTO.items.Количество() Цикл 
				Если parentXDTO.items[j].linkType=Перечисления.aps_ВидыСвязей.СоставИзделия И parentXDTO.items[j].deleted<>Истина
						И parentXDTO.items[j].element=parentXDTO.items[i].element И Мин(parentXDTO.items[j].link.CADID, 1)=CADID
						И МодульСозданияПараметров.aps_ПолучитьЗначениеПараметраПоСвойствуВXDTO(parentXDTO.items[j], ПланыВидовХарактеристик.aps_Свойства.ЕдиницыИзмерения)=МодульСозданияПараметров.aps_ПолучитьЗначениеПараметраПоСвойствуВXDTO(parentXDTO.items[i], ПланыВидовХарактеристик.aps_Свойства.ЕдиницыИзмерения) Тогда
						
					Количество=МодульСозданияПараметров.aps_ПолучитьЗначениеПараметраПоСвойствуВXDTO(parentXDTO.items[j], ПланыВидовХарактеристик.aps_Свойства.Количество);
					Попытка 
						Количество=Число(Количество);
					Исключение
						Количество=1;
					КонецПопытки;

					ОбщееКоличество=ОбщееКоличество+Количество;
					
					Примечание=Строка(МодульСозданияПараметров.aps_ПолучитьЗначениеПараметраПоСвойствуВXDTO(parentXDTO.items[j], ПланыВидовХарактеристик.aps_Свойства.Примечание));
					Если НЕ ПустаяСтрока(Примечание) Тогда 
						ОбщееПримечание=?(ПустаяСтрока(ОбщееПримечание), "", ОбщееПримечание+", ")+Примечание;
					КонецЕсли;
					
					ПозОбозначение=Строка(МодульСозданияПараметров.aps_ПолучитьЗначениеПараметраПоСвойствуВXDTO(parentXDTO.items[j], ПланыВидовХарактеристик.aps_Свойства.ПозиционноеОбозначение));
					Если НЕ ПустаяСтрока(ПозОбозначение) Тогда
						ОбщееПозОбозначение=?(ПустаяСтрока(ОбщееПозОбозначение), "", ОбщееПозОбозначение+", ")+ПозОбозначение;
					КонецЕсли;
					
					Сгруппировано = Истина;
					
					Если parentXDTO.items[j].added=Истина Тогда 
						parentXDTO.items.Удалить(j); Продолжить;
					Иначе 
						parentXDTO.items[j].deleted=Истина; // пометить на удаление
					КонецЕсли;
				КонецЕсли;
				j=j+1;
			КонецЦикла;
			
			Если Сгруппировано Тогда 
				МодульСозданияПараметров.aps_УстановитьЗначениеПараметраПоСвойствуВXDTO(parentXDTO.items[i], ПланыВидовХарактеристик.aps_Свойства.Количество, ОбщееКоличество, Истина);
				МодульСозданияПараметров.aps_УстановитьЗначениеПараметраПоСвойствуВXDTO(parentXDTO.items[i], ПланыВидовХарактеристик.aps_Свойства.Примечание, ОбщееПримечание, Истина);
				МодульСозданияПараметров.aps_УстановитьЗначениеПараметраПоСвойствуВXDTO(parentXDTO.items[i], ПланыВидовХарактеристик.aps_Свойства.ПозиционноеОбозначение, ОбщееПозОбозначение, Истина);
			КонецЕсли;
		КонецЕсли;
		i=i+1;
	КонецЦикла;
	
КонецПроцедуры

// Процедура импортирует данные из внешнего источника в режиме рабочей копии
// Параметры:
//		parentXDTO - объект модели XDTO
//		ТаблицаИмпорта - ТаблицаЗначений, таблица данных импорта
// Пример:
//		aps_ИмпортДанныхСпецификации(parentXDTO, Параметр);
//
Процедура aps_ИмпортДанныхСпецификации( parentXDTO, ТаблицаИмпорта ) Экспорт 
	МассивСтрокКолонок=КолонкиСпецификации.НайтиСтроки(Новый Структура("ВидЭлемента",parentXDTO.elementType));
	Если МассивСтрокКолонок.Количество()=0 Тогда 
		МассивСтрокКолонок=КолонкиСпецификации.НайтиСтроки(Новый Структура("ВидЭлемента",Справочники.aps_ВидыЭлементов.ПустаяСсылка()));
	КонецЕсли;
	ТаблицаКолонок=КолонкиСпецификации.Выгрузить(МассивСтрокКолонок);
	
	МассивРодителей=Новый Массив();
	МассивРодителей.Добавить( parentXDTO );
	
	itemXDTO=Неопределено;
	ТекущийУровень=1;
	Для i=0 По ТаблицаИмпорта.Количество()-1 Цикл 
		СтрокаИмпорта=ТаблицаИмпорта[i];
		Если СтрокаИмпорта.Уровень=0 Тогда 
			СтрокаИмпорта.Уровень=1;
		КонецЕсли;
		
		Если СтрокаИмпорта.Уровень>ТекущийУровень И i>0 Тогда
			МассивРодителей.Добавить( itemXDTO );
			ТекущийУровень=ТекущийУровень+1;
		ИначеЕсли СтрокаИмпорта.Уровень<ТекущийУровень Тогда
			РазницаУровней=ТекущийУровень-СтрокаИмпорта.Уровень;
			Для k=1 По РазницаУровней Цикл 
				МассивРодителей.Удалить(МассивРодителей.Количество()-1);
			КонецЦикла;
			ТекущийУровень=ТекущийУровень-РазницаУровней;
		КонецЕсли;
		
		// первая колонка всегда ВидЭлемента
		ВидЭлементаИмпорта = СтрокаИмпорта.ВидЭлемента; НайденныеСвойства = Новый Массив();
		
		Если ТипЗнч(ВидЭлементаИмпорта)<>Тип("СправочникСсылка.aps_ВидыЭлементов") Тогда 
			itemXDTO = aps_СоздатьОбъектМоделиXDTO(ВидЭлементаИмпорта);
		Иначе
			ДеревоСвойств = Новый ДеревоЗначений;
			МодульСозданияОбъектов.aps_ОбновитьДеревоСвойств(ВидЭлементаИмпорта, ДеревоСвойств);
			///////////////////////////////////////////////////////
			// заполнение значений дерева свойств по таблице (для элемента)
			СтрокиДереваСвойств=ДеревоСвойств.Строки.НайтиСтроки(Новый Структура("ЭтоГруппа", Ложь), Истина);
			Для Каждого СтрокаДереваСвойств Из СтрокиДереваСвойств Цикл 
				КолонкаСпецификации = ТаблицаКолонок.Найти(СтрокаДереваСвойств.Свойство);
				Если КолонкаСпецификации <> Неопределено Тогда 
					ИндексКолонки = ТаблицаКолонок.Индекс(КолонкаСпецификации);
					Если ИндексКолонки < ТаблицаИмпорта.Колонки.Количество()-2 Тогда 
						ТипЗначенияСвойства = СтрокаДереваСвойств.Свойство.ТипЗначения;
						ЗначениеПараметра = aps_ПреобразоватьЗначениеПараметра(СтрокаИмпорта[ИндексКолонки+2], ТипЗначенияСвойства);
						СтрокаДереваСвойств.Значение = ЗначениеПараметра;
					КонецЕсли;
					
					НайденныеСвойства.Добавить(СтрокаДереваСвойств.Свойство);
				КонецЕсли; // Если КолонкаСпецификации <> Неопределено Тогда 
			КонецЦикла;
			
			Попытка
				СуществующийЭлемент = Неопределено;
				itemXDTO = МодульСозданияОбъектов.aps_СозданиеОбъектаPDM(ВидЭлементаИмпорта, ДеревоСвойств, СуществующийЭлемент);
				itemXDTO.created = Истина;
			Исключение
				Если СуществующийЭлемент <> Неопределено Тогда 
					itemXDTO = aps_СоздатьОбъектМоделиXDTO( СуществующийЭлемент );
				Иначе // другая ошибка
					Сообщить(ПараметрыСеанса.aps_ИмяПродукта+НСтр("ru = ""Не удалось импортировать элемент:""; en_US = ""Cannot import the item:""")+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), СтатусСообщения.Внимание);
					Продолжить;
				КонецЕсли;
			КонецПопытки;
		КонецЕсли;
			
		itemXDTO.link	  = СериализаторXDTO.ЗаписатьXDTO(Справочники.aps_ЭлементыСвязей.ПолучитьСсылку());
		itemXDTO.linkType = СериализаторXDTO.ЗаписатьXDTO(Перечисления.aps_ВидыСвязей.СоставИзделия);
		
		ДеревоСвойствСвязи = Новый ДеревоЗначений;
		МодульСозданияОбъектов.aps_ОбновитьДеревоСвойств(Справочники.aps_ВидыЭлементов.СвязьСостава, ДеревоСвойствСвязи);
		///////////////////////////////////////////////////////////
		// заполнение значений дерева свойств по таблице (для связи)
		СтрокиДереваСвойств=ДеревоСвойствСвязи.Строки.НайтиСтроки(Новый Структура("ЭтоГруппа", Ложь), Истина);
		Для Каждого СтрокаДереваСвойств Из СтрокиДереваСвойств Цикл 
			КолонкаСпецификации = ТаблицаКолонок.Найти(СтрокаДереваСвойств.Свойство);
			Если КолонкаСпецификации <> Неопределено Тогда 
				ИндексКолонки = ТаблицаКолонок.Индекс(КолонкаСпецификации);
				Если ИндексКолонки < ТаблицаИмпорта.Колонки.Количество()-2 Тогда 
					ТипЗначенияСвойства = СтрокаДереваСвойств.Свойство.ТипЗначения;
					ЗначениеПараметра = aps_ПреобразоватьЗначениеПараметра(СтрокаИмпорта[ИндексКолонки+2], ТипЗначенияСвойства);
					СтрокаДереваСвойств.Значение = ЗначениеПараметра;
				КонецЕсли;
				
				НайденныеСвойства.Добавить(СтрокаДереваСвойств.Свойство);
			КонецЕсли; // Если КолонкаСпецификации <> Неопределено Тогда 
		КонецЦикла;

		// параметры связи в xdto-модели
		МодульСозданияОбъектов.aps_СозданиеПараметровXDTOПоДереву(ДеревоСвойствСвязи.Строки, itemXDTO, Истина);
		
		// оставшиеся параметры
		Для Каждого КолонкаСпецификации Из ТаблицаКолонок Цикл 
			Если НайденныеСвойства.Найти(КолонкаСпецификации.Свойство)=Неопределено И ЗначениеЗаполнено(КолонкаСпецификации.Свойство) Тогда 
				ИндексКолонки = ТаблицаКолонок.Индекс(КолонкаСпецификации);
				Если ИндексКолонки < ТаблицаИмпорта.Колонки.Количество()-2 Тогда 
					ТипЗначенияСвойства = КолонкаСпецификации.Свойство.ТипЗначения;
					ЗначениеПараметра = aps_ПреобразоватьЗначениеПараметра(СтрокаИмпорта[ИндексКолонки+2], ТипЗначенияСвойства);
					МодульСозданияПараметров.aps_УстановитьЗначениеПараметраПоСвойствуВXDTO(itemXDTO, КолонкаСпецификации.Свойство, ЗначениеПараметра);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		
		itemXDTO.added	  =Истина;
		itemXDTO.modified =Истина;
		
		aps_ОбновитьПредставлениеВМоделиXDTO(itemXDTO);
		
		currentParentXDTO=МассивРодителей[МассивРодителей.Количество()-1];
		
		ПозДляВставки=Неопределено; // определить позицию для вставки объекта
		aps_НайтиВМассивеXDTO(currentParentXDTO.items, Новый Структура("refLinkGroup", Истина), ПозДляВставки);
		
		Если ПозДляВставки <> Неопределено Тогда 
			currentParentXDTO.items.Вставить(ПозДляВставки, itemXDTO);
			ПозДляВставки = ПозДляВставки + 1;
		Иначе 
			currentParentXDTO.items.Добавить(itemXDTO);
		КонецЕсли;
		
		currentParentXDTO.modified=Истина;
		
	КонецЦикла;
	
КонецПроцедуры


// Функция запускает управляемый проводник ИС в режиме выбора и возвращает xdto-модели выбранных элементов
// Параметры:
//		СтрокаСоединения - строка, строка соединения с базой Инженерного справочника
//		МассивДоступныхВидов - массив ссылок на виды элементов, которые можно выбрать из ИС, или один вид элемента
// Возвращаемое значение:
//		Массив XDTO-моделей выбранных элементов
// Пример:
//      ЗначениеВыбора = Обработки.aps_УправлениеИзделиями.Создать().aps_ВыбратьИзИС(СтрокаСоединения, Справочники.aps_ВидыЭлементов.Материал);
//
Функция aps_ВыбратьИзИС(СтрокаСоединения, Знач МассивДоступныхВидов = Неопределено) Экспорт 
	Попытка	
		aps_ПолныеПрава.aps_ПроверитьЛицензиюСеанса();
	Исключение
		ВызватьИсключение ОписаниеОшибки();
	КонецПопытки;
	
	Попытка
		V8_Application = Новый COMОбъект("V82c.Application");
	Исключение
		V8_Application = Новый COMОбъект("V83c.Application");	
	КонецПопытки;

	 
	СоединениеУстановлено = V8_Application.Connect( СтрокаСоединения );
	Если Не СоединениеУстановлено Тогда 
		Возврат Неопределено;
	КонецЕсли;
	
	V8_Application.Visible = Ложь;
	
	ИмяФайлаДляЗагрузки = ПолучитьИмяВременногоФайла(".xml");
	
	ПараметрыФормы = V8_Application.NewObject("Структура");
	ПараметрыФормы.Вставить("ОткрытьПрименяемость"	, Истина);
	ПараметрыФормы.Вставить("РежимВыбора"			, Истина);
	ПараметрыФормы.Вставить("ВыбиратьXDTO"			, Истина);
	ПараметрыФормы.Вставить("ВнешнееСоединение"		, Истина);
	ПараметрыФормы.Вставить("ИмяФайлаОбмена"		, ИмяФайлаДляЗагрузки);
	
	Если МассивДоступныхВидов <> Неопределено Тогда 
		Если ТипЗнч(МассивДоступныхВидов) <> Тип("Массив") Тогда 
			ВидЭлемента = МассивДоступныхВидов;
			МассивДоступныхВидов = Новый Массив();
			МассивДоступныхВидов.Добавить(ВидЭлемента);
		КонецЕсли;
		
		внешСписокДоступныхВидов = V8_Application.NewObject("СписокЗначений");
		Для Каждого ВидЭлемента Из МассивДоступныхВидов Цикл 
			внешСписокДоступныхВидов.Добавить(Object1С2Строка(ВидЭлемента));
		КонецЦикла;
		
		ПараметрыФормы.Вставить("ДоступныеВидыЭлементов", внешСписокДоступныхВидов);
	КонецЕсли;
	
	Попытка
		ФормаПроводника = V8_Application.ПолучитьФорму("Обработка.aps_Проводник.Форма", ПараметрыФормы);
	Исключение
		ФормаПроводника = V8_Application.ПолучитьФорму("Обработка.aps_Проводник.Форма", ПараметрыФормы);
	КонецПопытки;
	
	МассивВыбораCOM = ФормаПроводника.ОткрытьМодально();
	Если МассивВыбораCOM = Неопределено Тогда 
		Возврат Неопределено;
	КонецЕсли;
	
	// загрузка дополнительных данных ссылочного типа из Инженерного справочника
	// (свойств, значений, единиц измерений)
	ОбработкаЗагрузки = Обработки.УниверсальныйОбменДаннымиXML.Создать();
	ОбработкаЗагрузки.ЗаписыватьВИнформационнуюБазуТолькоИзмененныеОбъекты = Ложь;
	ОбработкаЗагрузки.ИмяФайлаОбмена = ИмяФайлаДляЗагрузки;
	ОбработкаЗагрузки.РежимОбмена = "Загрузка";
	ОбработкаЗагрузки.НеВыводитьНикакихИнформационныхСообщенийПользователю = Истина;
	ОбработкаЗагрузки.ВыполнитьЗагрузку();
	
	МассивXDTO=Новый Массив;
	Для i=0 По МассивВыбораCOM.Количество()-1 Цикл 
		itemXDTO = Строка2XDTO(МассивВыбораCOM.Получить(i));
		Если itemXDTO.element.ПолучитьОбъект()=Неопределено Или itemXDTO.element.ПометкаУдаления Тогда 
			itemXDTO.created = Истина;
		КонецЕсли;
		МассивXDTO.Добавить(itemXDTO);
	КонецЦикла;
	
	Возврат МассивXDTO;
КонецФункции

#КонецОбласти


