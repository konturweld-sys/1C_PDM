// Обработчик события "OnActivate" блока div
// Параметры:
//		element - COMОбъект, блок div
Функция JavaScriptDivActivate( element ) Экспорт
	
	Если ФормаОбработки <> Неопределено Тогда 
		ФормаОбработки.ПриАктивизацииБлокаЭлемента(element);
	КонецЕсли;
	
КонецФункции

