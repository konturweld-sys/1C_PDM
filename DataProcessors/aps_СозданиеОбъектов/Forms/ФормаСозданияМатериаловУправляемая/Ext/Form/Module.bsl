Перем document;
&НаКлиенте
Перем СозданныеЭлементы Экспорт;

#КонецОбласти

#Если НЕ МобильноеПриложениеСервер Тогда
	
#Область ОбработчикиСобытийФормыНаСервере	
	
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("МаркаМатериала") Тогда 
		МаркаМатериала = Параметры.МаркаМатериала;
	КонецЕсли;
	Если Параметры.Свойство("Сортамент") Тогда 
		Сортамент = Параметры.Сортамент;
	КонецЕсли;
	Если Параметры.Свойство("Типоразмер") Тогда 
		Типоразмер = Параметры.Типоразмер;
	КонецЕсли;
	Если Параметры.Свойство("ПредыдущаяРевизия") Тогда
		ПредыдущаяРевизия = Параметры.ПредыдущаяРевизия;
		ОригиналРевизии	  = ?(ЗначениеЗаполнено(ПредыдущаяРевизия.ОригиналРевизии), ПредыдущаяРевизия.ОригиналРевизии, ПредыдущаяРевизия);
		
		СвойствоМаркаМатериала = ПланыВидовХарактеристик.aps_Свойства.МаркаМатериала;
		СвойствоСортамент	   = ПланыВидовХарактеристик.aps_Свойства.Сортамент;
		СвойствоТипоразмер	   = ПланыВидовХарактеристик.aps_Свойства.Типоразмер;
		ВидЭлементаМаркаМатериала = Справочники.aps_ВидыЭлементов.МаркаМатериала;
		ВидЭлементаСортамент      = Справочники.aps_ВидыЭлементов.Сортамент;
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		               |	aps_ЭлементыСправочников.Ссылка
		               |ИЗ
		               |	Справочник.aps_ЭлементыСправочников КАК aps_ЭлементыСправочников
		               |ГДЕ
		               |	aps_ЭлементыСправочников.ВидЭлемента = &ВидЭлемента
		               |	И aps_ЭлементыСправочников.Параметры.Параметр.Значение = &Значение
		               |	И aps_ЭлементыСправочников.Параметры.Параметр.Свойство = &Свойство";
		ДополнительныеСвойства = Новый Соответствие;			   
		
		Для Каждого СтрокаПараметра Из ПредыдущаяРевизия.Параметры Цикл
			Свойство = СтрокаПараметра.Параметр.Свойство;
			Значение = СтрокаПараметра.Параметр.Значение;
			
			Если Свойство = СвойствоМаркаМатериала Тогда
				Запрос.УстановитьПараметр("Свойство", Свойство);
				Запрос.УстановитьПараметр("Значение", Значение);
				Запрос.УстановитьПараметр("ВидЭлемента", ВидЭлементаМаркаМатериала);
				тзРезультаты = Запрос.Выполнить().Выгрузить();
				Если тзРезультаты.Количество() > 0 Тогда
					МаркаМатериала = тзРезультаты[0].Ссылка;
				КонецЕсли;
				
			ИначеЕсли Свойство = СвойствоСортамент Тогда 
				Запрос.УстановитьПараметр("Свойство", Свойство);
				Запрос.УстановитьПараметр("Значение", Значение);
				Запрос.УстановитьПараметр("ВидЭлемента", ВидЭлементаСортамент);
				тзРезультаты = Запрос.Выполнить().Выгрузить();
				Если тзРезультаты.Количество() > 0 Тогда
					Сортамент = тзРезультаты[0].Ссылка;
				КонецЕсли;
				
			ИначеЕсли Свойство = СвойствоТипоразмер Тогда 
				Типоразмер = Значение;
			Иначе
				ДополнительныеСвойства.Вставить(Свойство, Значение);
			КонецЕсли;
		КонецЦикла;
		
		АдресДополнительныхСвойств = ПоместитьВоВременноеХранилище(ДополнительныеСвойства, ЭтаФорма.УникальныйИдентификатор);
	КонецЕсли;
	
	virtualappiushost = "http://virtualappiushost";
	temp = СтрЗаменить(КаталогВременныхФайлов(), "\", "/");
 	// Подложка
	ТекстПодложки = aps_УправлениеВиртуальнымХостом.aps_ПолучитьТекстШаблона(virtualappiushost+"/TEMPLATES/basic/layers/presentation.htm", Истина);
	// загрузить текст подложки первый раз
	ПредставлениеHTML = ТекстПодложки;
КонецПроцедуры

#КонецОбласти


#Область ПрочиеПроцедурыИФункцииНаСервере

&НаСервере
Процедура ОбновитьШаблонПредставления()
	
	ПредставлениеМатериала.Очистить();
	
	//////////////////////////////////////////////////////////////////////////////////////////
	// получить документы (на марку, на сортамент, на технические условия)
	ПолучитьДокументы();

	МодульСозданияПараметров = Обработки.aps_СозданиеПараметров.Создать();
    	
	Если ЗначениеЗаполнено(ДокументНаТУ) И ЗначениеЗаполнено(Сортамент) И ДокументНаТУ.ПредставлениеЭлементовРесурса.Количество()>0 Тогда
		МассивПараметров = ДокументНаТУ.ПредставлениеЭлементовРесурса.ВыгрузитьКолонку("Параметр");
		знчСтандартНаТУ = МодульСозданияПараметров.aps_ВспомНайтиПараметрПоСвойству(ДокументНаТУ, ПланыВидовХарактеристик.aps_Свойства.ТУ).Значение;
		Если НЕ ЗначениеЗаполнено(знчСтандартНаТУ) Тогда
			знчСтандартНаТУ = МодульСозданияПараметров.aps_ВспомНайтиПараметрПоСвойству(ДокументНаТУ, ПланыВидовХарактеристик.aps_Свойства.СтдНаСортамент).Значение;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(знчСтандартНаТУ) Тогда
			знчСтандартНаТУ = МодульСозданияПараметров.aps_ВспомНайтиПараметрПоСвойству(ДокументНаТУ, ПланыВидовХарактеристик.aps_Свойства.СтдНаМарку).Значение;
		КонецЕсли;
	
		Для i=0 По МассивПараметров.Количество()-1 Цикл
			Параметр = МассивПараметров[i];
			Если ТипЗнч(Параметр) = Тип("Строка") Тогда
				Если i=0 Тогда
					НоваяСтрокаПредставления = ПредставлениеМатериала.Добавить();
					НоваяСтрокаПредставления.Свойство = ПланыВидовХарактеристик.aps_Свойства.Комментарий;
					НоваяСтрокаПредставления.Значение = Параметр;
					НоваяСтрокаПредставления.ГруппаПараметров = "Сортамент";
				КонецЕсли;
				Продолжить;
			КонецЕсли;
			
			Свойство = Параметр.Свойство;
			НоваяСтрокаПредставления = ПредставлениеМатериала.Добавить();
			НоваяСтрокаПредставления.Свойство = Свойство;
			ПараметрМарки = МодульСозданияПараметров.aps_ВспомНайтиПараметрПоСвойству(МаркаМатериала, Свойство);
			ПараметрСортамента = МодульСозданияПараметров.aps_ВспомНайтиПараметрПоСвойству(Сортамент, Свойство);
			Если ЗначениеЗаполнено(ПараметрМарки) Тогда
				НоваяСтрокаПредставления.Значение = ПараметрМарки.Значение;
				НоваяСтрокаПредставления.ГруппаПараметров = "Марка материала";
			ИначеЕсли ЗначениеЗаполнено(ПараметрСортамента) Тогда
				НоваяСтрокаПредставления.Значение = ПараметрСортамента.Значение;
				НоваяСтрокаПредставления.ГруппаПараметров = "Сортамент";
			КонецЕсли;
			
			Если i>0 Тогда
				НоваяСтрокаПредставления.Префикс = МассивПараметров[i-1];
			КонецЕсли;
		КонецЦикла;
		
		ПараметрТипоразмер = ПредставлениеМатериала.НайтиСтроки(Новый Структура("Свойство", ПланыВидовХарактеристик.aps_Свойства.Типоразмер));
		Если ПараметрТипоразмер.Количество() > 0 Тогда 
			ПараметрТипоразмер = ПараметрТипоразмер[0];
			ПараметрТипоразмер.Значение = Типоразмер;
			ПараметрТипоразмер.ГруппаПараметров = "Типоразмер";
		КонецЕсли;
		ПараметрТУ = ПредставлениеМатериала.НайтиСтроки(Новый Структура("Свойство", ПланыВидовХарактеристик.aps_Свойства.ТУ));
		Если ПараметрТУ.Количество() > 0 Тогда
			ПараметрТУ = ПараметрТУ[0];
			ПараметрТУ.Значение = знчСтандартНаТУ;
			ПараметрТУ.ГруппаПараметров = "Технические условия";
		КонецЕсли;
		
	ИначеЕсли ЗначениеЗаполнено(МаркаМатериала) Тогда 
		// заполнить список параметрами из представления марки материала
		МассивПараметров = МаркаМатериала.ПредставлениеЭлемента.ВыгрузитьКолонку("Параметр");
		Для i=0 По МассивПараметров.Количество()-1 Цикл
			Параметр = МассивПараметров[i];
			Если ТипЗнч(Параметр) = Тип("Строка") ИЛИ НЕ ЗначениеЗаполнено(Параметр.Значение) Тогда
				Продолжить;
			КонецЕсли;
			НоваяСтрокаПредставления = ПредставлениеМатериала.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаПредставления, Параметр);
			Если i>0 Тогда
				НоваяСтрокаПредставления.Префикс = МассивПараметров[i-1];
			КонецЕсли;
			НоваяСтрокаПредставления.ГруппаПараметров = "Марка материала";
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокМарокМатериалов()
	МассивЗначений = ПотомкиЭлемента(Сортамент, Справочники.aps_ШаблоныТехнологическихСвязей.МаркиМатериаловСортаменты);
	Элементы.МаркаМатериала.СписокВыбора.ЗагрузитьЗначения(МассивЗначений);
	
	Если (НЕ ЗначениеЗаполнено(МаркаМатериала) Или МассивЗначений.Найти(МаркаМатериала)=Неопределено) И МассивЗначений.Количество()>0 Тогда
		МаркаМатериала = МассивЗначений[0];
	КонецЕсли;
	
	Элементы.МаркаМатериала.КнопкаСпискаВыбора = (Элементы.МаркаМатериала.СписокВыбора.Количество() > 1);
КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокСортаментов()
	МассивЗначений = ПотомкиЭлемента(МаркаМатериала, Справочники.aps_ШаблоныТехнологическихСвязей.МаркиМатериаловСортаменты);
	Элементы.Сортамент.СписокВыбора.ЗагрузитьЗначения(МассивЗначений);
	
	Если (НЕ ЗначениеЗаполнено(Сортамент) Или МассивЗначений.Найти(Сортамент)=Неопределено) И МассивЗначений.Количество()>0 Тогда
		Сортамент = МассивЗначений[0];
	КонецЕсли;
	
	Элементы.Сортамент.КнопкаСпискаВыбора = (Элементы.Сортамент.СписокВыбора.Количество() > 0);
КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокТипоразмеров()
	Если Элементы.ФильтрТипоразмеров.Пометка Тогда 
		МассивЗначений = ПотомкиСвязи(МаркаМатериала, Сортамент, Справочники.aps_ШаблоныТехнологическихСвязей.ДоступныеТипоразмеры);
	Иначе 
		МассивЗначений = ПотомкиЭлемента(Сортамент, Справочники.aps_ШаблоныТехнологическихСвязей.ТипоразмерыСортамента);
	КонецЕсли;
	
	СписокВыбора = Элементы.Типоразмер.СписокВыбора;
	СписокВыбора.Очистить();
	Для Каждого ТипоразмерСсылка Из МассивЗначений Цикл 
		СписокВыбора.Добавить(ТипоразмерСсылка);
	КонецЦикла;
		
	Если НЕ ЗначениеЗаполнено(Типоразмер) Тогда 
		Типоразмер = ?(МассивЗначений.Количество()>0, МассивЗначений[0], Неопределено);
	ИначеЕсли МассивЗначений.Найти(Типоразмер)=Неопределено
		И Элементы.ФильтрТипоразмеров.Пометка Тогда // типоразмер из общего списка поместить в список доступных
		СписокВыбора.Добавить(Типоразмер);
	КонецЕсли;
	
	Элементы.Типоразмер.КнопкаСпискаВыбора = (Элементы.Типоразмер.СписокВыбора.Количество() > 0);
	Если Элементы.Типоразмер.СписокВыбора.Количество() > 0 Тогда 
		Элементы.Типоразмер.Подсказка = "";
	Иначе 
		Элементы.Типоразмер.Подсказка = ?(Элементы.ФильтрТипоразмеров.Пометка, "Нет доступных типоразмеров", "Нет типоразмеров");
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПотомкиСвязи(РодительСсылка, ПотомокСсылка, ВидСвязи)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	aps_ЭлементыСвязей.ПотомокСсылка КАК ЭлементСсылка
	               |ИЗ
	               |	Справочник.aps_ЭлементыСвязей КАК aps_ЭлементыСвязей
	               |ГДЕ
	               |	aps_ЭлементыСвязей.РодительСсылка.РодительСсылка = &РодительСсылка
	               |	И aps_ЭлементыСвязей.РодительСсылка.ПотомокСсылка = &ПотомокСсылка
	               |	И aps_ЭлементыСвязей.ВидСвязи = &ВидСвязи
	               |	И НЕ aps_ЭлементыСвязей.ПометкаУдаления
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	aps_ЭлементыСвязей.ПорядокВывода";
	Запрос.УстановитьПараметр("РодительСсылка"	, РодительСсылка);
	Запрос.УстановитьПараметр("ПотомокСсылка"	, ПотомокСсылка);
	Запрос.УстановитьПараметр("ВидСвязи"		, ВидСвязи);
	МассивЭлементов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ЭлементСсылка");
	Возврат МассивЭлементов;
КонецФункции

&НаСервереБезКонтекста
Функция ПотомкиЭлемента(РодительСсылка, ВидСвязи)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Потомки.ЭлементСсылка КАК ЭлементСсылка,
	               |	Потомки.ЭлементСсылка.Наименование КАК Наименование
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ВЫБОР
	               |			КОГДА aps_ЭлементыСвязей.РодительСсылка = &РодительСсылка
	               |				ТОГДА aps_ЭлементыСвязей.ПотомокСсылка
	               |			ИНАЧЕ aps_ЭлементыСвязей.РодительСсылка
	               |		КОНЕЦ КАК ЭлементСсылка
	               |	ИЗ
	               |		Справочник.aps_ЭлементыСвязей КАК aps_ЭлементыСвязей
	               |	ГДЕ
	               |		(aps_ЭлементыСвязей.РодительСсылка = &РодительСсылка
	               |				ИЛИ aps_ЭлементыСвязей.ПотомокСсылка = &РодительСсылка)
	               |		И aps_ЭлементыСвязей.ВидСвязи = &ВидСвязи
	               |		И НЕ aps_ЭлементыСвязей.ПометкаУдаления) КАК Потомки
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Наименование";
	Запрос.УстановитьПараметр("РодительСсылка"	, РодительСсылка);
	Запрос.УстановитьПараметр("ВидСвязи"		, ВидСвязи);
	МассивЭлементов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ЭлементСсылка");
	Возврат МассивЭлементов;
КонецФункции

&НаСервере
Процедура ПолучитьДокументы()
	ДокументНаМарку 	= Неопределено;
	ДокументНаСортамент = Неопределено;
	ДокументНаТУ 		= Неопределено;
	
	ВидСвязиДокументы = Справочники.aps_ШаблоныТехнологическихСвязей.Документы;
	
	МассивДокументов = ПотомкиСвязи(МаркаМатериала, Сортамент, ВидСвязиДокументы);
	Если МассивДокументов.Количество()>0 Тогда
		ДокументНаТУ = МассивДокументов[0];
	КонецЕсли;
	МассивДокументов = ПотомкиЭлемента(Сортамент, ВидСвязиДокументы);
	Если МассивДокументов.Количество()>0 Тогда
		ДокументНаСортамент = МассивДокументов[0];
		Если НЕ ЗначениеЗаполнено(ДокументНаТУ) И ДокументНаСортамент.ПредставлениеЭлементовРесурса.Количество()>0 Тогда
			ДокументНаТУ = ДокументНаСортамент;
		КонецЕсли;
	КонецЕсли;
	МассивДокументов = ПотомкиЭлемента(МаркаМатериала, ВидСвязиДокументы);
	Если МассивДокументов.Количество()>0 Тогда
		ДокументНаМарку = МассивДокументов[0];
		Если НЕ ЗначениеЗаполнено(ДокументНаТУ) И ДокументНаМарку.ПредставлениеЭлементовРесурса.Количество()>0 Тогда
			ДокументНаТУ = ДокументНаМарку;
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСсылкуСвойства(ИмяПредопределенного)
	Возврат ПланыВидовХарактеристик.aps_Свойства[ИмяПредопределенного];
КонецФункции
	
&НаСервереБезКонтекста
Функция ПолучитьЗначенияСвойства(Свойство)
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	aps_ЗначенияСвойств.Ссылка
	               |ИЗ
	               |	Справочник.aps_ЗначенияСвойств КАК aps_ЗначенияСвойств
	               |ГДЕ
	               |	aps_ЗначенияСвойств.Владелец = &Владелец
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	aps_ЗначенияСвойств.Наименование";
	Запрос.УстановитьПараметр("Владелец", Свойство);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
КонецФункции

&НаСервере
Функция СоздатьМатериалСервер(ПредставлениеМатериалаHTML = "", СтрокаПредупреждения = "")
	МодульСозданияОбъектов = Обработки.aps_СозданиеОбъектов.Создать();
	МодульСозданияПараметров = Обработки.aps_СозданиеПараметров.Создать();
	
	НачатьТранзакцию();
	
	Попытка
		СсылкаСуществующего = Неопределено;
		НовыйМатериал = МодульСозданияОбъектов.aps_СозданиеОбъектаPDM(Справочники.aps_ВидыЭлементов.Материал, ПолучитьДеревоСвойств(), СсылкаСуществующего);
		
		НовыйМатериалСсылка = НовыйМатериал.Ссылка;
		ПредставлениеЭлемента = НовыйМатериал.ПредставлениеЭлемента;
		ПредставлениеЭлемента.Очистить();
		
		ПредыдущийПрефикс = "";
		Для Каждого СтрокаПредставления Из ПредставлениеМатериала Цикл
			Если ЗначениеЗаполнено(СтрокаПредставления.Значение) Тогда
				Префикс = ?(ПредыдущийПрефикс<>"", ПредыдущийПрефикс, СтрокаПредставления.Префикс);
				ПредыдущийПрефикс = "";
				Если Префикс <> "" Тогда
					ПредставлениеЭлемента.Добавить().Параметр = Префикс;
				КонецЕсли;
				ПредставлениеЭлемента.Добавить().Параметр = МодульСозданияПараметров.aps_ВспомНайтиПараметрПоСвойству(НовыйМатериалСсылка, СтрокаПредставления.Свойство);
			ИначеЕсли СтрокаПредставления.Префикс = " " ИЛИ СтрокаПредставления.Префикс = "/" Тогда
				ПредыдущийПрефикс = СтрокаПредставления.Префикс;
			КонецЕсли;
		КонецЦикла;
		НовыйМатериал.ИндексКартинки = МаркаМатериала.ИндексКартинки;
		НовыйМатериал.HTMLКонтент = ПредставлениеМатериалаHTML;
		
		Попытка
			НовыйМатериал.Записать();
		Исключение
			НовыйМатериал.ДополнительныеСвойства.Свойство("СуществующийЭлемент", СсылкаСуществующего);
			ВызватьИсключение;
		КонецПопытки;
		
		Если ЗначениеЗаполнено(ОригиналРевизии) Тогда
			// создание ревизии
			НовыйМатериал.ОригиналРевизии = ОригиналРевизии;
			НовыйМатериал.ПредыдущаяРевизия = ПредыдущаяРевизия;
			НовыйМатериал.Записать();
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
		Если ТипоразмерИзОбщегоСписка Тогда
			ДобавитьТипоразмерВСписокДоступных(МаркаМатериала, Сортамент, Типоразмер);
		КонецЕсли;
		
		Возврат НовыйМатериалСсылка;
		
	Исключение
		ОтменитьТранзакцию();
		
		Если СсылкаСуществующего <> Неопределено Тогда
			СтрокаПредупреждения = "Материал с такими параметрами уже применен!";
		Иначе
			СтрокаПредупреждения = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецЕсли;
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

&НаСервере
Функция ПолучитьДеревоСвойств(ПростыеТипыЗначений = Ложь)
	ДеревоСвойств = Новый ДеревоЗначений;
	ДеревоСвойств.Колонки.Добавить("Имя");
	ДеревоСвойств.Колонки.Добавить("СвойствоЭлемента");
	ДеревоСвойств.Колонки.Добавить("Свойство");
	ДеревоСвойств.Колонки.Добавить("ЕдиницаИзмерения");
	ДеревоСвойств.Колонки.Добавить("Значение");
	ДеревоСвойств.Колонки.Добавить("ЭтоГруппа");
	
	// добавить в дерево параметры, из которых формируется представление материала
	Для Каждого СтрокаПредставления Из ПредставлениеМатериала Цикл
		СтрокаГруппы = ДеревоСвойств;
		
		ИмяГруппыПараметров = СтрокаПредставления.ГруппаПараметров;
		Если ЗначениеЗаполнено(ИмяГруппыПараметров) Тогда
			мсСтрокаГруппы = ДеревоСвойств.Строки.НайтиСтроки(Новый Структура("Имя, ЭтоГруппа", ИмяГруппыПараметров, Истина));
			Если мсСтрокаГруппы.Количество() > 0 Тогда
				СтрокаГруппы = мсСтрокаГруппы[0];
			Иначе
				СтрокаГруппы = ДеревоСвойств.Строки.Добавить();
				СтрокаГруппы.Имя = ИмяГруппыПараметров;
				СтрокаГруппы.ЭтоГруппа = Истина;
			КонецЕсли;
		КонецЕсли;
		
	    Свойство = СтрокаПредставления.Свойство;
		Значение = СтрокаПредставления.Значение;
		
		Если ЗначениеЗаполнено(Значение) Тогда
			СтрокаСвойства = СтрокаГруппы.Строки.Добавить();
			СтрокаСвойства.Имя = Строка(Свойство);
			Если ПростыеТипыЗначений Тогда
				ЗначениеПараметра = Строка(Значение);
				Если Свойство.Предопределенный И Свойство.ТипЗначения.СодержитТип(Тип("Строка")) Тогда
					СтрокаСвойства.Свойство = Свойство;
				Иначе
					// обобщенное свойство простого типа (строка, число или дата)
					СтрокаСвойства.Свойство = ПланыВидовХарактеристик.aps_Свойства.ИмпортированноеСвойство;
					Попытка 
						ЗначениеПараметра = Число(ЗначениеПараметра);
					Исключение;
					КонецПопытки;
				КонецЕсли;
				СтрокаСвойства.Значение = ЗначениеПараметра;
			Иначе
				СтрокаСвойства.Свойство	= СтрокаПредставления.Свойство;
		    	СтрокаСвойства.Значение = Значение;
			КонецЕсли;
			СтрокаСвойства.ЭтоГруппа = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	// добавить в дерево все параметры марки материала, сортамента и типоразмера
	Если ЗначениеЗаполнено(МаркаМатериала) И ДеревоСвойств.Строки.НайтиСтроки(Новый Структура("Имя, ЭтоГруппа", "Марка материала", Истина)).Количество() = 0 Тогда
		СтрокаГруппыМарки = ДеревоСвойств.Строки.Добавить();
		СтрокаГруппыМарки.Имя = "Марка материала";
		СтрокаГруппыМарки.ЭтоГруппа = Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Сортамент) И ДеревоСвойств.Строки.НайтиСтроки(Новый Структура("Имя, ЭтоГруппа", "Сортамент", Истина)).Количество() = 0 Тогда
		СтрокаГруппыСортамента = ДеревоСвойств.Строки.Добавить();
		СтрокаГруппыСортамента.Имя = "Сортамент";
		СтрокаГруппыСортамента.ЭтоГруппа = Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Типоразмер) И ДеревоСвойств.Строки.НайтиСтроки(Новый Структура("Имя, ЭтоГруппа", "Типоразмер", Истина)).Количество() = 0 Тогда
		СтрокаГруппыТипоразмера = ДеревоСвойств.Строки.Добавить();
		СтрокаГруппыТипоразмера.Имя = "Типоразмер";
		СтрокаГруппыТипоразмера.ЭтоГруппа = Истина;
	КонецЕсли;
	
	ГруппыПараметров = ДеревоСвойств.Строки.НайтиСтроки(Новый Структура("ЭтоГруппа", Истина));
	Для Каждого СтрокаГруппы Из ГруппыПараметров Цикл
		ИмяГруппы = СтрокаГруппы.Имя;
		Если ИмяГруппы = "Сортамент" Тогда
			ЭлементСсылка = Сортамент;
		ИначеЕсли ИмяГруппы = "Марка материала" Тогда
			ЭлементСсылка = МаркаМатериала;
		ИначеЕсли ИмяГруппы = "Типоразмер" Тогда
			ЭлементСсылка = Типоразмер;
		Иначе // "Технические условия"
			Продолжить;
		КонецЕсли;                
		                                                                                                                                                                                                                                                                                                                                                                                                       
		Для Каждого СтрокаПараметра Из ЭлементСсылка.Параметры Цикл
			Свойство = СтрокаПараметра.Параметр.Свойство;
			ИмяПараметра = СтрокаПараметра.Параметр.Наименование;
			ЗначениеПараметра = СтрокаПараметра.Параметр.Значение;
			Если СтрокаГруппы.Строки.НайтиСтроки(Новый Структура("Свойство, Имя", Свойство, ИмяПараметра)).Количество() = 0 Тогда
				СтрокаСвойства = СтрокаГруппы.Строки.Добавить();
				СтрокаСвойства.Свойство = Свойство;
				СтрокаСвойства.Имя = СтрокаПараметра.Параметр.Наименование;
				Если ПростыеТипыЗначений Тогда
					СтрокаСвойства.Значение = ?(ТипЗнч(ЗначениеПараметра) = Тип("Число"), ЗначениеПараметра, Строка(ЗначениеПараметра));
					СтрокаСвойства.Свойство = ?(Свойство.Предопределенный, Свойство, ПланыВидовХарактеристик.aps_Свойства.ИмпортированноеСвойство);
				Иначе
					СтрокаСвойства.Значение = СтрокаПараметра.Параметр.Значение;
				КонецЕсли;
				ЕдиницаИзмерения = СтрокаПараметра.Параметр.ЕдиницаИзмерения;
				Если ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
					СтрокаСвойства.ЕдиницаИзмерения = ЕдиницаИзмерения;
				КонецЕсли;
				СтрокаСвойства.ЭтоГруппа = Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат ДеревоСвойств;
КонецФункции                    

&НаСервереБезКонтекста
Процедура ДобавитьТипоразмерВСписокДоступных(МаркаМатериала, Сортамент, Типоразмер)
	МодульСозданияОбъектов = Обработки.aps_СозданиеОбъектов.Создать();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
				   |	aps_ЭлементыСвязей.Ссылка
				   |ИЗ
				   |	Справочник.aps_ЭлементыСвязей КАК aps_ЭлементыСвязей
				   |ГДЕ
				   |	aps_ЭлементыСвязей.РодительСсылка = &РодительСсылка
				   |	И aps_ЭлементыСвязей.ПотомокСсылка = &ПотомокСсылка";
	Запрос.УстановитьПараметр("РодительСсылка", МаркаМатериала);
	Запрос.УстановитьПараметр("ПотомокСсылка", Сортамент);
	тзРезультаты = Запрос.Выполнить().Выгрузить();
	Если тзРезультаты.Количество() > 0 Тогда
		СвязьСсылка = тзРезультаты[0].Ссылка;
		МодульСозданияОбъектов.aps_СозданиеЭлементнойСвязи(Справочники.aps_ВидыЭлементов.СвязьТехнологии, СвязьСсылка, Типоразмер, Справочники.aps_ШаблоныТехнологическихСвязей.ДоступныеТипоразмеры, Новый ДеревоЗначений());
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПредопределенныйЭлементСправочника(ИмяСправочника, ИмяПредопределенного)
