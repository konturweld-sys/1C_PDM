		ЭлементУпр = Элементы.ПредставлениеМатериалаЗначение;
		ВидимостьКнопок = НЕ ЗначениеЗаполнено(Элемент.ТекущиеДанные.ГруппаПараметров);
		ЭлементУпр.КнопкаСпискаВыбора = ВидимостьКнопок;
		ЭлементУпр.КнопкаОчистки = ВидимостьКнопок;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
// Общий обработчик для полей "МаркаМатериала" и "Сортамент"
Процедура МаркаМатериалаПриИзменении(Элемент)
	Если Элемент.Имя = "МаркаМатериала" Тогда 
		ОбновитьСписокСортаментов();
	КонецЕсли;
	Если Элемент.Имя = "Сортамент" Тогда 
		ОбновитьСписокМарокМатериалов();
		ОбновитьСписокТипоразмеров();
	КонецЕсли;
	
	ОбновитьШаблонПредставления();
	СформироватьПредставление();
КонецПроцедуры

&НаКлиенте
Процедура ТипоразмерПриИзменении(Элемент)
	МассивСтрок = ПредставлениеМатериала.НайтиСтроки(Новый Структура("Свойство", ПолучитьСсылкуСвойства("Типоразмер")));
	Если МассивСтрок.Количество()>0 Тогда
		СтрокаТипоразмера = МассивСтрок[0];
		СтрокаТипоразмера.Значение = Типоразмер;
		СформироватьПредставление();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПредставлениеHTMLДокументСформирован(Элемент)
	Попытка
		document = Элемент.Документ;
		
		ПредставлениеДляHTML = СтрЗаменить(ПредставлениеДляHTML,"""","&quot;");
		ПредставлениеДляHTML = СтрЗаменить(ПредставлениеДляHTML,"<","&lt;");
		ПредставлениеДляHTML = СтрЗаменить(ПредставлениеДляHTML,">","&gt;");

		// первым параметром - текст представления,
		// вторым - идентификатор числителя,
		// третьим - идентификатор знаменателя
		ТекстСкрипта = "buildMaterialPresentation("""+ПредставлениеДляHTML+""", ""{44440f19-7c4f-4b19-87a1-755736ada51f}"", ""{ea214920-058e-4353-8fb9-2705c3e05327}"")";
		
		bodyHTML=document.body.innerHTML;
		Если Найти(bodyHTML,"<!--CAD")<>0 Тогда
			bodyHTML=Сред(bodyHTML,1, Найти(bodyHTML,"<!--CAD")-1);
		КонецЕсли;
		document.body.innerHTML=bodyHTML+"<!--CAD"+ПредставлениеДляHTML+"-->"; 
 
		Попытка // msie
			document.parentWindow.eval(ТекстСкрипта);
		Исключение
			document.defaultView.eval(ТекстСкрипта);
		КонецПопытки;
	Исключение
	КонецПопытки;
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СоздатьМатериал(Команда)
	Попытка
		ПредставлениеМатериалаHTML = document.body.innerHTML;
	Исключение
		Предупреждение(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	
	// проверить, находится ли типоразмер в списке доступных
	МассивЗначений = ПотомкиСвязи(МаркаМатериала, Сортамент, ПредопределенныйЭлементСправочника("aps_ШаблоныТехнологическихСвязей", "ДоступныеТипоразмеры"));
	Если МассивЗначений.Найти(Типоразмер) = Неопределено Тогда
		ТипоразмерИзОбщегоСписка = Истина;
	КонецЕсли;
	
	СтрокаПредупреждения = "";
	СозданныйМатериал = СоздатьМатериалСервер(ПредставлениеМатериалаHTML, СтрокаПредупреждения);
	Если СозданныйМатериал<>Неопределено Тогда
		СозданныеЭлементы.Добавить(СозданныйМатериал);
		Если НЕ СоздатьНесколькоЭкземпляров Тогда 
			Закрыть();
		КонецЕсли;
	ИначеЕсли НЕ ПустаяСтрока(СтрокаПредупреждения) Тогда 
		Предупреждение(СтрокаПредупреждения);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ФильтрТипоразмеров(Команда)
	Элемент = Элементы.ФильтрТипоразмеров;
	Элемент.Пометка = НЕ Элемент.Пометка;
	
	ОбновитьСписокТипоразмеров();
	ТипоразмерПриИзменении(Элементы.Типоразмер);
КонецПроцедуры

#КонецОбласти


#Область ПрочиеПроцедурыИФункцииНаКлиенте

&НаКлиенте
Процедура ПриОткрытииОбработчикОжидания()
	Если НЕ ЗначениеЗаполнено(МаркаМатериала) И НЕ ЗначениеЗаполнено(Сортамент) Тогда
		Предупреждение("Выберите марку материала или сортамент и повторите операцию.");
		Закрыть();
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(МаркаМатериала) Тогда
		ОбновитьСписокМарокМатериалов();
		Если Элементы.МаркаМатериала.СписокВыбора.Количество() = 0 Тогда 
			// с данным сортаментом не связано ни одной марки материала
			Предупреждение("Невозможно применить материал!"+Символы.ПС+"Свяжите сортамент с маркой материала и повторите операцию.");
			Закрыть();
			Возврат;
		КонецЕсли;
	ИначеЕсли НЕ ЗначениеЗаполнено(Сортамент) Тогда 
		ОбновитьСписокСортаментов();
		Если Элементы.Сортамент.СписокВыбора.Количество() = 0 Тогда 
			// марка материала без сортаментов
			Элементы.ГруппаСортамент.Доступность = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Если Элементы.МаркаМатериала.СписокВыбора.Количество() = 0 И ЗначениеЗаполнено(Сортамент) Тогда 
		ОбновитьСписокМарокМатериалов();
	КонецЕсли;
	Если Элементы.ГруппаСортамент.Доступность
			И Элементы.Сортамент.СписокВыбора.Количество() = 0 И ЗначениеЗаполнено(МаркаМатериала) Тогда 
		ОбновитьСписокСортаментов();
	КонецЕсли;
	
	Если Элементы.ГруппаСортамент.Доступность Тогда 
		Элементы.ФильтрТипоразмеров.Пометка = Истина;
		ОбновитьСписокТипоразмеров();
	КонецЕсли;
	
	
	ОбновитьШаблонПредставления();
	Если НЕ ПустаяСтрока(АдресДополнительныхСвойств) Тогда
		ДополнительныеСвойства = ПолучитьИзВременногоХранилища(АдресДополнительныхСвойств);
		
		Для Каждого СтрокаПредставления Из ПредставлениеМатериала Цикл
			ЗначениеСвойства = ДополнительныеСвойства.Получить(СтрокаПредставления.Свойство);
			Если ЗначениеСвойства <> Неопределено Тогда
				СтрокаПредставления.Значение = ЗначениеСвойства;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	СформироватьПредставление();
	
	Элементы.ФормаКоманднаяПанель.Доступность  = Истина;
	Элементы.НижняяКоманднаяПанель.Доступность = Истина;
	Заголовок = "Создание материала";
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПредставление()
	Представление = ""; ПредставлениеДляHTML = "";
	ПредыдущийПрефикс = "";
	
	ЕстьРазделитель = ПредставлениеМатериала.НайтиСтроки(Новый Структура("Префикс", "/")).Количество() > 0;
	ЧислоСимволовДоЧислителя = ?(ЕстьРазделитель,СтрДлина(Строка(ПредставлениеМатериала[0].Значение)),0);
	
	Для Каждого СтрокаПредставления Из ПредставлениеМатериала Цикл
		Если ЗначениеЗаполнено(СтрокаПредставления.Значение) Тогда
			Префикс = ?(ПредыдущийПрефикс<>"", ПредыдущийПрефикс, СтрокаПредставления.Префикс);
			ПредыдущийПрефикс = "";
			Представление = Представление + Префикс + Строка(СтрокаПредставления.Значение);
		ИначеЕсли (СтрокаПредставления.Префикс = " " ИЛИ СтрокаПредставления.Префикс = "/") И ПредыдущийПрефикс<>"/" Тогда
		    ПредыдущийПрефикс = СтрокаПредставления.Префикс;
		КонецЕсли;
	КонецЦикла;
	
	
	
	Представление = СокрЛП(Представление);
	
	ПредставлениеДляHTML = Представление;
	Если ЕстьРазделитель Тогда 
		ПредставлениеДляHTML = СокрЛП(Лев(ПредставлениеДляHTML, ЧислоСимволовДоЧислителя))+"{44440f19-7c4f-4b19-87a1-755736ada51f}"+СокрЛП(Сред(ПредставлениеДляHTML, ЧислоСимволовДоЧислителя+1));
		ЧислоСимволовДоЗнаменателя = Найти(ПредставлениеДляHTML, "/")-1;
		ПредставлениеДляHTML = СокрЛП(Лев(ПредставлениеДляHTML, ЧислоСимволовДоЗнаменателя))+"{ea214920-058e-4353-8fb9-2705c3e05327}"+СокрЛП(Сред(ПредставлениеДляHTML, ЧислоСимволовДоЗнаменателя+2));
	КонецЕсли;
	
	ПредставлениеHTMLДокументСформирован(Элементы.ПредставлениеHTML);
КонецПроцедуры

#КонецОбласти

#КонецЕсли