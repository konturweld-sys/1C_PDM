// Открывает форму расчета нормировочной карты
//
// Параметры:
//		Владелец - Форма, владелец формы расчета
//
// Возвращаемое значение:
//		Булево, истина, если был перерасчет
//
// Пример:
//		РасчетВыполнен = aps_ОткрытьРасчет(ВладелецФормы);
//
Функция aps_ОткрытьРасчет(ФормаВладелец) Экспорт
	
	Попытка	
		aps_ПолныеПрава.aps_ПроверитьЛицензиюСеанса();
	Исключение
		ВызватьИсключение ОписаниеОшибки();
	КонецПопытки;


	Если ИсторияРасчета <> Неопределено Тогда
		Попытка
			МодельБлокаРасчета = Строка2XDTO(ИсторияРасчета); // получаем xdto-модель расчета
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	Если МодельБлокаРасчета = Неопределено Или МодельБлокаРасчета.element.ПолучитьОбъект()=Неопределено Тогда 
		ВыборЭлемента = Обработки.aps_Проводник.ПолучитьФорму(, ФормаВладелец);
		ВыборЭлемента.Выбор = Истина;
		ВыборЭлемента.ОдиночныйВыбор = Истина;
		ВыборЭлемента.ДоступныеВидыЭлементов.Добавить().ВидЭлемента = Справочники.aps_ВидыЭлементов.БлокРасчета;
		ВыборЭлемента.ДоступныеВидыЭлементов.Добавить().ВидЭлемента = Справочники.aps_ВидыЭлементов.ГруппаРасчета;
		ВыборЭлемента.КорневыеЭлементы.Добавить().КорневойЭлемент = Справочники.aps_ЭлементыСправочников.Нормирование;
		
		БлокРасчетаИлиГруппа = ВыборЭлемента.ОткрытьМодально();
		Если БлокРасчетаИлиГруппа = Неопределено Тогда 
			Возврат Ложь;
		КонецЕсли;
		
		МодельБлокаРасчета = aps_СоздатьОбъектМоделиXDTO(БлокРасчетаИлиГруппа);
	КонецЕсли;
	
	МодульРасчета = Обработки.aps_РедакторБлокаРасчета.Создать();
	МодульРасчета.item = МодельБлокаРасчета.element;
	
	ФормаРасчета = МодульРасчета.ПолучитьФорму("ФормаРасчета", ФормаВладелец);
	ФормаРасчета.МодельРодителя = МодельБлокаРасчета;
	ФормаРасчета.ЗакрыватьПриЗакрытииВладельца = Ложь;
	Если ФормаРасчета.ОткрытьМодально() <> Истина Тогда 
		Возврат Ложь;
	КонецЕсли;
	
	МодельБлокаРасчета = ФормаРасчета.СписокБлоков[0].ОбъектXDTO;
	созданиеПараметров = Обработки.aps_СозданиеПараметров.Создать();
	// значение расчета помещается в параметр "Расчетное_время"
	СтрокаРасчетногоПараметра = ФормаРасчета.ДеревоПараметров.Строки.Найти(Истина, "Расчетный", Истина);
	Если СтрокаРасчетногоПараметра <> Неопределено Тогда 
		ЗначениеРасчета = СтрокаРасчетногоПараметра.Значение;
	Иначе 
		ЗначениеРасчета = Неопределено;
	КонецЕсли;
	
	ИсторияРасчета  = XDTO2Строка(МодельБлокаРасчета);
	Возврат Истина;
КонецФункции

#КонецОбласти

#КонецЕсли	