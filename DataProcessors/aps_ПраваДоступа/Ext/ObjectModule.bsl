// Функция возвращает ссылку на текущего пользователя из справочника Пользователи.
// Если пользователь не найден, будет создана соответствующая запись в справочнике
// 
// Параметры:
//		ИмяПользователя - имя пользователя информационной базы
// Возвращаемое значение:
//		СправочникСсылка.Пользователи
// Пример:
//		ПараметрыСеанса.ТекущийПользователь=МодульПравДоступа.aps_ОпределитьТекущегоПользователя(ИмяПользователя());
Функция aps_ОпределитьТекущегоПользователя( ИмяПользователя, ПолноеИмяПользователя = "" ) Экспорт
	локТекущийПользователь = Справочники.Пользователи.ПустаяСсылка();
	
	Если НЕ ПустаяСтрока(ИмяПользователя) Тогда 
		
		//БлокировкаДанных = Новый БлокировкаДанных;
		//ЭлементБлокировки = БлокировкаДанных.Добавить("Справочник.Пользователи");
		//ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		//ЭлементБлокировки.УстановитьЗначение("Код", ИмяПользователя);
		//БлокировкаДанных.Заблокировать();
		
		// Запрос по поиску элемента в справочнике пользователей
		Запрос = Новый Запрос();
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		               |	Пользователи.Ссылка
		               |ИЗ
		               |	Справочник.Пользователи КАК Пользователи
		               |ГДЕ
		               |	Пользователи.Код = &КодПользователя";
		Запрос.УстановитьПараметр("КодПользователя", ИмяПользователя);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			локТекущийПользователь = Выборка.Ссылка;
		Иначе 
			Попытка
				ОбъектПользователь = Справочники.Пользователи.СоздатьЭлемент();
				ОбъектПользователь.Код			= ИмяПользователя;
				ОбъектПользователь.Наименование	= ПолноеИмяПользователя;
				ОбъектПользователь.Записать();
				
				локТекущийПользователь = ОбъектПользователь.Ссылка;
			Исключение
				ЗаписьЖурналаРегистрации("PDM",УровеньЖурналаРегистрации.Ошибка,,,НСтр("ru = ""Невозможно создать нового пользователя""; en_US = ""Cannot create new user"""));
			КонецПопытки;
		КонецЕсли;
		
	КонецЕсли;
			
	Возврат локТекущийПользователь;
КонецФункции

// Функция применяет соответствующую политику доступа в зависимости от роли пользователя
// 
// Параметры:
//		нет
// Возвращаемое значение:
//		истина
Функция aps_ОбновитьПолитикуТекущегоПользователя() Экспорт 

	МассивСубъектовПрава = Новый Массив();
	
	ТекущийПользователь = ПараметрыСеанса.ТекущийПользователь;
	
	Если ТекущийПользователь.Пустая() Тогда
		
		МассивСубъектовПрава.Добавить( Перечисления.aps_СистемныеГруппы.Система );
		
	Иначе
		
		ПользовательИБ = aps_НайтиПользователяИБПоИмени(СокрЛП(ТекущийПользователь.Код));
		Если ПользовательИБ <> Неопределено Тогда 
			Если ПользовательИБ.Роли.Содержит(Метаданные.Роли.Найти("aps_Администратор")) Тогда
				
				МассивСубъектовПрава.Добавить( Перечисления.aps_СистемныеГруппы.Администраторы );
				
			ИначеЕсли ПользовательИБ.Роли.Содержит(Метаданные.Роли.Найти("aps_Пользователь"))
						Или ПользовательИБ.Роли.Содержит(Метаданные.Роли.Найти("aps_ОпытныйПользователь")) Тогда 
				
				МассивСубъектовПрава.Добавить( Перечисления.aps_СистемныеГруппы.Пользователи );
				
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	МассивСубъектовПрава.Добавить( Перечисления.aps_СистемныеГруппы.Все );
	
	ПараметрыСеанса.aps_ПримененнаяПолитика = Новый ФиксированныйМассив(МассивСубъектовПрава);
	
	Возврат Истина;
	
КонецФункции // aps_ОбновитьПолитикуТекущегоПользователя()

// Функция возвращает пользователя информационной базы, найденного по имени.
// Если пользователь не найден, будет создана соответствующая запись в справочнике
// 
// Параметры:
//		ИмяПользователя - имя пользователя информационной базы
// Возвращаемое значение:
//		ПользовательИнформационнойБазы
// Пример:
//		ПользовательИБ = aps_НайтиПользователяИБПоИмени(СокрЛП(ТекущийПользователь.Код));
Функция aps_НайтиПользователяИБПоИмени( ИмяПользователя ) Экспорт 
	Возврат ПользователиИнформационнойБазы.НайтиПоИмени( ИмяПользователя );
КонецФункции


// Функция проверяет наличие права
//
// Параметры:
//  	ОбъектПрава	- проверяемый объект права 
//  	item		- проверяемый элемент, связь или параметр
//  	ДескрипторГрупповойПолитики	- дескриптор групповой политики
//
// Возвращаемое значение:
//		Булево, Истина, если право есть, Ложь в противном случае
//
// Пример:
//		ИзмОбъектнойПолитики = aps_ПроверитьОбъектПрава(Справочники.aps_Права.ИзменениеОбъектнойПолитики, ЭлементСсылка, ЭлементСсылка.GMOD);
//
Функция aps_ПроверитьОбъектПрава( ОбъектПрава, item, ДескрипторГрупповойПолитики, Запрещено = Ложь ) Экспорт
	
	// Особые разрешения на изменение объектной политики. Владелец может изменять объектную политику
	// независимо от установленных разрешений
	Если ОбъектПрава=Справочники.aps_Права.ИзменениеОбъектнойПолитики И item.UID=ПараметрыСеанса.ТекущийПользователь Тогда
		Возврат Истина;
	КонецЕсли;
	
	
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ
	               |	aps_ЗначенияОбъектовПравПолитик.ОбъектПрава КАК ОбъектПрава,
	               |	aps_ЗначенияОбъектовПравПолитик.СубъектПрава КАК СубъектПрава,
	               |	aps_ЗначенияОбъектовПравПолитик.Разрешить КАК Разрешить,
	               |	aps_ЗначенияОбъектовПравПолитик.Запретить КАК Запретить
	               |ИЗ
	               |	РегистрСведений.aps_ЗначенияОбъектовПравПолитик КАК aps_ЗначенияОбъектовПравПолитик
	               |ГДЕ
	               |	aps_ЗначенияОбъектовПравПолитик.Источник = &Дескриптор
	               |	И aps_ЗначенияОбъектовПравПолитик.ОбъектПрава = &Право";
	Запрос.УстановитьПараметр( "Право", ОбъектПрава );
	Если ЗначениеЗаполнено(ДескрипторГрупповойПолитики) Тогда 
		// если назначена групповая политика, объектную НЕ проверяем
		Запрос.УстановитьПараметр( "Дескриптор", ДескрипторГрупповойПолитики );
	Иначе 
		Запрос.УстановитьПараметр( "Дескриптор", item.MOD );
	КонецЕсли;
	
	rights = Запрос.Выполнить().Выгрузить();
	
	//-----------------------------------------------------------------
	//- Проверить именованные права
	
	Разрешено = Ложь; ОтноситсяКОстальным = Истина; // текущего пользователя можно отнести к системной группе "ОСТАЛЬНЫЕ"
	
	Для Каждого right Из rights Цикл
	
		Если ТипЗнч(right.СубъектПрава)=Тип("СправочникСсылка.ГруппыПользователей") И right.СубъектПрава.ПользователиГруппы.Найти(ПараметрыСеанса.ТекущийПользователь) <> Неопределено Тогда
			Если right.Запретить Тогда
				Запрещено = Истина;
			ИначеЕсли right.Разрешить Тогда
				Разрешено = Истина;
			КонецЕсли;
			ОтноситсяКОстальным = Ложь;
		ИначеЕсли ТипЗнч(right.СубъектПрава) = Тип("СправочникСсылка.Пользователи") И right.СубъектПрава = ПараметрыСеанса.ТекущийПользователь Тогда
			Если right.Запретить Тогда
				Запрещено = Истина;
			ИначеЕсли right.Разрешить Тогда
				Разрешено = Истина;
			КонецЕсли;
			ОтноситсяКОстальным = Ложь;
		ИначеЕсли right.СубъектПрава = Перечисления.aps_СистемныеГруппы.Все И НЕ ПараметрыСеанса.ТекущийПользователь.Пустая() Тогда
			Если right.Запретить Тогда
				Запрещено = Истина;
			ИначеЕсли right.Разрешить Тогда
				Разрешено = Истина;
			КонецЕсли;
			ОтноситсяКОстальным = Ложь;
		ИначеЕсли right.СубъектПрава = Перечисления.aps_СистемныеГруппы.Владелец И item.UID = ПараметрыСеанса.ТекущийПользователь Тогда
			Если right.Запретить Тогда
				Запрещено = Истина;
			ИначеЕсли right.Разрешить Тогда
				Разрешено = Истина;
			КонецЕсли;
			ОтноситсяКОстальным = Ложь;
		ИначеЕсли right.СубъектПрава = Перечисления.aps_СистемныеГруппы.Группа 
					И ТипЗнч(item.GID)=Тип("СправочникСсылка.ГруппыПользователей") И item.GID.ПользователиГруппы.Найти(ПараметрыСеанса.ТекущийПользователь) <> Неопределено Тогда
			Если right.Запретить Тогда
				Запрещено = Истина;
			ИначеЕсли right.Разрешить Тогда
				Разрешено = Истина;
			КонецЕсли;
			ОтноситсяКОстальным = Ложь;
		ИначеЕсли right.СубъектПрава = Перечисления.aps_СистемныеГруппы.Пользователи И ПараметрыСеанса.aps_ПримененнаяПолитика.Найти(Перечисления.aps_СистемныеГруппы.Пользователи) <> Неопределено Тогда
			Если right.Запретить Тогда
				Запрещено = Истина;
			ИначеЕсли right.Разрешить Тогда
				Разрешено = Истина;
			КонецЕсли;
			ОтноситсяКОстальным = Ложь;
		ИначеЕсли right.СубъектПрава = Перечисления.aps_СистемныеГруппы.Администраторы И ПараметрыСеанса.aps_ПримененнаяПолитика.Найти(Перечисления.aps_СистемныеГруппы.Администраторы) <> Неопределено Тогда
			Если right.Запретить Тогда
				Запрещено = Истина;
			ИначеЕсли right.Разрешить Тогда
				Разрешено = Истина;
			КонецЕсли;
			ОтноситсяКОстальным = Ложь;
		ИначеЕсли right.СубъектПрава = Перечисления.aps_СистемныеГруппы.Система И ПараметрыСеанса.aps_ПримененнаяПолитика.Найти(Перечисления.aps_СистемныеГруппы.Система) <> Неопределено Тогда
			Если right.Запретить Тогда
				Запрещено = Истина;
			ИначеЕсли right.Разрешить Тогда
				Разрешено = Истина;
			КонецЕсли;
			ОтноситсяКОстальным = Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ОтноситсяКОстальным Тогда 
		right = rights.Найти(Перечисления.aps_СистемныеГруппы.Остальные);
		Если right <> Неопределено Тогда 
			Если right.Запретить Тогда
				Запрещено = Истина;
			ИначеЕсли right.Разрешить Тогда
				Разрешено = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если Запрещено Тогда 
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Разрешено;
	
КонецФункции


// Функция устанавливает новую объектную политику для массива элементов
//
// Параметры:
//		МассивЭлементовXDTO - массив объектов XDTO, для которых необходимо установить объектную политику
//		Дескриптор			- дескриптор объектной политики
//		СтруктураПараметров - структура параметров установки объектной политики
//
// Возвращаемое значение:
//		нет
//
// Пример:
//		aps_УстановитьОбъектнуюПолитику(ЗначениеВыбора, ДескрипторОбъектнойПолитики, НастройкиПримененияПолитики);
//
Функция aps_УстановитьОбъектнуюПолитику( МассивЭлементовXDTO, Дескриптор, СтруктураПараметров ) Экспорт
	
	ОчищатьГрупповуюПолитику		= ?(СтруктураПараметров.Свойство("ОчищатьГрупповуюПолитику"), СтруктураПараметров.ОчищатьГрупповуюПолитику, Ложь);
	УстанавливатьДляЭлементов		= ?(СтруктураПараметров.Свойство("УстанавливатьДляЭлементов"), СтруктураПараметров.УстанавливатьДляЭлементов, Истина);
	УстанавливатьДляПараметров		= ?(СтруктураПараметров.Свойство("УстанавливатьДляПараметров"), СтруктураПараметров.УстанавливатьДляПараметров, Ложь);
	УстанавливатьДляПараметровСвязи	= ?(СтруктураПараметров.Свойство("УстанавливатьДляПараметровСвязи"), СтруктураПараметров.УстанавливатьДляПараметровСвязи, Ложь);
	
	ПараметрыДляУстановки			= ?(СтруктураПараметров.Свойство("ПараметрыДляУстановки"), СтруктураПараметров.ПараметрыДляУстановки, Неопределено);
	
	
	СтрокаБлокировок=НСтр("ru = ""Заблокированные элементы:""; en_US = ""Blocked items:""");
	СтрокаРазрешений=НСтр("ru = ""Отсутствует право изменения объектной политики или Вы не являетесь владельцем элемента:""; en_US = ""Object policy change permission is missing or you are not the item owner:""");
	СтрокаОшибок	=НСтр("ru = ""Ошибки:""; en_US = ""Errors:""");	
	Если ОчищатьГрупповуюПолитику Тогда 
		СтрокаИзменений=НСтр("ru = ""Изменены дескрипторы объектной и групповой политики:""; en_US = ""Object and group policy descriptors are changed:""");
	Иначе 
		СтрокаИзменений=НСтр("ru = ""Изменен дескриптор объектной политики:""; en_US = ""Object policy descriptor is changed:""");
	КонецЕсли;
	
	#Если Клиент Тогда 
	ФормаПрогресса=ПолучитьОбщуюФорму("aps_ФормаИндикатора");
	ФормаПрогресса.МаксимальноеЗначение=МассивЭлементовXDTO.Количество();
	ФормаПрогресса.Открыть();
	#КонецЕсли

	Если ТипЗнч(МассивЭлементовXDTO) <> Тип("Массив") Тогда
		itemXDTO = МассивЭлементовXDTO;
		МассивЭлементовXDTO = Новый Массив;
		МассивЭлементовXDTO.Добавить(itemXDTO);
	КонецЕсли;
	
	// параметры для установки политики
	Если ПараметрыДляУстановки <> Неопределено Тогда 
		XDTOТаблицы = Строка2XDTO(ПараметрыДляУстановки);
		ТаблицаОтбораПараметров = СериализаторXDTO.ПрочитатьXDTO(XDTOТаблицы);
	КонецЕсли;
	
	Для Каждого itemXDTO Из МассивЭлементовXDTO Цикл
		ЭлементСсылка=itemXDTO.element;
		ЭлементСвязи =itemXDTO.link;
		
		#Если Клиент Тогда 
		ФормаПрогресса.НадписьПроцесса=ЭлементСсылка.Наименование;
		ФормаПрогресса.ЗначениеИндикатора=ФормаПрогресса.ЗначениеИндикатора+1;
		#КонецЕсли
		
		Если УстанавливатьДляЭлементов Тогда
			Разрешено=Истина;
			Если НЕ ЭлементСсылка.РедактирующийПользователь.Пустая() Тогда
				Разрешено=Ложь;
				СтрокаБлокировок=СтрокаБлокировок+Символы.ПС+ЭлементСсылка.Наименование+НСтр("ru = "", пользователь """"; en_US = "" by user """"")+Строка(ЭлементСсылка.РедактирующийПользователь)+"""";
			КонецЕсли;
			
			ИзмОбъектнойПолитики = (ЭлементСсылка.UID=ПараметрыСеанса.ТекущийПользователь ИЛИ aps_ПроверитьОбъектПрава(Справочники.aps_Права.ИзменениеОбъектнойПолитики, ЭлементСсылка, ЭлементСсылка.GMOD));
			Если НЕ ИзмОбъектнойПолитики Тогда 
				Разрешено=Ложь;
				СтрокаРазрешений=СтрокаРазрешений+Символы.ПС+ЭлементСсылка.Наименование;
			КонецЕсли;	
				
			Если Разрешено Тогда 
				itemObject=ЭлементСсылка.ПолучитьОбъект();
				Если ОчищатьГрупповуюПолитику=Истина Тогда
					itemObject.GMOD=Справочники.aps_ДескрипторыДоступа.ПустаяСсылка();					
				КонецЕсли;
				itemObject.MOD=Дескриптор;
				itemObject.SGID=Истина;
				Попытка
					itemObject.ДополнительныеСвойства.Вставить("ПроверитьУникальность", Ложь);
					itemObject.Записать();
					СтрокаИзменений=СтрокаИзменений+Символы.ПС+ЭлементСсылка.Наименование;
				Исключение
					СтрокаОшибок=СтрокаОшибок+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
		
		Если УстанавливатьДляПараметров Тогда
			Для i=0 По ЭлементСсылка.Параметры.Количество()-1 Цикл
				ПараметрСсылка=ЭлементСсылка.Параметры[i].Параметр;
				Если ТаблицаОтбораПараметров <> Неопределено И ТаблицаОтбораПараметров.НайтиСтроки(Новый Структура("Свойство", ПараметрСсылка.Свойство)).Количество()=0 Тогда 
					Продолжить; // пропускаем параметр
				КонецЕсли;
				
				ИзмОбъектнойПолитики = (ПараметрСсылка.UID=ПараметрыСеанса.ТекущийПользователь ИЛИ aps_ПроверитьОбъектПрава(Справочники.aps_Права.ИзменениеОбъектнойПолитики, ПараметрСсылка, ПараметрСсылка.GMOD));
				Если НЕ ИзмОбъектнойПолитики Тогда 
					СтрокаРазрешений=СтрокаРазрешений+Символы.ПС+ЭлементСсылка.Наименование+", "+ПараметрСсылка.Наименование;
					Продолжить;
				КонецЕсли;	
								
				ОбъектПараметра= ПараметрСсылка.ПолучитьОбъект();
				Если ОчищатьГрупповуюПолитику=Истина Тогда
					ОбъектПараметра.GMOD=Справочники.aps_ДескрипторыДоступа.ПустаяСсылка();					
				КонецЕсли;
				ОбъектПараметра.MOD=Дескриптор;
				ОбъектПараметра.SGID=Истина;
				Попытка
					ОбъектПараметра.Записать();
					СтрокаИзменений=СтрокаИзменений+Символы.ПС+ЭлементСсылка.Наименование+", "+ПараметрСсылка.Наименование;
				Исключение
					СтрокаОшибок=СтрокаОшибок+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
					Продолжить;
				КонецПопытки;
			КонецЦикла;
		КонецЕсли;
		
		Если УстанавливатьДляПараметровСвязи
				И ЭлементСвязи<>Неопределено И ЭлементСвязи.Метаданные().ТабличныеЧасти.Найти("Параметры")<>Неопределено Тогда 
				
			Для i=0 По ЭлементСвязи.Параметры.Количество()-1 Цикл
				ПараметрСсылка=ЭлементСвязи.Параметры[i].Параметр;
				Если ТаблицаОтбораПараметров <> Неопределено И ТаблицаОтбораПараметров.НайтиСтроки(Новый Структура("Свойство", ПараметрСсылка.Свойство)).Количество()=0 Тогда 
					Продолжить; // пропускаем параметр
				КонецЕсли;
				
				ИзмОбъектнойПолитики = ПараметрСсылка.UID=ПараметрыСеанса.ТекущийПользователь ИЛИ aps_ПроверитьОбъектПрава(Справочники.aps_Права.ИзменениеОбъектнойПолитики, ПараметрСсылка, ПараметрСсылка.GMOD);
				Если НЕ ИзмОбъектнойПолитики Тогда 
					СтрокаРазрешений=СтрокаРазрешений+Символы.ПС+ЭлементСсылка.Наименование+НСтр("en_US=' (in context of ';ru=' (в контексте '")+Строка(ЭлементСвязи.РодительСсылка)+"), "+ПараметрСсылка.Наименование;
					Продолжить;
				КонецЕсли;	

				ОбъектПараметра= ПараметрСсылка.ПолучитьОбъект();
				Если ОчищатьГрупповуюПолитику=Истина Тогда
					ОбъектПараметра.GMOD=Справочники.aps_ДескрипторыДоступа.ПустаяСсылка();					
				КонецЕсли;
				ОбъектПараметра.MOD=Дескриптор;
				ОбъектПараметра.SGID=Истина;
				Попытка
					ОбъектПараметра.Записать();
					СтрокаИзменений=СтрокаИзменений+Символы.ПС+ЭлементСсылка.Наименование+НСтр("en_US=' (in context of ';ru=' (в контексте '")+Строка(ЭлементСвязи.РодительСсылка)+"), "+ПараметрСсылка.Наименование;
				Исключение
					СтрокаОшибок=СтрокаОшибок+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
					Продолжить;
				КонецПопытки;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	#Если Клиент Тогда 
	ФормаПрогресса.Закрыть();
	
	Если Найти(СтрокаБлокировок,Символы.ПС)>0 Тогда 
		Сообщить(СтрокаБлокировок, СтатусСообщения.Внимание);
	КонецЕсли;
	Если Найти(СтрокаРазрешений,Символы.ПС)>0 Тогда 
		Сообщить(СтрокаРазрешений, СтатусСообщения.Внимание);
	КонецЕсли;
	Если Найти(СтрокаОшибок,Символы.ПС)>0 Тогда 
		Сообщить(СтрокаОшибок, СтатусСообщения.Внимание);
	КонецЕсли;
	Если Найти(СтрокаИзменений,Символы.ПС)>0 Тогда 
		Сообщить(СтрокаИзменений, СтатусСообщения.Информация);
	КонецЕсли;
	#КонецЕсли
КонецФункции

// Функция устанавливает новую групповую политику для массива элементов
//
// Параметры:
//		МассивЭлементовXDTO - массив объектов XDTO, для которых необходимо установить групповую политику
//		Дескриптор			- дескриптор групповой политики
//		СтруктураПараметров - структура параметров установки групповой политики
//
// Возвращаемое значение:
//		нет
//
// Пример:
//      aps_УстановитьГрупповуюПолитику(ЗначениеВыбора, ДескрипторГрупповойПолитики, НастройкиПримененияПолитики);
//
Функция aps_УстановитьГрупповуюПолитику( МассивЭлементовXDTO, Дескриптор, СтруктураПараметров ) Экспорт
	
	ОчищатьОбъектнуюПолитику		= ?(СтруктураПараметров.Свойство("ОчищатьОбъектнуюПолитику"), СтруктураПараметров.ОчищатьОбъектнуюПолитику, Ложь);
	УстанавливатьДляЭлементов		= ?(СтруктураПараметров.Свойство("УстанавливатьДляЭлементов"), СтруктураПараметров.УстанавливатьДляЭлементов, Истина);
	УстанавливатьДляПараметров		= ?(СтруктураПараметров.Свойство("УстанавливатьДляПараметров"), СтруктураПараметров.УстанавливатьДляПараметров, Ложь);
	УстанавливатьДляПараметровСвязи	= ?(СтруктураПараметров.Свойство("УстанавливатьДляПараметровСвязи"), СтруктураПараметров.УстанавливатьДляПараметровСвязи, Ложь);
	
	ПараметрыДляУстановки			= ?(СтруктураПараметров.Свойство("ПараметрыДляУстановки"), СтруктураПараметров.ПараметрыДляУстановки, Неопределено);
	
	СтрокаБлокировок=НСтр("ru = ""Заблокированные элементы:""; en_US = ""Blocked items:""");
	СтрокаРазрешений=НСтр("ru = ""Отсутствует право изменения групповой политики:""; en_US = ""Group policy change permission is missing:""");
	СтрокаОшибок	=НСтр("ru = ""Ошибки:""; en_US = ""Errors:""");
	Если ОчищатьОбъектнуюПолитику Тогда 
		СтрокаИзменений=НСтр("ru = ""Изменены дескрипторы групповой и объектной политики:""; en_US = ""Group and object policy descriptors are changed:""");
	Иначе 
		СтрокаИзменений=НСтр("ru = ""Изменен дескриптор групповой политики:""; en_US = ""Group policy descriptor is changed:""");
	КонецЕсли;
	
	#Если Клиент Тогда 
	ФормаПрогресса=ПолучитьОбщуюФорму("aps_ФормаИндикатора");
	ФормаПрогресса.МаксимальноеЗначение=МассивЭлементовXDTO.Количество();
	ФормаПрогресса.Открыть();
	#КонецЕсли

	Если ТипЗнч(МассивЭлементовXDTO) <> Тип("Массив") Тогда
		itemXDTO = МассивЭлементовXDTO;
		МассивЭлементовXDTO = Новый Массив;
		МассивЭлементовXDTO.Добавить(itemXDTO);
	КонецЕсли;

	// параметры для установки политики
	Если ПараметрыДляУстановки <> Неопределено Тогда 
		XDTOТаблицы = Строка2XDTO(ПараметрыДляУстановки);
		ТаблицаОтбораПараметров = СериализаторXDTO.ПрочитатьXDTO(XDTOТаблицы);
	КонецЕсли;
	
	Для Каждого itemXDTO Из МассивЭлементовXDTO Цикл
		ЭлементСсылка=itemXDTO.element;
		ЭлементСвязи =itemXDTO.link;
		
		#Если Клиент Тогда 
		ФормаПрогресса.НадписьПроцесса=ЭлементСсылка.Наименование;
		ФормаПрогресса.ЗначениеИндикатора=ФормаПрогресса.ЗначениеИндикатора+1;
		#КонецЕсли
		
		Если УстанавливатьДляЭлементов Тогда
			Разрешено=Истина;
			Если НЕ ЭлементСсылка.РедактирующийПользователь.Пустая() Тогда
				Разрешено=Ложь;
				СтрокаБлокировок=СтрокаБлокировок+Символы.ПС+ЭлементСсылка.Наименование+НСтр("ru = "", пользователь """"; en_US ="" by user """"")+Строка(ЭлементСсылка.РедактирующийПользователь)+"""";
			КонецЕсли;
			
			ИзмГрупповойПолитики=aps_ПроверитьОбъектПрава(Справочники.aps_Права.ИзменениеГрупповойПолитики, ЭлементСсылка, ЭлементСсылка.GMOD);
			Если НЕ ИзмГрупповойПолитики Тогда 
				Разрешено=Ложь;
				СтрокаРазрешений=СтрокаРазрешений+Символы.ПС+ЭлементСсылка.Наименование;
			КонецЕсли;	
			
			Если Разрешено Тогда 
				itemObject=ЭлементСсылка.ПолучитьОбъект();
				itemObject.GMOD=Дескриптор;
				Если ОчищатьОбъектнуюПолитику=Истина Тогда
					itemObject.MOD=Справочники.aps_ДескрипторыДоступа.ПустаяСсылка();					
				КонецЕсли;
				
				Попытка
					itemObject.ДополнительныеСвойства.Вставить("ПроверитьУникальность", Ложь);
					itemObject.Записать();
					СтрокаИзменений=СтрокаИзменений+Символы.ПС+ЭлементСсылка.Наименование;
				Исключение
					СтрокаОшибок=СтрокаОшибок+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
		
		Если УстанавливатьДляПараметров Тогда
			Для i=0 По ЭлементСсылка.Параметры.Количество()-1 Цикл
				ПараметрСсылка=ЭлементСсылка.Параметры[i].Параметр;
				Если ТаблицаОтбораПараметров <> Неопределено И ТаблицаОтбораПараметров.НайтиСтроки(Новый Структура("Свойство", ПараметрСсылка.Свойство)).Количество()=0 Тогда 
					Продолжить; // пропускаем параметр
				КонецЕсли;
				
				ИзмГрупповойПолитики = aps_ПроверитьОбъектПрава(Справочники.aps_Права.ИзменениеГрупповойПолитики, ПараметрСсылка, ПараметрСсылка.GMOD);
				Если НЕ ИзмГрупповойПолитики Тогда 
					СтрокаРазрешений=СтрокаРазрешений+Символы.ПС+ЭлементСсылка.Наименование+", "+ПараметрСсылка.Наименование;
					Продолжить;
				КонецЕсли;	
				
				ОбъектПараметра=ПараметрСсылка.ПолучитьОбъект();
				ОбъектПараметра.GMOD=Дескриптор;
				Если ОчищатьОбъектнуюПолитику=Истина Тогда
					ОбъектПараметра.MOD=Справочники.aps_ДескрипторыДоступа.ПустаяСсылка();					
				КонецЕсли;
				
				Попытка
					ОбъектПараметра.Записать();
					СтрокаИзменений=СтрокаИзменений+Символы.ПС+ЭлементСсылка.Наименование+", "+ПараметрСсылка.Наименование;
				Исключение
					СтрокаОшибок=СтрокаОшибок+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
					Продолжить;
				КонецПопытки;
			КонецЦикла;
		КонецЕсли;
		
		Если УстанавливатьДляПараметровСвязи
				И ЭлементСвязи<>Неопределено И ЭлементСвязи.Метаданные().ТабличныеЧасти.Найти("Параметры")<>Неопределено Тогда 
				
			Для i=0 По ЭлементСвязи.Параметры.Количество()-1 Цикл
				ПараметрСсылка=ЭлементСвязи.Параметры[i].Параметр;
				Если ТаблицаОтбораПараметров <> Неопределено И ТаблицаОтбораПараметров.НайтиСтроки(Новый Структура("Свойство", ПараметрСсылка.Свойство)).Количество()=0 Тогда 
					Продолжить; // пропускаем параметр
				КонецЕсли;
				
				ИзмГрупповойПолитики = aps_ПроверитьОбъектПрава(Справочники.aps_Права.ИзменениеГрупповойПолитики, ПараметрСсылка, ПараметрСсылка.GMOD);
				Если НЕ ИзмГрупповойПолитики Тогда 
					СтрокаРазрешений=СтрокаРазрешений+Символы.ПС+ЭлементСсылка.Наименование+НСтр("ru = "" (в контексте ""; en_US = "" (in context of """)+Строка(ЭлементСвязи.РодительСсылка)+"), "+ПараметрСсылка.Наименование;
					Продолжить;
				КонецЕсли;	
				
				ОбъектПараметра=ПараметрСсылка.ПолучитьОбъект();
				ОбъектПараметра.GMOD=Дескриптор;
				Если ОчищатьОбъектнуюПолитику=Истина Тогда
					ОбъектПараметра.MOD=Справочники.aps_ДескрипторыДоступа.ПустаяСсылка();					
				КонецЕсли;
				
				Попытка
					ОбъектПараметра.Записать();
					СтрокаИзменений=СтрокаИзменений+Символы.ПС+ЭлементСсылка.Наименование+НСтр("ru = "" (в контексте ""; en_US = "" (in context of """)+Строка(ЭлементСвязи.РодительСсылка)+"), "+ПараметрСсылка.Наименование;
				Исключение
					СтрокаОшибок=СтрокаОшибок+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
					Продолжить;
				КонецПопытки;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	#Если Клиент Тогда 
	ФормаПрогресса.Закрыть();
	
	Если Найти(СтрокаБлокировок,Символы.ПС)>0 Тогда 
		Сообщить(СтрокаБлокировок, СтатусСообщения.Внимание);
	КонецЕсли;
	Если Найти(СтрокаРазрешений,Символы.ПС)>0 Тогда 
		Сообщить(СтрокаРазрешений, СтатусСообщения.Внимание);
	КонецЕсли;
	Если Найти(СтрокаОшибок,Символы.ПС)>0 Тогда 
		Сообщить(СтрокаОшибок, СтатусСообщения.Внимание);
	КонецЕсли;
	Если Найти(СтрокаИзменений,Символы.ПС)>0 Тогда 
		Сообщить(СтрокаИзменений, СтатусСообщения.Информация);
	КонецЕсли;
	#КонецЕсли

КонецФункции

// Функция устанавливает новых владельца и группу для массива элементов
//
// Параметры:
//		МассивЭлементовXDTO - массив объектов XDTO, для которых необходимо установить владельца и группу
//		НовыйВладелец		- пользователь или системная группа
//		НоваяГруппа			- системная группа, группа пользователей или пользователь
//		СтруктураПараметров - структура параметров установки новых владельца и группы
//
// Возвращаемое значение:
//		нет
//
// Пример:
//		aps_УстановитьВладельцаИГруппу(ЗначениеВыбора, НовыйВладелец, НоваяГруппа, НастройкиПримененияПолитики);
//
Функция aps_УстановитьВладельцаИГруппу( МассивЭлементовXDTO, НовыйВладелец, НоваяГруппа, СтруктураПараметров ) Экспорт
	
	УстанавливатьДляЭлементов		= ?(СтруктураПараметров.Свойство("УстанавливатьДляЭлементов"), СтруктураПараметров.УстанавливатьДляЭлементов, Истина);
	УстанавливатьДляПараметров		= ?(СтруктураПараметров.Свойство("УстанавливатьДляПараметров"), СтруктураПараметров.УстанавливатьДляПараметров, Ложь);
	УстанавливатьДляПараметровСвязи	= ?(СтруктураПараметров.Свойство("УстанавливатьДляПараметровСвязи"), СтруктураПараметров.УстанавливатьДляПараметровСвязи, Ложь);
	
	ПараметрыДляУстановки			= ?(СтруктураПараметров.Свойство("ПараметрыДляУстановки"), СтруктураПараметров.ПараметрыДляУстановки, Неопределено);
	
	
	СтрокаБлокировок		=НСтр("ru = 'Заблокированные элементы:'; en_US = 'Blocked items:'");
	СтрокаРазрешений		=НСтр("ru = 'Отсутствует право изменения владельца и группы:'; en_US = 'Owner and group change permission is missing:'");
	СтрокаОшибок			=НСтр("ru = 'Ошибки:'; en_US = 'Errors:'");
	Если НовыйВладелец<>Ложь И НоваяГруппа<>Ложь Тогда 
		СтрокаИзменений=НСтр("ru = 'Владелец изменен на ""'; en_US = 'Owner is changed to ""'")+?(ЗначениеЗаполнено(НовыйВладелец), Строка(НовыйВладелец), НСтр("ru = 'Неопределено'; en_US = 'Undefined'"))+""""
									+НСтр("ru = '"", группа изменена на ""'; en_US = ', group is changed to ""'")+?(ЗначениеЗаполнено(НоваяГруппа), Строка(НоваяГруппа), НСтр("ru = 'Неопределено'; en_US = 'Undefined'"))+""":";
	ИначеЕсли НовыйВладелец<>Ложь Тогда 
		СтрокаИзменений=НСтр("ru = 'Владелец изменен на ""'; en_US = 'Owner is changed to ""'")+?(ЗначениеЗаполнено(НовыйВладелец), Строка(НовыйВладелец), НСтр("ru = 'Неопределено'; en_US = 'Undefined'"))+""":"
	ИначеЕсли НоваяГруппа<>Ложь Тогда 
		СтрокаИзменений=НСтр("ru = 'Группа изменена на ""'; en_US = 'Group is changed to ""'")+?(ЗначениеЗаполнено(НоваяГруппа), Строка(НоваяГруппа), НСтр("ru = 'Неопределено'; en_US = 'Undefined'"))+""":";
	КонецЕсли;
	
	#Если Клиент Тогда 
	ФормаПрогресса=ПолучитьОбщуюФорму("aps_ФормаИндикатора");
	ФормаПрогресса.МаксимальноеЗначение=МассивЭлементовXDTO.Количество();
	ФормаПрогресса.Открыть();
	#КонецЕсли
	
	Если ТипЗнч(МассивЭлементовXDTO) <> Тип("Массив") Тогда
		itemXDTO = МассивЭлементовXDTO;
		МассивЭлементовXDTO = Новый Массив;
		МассивЭлементовXDTO.Добавить(itemXDTO);
	КонецЕсли;
	
	// параметры для установки политики
	Если ПараметрыДляУстановки <> Неопределено Тогда 
		XDTOТаблицы = Строка2XDTO(ПараметрыДляУстановки);
		ТаблицаОтбораПараметров = СериализаторXDTO.ПрочитатьXDTO(XDTOТаблицы);
	КонецЕсли;
	
	Для Каждого itemXDTO Из МассивЭлементовXDTO Цикл
		ЭлементСсылка=itemXDTO.element;
		ЭлементСвязи =itemXDTO.link;
		
		#Если Клиент Тогда 
		ФормаПрогресса.НадписьПроцесса=ЭлементСсылка.Наименование;
		ФормаПрогресса.ЗначениеИндикатора=ФормаПрогресса.ЗначениеИндикатора+1;
		#КонецЕсли
		
		Если УстанавливатьДляЭлементов Тогда
			Разрешено=Истина;
			Если НЕ ЭлементСсылка.РедактирующийПользователь.Пустая() Тогда
				Разрешено=Ложь;
				СтрокаБлокировок=СтрокаБлокировок+Символы.ПС+ЭлементСсылка.Наименование+НСтр("ru = ', пользователь ""'; en_US = ' by user ""'")+Строка(ЭлементСсылка.РедактирующийПользователь)+"""";
			КонецЕсли;
			
			ИзмВладельцаИГруппы = (aps_ЯАдмин() ИЛИ ЭлементСсылка.UID=ПараметрыСеанса.ТекущийПользователь);
			Если НЕ ИзмВладельцаИГруппы Тогда
				Разрешено=Ложь;
				СтрокаРазрешений=СтрокаРазрешений+Символы.ПС+ЭлементСсылка.Наименование;
			КонецЕсли;
			
			Если Разрешено Тогда 
				itemObject=ЭлементСсылка.ПолучитьОбъект();
				Если НовыйВладелец<>Ложь Тогда 
					itemObject.UID=НовыйВладелец;
				КонецЕсли;
				Если НоваяГруппа<>Ложь Тогда 
					itemObject.GID=НоваяГруппа;
				КонецЕсли;
				
				Попытка
					itemObject.ДополнительныеСвойства.Вставить("ПроверитьУникальность", Ложь);
					itemObject.Записать();
					СтрокаИзменений=СтрокаИзменений+Символы.ПС+ЭлементСсылка.Наименование;
				Исключение
					СтрокаОшибок=СтрокаОшибок+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
		
		Если УстанавливатьДляПараметров Тогда
			Для i=0 По ЭлементСсылка.Параметры.Количество()-1 Цикл
				ПараметрСсылка=ЭлементСсылка.Параметры[i].Параметр;
				Если ТаблицаОтбораПараметров <> Неопределено И ТаблицаОтбораПараметров.НайтиСтроки(Новый Структура("Свойство", ПараметрСсылка.Свойство)).Количество()=0 Тогда 
					Продолжить; // пропускаем параметр
				КонецЕсли;
				
				ИзмВладельцаИГруппы = (aps_ЯАдмин() ИЛИ ПараметрСсылка.UID=ПараметрыСеанса.ТекущийПользователь);
				Если НЕ ИзмВладельцаИГруппы Тогда 
					СтрокаРазрешений=СтрокаРазрешений+Символы.ПС+ЭлементСсылка.Наименование+", "+ПараметрСсылка.Наименование;
					Продолжить;
				КонецЕсли;	
				
				ОбъектПараметра=ПараметрСсылка.ПолучитьОбъект();
				Если НовыйВладелец<>Ложь Тогда 
					ОбъектПараметра.UID=НовыйВладелец;
				КонецЕсли;
				Если НоваяГруппа<>Ложь Тогда 
					ОбъектПараметра.GID=НоваяГруппа;
				КонецЕсли;
				
				Попытка
					ОбъектПараметра.Записать();
					СтрокаИзменений=СтрокаИзменений+Символы.ПС+ЭлементСсылка.Наименование+", "+ПараметрСсылка.Наименование;
				Исключение
					СтрокаОшибок=СтрокаОшибок+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
					Продолжить;
				КонецПопытки;
			КонецЦикла;
		КонецЕсли;
		
		Если УстанавливатьДляПараметровСвязи
				И ЭлементСвязи<>Неопределено И ЭлементСвязи.Метаданные().ТабличныеЧасти.Найти("Параметры")<>Неопределено Тогда 
				
			Для i=0 По ЭлементСвязи.Параметры.Количество()-1 Цикл
				ПараметрСсылка=ЭлементСвязи.Параметры[i].Параметр;
				Если ТаблицаОтбораПараметров <> Неопределено И ТаблицаОтбораПараметров.НайтиСтроки(Новый Структура("Свойство", ПараметрСсылка.Свойство)).Количество()=0 Тогда 
					Продолжить; // пропускаем параметр
				КонецЕсли;
				
				ИзмВладельцаИГруппы = (aps_ЯАдмин() ИЛИ ПараметрСсылка.UID=ПараметрыСеанса.ТекущийПользователь);
				Если НЕ ИзмВладельцаИГруппы Тогда
					СтрокаРазрешений=СтрокаРазрешений+Символы.ПС+ЭлементСсылка.Наименование+НСтр("ru = ' (в контексте '; en_US = ' (in context of '")+Строка(ЭлементСвязи.РодительСсылка)+"), "+ПараметрСсылка.Наименование;
					Продолжить;
				КонецЕсли;	
				
				ОбъектПараметра=ПараметрСсылка.ПолучитьОбъект();
				Если НовыйВладелец<>Ложь Тогда 
					ОбъектПараметра.UID=НовыйВладелец;
				КонецЕсли;
				Если НоваяГруппа<>Ложь Тогда 
					ОбъектПараметра.GID=НоваяГруппа;
				КонецЕсли;
				
				Попытка
					ОбъектПараметра.Записать();
					СтрокаИзменений=СтрокаИзменений+Символы.ПС+ЭлементСсылка.Наименование+НСтр("ru = ' (в контексте '; en_US = ' (in context of '")+Строка(ЭлементСвязи.РодительСсылка)+"), "+ПараметрСсылка.Наименование;
				Исключение
					СтрокаОшибок=СтрокаОшибок+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
					Продолжить;
				КонецПопытки;
			КонецЦикла;
		КонецЕсли;
				
	КонецЦикла;
	
	#Если Клиент Тогда 
	ФормаПрогресса.Закрыть();
	
	Если Найти(СтрокаБлокировок,Символы.ПС)>0 Тогда 
		Сообщить(СтрокаБлокировок, СтатусСообщения.Внимание);
	КонецЕсли;
	Если Найти(СтрокаРазрешений,Символы.ПС)>0 Тогда 
		Сообщить(СтрокаРазрешений, СтатусСообщения.Внимание);
	КонецЕсли;
	Если Найти(СтрокаОшибок,Символы.ПС)>0 Тогда 
		Сообщить(СтрокаОшибок, СтатусСообщения.Внимание);
	КонецЕсли;
	Если Найти(СтрокаИзменений,Символы.ПС)>0 Тогда 
		Сообщить(СтрокаИзменений, СтатусСообщения.Информация);
	КонецЕсли;
	#КонецЕсли

КонецФункции


// Функция создает копию дескриптора
//
// Параметры:
// 		ДескрипторИсточник - дескриптор доступа
//
// Возвращаемое значение:
//		СправочникСсылка.aps_ДескрипторыДоступа - созданная копия
//
// Пример:
//		НовыйДескриптор = aps_СкопироватьДескриптор(ДескрипторОбъектнойПолитики);
//
Функция aps_СкопироватьДескриптор( ДескрипторИсточник ) Экспорт
	Попытка
		НачатьТранзакцию();
			НаборПрав = РегистрыСведений.aps_ЗначенияОбъектовПравПолитик.СоздатьНаборЗаписей();
			НаборПрав.Отбор.Источник.Установить( ДескрипторИсточник );
			НаборПрав.Прочитать();
		
			НовыйДескрипторОбъект=ДескрипторИсточник.ПолучитьОбъект().Скопировать();
			GUIDСсылки=Новый УникальныйИдентификатор();
			СсылкаНового=Справочники.aps_ДескрипторыДоступа.ПолучитьСсылку(GUIDСсылки);
			НовыйДескрипторОбъект.УстановитьСсылкуНового(СсылкаНового);
			НовыйДескрипторОбъект.Наименование=Строка(GUIDСсылки);
			НовыйДескрипторОбъект.Записать();
		
			Для Каждого СтрокаНабора Из НаборПрав Цикл
				НоваяЗапись=РегистрыСведений.aps_ЗначенияОбъектовПравПолитик.СоздатьМенеджерЗаписи();
				НоваяЗапись.Источник	= НовыйДескрипторОбъект.Ссылка;
				НоваяЗапись.СубъектПрава= СтрокаНабора.СубъектПрава;
				НоваяЗапись.ОбъектПрава	= СтрокаНабора.ОбъектПрава;
				НоваяЗапись.Разрешить	= СтрокаНабора.Разрешить;
				НоваяЗапись.Запретить	= СтрокаНабора.Запретить;
				НоваяЗапись.Записать();
			КонецЦикла;
		ЗафиксироватьТранзакцию();
		Возврат НовыйДескрипторОбъект.Ссылка;
	Исключение
		ОтменитьТранзакцию();
		Возврат Неопределено;
	КонецПопытки;
КонецФункции	

// Функция возвращает массив элементов применяемости дескриптора
//
// Параметры:
//		Дескриптор - дескриптор доступа
//
// Возвращаемое значение:
//		Массив
//
// Пример:
//		ПрименяемостьДескриптора=aps_ПрименяемостьДескриптора(ДескрипторОбъектнойПолитики);
//
Функция aps_ПрименяемостьДескриптора( Дескриптор ) Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	aps_ЭлементыИзделия.Ссылка КАК ВладелецДескриптора
	                      |ИЗ
	                      |	Справочник.aps_ЭлементыИзделия КАК aps_ЭлементыИзделия
	                      |ГДЕ
	                      |	(НЕ aps_ЭлементыИзделия.ПометкаУдаления)
	                      |	И aps_ЭлементыИзделия.MOD = &MOD
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	aps_ЭлементыТехнологии.Ссылка
	                      |ИЗ
	                      |	Справочник.aps_ЭлементыТехнологии КАК aps_ЭлементыТехнологии
	                      |ГДЕ
	                      |	(НЕ aps_ЭлементыТехнологии.ПометкаУдаления)
	                      |	И aps_ЭлементыТехнологии.MOD = &MOD
	                      |
	                      |ОБЪЕДИНИТЬ ВСЕ
	                      |
	                      |ВЫБРАТЬ
	                      |	aps_ЭлементыСправочников.Ссылка
	                      |ИЗ
	                      |	Справочник.aps_ЭлементыСправочников КАК aps_ЭлементыСправочников
	                      |ГДЕ
	                      |	(НЕ aps_ЭлементыСправочников.ПометкаУдаления)
	                      |	И aps_ЭлементыСправочников.MOD = &MOD");
	Запрос.УстановитьПараметр("MOD", Дескриптор);
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку(0);
КонецФункции

#КонецОбласти

#КонецЕсли