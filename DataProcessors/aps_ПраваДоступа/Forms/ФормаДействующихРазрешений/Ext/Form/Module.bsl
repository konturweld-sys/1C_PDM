
#Если Не МобильноеПриложениеКлиент Тогда
	
#Область ОбработчикиСобытийФормыНаКлиенте	
	
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Заголовок = Строка(ЭлементИлиПараметр);
	ПользовательДляПроверкиПриИзменении(Неопределено);
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиЭлементовФормы

&НаКлиенте
Процедура ПользовательДляПроверкиПриИзменении(Элемент)
	ПроверитьРазрешенияПользователя();
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПодробнееОПравах(Команда)
	ОткрытьСправку("Справочник.aps_Права"); 
КонецПроцедуры

#КонецОбласти
	
#КонецЕсли

#Если Не МобильноеПриложениеСервер Тогда

#Область ОбработчикиСобытийФормыНаСервере

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если НЕ Параметры.Свойство("item") Тогда 
		Отказ = Истина; Возврат;
	КонецЕсли;
	
	ЭлементИлиПараметр = Параметры.item;
	// проверяем для текущего пользователя
	ПользовательДляПроверки = ПараметрыСеанса.ТекущийПользователь;
КонецПроцедуры

#КонецОбласти


#Область ПрочиеПроцедурыИФункции

&НаСервере
Процедура ПроверитьРазрешенияПользователя()
	Если Разрешения.Количество() = 0 Тогда 
		ВыборкаВсехОбъектовДоступа = Справочники.aps_Права.Выбрать();
		Пока ВыборкаВсехОбъектовДоступа.Следующий() Цикл
			Разрешения.Добавить(ВыборкаВсехОбъектовДоступа.Ссылка);
		КонецЦикла;
	КонецЕсли;
	
	Разрешения.ЗаполнитьПометки(Ложь);
	
	Если ПользовательДляПроверки.Пустая() Тогда 
		Возврат;
	КонецЕсли;
	
	// проверка прав выбранного пользователя
	ПараметрыСеанса.ТекущийПользователь=ПользовательДляПроверки;
	aps_ПолныеПрава.aps_ОбновитьПолитикуТекущегоПользователя();

	МодульПравДоступа = Обработки.aps_ПраваДоступа.Создать();
	Для i=0 По Разрешения.Количество()-1 Цикл 
		Разрешения[i].Пометка = МодульПравДоступа.aps_ПроверитьОбъектПрава(Разрешения[i].Значение, ЭлементИлиПараметр, ЭлементИлиПараметр.GMOD);
	КонецЦикла;
	
	ПараметрыСеанса.ТекущийПользователь=МодульПравДоступа.aps_ОпределитьТекущегоПользователя(ИмяПользователя());
	aps_ПолныеПрава.aps_ОбновитьПолитикуТекущегоПользователя();
КонецПроцедуры

#КонецОбласти

#КонецЕсли