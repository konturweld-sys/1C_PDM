
#Если Не МобильноеПриложениеКлиент Тогда

#Область ОбработчикиСобытийФормы	
	
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОбработкаОповещения("AppiusWindowGeneralNotify", aps_СтруктураПараметровОповещения, Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	Если Модифицированность Тогда
		Ответ = Вопрос(НСтр("ru = ""Принять внесенные изменения?""; en_US = ""Accept changes?"""), РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Да);
		Если Ответ = КодВозвратаДиалога.Да Тогда
			Применить(Неопределено);
		Иначе 
			Восстановить(Неопределено);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	Если ИсточникВыбора.КлючУникальности="ПрименитьОбъектнуюПолитикуДляНескольких" Тогда	
		ФормаНастроек=ПолучитьФорму("Обработка.aps_ПраваДоступа.Форма.ФормаНастроекПримененияПолитики");
		ФормаНастроек.Элементы.ИзменениеВладельцаИГруппы.Видимость = Ложь;
		ФормаНастроек.Элементы.ИзменениеГрупповойПолитики.Видимость = Ложь;
		Если ФормаНастроек.ОткрытьМодально()=Истина Тогда
			НастройкиПримененияПолитики = Новый Структура();
			НастройкиПримененияПолитики.Вставить("ОчищатьГрупповуюПолитику"			, ФормаНастроек.ОчищатьГрупповуюПолитику);
			НастройкиПримененияПолитики.Вставить("УстанавливатьДляЭлементов"		, ФормаНастроек.ПрименитьДляЭлементов);
			НастройкиПримененияПолитики.Вставить("УстанавливатьДляПараметров"		, ФормаНастроек.ПрименитьДляПараметров);
			НастройкиПримененияПолитики.Вставить("УстанавливатьДляПараметровСвязи"	, ФормаНастроек.ПрименитьДляПараметровСвязи);
			НастройкиПримененияПолитики.Вставить("ПараметрыДляУстановки"			, ФормаНастроек.ПараметрыДляПрименения);
			
			Состояние(НСтр("ru = ""Установка объектной политики...""; en_US = ""Object policy setting..."""));
			УстановитьОбъектнуюПолитику(ВыбранноеЗначение, НастройкиПримененияПолитики);
			Состояние(НСтр("ru = ""Установка объектной политики завершена""; en_US = ""Object policy setting is completed"""));
		КонецЕсли;
		
	ИначеЕсли ИсточникВыбора.КлючУникальности="ПрименитьГрупповуюПолитикуДляНескольких" Тогда
		ФормаНастроек=ПолучитьФорму("Обработка.aps_ПраваДоступа.Форма.ФормаНастроекПримененияПолитики");
		ФормаНастроек.Элементы.ИзменениеВладельцаИГруппы.Видимость = Ложь;
		ФормаНастроек.Элементы.ИзменениеОбъектнойПолитики.Видимость = Ложь;
		
		Если ФормаНастроек.ОткрытьМодально()=Истина Тогда
			НастройкиПримененияПолитики = Новый Структура();
			НастройкиПримененияПолитики.Вставить("ОчищатьОбъектнуюПолитику"			, ФормаНастроек.ОчищатьОбъектнуюПолитику);
			НастройкиПримененияПолитики.Вставить("УстанавливатьДляЭлементов"		, ФормаНастроек.ПрименитьДляЭлементов);
			НастройкиПримененияПолитики.Вставить("УстанавливатьДляПараметров"		, ФормаНастроек.ПрименитьДляПараметров);
			НастройкиПримененияПолитики.Вставить("УстанавливатьДляПараметровСвязи"	, ФормаНастроек.ПрименитьДляПараметровСвязи);
			НастройкиПримененияПолитики.Вставить("ПараметрыДляУстановки"			, ФормаНастроек.ПараметрыДляПрименения);
			
			Состояние(НСтр("ru = ""Установка групповой политики...""; en_US = ""Group policy setting..."""));
			УстановитьГрупповуюПолитику(ВыбранноеЗначение, НастройкиПримененияПолитики);
			Состояние(НСтр("ru = ""Установка групповой политики завершена""; en_US = ""Group policy setting is completed"""));
		КонецЕсли;
		
	ИначеЕсли ИсточникВыбора.КлючУникальности="ПрименитьВладельцаИГруппуДляНескольких" Тогда
		ФормаНастроек=ПолучитьФорму("Обработка.aps_ПраваДоступа.Форма.ФормаНастроекПримененияПолитики");
		ФормаНастроек.Элементы.ИзменениеОбъектнойПолитики.Видимость = Ложь;
		ФормаНастроек.Элементы.ИзменениеГрупповойПолитики.Видимость = Ложь;
		ФормаНастроек.ИзменятьВладельца = Истина;
		ФормаНастроек.ИзменятьГруппу = Истина;
		
		Если ФормаНастроек.ОткрытьМодально() = Истина И (ФормаНастроек.ИзменятьВладельца Или ФормаНастроек.ИзменятьГруппу) Тогда
			НовыйВладелец = ?(ФормаНастроек.ИзменятьВладельца, Владелец, Ложь);
			НоваяГруппа = ?(ФормаНастроек.ИзменятьГруппу, Группа, Ложь);
			
			НастройкиПримененияПолитики = Новый Структура();
			НастройкиПримененияПолитики.Вставить("УстанавливатьДляЭлементов"		, ФормаНастроек.ПрименитьДляЭлементов);
			НастройкиПримененияПолитики.Вставить("УстанавливатьДляПараметров"		, ФормаНастроек.ПрименитьДляПараметров);
			НастройкиПримененияПолитики.Вставить("УстанавливатьДляПараметровСвязи"	, ФормаНастроек.ПрименитьДляПараметровСвязи);
			НастройкиПримененияПолитики.Вставить("ПараметрыДляУстановки"			, ФормаНастроек.ПараметрыДляПрименения);
			
			Состояние(НСтр("ru = ""Установка владельца и группы...""; en_US = ""Owner and group setting..."""));
			УстановитьВладельцаИГруппу(ВыбранноеЗначение, НовыйВладелец, НоваяГруппа, НастройкиПримененияПолитики);
			Состояние(НСтр("ru = ""Установка владельца и группы завершена""; en_US = ""Owner and group setting is completed"""));
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "AppiusWindowGeneralNotify" Тогда
		// Не реагировать на оповещение от подчиненной формы и от самой себя
		ВладелецФормыИсточника = Источник;
		Пока ВладелецФормыИсточника <> Неопределено Цикл 
			Если ВладелецФормыИсточника = ЭтаФорма Тогда 
				Возврат;
			КонецЕсли;
			Если ТипЗнч(ВладелецФормыИсточника)=Тип("УправляемаяФорма") Тогда 
				ВладелецФормыИсточника = ВладелецФормыИсточника.ВладелецФормы;
			Иначе 
				ВладелецФормыИсточника = Неопределено;
			КонецЕсли;
		КонецЦикла;
		
		ПередЗакрытием(Неопределено, Неопределено);
		
		Если Параметр.Свойство("item") И ЗначениеЗаполнено(Параметр.item) Тогда 
			Объект.item = Параметр.item;
		ИначеЕсли Источник <> Неопределено Тогда  
			Возврат;
		КонецЕсли;
		
		ОбновлениеИнформацииВОкне();
		
	ИначеЕсли ИмяСобытия = "AppiusWindowParameterNotify" Тогда
		
		// Не реагировать на оповещение от подчиненной формы и от самой себя
		ВладелецФормыИсточника = Источник;
		Пока ВладелецФормыИсточника <> Неопределено Цикл 
			Если ВладелецФормыИсточника = ЭтаФорма Тогда 
				Возврат;
			КонецЕсли;
			Если ТипЗнч(ВладелецФормыИсточника)=Тип("УправляемаяФорма") Тогда 
				ВладелецФормыИсточника = ВладелецФормыИсточника.ВладелецФормы;
			Иначе 
				ВладелецФормыИсточника = Неопределено;
			КонецЕсли;
		КонецЦикла;
		
		ПередЗакрытием(Неопределено, Неопределено);
		
		Если Параметр.Свойство("parameter") Тогда 
			Объект.item = Параметр.parameter;
			ОбновлениеИнформацииВОкне();
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Применить(Команда)
	КнопкаПрименить();
	Модифицированность = Ложь;
	
	ОбновлениеИнформацииВОкне();
	ДоступностьКнопкиПрименить();
КонецПроцедуры

&НаКлиенте
Процедура Восстановить(Команда)
	ОбновлениеИнформацииВОкне();
	Модифицированность = Ложь;
	
	Элементы.СубъектыПрава.Обновить();
	ДоступностьКнопкиПрименить();
КонецПроцедуры

&НаКлиенте
Процедура Очистить(Команда)
	КнопкаОчистить();
	Элементы.СубъектыПрава.Обновить();
	Модифицированность = Истина;
	ДоступностьКнопкиПрименить();
КонецПроцедуры

&НаКлиенте
Процедура Изменить(Команда)
	Если НЕ Объект.ДескрипторОбъектнойПолитики.Пустая() Тогда 
		Применяемость = ПрименяемостьДескриптора(Объект.ДескрипторОбъектнойПолитики);
		Если Применяемость>1 Тогда
			Предупреждение(НСтр("ru = ""Дескриптор используется в ""; en_US = ""This descriptor is used in """)+Строка(Применяемость)+НСтр("ru = "" элементах. Изменение прав в дескрипторе политики, может привести к невозможности доступа к этим элементам!""; en_US = ""items. Change of permissions in descriptor can result in impossibility of access to this items!"""));
		КонецЕсли;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("Ключ", Объект.ДескрипторОбъектнойПолитики);
	Форма = ПолучитьФорму("Справочник.aps_ДескрипторыДоступа.ФормаОбъекта", ПараметрыФормы);
	Форма.ОткрытьМодально();
	
	Объект.ДескрипторОбъектнойПолитики = Форма.Объект.Ссылка;
	
	ОбновлениеОбъектныхПрав();
	
	Если СубъектыПрава.Количество() > 0 И Элементы.СубъектыПрава.ТекущаяСтрока=Неопределено Тогда 
		Элементы.СубъектыПрава.ТекущаяСтрока = СубъектыПрава[0].ПолучитьИдентификатор();
	КонецЕсли;
	
	ДоступностьКнопкиПрименить();
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьДляНескольких(Команда)
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	ПараметрыФормы.Вставить("ВыбиратьXDTO", Истина);
	ОткрытьФорму("Обработка.aps_Проводник.Форма", ПараметрыФормы, ЭтаФорма, Команда.Имя);
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиЭлементовФормы

&НаКлиенте
Процедура СубъектыПраваПриАктивизацииСтроки(Элемент)
	Если Элемент.ТекущиеДанные <> Неопределено Тогда
		Субъект = Элемент.ТекущиеДанные.СубъектПрава;
	Иначе
		Субъект = Неопределено;
	КонецЕсли;
	
	СубъектыПраваПриАктивизацииСтрокиСервер(Субъект); 
КонецПроцедуры  

&НаКлиенте
Процедура ПолеВладелецПриИзменении(Элемент)
	Если ПолеВладелецПриИзмененииСервер(Владелец) Тогда
		Предупреждение(НСтр("ru = ""В качестве владельца может быть выбрана только системная группа <""; en_US = ""Only <""")+Строка(Владелец)+НСтр("ru = "">!""; en_US = ""> system group can be selected as the owner."""));
	КонецЕсли;
	Модифицированность=Истина;
	ДоступностьКнопкиПрименить();
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииПоля(Элемент)
	Модифицированность=Истина;
	ДоступностьКнопкиПрименить();
КонецПроцедуры

&НаКлиенте
Процедура ГруппаСтраницПриСменеСтраницы(Элемент, ТекущаяСтраница)
	ДоступностьКнопкиПрименить();
КонецПроцедуры

#КонецОбласти


#Область ОбновлениеДанныхФормы

&НаКлиенте
Процедура ОбновлениеИнформацииВОкне()
	СтруктураПравПользователя = Новый Структура();
	ОбновлениеИнформацииВОкнеСервер(СтруктураПравПользователя);
	
	Если ЗначениеЗаполнено( Объект.item ) Тогда
		ИзмВладельца = СтруктураПравПользователя.ИзменениеВладельца;
		ИзмОбъектнойПолитики = СтруктураПравПользователя.ИзменениеОбъектнойПолитики;
		ИзмГрупповойПолитики = СтруктураПравПользователя.ИзменениеГрупповойПолитики;
		
		Элементы.ПолеВладелец.ТолькоПросмотр = НЕ ИзмВладельца;
		Элементы.ПолеГруппа.ТолькоПросмотр	 = НЕ ИзмВладельца;
		
		Элементы.НаследоватьОбПолитику.ТолькоПросмотр = НЕ ИзмОбъектнойПолитики;
		
		Элементы.ИзменениеОбПолитики.Доступность	= ИзмОбъектнойПолитики;
		Элементы.ОчисткаОбПолитики.Доступность		= ИзмОбъектнойПолитики;
		
		Элементы.ДескрипторГрупповойПолитики.ТолькоПросмотр = НЕ ИзмГрупповойПолитики;
		
		Заголовок = НСтр("ru = ""Права доступа: ""; en_US = ""Security: """)+Строка(Объект.item);
	Иначе 
		Элементы.ПолеВладелец.ТолькоПросмотр = Истина;
		Элементы.ПолеГруппа.ТолькоПросмотр	 = Истина;
		
		Элементы.НаследоватьОбПолитику.ТолькоПросмотр = Истина;
		
		Элементы.ИзменениеОбПолитики.Доступность	= Ложь;
		Элементы.ОчисткаОбПолитики.Доступность		= Ложь;
		
		Элементы.ДескрипторГрупповойПолитики.ТолькоПросмотр = Истина;
		
		Заголовок = НСтр("ru = ""Права доступа""; en_US = ""Security""");
	КонецЕсли;
	
	Если СубъектыПрава.Количество() > 0 И Элементы.СубъектыПрава.ТекущаяСтрока=Неопределено Тогда 
		Элементы.СубъектыПрава.ТекущаяСтрока = СубъектыПрава[0].ПолучитьИдентификатор();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДоступностьКнопкиПрименить()
	Элементы.Применить.Доступность = Модифицированность;
КонецПроцедуры

#КонецОбласти

#КонецЕсли

#Если НЕ МобильноеПриложениеСервер Тогда

#Область ПрочиеПроцедурыИФункции	
	
&НаСервере
Процедура ОбновлениеИнформацииВОкнеСервер(СтруктураПрав)
	
	ЭтотОбъектИБ = РеквизитФормыВЗначение("Объект");
	
	Если ЗначениеЗаполнено( Объект.item ) Тогда
		
		ИзмВладельца = aps_ЯАдмин() ИЛИ (Объект.item.UID=ПараметрыСеанса.ТекущийПользователь);
		СтруктураПрав.Вставить("ИзменениеВладельца", ИзмВладельца);
		
		ИзмОбъектнойПолитики= (Объект.item.UID=ПараметрыСеанса.ТекущийПользователь) ИЛИ ЭтотОбъектИБ.aps_ПроверитьОбъектПрава(Справочники.aps_Права.ИзменениеОбъектнойПолитики, Объект.item, Объект.item.GMOD);
		СтруктураПрав.Вставить("ИзменениеОбъектнойПолитики", ИзмОбъектнойПолитики);
		
		ИзмГрупповойПолитики= ЭтотОбъектИБ.aps_ПроверитьОбъектПрава(Справочники.aps_Права.ИзменениеГрупповойПолитики, Объект.item, Объект.item.GMOD);
		СтруктураПрав.Вставить("ИзменениеГрупповойПолитики", ИзмГрупповойПолитики);
		
		Владелец	= Объект.item.UID;
		Группа		= Объект.item.GID;
		
		НаследоватьОбПолитику = Объект.item.SGID;
		
		Объект.ДескрипторГрупповойПолитики=Объект.item.GMOD;
		Объект.ДескрипторОбъектнойПолитики=Объект.item.MOD;
		
		ОбновлениеОбъектныхПрав();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновлениеОбъектныхПрав()
	
	ЗнПравДоступа = РеквизитФормыВЗначение("ЗначенияПравДоступа");
	ЗнПравДоступа.Отбор.Источник.Установить(Неопределено);
	ЗнПравДоступа.Отбор.СубъектПрава.Установить(Неопределено);
	ЗначениеВРеквизитФормы(ЗнПравДоступа, "ЗначенияПравДоступа");
	//- Обновление объектных прав -------------------------------------
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
						  |	aps_ЗначенияОбъектовПравПолитик.СубъектПрава КАК СубъектПрава
						  |ИЗ
						  |	РегистрСведений.aps_ЗначенияОбъектовПравПолитик КАК aps_ЗначенияОбъектовПравПолитик
						  |ГДЕ
						  |	aps_ЗначенияОбъектовПравПолитик.Источник = &Источник
						  |
						  |УПОРЯДОЧИТЬ ПО
						  |	СубъектПрава");
	Запрос.УстановитьПараметр("Источник", Объект.ДескрипторОбъектнойПолитики);
	ЗначениеВРеквизитФормы(Запрос.Выполнить().Выгрузить(), "СубъектыПрава");

КонецПроцедуры

&НаСервере
Процедура КнопкаПрименить()
	Попытка
		
		ЭлементОбъект = Объект.item.ПолучитьОбъект();
		
		ЭлементОбъект.UID	= Владелец;
		ЭлементОбъект.GID	= Группа;
		ЭлементОбъект.SGID	= НаследоватьОбПолитику;
		
		ЭлементОбъект.GMOD	= Объект.ДескрипторГрупповойПолитики;
		ЭлементОбъект.MOD	= Объект.ДескрипторОбъектнойПолитики;
		
		ЭлементОбъект.Записать();
			
	Исключение
		
		Сообщить(ПараметрыСеанса.aps_ИмяПродукта + НСтр("ru = ""Ошибка записи изменений:""; en_US = ""Write error:""") + Символы.ПС + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), СтатусСообщения.Внимание);
		
	КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура УстановитьОбъектнуюПолитику(МассивСтрокXML, НастройкиПримененияПолитики)
	ЭтотОбъектИБ = РеквизитФормыВЗначение("Объект");
	МодельXDTO = ПолучитьМассивXDTO(МассивСтрокXML);
	ЭтотОбъектИБ.aps_УстановитьОбъектнуюПолитику(МодельXDTO, ЭтотОбъектИБ.ДескрипторОбъектнойПолитики, НастройкиПримененияПолитики);
КонецПроцедуры

&НаСервере
Процедура УстановитьГрупповуюПолитику(МассивСтрокXML, НастройкиПримененияПолитики)
	ЭтотОбъектИБ = РеквизитФормыВЗначение("Объект");
	МодельXDTO = ПолучитьМассивXDTO(МассивСтрокXML);
	ЭтотОбъектИБ.aps_УстановитьГрупповуюПолитику(МодельXDTO, ЭтотОбъектИБ.ДескрипторГрупповойПолитики, НастройкиПримененияПолитики);
КонецПроцедуры

&НаСервере
Процедура УстановитьВладельцаИГруппу(МассивСтрокXML, НовыйВладелец, НоваяГруппа, НастройкиПримененияПолитики)
	ЭтотОбъектИБ = РеквизитФормыВЗначение("Объект");
	МодельXDTO = ПолучитьМассивXDTO(МассивСтрокXML);
	ЭтотОбъектИБ.aps_УстановитьВладельцаИГруппу(МодельXDTO, НовыйВладелец, НоваяГруппа, НастройкиПримененияПолитики);
КонецПроцедуры

&НаСервере
Функция ПолучитьМассивXDTO(МассивСтрокXML)
	МассивXDTO = Новый Массив(МассивСтрокXML.Количество());
	Для i=0 По МассивСтрокXML.Количество()-1 Цикл
		МассивXDTO[i] = Строка2XDTO(МассивСтрокXML[i]);
	КонецЦикла;
	Возврат МассивXDTO;
КонецФункции

&НаСервере
Процедура КнопкаОчистить()
	Объект.ДескрипторОбъектнойПолитики = Справочники.aps_ДескрипторыДоступа.ПустаяСсылка();
	ОбновлениеОбъектныхПрав();
КонецПроцедуры

&НаСервере
Функция ПрименяемостьДескриптора(Дескриптор)
	
	ПрименяемостьДескриптора=РеквизитФормыВЗначение("Объект").aps_ПрименяемостьДескриптора(Дескриптор);
	Возврат ПрименяемостьДескриптора.Количество();
		
 КонецФункции

&НаСервере
Процедура СубъектыПраваПриАктивизацииСтрокиСервер(Субъект)
	ЗнПравДоступа = РеквизитФормыВЗначение("ЗначенияПравДоступа");
	ЗнПравДоступа.Отбор.Источник.Установить( Объект.ДескрипторОбъектнойПолитики );
	ЗнПравДоступа.Отбор.СубъектПрава.Установить( Субъект );
	ЗнПравДоступа.Прочитать();
	ЗначениеВРеквизитФормы(ЗнПравДоступа, "ЗначенияПравДоступа");
		
	ТаблицаЗначенийПрав = ЗначенияПравДоступа.Выгрузить();
	ТаблицаЗначенийПрав.Сортировать("ОбъектПрава");
	ЗначенияПравДоступа.Загрузить(ТаблицаЗначенийПрав);
КонецПроцедуры

&НаСервере
Функция ПолеВладелецПриИзмененииСервер(Значение)
	Если ЗначениеЗаполнено(Значение) И ТипЗнч(Значение)=Тип("ПеречислениеСсылка.aps_СистемныеГруппы")
			И Значение<>Перечисления.aps_СистемныеГруппы.Администраторы Тогда 
		Значение = Перечисления.aps_СистемныеГруппы.Администраторы;	
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

#КонецОбласти

#КонецЕсли
