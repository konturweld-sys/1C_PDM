
#Область ПрограммныйИнтерфейс

#Если НЕ МобильноеПриложениеСервер Тогда

// Функция возвращает найденные таблицы параметров для принятой модели XDTO (вызывать без третьего параметра)
// Параметры:
//		item_xdto - ОбъектXDTO
//		МассивXDTO - массив (пустой)
// Возвращаемое значение:
//      Соответствие
// Пример:
//		соответствиеЭлементовИТаблиц=aps_ПолучитьТаблицыПараметровПоXDTOИСформироватьМассив( item_xdto, массивXDTO );
//
Функция aps_ПолучитьТаблицыПараметровПоXDTOИСформироватьМассив( item_xdto, массивXDTO, входСоответствие=Неопределено ) Экспорт
	Если входСоответствие=Неопределено Тогда
		входСоответствие=Новый Соответствие();
	КонецЕсли;
	массивXDTO.Добавить(item_xdto);
	Если item_xdto.element<>Неопределено Тогда
		хранилищеТаблицы=item_xdto.element.ТаблицаПараметров.Получить();
		Если хранилищеТаблицы<>Неопределено Тогда
			входСоответствие.Вставить(item_xdto.element, хранилищеТаблицы);
		КонецЕсли;
	КонецЕсли;
	Для i=0 По item_xdto.items.Количество()-1 Цикл
		aps_ПолучитьТаблицыПараметровПоXDTOИСформироватьМассив(item_xdto.items[i], массивXDTO, входСоответствие);
	КонецЦикла;
	Возврат входСоответствие;
КонецФункции

// Функция получает критерии по указанной таблице параметров
// Параметры:
//		таблицаПараметров - табличный документ
// Возвращаемое значение:
//      Список значений
// Пример:
//		Элемент.СписокВыбора = aps_ПолучитьКритерииТаблицыПараметров(ТекущаяСтрока.item.ТаблицаПараметров.Получить());
//
Функция aps_ПолучитьКритерииТаблицыПараметров( таблицаПараметров ) Экспорт
	СписокКритериев=Новый СписокЗначений();
	ШиринаТаблицы = таблицаПараметров.ШиринаТаблицы;
	Для i=2 По ШиринаТаблицы Цикл
		ОбластьКритерия = таблицаПараметров.Область(1,i,1,i);
		Если ОбластьКритерия.СодержитЗначение И ЗначениеЗаполнено(ОбластьКритерия.Значение) Тогда
			СписокКритериев.Добавить(ОбластьКритерия.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат СписокКритериев;
КонецФункции

// Функция получает основной критерий по указанной таблице параметров
// Параметры:
//		таблицаПараметров - табличный документ
// Возвращаемое значение:
//      значение критерия таблицы, произвольное значение
// Пример:
//		СтрокаТаблицыФормы.КритерийТаблицыПараметров=aps_ПолучитьОсновнойКритерийТаблицыПараметров(КИЗ.Значение);
//
Функция aps_ПолучитьОсновнойКритерийТаблицыПараметров( таблицаПараметров ) Экспорт
	ШиринаТаблицы = таблицаПараметров.ШиринаТаблицы;
	Для i=2 По ШиринаТаблицы Цикл
		ОбластьКритерия = таблицаПараметров.Область(1,i,1,i);
		Если ОбластьКритерия.СодержитЗначение И ЗначениеЗаполнено(ОбластьКритерия.Значение) И НЕ ПустаяСтрока(ОбластьКритерия.Примечание.Текст) Тогда
			Возврат ОбластьКритерия.Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Функция присваивает параметрам модели XDTO значения из таблицы по критерию
// Параметры:
//		массивXDTO - массив XDTO-моделей
//		ТалицаПараметров - табличный документ
//		КритерийТаблицы - критерий таблицы, произвольное значение
// Пример:
//		aps_ПараметризацияXDTOПоТаблице(массивXDTO, СтрокаТаблицыФормы.item.ТаблицаПараметров.Получить(), СтрокаТаблицыФормы.КритерийТаблицыПараметров);
//
Процедура aps_ПараметризацияXDTOПоТаблице( массивXDTO, ТаблицаПараметров, КритерийТаблицы ) Экспорт
	СоответствиеПараметровИЗначений=Новый Соответствие();
	ШиринаТаблицы = ТаблицаПараметров.ШиринаТаблицы;
	Для i=2 По ШиринаТаблицы Цикл
		ОбластьКритерия = таблицаПараметров.Область(1,i,1,i);
		Если ОбластьКритерия.СодержитЗначение И ОбластьКритерия.Значение=КритерийТаблицы Тогда
			Для c=2 По таблицаПараметров.ВысотаТаблицы Цикл
				ОбластьПараметра = таблицаПараметров.Область(c,1,c,1);
				ОбластьЗначения  = таблицаПараметров.Область(c,i,c,i);
				Если ОбластьПараметра.СодержитЗначение И ЗначениеЗаполнено(ОбластьПараметра.Значение)
							И ОбластьЗначения.СодержитЗначение Тогда 
						СоответствиеПараметровИЗначений.Вставить(ОбластьПараметра.Значение, ОбластьЗначения.Значение);
				КонецЕсли;
			КонецЦикла;			
		КонецЕсли;	
	КонецЦикла;
	
	// заполнение значений параметров в модели XDTO из соответствия
	Для i=0 По массивXDTO.Количество()-1 Цикл
		массивПараметровXDTO=aps_СформироватьМассивПараметровИзМоделиXDTO(массивXDTO[i]);
		Для c=0 По массивПараметровXDTO.Количество()-1 Цикл
			Если СоответствиеПараметровИЗначений.Получить(массивПараметровXDTO[c].reference)<>Неопределено Тогда
				значениеПараметраИзТаблицы=СоответствиеПараметровИЗначений.Получить(массивПараметровXDTO[c].reference);
				массивПараметровXDTO[c].value=?(ЗначениеЗаполнено(значениеПараметраИзТаблицы), СериализаторXDTO.ЗаписатьXDTO(значениеПараметраИзТаблицы), Неопределено);
				Если массивПараметровXDTO[c].linkParameter=Истина Тогда 
					parentItemXDTO=массивXDTO[i].Владелец();
					Если parentItemXDTO<>Неопределено И parentItemXDTO.refLinkGroup Тогда 
						parentItemXDTO=parentItemXDTO.Владелец();
					КонецЕсли;
					
					Если parentItemXDTO<>Неопределено Тогда 
						parentItemXDTO.modified=Истина;
					КонецЕсли;
				Иначе 
					массивXDTO[i].modified=Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

#КонецЕсли


#Если Клиент Тогда 

// Процедура интерактивной параметризации по таблице
//
// Параметры:
//		item_xdto - xdto-модель изделия или технологии
//
Процедура aps_ИнтерактивнаяПараметризация( item_xdto ) Экспорт
	
	Состояние("Начат процесс параметризации...");
	
	массивXDTO=Новый Массив();
	соответствиеЭлементовИТаблиц=aps_ПолучитьТаблицыПараметровПоXDTOИСформироватьМассив( item_xdto, массивXDTO );
	
	Если соответствиеЭлементовИТаблиц.Количество()<>0 Тогда
		Форма=ПолучитьФорму("ФормаВыбораИзТаблицыПараметров");
		Для Каждого КиЗ Из соответствиеЭлементовИТаблиц Цикл
			локЭлементСсылка=КиЗ.Ключ;
			
			СтрокаТаблицыФормы=Форма.ЭлементыТаблицыПараметров.Добавить();
  			СтрокаТаблицыФормы.item=локЭлементСсылка;
			СтрокаТаблицыФормы.ИндексКартинки=?(локЭлементСсылка.ИндексКартинки=0, локЭлементСсылка.ВидЭлемента.ИндексКартинки, локЭлементСсылка.ИндексКартинки);
			СтрокаТаблицыФормы.КритерийТаблицыПараметров=aps_ПолучитьОсновнойКритерийТаблицыПараметров(КИЗ.Значение);
		КонецЦикла;
		Если Форма.ОткрытьМодально()=Истина Тогда
			Для Каждого СтрокаТаблицыФормы Из Форма.ЭлементыТаблицыПараметров Цикл
					aps_ПараметризацияXDTOПоТаблице(массивXDTO, СтрокаТаблицыФормы.item.ТаблицаПараметров.Получить(), СтрокаТаблицыФормы.КритерийТаблицыПараметров);
			КонецЦикла;
		КонецЕсли;
	Иначе
		Предупреждение(НСтр("ru = 'Таблицы параметров не найдены!'; en_US = 'Parameters table not found!'"));
	КонецЕсли;
КонецПроцедуры

#КонецЕсли

#КонецОбласти