#Если НЕ МобильноеПриложениеСервер Тогда

#Область ОбработчикиСобытийФормыНаСервере	
	
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ТекстЗапроса = "ВЫБРАТЬ
	               |	aps_СвойстваЭлементов.Ссылка КАК Ссылка,
	               |	aps_СвойстваЭлементов.Родитель КАК Родитель,
	               |	aps_СвойстваЭлементов.СвойствоЭлемента КАК Свойство,
	               |	aps_СвойстваЭлементов.Владелец КАК Владелец,
	               |	aps_СвойстваЭлементов.Представление КАК Представление,
	               |	aps_СвойстваЭлементов.Владелец.Наименование КАК ВладелецНаименование,
	               |	aps_СвойстваЭлементов.Владелец.ИндексКартинки КАК Картинка
	               |ИЗ
	               |	Справочник.aps_СвойстваЭлементов КАК aps_СвойстваЭлементов
	               |ГДЕ
	               |	aps_СвойстваЭлементов.Владелец ССЫЛКА Справочник.aps_ВидыЭлементов
	               |	И aps_СвойстваЭлементов.ЭтоГруппа = ЛОЖЬ
	               |	И aps_СвойстваЭлементов.Владелец.Служебный = ЛОЖЬ
				   |
				   |УПОРЯДОЧИТЬ ПО
	               |	ВладелецНаименование,
	               |	Родитель";
	ЗаполнитьДеревоСвойств(ТекстЗапроса, ДеревоСвойствЭлементов);
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	aps_СвойстваЭлементов.Ссылка КАК Ссылка,
	               |	aps_СвойстваЭлементов.Родитель КАК Родитель,
	               |	aps_СвойстваЭлементов.СвойствоЭлемента КАК Свойство,
	               |	aps_СвойстваЭлементов.Владелец КАК Владелец,
	               |	aps_СвойстваЭлементов.Представление КАК Представление,
	               |	aps_СвойстваЭлементов.Владелец.Наименование КАК ВладелецНаименование,
	               |	aps_СвойстваЭлементов.Владелец.ИндексКартинки КАК Картинка
	               |ИЗ
	               |	Справочник.aps_СвойстваЭлементов КАК aps_СвойстваЭлементов
	               |ГДЕ
	               |	aps_СвойстваЭлементов.Владелец ССЫЛКА Справочник.aps_ШаблоныТехнологическихСвязей
	               |	И aps_СвойстваЭлементов.ЭтоГруппа = ЛОЖЬ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ВладелецНаименование,
	               |	Родитель";
	ЗаполнитьДеревоСвойств(ТекстЗапроса, ДеревоСвойствСвязей);
	
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ
	               |	aps_Свойства.Ссылка КАК Свойство,
	               |	aps_Свойства.Родитель КАК Родитель,
	               |	aps_Свойства.Наименование КАК Представление,
	               |	aps_Свойства.ЭтоГруппа КАК ЭтоГруппа
	               |ИЗ
	               |	ПланВидовХарактеристик.aps_Свойства КАК aps_Свойства
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЭтоГруппа УБЫВ,
	               |	Родитель,
	               |	Представление";
	тзРезультаты = Запрос.Выполнить().Выгрузить();
	локДеревоПВХ = ДанныеФормыВЗначение(ДеревоПВХ, Тип("ДеревоЗначений"));
	ЗаполнитьДеревоПВХРек(тзРезультаты, ПланыВидовХарактеристик.aps_Свойства.ПустаяСсылка(), локДеревоПВХ.Строки);
	ЗначениеВДанныеФормы(локДеревоПВХ, ДеревоПВХ);
КонецПроцедуры

#КонецОбласти


#Область ПрочиеПроцедурыИФункцииНаСервере

&НаСервереБезКонтекста
Процедура ЗаполнитьДеревоПВХРек(ТаблицаПВХ, Родитель, СтрокиДерева)
	СтрокиСвойств = ТаблицаПВХ.НайтиСтроки(Новый Структура("Родитель", Родитель));
	Для Каждого Строка Из СтрокиСвойств Цикл
		СтрокаДерева = СтрокиДерева.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДерева, Строка);
		ЗаполнитьДеревоПВХРек(ТаблицаПВХ, СтрокаДерева.Свойство, СтрокаДерева.Строки);
	КонецЦикла;
КонецПроцедуры


&НаСервере
Функция ПоместитьДеревоВыбранныхСвойств()
	локДеревоСвойств = ДанныеФормыВЗначение(ДеревоСвойствСвязей, Тип("ДеревоЗначений"));
	ПолучитьДеревоВыбранныхРек(локДеревоСвойств.Строки);
	
	локДеревоСвойствЭлементов = ДанныеФормыВЗначение(ДеревоСвойствЭлементов, Тип("ДеревоЗначений"));
	ПолучитьДеревоВыбранныхРек(локДеревоСвойствЭлементов.Строки);
	ОбъединитьДваДереваРек(локДеревоСвойств.Строки, локДеревоСвойствЭлементов.Строки);
	
	локДеревоПВХ = ДанныеФормыВЗначение(ДеревоПВХ, Тип("ДеревоЗначений"));
	ВыбранныеСтрокиПВХ = локДеревоПВХ.Строки.НайтиСтроки(Новый Структура("Выбран", Истина), Истина);
	ОбъединитьДваДереваРек(локДеревоСвойств.Строки, ВыбранныеСтрокиПВХ);
	
	АдресДереваВыбранныхСвойств = ПоместитьВоВременноеХранилище(локДеревоСвойств);
	Возврат АдресДереваВыбранныхСвойств;
КонецФункции

&НаСервереБезКонтекста
Процедура ПолучитьДеревоВыбранныхРек(СтрокиДерева)
	КоличествоСтрок = СтрокиДерева.Количество();
	Для i = 0 По КоличествоСтрок - 1 Цикл
		rev_i = КоличествоСтрок - i - 1;
		Строка = СтрокиДерева[rev_i];
		Если Строка.Выбран = 0 Тогда
			СтрокиДерева.Удалить(rev_i);
		Иначе
			ПолучитьДеревоВыбранныхРек(Строка.Строки);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОбъединитьДваДереваРек(СтрокиПриемника, СтрокиИсточника)
	Для Каждого СтрокаИсточника Из СтрокиИсточника Цикл
		СтрокаПриемника = СтрокиПриемника.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаПриемника, СтрокаИсточника);
		ОбъединитьДваДереваРек(СтрокаПриемника.Строки, СтрокаИсточника.Строки);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоСвойств(ТекстЗапроса, ДеревоСвойств)
	локДеревоСвойств = ДанныеФормыВЗначение(ДеревоСвойств, Тип("ДеревоЗначений"));
	Запрос = Новый Запрос(ТекстЗапроса);
	тзРезультаты = Запрос.Выполнить().Выгрузить();
	
	СтрокиДерева = локДеревоСвойств.Строки;
	ТекущийВладелец = Неопределено;
	ТекущаяГруппа = Неопределено;
	СтрокаГруппы = Неопределено;
	СтрокаВладельца = Неопределено;
	Для Каждого СтрокаРезультата Из тзРезультаты Цикл
		Владелец = СтрокаРезультата.Владелец;
		Группа = СтрокаРезультата.Родитель;
		Если Владелец <> ТекущийВладелец Тогда 
			ТекущийВладелец = Владелец;
			СтрокаВладельца = СтрокиДерева.Добавить();
			СтрокаВладельца.Представление = Владелец.Наименование;
			СтрокаВладельца.ЭтоСтрокаВида = Истина;
			СтрокаВладельца.Картинка = СтрокаРезультата.Картинка;
			СтрокаВладельца.ВидЭлементаИлиСвязи = СтрокаРезультата.Владелец;
		КонецЕсли;
		Если Группа.Пустая() Тогда 
			СтрокаГруппы = СтрокаВладельца;
		ИначеЕсли Группа <> ТекущаяГруппа Тогда
			ТекущаяГруппа = Группа;
			СтрокаГруппы = СтрокаВладельца.Строки.Добавить();
			СтрокаГруппы.Представление = Группа.Наименование;
			СтрокаГруппы.ЭтоГруппа = Истина;
			СтрокаГруппы.Картинка = 2;
		КонецЕсли;
		
		СтрокаСвойства = СтрокаГруппы.Строки.Добавить();
		СтрокаСвойства.Представление = СтрокаРезультата.Представление;
		СтрокаСвойства.Свойство = СтрокаРезультата.Свойство;
	КонецЦикла;
	
	ЗначениеВДанныеФормы(локДеревоСвойств, ДеревоСвойств);
КонецПроцедуры

#КонецОбласти

#КонецЕсли

#Если НЕ МобильноеПриложениеКлиент Тогда

#Область ОбработчикиЭлементовФормы
	
&НаКлиенте
Процедура ДеревоСвойствВыбранПриИзменении(Элемент)
	ЭлементДеревоСвойств = Элемент.Родитель.Родитель; // ../группа формы/таблица формы
	ДеревоСвойств = ЭтаФорма[ЭлементДеревоСвойств.Имя];
	ТекущаяСтрока = ДеревоСвойств.НайтиПоИдентификатору(ЭлементДеревоСвойств.ТекущаяСтрока);
	Если ТекущаяСтрока.Выбран = 0 Тогда
		ТекущаяСтрока.Выбран = 1;
	КонецЕсли;
	Если ТекущаяСтрока.Выбран = 2 Тогда
		ТекущаяСтрока.Выбран = 0;
	КонецЕсли;
	УстановитьФлажкиВнизРек(ТекущаяСтрока.ПолучитьЭлементы(), ТекущаяСтрока.Выбран);
	УстановитьФлажкиВверхРек(ТекущаяСтрока.ПолучитьРодителя());	
КонецПроцедуры

&НаКлиенте 
Процедура УстановитьФлажкиВнизРек(ЭлементыДерева, ЗначениеФлажка)
	Для Каждого Элемент Из ЭлементыДерева Цикл
		Элемент.Выбран = ЗначениеФлажка;
		УстановитьФлажкиВнизРек(Элемент.ПолучитьЭлементы(), ЗначениеФлажка);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФлажкиВверхРек(ЭлементДерева)
	Если ЭлементДерева = Неопределено Тогда Возврат; КонецЕсли;
	
	ВсеЭлементыВыбраны = Истина;
	НетВыбранныхЭлементов = Истина;
	
	Для Каждого ПодчиненныйЭлемент Из ЭлементДерева.ПолучитьЭлементы() Цикл
		Если ПодчиненныйЭлемент.Выбран = 0 Тогда
			ВсеЭлементыВыбраны = Ложь;
		ИначеЕсли ПодчиненныйЭлемент.Выбран = 1 Тогда
			НетВыбранныхЭлементов = Ложь;
		Иначе
			ВсеЭлементыВыбраны = Ложь;
			НетВыбранныхЭлементов = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Если НетВыбранныхЭлементов Тогда
		ЭлементДерева.Выбран = 0;
	ИначеЕсли ВсеЭлементыВыбраны Тогда
		ЭлементДерева.Выбран = 1;
	Иначе
		ЭлементДерева.Выбран = 2;
	КонецЕсли;
	
	УстановитьФлажкиВверхРек(ЭлементДерева.ПолучитьРодителя());
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Готово(Команда)
	АдресДереваВыбранныхСвойств = ПоместитьДеревоВыбранныхСвойств();
	Закрыть(АдресДереваВыбранныхСвойств);
КонецПроцедуры

#КонецОбласти

#КонецЕсли
