#Если Не МобильноеПриложениеСервер Тогда

#Область ПрограммныйИнтерфейс	
	
// Процедура рассчитывает модель по программе
// Параметры:
//		МодельXDTO - объект XDTO, для которого будет выполнен расчет
//		ТекстПрограммы - Строка, текст расчета
//		МодельБлокаРасчета - объект XDTO блока расчета
// Пример:
//		aps_Рассчитать(МодельРодителя, СтрокаСписка.ТекстПрограммы, МодельБлокаРасчета);
//
Процедура aps_Рассчитать( МодельXDTO, Знач ТекстПрограммы, МодельБлокаРасчета=Неопределено ) Экспорт 
	ИдентификаторыРасчета = Справочники.aps_ИдентификаторыРасчета.Выбрать();
	Пока ИдентификаторыРасчета.Следующий() Цикл 
		Если ИдентификаторыРасчета.ЭтоГруппа ИЛИ ИдентификаторыРасчета.ПометкаУдаления Тогда 
			Продолжить;
		КонецЕсли;

		aps_ЗаменитьИдентификаторВПрограммеРасчета(ТекстПрограммы, ИдентификаторыРасчета.Идентификатор, ИдентификаторыРасчета.Лексема);
	КонецЦикла;
	
	Выполнить ТекстПрограммы;
КонецПроцедуры	

// Процедура заменяет идентификатор в тексте программы в соответствии с директивами
// Параметры:
//		ТекстПрограммы	- Строка
//		Идентификатор	- Строка, которую необходимо заменить в тексте программы
//		Лексема			- Строка, которой необходимо заменить идентификатор
// Пример:
//		aps_ЗаменитьИдентификаторВПрограммеРасчета(ТекстПрограммы, ИдентификаторыРасчета.Идентификатор, ИдентификаторыРасчета.Лексема);
//
Процедура aps_ЗаменитьИдентификаторВПрограммеРасчета( ТекстПрограммы, Знач Идентификатор, Знач Лексема ) Экспорт 
	
	Если ПустаяСтрока(Идентификатор) Или ПустаяСтрока(Лексема) Тогда 
		Возврат;
	КонецЕсли;
	
	КодСимвола_A = 65;
	СтрокаUUID = СтрЗаменить(Строка(Новый УникальныйИдентификатор()),"-","_");
	
	i = Найти(ТекстПрограммы, Идентификатор);
	Пока i > 0 Цикл 
		КодСимволаДо = КодСимвола(ТекстПрограммы,i-1);
		КодСимволаПосле = КодСимвола(ТекстПрограммы,i+СтрДлина(Идентификатор));
		Если КодСимволаДо < КодСимвола_A И КодСимволаПосле < КодСимвола_A Тогда 
			// заменить на лексему
			ТекстПрограммы = Лев(ТекстПрограммы,i-1)+Лексема+Сред(ТекстПрограммы,i+СтрДлина(Идентификатор));
		Иначе
			// заменить на уникальный идентификатор
			ТекстПрограммы = Лев(ТекстПрограммы,i-1)+СтрокаUUID+Сред(ТекстПрограммы,i+СтрДлина(Идентификатор));
		КонецЕсли;
		i = Найти(ТекстПрограммы, Идентификатор);
	КонецЦикла;
	
	ТекстПрограммы = СтрЗаменить(ТекстПрограммы, СтрокаUUID, Идентификатор);
	
КонецПроцедуры

// Процедура обновляет модель данных для группы расчета
// Параметры:
//		parentXDTOArray - массив моделей к обновлению
//		МодельОбъекта	- модель объекта, для которого будет выполняться группа расчета
// Пример:
//		aps_ОбновитьМодельГруппыРасчетаРек(МассивРодителей, МодельОбъекта);
//
Процедура aps_ОбновитьМодельГруппыРасчетаРек(parentXDTOArray, МодельОбъекта=Неопределено) Экспорт 
	Если parentXDTOArray.Количество() = 0 Тогда 
		Возврат;
	КонецЕсли;
	
	parentArray = Новый Массив;
	Для Каждого parentXDTO Из parentXDTOArray Цикл 
		parentArray.Добавить(parentXDTO.link);
	КонецЦикла;
	
	ЭлементныеСвязи = aps_Итераторы.aps_ЭлементныеСвязи(parentArray);
	childXDTOArray = Новый Массив;
	
	Для Каждого parentXDTO Из parentXDTOArray Цикл
		СтруктураОтбораСтрок = Новый Структура("РодительСсылка", parentXDTO.link);
		локЭлементныеСвязи = ЭлементныеСвязи.НайтиСтроки(СтруктураОтбораСтрок);
		
		Для Каждого СтрокаСвязи Из локЭлементныеСвязи Цикл
			Если МодельОбъекта <> Неопределено Тогда
				itemXDTO = aps_СоздатьМодельБлокаРасчета(СтрокаСвязи.ЭлементСсылка, МодельОбъекта);
			Иначе
				itemXDTO = aps_СоздатьОбъектМоделиXDTO(СтрокаСвязи.ЭлементСсылка);
			КонецЕсли;
			itemXDTO.link = СериализаторXDTO.ЗаписатьXDTO(СтрокаСвязи.ЭлементСвязи);
			parentXDTO.items.Добавить(itemXDTO);
			childXDTOArray.Добавить(itemXDTO);
		КонецЦикла;
		
		i = 0;
		Пока i < childXDTOArray.Количество() Цикл 
			otherParentXDTO = childXDTOArray[i].Владелец();
			УдалитьИзМассива=Ложь;
			Пока otherParentXDTO <> Неопределено Цикл 
				Если otherParentXDTO.link=childXDTOArray[i].link Тогда 
					УдалитьИзМассива=Истина;
					Прервать;
				КонецЕсли;
				otherParentXDTO=otherParentXDTO.Владелец();
			КонецЦикла;
			Если УдалитьИзМассива Тогда 
				childXDTOArray.Удалить(i);
			Иначе 
				i=i+1;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	aps_ОбновитьМодельГруппыРасчетаРек(childXDTOArray);
КонецПроцедуры

// Функция создает XDTO-модель группы расчета
// Параметры:
//		ГруппаРасчета - ссылка на группу расчета
//		МодельОбъекта - XDTO-модель объекта, для которого будет выполняться группа расчета
// Возвращаемое значение:
//		ОбъектXDTO
// Пример:
//		МодельГруппы = aps_ПолучитьМодельГруппыРасчета(item, МодельРодителя);
//
Функция aps_ПолучитьМодельГруппыРасчета(ГруппаРасчета, МодельОбъекта=Неопределено) Экспорт
	МодельГруппыРасчета = aps_СоздатьОбъектМоделиXDTO(ГруппаРасчета);
	МодельГруппыРасчета.pictureIndex = Справочники.aps_ВидыЭлементов.ГруппаРасчета.ИндексКартинки;
	aps_ЗаполнитьПредставлениеМоделиПоТабЧасти(МодельГруппыРасчета, ГруппаРасчета.ПредставлениеЭлемента);
	
	ЭлементныеСвязи = aps_Итераторы.aps_ЭлементныеСвязи(ГруппаРасчета);
	МассивРодителей = Новый Массив;
	
	Для Каждого СтрокаСвязи Из ЭлементныеСвязи Цикл
		БлокРасчета = СтрокаСвязи.ЭлементСсылка;
		Если МодельОбъекта <> Неопределено Тогда
			МодельБлокаРасчета = aps_СоздатьМодельБлокаРасчета(БлокРасчета, МодельОбъекта);
		Иначе
			МодельБлокаРасчета = aps_СоздатьОбъектМоделиXDTO(БлокРасчета);
		КонецЕсли;
		МодельБлокаРасчета.link = СериализаторXDTO.ЗаписатьXDTO(СтрокаСвязи.ЭлементСвязи);
		МодельГруппыРасчета.items.Добавить(МодельБлокаРасчета);
		МассивРодителей.Добавить(МодельБлокаРасчета);
	КонецЦикла;
	
	aps_ОбновитьМодельГруппыРасчетаРек(МассивРодителей, МодельОбъекта);
	
	Возврат МодельГруппыРасчета;
КонецФункции

// Функция рекурсивно формирует таблицу блоков расчета по порядку выполнения
// Параметры:
//		itemXDTOArray - массив XDTO-моделей блоков расчета
//		ТаблицаРасчета- ТаблицаЗначений, таблица, сформированная на предыдущих уровнях
// Возвращаемое значение:
//		ТаблицаЗначений
// Пример:
//		СписокБлоковСПовторами = aps_СформироватьСписокБлоковРасчетаРек(МодельГруппы.items);
//
Функция aps_СформироватьСписокБлоковРасчетаРек(itemXDTOArray, ТаблицаРасчета=Неопределено) Экспорт
	Если ТаблицаРасчета = Неопределено Тогда
		ТаблицаРасчета = Новый ТаблицаЗначений();
		ТаблицаРасчета.Колонки.Добавить("ЭлементСсылка");
		ТаблицаРасчета.Колонки.Добавить("ОбъектXDTO");
		ТаблицаРасчета.Колонки.Добавить("Рассчитан");
	КонецЕсли;

	Для Каждого itemXDTO Из itemXDTOArray Цикл 
		НоваяСтрока = ТаблицаРасчета.Добавить();
		НоваяСтрока.ЭлементСсылка = itemXDTO.element;
		НоваяСтрока.ОбъектXDTO = itemXDTO;
		НоваяСтрока.Рассчитан = Ложь;
		ТаблицаРасчета = aps_СформироватьСписокБлоковРасчетаРек(itemXDTO.items, ТаблицаРасчета);
	КонецЦикла;
	
	Возврат ТаблицаРасчета;
КонецФункции

// Функция рекурсивно выполняет замену переменных в тексте программы расчета
// Параметры:
//		ПараметрыБлокаРасчета 	- массив XDTO-параметров блока расчета
//		ТекстПрограммы			- текст программы, в котором будет произведена замена переменных
//		ИмяГруппы				- строка, имя группы параметров
// Пример:
//		ТекстПрограммы = aps_ЗаменитьПеременныеИОпределитьПараметрыРек(parameter.parameters, ТекстПрограммы, aps_УбратьПробелыИзСтроки(parameter.description + "."));
//
Функция aps_ЗаменитьПеременныеИОпределитьПараметрыРек(ПараметрыБлокаРасчета, ТекстПрограммы, ИмяГруппы="") Экспорт
	МассивМножественныхГрупп = Новый Массив;
	УбратьКомментарииИзТекста(ТекстПрограммы);
	
	Для Каждого parameter Из ПараметрыБлокаРасчета Цикл
		Если parameter.property = Неопределено Тогда // группа параметров
			Если parameter.reference.ВидЭлементаИлиСвязи <> Неопределено 
				И Найти(ТекстПрограммы, aps_УбратьПробелыИзСтроки(Строка(parameter.reference.ВидЭлементаИлиСвязи))+"[") > 0 Тогда //множественная группа параметров
				Если МассивМножественныхГрупп.Найти(parameter.reference) <> Неопределено Тогда
					// группа уже была обработана
					Продолжить;
				КонецЕсли;
				
				ИмяГруппыПараметров = aps_УбратьПробелыИзСтроки(Строка(parameter.reference.ВидЭлементаИлиСвязи));
				СоответствиеИменПараметров = Новый Соответствие;
				// получить полный список параметров из базы
				БлокРасчетаСсылка = parameter.Владелец().element;
				Для Каждого СтрокаПараметра Из БлокРасчетаСсылка.Параметры Цикл
					Если СтрокаПараметра.Параметр.Родитель = parameter.reference Тогда
						СоответствиеИменПараметров.Вставить(СтрокаПараметра.Параметр.Наименование, aps_УбратьНеБуквыИНеЦифры(СтрокаПараметра.Параметр.Наименование));
					КонецЕсли;
				КонецЦикла;
				
				СтрокаGUID = Строка(parameter.reference.УникальныйИдентификатор());
			    ТекстИнициализации = ИмяГруппыПараметров + " = aps_ПолучитьМассивГруппПараметровПоСсылке(МодельБлокаРасчета, Справочники.aps_ПараметрыЭлементовТехнологии.ПолучитьСсылку(Новый УникальныйИдентификатор(""" + СтрокаGUID + """)));";
				НовыйТекстПрограммы = "";
				
				ИндексВхождения = Найти(ТекстПрограммы, ИмяГруппыПараметров + "[");
				Пока ИндексВхождения > 0 Цикл
					СимволДоПеременной = Сред(ТекстПрограммы, ИндексВхождения-1, 1);
					Если СимволДоПеременной = "_" 
						ИЛИ СимволДоПеременной = "."
						ИЛИ aps_ЭтоБуква(СимволДоПеременной) И НЕ ИндексВхождения = 1 //т.к. если индекс=1, то за символ до переменной принимается первый символ переменной
						ИЛИ aps_ЭтоЦифра(СимволДоПеременной) И НЕ ИндексВхождения = 1 Тогда
						НовыйТекстПрограммы = НовыйТекстПрограммы + Лев(ТекстПрограммы, ИндексВхождения + СтрДлина(ИмяГруппыПараметров));
						ТекстПрограммы = Сред(ТекстПрограммы, ИндексВхождения + СтрДлина(ИмяГруппыПараметров) + 1);
						ИндексВхождения = Найти(ТекстПрограммы, ИмяГруппыПараметров + "[");
						Продолжить;
					КонецЕсли;
					
					НовыйТекстПрограммы = НовыйТекстПрограммы + Лев(ТекстПрограммы, ИндексВхождения - 1);
					ТекстПрограммы = Сред(ТекстПрограммы, ИндексВхождения);
					ИндексСкобки = Найти(ТекстПрограммы, "].");
					
					// поиск в тексте программы параметра с исключением входимости имен одних параметров в другие
					ПредыдущйПараметрУдовлетворяющийУсловию = Неопределено;
 					Для Каждого СтрокаИмяПараметра Из СоответствиеИменПараметров Цикл
						Если (Найти(ТекстПрограммы, СтрокаИмяПараметра.Значение) = ИндексСкобки + 2) и ((ПредыдущйПараметрУдовлетворяющийУсловию = Неопределено) или (СтрДлина(СтрокаИмяПараметра.Значение) > СтрДлина(ПредыдущйПараметрУдовлетворяющийУсловию.Значение))) Тогда //СтрДлина("].")=2
							ПредыдущйПараметрУдовлетворяющийУсловию = СтрокаИмяПараметра;
						КонецЕсли;
					КонецЦикла;
					Если ПредыдущйПараметрУдовлетворяющийУсловию <> "" Тогда
						ТекстПрограммы = "aps_НайтиПараметрПоИмениВГруппеXDTO(" + Лев(ТекстПрограммы, ИндексСкобки) + ", """ + ПредыдущйПараметрУдовлетворяющийУсловию.Ключ + """).value" + Сред(ТекстПрограммы, ИндексСкобки + 2 + СтрДлина(ПредыдущйПараметрУдовлетворяющийУсловию.Значение));
					КонецЕсли;	
					ИндексТочкиСЗапятой = Найти(ТекстПрограммы, ";");
					ТекстСтрокиПрограммы = Лев(ТекстПрограммы, ИндексТочкиСЗапятой - 1);
					
					// проверка на наличие условий //
					Если Найти(НРег(ТекстСтрокиПрограммы), "тогда") > 0 Тогда
						ТекстСтрокиПрограммы = Лев(ТекстСтрокиПрограммы, Найти(НРег(ТекстСтрокиПрограммы), "тогда") + СтрДлина("тогда"));
						ИндексЗнакаРавно = 0;
					ИначеЕсли Найти(НРег(ТекстСтрокиПрограммы), "цикл") > 0 Тогда
						ТекстСтрокиПрограммы = Лев(ТекстСтрокиПрограммы, Найти(НРег(ТекстСтрокиПрограммы), "цикл") + СтрДлина("цикл"));
						ИндексЗнакаРавно = 0;
					Иначе
						ИндексЗнакаРавно = Найти(ТекстСтрокиПрограммы, "=");
					КонецЕсли;
					/////////////////////////////////
					
					Если ИндексЗнакаРавно > 0 Тогда
						ВыражениеЗначенияПараметра = СокрЛП(Сред(ТекстСтрокиПрограммы, ИндексЗнакаРавно + 1));
						Если ВыражениеЗначенияПараметра <> "Неопределено" Тогда
							НовыйТекстСтрокиПрограммы = СтрЗаменить(ТекстСтрокиПрограммы, ВыражениеЗначенияПараметра, "СериализаторXDTO.ЗаписатьXDTO(" + ВыражениеЗначенияПараметра + ")");
						Иначе
							НовыйТекстСтрокиПрограммы = ТекстСтрокиПрограммы;
						КонецЕсли;
					Иначе
						НовыйТекстСтрокиПрограммы = ТекстСтрокиПрограммы;
					КонецЕсли;
					
					ТекстПрограммы = СтрЗаменить(ТекстПрограммы, ТекстСтрокиПрограммы, НовыйТекстСтрокиПрограммы);
					
					ИндексВхождения = Найти(Сред(ТекстПрограммы, СтрДлина("aps_НайтиПараметрПоИмениВГруппеXDTO(") + СтрДлина(ИмяГруппыПараметров) + 2), ИмяГруппыПараметров + "[");					
					Если ИндексВхождения > 0 Тогда
						ИндексВхождения = ИндексВхождения + СтрДлина("aps_НайтиПараметрПоИмениВГруппеXDTO(") + СтрДлина(ИмяГруппыПараметров) + 1; //т.к. искали в отрезке текста программы
					КонецЕсли;
				КонецЦикла;
				ТекстПрограммы = ТекстИнициализации + Символы.ПС + НовыйТекстПрограммы + ТекстПрограммы;
				
				МассивМножественныхГрупп.Добавить(parameter.reference);
				
			Иначе // обычная группа параметров
				ТекстПрограммы = aps_ЗаменитьПеременныеИОпределитьПараметрыРек(parameter.parameters, ТекстПрограммы, aps_УбратьПробелыИзСтроки(parameter.description + "."));
			КонецЕсли;	
			
		Иначе // параметр
			ИмяПеременной = ИмяГруппы + aps_УбратьПробелыИзСтроки(parameter.description);
			ИмяПеременнойПараметра = "Параметр_" + aps_УбратьНеБуквыИНеЦифры(СтрЗаменить(ИмяПеременной, ".", ""));
			СтрокаGUID = Строка(parameter.reference.УникальныйИдентификатор());
			ТекстИнициализации = ИмяПеременнойПараметра + " = МодульСозданияПараметров.aps_ВспомНайтиПараметрПоСсылкеВXDTO(МодельБлокаРасчета, Справочники."+parameter.reference.Метаданные().Имя+".ПолучитьСсылку(Новый УникальныйИдентификатор("""+СтрокаGUID+""")));";
			НовыйТекстПрограммы = "";
			
			ИндексВхождения = Найти(ТекстПрограммы, ИмяПеременной);
			Если ИндексВхождения > 0 Тогда
				Пока ИндексВхождения > 0 Цикл
					СимволДоПеременной = Сред(ТекстПрограммы, ИндексВхождения-1, 1);
					СимволПослеПеременной = Сред(ТекстПрограммы, ИндексВхождения+СтрДлина(ИмяПеременной), 1);
					Если СимволДоПеременной = "_" 
						ИЛИ СимволДоПеременной = "."
						ИЛИ aps_ЭтоБуква(СимволДоПеременной) И НЕ ИндексВхождения = 1 // т.к. если индекс=1, то за символ до переменной принимается первый символ переменной
						ИЛИ aps_ЭтоЦифра(СимволДоПеременной) И НЕ ИндексВхождения = 1 
						ИЛИ aps_ЭтоБуква(СимволПослеПеременной) 
						ИЛИ aps_ЭтоЦифра(СимволПослеПеременной) Тогда
						НовыйТекстПрограммы = НовыйТекстПрограммы + Лев(ТекстПрограммы, ИндексВхождения + СтрДлина(ИмяПеременной) - 1);
						ТекстПрограммы = Сред(ТекстПрограммы, ИндексВхождения + СтрДлина(ИмяПеременной));
						ИндексВхождения = Найти(ТекстПрограммы, ИмяПеременной);
						Продолжить;
					КонецЕсли;
					
					НовыйТекстПрограммы = НовыйТекстПрограммы + Лев(ТекстПрограммы, ИндексВхождения - 1);
					ТекстПрограммы = Сред(ТекстПрограммы, ИндексВхождения);
					ИндексТочкиСЗапятой = Найти(ТекстПрограммы, ";");
					ТекстСтрокиПрограммы = Лев(ТекстПрограммы, ИндексТочкиСЗапятой - 1);
					
					// проверка на наличие условий //
					Если Найти(НРег(ТекстСтрокиПрограммы), "тогда") > 0 Тогда
						ТекстСтрокиПрограммы = Лев(ТекстСтрокиПрограммы, Найти(НРег(ТекстСтрокиПрограммы), "тогда") + СтрДлина("тогда"));
						ИндексЗнакаРавно = 0;
					ИначеЕсли Найти(НРег(ТекстСтрокиПрограммы), "цикл") > 0 Тогда
						ТекстСтрокиПрограммы = Лев(ТекстСтрокиПрограммы, Найти(НРег(ТекстСтрокиПрограммы), "цикл") + СтрДлина("цикл"));
						ИндексЗнакаРавно = 0;
					Иначе
						ИндексЗнакаРавно = Найти(ТекстСтрокиПрограммы, "=");
					КонецЕсли;
					/////////////////////////////////
					
					Если ИндексЗнакаРавно > 0 Тогда
						ВыражениеЗначенияПараметра = СокрЛП(Сред(ТекстСтрокиПрограммы, ИндексЗнакаРавно + 1));
						Если ВыражениеЗначенияПараметра <> "Неопределено" Тогда
							НовыйТекстСтрокиПрограммы = СтрЗаменить(ТекстСтрокиПрограммы, ВыражениеЗначенияПараметра, "СериализаторXDTO.ЗаписатьXDTO(" + ВыражениеЗначенияПараметра + ")");
						Иначе
							НовыйТекстСтрокиПрограммы = ТекстСтрокиПрограммы;
						КонецЕсли;
					Иначе
						НовыйТекстСтрокиПрограммы = ТекстСтрокиПрограммы;
					КонецЕсли;
					
					НовыйТекстСтрокиПрограммы = ИмяПеременнойПараметра + ".value" + Сред(НовыйТекстСтрокиПрограммы, СтрДлина(ИмяПеременной)+1);
					ТекстПрограммы = СтрЗаменить(ТекстПрограммы, ТекстСтрокиПрограммы, НовыйТекстСтрокиПрограммы);
					
					ИндексВхождения = Найти(Сред(ТекстПрограммы, СтрДлина(ИмяПеременнойПараметра + ".value") + 1), ИмяПеременной);	
					Если ИндексВхождения > 0 Тогда 
						ИндексВхождения = ИндексВхождения + СтрДлина(ИмяПеременнойПараметра + ".value");
					КонецЕсли;
				КонецЦикла;
				ТекстПрограммы = ТекстИнициализации + Символы.ПС + НовыйТекстПрограммы + ТекстПрограммы; 
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТекстПрограммы;
КонецФункции


// Процедура заполняет значения параметров объекта XDTO по дереву параметров
// Параметры:
//		itemXDTO - ОбъектXDTO
//		ДеревоПараметров - дерево значений
// Пример:
//		aps_ЗаполнитьПараметрыВXDTOПоДереву(МодельБлокаРасчета, ДеревоПараметров);
//
Процедура aps_ЗаполнитьПараметрыВXDTOПоДереву(itemXDTO, ДеревоПараметров) Экспорт
	СтрокиДереваПараметров = ДеревоПараметров.Строки;
	МассивПараметровXDTO = aps_СформироватьМассивПараметровИзМоделиXDTO(itemXDTO);
	Для Каждого parameter Из МассивПараметровXDTO Цикл
		Если parameter.property <> Неопределено Тогда // не группа
			СтрокиПараметра = СтрокиДереваПараметров.НайтиСтроки(Новый Структура("Ссылка", parameter.reference),  Истина);
			Для инд = 0 по СтрокиПараметра.количество() - 1 Цикл
				Если (СтрокиПараметра[инд] <> Неопределено) Тогда
					Попытка     // сгруппированные параметры
						Если (parameter.Владелец().value = СтрокиПараметра[инд].Родитель.Значение) Тогда
							parameter.value = ?(СтрокиПараметра[инд].Значение <> Неопределено, СериализаторXDTO.ЗаписатьXDTO(СтрокиПараметра[инд].Значение), Неопределено);
							parameter.unit = ?(СтрокиПараметра[инд].ЕдиницаИзмерения <> Неопределено, СериализаторXDTO.ЗаписатьXDTO(СтрокиПараметра[инд].ЕдиницаИзмерения), Неопределено);
						КонецЕсли;
					Исключение  // параметры без группы
						parameter.value = ?(СтрокиПараметра[инд].Значение <> Неопределено, СериализаторXDTO.ЗаписатьXDTO(СтрокиПараметра[инд].Значение), Неопределено);
						parameter.unit = ?(СтрокиПараметра[инд].ЕдиницаИзмерения <> Неопределено, СериализаторXDTO.ЗаписатьXDTO(СтрокиПараметра[инд].ЕдиницаИзмерения), Неопределено);
					КонецПопытки;	
				КонецЕсли;	
			КонецЦикла;	
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Процедура заполняет значения параметров в дереве значений по объекту XDTO
// Параметры:
//		ДеревоПараметров - дерево значений
//		itemXDTO - ОбъектXDTO
// Пример:
//		aps_ЗаполнитьПараметрыВДеревеПоXDTO(ДеревоПараметров, МодельБлокаРасчета);
//
Процедура aps_ЗаполнитьПараметрыВДеревеПоXDTO(ДеревоПараметров, itemXDTO) Экспорт
	СтрокиДереваПараметров = ДеревоПараметров.Строки;
	МассивПараметровXDTO = aps_СформироватьМассивПараметровИзМоделиXDTO(itemXDTO);
	Для Каждого parameter Из МассивПараметровXDTO Цикл
		Если parameter.property <> Неопределено Тогда // не группа
			СтрокиПараметра = СтрокиДереваПараметров.НайтиСтроки(Новый Структура("Ссылка", parameter.reference),  Истина);
			Для инд = 0 по СтрокиПараметра.количество() - 1 Цикл
				Если (СтрокиПараметра[инд] <> Неопределено) Тогда
					Попытка     // сгруппированные параметры
						Если (parameter.Владелец().value = СтрокиПараметра[инд].Родитель.Значение) Тогда
							СтрокиПараметра[инд].Значение = ?(parameter.value <> Неопределено, parameter.value, ?(ЗначениеЗаполнено(СтрокиПараметра[инд].Свойство.ТипЗначения), СтрокиПараметра[инд].Свойство.ТипЗначения.ПривестиЗначение(), Неопределено));
							СтрокиПараметра[инд].ЕдиницаИзмерения = parameter.unit;
							
							// если составной тип
							Если СтрокиПараметра[инд].Значение = Неопределено 
									И ЗначениеЗаполнено(СтрокиПараметра[инд].Свойство.ТипЗначения)
									И СтрокиПараметра[инд].Свойство.ТипЗначения.СодержитТип(Тип("Число")) Тогда
								СтрокиПараметра[инд].Значение = 0;	
							КонецЕсли;
						КонецЕсли;
					Исключение  // параметры без группы
						СтрокиПараметра[инд].Значение = ?(parameter.value <> Неопределено, parameter.value, ?(ЗначениеЗаполнено(СтрокиПараметра[инд].Свойство.ТипЗначения), СтрокиПараметра[инд].Свойство.ТипЗначения.ПривестиЗначение(), Неопределено));
						СтрокиПараметра[инд].ЕдиницаИзмерения = parameter.unit;
						
						// если составной тип
						Если СтрокиПараметра[инд].Значение = Неопределено 
								И ЗначениеЗаполнено(СтрокиПараметра[инд].Свойство.ТипЗначения)
								И СтрокиПараметра[инд].Свойство.ТипЗначения.СодержитТип(Тип("Число")) Тогда
							СтрокиПараметра[инд].Значение = 0;	
						КонецЕсли;
					КонецПопытки;	
				КонецЕсли;	
			КонецЦикла;	
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Процедура заполняет значения параметров модели XDTO по другой модели XDTO
// Параметры:
//		receiverParameters	- CписокXDTO, параметры модели-приемника
//		sourceParameters	- CписокXDTO, параметры модели-источника
// Пример:
//		aps_ЗаполнитьПараметрыВXDTOПоXDTO(parentXDTO.parameters, МодельБлокаРасчета.parameters);
//
Процедура aps_ЗаполнитьПараметрыВXDTOПоXDTO(receiverParameters, sourceParameters) Экспорт
	receiverParameterArray = aps_СформироватьМассивПараметровИзМоделиXDTO(receiverParameters.Владелец); 
	
	Для Каждого sourceParameterGroup Из sourceParameters Цикл
		ГруппаПараметров = sourceParameterGroup.reference;
		Если ГруппаПараметров.ЭтоГруппа И ЗначениеЗаполнено(ГруппаПараметров.ВидЭлементаИлиСвязи) Тогда
			receiverParameterGroup = Неопределено;
			// группы по видам элементов или связей совпадают для всех блоков расчета (наследуются)
			Для Каждого receiverParameter Из receiverParameters Цикл
				Если receiverParameter.reference = ГруппаПараметров Тогда
					receiverParameterGroup = receiverParameter;
				КонецЕсли;
			КонецЦикла;
			Если receiverParameterGroup = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Для Каждого sourceParameter Из sourceParameterGroup.parameters Цикл
				Свойство = sourceParameter.property;
				Для Каждого receiverParameter Из receiverParameterGroup.parameters Цикл
					Если receiverParameter.property = Свойство Тогда 
						receiverParameter.value = ?(ЗначениеЗаполнено(sourceParameter.value), СериализаторXDTO.ЗаписатьXDTO(sourceParameter.value), ?(ЗначениеЗаполнено(sourceParameter.property.ТипЗначения), sourceParameter.property.ТипЗначения.ПривестиЗначение(), Неопределено));
						receiverParameter.unit = ?(ЗначениеЗаполнено(sourceParameter.unit), СериализаторXDTO.ЗаписатьXDTO(sourceParameter.unit), Неопределено);
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
			
		Иначе
			Если НЕ ГруппаПараметров.ЭтоГруппа Тогда
				sourceParameter = sourceParameterGroup;
				МассивПараметров = Новый Массив;
				МассивПараметров.Добавить(sourceParameter);
				sourceParameterGroup = Новый Структура("parameters", МассивПараметров);
			КонецЕсли;
				
			Для Каждого sourceParameter Из sourceParameterGroup.parameters Цикл
				Для Каждого receiverParameter Из receiverParameterArray Цикл
					Родитель = receiverParameter.reference.Родитель;
					Если receiverParameter.property = sourceParameter.property
							И (НЕ ЗначениеЗаполнено(Родитель) ИЛИ НЕ ЗначениеЗаполнено(Родитель.ВидЭлементаИлиСвязи)) Тогда
						receiverParameter.value = ?(ЗначениеЗаполнено(sourceParameter.value), СериализаторXDTO.ЗаписатьXDTO(sourceParameter.value), ?(ЗначениеЗаполнено(sourceParameter.property.ТипЗначения), sourceParameter.property.ТипЗначения.ПривестиЗначение(), Неопределено));
						receiverParameter.unit = ?(ЗначениеЗаполнено(sourceParameter.unit), СериализаторXDTO.ЗаписатьXDTO(sourceParameter.unit), Неопределено);
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
			
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры	

// Процедура заполняет значения параметров модели блока расчета по модели объекта, для которого выполняется расчет
// Параметры:
//		МодельБлокаРасчета	- ОбъектXDTO, модель блока расчета
//		МодельОбъекта		- ОбъектXDTO, модель объекта
// Пример:
//		aps_ЗаполнитьПараметрыМоделиБлокаПоМоделиОбъекта(МодельБлокаРасчета, МодельРодителя);
//
Процедура aps_ЗаполнитьПараметрыМоделиБлокаПоМоделиОбъекта(МодельБлокаРасчета, МодельОбъекта) Экспорт
	МассивПараметровXDTO = aps_СформироватьМассивПараметровИзМоделиXDTO(МодельБлокаРасчета);
	Для Каждого ПараметрXDTO Из МассивПараметровXDTO Цикл
		Если ПараметрXDTO.property = Неопределено Тогда 
			Продолжить;
		КонецЕсли;
		ПараметрМоделиОбъекта = aps_НайтиПараметрПоСсылкеВXDTOРек(МодельОбъекта, ПараметрXDTO.reference);
		Если ПараметрМоделиОбъекта <> Неопределено Тогда
			ПараметрXDTO.value = ?(ПараметрМоделиОбъекта.value <> Неопределено, СериализаторXDTO.ЗаписатьXDTO(ПараметрМоделиОбъекта.value), Неопределено);
			ПараметрXDTO.unit = ?(ПараметрМоделиОбъекта.unit <> Неопределено, СериализаторXDTO.ЗаписатьXDTO(ПараметрМоделиОбъекта.unit), Неопределено);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Процедура заполняет значения параметров модели объекта, для которого выполняется расчет, по модели блока расчета
// Параметры:
//		МодельОбъекта		- ОбъектXDTO, модель объекта
//		МодельБлокаРасчета	- ОбъектXDTO, модель блока расчета
// Пример:
//		aps_ЗаполнитьПараметрыМоделиОбъектаПоМоделиБлока(МодельРодителя, МодельБлокаРасчета);
//
Процедура aps_ЗаполнитьПараметрыМоделиОбъектаПоМоделиБлока(МодельОбъекта, МодельБлокаРасчета) Экспорт
	МассивПараметровXDTO = aps_СформироватьМассивПараметровИзМоделиXDTO(МодельБлокаРасчета);
	
	Для Каждого ПараметрXDTO Из МассивПараметровXDTO Цикл
		Если ПараметрXDTO.property = Неопределено Тогда 
			Продолжить;
		КонецЕсли;
		ПараметрМоделиОбъекта = aps_НайтиПараметрПоСсылкеВXDTOРек(МодельОбъекта, ПараметрXDTO.reference);
		Если ПараметрМоделиОбъекта <> Неопределено 
			И (ПараметрМоделиОбъекта.value <> ПараметрXDTO.value
			ИЛИ ПараметрМоделиОбъекта.unit <> ПараметрXDTO.unit) Тогда
			ПараметрМоделиОбъекта.value = ?(ПараметрXDTO.value <> Неопределено, СериализаторXDTO.ЗаписатьXDTO(ПараметрXDTO.value), Неопределено);
			ПараметрМоделиОбъекта.unit = ?(ПараметрXDTO.unit <> Неопределено, СериализаторXDTO.ЗаписатьXDTO(ПараметрXDTO.unit), Неопределено);
			
			// установить флаг модифицированности в модели
			itemXDTO = ПараметрМоделиОбъекта.Владелец();
			Если itemXDTO.Тип().Имя = "parameter" Тогда
				itemXDTO = itemXDTO.Владелец();
			КонецЕсли;
			Если ПараметрМоделиОбъекта.linkParameter=Истина Тогда
				parentItemXDTO = itemXDTO.Владелец();
				parentItemXDTO = ?(parentItemXDTO<>Неопределено И parentItemXDTO.refLinkGroup, parentItemXDTO.Владелец(), parentItemXDTO);
	
				Если parentItemXDTO<>Неопределено Тогда 
					parentItemXDTO.modified = Истина;
				КонецЕсли;
			Иначе 
				itemXDTO.modified = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Процедура рекурсивно обновлет флажки входных параметров расчета
// Параметры:
//		СтрокиДереваПараметров  - КоллекцияСтрокДереваЗначений
//		ТекстСпискаПеременных	- строка, список переменных расчета
//		ИмяГруппы				- строка, имя группы параметров
// Пример:
//		aps_ОбновитьФлажкиВходныхПараметровРек(СтрокаДерева.Строки, ТекстСпискаПеременных, локИмяГруппы);
//
Процедура aps_ОбновитьФлажкиВходныхПараметровРек(СтрокиДереваПараметров, ТекстСпискаПеременных, ИмяГруппы="") Экспорт
	Для Каждого СтрокаДерева Из СтрокиДереваПараметров Цикл
		Если СтрокаДерева.ЭтоГруппа Тогда
			локИмяГруппы = aps_УбратьПробелыИзСтроки(СтрокаДерева.Имя);
			Если Найти(ТекстСпискаПеременных, локИмяГруппы + "[i]") > 0 Тогда
				СтрокаДерева.Множественный = Истина;
				локИмяГруппы = локИмяГруппы + "[i].";
			Иначе
				локИмяГруппы = локИмяГруппы + ".";
			КонецЕсли;
			
			aps_ОбновитьФлажкиВходныхПараметровРек(СтрокаДерева.Строки, ТекстСпискаПеременных, локИмяГруппы);
		Иначе
			ИмяПеременной = ИмяГруппы + aps_УбратьПробелыИзСтроки(СтрокаДерева.Имя);
			ИндексВхождения = Найти(ТекстСпискаПеременных, ИмяПеременной);
			локТекстСписка = ТекстСпискаПеременных;
			Если ИндексВхождения > 0 Тогда
				Пока ИндексВхождения > 0 Цикл
					СимволДоПеременной = Сред(локТекстСписка, ИндексВхождения-1, 1);
					СимволПослеПеременной = Сред(локТекстСписка, ИндексВхождения+СтрДлина(ИмяПеременной), 1);
					Если СимволДоПеременной = "."
						ИЛИ aps_ЭтоБуква(СимволДоПеременной) 
						ИЛИ aps_ЭтоЦифра(СимволДоПеременной) 
						ИЛИ aps_ЭтоБуква(СимволПослеПеременной) 
						ИЛИ aps_ЭтоЦифра(СимволПослеПеременной) Тогда
						локТекстСписка = Сред(локТекстСписка, ИндексВхождения + СтрДлина(ИмяПеременной));
						ИндексВхождения = Найти(локТекстСписка, ИмяПеременной);
					Иначе
						локТекстСписка = Сред(локТекстСписка, ИндексВхождения);
						ИндексТочкиСЗапятой = Найти(локТекстСписка, ";");
						локТекстСписка = ?(ИндексТочкиСЗапятой > 0, Лев(локТекстСписка, ИндексТочкиСЗапятой), локТекстСписка);
						СтрокаДерева.Расчетный = (Найти(локТекстСписка, "output")>0);
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Процедура обновляет список переменных в тексте программы по дереву параметров
// Параметры:
//		ТекстПрограммы	 - строка
//		ДеревоПараметров - ДеревоЗначений
// Пример:
//		aps_ОбновитьСписокПеременныхВТекстеПрограммы(локТекстПрограммы, ДеревоПараметров);
Процедура aps_ОбновитьСписокПеременныхВТекстеПрограммы(ТекстПрограммы, ДеревоПараметров) Экспорт 
	НачалоСпискаПеременных = Найти(ТекстПрограммы, "APPIUS_BEGIN");
	КонецСпискаПеременных = Найти(ТекстПрограммы, "APPIUS_END");
	
	// сформировать новый список переменных
	ТекстСпискаПеременных = "APPIUS_BEGIN" + Символы.ПС + НСтр("ru = '// Доступные переменные:'; en_US = '// Variables:'");
	
	Для Каждого СтрокаДерева Из ДеревоПараметров.Строки Цикл
		Если СтрокаДерева.ЭтоГруппа Тогда
			ИмяГруппы = aps_УбратьПробелыИзСтроки(СтрокаДерева.Имя);
			Для Каждого СтрокаПараметра Из СтрокаДерева.Строки Цикл
				ИмяПеременной = ИмяГруппы + ?(СтрокаДерева.Множественный, "[i]", "") + "." + aps_УбратьПробелыИзСтроки(СтрокаПараметра.Имя);
				ТипЗначения = Строка(СтрокаПараметра.Свойство.ТипЗначения);
				ТекстСпискаПеременных = ТекстСпискаПеременных + Символы.ПС + "// " + ИмяПеременной + " (" + ТипЗначения + ")";
				Если СтрокаПараметра.Расчетный Тогда
					ТекстСпискаПеременных = ТекстСпискаПеременных + " output";
				КонецЕсли;
				ТекстСпискаПеременных = ТекстСпискаПеременных + ";";
			КонецЦикла;
		Иначе
			ИмяПеременной = aps_УбратьНеБуквыИНеЦифры(СтрокаДерева.Имя);
			ТипЗначения = Строка(СтрокаДерева.Свойство.ТипЗначения);
			ТекстСпискаПеременных = ТекстСпискаПеременных + Символы.ПС + "// " + ИмяПеременной + " (" + ТипЗначения + ")";
			Если СтрокаДерева.Расчетный Тогда
				ТекстСпискаПеременных = ТекстСпискаПеременных + " output";
			КонецЕсли;
			ТекстСпискаПеременных = ТекстСпискаПеременных + ";";
		КонецЕсли;
	КонецЦикла;
	ТекстСпискаПеременных = ТекстСпискаПеременных + Символы.ПС + "//APPIUS_END";
	
	Если НачалоСпискаПеременных = 0 Тогда
		ТекстПрограммы = "//" + ТекстСпискаПеременных + Символы.ПС + ТекстПрограммы;
	Иначе
		ТекстПрограммы = Лев(ТекстПрограммы, НачалоСпискаПеременных - 1) + ТекстСпискаПеременных + Сред(ТекстПрограммы, КонецСпискаПеременных + СтрДлина("APPIUS_END"));
	КонецЕсли;	
	
	Модифицированность = Истина;	
КонецПроцедуры

// Функция создает XDTO-модель блока расчета
// Параметры:
//		БлокРасчета - ссылка на блок расчета
//		МодельОбъекта - ОбъектXDTO, модель объекта, для которого будет выполняться расчет
// Возвращаемое значение:
//		ОбъектXDTO
// Пример:
//		itemXDTO = aps_СоздатьМодельБлокаРасчета(СтрокаСвязи.ЭлементСсылка, МодельОбъекта);
//
Функция aps_СоздатьМодельБлокаРасчета(БлокРасчета, МодельОбъекта) Экспорт
	МодельБлокаРасчета = aps_СоздатьОбъектМоделиXDTO(БлокРасчета);
	ТекстПрограммы = БлокРасчета.ПрограммаРасчета;
	
	МассивXDTO = aps_СформироватьМассивИзМоделиXDTO(МодельОбъекта);
	СоответствиеОбъектовИПараметров = Новый Соответствие();
	Для Каждого itemXDTO Из МассивXDTO Цикл
		СоответствиеОбъектовИПараметров.Вставить(itemXDTO, aps_СформироватьМассивПараметровИзМоделиXDTO(itemXDTO));
	КонецЦикла;
	
	СоответствиеВидовЭлементовИВидовСвязей = Новый Соответствие;
	Для Каждого parameter Из МодельБлокаРасчета.parameters Цикл
		Если parameter.property = Неопределено Тогда // группа параметров
			ВидСвязи = parameter.reference.ВидЭлементаИлиСвязи;
			Если ЗначениеЗаполнено(ВидСвязи)
					И ТипЗнч(ВидСвязи) = Тип("СправочникСсылка.aps_ШаблоныТехнологическихСвязей") Тогда
				Для Каждого СтрокаВидаЭлемента Из ВидСвязи.ПодчиненныеВидыЭлементов Цикл
					СоответствиеВидовЭлементовИВидовСвязей.Вставить(СтрокаВидаЭлемента.ВидЭлемента, ВидСвязи);
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	МассивГруппКУдалению = Новый Массив();
	МассивНовыхГруппПараметров = Новый Массив();
	
	ПараметрыБлокаРасчета = МодельБлокаРасчета.parameters;
	Для Каждого parameterGroup Из ПараметрыБлокаРасчета Цикл
		ВидЭлементаИлиСвязи = parameterGroup.reference.ВидЭлементаИлиСвязи;
		Если parameterGroup.value <> Неопределено
			ИЛИ ВидЭлементаИлиСвязи = Неопределено Тогда 
			// параметры, не привязанные к виду элемента или связи, остаются без изменений
			Продолжить;
		КонецЕсли;
		
		СтруктураОтбора = Новый Структура();
		Если ТипЗнч(ВидЭлементаИлиСвязи) = Тип("СправочникСсылка.aps_ВидыЭлементов") Тогда
			СтруктураОтбора.Вставить("elementType", ВидЭлементаИлиСвязи);
			СтруктураОтбора.Вставить("refLinkGroup", Ложь);
			ВидСвязи = СоответствиеВидовЭлементовИВидовСвязей.Получить(ВидЭлементаИлиСвязи);
			Если ВидСвязи <> Неопределено Тогда
				СтруктураОтбора.Вставить("linkType", ВидСвязи);
			КонецЕсли;
		ИначеЕсли ТипЗнч(ВидЭлементаИлиСвязи) = Тип("СправочникСсылка.aps_ШаблоныТехнологическихСвязей") Тогда
			СтруктураОтбора.Вставить("linkType", ВидЭлементаИлиСвязи);
			СтруктураОтбора.Вставить("refLinkGroup", Ложь);
		КонецЕсли;
		
		Если Найти(ТекстПрограммы, aps_УбратьПробелыИзСтроки(parameterGroup.description) + "[i].") > 0 Тогда
			// множественные параметры
			МассивГруппКУдалению.Добавить(parameterGroup.reference);
			itemXDTOArray = aps_НайтиВМоделиXDTO(МодельОбъекта, СтруктураОтбора,,, Истина); // по всем уровням
			
			Для Каждого itemXDTO Из itemXDTOArray Цикл
				newParameterGroup = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("http://appius.ru/pdm", "parameter"));
				newParameterGroup.reference	 = СериализаторXDTO.ЗаписатьXDTO(parameterGroup.reference);
				newParameterGroup.description = itemXDTO.description;
				newParameterGroup.linkParameter = parameterGroup.linkParameter;
				newParameterGroup.value = СериализаторXDTO.ЗаписатьXDTO(itemXDTO.element); 
				МассивНовыхГруппПараметров.Добавить(newParameterGroup);
				
				МассивПараметровXDTO = СоответствиеОбъектовИПараметров[itemXDTO];
				Для Каждого parameter Из parameterGroup.parameters Цикл
					флПараметрВМоделиXDTO = Ложь;
					Для Каждого ПараметрXDTO Из МассивПараметровXDTO Цикл
						Если ПараметрXDTO.property = parameter.property Тогда
							newParameter = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("http://appius.ru/pdm", "parameter"));
							newParameter.reference		= СериализаторXDTO.ЗаписатьXDTO(ПараметрXDTO.reference);
							newParameter.description	= parameter.description;
							newParameter.property		= ПараметрXDTO.property;
							newParameter.unit			= ПараметрXDTO.unit;
							newParameter.linkParameter	= ПараметрXDTO.linkParameter;
							newParameterGroup.parameters.Добавить(newParameter);
							флПараметрВМоделиXDTO = Истина;
						    Прервать;
						КонецЕсли;
					КонецЦикла;
					// если параметров нет в модели. считываем их с блока расчета
					Если не флПараметрВМоделиXDTO Тогда
						newParameter = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("http://appius.ru/pdm", "parameter"));
						newParameter.reference		= СериализаторXDTO.ЗаписатьXDTO(parameter.reference);
						newParameter.description	= parameter.description;
						newParameter.property		= parameter.property;
						newParameter.unit			= parameter.unit;
						newParameter.linkParameter	= parameter.linkParameter;
						newParameterGroup.parameters.Добавить(newParameter);
					КонецЕсли;	
				КонецЦикла; // Для Каждого parameter Из parameterGroup.parameters Цикл
			КонецЦикла; // Для Каждого itemXDTO Из itemXDTOArray Цикл
			
		Иначе			
			itemXDTO = aps_НайтиВМассивеXDTO(МассивXDTO, СтруктураОтбора);
			Если itemXDTO <> Неопределено Тогда
				Для Каждого parameter Из parameterGroup.parameters Цикл
					ПараметрXDTO = МодульСозданияПараметров.aps_ВспомНайтиПараметрПоСвойствуВXDTO(itemXDTO, parameter.property);
					Если ПараметрXDTO <> Неопределено Тогда 
						parameter.reference = СериализаторXDTO.ЗаписатьXDTO(ПараметрXDTO.reference);
					КонецЕсли;
				КонецЦикла; // Для Каждого parameter Из parameterGroup.parameters Цикл
			КонецЕсли;
		КонецЕсли;
	КонецЦикла; // Для Каждого parameterGroup Из МодельБлокаРасчета.parameters Цикл
	
	КоличествоГруппПараметров = ПараметрыБлокаРасчета.Количество();
	Для i = 0 По КоличествоГруппПараметров - 1 Цикл
		rev_i = КоличествоГруппПараметров - 1 - i;
		Если МассивГруппКУдалению.Найти(ПараметрыБлокаРасчета[rev_i].reference) <> Неопределено Тогда
			ПараметрыБлокаРасчета.Удалить(rev_i);
		КонецЕсли;
	КонецЦикла;
	
	Для i = 0 По МассивНовыхГруппПараметров.Количество() - 1 Цикл
		ПараметрыБлокаРасчета.Добавить(МассивНовыхГруппПараметров[i]);
	КонецЦикла;
	
	Возврат МодельБлокаРасчета;
КонецФункции

// Функция получает дерево параметров по модели XDTO
// Параметры:
//		itemXDTO - ОбъектXDTO
// Возвращаемое значение:
//		ДеревоЗначений
// Пример:
//		ДеревоПараметров = aps_ПолучитьДеревоПараметровПоXDTO(МодельБлокаРасчета);
//
Функция aps_ПолучитьДеревоПараметровПоXDTO(itemXDTO) Экспорт
	ДеревоПараметров = Новый ДеревоЗначений();
	ДеревоПараметров.Колонки.Добавить("Имя", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(100)));
	ДеревоПараметров.Колонки.Добавить("Значение");
	ДеревоПараметров.Колонки.Добавить("ЕдиницаИзмерения", Новый ОписаниеТипов("СправочникСсылка.КлассификаторЕдиницИзмерения"));
	ДеревоПараметров.Колонки.Добавить("Свойство", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.aps_Свойства"));
	ДеревоПараметров.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("СправочникСсылка.aps_ПараметрыЭлементовИзделия, СправочникСсылка.aps_ПараметрыЭлементовТехнологии"));
	ДеревоПараметров.Колонки.Добавить("ЭтоГруппа", Новый ОписаниеТипов("Булево"));
	ДеревоПараметров.Колонки.Добавить("Картинка", Новый ОписаниеТипов("Число"), Новый КвалификаторыЧисла(1));
	ДеревоПараметров.Колонки.Добавить("ЭтоПараметрСвязи", Новый ОписаниеТипов("Булево"));
	
	Для Каждого parameterGroup Из itemXDTO.parameters Цикл
		СтрокаГруппыПараметров = ДеревоПараметров.Строки.Добавить();
		СтрокаГруппыПараметров.Имя = parameterGroup.description;
		СтрокаГруппыПараметров.Значение = parameterGroup.value;
		СтрокаГруппыПараметров.ЕдиницаИзмерения = parameterGroup.unit;
		СтрокаГруппыПараметров.Свойство = parameterGroup.property;
		СтрокаГруппыПараметров.Ссылка = parameterGroup.reference;
		СтрокаГруппыПараметров.ЭтоГруппа = НЕ ЗначениеЗаполнено(parameterGroup.property);
		СтрокаГруппыПараметров.ЭтоПараметрСвязи = parameterGroup.linkParameter;
		СтрокаГруппыПараметров.Картинка = ?(СтрокаГруппыПараметров.ЭтоГруппа, 1, ?(СтрокаГруппыПараметров.ЭтоПараметрСвязи, 2, 0));
		Для Каждого parameter Из parameterGroup.parameters Цикл
			СтрокаПараметра = СтрокаГруппыПараметров.Строки.Добавить();
			СтрокаПараметра.Имя = parameter.description;
			СтрокаПараметра.Значение = parameter.value;
			СтрокаПараметра.ЕдиницаИзмерения = parameter.unit;
			СтрокаПараметра.Свойство = parameter.property;
			СтрокаПараметра.Ссылка = parameter.reference;
			СтрокаПараметра.ЭтоПараметрСвязи = parameter.linkParameter;
			СтрокаПараметра.Картинка = ?(СтрокаПараметра.ЭтоГруппа, 1, ?(СтрокаПараметра.ЭтоПараметрСвязи, 2, 0));
		КонецЦикла;
	КонецЦикла;
	
	Возврат ДеревоПараметров;
КонецФункции

// Функция находит параметр в модели XDTO по ссылке на параметр
// Параметры:
//		itemXDTO - ОбъектXDTO
//		Ссылка - ссылка на параметр
// Возвращаемое значение:
//		ОбъектXDTO
// Пример:
//		ПараметрXDTO = aps_НайтиПараметрПоСсылкеВXDTOРек(childItem, Ссылка);
//
Функция aps_НайтиПараметрПоСсылкеВXDTOРек(itemXDTO, Ссылка) Экспорт
	МассивПараметровXDTO = aps_СформироватьМассивПараметровИзМоделиXDTO(itemXDTO);
	Для Каждого ПараметрXDTO Из МассивПараметровXDTO Цикл
		Если ПараметрXDTO.reference = Ссылка Тогда
			Возврат ПараметрXDTO;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого childItem Из itemXDTO.items Цикл
		ПараметрXDTO = aps_НайтиПараметрПоСсылкеВXDTOРек(childItem, Ссылка);
		Если ПараметрXDTO <> Неопределено Тогда
			Возврат ПараметрXDTO;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
КонецФункции

// Функция получает массив групп параметров модели XDTO по ссылке
// Параметры:
//		itemXDTO - ОбъектXDTO
//		Ссылка - ссылка на группу параметров
// Возвращаемое значение:
//		Массив параметров XDTO
// Пример:
//		ТекстИнициализации = ИмяГруппыПараметров + " = aps_ПолучитьМассивГруппПараметровПоСсылке(МодельБлокаРасчета, Справочники.aps_ПараметрыЭлементовТехнологии.ПолучитьСсылку(Новый УникальныйИдентификатор(""" + СтрокаGUID + """)));";
Функция aps_ПолучитьМассивГруппПараметровПоСсылке(itemXDTO, Ссылка) Экспорт
	МассивГрупп = Новый Массив();
	Для Каждого parameter Из itemXDTO.parameters Цикл
		Если parameter.property = Неопределено И parameter.reference = Ссылка Тогда
			МассивГрупп.Добавить(parameter);
		КонецЕсли;
	КонецЦикла;
	Возврат МассивГрупп;
КонецФункции

// Функция находит параметр в группе параметров XDTO по имени
// Параметры:
//		parameterGroup - ОбъектXDTO, группа параметров XDTO
//		ИмяПараметра - строка, наименование параметра, который необходимо найти
// Возвращаемое значение:
//		ОбъектXDTO
//
Функция aps_НайтиПараметрПоИмениВГруппеXDTO(parameterGroup, ИмяПараметра) Экспорт
	Для Каждого parameter Из parameterGroup.parameters Цикл
		Если parameter.description = ИмяПараметра Тогда 
			Возврат parameter;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Функция убирает пробелы из строки, при этом исходная строка не изменяется
// Параметры:
//		Строка - строка, из которой необходимо удалить пробелы
// Возвращаемое значение:
//		Строка
// Пример:
//		СтрокаБезПробелов = aps_УбратьПробелыИзСтроки(Строка);
//
Функция aps_УбратьПробелыИзСтроки(Знач Строка) Экспорт
	ПозицияПробела = Найти(Строка, " ");
	Пока ПозицияПробела > 0 Цикл
		ДоПробела = Лев(Строка, ПозицияПробела - 1);
		ПослеПробела = Сред(Строка, ПозицияПробела + 1);
		Строка = ДоПробела + ТРег(ПослеПробела);
		ПозицияПробела = Найти(Строка, " ");
	КонецЦикла;
	Возврат Строка;
КонецФункции

// Функция определяет, является ли символ буквой
// Параметры:
//		Параметр - строка длины 1 (символ)
// Возвращаемое значение:
//		Булево: истина, если символ является буквой, ложь, если не является
// Пример:
//		ЭтоБуква = aps_ЭтоБуква(Сред(Строка, 2, 1));
//
Функция aps_ЭтоБуква(Параметр) Экспорт
	Если (Параметр >= "A") И (Параметр <= "Z") ИЛИ (Параметр >= "a") И (Параметр <= "z") ИЛИ
		 (Параметр >= "А") И (Параметр <= "Я") ИЛИ (Параметр >= "а") И (Параметр <= "я") Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
КонецФункции // ЭтоБуква

// Функция определяет, является ли символ цифрой
// Параметры:
//		Параметр - строка длины 1 (символ)
// Возвращаемое значение:
//		Булево: истина, если символ является цифрой, ложь, если не является
// Пример:
//		ЭтоЦифра = aps_ЭтоЦифра(Сред(Строка, 2, 1));
//
Функция aps_ЭтоЦифра(Параметр) Экспорт
	Если (Параметр >= "0") И (Параметр <= "9")Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
КонецФункции // ЭтоЦифра

// Функция удаляет из строки сивмолы, не являющиеся ни буквами, ни цифрами
// Параметры:
//		Строка - строка
// Возвращаемое значение:
//		Строка
// Пример:
//		Наименование = aps_УбратьНеБуквыИНеЦифры(Строка);
//
Функция aps_УбратьНеБуквыИНеЦифры(Строка) Экспорт
	
	темп = Строка;
	результатСтрока = ""; 
	флНеСимвол = Ложь;
	
	Для инд = 1 по СтрДлина(Строка) Цикл
		символ = Лев(темп, 1);
		темп = Прав(темп, СтрДлина(темп) - 1);
		Если aps_ЭтоБуква(символ) или aps_ЭтоЦифра(символ) Тогда
			Если флНеСимвол Тогда
				результатСтрока = результатСтрока + ВРег(символ);
			Иначе	
				результатСтрока = результатСтрока + символ;
			КонецЕсли;
			флНеСимвол = Ложь;
		Иначе
			флНеСимвол = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат результатСтрока;
	
КонецФункции

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

Процедура УбратьКомментарииИзТекста(Текст)
	
	ИндексНачалаКомментария = Найти(текст, "//");
	Пока ИндексНачалаКомментария > 0 Цикл
		текстДоКомментария = Лев(текст, ИндексНачалаКомментария - 1);
		текстНачинаяСКомментария = Прав(текст, (СтрДлина(текст) - ИндексНачалаКомментария + 1));
		ИндексПереводаСтроки = Найти(текстНачинаяСКомментария, Символы.ПС);
		Если ИндексПереводаСтроки = 0 Тогда
			текст = текстДоКомментария;
			Возврат;
		Иначе
			ТекстПослеКомментария = Прав(текстНачинаяСКомментария, (СтрДлина(текстНачинаяСКомментария) - ИндексПереводаСтроки + 1));
			текст = текстДоКомментария + ТекстПослеКомментария;
		КонецЕсли;	
		ИндексНачалаКомментария = Найти(текст, "//");
	КонецЦикла;	
	
КонецПроцедуры	

#КонецОбласти

#КонецЕсли	