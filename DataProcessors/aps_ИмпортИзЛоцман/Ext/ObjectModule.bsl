
#Если НЕ МобильноеПриложениеСервер Тогда

#Область ОписаниеПеременных

Перем ТипПараметр, ЛоцманXDTO, созданныеОбъекты, Фабрика, URI, СправочникСвязей, СправочникПараметровСвязи;

Перем управлениеИзделиями;

#КонецОбласти


#Область ПрограммныйИнтерфейс

// Процедура выполняет загрузку корневых элементов из Лоцман
// Параметры:
//		currentXDTO - ОбъектXDTO, Неопределено
//		ИмяФайла	- строка
// Пример:
//		Загрузка(Неопределено, ОткрытиеФайла.ПолноеИмяФайла);
Процедура Загрузка( currentXDTO, ИмяФайла ) Экспорт

	xsdЧтение = Новый ЧтениеXML;
	Попытка
		xsdЧтение.ОткрытьФайл(ФайлСхемыДокумента);
	Исключение
		Сообщить(НСтр("ru = 'Неправильный формат файла xsd-схемы!'; en_US = 'Invalid xsd-file!'"), СтатусСообщения.Внимание);
		Возврат;
	КонецПопытки;
		
	НовыйПостроительДом = Новый ПостроительDOM;
	НовыйДокументДом = НовыйПостроительДом.Прочитать(xsdЧтение);
		
	НовыйПостроительСхем = Новый ПостроительСхемXML;
	НоваяСхема = НовыйПостроительСхем.СоздатьСхемуXML(НовыйДокументДом);

	URI=НоваяСхема.ПространствоИмен;

	НаборСхем = Новый НаборСхемXML;
	НаборСхем.Добавить(НоваяСхема);

	Фабрика = Новый ФабрикаXDTO(НаборСхем);


	Количество=0;
	Если НЕ ПустаяСтрока(ИмяФайла) Тогда
		xmlЧтение = Новый ЧтениеXML;
		xmlЧтение.ОткрытьФайл(ИмяФайла);
		Попытка
			ЛоцманXDTO=Фабрика.ПрочитатьXML(xmlЧтение);
		Исключение
			Сообщить(НСтр("ru = 'Неправильный формат xml-файла!'; en_US = 'Invalid xml-file!'"), СтатусСообщения.Внимание);
			Возврат;
		КонецПопытки;
		
		// Поиск проектов
		endItemsArray=Новый Массив();
		Для i=0 По ЛоцманXDTO.Product.Количество()-1 Цикл
			Если ЛоцманXDTO.Product[i].IsProject="1" Тогда     
				Попытка
					itemXDTO=ИмпортОбъектаЛоцман( ЛоцманXDTO.Product[i].Version.uID );
				Исключение
					Сообщить(ЛоцманXDTO.Product[i].Name+": "+КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), СтатусСообщения.Внимание);
					Продолжить;
				КонецПопытки;
				
				aps_ОтправитьНаРабочийСтол(itemXDTO); Количество=Количество+1;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если Количество>0 Тогда
		Сообщить(НСтр("ru = 'Импортировано корневых элементов: '; en_US = 'Imported items count: '")+Строка(Количество), СтатусСообщения.Информация);
	Иначе
		Сообщить(НСтр("ru = 'Ни одного элемента не импортировано.'; en_US = 'No items have been imported.'"), СтатусСообщения.Информация);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

Функция найтиXDTOПоId( id )
	Для i=0 по ЛоцманXDTO.Product.Количество()-1 Цикл
		Если id=ЛоцманXDTO.Product[i].Version.uID Тогда
			Возврат ЛоцманXDTO.Product[i];
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция ИмпортОбъектаЛоцман( id )
	
	Если созданныеОбъекты.Получить(id) <> Неопределено Тогда
		xdto=aps_СкопироватьОбъектМоделиXDTO(созданныеОбъекты.Получить(id));
		xdto.added=Истина;
		Возврат xdto;
	КонецЕсли;
	
	 product=найтиXDTOПоId(id);
	 
	 Если product=Неопределено Тогда
		 ВызватьИсключение НСтр("ru = 'Не найдено изделие: '; en_US = 'Product not found: '")+id;
	 КонецЕсли;
	

	
	ВидЭлементаСтр=ВидыЭлементов.Найти(product.Type);
	Если ВидЭлементаСтр=Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Неизвестный тип элемента: '; en_US = 'Unknown item type: '")+product.Type;
	КонецЕсли;
	
	ДеревоСвойств=Неопределено;
	МодульСозданияОбъектов.aps_ОбновитьДеревоСвойств(ВидЭлементаСтр.ВидЭлемента, ДеревоСвойств);
	
	Если НЕ ВидЭлементаСтр.ВидДокумента.Пустая() Тогда
		СтрокаСвойства = ДеревоСвойств.Строки.Найти(ПланыВидовХарактеристик.aps_Свойства.ВидДокумента, "Свойство", Истина);
		Если СтрокаСвойства <> Неопределено Тогда 
			СтрокаСвойства.Значение = ВидЭлементаСтр.ВидДокумента;
			Свойство=ПланыВидовХарактеристик.aps_Свойства.Наименование;
			СтрокаСвойства = ДеревоСвойств.Строки.Найти(Свойство, "Свойство", Истина);
			Если СтрокаСвойства<>Неопределено Тогда
				СтрокаСвойства.Значение=ВидЭлементаСтр.ВидДокумента.Наименование;
			Иначе
				новаяСтрока=ДеревоСвойств.Строки.Добавить();
				новаяСтрока.Имя=Свойство.Наименование;
				новаяСтрока.Значение=ВидЭлементаСтр.ВидДокумента.Наименование;
				новаяСтрока.Свойство=Свойство;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	
	КлючевоеСвойство=КлючевыеАтрибуты.Найти(ВидЭлементаСтр.ВидЭлемента);
	Если КлючевоеСвойство=Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Задайте свойство для ключевого атрибута!'; en_US = 'Specify the property for key attribute!'");
	КонецЕсли;
	СтрокаСвойства = ДеревоСвойств.Строки.Найти(КлючевоеСвойство.Свойство, "Свойство", Истина);
	Если СтрокаСвойства<>Неопределено Тогда
		СтрокаСвойства.Значение=product.Name;
	Иначе
		новаяСтрока=ДеревоСвойств.Строки.Добавить();
		новаяСтрока.Имя=КлючевоеСвойство.Свойство.Наименование;
		новаяСтрока.Значение=product.Name;
		новаяСтрока.Свойство=КлючевоеСвойство.Свойство;
	КонецЕсли;	
	
	
	// получить версии
	
	Version=product.Version;
	
	ДатаСоздания=Дата(Version.CreateDate);
	
	// определить состояние
	СостоянияСтр=СостоянияЭлементов.Найти(Version.State);
	Если СостоянияСтр=Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Неизвестное состояние: '; en_US = 'Unknown status: '")+Version.State;
	КонецЕсли;
	
	Состояние=СостоянияСтр.Состояние;
	НомерВерсии=Version.Number;
	
	
	// получить владельца
	ПользователиСтр=Пользователи.Найти(Version.UserName);
	Если ПользователиСтр=Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'Неизвестное имя пользователя: '; en_US = 'Unknown user name: '")+Version.UserName;
	КонецЕсли;
	Владелец=ПользователиСтр.Пользователь;
	
	Свойство=ПланыВидовХарактеристик.aps_Свойства.Состояние;
	СтрокаСвойства = ДеревоСвойств.Строки.Найти(Свойство, "Свойство", Истина);
	Если СтрокаСвойства<>Неопределено Тогда
		СтрокаСвойства.Значение=Состояние;
	Иначе
		новаяСтрока=ДеревоСвойств.Строки.Добавить();
		новаяСтрока.Имя=Свойство.Наименование;
		новаяСтрока.Значение=Состояние;
		новаяСтрока.Свойство=Свойство;
	КонецЕсли;
	
	Свойство=ПланыВидовХарактеристик.aps_Свойства.НомерРевизии;
	СтрокаСвойства = ДеревоСвойств.Строки.Найти(Свойство, "Свойство", Истина);
	Если СтрокаСвойства<>Неопределено Тогда
		СтрокаСвойства.Значение=Состояние;
	Иначе
		новаяСтрока=ДеревоСвойств.Строки.Добавить();
		новаяСтрока.Имя=Свойство.Наименование;
		новаяСтрока.Значение=Состояние;
		новаяСтрока.Свойство=Свойство;
	КонецЕсли;


		
	Если Version.Свойства().Получить("Attribute")<>Неопределено Тогда
		Если ТипЗнч(Version.Attribute) = Тип("ОбъектXDTO") Тогда
				Свойство=ПланыВидовХарактеристик.aps_Свойства.НайтиПоНаименованию(Version.Attribute.Name);
				Если Свойство.Пустая() Тогда
					Сообщить(НСтр("ru = 'Атрибут '; en_US = 'Attribute '")+Version.Attribute.Name+НСтр("ru = ' игнорирован. Нет соответствия!'; en_US = ' was ignored. Match is missing!'"));
				Иначе
					СтрокаСвойства = ДеревоСвойств.Строки.Найти(Свойство, "Свойство", Истина);
					Если СтрокаСвойства<>Неопределено Тогда
						СтрокаСвойства.Значение=Version.Attribute.Value;
					Иначе
						новаяСтрока=ДеревоСвойств.Строки.Добавить();
						новаяСтрока.Имя=Свойство.Наименование;
						новаяСтрока.Значение=Version.Attribute.Value;
						новаяСтрока.Свойство=Свойство;
					КонецЕсли;
				КонецЕсли;					
		Иначе
			Для i=0 По Version.Attribute.Количество()-1 Цикл
				Свойство=ПланыВидовХарактеристик.aps_Свойства.НайтиПоНаименованию(Version.Attribute[i].Name);
				Если Свойство.Пустая() Тогда
					Сообщить(НСтр("ru = 'Атрибут '; en_US = 'Attribute '")+Version.Attribute[i].Name+НСтр("ru = ' игнорирован. Нет соответствия!'; en_US = ' was ignored. Match is missing!'"));
				Иначе
					СтрокаСвойства = ДеревоСвойств.Строки.Найти(Свойство, "Свойство", Истина);
					Если СтрокаСвойства<>Неопределено Тогда
						СтрокаСвойства.Значение=Version.Attribute[i].Value;
					Иначе
						новаяСтрока=ДеревоСвойств.Строки.Добавить();
						новаяСтрока.Имя=Свойство.Наименование;
						новаяСтрока.Значение=Version.Attribute[i].Value;
						новаяСтрока.Свойство=Свойство;
					КонецЕсли;
				КонецЕсли;		
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	
	СуществующийЭлемент=Неопределено;
	
	Попытка
		ТекущийПользовательСохр = ПараметрыСеанса.ТекущийПользователь;
		ПараметрыСеанса.ТекущийПользователь=Владелец;
		pdmXDTO=МодульСозданияОбъектов.aps_СозданиеОбъектаPDM(ВидЭлементаСтр.ВидЭлемента,ДеревоСвойств,СуществующийЭлемент);
		pdmXDTO.created=Истина;
		pdmXDTO.added=Истина;
		ПараметрыСеанса.ТекущийПользователь=ТекущийПользовательСохр;
		Сообщить(НСтр("ru = 'Импорт: '; en_US = 'Import: '")+pdmXDTO.description);
	Исключение
		ПараметрыСеанса.ТекущийПользователь=ТекущийПользовательСохр;
		Если СуществующийЭлемент<>Неопределено Тогда
			
			ТекущийПользовательСохр = ПараметрыСеанса.ТекущийПользователь;
			ПараметрыСеанса.ТекущийПользователь=Владелец;
			xdto=aps_СоздатьОбъектМоделиXDTO(СуществующийЭлемент);
			xdto.added=Истина;
			Возврат xdto;
		Иначе
			ВызватьИсключение;
		КонецЕсли;
	КонецПопытки;
	pdmXDTO.viewTemplate= ВидЭлементаСтр.ВидЭлемента.ФайлШаблонаПросмотра;
	pdmXDTO.created=Истина;
	pdmXDTO.added=Истина;
	pdmXDTO.modified=Истина;

	созданныеОбъекты.Вставить(product.Version.uID,pdmXDTO);
	
	Если Version.Свойства().Получить("Links")<>Неопределено Тогда
		Если ТипЗнч(Version.Links)=Тип("ОбъектXDTO") Тогда
				LinkVersion=Version.Links.LinkVersion;
				Если ТипЗнч(LinkVersion)=Тип("ОбъектXDTO") Тогда
					itemXDTO=ИмпортОбъектаЛоцман(LinkVersion.uIDVer);
					itemXDTO.linkType=СериализаторXDTO.ЗаписатьXDTO(Перечисления.aps_ВидыСвязей.СоставИзделия);
					itemXDTO.link=СериализаторXDTO.ЗаписатьXDTO(СправочникСвязей.ПолучитьСсылку());
					aps_УдалитьИзМассиваXDTO(itemXDTO.parameters, Новый Структура("linkParameter", Истина));
					
					ДеревоСвойствСвязи=Новый ДеревоЗначений();
					МодульСозданияОбъектов.aps_ОбновитьДеревоСвойств(Справочники.aps_ВидыЭлементов.СвязьСостава, ДеревоСвойствСвязи);
					МодульСозданияОбъектов.aps_СозданиеПараметровXDTOПоДереву(ДеревоСвойствСвязи.Строки, itemXDTO, Истина);
					Если LinkVersion.Свойства().Получить("MaxQuantity")<>Неопределено Тогда
						count=МодульСозданияПараметров.aps_ВспомНайтиПараметрПоСвойствуВXDTO(itemXDTO, ПланыВидовХарактеристик.aps_Свойства.Количество, Истина);
						Если count<>Неопределено И count.linkParameter=Истина Тогда 
							count.value = СериализаторXDTO.ЗаписатьXDTO(LinkVersion.MaxQuantity);
						Иначе 
							count=ФабрикаXDTO.Создать(ТипПараметр);
							count.reference		= СериализаторXDTO.ЗаписатьXDTO(СправочникПараметровСвязи.ПолучитьСсылку());
							count.description	= Строка(ПланыВидовХарактеристик.aps_Свойства.Количество);
							count.property		= ПланыВидовХарактеристик.aps_Свойства.Количество;
							count.value			= СериализаторXDTO.ЗаписатьXDTO(LinkVersion.MaxQuantity);
							count.linkParameter	= Истина;
							
							itemXDTO.parameters.Добавить(count);
						КонецЕсли;
					КонецЕсли;
					pdmXDTO.items.Добавить(itemXDTO);
					pdmXDTO.modified=Истина;
				Иначе
					Для j=0 По LinkVersion.Количество()-1 Цикл
						itemXDTO=ИмпортОбъектаЛоцман(LinkVersion[j].uIDVer);
						itemXDTO.linkType=СериализаторXDTO.ЗаписатьXDTO(Перечисления.aps_ВидыСвязей.СоставИзделия);
						itemXDTO.link=СериализаторXDTO.ЗаписатьXDTO(СправочникСвязей.ПолучитьСсылку());
						aps_УдалитьИзМассиваXDTO(itemXDTO.parameters, Новый Структура("linkParameter", Истина));
						
						ДеревоСвойствСвязи=Новый ДеревоЗначений();
						МодульСозданияОбъектов.aps_ОбновитьДеревоСвойств(Справочники.aps_ВидыЭлементов.СвязьСостава, ДеревоСвойствСвязи);
						МодульСозданияОбъектов.aps_СозданиеПараметровXDTOПоДереву(ДеревоСвойствСвязи.Строки, itemXDTO, Истина);
						Если LinkVersion[j].Свойства().Получить("MaxQuantity")<>Неопределено Тогда
							count=МодульСозданияПараметров.aps_ВспомНайтиПараметрПоСвойствуВXDTO(itemXDTO, ПланыВидовХарактеристик.aps_Свойства.Количество, Истина);
							Если count<>Неопределено И count.linkParameter=Истина Тогда 
								count.value = СериализаторXDTO.ЗаписатьXDTO(LinkVersion[j].MaxQuantity);
							Иначе 
								count=ФабрикаXDTO.Создать(ТипПараметр);
								count.reference		= СериализаторXDTO.ЗаписатьXDTO(СправочникПараметровСвязи.ПолучитьСсылку());
								count.description	= Строка(ПланыВидовХарактеристик.aps_Свойства.Количество);
								count.property		= ПланыВидовХарактеристик.aps_Свойства.Количество;
								count.value			= СериализаторXDTO.ЗаписатьXDTO(LinkVersion[j].MaxQuantity);
								count.linkParameter	= Истина;
								
								itemXDTO.parameters.Добавить(count);
							КонецЕсли;
						КонецЕсли;
						pdmXDTO.items.Добавить(itemXDTO);
						pdmXDTO.modified=Истина;
					КонецЦикла;
				КонецЕсли;
			Иначе
				 Связи = Новый Массив();
				 
				Если ТипЗнч(Version.Links) = Тип("СписокXDTO") Тогда
					Для i=0 По Version.Links.Количество()-1 Цикл
						Связи.Добавить(Version.Links[i]);
					КонецЦикла;
				Иначе
					Связи.Добавить(Version.Links);
				КонецЕсли;
					Для i=0 по Связи.Количество()-1 цикл
						Link=Связи[i];
						
						ВерсииСвязей = Новый Массив();
						Если ТипЗнч(Link.LinkVersion)=Тип("СписокXDTO") Тогда
							Для j=0 По Link.LinkVersion.Количество()-1 Цикл
								ВерсииСвязей.Добавить(Link.LinkVersion[j]);
							КонецЦикла;
						Иначе
							ВерсииСвязей.Добавить(Link.LinkVersion);
						КонецЕсли;
						
						Для j=0 по ВерсииСвязей.Количество()-1 Цикл
							LinkVersion=ВерсииСвязей[j];
					
					itemXDTO=ИмпортОбъектаЛоцман(LinkVersion.uIDVer);
					itemXDTO.linkType=СериализаторXDTO.ЗаписатьXDTO(Перечисления.aps_ВидыСвязей.СоставИзделия);
					itemXDTO.link=СериализаторXDTO.ЗаписатьXDTO(СправочникСвязей.ПолучитьСсылку());
					aps_УдалитьИзМассиваXDTO(itemXDTO.parameters, Новый Структура("linkParameter", Истина));
					
					ДеревоСвойствСвязи=Новый ДеревоЗначений();
					МодульСозданияОбъектов.aps_ОбновитьДеревоСвойств(Справочники.aps_ВидыЭлементов.СвязьСостава, ДеревоСвойствСвязи);
					МодульСозданияОбъектов.aps_СозданиеПараметровXDTOПоДереву(ДеревоСвойствСвязи.Строки, itemXDTO, Истина);
					Если LinkVersion.Свойства().Получить("MaxQuantity")<>Неопределено Тогда
						count=МодульСозданияПараметров.aps_ВспомНайтиПараметрПоСвойствуВXDTO(itemXDTO, ПланыВидовХарактеристик.aps_Свойства.Количество, Истина);
						Если count<>Неопределено И count.linkParameter=Истина Тогда 
