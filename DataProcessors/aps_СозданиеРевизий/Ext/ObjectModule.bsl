// Функция возвращает список ревизий, созданных на основании переданного элемента
// Параметры:
// 		item - CправочникСсылка.aps_ЭлементыИзделия, aps_ЭлементыТехнологии, aps_ЭлементыСправочников
//		СпособСоздания - CправочникСсылка.aps_СпособыСозданияРевизий
//		ПоискПоОригиналу - если Истина, возвращает все ревизии, начиная с оригинала; иначе - созданные от переданного элемента
// Возвращаемое значение:
//		ТаблицаЗначений
// Пример:
//		Ревизии=МодульСозданияРевизий.aps_ПолучитьРевизииЭлемента(ОригиналРевизии,, Истина);
//
Функция aps_ПолучитьРевизииЭлемента( item, СпособСоздания = Неопределено, ПоискПоОригиналу = Истина ) Экспорт
	ТекстЗапроса = "ВЫБРАТЬ
	               |	СправочникЭлементовРевизии.Ссылка КАК ЭлементСсылка,
	               |	СправочникЭлементовРевизии.Ссылка.ВидЭлемента КАК ВидЭлемента,
	               |	СправочникЭлементовРевизии.Ссылка.ОригиналРевизии КАК ОригиналРевизии,
	               |	СправочникЭлементовРевизии.Ссылка.ПредыдущаяРевизия КАК ПредыдущаяРевизия,
	               |	ВЫБОР
	               |		КОГДА СправочникЭлементовРевизии.Ссылка.ИндексКартинки = 0
	               |			ТОГДА СправочникЭлементовРевизии.Ссылка.ВидЭлемента.ИндексКартинки
	               |		ИНАЧЕ СправочникЭлементовРевизии.Ссылка.ИндексКартинки
	               |	КОНЕЦ КАК Картинка,
	               |	СправочникЭлементовРевизии.Ссылка.Дата КАК Дата,
	               |	СпособСозданияРевизии.СпособСоздания КАК СпособСоздания
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		СправочникЭлементов.Ссылка КАК Ссылка
	               |	ИЗ
	               |		Справочник.СправочникЭлементов КАК СправочникЭлементов
	               |	ГДЕ
	               |		(НЕ СправочникЭлементов.ПометкаУдаления)
	               |		И СправочникЭлементов"+?(ПоискПоОригиналу,".ОригиналРевизии",".ПредыдущаяРевизия")+" В(&ОригиналИлиПредыдущая)) КАК СправочникЭлементовРевизии
				   |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |			СправочникЭлементовПараметры.Ссылка КАК Ссылка,
	               |			СправочникЭлементовПараметры.Параметр.Значение КАК СпособСоздания
	               |		ИЗ
	               |			Справочник.СправочникЭлементов.Параметры КАК СправочникЭлементовПараметры
	               |		ГДЕ
	               |			(НЕ СправочникЭлементовПараметры.Ссылка.ПометкаУдаления)
	               |			И СправочникЭлементовПараметры.Параметр.Свойство = &СвойствоСпособСоздания
	               |			И СправочникЭлементовПараметры.Ссылка"+?(ПоискПоОригиналу,".ОригиналРевизии",".ПредыдущаяРевизия")+" В(&ОригиналИлиПредыдущая)) КАК СпособСозданияРевизии
	               |		ПО (СпособСозданияРевизии.Ссылка = СправочникЭлементовРевизии.Ссылка)";
			   
	ТекстЗапроса = "ВЫБРАТЬ *
				   |ИЗ 
				   |(" + 
	СтрЗаменить(ТекстЗапроса,"СправочникЭлементов","aps_ЭлементыИзделия") + "
				   |ОБЪЕДИНИТЬ ВСЕ
				   |" + 
	СтрЗаменить(ТекстЗапроса,"СправочникЭлементов","aps_ЭлементыСправочников") + "
				   |ОБЪЕДИНИТЬ ВСЕ
				   |" + 
	СтрЗаменить(ТекстЗапроса,"СправочникЭлементов","aps_ЭлементыТехнологии") + ") КАК Ревизии";
	Если ЗначениеЗаполнено(СпособСоздания) Тогда 
		ТекстЗапроса = ТекстЗапроса + "
				   |ГДЕ СпособСоздания = &ЗначениеСпособСоздания";
	КонецЕсли;
	ТекстЗапроса = ТекстЗапроса + "
				   |УПОРЯДОЧИТЬ ПО
				   |	СпособСоздания.Код, Дата";
						  
	ЗапросРевизий = Новый Запрос(ТекстЗапроса);
	ЗапросРевизий.УстановитьПараметр("ОригиналИлиПредыдущая", item);
	ЗапросРевизий.УстановитьПараметр("СвойствоСпособСоздания", ПланыВидовХарактеристик.aps_Свойства.СпособСозданияРевизии);
	ЗапросРевизий.УстановитьПараметр("ЗначениеСпособСоздания", СпособСоздания);
	Ревизии = ЗапросРевизий.Выполнить().Выгрузить();
	Возврат Ревизии;
КонецФункции

// Функция возвращает ссылку на элемент, являющийся началом ветви изменений
// Параметры:
// 		item - CправочникСсылка.aps_ЭлементыИзделия, aps_ЭлементыТехнологии, aps_ЭлементыСправочников
// Возвращаемое значение:
//		CправочникСсылка.aps_ЭлементыИзделия, aps_ЭлементыТехнологии, aps_ЭлементыСправочников
// Пример:
//		item = aps_ПоискОригиналаИзменений(item);
//
Функция aps_ПоискОригиналаИзменений( Знач item ) Экспорт 
	Пока ЗначениеЗаполнено(item.ПредыдущаяРевизия) И МодульСозданияПараметров.aps_ВспомНайтиПараметрПоСвойству(item, ПланыВидовХарактеристик.aps_Свойства.СпособСозданияРевизии).Значение=Справочники.aps_СпособыСозданияРевизий.Изменение Цикл 
		item = item.ПредыдущаяРевизия;
	КонецЦикла;
	Возврат item;
КонецФункции

// Функция возвращает массив всех изменений для переданного элемента
// Параметры:
// 		item - CправочникСсылка.aps_ЭлементыИзделия, aps_ЭлементыТехнологии, aps_ЭлементыСправочников
// Возвращаемое значение:
//		Массив
// Пример:
//		МассивРевизий = МодульСозданияРевизий.aps_СформироватьМассивРевизийИзменения(ЭлементСсылка);
//
Функция aps_СформироватьМассивРевизийИзменения( Знач item ) Экспорт 
	item = aps_ПоискОригиналаИзменений(item);
	МассивРевизийИзменения = Новый Массив();
	МассивРевизийИзменения.Добавить(item);
	Для Каждого Ревизия Из МассивРевизийИзменения Цикл 
		СледующиеРевизии = aps_ПолучитьРевизииЭлемента(Ревизия, Справочники.aps_СпособыСозданияРевизий.Изменение, Ложь);
		Для i=0 По СледующиеРевизии.Количество()-1 Цикл 
			МассивРевизийИзменения.Добавить(СледующиеРевизии[i].ЭлементСсылка);
		КонецЦикла;
	КонецЦикла;
	Возврат МассивРевизийИзменения;
КонецФункции

// Функция создает новую ревизию элемента
// Параметры:
// 		item - CправочникСсылка.aps_ЭлементыИзделия, aps_ЭлементыТехнологии, aps_ЭлементыСправочников
//		СписокПараметровРевизии - таблица параметров создаваемой ревизии
// Возвращаемое значение:
//		CправочникОбъект.aps_ЭлементыИзделия, aps_ЭлементыТехнологии, aps_ЭлементыСправочников
// Пример:
//		itemObject = МодульСозданияРевизий.aps_СоздатьРевизию(ДокументСсылка, ТаблицаПараметровРевизии);
//
Функция aps_СоздатьРевизию( item, СписокПараметровРевизии = Неопределено ) Экспорт
	Попытка
		
		НачатьТранзакцию();
		
		itemRevision = МодульСозданияОбъектов.aps_СозданиеОбъектаPDM( item.ВидЭлемента, Новый ДеревоЗначений );
		
		itemRevision.ОригиналРевизии = ?(ЗначениеЗаполнено(item.ОригиналРевизии), item.ОригиналРевизии, item.Ссылка);
		itemRevision.ПредыдущаяРевизия = item.Ссылка;
		
		ЗаполнитьЗначенияСвойств(itemRevision, item, "HTMLКонтент, ПрограммаРасчета, ТаблицаПараметров, ИндексКартинки");
		
		#Если Клиент Или ВнешнееСоединение Тогда 
			// гл. переменная
		#Иначе
			aps_СтруктураПараметровОповещения=aps_СтруктураПараметровОповещенияНаСервере;
		#КонецЕсли
		
		aps_СтруктураПараметровОповещения.Вставить("itemObject",itemRevision);
		aps_ОбработчикиСобытий.aps_ВыполнитьСобытие(Перечисления.aps_События.ПриСозданииРевизии, aps_СтруктураПараметровОповещения);

		СоответствиеПараметровРевизии=Новый Соответствие;
		Если СписокПараметровРевизии <> Неопределено Тогда
			СоответствиеГруппПараметров=Новый Соответствие;
			
			Для Каждого СтрокаСпискаПараметров Из СписокПараметровРевизии Цикл
				СуществующийПараметр = ?(ЗначениеЗаполнено(СтрокаСпискаПараметров.Параметр), СтрокаСпискаПараметров.Параметр, Справочники.aps_ПараметрыЭлементовИзделия.ПустаяСсылка());
				
				Если НЕ СуществующийПараметр.Пустая() И СтрокаСпискаПараметров.Наследовать=Истина Тогда 
					// наследовать параметр
					itemRevision.Параметры.Добавить().Параметр = СуществующийПараметр;
				Иначе
					// создать новый параметр
					ГруппаПараметров = СоответствиеГруппПараметров.Получить(СуществующийПараметр.Родитель);
					Если ГруппаПараметров=Неопределено И ЗначениеЗаполнено(СуществующийПараметр.Родитель) Тогда 
						// создать аналогичную группу
						ГруппаПараметров = МодульСозданияПараметров.aps_СозданиеПараметра(itemRevision, СуществующийПараметр.Родитель.Наименование,,, Истина);
						СоответствиеГруппПараметров.Вставить(СуществующийПараметр.Родитель, ГруппаПараметров);
					КонецЕсли;					
					
					СуществующийПараметр=МодульСозданияПараметров.aps_СозданиеПараметра(itemRevision, СтрокаСпискаПараметров.Имя, СтрокаСпискаПараметров.Свойство, СтрокаСпискаПараметров.Значение,, ГруппаПараметров);
				КонецЕсли;
				
				Если ЗначениеЗаполнено(СтрокаСпискаПараметров.Параметр) Тогда 
					СоответствиеПараметровРевизии.Вставить(СтрокаСпискаПараметров.Параметр, СуществующийПараметр);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		// скопировать представление (для новой ревизии)
		itemRevision.ПредставлениеЭлемента.Очистить();
		Для Каждого СтрокаПредставления Из item.ПредставлениеЭлемента Цикл 
			Если ТипЗнч(СтрокаПредставления.Параметр) = Тип("Строка") Тогда 
				ЗаполнитьЗначенияСвойств(itemRevision.ПредставлениеЭлемента.Добавить(), СтрокаПредставления);
			ИначеЕсли СоответствиеПараметровРевизии.Получить(СтрокаПредставления.Параметр) <> Неопределено Тогда 
				СтрокаПредставленияРевизии = itemRevision.ПредставлениеЭлемента.Добавить();
				СтрокаПредставленияРевизии.Параметр  = СоответствиеПараметровРевизии[СтрокаПредставления.Параметр];
				СтрокаПредставленияРевизии.Системный = СтрокаПредставления.Системный;
			КонецЕсли;
		КонецЦикла;
		
		// создать представление ревизии
		aps_СоздатьПредставлениеРевизии( itemRevision );
		
		itemRevision.Записать();
		
		aps_СкопироватьФайлыРевизии( item, itemRevision );
		
		ЗафиксироватьТранзакцию();
		
		Возврат itemRevision;
		
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецФункции

// Функция связывает два элемента системы ревизиями
// Параметры:
// 		item - предыдущая ревизия, CправочникСсылка.aps_ЭлементыИзделия, aps_ЭлементыТехнологии, aps_ЭлементыСправочников
//		itemRevision - следующая ревизия, CправочникСсылка.aps_ЭлементыИзделия, aps_ЭлементыТехнологии,
//					   aps_ЭлементыСправочников
//		СписокПараметровРевизии - таблица параметров существующей ревизии
// Возвращаемое значение:
//		CправочникОбъект.aps_ЭлементыИзделия, aps_ЭлементыТехнологии, aps_ЭлементыСправочников
// Пример:
//		itemRevision = aps_СвязатьРевизии( ПредыдущаяРевизия, ЭлементСсылка, СтрокиПараметровРевизии );
//
Функция aps_СвязатьРевизии( item, Знач itemRevision, СписокПараметровРевизии = Неопределено ) Экспорт
	Попытка
		
		НачатьТранзакцию();
		
		Если НЕ МодульПравДоступа.aps_ПроверитьОбъектПрава(Справочники.aps_Права.Изменение, itemRevision, itemRevision.GMOD) Тогда 
			ВызватьИсключение НСтр("ru = ""Элемент <""; en_US = ""The <""")+itemRevision.Наименование+НСтр("ru = "">. Отсутствует право изменения!""; en_US = ""> item. Change permission is missing!""");
		КонецЕсли;					
		
		itemRevision = itemRevision.ПолучитьОбъект();
		
		itemRevision.ОригиналРевизии = ?(ЗначениеЗаполнено(item.ОригиналРевизии), item.ОригиналРевизии, item.Ссылка);
		itemRevision.ПредыдущаяРевизия = item.Ссылка;
		
		itemRevision.Параметры.Очистить(); // очистить список параметров
		
		Если СписокПараметровРевизии <> Неопределено Тогда
		
			Для Каждого СтрокаСпискаПараметров Из СписокПараметровРевизии Цикл
				// создать или наследовать параметр
				СтрокаСпискаПараметров.Параметр = МодульСозданияПараметров.aps_СозданиеПараметра(itemRevision, СтрокаСпискаПараметров.Имя, СтрокаСпискаПараметров.Свойство, СтрокаСпискаПараметров.Значение,,,, СтрокаСпискаПараметров.Параметр);
			КонецЦикла;

		КонецЕсли;
		
		// создать представление ревизии
		aps_СоздатьПредставлениеРевизии( itemRevision );
		
		itemRevision.Записать();
		
		ЗафиксироватьТранзакцию();
		
		Возврат itemRevision;
		
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецФункции

// Процедура создает представление ревизии в зависимости от способа создания
// Параметры:
// 		itemRevision - CправочникОбъект.aps_ЭлементыИзделия, aps_ЭлементыТехнологии, aps_ЭлементыСправочников
Процедура aps_СоздатьПредставлениеРевизии( itemRevision ) Экспорт 
	ПараметрСпособСоздания	= МодульСозданияПараметров.aps_ВспомНайтиПараметрПоСвойству(itemRevision, ПланыВидовХарактеристик.aps_Свойства.СпособСозданияРевизии);
	ПараметрНомерРевизии	= МодульСозданияПараметров.aps_ВспомНайтиПараметрПоСвойству(itemRevision, ПланыВидовХарактеристик.aps_Свойства.НомерРевизии);
	ПараметрНомерИсполнения	= МодульСозданияПараметров.aps_ВспомНайтиПараметрПоСвойству(itemRevision, ПланыВидовХарактеристик.aps_Свойства.НомерИсполнения);
	
	i = 0;
	Пока i < itemRevision.ПредставлениеЭлемента.Количество() Цикл 
		СтрокаПредставления = itemRevision.ПредставлениеЭлемента[i];
		Если ПараметрСпособСоздания.Значение = Справочники.aps_СпособыСозданияРевизий.Изменение И СтрокаПредставления.Системный = 1 Тогда 
			// Удалить системные параметры ревизии изменения (=1) из представления
			itemRevision.ПредставлениеЭлемента.Удалить(i);
		ИначеЕсли ПараметрСпособСоздания.Значение <> Справочники.aps_СпособыСозданияРевизий.Изменение И СтрокаПредставления.Системный > 0 Тогда 
			// Удалить все системные параметры (>0) из представления
			itemRevision.ПредставлениеЭлемента.Удалить(i);
		Иначе 
			i = i + 1;
		КонецЕсли;
	КонецЦикла;
	

	// Системный: 1 - ревизия изменения, 2 - ревизия исполнения
	Если ПараметрСпособСоздания.Значение = Справочники.aps_СпособыСозданияРевизий.Изменение Тогда 
		// номер изменения в конец представления
		СтрокаПредставления = itemRevision.ПредставлениеЭлемента.Добавить();
		СтрокаПредставления.Параметр  = "/";
		СтрокаПредставления.Системный = 1;
		
		Если ЗначениеЗаполнено(ПараметрНомерРевизии) Тогда 
			СтрокаПредставления = itemRevision.ПредставлениеЭлемента.Добавить();
			СтрокаПредставления.Параметр  = ПараметрНомерРевизии;
			СтрокаПредставления.Системный = 1;
		КонецЕсли;
		
	ИначеЕсли ПараметрСпособСоздания.Значение = Справочники.aps_СпособыСозданияРевизий.Исполнение Тогда 
		ПозВставки = Неопределено;
		ПараметрОбозначение = МодульСозданияПараметров.aps_ВспомНайтиПараметрПоСвойствуВПредставлении(itemRevision, ПланыВидовХарактеристик.aps_Свойства.Обозначение);
		Если ЗначениеЗаполнено(ПараметрОбозначение) Тогда 
			ПозВставки = itemRevision.ПредставлениеЭлемента.Индекс(itemRevision.ПредставлениеЭлемента.Найти(ПараметрОбозначение)) ;
		КонецЕсли;
		
		// номер исполнения после обозначения
		Если ПозВставки <> Неопределено Тогда 
			ПозВставки=ПозВставки+1;
			СтрокаПредставления = itemRevision.ПредставлениеЭлемента.Вставить(ПозВставки);
		Иначе 
			СтрокаПредставления = itemRevision.ПредставлениеЭлемента.Добавить();
		КонецЕсли;
		СтрокаПредставления.Параметр  = "-";
		СтрокаПредставления.Системный = 2;
		
		Если ЗначениеЗаполнено(ПараметрНомерИсполнения) Тогда 
			Если ПозВставки <> Неопределено Тогда 
				ПозВставки=ПозВставки+1;
				СтрокаПредставления = itemRevision.ПредставлениеЭлемента.Вставить(ПозВставки);
			Иначе 
				СтрокаПредставления = itemRevision.ПредставлениеЭлемента.Добавить();
			КонецЕсли;
			СтрокаПредставления.Параметр  = ПараметрНомерИсполнения;
			СтрокаПредставления.Системный = 2;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Функция копирует файлы ревизии документа
// Параметры:
// 		item - CправочникСсылка.aps_ЭлементыИзделия, aps_ЭлементыТехнологии, aps_ЭлементыСправочников
//		itemRevision - CправочникСсылка.aps_ЭлементыИзделия, aps_ЭлементыТехнологии, aps_ЭлементыСправочников
// Возвращаемое значение:
//		Нет
Функция aps_СкопироватьФайлыРевизии( item, itemRevision ) Экспорт
	ФайлыДокумента=aps_РаботаСФайламиСервер.aps_ПолучитьФайлыДокумента(item, Ложь);
	
	СкопированныеФайлы=Новый ТаблицаЗначений();
	СкопированныеФайлы.Колонки.Добавить("Файл");
	СкопированныеФайлы.Колонки.Добавить("ФайлКопия");
	СкопированныеФайлы.Добавить().Файл=Справочники.aps_Файлы.ПустаяСсылка();
	
	i=0;
	Пока i < СкопированныеФайлы.Количество() Цикл
		Файлы=ФайлыДокумента.НайтиСтроки(Новый Структура("Родитель",СкопированныеФайлы[i].Файл));
		Для Каждого Файл Из Файлы Цикл 
			ФайлКопия=Файл.Ссылка.Скопировать();
			ФайлКопия.Родитель=СкопированныеФайлы[i].ФайлКопия;
			ФайлКопия.Владелец=itemRevision.Ссылка;
			Если НЕ Файл.ЭтоГруппа Тогда 
				ФайлКопия.Редактируется=Справочники.Пользователи.ПустаяСсылка();
				ФайлКопия.ИдентификаторCheckOut="";
			КонецЕсли;
			
			ФайлКопия.Записать();
			
			СкопированныйФайл=СкопированныеФайлы.Добавить();
			СкопированныйФайл.Файл=Файл.Ссылка;
			СкопированныйФайл.ФайлКопия=ФайлКопия.Ссылка;
		КонецЦикла;
		i=i+1;
	КонецЦикла;
КонецФункции

// Функция возвращает номер последней ревизии изменения для данного элемента
// Параметры:
// 		itemRevision - оригинальный элемент или ревизия
// Возвращаемое значение:
//		Число
// Пример:
//		ПредыдущийНомер = aps_ПолучитьПоследнийНомерРевизииИзменения(ПредыдущаяРевизия);
//
Функция aps_ПолучитьПоследнийНомерРевизииИзменения( itemRevision ) Экспорт 
	ВремПравило = Справочники.aps_ПравилаУправления.СоздатьЭлемент();
	ВремПравило.ПриоритетВыбораРевизии = Перечисления.aps_ПриоритетыВыбораРевизий.ПоследняяПоНомеру;
	СпособСозданияУсловие = ВремПравило.Условия.Добавить();
	СпособСозданияУсловие.Свойство		= ПланыВидовХарактеристик.aps_Свойства.СпособСозданияРевизии;
	СпособСозданияУсловие.ВидСравнения	= Перечисления.aps_ВидыСравнения.Равно;
	СпособСозданияУсловие.Значение		= Справочники.aps_СпособыСозданияРевизий.Изменение;
	
	ОригиналРевизии = ?(ЗначениеЗаполнено(itemRevision.ОригиналРевизии), itemRevision.ОригиналРевизии, itemRevision);
	Ревизии = aps_Итераторы.aps_ПодборРевизийЭлементов(ОригиналРевизии, Object1С2Строка(ВремПравило));
	
	МассивРевизийИзменения = aps_СформироватьМассивРевизийИзменения(itemRevision.Ссылка);
	
	i=0;
	Пока i < Ревизии.Количество() Цикл 
		СтрокаПодобраннойРевизии = Ревизии[i];
		Если МассивРевизийИзменения.Найти(СтрокаПодобраннойРевизии.ЭлементСсылка) <> Неопределено Тогда 
			Если ТипЗнч(СтрокаПодобраннойРевизии.ЭлементСсылка)=Тип("СправочникСсылка.aps_ЭлементыИзделия") Тогда 
				Параметры = СтрокаПодобраннойРевизии.ПараметрыЭлементаИзделия;
			ИначеЕсли ТипЗнч(СтрокаПодобраннойРевизии.ЭлементСсылка)=Тип("СправочникСсылка.aps_ЭлементыСправочников") Тогда 
				Параметры = СтрокаПодобраннойРевизии.ПараметрыЭлементаСправочника;
			Иначе 
				Параметры = СтрокаПодобраннойРевизии.ПараметрыЭлементаТехнологии;
			КонецЕсли;
			СтрокаПараметра = Параметры.Найти(ПланыВидовХарактеристик.aps_Свойства.НомерРевизии, "Свойство");
			Если СтрокаПараметра<>Неопределено Тогда 
				Возврат СтрокаПараметра.Значение;
			КонецЕсли;
		КонецЕсли;		
		i=i+1;
	КонецЦикла;
	
	Возврат 0;
КонецФункции

// Функция возвращает номер последней ревизии исполнения для данного элемента
// Параметры:
// 		itemRevision - оригинальный элемент или ревизия
// Возвращаемое значение:
//		CправочникОбъект.aps_ЭлементыИзделия, aps_ЭлементыТехнологии, aps_ЭлементыСправочников
// Пример:
//		ПредыдущийНомер=МодульСозданияРевизий.aps_ПолучитьПоследнийНомерРевизииИсполнения( ОригиналРевизии );
//
Функция aps_ПолучитьПоследнийНомерРевизииИсполнения( itemRevision ) Экспорт 
	ВремПравило = Справочники.aps_ПравилаУправления.СоздатьЭлемент();
	ВремПравило.ПриоритетВыбораРевизии = Перечисления.aps_ПриоритетыВыбораРевизий.ПоследняяПоНомеру;
	СпособСозданияУсловие = ВремПравило.Условия.Добавить();
	СпособСозданияУсловие.Свойство		= ПланыВидовХарактеристик.aps_Свойства.СпособСозданияРевизии;
	СпособСозданияУсловие.ВидСравнения	= Перечисления.aps_ВидыСравнения.Равно;
	СпособСозданияУсловие.Значение		= Справочники.aps_СпособыСозданияРевизий.Исполнение;
	
	ОригиналРевизии = ?(ЗначениеЗаполнено(itemRevision.ОригиналРевизии), itemRevision.ОригиналРевизии, itemRevision);
	Ревизии = aps_Итераторы.aps_ПодборРевизийЭлементов(ОригиналРевизии, Object1С2Строка(ВремПравило));
	Если Ревизии.Количество() > 0 Тогда 
		СтрокаПодобраннойРевизии = Ревизии[0];
		Если ТипЗнч(СтрокаПодобраннойРевизии.ЭлементСсылка)=Тип("СправочникСсылка.aps_ЭлементыИзделия") Тогда 
			Параметры = СтрокаПодобраннойРевизии.ПараметрыЭлементаИзделия;
		ИначеЕсли ТипЗнч(СтрокаПодобраннойРевизии.ЭлементСсылка)=Тип("СправочникСсылка.aps_ЭлементыСправочников") Тогда 
			Параметры = СтрокаПодобраннойРевизии.ПараметрыЭлементаСправочника;
		Иначе 
			Параметры = СтрокаПодобраннойРевизии.ПараметрыЭлементаТехнологии;
		КонецЕсли;
		СтрокаПараметра = Параметры.Найти(ПланыВидовХарактеристик.aps_Свойства.НомерИсполнения, "Свойство");
		Если СтрокаПараметра<>Неопределено Тогда 
			Возврат СтрокаПараметра.Значение;
		КонецЕсли;
	КонецЕсли;
	
	Возврат "";
КонецФункции

#КонецЕсли

#Если (ТолстыйКлиентОбычноеПриложение Или Сервер) И Не МобильноеПриложениеСервер Тогда 
	
// Процедура обновляет уровень дерева ревизий, созданных от текущей
// Параметры:
//		itemRevision - ссылка на ревизию
//		СтрокиДереваРевизий - строки дерева ревизий для обновления
//		ДобавитьПредыдущую - если Истина, добавляет переданную ревизию в корень дерева
// Пример:
//		МодульСозданияРевизий.aps_ОбновитьДеревоРевизий(activeItemXDTO.element, ДеревоПредставленияРевизии.Строки, СпособСозданияРевизииФильтр, РежимПросмотраДерево);
//
Процедура aps_ОбновитьДеревоРевизий( Знач itemRevision, Знач СтрокиДереваРевизий, СпособСоздания = Неопределено, РежимПросмотраДерево = Ложь ) Экспорт 
	СтрокиДереваРевизий.Очистить();
	
	Если ЗначениеЗаполнено(itemRevision) Тогда 
		ОригиналРевизии = ?(ЗначениеЗаполнено(itemRevision.ОригиналРевизии), itemRevision.ОригиналРевизии, itemRevision);
		// если указан способ создания, фильтруем по переданному значению
		Ревизии = aps_ПолучитьРевизииЭлемента(ОригиналРевизии, СпособСоздания, Истина);
		Если Ревизии.Количество() > 0 Тогда 
			СтрокаРевизии = Ревизии.Вставить(0);
			СтрокаРевизии.Картинка		= ?(ЗначениеЗаполнено(ОригиналРевизии.ИндексКартинки), ОригиналРевизии.ИндексКартинки, ОригиналРевизии.ВидЭлемента.ИндексКартинки);
			СтрокаРевизии.ЭлементСсылка	= ОригиналРевизии;
			СтрокаРевизии.Дата			= ОригиналРевизии.Дата;
			
			СтрокаОригинала = СтрокиДереваРевизий.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаОригинала, СтрокаРевизии);
			
			ОбщийМассивСтрок = Новый Массив;
			ОбщийМассивСтрок.Добавить(СтрокаОригинала);
			Если РежимПросмотраДерево Тогда 
				Для Каждого СтрокаДереваРевизий Из ОбщийМассивСтрок Цикл 
					СледующиеРевизии = Ревизии.НайтиСтроки(Новый Структура("ПредыдущаяРевизия", СтрокаДереваРевизий.ЭлементСсылка));
					Подстроки = СтрокаДереваРевизий.Строки;
					Для i=0 По СледующиеРевизии.Количество()-1 Цикл
						Если СтрокиДереваРевизий.Найти(СледующиеРевизии[i].ЭлементСсылка, "ЭлементСсылка", Истина)<>Неопределено Тогда 
							Продолжить;
						КонецЕсли;
						Подстрока = Подстроки.Добавить();
						ЗаполнитьЗначенияСвойств(Подстрока, СледующиеРевизии[i]);
						ОбщийМассивСтрок.Добавить(Подстрока);
					КонецЦикла;
				КонецЦикла;
			Иначе // список
				Для i=1 По Ревизии.Количество()-1 Цикл
					Если СтрокиДереваРевизий.Найти(Ревизии[i].ЭлементСсылка, "ЭлементСсылка", Истина)<>Неопределено Тогда 
						Продолжить;
					КонецЕсли;
					СтрокаДереваРевизий = СтрокиДереваРевизий.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаДереваРевизий, Ревизии[i]);
					ОбщийМассивСтрок.Добавить(СтрокаДереваРевизий);
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры


// Процедура создает элементные связи новой ревизии по модели XDTO
// Параметры:
// 		parentXDTO - объект модели XDTO
Процедура aps_СозданиеСвязейПоМоделиXDTO( parentXDTO ) Экспорт 
	
	МассивXDTO=aps_НайтиВМоделиXDTO(parentXDTO, Новый Структура("refLinkGroup", Ложь));
	Для Каждого itemXDTO Из МассивXDTO Цикл
		Если itemXDTO.deleted=Истина Тогда 
			// удалить из модели, иначе будет удален из оригинала после сохранения
			aps_УдалитьИзМассиваXDTO(itemXDTO.Владелец().items, itemXDTO);
			Продолжить;
		КонецЕсли;
		
		Если itemXDTO.replaced=Истина Тогда
			itemXDTO.replaced=Неопределено;
		КонецЕсли;					 
		
		Если ЗначениеЗаполнено(itemXDTO.link) Тогда
			ВидЭлементаСвязи=Неопределено;
			Если itemXDTO.linkType = Перечисления.aps_ВидыСвязей.СоставИзделия Тогда 
				ВидЭлементаСвязи = Справочники.aps_ВидыЭлементов.СвязьСостава;
			ИначеЕсли ТипЗнч(itemXDTO.linkType)=Тип("СправочникСсылка.aps_ШаблоныТехнологическихСвязей") И itemXDTO.linkType.ГоризонтальнаяСвязь Тогда 
				ВидЭлементаСвязи = Справочники.aps_ВидыЭлементов.СвязьТехнологии;
			КонецЕсли;
				
			Если ВидЭлементаСвязи = Неопределено Тогда 
				// вертикальная связь
				itemXDTO.link=СериализаторXDTO.ЗаписатьXDTO(Справочники.aps_ВертикальныеСвязи.ПолучитьСсылку());
			Иначе 
				// элементная связь
				СправочникПараметровСвязи=МодульСозданияПараметров.aps_ПолучитьСправочникПараметров(ВидЭлементаСвязи);
				МассивПараметровXDTO=aps_СформироватьМассивПараметровИзМоделиXDTO(itemXDTO);
				Для Каждого parameterXDTO Из МассивПараметровXDTO Цикл 
					Если parameterXDTO.linkParameter=Истина Тогда 
						parameterXDTO.reference=СериализаторXDTO.ЗаписатьXDTO(СправочникПараметровСвязи.ПолучитьСсылку());
					КонецЕсли;
				КонецЦикла;
				
				itemXDTO.link=СериализаторXDTO.ЗаписатьXDTO(Справочники.aps_ЭлементыСвязей.ПолучитьСсылку());
			КонецЕсли;
		КонецЕсли;
		
		itemXDTO.added=Истина;
		parentXDTO.modified=Истина;
	КонецЦикла;
	
	#Если Клиент Или ВнешнееСоединение Тогда 
		// гл. переменная
	#Иначе
		aps_СтруктураПараметровОповещения=aps_СтруктураПараметровОповещенияНаСервере;
	#КонецЕсли
	
	aps_СохранитьИзмененияРедактированияXDTO(parentXDTO, aps_СтруктураПараметровОповещения);
	
	
КонецПроцедуры


// Процедура создает ревизии по xdto-модели с учетом внесенных изменений и подготавливает модель для сохранения
// Параметры:
//		parentXDTO - ОбъектXDTO, объект модели XDTO
//		Изделие - ссылка на изделие для конкретизации
//		МассивСозданныхРевизий - возвращаемый массив созданных ревизий 
// Пример:
//		МодульСозданияРевизий.aps_АвтосозданиеРевизийИзменения(itemXDTO, СоответствиеРевизий);
//
Процедура aps_АвтосозданиеРевизийИзменения( parentXDTO, СоответствиеРевизий = Неопределено ) Экспорт
	#Если Клиент Или ВнешнееСоединение Тогда 
		// гл. переменная
	#Иначе
		aps_СтруктураПараметровОповещения=aps_СтруктураПараметровОповещенияНаСервере;
	#КонецЕсли
	
	//////////////////////////////////////////////////////////////////////////////////////////////////////
	// очистить структуру параметров событий, иначе - наследуется объектная политика от предыдущей ревизии
	aps_СтруктураПараметровОповещения.Очистить();
	
	
	Если СоответствиеРевизий=Неопределено Тогда 
		СоответствиеРевизий=Новый Соответствие();
	КонецЕсли;
	
	Для Каждого itemXDTO Из parentXDTO.items Цикл
		aps_АвтосозданиеРевизийИзменения(itemXDTO, СоответствиеРевизий);
	КонецЦикла;
	
	Если parentXDTO.created<>Истина И parentXDTO.modified=Истина Тогда 
		ПредыдущаяРевизия=parentXDTO.element;
		
		// Создать ревизию изменения
		itemRevision=aps_СоздатьРевизию(ПредыдущаяРевизия);
		parentXDTO.element=СериализаторXDTO.ЗаписатьXDTO(itemRevision.Ссылка);

		СправочникПараметров=МодульСозданияПараметров.aps_ПолучитьСправочникПараметров(itemRevision.ВидЭлемента);
		
		СоответствиеПараметровРевизии=Новый Соответствие;
		// Обработка параметров ревизии.
		массивПараметровXDTO=aps_СформироватьМассивПараметровИзМоделиXDTO(parentXDTO);
		Для Каждого parameterXDTO Из массивПараметровXDTO Цикл 
			Если parameterXDTO.linkParameter=Истина Тогда 
				Продолжить;
			КонецЕсли;
			
			ПараметрСсылка=parameterXDTO.reference;
			Если parameterXDTO.reference.ПолучитьОбъект()<>Неопределено Тогда 
				parameterXDTO.reference=СериализаторXDTO.ЗаписатьXDTO(СправочникПараметров.ПолучитьСсылку());
			КонецЕсли;
			
			СоответствиеПараметровРевизии.Вставить(ПараметрСсылка, parameterXDTO.reference);
		КонецЦикла;
		
		ПредыдущийНомер = aps_ПолучитьПоследнийНомерРевизииИзменения(ПредыдущаяРевизия);
		СледующийНомер = 0;
		Попытка
			Выполнить itemRevision.ВидЭлемента.КодПоследовательностиРевизийИзменения.ТекстКода;
		Исключение
		КонецПопытки;
		
		// Параметр "Ревизия"
		МодульСозданияПараметров.aps_УстановитьЗначениеПараметраПоСвойствуВXDTO(parentXDTO, ПланыВидовХарактеристик.aps_Свойства.НомерРевизии, СледующийНомер);
		// Параметр "Способ создания ревизии"
		МодульСозданияПараметров.aps_УстановитьЗначениеПараметраПоСвойствуВXDTO(parentXDTO, ПланыВидовХарактеристик.aps_Свойства.СпособСозданияРевизии, Справочники.aps_СпособыСозданияРевизий.Изменение);
		
		Если parentXDTO.presentation.Количество()=0 Тогда 
			// Скопировать представление предыдущей ревизии в модель XDTO
			aps_ЗаполнитьПредставлениеМоделиПоТабЧасти(parentXDTO, ПредыдущаяРевизия.ПредставлениеЭлемента);
		КонецЕсли;
		
		Для i=0 По parentXDTO.presentation.Количество()-1 Цикл 
			Если СоответствиеПараметровРевизии.Получить(parentXDTO.presentation[i])<>Неопределено Тогда 
				parentXDTO.presentation[i]=СериализаторXDTO.ЗаписатьXDTO(СоответствиеПараметровРевизии[parentXDTO.presentation[i]]);
			КонецЕсли;
		КонецЦикла;
		
		// Создание связей для новой ревизии
		aps_СозданиеСвязейПоМоделиXDTO(parentXDTO);
		
		itemRevision.Прочитать();
		Если itemRevision.ПредставлениеЭлемента.Количество() = ПредыдущаяРевизия.ПредставлениеЭлемента.Количество() Тогда 
			Для i=0 По itemRevision.ПредставлениеЭлемента.Количество()-1 Цикл 
				itemRevision.ПредставлениеЭлемента[i].Системный = ПредыдущаяРевизия.ПредставлениеЭлемента[i].Системный;
			КонецЦикла;
		КонецЕсли;
		aps_СоздатьПредставлениеРевизии( itemRevision );
		itemRevision.Записать();
		
		parentXDTO.presentation.Очистить();
		aps_ОбновитьПредставлениеВМоделиXDTO(parentXDTO);
		
		// добавить созданную ревизию в соответствие
		СоответствиеРевизий.Вставить(ПредыдущаяРевизия, itemRevision.Ссылка);
	КонецЕсли;
КонецПроцедуры
	
// Процедура создает ревизии по xdto-модели с учетом внесенных изменений и подготавливает модель для сохранения
// Параметры:
//		parentXDTO - ОбъектXDTO, объект модели XDTO
//		Изделие - ссылка на изделие для конкретизации
//		МассивСозданныхРевизий - возвращаемый массив созданных ревизий 
// Пример:
//		МодульСозданияРевизий.aps_АвтосозданиеРевизийКонкретизации(itemXDTO, ИзделиеТТП);
//
Процедура aps_АвтосозданиеРевизийКонкретизации( parentXDTO, Изделие, СоответствиеРевизий = Неопределено ) Экспорт
	#Если Клиент Или ВнешнееСоединение Тогда 
		// гл. переменная
	#Иначе
		aps_СтруктураПараметровОповещения=aps_СтруктураПараметровОповещенияНаСервере;
	#КонецЕсли
	
	//////////////////////////////////////////////////////////////////////////////////////////////////////
	// очистить структуру параметров событий, иначе - наследуется объектная политика от предыдущей ревизии
	aps_СтруктураПараметровОповещения.Очистить();
	
	
	Если СоответствиеРевизий=Неопределено Тогда 
		СоответствиеРевизий=Новый Соответствие();
	КонецЕсли;
	
	Для Каждого itemXDTO Из parentXDTO.items Цикл
		aps_АвтосозданиеРевизийКонкретизации(itemXDTO, Изделие, СоответствиеРевизий);
	КонецЦикла;
	
	Если parentXDTO.created<>Истина И parentXDTO.modified=Истина Тогда 
		Если МодульСозданияПараметров.aps_ПолучитьЗначениеПараметраПоСвойствуВXDTO(parentXDTO, ПланыВидовХарактеристик.aps_Свойства.Изделие)=Изделие Тогда 
			// сохраняем существующую ревизию
			aps_СохранитьИзмененияРедактированияXDTO(parentXDTO, aps_СтруктураПараметровОповещения);
			Возврат;
		КонецЕсли;
		
		ПредыдущаяРевизия=parentXDTO.element;
		
		// Создать ревизию
		itemRevision=aps_СоздатьРевизию(ПредыдущаяРевизия);
		parentXDTO.element=СериализаторXDTO.ЗаписатьXDTO(itemRevision.Ссылка);

		СправочникПараметров=МодульСозданияПараметров.aps_ПолучитьСправочникПараметров(itemRevision.ВидЭлемента);
		
		СоответствиеПараметровРевизии=Новый Соответствие;
		// Обработка параметров ревизии.
		// Если параметр изменен - создать новый, иначе - наследовать
		массивПараметровXDTO=aps_СформироватьМассивПараметровИзМоделиXDTO(parentXDTO);
		Для Каждого parameterXDTO Из массивПараметровXDTO Цикл 
			Если parameterXDTO.linkParameter=Истина Тогда 
				Продолжить;
			КонецЕсли;
			
			ПараметрСсылка=parameterXDTO.reference;
			Если parameterXDTO.reference.ПолучитьОбъект()<>Неопределено И
				(parameterXDTO.property=Неопределено Или parameterXDTO.value=Неопределено 
					Или parameterXDTO.property.ТипЗначения.ПривестиЗначение(parameterXDTO.value)<>parameterXDTO.reference.Значение
					Или parameterXDTO.property=ПланыВидовХарактеристик.aps_Свойства.Изделие) Тогда 
				parameterXDTO.reference=СериализаторXDTO.ЗаписатьXDTO(СправочникПараметров.ПолучитьСсылку());
			КонецЕсли;
			
			СоответствиеПараметровРевизии.Вставить(ПараметрСсылка, parameterXDTO.reference);
		КонецЦикла;
		
		// Параметр "Изделие"
		МодульСозданияПараметров.aps_УстановитьЗначениеПараметраПоСвойствуВXDTO(parentXDTO, ПланыВидовХарактеристик.aps_Свойства.Изделие, Изделие);
		// Параметр "Способ создания ревизии"
		МодульСозданияПараметров.aps_УстановитьЗначениеПараметраПоСвойствуВXDTO(parentXDTO, ПланыВидовХарактеристик.aps_Свойства.СпособСозданияРевизии, Справочники.aps_СпособыСозданияРевизий.Представление);
		
		Если parentXDTO.presentation.Количество()=0 Тогда 
			// Скопировать представление предыдущей ревизии в модель XDTO
			aps_ЗаполнитьПредставлениеМоделиПоТабЧасти(parentXDTO, ПредыдущаяРевизия.ПредставлениеЭлемента);
		КонецЕсли;
		
		Для i=0 По parentXDTO.presentation.Количество()-1 Цикл 
			Если СоответствиеПараметровРевизии.Получить(parentXDTO.presentation[i])<>Неопределено Тогда 
				parentXDTO.presentation[i]=СериализаторXDTO.ЗаписатьXDTO(СоответствиеПараметровРевизии[parentXDTO.presentation[i]]);
			КонецЕсли;
		КонецЦикла;
		
		// Создание связей для новой ревизии
		aps_СозданиеСвязейПоМоделиXDTO(parentXDTO);
		
		itemRevision.Прочитать();
		Если itemRevision.ПредставлениеЭлемента.Количество() = ПредыдущаяРевизия.ПредставлениеЭлемента.Количество() Тогда 
			Для i=0 По itemRevision.ПредставлениеЭлемента.Количество()-1 Цикл 
				itemRevision.ПредставлениеЭлемента[i].Системный = ПредыдущаяРевизия.ПредставлениеЭлемента[i].Системный;
			КонецЦикла;
		КонецЕсли;
		aps_СоздатьПредставлениеРевизии( itemRevision );
		itemRevision.Записать();
		
		parentXDTO.presentation.Очистить();
		aps_ОбновитьПредставлениеВМоделиXDTO(parentXDTO);
		
		// добавить созданную ревизию в соответствие
		СоответствиеРевизий.Вставить(ПредыдущаяРевизия, itemRevision.Ссылка);
	КонецЕсли;
	
КонецПроцедуры
	
#КонецЕсли

#КонецОбласти


#Область Инициализация

#Если Сервер Тогда 
aps_СтруктураПараметровОповещенияНаСервере=Новый Структура();
#КонецЕсли

#КонецОбласти
