#Область ПрограммныйИнтерфейс

// Процедура обновляет модель данных для данного объекта
// Параметры:
//		parentXDTO - ОбъектXDTO, объект модели XDTO
//		ПравилоУправления - СправочникСсылка.aps_ПравилаУправления, Строка
//		ИгнорироватьНесвязанныеРевизии - Булево
// Пример:
//		aps_ОбновитьМодельXDTO(itemXDTO, ПравилоУправления, НЕ ПоказыватьНесвязанныеРевизии);
//
Процедура aps_ОбновитьМодельXDTO( parentXDTO, Знач ПравилоУправления = Неопределено, ИгнорироватьНесвязанныеРевизии = Ложь ) Экспорт
	Если parentXDTO.element = Проводник.СсылкаОбщиеПапки Или parentXDTO.element=Проводник.СсылкаНесвязанные Тогда 
		Проводник.aps_ОбновитьМодельXDTO(parentXDTO, ПравилоУправления, ИгнорироватьНесвязанныеРевизии);
	Иначе
		parentXDTOArray=Новый Массив;
		parentXDTOArray.Добавить(parentXDTO);
		Проводник.aps_ОбновитьМодельXDTOРек(parentXDTOArray, ПравилоУправления, 1, Истина, МассивИтераторов);
	КонецЕсли;
КонецПроцедуры

// Процедура рекурсивно обновляет модель данных для массива объектов
// Параметры:
//		parentXDTOArray - массив объектов XDTO-модели
//		ПравилоУправления - СправочникСсылка.aps_ПравилаУправления, Строка
//		КолУровней (необязательный) - Число или Неопределено, число уровней для построения
// Пример:
//		aps_ОбновитьМодельXDTOРек(МассивXDTOДляПостроения, ПравилоУправления);
//
Процедура aps_ОбновитьМодельXDTOРек( parentXDTOArray, Знач ПравилоУправления = Неопределено, КолУровней = Неопределено ) Экспорт
	Проводник.aps_ОбновитьМодельXDTOРек(parentXDTOArray, ПравилоУправления, КолУровней, Истина, МассивИтераторов);
КонецПроцедуры

// Процедура обновляет дерево представления по модели данных
// Параметры:
//		parentXDTO - объект модели XDTO
//		СтрокиДереваПредставления - строки дерева представления формы для обновления (необязательный)
// Пример:
//		aps_ОбновитьДеревоПоМоделиXDTO(itemXDTO, СтрокаДереваПредставления.Строки, СтруктураПараметровОтображения);
//
Процедура aps_ОбновитьДеревоПоМоделиXDTO( parentXDTO, СтрокиДереваПредставления, ПараметрыОтображения = Неопределено ) Экспорт 
	Проводник.aps_ОбновитьДеревоПоМоделиXDTO(parentXDTO, СтрокиДереваПредставления, ПараметрыОтображения);
КонецПроцедуры

// Процедура обновляет дерево представления по модели данных целиком
// Параметры:
//		parentXDTO - объект модели XDTO
//		СтрокиДереваПредставления - строки дерева представления формы для обновления (необязательный)
// Пример:
//		aps_ОбновитьДеревоПоМоделиXDTOРек(itemXDTO, ТекущаяСтрокаДереваПредставления.Строки, СтруктураПараметровОтображения);
//
Процедура aps_ОбновитьДеревоПоМоделиXDTOРек( parentXDTO, СтрокиДереваПредставления, ПараметрыОтображения = Неопределено ) Экспорт 
	Проводник.aps_ОбновитьДеревоПоМоделиXDTOРек(parentXDTO, СтрокиДереваПредставления, ПараметрыОтображения);
КонецПроцедуры

// Функция создает новый элемент определенного вида
// Параметры:
//		parentItem - СправочникСсылка.aps_ЭлементыСправочников, папка
//		ВидСоздаваемого (необязательный)  - СправочникСсылка.aps_ВидыЭлементов
// Возвращаемое значение:
//		Массив созданных элементов
// Пример:
//		СозданныеЭлементы = aps_ИнтерактивноеСозданиеЭлемента(parentItem, ВидСоздаваемого);
//
Функция aps_ИнтерактивноеСозданиеЭлемента( parentItem, ВидСоздаваемого = Неопределено ) Экспорт 
	СозданныеЭлементы = Новый Массив;
	
	Если ВидСоздаваемого = Справочники.aps_ВидыЭлементов.ПапкаСправочника Тогда 
		// Создать папку
		НаименованиеПапки = МодульСозданияОбъектов.ПолучитьФорму("ФормаСозданияПапки").ОткрытьМодально();
		Если НЕ ПустаяСтрока(НаименованиеПапки) Тогда
			Попытка
				НачатьТранзакцию();
   				    ДеревоСвойствПапки = Новый ДеревоЗначений;
					МодульСозданияОбъектов.aps_ОбновитьДеревоСвойств( ВидСоздаваемого, ДеревоСвойствПапки );
					
					СтрокаСвойства = ДеревоСвойствПапки.Строки.Найти(ПланыВидовХарактеристик.aps_Свойства.Наименование, "Свойство", Истина);
					Если СтрокаСвойства <> Неопределено Тогда 
						СтрокаСвойства.Значение = НаименованиеПапки;
					Иначе // Добавить свойство "Наименование" в дерево в случае отсутствия
						МодульСозданияОбъектов.aps_НеинтерактивноеДобавлениеСвойстваВДерево(ПланыВидовХарактеристик.aps_Свойства.Наименование, НаименованиеПапки,,, ДеревоСвойствПапки);
					КонецЕсли;
					
					СозданныйОбъект = МодульСозданияОбъектов.aps_СозданиеОбъектаPDM( Справочники.aps_ВидыЭлементов.ПапкаСправочника, 
																										ДеревоСвойствПапки );
					
				ЗафиксироватьТранзакцию();
				
				СозданныеЭлементы.Добавить(СозданныйОбъект.Ссылка);
			Исключение
				ОтменитьТранзакцию();
				Сообщить(ПараметрыСеанса.aps_ИмяПродукта+НСтр("ru = ""Не удалось создать папку:""; en_US = ""Cannot create folder:""")+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), СтатусСообщения.Внимание);
			КонецПопытки;
		КонецЕсли;
		
	Иначе 
		// Создать элемент
		МодульСозданияОбъектов.ПолучитьФорму(, ФормаОбработки).ОткрытьМодально();
		СозданныеЭлементы = МодульСозданияОбъектов.СозданныеЭлементы.ВыгрузитьКолонку("СозданныйЭлемент");
	КонецЕсли;
	
	Возврат СозданныеЭлементы;
КонецФункции

// Функция заимствует существующий элемент в личную папку
// Параметры:
//		item		- СправочникСсылка.aps_ЭлементыИзделия, aps_ЭлементыТехнологии, aps_ЭлементыСправочников
//		parentItem	- СправочникСсылка.aps_ЭлементыИзделия, aps_ЭлементыТехнологии, aps_ЭлементыСправочников
// Возвращаемое значение:
//		СправочникСсылка.aps_ВертикальныеСвязи,
//		Ложь, если элемент не был заимствован
// Пример:
//		СозданнаяСвязь=aps_ИнтерактивноеДобавлениеЭлемента(МассивПеретаскивания[i].element, parentItem);
//
Функция aps_ИнтерактивноеДобавлениеЭлемента( item, parentItem ) Экспорт 
	Попытка	
		СозданнаяСвязь = МодульСозданияОбъектов.aps_СозданиеВертикальнойСвязи( parentItem, item, Перечисления.aps_ВидыСвязей.Личное );
		Возврат СозданнаяСвязь.Ссылка;
	Исключение
		Сообщить(ПараметрыСеанса.aps_ИмяПродукта+НСтр("ru = ""Не удалось заимствовать элемент:""; en_US = ""Cannot adopt item:""")+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), СтатусСообщения.Внимание);
	КонецПопытки;
		
	Возврат Ложь;
КонецФункции

// Функция включает или отключает общедоступность папки по переданному параметру
// Параметры:
//		item			- ссылка на папку
//		Общедоступность	- Булево, флаг общедоступности
// Возвращаемое значение:
//		Булево - успешное изменение
// Пример:
//		ОбщедоступностьИзменена = aps_ИзменитьОбщедоступностьПапки(itemXDTO.element, Ложь);
//
Функция aps_ИзменитьОбщедоступностьПапки( item, Общедоступность ) Экспорт 
	ПараметрСсылка = МодульСозданияПараметров.aps_ВспомНайтиПараметрПоСвойству(item, ПланыВидовХарактеристик.aps_Свойства.Общедоступность);
	
	Попытка
		НачатьТранзакцию();
			Если НЕ ПараметрСсылка.Пустая() Тогда 
				Если НЕ МодульПравДоступа.aps_ПроверитьОбъектПрава( Справочники.aps_Права.Изменение, ПараметрСсылка, ПараметрСсылка.GMOD ) Тогда 
					ВызватьИсключение НСтр("ru = 'Отсутствует право изменения параметра!'; en_US = 'Change permission of the parameter is missing!'");
				КонецЕсли;
			Иначе 
				Если НЕ МодульПравДоступа.aps_ПроверитьОбъектПрава( Справочники.aps_Права.Изменение, item, item.GMOD ) Тогда 
					ВызватьИсключение НСтр("ru = 'Отсутствует право изменения!'; en_US = 'Change permission is missing!'");
				КонецЕсли;
			КонецЕсли;
			
			ОбъектПапки = item.ПолучитьОбъект();
			МодульСозданияПараметров.aps_УстановкаПараметра(ОбъектПапки, ПланыВидовХарактеристик.aps_Свойства.Общедоступность, Общедоступность);
			ОбъектПапки.Записать();
		ЗафиксироватьТранзакцию();
		Возврат Истина;
		
	Исключение
		ОтменитьТранзакцию();
		Если Общедоступность=Истина Тогда 
			Сообщить(ПараметрыСеанса.aps_ИмяПродукта+НСтр("ru = ""Не удалось включить общедоступность папки <""; en_US = ""Cannot share the folder <""")+Строка(item)+НСтр("ru = ""> по причине:""; en_US = ""> because: """)+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), СтатусСообщения.Внимание);
		Иначе 
			Сообщить(ПараметрыСеанса.aps_ИмяПродукта+НСтр("ru = ""Не удалось отключить общедоступность папки <""; en_US = ""Cannot make the folder <""")+Строка(item)+НСтр("ru = ""> по причине:""; en_US = ""> private because:""")+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), СтатусСообщения.Внимание);
		КонецЕсли;
		
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Функция изменяет наименование папки по переданному параметру
// Параметры:
//		item			- ссылка на папку
//		Наименование	- Строка, новое имя папки
// Возвращаемое значение:
//		Булево - успешное изменение
// Пример:
//		НаименованиеИзменено = aps_ИзменитьНаименованиеПапки(activeItemXDTO.element, НаименованиеПапки);
Функция aps_ИзменитьНаименованиеПапки( item, Наименование ) Экспорт 
	ПараметрСсылка = МодульСозданияПараметров.aps_ВспомНайтиПараметрПоСвойству(item, ПланыВидовХарактеристик.aps_Свойства.Наименование);
	
	Попытка
		НачатьТранзакцию();
			Если НЕ ПараметрСсылка.Пустая() Тогда 
				Если НЕ МодульПравДоступа.aps_ПроверитьОбъектПрава( Справочники.aps_Права.Изменение, ПараметрСсылка, ПараметрСсылка.GMOD ) Тогда 
					ВызватьИсключение НСтр("ru = 'Отсутствует право изменения параметра!'; en_US = 'Change permission of the parameter is missing!'");
				КонецЕсли;
			Иначе 
				Если НЕ МодульПравДоступа.aps_ПроверитьОбъектПрава( Справочники.aps_Права.Изменение, item, item.GMOD ) Тогда 
					ВызватьИсключение НСтр("ru = 'Отсутствует право изменения!'; en_US = 'Change permission is missing!'");
				КонецЕсли;
			КонецЕсли;
		
			ОбъектПапки = item.ПолучитьОбъект();
			МодульСозданияПараметров.aps_УстановкаПараметра(ОбъектПапки, ПланыВидовХарактеристик.aps_Свойства.Наименование, Наименование);
			ОбъектПапки.Записать();
		ЗафиксироватьТранзакцию();
		Возврат Истина;
		
	Исключение
		ОтменитьТранзакцию();
		Сообщить(ПараметрыСеанса.aps_ИмяПродукта+НСтр("ru = ""Не удалось переименовать папку по причине:""; en_US = ""Cannot rename folder: """)+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), СтатусСообщения.Внимание);
		Возврат Ложь;
	КонецПопытки;
КонецФункции


// Процедура обновляет дерево уведомлений
// Параметры:
//		Дерево - ДеревоЗначений
//		СтруктураУсловий - Структура
// Пример:
//		aps_ОбновитьДеревоУведомлений( локСписокЗадач, СтруктураУсловий );
//
Процедура aps_ОбновитьДеревоУведомлений( Дерево, СтруктураУсловий = Неопределено, БезВложений = Истина ) Экспорт
	Перем СтрокаПоиска, ПоляПоиска, Получатель, Отправитель, Выполнена, Важное, СВложением, ПометкаУдаления, ОтправительИЛИПолучатель, КопияОтправителю, Теги;
	
	Если ЗначениеЗаполнено(СтруктураУсловий) Тогда
		СтруктураУсловий.Свойство("СтрокаПоиска"				, СтрокаПоиска);
		СтруктураУсловий.Свойство("ПоляПоиска"					, ПоляПоиска);
		СтруктураУсловий.Свойство("Получатель"					, Получатель);
		СтруктураУсловий.Свойство("Отправитель"					, Отправитель);
		СтруктураУсловий.Свойство("Выполнена"					, Выполнена);
		СтруктураУсловий.Свойство("Важное"						, Важное);
		СтруктураУсловий.Свойство("СВложением"					, СВложением);
		СтруктураУсловий.Свойство("ПометкаУдаления"				, ПометкаУдаления);
		СтруктураУсловий.Свойство("КопияОтправителю"			, КопияОтправителю);
		СтруктураУсловий.Свойство("ОтправительИЛИПолучатель"	, ОтправительИЛИПолучатель);
		СтруктураУсловий.Свойство("Теги"						, Теги);
	КонецЕсли;
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	*,
	                      |	ВЫБОР
	                      |		КОГДА ОтветыНаУведомления.Уведомление ЕСТЬ NULL 
	                      |			ТОГДА ЛОЖЬ
	                      |		ИНАЧЕ ИСТИНА
	                      |	КОНЕЦ КАК Ответ
	                      |ИЗ
	                      |	(ВЫБРАТЬ
	                      |		*,
						  |		Наименование КАК Тема,
						  |		Выполнена КАК Прочитано
	                      |	ИЗ
	                      |		Задача.aps_Уведомление КАК aps_Уведомление
	                      |	ГДЕ
	                      |		ИСТИНА");
	Если ЗначениеЗаполнено(ПометкаУдаления) Тогда
		Запрос.Текст = Запрос.Текст + "
	                      |	И aps_Уведомление.ПометкаУдаления = &ПометкаУдаления";
		Запрос.УстановитьПараметр("ПометкаУдаления", ПометкаУдаления);
	КонецЕсли;
	Если ЗначениеЗаполнено(КопияОтправителю) Тогда
		Запрос.Текст = Запрос.Текст + "
	                      |	И aps_Уведомление.КопияОтправителю = &КопияОтправителю";
		Запрос.УстановитьПараметр("КопияОтправителю", КопияОтправителю);
	КонецЕсли;
	Если ЗначениеЗаполнено(СтрокаПоиска) Тогда
		Если ПоляПоиска = 2 Тогда
			Запрос.Текст = Запрос.Текст + "
	                      |	И (aps_Уведомление.Наименование ПОДОБНО &СтрокаПоиска ИЛИ aps_Уведомление.Содержание ПОДОБНО &СтрокаПоиска)";
		Иначе
			Запрос.Текст = Запрос.Текст + "
	                      |	И aps_Уведомление.Наименование ПОДОБНО &СтрокаПоиска";
		КонецЕсли;
		Запрос.УстановитьПараметр("СтрокаПоиска", "%" + СтрокаПоиска +"%");
	КонецЕсли;
	Если ЗначениеЗаполнено(ОтправительИЛИПолучатель) Тогда
		Запрос.Текст = Запрос.Текст + "
	                      |	И (aps_Уведомление.Получатель = &ОтправительИЛИПолучатель ИЛИ aps_Уведомление.Отправитель = &ОтправительИЛИПолучатель)";
		Запрос.УстановитьПараметр("ОтправительИЛИПолучатель", ОтправительИЛИПолучатель);
	Иначе
		Если ЗначениеЗаполнено(Получатель) Тогда
			Запрос.Текст = Запрос.Текст + "
	                      |	И aps_Уведомление.Получатель = &Получатель";
			Запрос.УстановитьПараметр("Получатель", Получатель);
		КонецЕсли;
		Если ЗначениеЗаполнено(Отправитель) Тогда
			Запрос.Текст = Запрос.Текст + "
	                      |	И aps_Уведомление.Отправитель = &Отправитель";
			Запрос.УстановитьПараметр("Отправитель", Отправитель);
		КонецЕсли;
	КонецЕсли;
	Если ЗначениеЗаполнено(Выполнена) Тогда
		Запрос.Текст = Запрос.Текст + "
	                      |	И aps_Уведомление.Выполнена = &Выполнена";
		Запрос.УстановитьПараметр("Выполнена", Выполнена);
	КонецЕсли;
	Если ЗначениеЗаполнено(Важное) Тогда
		Запрос.Текст = Запрос.Текст + "
	                      |	И aps_Уведомление.Важное = &Важное";
		Запрос.УстановитьПараметр("Важное", Важное);
	КонецЕсли;
	Если ЗначениеЗаполнено(Теги) Тогда
		Запрос.Текст = Запрос.Текст + "
	                      |	И aps_Уведомление.Теги.Тег В(&Теги)";
		Запрос.УстановитьПараметр("Теги", Теги);
	КонецЕсли;
	Запрос.Текст = Запрос.Текст + ") КАК УведомленияСОтбором
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |			aps_ОтветыНаУведомления.Уведомление КАК Уведомление
	                      |		ИЗ
	                      |			РегистрСведений.aps_ОтветыНаУведомления КАК aps_ОтветыНаУведомления) КАК ОтветыНаУведомления
	                      |		ПО (ОтветыНаУведомления.Уведомление = УведомленияСОтбором.Ссылка)
	                      |УПОРЯДОЧИТЬ ПО
	                      |	Дата УБЫВ";
	
	тзУведомления = Запрос.Выполнить().Выгрузить();
	
	СтрокиЗадач=Дерево.Строки;
	
	insert=0; МассивСтрок=Новый Массив();
	Для Каждого Строка Из тзУведомления Цикл
		ТекущаяСВложением = Строка.Вложения.Количество() > 0;
		Если ЗначениеЗаполнено(СВложением) Тогда
			Если СВложением <> ТекущаяСВложением Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		СтрокаЗадачи = СтрокиЗадач.Найти(Строка.Ссылка, "Ссылка");
		Если СтрокаЗадачи = Неопределено Тогда 
			СтрокаЗадачи = СтрокиЗадач.Вставить(insert);
		ИначеЕсли insert <> СтрокиЗадач.Индекс(СтрокаЗадачи) Тогда 
			СтрокиЗадач.Сдвинуть(СтрокаЗадачи, insert-СтрокиЗадач.Индекс(СтрокаЗадачи));
		КонецЕсли;
		
		МассивСтрок.Добавить(СтрокаЗадачи);
		
		insert=insert+1;
		
		ЗаполнитьЗначенияСвойств(СтрокаЗадачи, Строка);
		
		Если ПустаяСтрока(СтрокаЗадачи.Тег) Тогда 
			Для Каждого СтрокаТега Из Строка.Теги Цикл
				СтрокаЗадачи.Тег = СтрокаЗадачи.Тег + Строка(СтрокаТега.Тег) + "; ";
			КонецЦикла;
		КонецЕсли;
		
		Если БезВложений Тогда 
			Продолжить; // не отображать вложения в дереве
		КонецЕсли;
		
		Если СтрокаЗадачи.Строки.Количество()=0 Тогда 
			Для Каждого СтрокаВложения Из Строка.Вложения Цикл
				НоваяСтрока = СтрокаЗадачи.Строки.Добавить();
				НоваяСтрока.Вложение	= СтрокаВложения.Вложение;
				НоваяСтрока.Тема		= Строка(СтрокаВложения.Вложение);
			КонецЦикла;
			
			СтрокаЗадачи.СВложениями=(СтрокаЗадачи.Строки.Количество()>0);
		КонецЕсли;
	КонецЦикла;
	
	i=0;
	Пока i < СтрокиЗадач.Количество() Цикл 
		Если МассивСтрок.Найти(СтрокиЗадач[i])=Неопределено Тогда 
			Если СтрокиЗадач[i].Строки.Количество() > 0 Тогда 
				СтрокиЗадач[i].Строки.Очистить();
			КонецЕсли;
			СтрокиЗадач.Удалить(i); Продолжить;
		КонецЕсли;
		i=i+1;
	КонецЦикла;
	
КонецПроцедуры

// Процедура обновляет дерево поручений
// Параметры:
//		Дерево - ДеревоЗначений
//		СтруктураУсловий - Структура
// Пример:
//		aps_ОбновитьДеревоПоручений( локСписокПоручений, СтруктураУсловий );
//
Процедура aps_ОбновитьДеревоПоручений( Дерево, СтруктураУсловий = Неопределено, ПолеГруппировки = Неопределено ) Экспорт
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	*,
	                      |	ВЫРАЗИТЬ(БизнесПроцесс.ВедущаяЗадача КАК Задача.aps_ИзменениеСостоянияЭлементов).БизнесПроцесс КАК БизнесПроцесс
	                      |ИЗ
	                      |	Задача.aps_Поручение
	                      |ГДЕ
	                      |	НЕ ПометкаУдаления");
	Для Каждого КиЗ Из СтруктураУсловий Цикл 
		Запрос.Текст = Запрос.Текст + "
	                      |И "+СтрЗаменить(КиЗ.Ключ, "_", ".") + " = " + "&" + КиЗ.Ключ;
		Запрос.УстановитьПараметр(КиЗ.Ключ, КиЗ.Значение);
	КонецЦикла;
	Запрос.Текст = "ВЫБРАТЬ * ИЗ ( 
	                      |"+ Запрос.Текст + ") КАК Поручения
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	                      |			Состояния.Ссылка КАК Ссылка,
	                      |			МАКСИМУМ(Состояния.ЭлементСсылка) КАК ЭлементСсылка
	                      |		ИЗ
	                      |			Задача.aps_Поручение.Состояния КАК Состояния
	                      |		ГДЕ
	                      |			НЕ Состояния.Ссылка.ПометкаУдаления
	                      |		
	                      |		СГРУППИРОВАТЬ ПО
	                      |			Состояния.Ссылка) КАК Элементы
	                      |		ПО Поручения.Ссылка = Элементы.Ссылка";
	Запрос.Текст = Запрос.Текст + "
						  |УПОРЯДОЧИТЬ ПО
						  |	СрокСогласования УБЫВ, Дата УБЫВ";
	Если НЕ ПустаяСтрока(ПолеГруппировки) Тогда 
		Запрос.Текст = Запрос.Текст + "
						  |ИТОГИ ПО
						  |	"+ПолеГруппировки;
	КонецЕсли;							  
						
	тзПоручения = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	
	Дерево = тзПоручения;
		
КонецПроцедуры

#КонецОбласти


