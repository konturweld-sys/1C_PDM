
#Если ТолстыйКлиентОбычноеПриложение Тогда 

#Область ОписаниеПеременных	

Перем КнопкиМодулейСоответствие;

#КонецОбласти


#Область ПрограммныйИнтерфейс

// Процедура находит или создает меню и добавляет кнопку для вызова подключаемого модуля
// Параметры:
//		Форма - Форма
//		ДействиеОбработчик - Действие
// Пример:
//		МодульПлагинов.aps_СоздатьМенюПодключаемыхМодулей(ЭтаФорма, Новый Действие("ОбработчикПодключаемогоМодуля"));
//
Процедура aps_СоздатьМенюПодключаемыхМодулей(Форма, ДействиеОбработчик) Экспорт
	СписокМодулей = aps_ПолучитьСписокПодключаемыхМодулей(Форма.ОбработкаОбъект.Метаданные().ПолноеИмя());
	Для каждого СтрокаМодуля Из СписокМодулей Цикл
		МассивПодменюДляПодключения = aps_НайтиПодменюНаФорме(Форма, СтрокаМодуля.Подменю);
		Для Каждого Подменю Из МассивПодменюДляПодключения Цикл 
			Кнопки = Подменю.Кнопки;
			Если Найти(Кнопки[Кнопки.Количество()-1].Имя, "Модуль_") = 0 Тогда 
				// вставить разделитель
				Кнопки.Добавить("Модуль_" + СтрЗаменить(Новый УникальныйИдентификатор(), "-", "_"), ТипКнопкиКоманднойПанели.Разделитель);
			КонецЕсли;
			
			ИмяКнопки = "Модуль_" + СтрЗаменить(Строка(Новый УникальныйИдентификатор()), "-", "_");
			
			Кнопка = Кнопки.Добавить(ИмяКнопки, ТипКнопкиКоманднойПанели.Действие, СтрокаМодуля.Наименование, ДействиеОбработчик);
			Кнопка.Подсказка = СтрокаМодуля.Комментарий; 
			Кнопка.Пояснение = СтрокаМодуля.Комментарий; 
			
			Если ЗначениеЗаполнено(СтрокаМодуля.КартинкаКнопки) Тогда 
				Попытка
					Кнопка.Картинка  = БиблиотекаКартинок[СтрокаМодуля.КартинкаКнопки]; 
				Исключение
				КонецПопытки;
			КонецЕсли;
			
			КнопкиМодулейСоответствие.Вставить(Кнопка, СтрокаМодуля.Ссылка);
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

// Функция выполняет поиск подменю на форме
// Параметры:
//		Форма - Форма
//		Имя - строка (необязательный)
// Возвращаемое значение:
//		Массив
// Пример:
//		МассивПодменю = Обработки.aps_ПодключаемыеМодули.Создать().aps_НайтиПодменюНаФорме(ФормаОбработки);
//
Функция aps_НайтиПодменюНаФорме(Форма, Имя = "") Экспорт 
	МассивПодменю = Новый Массив();
	
	МассивКоллекцийКнопок = Новый Массив();
	Для Каждого ЭлементФормы Из Форма.ЭлементыФормы Цикл 
		Если ТипЗнч(ЭлементФормы) = Тип("КоманднаяПанель") Тогда 
			МассивКоллекцийКнопок.Добавить(ЭлементФормы.Кнопки);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Кнопки Из МассивКоллекцийКнопок Цикл 
		Для Каждого Кнопка Из Кнопки Цикл 
			Если Кнопка.ТипКнопки = ТипКнопкиКоманднойПанели.Подменю Тогда 
				Если НЕ ЗначениеЗаполнено(Имя) Или ВРег(Кнопка.Имя) = ВРег(Имя) Тогда 
					МассивПодменю.Добавить(Кнопка);
				КонецЕсли;
				МассивКоллекцийКнопок.Добавить(Кнопка.Кнопки);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат МассивПодменю; 
КонецФункции

// Функция получает объект обработки подключаемого модуля 
// Параметры:
//		Кнопка - кнопка командной панели
// Возвращаемое значение:
//      ОбработкаОбъект; Неопределено
// Пример:
//		ОбработкаМодуля = МодульПлагинов.aps_ПолучитьМодуль(Кнопка);
//
Функция aps_ПолучитьМодуль(Кнопка) Экспорт
	Модуль = КнопкиМодулейСоответствие[Кнопка];
	Если Модуль = Неопределено Тогда 
		Возврат Неопределено;
	КонецЕсли;
	
	СправочникОбъект = Модуль.ПолучитьОбъект();
	Если СправочникОбъект = Неопределено Тогда 
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат СправочникОбъект.ПолучитьОбработку();
КонецФункции

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

Функция aps_ПолучитьСписокПодключаемыхМодулей(Обработка)
	
	ДоступныеРоли = Новый Массив();
	Для Каждого Роль Из Метаданные.Роли Цикл 
		Если РольДоступна(Роль) Тогда 
			ДоступныеРоли.Добавить(Роль.Имя);
		КонецЕсли;
	КонецЦикла;
	
	ЗапросМодулей = Новый Запрос();
	ЗапросМодулей.УстановитьПараметр("Обработка", Обработка);
	ЗапросМодулей.УстановитьПараметр("ДоступныеРоли", ДоступныеРоли);
	
	ЗапросМодулей.Текст = 
		"ВЫБРАТЬ
		|	Модули.Ссылка,
		|	Модули.Ссылка.Наименование КАК Наименование,
		|	Модули.Ссылка.Комментарий КАК Комментарий,
		|	Модули.Ссылка.КартинкаКнопки КАК КартинкаКнопки,
		|	Модули.Подменю
		|ИЗ
		|	(ВЫБРАТЬ
		|		Модули.Ссылка КАК Ссылка,
		|		Модули.Подменю КАК Подменю
		|	ИЗ
		|		(ВЫБРАТЬ
		|			Спр.Ссылка КАК Ссылка,
		|			Спр.Подменю КАК Подменю
		|		ИЗ
		|			Справочник.aps_ПодключаемыеМодули.Подключение КАК Спр
		|		ГДЕ
		|			НЕ Спр.Ссылка.ПометкаУдаления
		|			И Спр.Обработка = &Обработка) КАК Модули
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.aps_ПодключаемыеМодули.Роли КАК Роли
		|			ПО Модули.Ссылка = Роли.Ссылка
		|	ГДЕ
		|		Роли.Роль В(&ДоступныеРоли)
		|	
		|	СГРУППИРОВАТЬ ПО
		|		Модули.Ссылка,
		|		Модули.Подменю) КАК Модули
		|
		|УПОРЯДОЧИТЬ ПО
		|	Модули.Ссылка.Код";

	Возврат ЗапросМодулей.Выполнить().Выгрузить();
КонецФункции

#КонецОбласти


