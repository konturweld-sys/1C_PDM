// Функция присваивает значение параметру по свойству в модели XDTO
//
// Параметры:
//		itemXDTO - XDTO-объект типа "item"
//		Свойство - ПланыВидовХарактеристикСсылка.aps_Свойства
//		Значение - Характеристика.aps_Свойства
// Пример:
//		МодульСозданияПараметров.aps_УстановитьЗначениеПараметраПоСвойствуВXDTO(childItemXDTO, ПланыВидовХарактеристик.aps_Свойства.Состояние, АктуальноеСостояние);
//
Процедура aps_УстановитьЗначениеПараметраПоСвойствуВXDTO( itemXDTO, Свойство, Значение, ФлагПараметраСвязи=Неопределено ) Экспорт 
	parameterXDTO=aps_ВспомНайтиПараметрПоСвойствуВXDTO(itemXDTO, Свойство, ФлагПараметраСвязи);
	Если parameterXDTO=Неопределено Тогда // создать параметр
		parameterXDTO = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("http://appius.ru/pdm", "parameter"));
		parameterXDTO.reference		= СериализаторXDTO.ЗаписатьXDTO(aps_ПолучитьСправочникПараметров(itemXDTO.elementType).ПолучитьСсылку());
		parameterXDTO.description	= Свойство.Наименование;
		parameterXDTO.property		= Свойство;
		parameterXDTO.unit			= Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка();
		
		parameterXDTO.linkParameter	= ?(ФлагПараметраСвязи=Неопределено, Ложь, ФлагПараметраСвязи);
		
		itemXDTO.parameters.Добавить(parameterXDTO);
	КонецЕсли;
	
	parameterXDTO.value = ?(ЗначениеЗаполнено(Значение), СериализаторXDTO.ЗаписатьXDTO(Значение), Неопределено);
	
	parentItemXDTO = itemXDTO.Владелец();
	parentItemXDTO = ?(parentItemXDTO<>Неопределено И parentItemXDTO.refLinkGroup, parentItemXDTO.Владелец(), parentItemXDTO);
	Если parameterXDTO.linkParameter=Истина Тогда 
		Если parentItemXDTO<>Неопределено Тогда 
			parentItemXDTO.modified = Истина;
		КонецЕсли;
	Иначе 
		itemXDTO.modified = Истина;
	КонецЕсли;
КонецПроцедуры

// Функция присваивает значение параметру по имени в модели XDTO
