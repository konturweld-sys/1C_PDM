Функция aps_ИсключитьПараметрПоСвойству( itemObject, Свойство ) Экспорт
	Количество = itemObject.Параметры.Количество()-1;
	Для i=0 По Количество Цикл
		rev_i = Количество-i;
		Если itemObject.Параметры[rev_i].Параметр.Свойство = Свойство Тогда
			itemObject.Параметры.Удалить(rev_i);
		КонецЕсли;
	КонецЦикла;
КонецФункции

