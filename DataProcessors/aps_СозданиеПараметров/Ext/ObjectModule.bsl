// Функция находит и возвращает блок параметра или для данного объекта структуры HTML-документа
//
// Параметры:
//		element - COM-объект, элемент DHTML
// Возвращаемое значение:
//      COM-объект, элемент DHTML
//
Функция aps_ПолучитьБлокПараметраИлиАтрибута( element ) Экспорт 
	
	parent = element.parentElement;
	Пока parent <> Неопределено Цикл 
		Если ВРег(parent.tagName) = "SPAN" Тогда 
			Попытка
				UUID = Новый УникальныйИдентификатор(parent.id);
				Возврат parent;
			Исключение
			КонецПопытки;
		КонецЕсли;
		parent = parent.parentElement;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

