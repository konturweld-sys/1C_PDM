#Если НЕ МобильноеПриложениеСервер Тогда
// Функция создает новый параметр
//
// Параметры:
//			itemObject		 - объект PDM-системы
//			Имя				 - Строка
//			Свойство		 - ПланыВидовХарактеристикСсылка.aps_Свойства
//			Значение		 - Характеристика.aps_Свойства
//			ЭтоГруппа		 - Булево
//			Группа			 - ссылка на группу параметров
//			ЕдиницаИзмерения - СправочникСсылка.КлассификаторЕдиницИзмерения
//			СсылкаНового	 - ссылка нового параметра
// Возвращаемое значение:
//			СправочникСсылка.aps_ПараметрыЭлементовТехнологии ИЛИ СправочникСсылка.aps_ПараметрыЭлементовИзделия
// Пример:
//			НовыйПараметр=МодульСозданияПараметров.aps_СозданиеПараметра(ЭлементОбъект, СтрокаСвойства.Имя, СтрокаСвойства.Свойство, СтрокаСвойства.Значение,, ГруппаПараметров, СтрокаСвойства.ЕдиницаИзмерения);
//
Функция aps_СозданиеПараметра( itemObject, Имя, Знач Свойство, Значение = Неопределено, ЭтоГруппа = Ложь, Группа = Неопределено, ЕдиницаИзмерения = Неопределено, СсылкаНового = Неопределено ) Экспорт;
	
	Если itemObject = Неопределено Тогда 
		ВызватьИсключение "aps_СозданиеПараметра: " + НСтр("ru = ""Неверно заданы входные параметры!""; en_US = ""Input parameters are incorrectly specified!""");
	КонецЕсли;
	
	// для параметров проверяется заполнение свойства
	Если НЕ ЭтоГруппа И (НЕ ЗначениеЗаполнено(Свойство) ИЛИ Свойство.ТипЗначения = Неопределено) Тогда 
		ВызватьИсключение НСтр("ru = ""Не заполнено свойство!""; en_US = ""Property is not specified!""");
	КонецЕсли;
	
	// заполнение имени проверяется для групп и параметров
	Если ПустаяСтрока(СокрЛП(Имя)) Тогда 
		ВызватьИсключение НСтр("ru = ""Пустое имя параметра недопустимо!""; en_US = ""Parameter description must be filled!""");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СсылкаНового) И СсылкаНового.ПометкаУдаления Тогда 
		Если СсылкаНового.ЭтоГруппа Тогда 
			СсылкаНового.ПолучитьОбъект().УстановитьПометкуУдаления(Ложь);
		Иначе 
			СсылкаНового.ПолучитьОбъект().Удалить(); // удалить помеченный на удаление параметр из базы
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СсылкаНового) И СсылкаНового.ПолучитьОбъект() <> Неопределено Тогда 
		Если НЕ ЭтоГруппа И itemObject.Параметры.Найти(СсылкаНового) = Неопределено Тогда
			itemObject.Параметры.Добавить().Параметр = СсылкаНового; // наследовать существующий параметр
		КонецЕсли;
		Возврат СсылкаНового; 
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СсылкаНового) Тогда 
		СправочникПараметров = Справочники[СсылкаНового.Метаданные().Имя];
	Иначе 
		СправочникПараметров = aps_ПолучитьСправочникПараметров( itemObject.ВидЭлемента );
	КонецЕсли;

	Если ЭтоГруппа Тогда
		ОбъектПараметра = СправочникПараметров.СоздатьГруппу();
	Иначе
		ОбъектПараметра = СправочникПараметров.СоздатьЭлемент();
		
		ОбъектПараметра.UID = ПараметрыСеанса.ТекущийПользователь;
		ОбъектПараметра.GID = Перечисления.aps_СистемныеГруппы.Пользователи;
		
		ОбъектПараметра.Свойство		 = Свойство;
		ОбъектПараметра.ЕдиницаИзмерения = ЕдиницаИзмерения;
		Если Значение <> Неопределено Тогда
			ОбъектПараметра.Значение = Значение;
		Иначе 
			ОбъектПараметра.Значение = Свойство.ТипЗначения.ПривестиЗначение();
		КонецЕсли;
	КонецЕсли;
	
	ОбъектПараметра.Родитель	 = Группа;
	ОбъектПараметра.Наименование = Имя;
	
	Если ЗначениеЗаполнено(СсылкаНового) Тогда 
		ОбъектПараметра.УстановитьСсылкуНового(СсылкаНового);
	КонецЕсли;
	
	Если НЕ НеЗаписыватьВБД И НЕ ЭтоГруппа Тогда 
		#Если Клиент Или ВнешнееСоединение Тогда 
			// гл. переменная
		#Иначе
			aps_СтруктураПараметровОповещения=aps_СтруктураПараметровОповещенияНаСервере;
		#КонецЕсли
		
		aps_СтруктураПараметровОповещения.Вставить("itemObject",itemObject);
		aps_СтруктураПараметровОповещения.Вставить("parameterObject",ОбъектПараметра);
		aps_ОбработчикиСобытий.aps_ВыполнитьСобытие(Перечисления.aps_События.ПриСозданииПараметра, aps_СтруктураПараметровОповещения);
	КонецЕсли;
	
	ОбъектПараметра.Записать();
	
	Если НЕ ЭтоГруппа Тогда 
		itemObject.Параметры.Добавить().Параметр = ОбъектПараметра.Ссылка;
	КонецЕсли;
		
	Возврат ОбъектПараметра.Ссылка;
		
КонецФункции

// Процедура изменяет атрибуты параметра
//
// Параметры:
//			ПараметрСсылка	 - ссылка на параметр
//			Имя 			 - Строка
//			Значение		 - Характеристика.aps_Свойства
//			Группа			 - ссылка на группу параметров
//			ЕдиницаИзмерения - СправочникСсылка.КлассификаторЕдиницИзмерения
// Возвращаемое значение:
//			Булево. Истина - параметр изменен, Ложь - параметр не изменен
// Пример:
//          ПараметрИзменен = МодульСозданияПараметров.aps_ИзменениеПараметра(parameterXDTO.reference, parameterXDTO.description, parameterXDTO.value, группаПараметров, parameterXDTO.unit);
//
Функция aps_ИзменениеПараметра( ПараметрСсылка, Имя = Неопределено, Значение = Неопределено, Группа = Неопределено, ЕдиницаИзмерения = Неопределено ) Экспорт;
	
	Если ПараметрСсылка = Неопределено Тогда 
		ВызватьИсключение "aps_ИзменениеПараметра: " + НСтр("ru = ""Неверно заданы входные параметры!""; en_US = ""Input parameters are incorrectly specified!""");
	КонецЕсли;
	
	Если Имя <> Неопределено И ПустаяСтрока(СокрЛП(Имя)) Тогда 
		ВызватьИсключение НСтр("ru = ""Пустое имя параметра недопустимо!""; en_US = ""Parameter description must be filled!""");
	КонецЕсли;
	
	ОбъектПараметра = ПараметрСсылка.ПолучитьОбъект();
	Если ОбъектПараметра = Неопределено Тогда 
		Возврат Ложь;
	КонецЕсли;
	
	Если Имя <> Неопределено И ОбъектПараметра.Наименование <> Имя Тогда
		ОбъектПараметра.Наименование = Имя;
	КонецЕсли;
	
	Если НЕ ОбъектПараметра.ЭтоГруппа Тогда
		Если Группа <> Неопределено И ОбъектПараметра.Родитель <> Группа Тогда 
			ОбъектПараметра.Родитель = Группа;
		КонецЕсли;
		
		Если ОбъектПараметра.Значение <> ОбъектПараметра.Свойство.ТипЗначения.ПривестиЗначение(Значение) Тогда
			ОбъектПараметра.Значение = ОбъектПараметра.Свойство.ТипЗначения.ПривестиЗначение(Значение);
		КонецЕсли;
			
		Если ЕдиницаИзмерения <> Неопределено И ОбъектПараметра.ЕдиницаИзмерения <> ЕдиницаИзмерения Тогда 
			ОбъектПараметра.ЕдиницаИзмерения = ЕдиницаИзмерения;
		КонецЕсли;
	КонецЕсли;
	
	Если ОбъектПараметра.Модифицированность() Тогда
		ОбъектПараметра.Записать();
		Возврат Истина; // параметр изменен
	КонецЕсли;
	
	Возврат Ложь;
КонецФункции

// Функция устанавливает значение параметра, если параметра нет - создает его
//
// Параметры:
//			itemObject - объект PDM-системы
//			Свойство - ПланыВидовХарактеристикСсылка.aps_Свойства
//			Значение - значение свойства
//			ИмяПараметраНеобяз - имя параметра (необязательно)
// Возвращаемое значение:
//		СправочникСсылка.aps_ПараметрыЭлементовТехнологии ИЛИ СправочникСсылка.aps_ПараметрыЭлементовИзделия
// Пример:
//		созданиеПараметров.aps_УстановкаПараметра(ОбъектСвязи, ПланыВидовХарактеристик.aps_Свойства.Количество, 1);
//
Функция aps_УстановкаПараметра( itemObject, Свойство, Значение, ИмяПараметраНеобяз = Неопределено ) Экспорт;
	
	Если Свойство=Неопределено Тогда
		Свойство=ПланыВидовХарактеристик.aps_Свойства.НайтиПоНаименованию(ИмяПараметраНеобяз);
	КонецЕсли;
	
	Если itemObject = Неопределено Или Не ЗначениеЗаполнено(Свойство) Тогда 
		ВызватьИсключение "aps_УстановкаПараметра: " + НСтр("ru = ""Неверно заданы входные параметры!""; en_US = ""Input parameters are incorrectly specified!""");
	КонецЕсли;
	
	Если ИмяПараметраНеобяз<>Неопределено Тогда 
		ПараметрСсылка = aps_ВспомНайтиПараметрПоСвойствуИИмени( itemObject, Свойство, ИмяПараметраНеобяз );
	Иначе
		ПараметрСсылка = aps_ВспомНайтиПараметрПоСвойству( itemObject, Свойство );
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ПараметрСсылка) Тогда
		Если ИмяПараметраНеобяз=Неопределено Тогда
			ИмяПараметра=Свойство.Наименование;
		Иначе
			ИмяПараметра=ИмяПараметраНеобяз;
		КонецЕсли;
		ПараметрСсылка = aps_СозданиеПараметра(itemObject, ИмяПараметра, Свойство, Значение);
	Иначе
		aps_ИзменениеПараметра(ПараметрСсылка,, Значение);
	КонецЕсли;
		
	Возврат ПараметрСсылка;
	
КонецФункции

// Функция определяет системный справочник по виду элемента
//
// Параметры:
//			ВидЭлемента - СправочникСсылка.aps_ВидыЭлементов
// Возвращаемое значение: 
//			СправочникМенеджер. Имя справочника хранения параметра
// Пример:
//			СправочникПараметров=МодульСозданияПараметров.aps_ПолучитьСправочникПараметров(itemXDTO.elementType);
//
Функция aps_ПолучитьСправочникПараметров( ВидЭлемента ) Экспорт;
	
	Если ВидЭлемента = Справочники.aps_ВидыЭлементов.Деталь
			ИЛИ ВидЭлемента = Справочники.aps_ВидыЭлементов.Комплекс
			ИЛИ ВидЭлемента = Справочники.aps_ВидыЭлементов.Комплект
			ИЛИ ВидЭлемента = Справочники.aps_ВидыЭлементов.СбЕдиница
			ИЛИ ВидЭлемента = Справочники.aps_ВидыЭлементов.ПакетЗамены
			ИЛИ ВидЭлемента = Справочники.aps_ВидыЭлементов.ВариантЗамены
			ИЛИ ВидЭлемента = Справочники.aps_ВидыЭлементов.ЛичнаяПапка
			ИЛИ ВидЭлемента = Справочники.aps_ВидыЭлементов.Документ
			ИЛИ ВидЭлемента = Справочники.aps_ВидыЭлементов.АктивныйДокументЧертежSolidWorks
			ИЛИ ВидЭлемента = Справочники.aps_ВидыЭлементов.АктивныйДокументДетальSolidWorks
			ИЛИ ВидЭлемента = Справочники.aps_ВидыЭлементов.АктивныйДокументСборкаSolidWorks
			ИЛИ ВидЭлемента = Справочники.aps_ВидыЭлементов.АктивныйДокументЧертежКОМПАС
			ИЛИ ВидЭлемента = Справочники.aps_ВидыЭлементов.АктивныйДокументДетальКОМПАС
			ИЛИ ВидЭлемента = Справочники.aps_ВидыЭлементов.АктивныйДокументСборкаКОМПАС
			ИЛИ ВидЭлемента = Справочники.aps_ВидыЭлементов.АктивныйДокументЧертежAutoCAD
			ИЛИ ВидЭлемента = Справочники.aps_ВидыЭлементов.АктивныйДокументДетальAutoCAD
			ИЛИ ВидЭлемента = Справочники.aps_ВидыЭлементов.АктивныйДокументСборкаAutoCAD
			ИЛИ ВидЭлемента = Справочники.aps_ВидыЭлементов.АктивныйДокументЧертежInventor
			ИЛИ ВидЭлемента = Справочники.aps_ВидыЭлементов.АктивныйДокументДетальInventor
			ИЛИ ВидЭлемента = Справочники.aps_ВидыЭлементов.АктивныйДокументСборкаInventor
			ИЛИ ВидЭлемента = Справочники.aps_ВидыЭлементов.АктивныйДокументЧертежSolidEdge
			ИЛИ ВидЭлемента = Справочники.aps_ВидыЭлементов.АктивныйДокументДетальSolidEdge
			ИЛИ ВидЭлемента = Справочники.aps_ВидыЭлементов.АктивныйДокументСборкаSolidEdge 
			
			ИЛИ ВидЭлемента = Справочники.aps_ВидыЭлементов.Оформление Тогда 
			
		Возврат Справочники.aps_ПараметрыЭлементовИзделия;
		
	Иначе
		
		Возврат Справочники.aps_ПараметрыЭлементовТехнологии;
	КонецЕсли;
	
КонецФункции


// Функция находит и возвращает ссылку на параметр элемента по свойству
//
// Параметры:
//			item - ссылка на элемент
//			Свойство - ПланыВидовХарактеристикСсылка.aps_Свойства
// Возвращаемое значение:
//		СправочникСсылка.aps_ПараметрыЭлементовТехнологии ИЛИ СправочникСсылка.aps_ПараметрыЭлементовИзделия
// Пример:
//      ПараметрСпособСозданияРевизии = МодульСозданияПараметров.aps_ВспомНайтиПараметрПоСвойству(item, ПланыВидовХарактеристик.aps_Свойства.СпособСозданияРевизии);
//
Функция aps_ВспомНайтиПараметрПоСвойству( item, Свойство ) Экспорт 
	Для Каждого СтрокаПараметра Из item.Параметры Цикл
		Если СтрокаПараметра.Параметр.Свойство = Свойство Тогда
			Возврат СтрокаПараметра.Параметр;
		КонецЕсли;
	КонецЦикла;
	Возврат Справочники.aps_ПараметрыЭлементовИзделия.ПустаяСсылка();
КонецФункции

// Функция находит и возвращает ссылку на параметр элемента по имени
//
// Параметры
//			item - ссылка на элемент
//			Имя	 - Строка
// Возвращаемое значение:
//		СправочникСсылка.aps_ПараметрыЭлементовТехнологии ИЛИ СправочникСсылка.aps_ПараметрыЭлементовИзделия
// Пример:
//      ПараметрСпособСозданияРевизии = МодульСозданияПараметров.aps_ВспомНайтиПараметрПоИмени(item, "Способ создания ревизии");
//
Функция aps_ВспомНайтиПараметрПоИмени( item, Имя ) Экспорт 
	Для Каждого СтрокаПараметра Из item.Параметры Цикл
		Если Врег(СокрЛП(СтрокаПараметра.Параметр.Наименование))=ВРег(СокрЛП(Имя)) Тогда
			Возврат СтрокаПараметра.Параметр;
		КонецЕсли;
	КонецЦикла;
	Возврат Справочники.aps_ПараметрыЭлементовИзделия.ПустаяСсылка();
КонецФункции

// Функция находит и возвращает ссылку на параметр элемента по свойству и имени
//
// Параметры:
//			item	 - ссылка на элемент
//			Свойство - ПланыВидовХарактеристикСсылка.aps_Свойства
//			Имя		 - Строка
// Возвращаемое значение:
//		СправочникСсылка.aps_ПараметрыЭлементовТехнологии ИЛИ СправочникСсылка.aps_ПараметрыЭлементовИзделия
// Пример:
//      ПараметрКомментарий = МодульСозданияПараметров.aps_ВспомНайтиПараметрПоСвойствуИИмени(item, ПланыВидовХарактеристик.aps_Свойства.Комментарий, "Комментарий 1");
//
Функция aps_ВспомНайтиПараметрПоСвойствуИИмени( item, Свойство, Имя ) Экспорт 
	Для Каждого СтрокаПараметра Из item.Параметры Цикл
		Если СтрокаПараметра.Параметр.Свойство = Свойство И Врег(СокрЛП(СтрокаПараметра.Параметр.Наименование))=ВРег(СокрЛП(Имя)) Тогда
			Возврат СтрокаПараметра.Параметр;
		КонецЕсли;
	КонецЦикла;
	Возврат Справочники.aps_ПараметрыЭлементовИзделия.ПустаяСсылка();
КонецФункции

// Функция находит и возвращает объект XDTO параметра по свойству
//
// Параметры:
//		itemXDTO - XDTO-объект типа "item"
//		Свойство - ПланыВидовХарактеристикСсылка.aps_Свойства
// Возвращаемое значение:
//		ОбъектXDTO
// Пример:
//		parameterXDTO = МодульСозданияПараметров.aps_ВспомНайтиПараметрПоСвойствуВXDTO( itemXDTO, ПараметрИлиСтрока );
//
Функция aps_ВспомНайтиПараметрПоСвойствуВXDTO( itemXDTO, Свойство, ФлагПараметраСвязи=Неопределено ) Экспорт 
	МассивПараметровXDTO=aps_СформироватьМассивПараметровИзМоделиXDTO(itemXDTO);
	Для Каждого parameterXDTO Из МассивПараметровXDTO Цикл
		Если parameterXDTO.property = Свойство 
