// Обработчик изменения текстового/числового параметра
// Параметры: element - COMОбъект
Функция JavaScriptTextChange( element ) Экспорт
	
	parameterSpan = aps_ПолучитьБлокПараметраИлиАтрибута(element);
	
	Если parameterSpan <> Неопределено Тогда 
		ИдентификаторПараметра = Новый УникальныйИдентификатор(parameterSpan.id);
		Если ОбъектXDTO <> Неопределено Тогда 
			parameterXDTO = aps_ВспомНайтиПараметрПоИдентификаторуВXDTO( ОбъектXDTO, ИдентификаторПараметра );
			Если parameterXDTO <> Неопределено Тогда 
				Если element.id = "f8fa361f-25d4-4361-8bc4-f3bc40252a54" Тогда 
					ЗначениеПараметра = parameterXDTO.property.ТипЗначения.ПривестиЗначение(element.value);
					parameterXDTO.value = ?(ЗначениеЗаполнено(ЗначениеПараметра), СериализаторXDTO.ЗаписатьXDTO(ЗначениеПараметра), Неопределено);	
					element.value = Строка(ЗначениеПараметра);
					
					parentItemXDTO = ОбъектXDTO.Владелец();
					parentItemXDTO = ?(parentItemXDTO<>Неопределено И parentItemXDTO.refLinkGroup, parentItemXDTO.Владелец(), parentItemXDTO);
					Если parameterXDTO.linkParameter=Истина Тогда 
						Если parentItemXDTO<>Неопределено Тогда 
							parentItemXDTO.modified = Истина;
						КонецЕсли;
					Иначе 
						aps_ОбновитьПредставлениеВМоделиXDTO( ОбъектXDTO );
						ОбъектXDTO.modified = Истина;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
		
КонецФункции

// Обработчик изменения ссылочного параметра
// Параметры: element - COMОбъект
Функция JavaScriptHyperLinkChange( element ) Экспорт
	
	parameterSpan = aps_ПолучитьБлокПараметраИлиАтрибута(element);
	
	Если parameterSpan <> Неопределено Тогда 
		ИдентификаторПараметра = Новый УникальныйИдентификатор(parameterSpan.id);
		Если ОбъектXDTO <> Неопределено Тогда 
			parameterXDTO = aps_ВспомНайтиПараметрПоИдентификаторуВXDTO(ОбъектXDTO, ИдентификаторПараметра);
			Если parameterXDTO <> Неопределено Тогда 
				Если element.id = "f8fa361f-25d4-4361-8bc4-f3bc40252a54" Тогда 
					ЗначениеПараметра=parameterXDTO.value;
					Свойство=parameterXDTO.property;
					ТипЗначенияСвойства=Свойство.ТипЗначения;
					ЗначениеВыбрано=Ложь;
					
					///////////////////////////////////////////////////////////////////////////////////////////////////
					// выбор значения параметра с помощью спец. обработки
					Если ЗначениеЗаполнено(Свойство.ОбработкаВыбораЗначения) Тогда
						aps_СтруктураПараметровОповещения.Вставить("property", Свойство);
						
						ЗначениеПараметра=aps_ОткрытьФормуВыбораЗначения(Неопределено, Новый Структура("Значение", ЗначениеПараметра), Свойство);
						Если ЗначениеПараметра=Неопределено Тогда 
							Возврат Ложь;
						КонецЕсли;
						ЗначениеВыбрано=Истина;
					КонецЕсли;
					
					Если ЗначениеВыбрано Или ВвестиЗначение(ЗначениеПараметра, parameterXDTO.description, ТипЗначенияСвойства) Тогда
						parameterXDTO.value = ?(ЗначениеЗаполнено(ЗначениеПараметра), СериализаторXDTO.ЗаписатьXDTO(ЗначениеПараметра), Неопределено);
						element.innerText = ?(ЗначениеЗаполнено(ЗначениеПараметра), Строка(ЗначениеПараметра), НСтр("ru = ""(нет)""; en_US = ""(no)"""));
						
						parentItemXDTO = ОбъектXDTO.Владелец();
						parentItemXDTO = ?(parentItemXDTO<>Неопределено И parentItemXDTO.refLinkGroup, parentItemXDTO.Владелец(), parentItemXDTO);
						Если parameterXDTO.linkParameter=Истина Тогда 
							Если parentItemXDTO<>Неопределено Тогда 
								parentItemXDTO.modified = Истина;
							КонецЕсли;
						Иначе
							aps_ОбновитьПредставлениеВМоделиXDTO( ОбъектXDTO );
							ОбъектXDTO.modified = Истина;
						КонецЕсли;
					КонецЕсли;
				ИначеЕсли element.id = "eaea1a2e-0dc3-4520-876e-01072eaaafd1" Тогда 
					ЕдиницаИзмерения = parameterXDTO.unit;
					Если ВвестиЗначение(ЕдиницаИзмерения, НСтр("ru = ""Единицы измерения (""; en_US = ""Measurement units (""")+parameterXDTO.description+")", Тип("СправочникСсылка.КлассификаторЕдиницИзмерения")) Тогда
