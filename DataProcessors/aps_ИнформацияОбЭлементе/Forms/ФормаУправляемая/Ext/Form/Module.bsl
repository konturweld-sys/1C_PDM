
#Если НЕ МобильноеПриложениеКлиент Тогда

#Область ОбработчикиСобытийФормы
	
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОбработкаОповещения("AppiusWindowGeneralNotify", aps_СтруктураПараметровОповещения, Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	Если Модифицированность Тогда
		Ответ = Вопрос(НСтр("ru = ""Принять внесенные изменения?""; en_US = ""Accept changes?"""), РежимДиалогаВопрос.ДаНет, 0, КодВозвратаДиалога.Да);
		Если Ответ = КодВозвратаДиалога.Да Тогда
			Применить(Неопределено);
		Иначе 
			Восстановить(Неопределено);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "AppiusWindowGeneralNotify" Тогда 
		// Не реагировать на оповещение вообще
		Если НеРеагироватьНаОповещение Тогда 
			Возврат;
		КонецЕсли;
		
		// Не реагировать на оповещение от подчиненной формы и от самой себя
		ВладелецФормыИсточника = Источник;
		Пока ВладелецФормыИсточника <> Неопределено Цикл 
			Если ВладелецФормыИсточника = ЭтаФорма Тогда 
				Возврат;
			КонецЕсли;
			Если ТипЗнч(ВладелецФормыИсточника)=Тип("УправляемаяФорма") Тогда 
				ВладелецФормыИсточника = ВладелецФормыИсточника.ВладелецФормы;
			Иначе 
				ВладелецФормыИсточника = Неопределено;
			КонецЕсли;
		КонецЦикла;
		
		ПередЗакрытием(Неопределено, Неопределено);
		
		Если Параметр.Свойство("item") И ЗначениеЗаполнено(Параметр.item) Тогда 
			Объект.item = Параметр.item;
		ИначеЕсли Источник <> Неопределено Тогда 
			Возврат;
		КонецЕсли;
		
		ОбновлениеИнформацииВОкне();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	Попытка
		СписокПараметров.НайтиПоИдентификатору(ИсточникВыбора.КлючУникальности).Значение = ВыбранноеЗначение;
	Исключение
	КонецПопытки;
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Восстановить(Команда)
	ОбновлениеИнформацииВОкне();
	Модифицированность = Ложь;
	
	ДоступностьКнопкиПрименить();
КонецПроцедуры

&НаКлиенте
Процедура Применить(Команда)
	КнопкаПрименить();
	Модифицированность = Ложь;
	
	ОтобразитьИзменениеДанных(Объект.item, ВидИзмененияДанных.Изменение);
	ОбновлениеИнформацииВОкне();
	ДоступностьКнопкиПрименить();
КонецПроцедуры

&НаКлиенте
Процедура НоваяГруппа(Команда)
	НоваяСтрока = СписокПараметров.ПолучитьЭлементы().Добавить();
	НоваяСтрока.ЭтоГруппа = Истина;
	НоваяСтрока.Картинка  = 1;
	Элементы.СписокПараметров.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
	Если Элементы.СписокПараметровИмя.Видимость Тогда
		Элементы.СписокПараметров.ТекущийЭлемент = Элементы.СписокПараметровИмя;
	КонецЕсли;
	Элементы.СписокПараметров.ИзменитьСтроку();
	ПолеПриИзменении(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьВПредставление(Команда)
	ТекущаяСтрока = Элементы.СписокПараметров.ТекущиеДанные; // копия строки
	Если ТекущаяСтрока <> Неопределено И НЕ ТекущаяСтрока.ЭтоГруппа Тогда
		Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.Ссылка) Тогда 
			Предупреждение(НСтр("ru = ""Необходимо записать новый параметр!""; en_US = ""New parameter must be saved!"""));
			Возврат;
		КонецЕсли;
		ПредставлениеЭлемента.Добавить().Параметр = ТекущаяСтрока.Ссылка;
		ПолеПриИзменении(Неопределено);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийСпискаПараметров

&НаКлиенте
Процедура СписокПараметровПриАктивизацииСтроки(Элемент)
	ТекущаяСтрока=Элемент.ТекущиеДанные;   // копия строки
	Если ТекущаяСтрока<>Неопределено Тогда	
		Если ВводДоступен() И ТекущийЭлемент=Элемент 
				И ЗначениеЗаполнено(ТекущаяСтрока.Ссылка) И НЕ ТекущаяСтрока.ЭтоГруппа Тогда 
			aps_СтруктураПараметровОповещения.Вставить("parameter",ТекущаяСтрока.Ссылка);
			Оповестить("AppiusWindowParameterNotify", aps_СтруктураПараметровОповещения, ЭтаФорма);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СписокПараметровПередУдалением(Элемент, Отказ)
	ТекущаяСтрока = Элемент.ТекущиеДанные;  // копия строки
	Если ТекущаяСтрока <> Неопределено И ЗначениеЗаполнено(ТекущаяСтрока.Ссылка) Тогда 
		ТекстВопроса = ?(ТекущаяСтрока.ЭтоГруппа, НСтр("ru = ""Удалить группу параметров?""; en_US = ""Delete parameters folder?"""), НСтр("ru = ""Удалить параметр?""; en_US = ""Delete parameter?"""));
		Если Вопрос(ТекстВопроса, РежимДиалогаВопрос.ДаНет, 60, КодВозвратаДиалога.Да) <> КодВозвратаДиалога.Да Тогда 
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СписокПараметровПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	Отказ = Истина;
	ТекущаяСтрока = Элемент.ТекущиеДанные; // копия строки
	
	Если ТекущаяСтрока<>Неопределено И ТекущаяСтрока.ЭтоГруппа И Не Копирование Тогда 
		НоваяСтрока = ТекущаяСтрока.ПолучитьЭлементы().Добавить();
	ИначеЕсли ТекущаяСтрока<>Неопределено И ТекущаяСтрока.ПолучитьРодителя()<>Неопределено Тогда 
		НоваяСтрока = ТекущаяСтрока.ПолучитьРодителя().ПолучитьЭлементы().Добавить();
	Иначе 
		НоваяСтрока = СписокПараметров.ПолучитьЭлементы().Добавить();
	КонецЕсли;
	
	Если Копирование Тогда 
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущаяСтрока,, "Ссылка");
	Иначе 
		НоваяСтрока.ЭтоГруппа = Ложь;
		НоваяСтрока.Картинка  = 0;
	КонецЕсли;
	
	Элемент.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
	Если Не НоваяСтрока.ЭтоГруппа И Элементы.СписокПараметровСвойство.Видимость Тогда
		Элемент.ТекущийЭлемент = Элементы.СписокПараметровСвойство;
	КонецЕсли;
	
	Элемент.ИзменитьСтроку();
	ПолеПриИзменении(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура СписокПараметровПередНачаломИзменения(Элемент, Отказ)
	ТекущаяСтрока = Элемент.ТекущиеДанные; // копия строки
	Если ТекущаяСтрока <> Неопределено И ЗначениеЗаполнено(ТекущаяСтрока.Ссылка) И НЕ ТекущаяСтрока.ЭтоГруппа Тогда 
		Отказ = НЕ ПроверитьПравоИзмененияСервер(ТекущаяСтрока.Ссылка); 
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СписокПараметровНачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка)
	Строка = СписокПараметров.НайтиПоИдентификатору(ПараметрыПеретаскивания.Значение);
	Если Строка.ЭтоГруппа Тогда
		СтандартнаяОбработка = Ложь;
	Иначе 
		ПараметрыПеретаскивания.Значение = Строка.Ссылка;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СписокПараметровПроверкаПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	Если Строка <> Неопределено Тогда
		текСтрока = СписокПараметров.НайтиПоИдентификатору(Строка);
	Иначе
		текСтрока = Неопределено;
	КонецЕсли;
	
	Если (текСтрока=Неопределено ИЛИ текСтрока.ЭтоГруппа) И ОписаниеТиповПараметра.СодержитТип(ТипЗнч(ПараметрыПеретаскивания.Значение)) Тогда 
		ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Перемещение;
	Иначе
		ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Отмена;
	КонецЕсли;
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура СписокПараметровПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	СтандартнаяОбработка = Ложь;
	
	ЗначениеПеретаскивания = ПараметрыПеретаскивания.Значение;
	СтрокиСпискаПараметров = СписокПараметров.ПолучитьЭлементы();
	Строки = ?(Строка=Неопределено, СтрокиСпискаПараметров, СписокПараметров.НайтиПоИдентификатору(Строка).ПолучитьЭлементы());
	СтрокаИсточник = НайтиСтрокуВДеревеПоСсылке(СтрокиСпискаПараметров, ЗначениеПеретаскивания);
	Если СтрокаИсточник <> Неопределено Тогда 
		ЗаполнитьЗначенияСвойств(Строки.Добавить(), СтрокаИсточник);
		// удалить строку, если перетаскивали из этого списка
		Если СтрокаИсточник.ПолучитьРодителя() = Неопределено Тогда 
			СтрокиСпискаПараметров.Удалить(СтрокиСпискаПараметров.Индекс(СтрокаИсточник));
		Иначе 
			СтрокаИсточник.ПолучитьРодителя().ПолучитьЭлементы().Удалить(СтрокаИсточник.ПолучитьРодителя().ПолучитьЭлементы().Индекс(СтрокаИсточник));
		КонецЕсли;
		
	Иначе 
		
		СтруктураПолей = ПолучитьСтруктуруЗначенийПолейСервер(ЗначениеПеретаскивания);
		Если Строка = Неопределено И ЗначениеЗаполнено(СтруктураПолей.Родитель) Тогда 
			СтрокаРодителя = НайтиСтрокуВДеревеПоСсылке(СтрокиСпискаПараметров, СтруктураПолей.Родитель);
			Если СтрокаРодителя = Неопределено Тогда 
				СтрокаРодителя = СтрокиСпискаПараметров.Добавить();
				СтрокаРодителя.Имя = Строка(СтруктураПолей.Родитель);
				СтрокаРодителя.Картинка = 1;
				СтрокаРодителя.Ссылка = СтруктураПолей.Родитель;
			КонецЕсли;
			Строки = СтрокаРодителя.ПолучитьЭлементы();
		КонецЕсли;
		
		НоваяСтрока = Строки.Добавить();
		НоваяСтрока.Имя = Строка(ЗначениеПеретаскивания);
		НоваяСтрока.Картинка = 0;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтруктураПолей);
	КонецЕсли;
	
	ПолеПриИзменении(Элемент);
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиЭлементовФормы

&НаКлиенте
Процедура НадписьСоздатьРевизиюНажатие(Элемент)
	МассивЭлементов = Новый Массив;
	МассивЭлементов.Добавить(Объект.item);
	ОткрытьФорму("Обработка.aps_СозданиеРевизий.Форма", Новый Структура("КорневыеЭлементы", МассивЭлементов));
КонецПроцедуры

&НаКлиенте
Процедура СписокПараметровСвойствоПриИзменении(Элемент)
	ТекущаяСтрока = Элемент.Родитель.ТекущиеДанные;
	Если ПустаяСтрока(ТекущаяСтрока.Имя) Тогда
		ТекущаяСтрока.Имя = Строка(ТекущаяСтрока.Свойство);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НаименованиеПриИзменении(Элемент)
	НаименованиеПриИзмененииСервер(Наименование);
	ПолеПриИзменении(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ОбозначениеПриИзменении(Элемент)
	ОбозначениеПриИзмененииСервер(Обозначение);
	ПолеПриИзменении(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ВладелецПриИзменении(Элемент)
	СтрокаПредупреждения = "";
	ВладелецПриИзмененииСервер(Владелец, СтрокаПредупреждения);
	Если Не ПустаяСтрока(СтрокаПредупреждения) Тогда
		Предупреждение(СтрокаПредупреждения);
	КонецЕсли;
	ПолеПриИзменении(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ПредставлениеПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	Если Не Копирование Тогда 
		Отказ = Истина;
		ПредставлениеЭлемента.Добавить().Параметр = ""; // пустая строка
		ПолеПриИзменении(Неопределено);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПредставлениеПередНачаломИзменения(Элемент, Отказ)
	Если ТипЗнч(Элемент.ТекущиеДанные.Параметр) <> Тип("Строка") Тогда 
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПредставлениеПроверкаПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	Если ОписаниеТиповПараметра.СодержитТип(ТипЗнч(ПараметрыПеретаскивания.Значение)) Тогда 
		ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Копирование;
	Иначе
		ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Отмена;
	КонецЕсли;
	СтандартнаяОбработка = Ложь;
КонецПроцедуры
                         
&НаКлиенте
Процедура ПредставлениеПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	ПредставлениеЭлемента.Добавить().Параметр = ПараметрыПеретаскивания.Значение;
	ПолеПриИзменении(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ПолеПриИзменении(Элемент)
	ОпределитьТипПараметраВПредставлении();
	
	Модифицированность = Истина;
	ДоступностьКнопкиПрименить();
КонецПроцедуры

#КонецОбласти


#Область ОбновлениеДанныхФормы

&НаКлиенте
Процедура ОбновлениеИнформацииВОкне()
	СтруктураПравПользователя = Новый Структура();
	ОбновлениеИнформацииВОкнеСервер(СтруктураПравПользователя);
	
	Если ЗначениеЗаполнено( Объект.item ) Тогда 
		ИзменениеИПросмотр = СтруктураПравПользователя.Изменение И СтруктураПравПользователя.Просмотр;
		ИзменениеВладельца = СтруктураПравПользователя.ИзменениеВладельца;
		
		Если ИзменениеИПросмотр Тогда 
			Элементы.Обозначение.ТолькоПросмотр	= ?(СтруктураПравПользователя.Свойство("ИзменениеОбозначения"), Не СтруктураПравПользователя.ИзменениеОбозначения, Ложь);
			Элементы.Наименование.ТолькоПросмотр= ?(СтруктураПравПользователя.Свойство("ИзменениеНаименования"), Не СтруктураПравПользователя.ИзменениеНаименования, Ложь);
		Иначе 
			Элементы.Обозначение.ТолькоПросмотр	= Истина;
			Элементы.Наименование.ТолькоПросмотр= Истина;
		КонецЕсли;
		
		Элементы.СписокПараметров.ТолькоПросмотр	= НЕ ИзменениеИПросмотр;
		Элементы.Представление.ТолькоПросмотр		= НЕ ИзменениеИПросмотр;
		
		Элементы.СписокПараметровНоваяГруппа.Доступность= ИзменениеИПросмотр;
		Элементы.ДобавитьВПредставление.Доступность		= ИзменениеИПросмотр;
		
		Элементы.Владелец.ТолькоПросмотр	= НЕ ИзменениеВладельца;
		Элементы.Группа.ТолькоПросмотр		= НЕ ИзменениеВладельца;
		
		Элементы.НадписьСоздатьРевизию.Доступность = Истина;
		
		Заголовок = "Свойства: "+Строка(Объект.item);
		
		Для Каждого СтрокаПараметра Из СписокПараметров.ПолучитьЭлементы() Цикл 
			Элементы.СписокПараметров.Развернуть(СтрокаПараметра.ПолучитьИдентификатор());
		КонецЦикла;
		
	Иначе 
		
		Элементы.СписокПараметров.ТолькоПросмотр	= Истина;
		Элементы.Представление.ТолькоПросмотр		= Истина;
		
		Элементы.СписокПараметровНоваяГруппа.Доступность= Ложь;
		Элементы.ДобавитьВПредставление.Доступность		= Ложь;
		
		Элементы.Обозначение.ТолькоПросмотр	= Истина;
		Элементы.Наименование.ТолькоПросмотр= Истина;
			
		Элементы.Владелец.ТолькоПросмотр	= Истина;
		Элементы.Группа.ТолькоПросмотр		= Истина;
		
		Элементы.НадписьСоздатьРевизию.Доступность = Ложь;
		
		Заголовок = "Свойства";
	КонецЕсли;

	ОпределитьТипПараметраВПредставлении();
	
КонецПроцедуры

&НаКлиенте
Процедура ДоступностьКнопкиПрименить()
	Элементы.Применить.Доступность = Модифицированность;
КонецПроцедуры

#КонецОбласти

#КонецЕсли


#Область ПрочиеПроцедурыИФункции

#Если НЕ МобильноеПриложениеКлиент Тогда

&НаКлиенте
Функция НайтиСтрокуВДеревеПоСсылке(Строки, Значение)
	Для Каждого Строка Из Строки Цикл
		Если Строка.Ссылка=Значение Тогда
			Возврат Строка;
		КонецЕсли;

		НайденнаяСтрока = НайтиСтрокуВДеревеПоСсылке(Строка.ПолучитьЭлементы(), Значение);
		Если НайденнаяСтрока <> Неопределено Тогда 
			Возврат НайденнаяСтрока;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Процедура ОпределитьТипПараметраВПредставлении()
	Для Каждого СтрокаПредставления Из ПредставлениеЭлемента Цикл 
		СтрокаПредставления.ЭтоПустаяСтрока = Ложь;
		СтрокаПредставления.ЭтоПробел = Ложь;
		СтрокаПредставления.ЭтоСтроковыйПараметр = Ложь;
		Если ТипЗнч(СтрокаПредставления.Параметр)=Тип("Строка") Тогда 
			СтрокаПредставления.ЭтоСтроковыйПараметр = Истина;
			Если СтрДлина(СтрокаПредставления.Параметр) = 0 Тогда 
				СтрокаПредставления.ЭтоПустаяСтрока = Истина;
			ИначеЕсли СтрДлина(СокрЛП(СтрокаПредставления.Параметр)) = 0 Тогда 
				СтрокаПредставления.ЭтоПробел = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

#КонецЕсли              


#Если НЕ МобильноеПриложениеСервер Тогда

&НаСервере
Процедура ОбновитьПараметры(СтруктураПрав)
	ЭтотОбъектИБ = РеквизитФормыВЗначение("Объект");
	
	ДеревоПараметров = aps_ПолучитьДеревоПараметров(Объект.item);
	
	СтрокаПараметра = ДеревоПараметров.Строки.Найти(ПланыВидовХарактеристик.aps_Свойства.Наименование, "Свойство", Истина);
	Наименование = ?(СтрокаПараметра <> Неопределено, СтрокаПараметра.Значение, "");
	Если СтрокаПараметра <> Неопределено Тогда 
		СтруктураПрав.Вставить("ИзменениеНаименования", ЭтотОбъектИБ.МодульПравДоступа.aps_ПроверитьОбъектПрава(Справочники.aps_Права.Изменение, СтрокаПараметра.Ссылка, СтрокаПараметра.Ссылка.GMOD));
	КонецЕсли;
	
	СтрокаПараметра = ДеревоПараметров.Строки.Найти(ПланыВидовХарактеристик.aps_Свойства.Обозначение, "Свойство", Истина);
	Обозначение = ?(СтрокаПараметра <> Неопределено, СтрокаПараметра.Значение, "");
	Если СтрокаПараметра <> Неопределено Тогда 
		СтруктураПрав.Вставить("ИзменениеОбозначения", ЭтотОбъектИБ.МодульПравДоступа.aps_ПроверитьОбъектПрава(Справочники.aps_Права.Изменение, СтрокаПараметра.Ссылка, СтрокаПараметра.Ссылка.GMOD));
	КонецЕсли;
	
	СтрокаПараметра = ДеревоПараметров.Строки.Найти(ПланыВидовХарактеристик.aps_Свойства.НомерРевизии, "Свойство", Истина);
	НомерРевизии = ?(СтрокаПараметра <> Неопределено, СтрокаПараметра.Значение, "");
	
	СтрокаПараметра = ДеревоПараметров.Строки.Найти(ПланыВидовХарактеристик.aps_Свойства.Состояние, "Свойство", Истина);
	Состояние = ?(СтрокаПараметра <> Неопределено, СтрокаПараметра.Значение, Неопределено);
	
	ЗначениеВРеквизитФормы(ДеревоПараметров, "СписокПараметров");
КонецПроцедуры

&НаСервере
Процедура ОбновитьПредставление(СтруктураПрав)
	локПредставлениеЭлемента = Объект.item.ПредставлениеЭлемента.Выгрузить();
	локПредставлениеЭлемента.Колонки.Добавить("ЭтоПустаяСтрока");
	локПредставлениеЭлемента.Колонки.Добавить("ЭтоПробел");
	локПредставлениеЭлемента.Колонки.Добавить("ЭтоСтроковыйПараметр");
	ЗначениеВРеквизитФормы(локПредставлениеЭлемента, "ПредставлениеЭлемента");
КонецПроцедуры

&НаСервере
Функция ПолучитьСтруктуруЗначенийПолейСервер(Ссылка)
	СтруктураПолей = Новый Структура;
	Для Каждого Реквизит Из Ссылка.Метаданные().СтандартныеРеквизиты Цикл 
		СтруктураПолей.Вставить(Реквизит.Имя, Ссылка[Реквизит.Имя]);
	КонецЦикла;
	Для Каждого Реквизит Из Ссылка.Метаданные().Реквизиты Цикл 
		СтруктураПолей.Вставить(Реквизит.Имя, Ссылка[Реквизит.Имя]);
	КонецЦикла;
	Возврат СтруктураПолей;
КонецФункции

&НаСервере
Процедура ЗаписатьПараметрыРек( ЭлементОбъект, Строки )
	ЭтотОбъектИБ = РеквизитФормыВЗначение("Объект");
	Для Каждого СтрокаПараметра Из Строки Цикл 
		ГруппаРодитель = Неопределено;
		Если СтрокаПараметра.Родитель <> Неопределено Тогда 
			ГруппаРодитель = СтрокаПараметра.Родитель.Ссылка;
		ИначеЕсли ЗначениеЗаполнено(СтрокаПараметра.Ссылка) Тогда 
			ГруппаРодитель = Справочники[СтрокаПараметра.Ссылка.Метаданные().Имя].ПустаяСсылка();
		КонецЕсли;
		
		СтрокаПараметра.Ссылка = ЭтотОбъектИБ.МодульСозданияПараметров.aps_СозданиеПараметра( ЭлементОбъект, СтрокаПараметра.Имя, СтрокаПараметра.Свойство, СтрокаПараметра.Значение, СтрокаПараметра.ЭтоГруппа, ГруппаРодитель, СтрокаПараметра.ЕдиницаИзмерения, СтрокаПараметра.Ссылка);
		
		ЭтотОбъектИБ.МодульСозданияПараметров.aps_ИзменениеПараметра(СтрокаПараметра.Ссылка, СтрокаПараметра.Имя, СтрокаПараметра.Значение, ГруппаРодитель, СтрокаПараметра.ЕдиницаИзмерения);
		
		Если СтрокаПараметра.ЭтоГруппа Тогда
			ЗаписатьПараметрыРек( ЭлементОбъект, СтрокаПараметра.Строки );
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура НаименованиеПриИзмененииСервер(Значение)
	локСписокПараметров = РеквизитФормыВЗначение("СписокПараметров");
	СтрокаСвойства = локСписокПараметров.Строки.Найти(ПланыВидовХарактеристик.aps_Свойства.Наименование, "Свойство", Истина);
	Если СтрокаСвойства <> Неопределено Тогда
		СтрокаСвойства.Значение	= Значение;
	Иначе
		НовыйПараметр = локСписокПараметров.Строки.Добавить();
		НовыйПараметр.ЭтоГруппа	= Ложь;
		НовыйПараметр.Имя		= "Наименование";
		НовыйПараметр.Свойство	= ПланыВидовХарактеристик.aps_Свойства.Наименование;
		НовыйПараметр.Значение	= Значение;
	КонецЕсли;
	ЗначениеВРеквизитФормы(локСписокПараметров, "СписокПараметров");
КонецПроцедуры

&НаСервере
Процедура ОбозначениеПриИзмененииСервер(Значение)
	локСписокПараметров = РеквизитФормыВЗначение("СписокПараметров");
	СтрокаСвойства = локСписокПараметров.Строки.Найти(ПланыВидовХарактеристик.aps_Свойства.Обозначение, "Свойство", Истина);
	Если СтрокаСвойства <> Неопределено Тогда 
		СтрокаСвойства.Значение	= Значение;
	Иначе
		НовыйПараметр = локСписокПараметров.Строки.Добавить();
		НовыйПараметр.ЭтоГруппа	= Ложь;
		НовыйПараметр.Имя		= "Обозначение";
		НовыйПараметр.Свойство	= ПланыВидовХарактеристик.aps_Свойства.Обозначение;
		НовыйПараметр.Значение	= Значение;
	КонецЕсли;
	ЗначениеВРеквизитФормы(локСписокПараметров, "СписокПараметров");
КонецПроцедуры

&НаСервере
Процедура ВладелецПриИзмененииСервер(ЗначениеВладельца, СтрокаИнфо = "")
	Если ЗначениеЗаполнено(ЗначениеВладельца) И ТипЗнч(ЗначениеВладельца)=Тип("ПеречислениеСсылка.aps_СистемныеГруппы")
			И ЗначениеВладельца<>Перечисления.aps_СистемныеГруппы.Администраторы Тогда 
		ЗначениеВладельца = Перечисления.aps_СистемныеГруппы.Администраторы;	
		СтрокаИнфо = НСтр("ru = ""В качестве владельца может быть выбрана только системная группа <""; en_US = ""Only <""")+Строка(Перечисления.aps_СистемныеГруппы.Администраторы)+НСтр("ru = "">!""; en_US = ""> system group can be selected as the owner.""");
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПроверитьПравоИзмененияСервер(Ссылка)
	Возврат РеквизитФормыВЗначение("Объект").МодульПравДоступа.aps_ПроверитьОбъектПрава(Справочники.aps_Права.Изменение, Ссылка, Ссылка.GMOD);
КонецФункции

&НаСервере
Функция КнопкаПрименить()
	Попытка
		
		НачатьТранзакцию();
			
 			ЭлементОбъект = Объект.item.ПолучитьОбъект();
			ЭлементОбъект.Параметры.Очистить();
			
			// Запись параметров
			локСписокПараметров = РеквизитФормыВЗначение("СписокПараметров");
			ЗаписатьПараметрыРек( ЭлементОбъект, локСписокПараметров.Строки );
			
			ЭлементОбъект.UID = Владелец;
			ЭлементОбъект.GID = Группа;
			
			ЭлементОбъект.ПредставлениеЭлемента.Загрузить( РеквизитФормыВЗначение("ПредставлениеЭлемента") );
			
			ЭлементОбъект.Записать();
			
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		Сообщить(ПараметрыСеанса.aps_ИмяПродукта + НСтр("ru = ""Ошибка записи изменений:""; en_US = ""Write error:""") + Символы.ПС + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), СтатусСообщения.Внимание);
		
	КонецПопытки;
КонецФункции

&НаСервере
Процедура ОбновлениеИнформацииВОкнеСервер(СтруктураПрав)
	ЭтотОбъектИБ = РеквизитФормыВЗначение("Объект");
	Если ЗначениеЗаполнено( Объект.item ) Тогда 
		
		Просмотр  = ЭтотОбъектИБ.МодульПравДоступа.aps_ПроверитьОбъектПрава( Справочники.aps_Права.Просмотр, Объект.item, Объект.item.GMOD );
		СтруктураПрав.Вставить("Просмотр", Просмотр);
		Изменение = ЭтотОбъектИБ.МодульПравДоступа.aps_ПроверитьОбъектПрава( Справочники.aps_Права.Изменение, Объект.item, Объект.item.GMOD );
		СтруктураПрав.Вставить("Изменение", Изменение);
		ИзменениеВладельца = aps_ЯАдмин() ИЛИ (Объект.item.UID=ПараметрыСеанса.ТекущийПользователь);
		СтруктураПрав.Вставить("ИзменениеВладельца", ИзменениеВладельца);
		
		
		ВидЭлемента	= Объект.item.ВидЭлемента;
		Владелец	= Объект.item.UID;
		Группа		= Объект.item.GID;
		
		Дата		= Объект.item.Дата;
		
		// очистить список параметров
		СписокПараметров.ПолучитьЭлементы().Очистить();
		Наименование	= Неопределено;
		Обозначение		= Неопределено;
		НомерРевизии	= Неопределено;
		Состояние		= Неопределено;
		
		// очистить представление
		ПредставлениеЭлемента.Очистить();
			
		Если Просмотр Тогда 	
			ОбновитьПараметры(СтруктураПрав);
			ОбновитьПредставление(СтруктураПрав);
		КонецЕсли;
	
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Объект.item = Справочники.aps_ЭлементыИзделия.ПустаяСсылка();
	
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("СправочникСсылка.aps_ПараметрыЭлементовИзделия"));
	МассивТипов.Добавить(Тип("СправочникСсылка.aps_ПараметрыЭлементовТехнологии"));
	ОписаниеТиповПараметра = Новый ОписаниеТипов(МассивТипов);
	
	НеРеагироватьНаОповещение = Ложь;
	
КонецПроцедуры

#КонецЕсли

#КонецОбласти