// Функция возвращает таблицу значений из найденных элементов.
//
// Параметры:
// 		СтрокаПоиска – Строка. Строка, по которой осуществляется поиск.
// 		ИскатьСредиЭлементов – Булево. Признак поиска среди элементов.
// 		ВидЭлемента - СправочникСсылка.aps_ВидыЭлементов. Вид элемента состава.
//
// Возвращаемое значение:
// 		ТаблицаЗначений. Найденные элементы.
//
// Пример:
//		РезультатыПоиска = aps_Поиск(СтруктураУсловий, МассивВходящихЭлементов);
//
Функция aps_Поиск( СтруктураУсловий, ЭлементыДляПроверки = Неопределено ) Экспорт
	Перем СтрокаПоиска, ВидЭлемента, СозданНеРанее, СозданНеПозже, Владелец, Группа, НаличиеФайлов, ИмяФайла;
		
	СтруктураУсловий.Свойство("СтрокаПоиска"	, СтрокаПоиска);
	СтруктураУсловий.Свойство("ВидЭлемента"		, ВидЭлемента);
	СтруктураУсловий.Свойство("СозданНеРанее"	, СозданНеРанее);
	СтруктураУсловий.Свойство("СозданНеПозже"	, СозданНеПозже);
	СтруктураУсловий.Свойство("Владелец"		, Владелец);
	СтруктураУсловий.Свойство("Группа"			, Группа);
	
	СтруктураУсловий.Свойство("НаличиеФайлов"	, НаличиеФайлов);
	СтруктураУсловий.Свойство("ИмяФайла"		, ИмяФайла);
	
	СвойстваДляПоиска = Неопределено;
	СтруктураУсловий.Свойство("СвойстваДляПоиска", СвойстваДляПоиска);
	
	ТекстРасширенногоПоиска = Неопределено;
	СтруктураУсловий.Свойство("ТекстРасширенногоПоиска", ТекстРасширенногоПоиска);
	
	Если ЗначениеЗаполнено(ТекстРасширенногоПоиска) Тогда
		// расширенный поиск
		Запрос = Новый Запрос("ВЫБРАТЬ
		                      |	СправочникЭлементов.ЭлементСсылка,
		                      |	СправочникЭлементов.ЭлементСсылка.ВидЭлемента КАК ВидЭлемента,
		                      |	СправочникЭлементов.ЭлементСсылка.Наименование КАК ПредставлениеЭлемента,
		                      |	ВЫБОР
		                      |		КОГДА СправочникЭлементов.ЭлементСсылка.ИндексКартинки = 0
		                      |			ТОГДА СправочникЭлементов.ЭлементСсылка.ВидЭлемента.ИндексКартинки
		                      |		ИНАЧЕ СправочникЭлементов.ЭлементСсылка.ИндексКартинки
		                      |	КОНЕЦ КАК Картинка
		                      |ИЗ
		                      |	(ВЫБРАТЬ
		                      |		aps_ЭлементыИзделия.Ссылка КАК ЭлементСсылка
		                      |	ИЗ
		                      |		Справочник.aps_ЭлементыИзделия КАК aps_ЭлементыИзделия
		                      |	ГДЕ
		                      |		(НЕ aps_ЭлементыИзделия.ПометкаУдаления)
		                      |	
		                      |	ОБЪЕДИНИТЬ ВСЕ
		                      |	
		                      |	ВЫБРАТЬ
		                      |		aps_ЭлементыСправочников.Ссылка
		                      |	ИЗ
		                      |		Справочник.aps_ЭлементыСправочников КАК aps_ЭлементыСправочников
		                      |	ГДЕ
		                      |		(НЕ aps_ЭлементыСправочников.ПометкаУдаления)
		                      |	
		                      |	ОБЪЕДИНИТЬ ВСЕ
		                      |	
		                      |	ВЫБРАТЬ
		                      |		aps_ЭлементыТехнологии.Ссылка
		                      |	ИЗ
		                      |		Справочник.aps_ЭлементыТехнологии КАК aps_ЭлементыТехнологии
		                      |	ГДЕ
		                      |		(НЕ aps_ЭлементыТехнологии.ПометкаУдаления)) КАК СправочникЭлементов");
		
		РезультатыПоиска = Запрос.Выполнить().Выгрузить();
		i = 0;
		Пока i < РезультатыПоиска.Количество() Цикл
			Выборка = РезультатыПоиска[i];
			Результат = Ложь;
			Попытка
				Выполнить ТекстРасширенногоПоиска;
			Исключение
				Сообщить(ПараметрыСеанса.aps_ИмяПродукта + НСтр("ru = 'Ошибка в условии поиска:'; en_US = 'Search term error:'") + Символы.ПС + ОписаниеОшибки(), СтатусСообщения.Внимание);
			КонецПопытки;
			
			Если НЕ Результат Тогда
				РезультатыПоиска.Удалить(i);
			Иначе
				i = i + 1;
			КонецЕсли;
		КонецЦикла;
		
	Иначе 
		
		Запрос = Новый Запрос();
		Если ЭлементыДляПроверки <> Неопределено Тогда 
			// помещаем элементы во временную таблицу
			МассивТипов=Новый Массив;
			МассивТипов.Добавить(Тип("СправочникСсылка.aps_ЭлементыИзделия"));
			МассивТипов.Добавить(Тип("СправочникСсылка.aps_ЭлементыСправочников"));
			МассивТипов.Добавить(Тип("СправочникСсылка.aps_ЭлементыТехнологии"));
			ОписаниеТиповЭлемента=Новый ОписаниеТипов(МассивТипов);
			
			СуществующиеСсылки=Новый ТаблицаЗначений();
			СуществующиеСсылки.Колонки.Добавить("Ссылка", ОписаниеТиповЭлемента);
			Для Каждого ЭлементСсылка Из ЭлементыДляПроверки Цикл 
				СуществующиеСсылки.Добавить().Ссылка = ЭлементСсылка;
			КонецЦикла;
			
			МенеджерВТ=Новый МенеджерВременныхТаблиц;
			Запрос.МенеджерВременныхТаблиц=МенеджерВТ;
			Запрос.Текст="ВЫБРАТЬ
			             |	ТаблицаСсылок.Ссылка КАК Ссылка
			             |ПОМЕСТИТЬ ВТСсылки
			             |ИЗ
			             |	&Данные КАК ТаблицаСсылок";
			Запрос.УстановитьПараметр("Данные",СуществующиеСсылки);
			Запрос.Выполнить();
		КонецЕсли;
		
		ТекстЗапроса = "ВЫБРАТЬ * 
		               |ИЗ
                       |	(ВЫБРАТЬ
		               |	СправочникЭлементов.Ссылка КАК ЭлементСсылка,
		               |	СправочникЭлементов.Ссылка.ВидЭлемента КАК ВидЭлемента,
		               |	СправочникЭлементов.Ссылка.Наименование КАК ПредставлениеЭлемента,
		               |	ВЫБОР
		               |		КОГДА СправочникЭлементов.ИндексКартинки = 0
		               |			ТОГДА СправочникЭлементов.ВидЭлемента.ИндексКартинки
		               |		ИНАЧЕ СправочникЭлементов.ИндексКартинки
		               |	КОНЕЦ КАК Картинка
		               |ИЗ
		               |	Справочник.СправочникЭлементов КАК СправочникЭлементов
		               |ГДЕ
		               |	(НЕ СправочникЭлементов.ПометкаУдаления)
					   |		И (НЕ СправочникЭлементов.Предопределенный)
					   |		И (НЕ СправочникЭлементов.ВидЭлемента.Служебный)";
		Если ЗначениеЗаполнено(ВидЭлемента) Тогда
			ТекстЗапроса = ТекстЗапроса + "
		               |	И (СправочникЭлементов.ВидЭлемента В(&Виды))";
			Запрос.УстановитьПараметр("Виды", ВидЭлемента);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Владелец) Тогда
			ТекстЗапроса = ТекстЗапроса + "
					   |	И (СправочникЭлементов.UID = &ПользовательВладелец)";
			Запрос.УстановитьПараметр ("ПользовательВладелец", Владелец);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Группа) Тогда
			ТекстЗапроса = ТекстЗапроса + "
					   |	И (СправочникЭлементов.GID = &Группа)";
			Запрос.УстановитьПараметр ("Группа", Группа);
		КонецЕсли;
		
		Если НЕ ПустаяСтрока(СтрокаПоиска) Тогда
			ТекстЗапроса = ТекстЗапроса + "
					   |	И (СправочникЭлементов.Наименование ПОДОБНО &СтрокаПоиска)";
			Запрос.УстановитьПараметр("СтрокаПоиска", "%"+СтрокаПоиска+"%");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СозданНеРанее) Тогда
			ТекстЗапроса = ТекстЗапроса + "
					   |	И (СправочникЭлементов.Дата >= &СозданНеРанее)";
			Запрос.УстановитьПараметр ("СозданНеРанее", НачалоДня(СозданНеРанее));
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СозданНеПозже) Тогда
			ТекстЗапроса = ТекстЗапроса + "
					   |	И (СправочникЭлементов.Дата <= &СозданНеПозже)";
			Запрос.УстановитьПараметр ("СозданНеПозже", КонецДня(СозданНеПозже));
		КонецЕсли;

		ТекстЗапроса = ТекстЗапроса + ") КАК СправочникЭлементов";
		
		
		// поиск по свойствам
		Если СвойстваДляПоиска=Неопределено Тогда
			СвойстваДляПоиска = Новый ТаблицаЗначений;
			СвойстваДляПоиска.Колонки.Добавить("Свойство");
			СвойстваДляПоиска.Колонки.Добавить("ВидСравнения");
			СвойстваДляПоиска.Колонки.Добавить("Значение");
		КонецЕсли;
		
		Если СвойстваДляПоиска.Количество() > 0 Тогда 
			ТекстЗапросаСвойства = "
					   |	ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
					   |		СправочникЭлементовПараметры.Ссылка КАК ЭлементСсылка
					   |	ИЗ
					   |		Справочник.СправочникЭлементов.Параметры КАК СправочникЭлементовПараметры
					   |	СГРУППИРОВАТЬ ПО
					   |		СправочникЭлементовПараметры.Ссылка
					   |	ИМЕЮЩИЕ
					   |		КОЛИЧЕСТВО(РАЗЛИЧНЫЕ &УдовлетворяющееСвойство) >= &КоличествоСвойств) КАК СправочникЭлементовПараметры
					   |	ПО СправочникЭлементов.ЭлементСсылка = СправочникЭлементовПараметры.ЭлементСсылка";
					   
			ТекстУсловий = "ВЫБОР"; КоличествоУсловий=0;
			Для i=0 По СвойстваДляПоиска.Количество()-1 Цикл 
				СвойствоДляПоиска=СвойстваДляПоиска[i];
				
				ТекстУсловий = ТекстУсловий + "
					   |КОГДА Параметр.Свойство В (&Свойство" + Строка(i+1) + ") И Параметр.Значение";
					   
				Если СвойствоДляПоиска.ВидСравнения=ВидСравнения.Равно Тогда
					ТекстУсловий=ТекстУсловий+" = ";
				ИначеЕсли СвойствоДляПоиска.ВидСравнения=ВидСравнения.Больше Тогда
					ТекстУсловий=ТекстУсловий+" > ";					
				ИначеЕсли СвойствоДляПоиска.ВидСравнения=ВидСравнения.Меньше Тогда
					ТекстУсловий=ТекстУсловий+" < ";
				ИначеЕсли СвойствоДляПоиска.ВидСравнения=ВидСравнения.БольшеИлиРавно Тогда
					ТекстУсловий=ТекстУсловий+" >= ";
				ИначеЕсли СвойствоДляПоиска.ВидСравнения=ВидСравнения.МеньшеИлиРавно Тогда
					ТекстУсловий=ТекстУсловий+" <= ";
				ИначеЕсли СвойствоДляПоиска.ВидСравнения=ВидСравнения.НеРавно Тогда
					ТекстУсловий=ТекстУсловий+" <> ";
				ИначеЕсли СвойствоДляПоиска.ВидСравнения=ВидСравнения.Содержит Тогда
					ТекстУсловий=ТекстУсловий+" ПОДОБНО ";
				Иначе // в списке
					ТекстУсловий=ТекстУсловий+" В ";
				КонецЕсли;
				
				ТекстУсловий = ТекстУсловий + "(&Значение" + Строка(i+1) + ") ТОГДА Параметр.Свойство";
				
				Запрос.УстановитьПараметр("Свойство"+Строка(i+1), СвойствоДляПоиска.Свойство);
				Запрос.УстановитьПараметр("Значение"+Строка(i+1), ?(СвойствоДляПоиска.ВидСравнения=ВидСравнения.Содержит, "%"+Строка(СвойствоДляПоиска.Значение)+"%", СвойствоДляПоиска.Значение));
			КонецЦикла;
			
			ТекстУсловий = ТекстУсловий + " ИНАЧЕ NULL КОНЕЦ";

			ТекстЗапросаСвойства = СтрЗаменить(ТекстЗапросаСвойства, "&УдовлетворяющееСвойство", ТекстУсловий);
			ТекстЗапроса = ТекстЗапроса + ТекстЗапросаСвойства;
			
			Запрос.УстановитьПараметр("КоличествоСвойств", СвойстваДляПоиска.Количество());
		КонецЕсли;
		
		Если НаличиеФайлов <> Неопределено Тогда 
			ТекстЗапросаФайлов = "
					   |	ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ Владелец ИЗ Справочник.aps_Файлы ГДЕ ИСТИНА) КАК aps_Файлы
					   |		ПО СправочникЭлементов.ЭлементСсылка = aps_Файлы.Владелец";
			Если НаличиеФайлов=Истина Тогда 
				Если ЗначениеЗаполнено(ИмяФайла) Тогда 
					ТекстЗапросаФайлов = СтрЗаменить(ТекстЗапросаФайлов, "ИСТИНА", "Наименование ПОДОБНО &ИмяФайла");
					Запрос.УстановитьПараметр("ИмяФайла", "%"+ИмяФайла+"%");
				КонецЕсли;
				ТекстЗапросаФайлов = ТекстЗапросаФайлов + "
					   |	ГДЕ НЕ aps_Файлы.Владелец ЕСТЬ NULL";	// с файлами
			Иначе 
				ТекстЗапросаФайлов = ТекстЗапросаФайлов + "
					   |	ГДЕ aps_Файлы.Владелец ЕСТЬ NULL";		// без файлов
			КонецЕсли;
			ТекстЗапроса = ТекстЗапроса + ТекстЗапросаФайлов;
		КонецЕсли;
		
		Если ЭлементыДляПроверки <> Неопределено Тогда 
			ТекстЗапроса = ТекстЗапроса + "
					   |	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТСсылки По СправочникЭлементов.ЭлементСсылка = ВТСсылки.Ссылка";
		КонецЕсли;
		
		// общий текст запроса
		ТекстЗапроса = "ВЫБРАТЬ *
					   |ИЗ 
					   |(" + СтрЗаменить(ТекстЗапроса, "СправочникЭлементов", "aps_ЭлементыИзделия") + "
					   |ОБЪЕДИНИТЬ ВСЕ
					   |" + СтрЗаменить(ТекстЗапроса, "СправочникЭлементов", "aps_ЭлементыСправочников") + " 
					   |ОБЪЕДИНИТЬ ВСЕ
					   |" + СтрЗаменить(ТекстЗапроса, "СправочникЭлементов", "aps_ЭлементыТехнологии") + ") КАК РезультатПоиска
		               |УПОРЯДОЧИТЬ ПО
		               |	РезультатПоиска.ЭлементСсылка.ВидЭлемента.Код,
		               |	РезультатПоиска.ЭлементСсылка.Наименование,
		               |	РезультатПоиска.ЭлементСсылка.Дата УБЫВ";
		
		Запрос.Текст = ТекстЗапроса;
		РезультатыПоиска = Запрос.Выполнить().Выгрузить();
			
	КонецЕсли;
	
	Возврат РезультатыПоиска;
КонецФункции

#КонецОбласти

#КонецЕсли