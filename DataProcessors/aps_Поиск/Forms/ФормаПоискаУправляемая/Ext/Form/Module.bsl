#Если НЕ МобильноеПриложениеКлиент Тогда
	
#Область ОбработчикиСобытийФормыНаКлиенте	
	
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "aps_ПоискЗакрыть" И Открыта() Тогда 
		Закрыть();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	Попытка
		СвойстваДляПоиска.НайтиПоИдентификатору(ИсточникВыбора.КлючУникальности).Значение = ВыбранноеЗначение;
	Исключение
	КонецПопытки;
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиЭлементовФормы

&НаКлиенте
Процедура ПолеВладелецПриИзменении(Элемент)
	Элементы.ТолькоМоиЭлементы.Пометка = (Владелец = aps_ПолныеПрава.aps_ПараметрСеанса("ТекущийПользователь"));
КонецПроцедуры

&НаКлиенте
Процедура ПолеБыстрыйВыборПриИзменении(Элемент)
	Если БыстрыйВыборДаты = "Сегодня" Тогда
		СозданНеРанее = ТекущаяДата();
		СозданНеПозже = ТекущаяДата();
	ИначеЕсли БыстрыйВыборДаты = "Вчера" Тогда
		СозданНеРанее = ТекущаяДата() - 86400;
		СозданНеПозже = ТекущаяДата() - 86400;
	ИначеЕсли БыстрыйВыборДаты = "За последние три дня" Тогда
		СозданНеРанее = ТекущаяДата() - 3*86400;
		СозданНеПозже = ТекущаяДата();
	ИначеЕсли БыстрыйВыборДаты = "За последнюю неделю" Тогда
		СозданНеРанее = ТекущаяДата() - 7*86400;
		СозданНеПозже = ТекущаяДата();
	ИначеЕсли БыстрыйВыборДаты = "За последний месяц" Тогда
		СозданНеРанее = ДобавитьМесяц(ТекущаяДата(), - 1);
		СозданНеПозже = ТекущаяДата();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПолеСозданОчистка(Элемент, СтандартнаяОбработка)
	БыстрыйВыборДаты = Неопределено;
КонецПроцедуры

&НаКлиенте
Процедура СвойстваВидСравненияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ДанныеВыбора = Новый СписокЗначений;
	ДанныеВыбора.Добавить(ВидСравнения.Равно);
	ДанныеВыбора.Добавить(ВидСравнения.Больше);
	ДанныеВыбора.Добавить(ВидСравнения.Меньше);
	ДанныеВыбора.Добавить(ВидСравнения.БольшеИлиРавно);
	ДанныеВыбора.Добавить(ВидСравнения.МеньшеИлиРавно);
	ДанныеВыбора.Добавить(ВидСравнения.НеРавно);
	ДанныеВыбора.Добавить(ВидСравнения.Содержит);
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура РезультатыПоискаПриАктивизацииСтроки(Элемент)
	ТекущаяСтрока = Элемент.ТекущиеДанные;
	Если ТекущаяСтрока <> Неопределено Тогда 
		aps_СтруктураПараметровОповещения.Очистить();
		aps_СтруктураПараметровОповещения.Вставить("item", ТекущаяСтрока.ЭлементСсылка);
		Оповестить("AppiusWindowGeneralNotify", aps_СтруктураПараметровОповещения, ЭтаФорма);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура РезультатыПоискаНачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение)
	Для i=0 По ПараметрыПеретаскивания.Значение.Количество()-1 Цикл 
		ПараметрыПеретаскивания.Значение[i] = РезультатыПоиска.НайтиПоИдентификатору(ПараметрыПеретаскивания.Значение[i]).ЭлементСсылка;
	КонецЦикла;
	
	ПараметрыПеретаскивания.ДопустимыеДействия = ДопустимыеДействияПеретаскивания.Копирование;
КонецПроцедуры

&НаКлиенте
Процедура ПолеНомерРевизииПриИзменении(Элемент)
	Если Элемент.Имя="ПолеСостояние" Тогда 
		Свойство = СвойствоСостояние;
	ИначеЕсли Элемент.Имя="ПолеНомерРевизии" Тогда 
		Свойство = СвойствоНомерРевизии;
	ИначеЕсли Элемент.Имя="ПолеНомерИсполнения" Тогда 
		Свойство = СвойствоНомерИсполнения;
	Иначе 
		Возврат;
	КонецЕсли;
		
	СтрокаСвойства = Неопределено;
	Для Каждого Строка Из СвойстваДляПоиска Цикл 
		Если Строка.Свойство = Свойство Тогда
			СтрокаСвойства = Строка;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если СтрокаСвойства = Неопределено Тогда
		СтрокаСвойства = СвойстваДляПоиска.Добавить();
		СтрокаСвойства.Свойство		= Свойство;
		СтрокаСвойства.ВидСравнения	= ВидСравнения.Равно;
	КонецЕсли;
	СтрокаСвойства.Значение	= ЭтаФорма[СтрЗаменить(Элемент.Имя, "Поле", "")];
КонецПроцедуры

&НаКлиенте
Процедура СвойстваПриИзменении(Элемент)
	Состояние		= Неопределено;
	НомерРевизии	= Неопределено;
	НомерИсполнения	= Неопределено;
	Для Каждого Строка Из СвойстваДляПоиска Цикл 
		Если Строка.Свойство = СвойствоСостояние Тогда
			Состояние = Строка.Значение;
		ИначеЕсли Строка.Свойство = СвойствоНомерРевизии Тогда
			НомерРевизии = Строка.Значение;
		ИначеЕсли Строка.Свойство = СвойствоНомерИсполнения Тогда
			НомерИсполнения = Строка.Значение;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КнопкаНайти(Команда)
	ЕстьРезультаты = ПолучитьРезультатыПоиска();	
	
	Если НЕ ЕстьРезультаты И Элементы.ТолькоМоиЭлементы.Пометка Тогда 
		Если Вопрос(НСтр("ru = 'Поиск не дал результатов. Выполнить поиск среди остальных элементов?'; en_US = 'No search results. Search among other elements?'"), РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда
			ТолькоМоиЭлементы(Неопределено);
			ЕстьРезультаты = ПолучитьРезультатыПоиска();
	
		КонецЕсли;
	КонецЕсли;
	
	ОбновитьРезультатыПоиска();
КонецПроцедуры

&НаКлиенте
Процедура ТолькоМоиЭлементы(Команда)
	Элементы.ТолькоМоиЭлементы.Пометка = НЕ Элементы.ТолькоМоиЭлементы.Пометка;
	Владелец = ?(Элементы.ТолькоМоиЭлементы.Пометка, aps_ПолныеПрава.aps_ПараметрСеанса("ТекущийПользователь"), Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСвойстваПоВиду(Команда)
	Если СвойстваДляПоиска.Количество() > 0 И Вопрос(НСтр("ru = 'Очистить существующий список?'; en_US = 'Clear the existing list?'"), РежимДиалогаВопрос.ДаНет)=КодВозвратаДиалога.Да Тогда 
		СвойстваДляПоиска.Очистить();
	КонецЕсли;
	
	ОбновитьСвойстваПоВидуСервер();
КонецПроцедуры

&НаКлиенте
Процедура КнопкаОткрытьПроводник(Команда)
	Если Элементы.РезультатыПоиска.ТекущиеДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	aps_ОткрытьВПроводнике(Элементы.РезультатыПоиска.ТекущиеДанные.ЭлементСсылка);
КонецПроцедуры

#КонецОбласти

#КонецЕсли

#Если НЕ МобильноеПриложениеСервер Тогда
	
#Область ОбработчикиСобытийФормыНаСервере

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	СвойствоСостояние			= ПланыВидовХарактеристик.aps_Свойства.Состояние;
	СвойствоНомерРевизии		= ПланыВидовХарактеристик.aps_Свойства.НомерРевизии;
	СвойствоНомерИсполнения		= ПланыВидовХарактеристик.aps_Свойства.НомерИсполнения;
	
	Элементы.ПолеНомерРевизии.ОграничениеТипа = СвойствоНомерРевизии.ТипЗначения;
	Элементы.ПолеНомерИсполнения.ОграничениеТипа = СвойствоНомерИсполнения.ТипЗначения;
	
	ОбновитьСписокВидов();
	
	АдресРезультатов = ПоместитьВоВременноеХранилище(Неопределено, ЭтаФорма.УникальныйИдентификатор);
КонецПроцедуры

#КонецОбласти


#Область ПрочиеПроцедурыИФункции

&НаСервере
Процедура ОбновитьСвойстваПоВидуСервер()
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	aps_СвойстваЭлементов.СвойствоЭлемента КАК Свойство
	                      |ИЗ
	                      |	Справочник.aps_СвойстваЭлементов КАК aps_СвойстваЭлементов
	                      |ГДЕ
	                      |	(НЕ aps_СвойстваЭлементов.ПометкаУдаления)
	                      |	И aps_СвойстваЭлементов.Владелец = &Владелец
	                      |	И (НЕ aps_СвойстваЭлементов.ЭтоГруппа)
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	aps_СвойстваЭлементов.СвойствоЭлемента.Наименование");
	Запрос.УстановитьПараметр("Владелец", ВидЭлемента);
	Результат = Запрос.Выполнить().Выгрузить();
	
	тзСвойстваДляПоиска = РеквизитФормыВЗначение("СвойстваДляПоиска");
	
	Для Каждого СтрокаСвойства Из Результат Цикл
		Если тзСвойстваДляПоиска.Найти(СтрокаСвойства.Свойство, "Свойство") = Неопределено Тогда 
			НоваяСтрока = тзСвойстваДляПоиска.Добавить();
			НоваяСтрока.Свойство = СтрокаСвойства.Свойство;
			НоваяСтрока.Значение = СтрокаСвойства.Свойство.ТипЗначения.ПривестиЗначение();
		КонецЕсли;
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(тзСвойстваДляПоиска, "СвойстваДляПоиска");
КонецПроцедуры

&НаСервере
Функция ПолучитьРезультатыПоиска()
	СтруктураУсловий = Новый Структура();
	
	СтруктураУсловий.Вставить("СтрокаПоиска", СтрокаПоиска);
	
	Если ЗначениеЗаполнено(ВидЭлемента) Тогда 
		СтруктураУсловий.Вставить("ВидЭлемента", ВидЭлемента);
	КонецЕсли;
	Если ЗначениеЗаполнено(Владелец) Тогда 
		СтруктураУсловий.Вставить("Владелец", Владелец);
	КонецЕсли;
	Если ЗначениеЗаполнено(Группа) Тогда 
		СтруктураУсловий.Вставить("Группа", Группа);
	КонецЕсли;
	
	тзСвойстваДляПоиска = Новый ТаблицаЗначений;
	тзСвойстваДляПоиска.Колонки.Добавить("Свойство");
	тзСвойстваДляПоиска.Колонки.Добавить("ВидСравнения");
	тзСвойстваДляПоиска.Колонки.Добавить("Значение");
	Для i=0 По СвойстваДляПоиска.Количество()-1 Цикл 
		Если ЗначениеЗаполнено(СвойстваДляПоиска[i].Значение) Тогда 
			ЗаполнитьЗначенияСвойств(тзСвойстваДляПоиска.Добавить(), СвойстваДляПоиска[i]);
		КонецЕсли;
	КонецЦикла;
	Если тзСвойстваДляПоиска.Количество() > 0 Тогда
		СтруктураУсловий.Вставить("СвойстваДляПоиска", тзСвойстваДляПоиска);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СозданНеРанее) Тогда 
		СтруктураУсловий.Вставить("СозданНеРанее", СозданНеРанее);
	КонецЕсли;
    Если ЗначениеЗаполнено(СозданНеПозже) Тогда 
		СтруктураУсловий.Вставить("СозданНеПозже", СозданНеПозже);
	КонецЕсли;
	
	тзРезультатыПоиска = РеквизитФормыВЗначение("Объект").aps_Поиск(СтруктураУсловий);
	ПоместитьВоВременноеХранилище(тзРезультатыПоиска, АдресРезультатов);
	Возврат тзРезультатыПоиска.Количество() > 0;
КонецФункции

&НаСервере
Функция ОбновитьРезультатыПоиска()
	ЗначениеВРеквизитФормы(ПолучитьИзВременногоХранилища(АдресРезультатов), "РезультатыПоиска");
КонецФункции

&НаСервере
Процедура ОбновитьСписокВидов()
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	aps_ВидыЭлементов.Ссылка КАК ВидЭлемента
	                      |ИЗ
	                      |	Справочник.aps_ВидыЭлементов КАК aps_ВидыЭлементов
	                      |ГДЕ
	                      |	(НЕ aps_ВидыЭлементов.ПометкаУдаления)
	                      |	И (НЕ aps_ВидыЭлементов.Служебный)
	                      |	И (НЕ aps_ВидыЭлементов.ЭтоГруппа)
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	aps_ВидыЭлементов.Наименование");
	Элементы.ПолеВидЭлемента.СписокВыбора.ЗагрузитьЗначения( Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку(0) );
КонецПроцедуры

#КонецОбласти

#КонецЕсли