// Функция формирует таблицу зависимых файлов по модели XDTO
// Параметры:
//		МодельXDTO - объект модели XDTO
//		ЗависимыеРасширения - массив зависимых расширений, может быть НЕОПРЕДЕЛЕНО
//		возвЗависимыеДокументы - формируемый массив зависимых документов, может быть НЕОПРЕДЕЛЕНО
// Возвращаемое значение:
//		ТаблицаЗначений
// Пример:
//		ЗависимыеФайлы=МодульРаботыСФайлами.aps_ПоискЗависимыхФайловПоМодели(МодельXDTOДляПоискаЗависимых, ЗависимыеРасширения);
//
Функция aps_ПоискЗависимыхФайловПоМодели( МодельXDTO, ЗависимыеРасширения=Неопределено, возвЗависимыеДокументы=Неопределено ) Экспорт 
	
	// получить линейный массив xdto из модели
	МассивXDTO=aps_СформироватьМассивИзМоделиXDTO(МодельXDTO);
	МассивДокументов=Новый Массив(); СоответствиеДокументовИИзделий = Новый Соответствие;
	Для i=0 По МассивXDTO.Количество()-1 Цикл 
		Если МассивXDTO[i].elementType = Справочники.aps_ВидыЭлементов.Документ
				ИЛИ МассивXDTO[i].elementType = Справочники.aps_ВидыЭлементов.АктивныйДокументЧертежSolidWorks
				ИЛИ МассивXDTO[i].elementType = Справочники.aps_ВидыЭлементов.АктивныйДокументДетальSolidWorks
				ИЛИ МассивXDTO[i].elementType = Справочники.aps_ВидыЭлементов.АктивныйДокументСборкаSolidWorks
				ИЛИ МассивXDTO[i].elementType = Справочники.aps_ВидыЭлементов.АктивныйДокументЧертежКОМПАС
				ИЛИ МассивXDTO[i].elementType = Справочники.aps_ВидыЭлементов.АктивныйДокументДетальКОМПАС
				ИЛИ МассивXDTO[i].elementType = Справочники.aps_ВидыЭлементов.АктивныйДокументСборкаКОМПАС
				ИЛИ МассивXDTO[i].elementType = Справочники.aps_ВидыЭлементов.АктивныйДокументЧертежAutoCAD
				ИЛИ МассивXDTO[i].elementType = Справочники.aps_ВидыЭлементов.АктивныйДокументДетальAutoCAD
				ИЛИ МассивXDTO[i].elementType = Справочники.aps_ВидыЭлементов.АктивныйДокументСборкаAutoCAD
				ИЛИ МассивXDTO[i].elementType = Справочники.aps_ВидыЭлементов.АктивныйДокументЧертежInventor
				ИЛИ МассивXDTO[i].elementType = Справочники.aps_ВидыЭлементов.АктивныйДокументДетальInventor
				ИЛИ МассивXDTO[i].elementType = Справочники.aps_ВидыЭлементов.АктивныйДокументСборкаInventor 
				ИЛИ МассивXDTO[i].elementType = Справочники.aps_ВидыЭлементов.АктивныйДокументЧертежSolidEdge
				ИЛИ МассивXDTO[i].elementType = Справочники.aps_ВидыЭлементов.АктивныйДокументДетальSolidEdge
				ИЛИ МассивXDTO[i].elementType = Справочники.aps_ВидыЭлементов.АктивныйДокументСборкаSolidEdge Тогда 
				
			Если МассивДокументов.Найти(МассивXDTO[i].element)=Неопределено Тогда 
				МассивДокументов.Добавить(МассивXDTO[i].element);
				Если МассивXDTO[i].Владелец()<>Неопределено Тогда 
					СоответствиеДокументовИИзделий.Вставить(МассивXDTO[i].element, МассивXDTO[i].Владелец().element);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ЗависимыеФайлы=aps_РаботаСФайламиСервер.aps_ПолучитьФайлыДокумента(МассивДокументов); // таблица файлов по всем документам из модели
	ЗависимыеФайлы.Колонки.Добавить("itemXDTO");
	ЗависимыеФайлы.Колонки.Добавить("itemDocXDTO");
	
	Если ЗависимыеРасширения=Неопределено Тогда 
		Возврат ЗависимыеФайлы; // вернуть все файлы
	КонецЕсли;
	
	i=0;
	Пока i < ЗависимыеФайлы.Количество() Цикл 
		Зависимый=Ложь;
		Для Каждого ЗавРасширение Из ЗависимыеРасширения Цикл 
			Если ВРЕГ(ЗавРасширение)=ВРЕГ(ЗависимыеФайлы[i].Расширение) Тогда 
				Зависимый=Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если НЕ Зависимый Тогда 
			ЗависимыеФайлы.Удалить(i); Продолжить;
		КонецЕсли;
		
		Если возвЗависимыеДокументы<>Неопределено И возвЗависимыеДокументы.Найти(ЗависимыеФайлы[i].Документ)=Неопределено Тогда 
			возвЗависимыеДокументы.Добавить(ЗависимыеФайлы[i].Документ);
		КонецЕсли;
		
		itemDocXDTO=ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("http://appius.ru/pdm", "item"));
		itemDocXDTO.element=СериализаторXDTO.ЗаписатьXDTO(ЗависимыеФайлы[i].Документ);
		ЗависимыеФайлы[i].itemDocXDTO=XDTO2Строка(itemDocXDTO); // xdto-модель документа
		
		Изделие = СоответствиеДокументовИИзделий.Получить(ЗависимыеФайлы[i].Документ);
		Если Изделие<>Неопределено Тогда 
			itemXDTO=ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("http://appius.ru/pdm", "item"));
			itemXDTO.element=СериализаторXDTO.ЗаписатьXDTO(Изделие);
			ЗависимыеФайлы[i].itemXDTO=XDTO2Строка(itemXDTO); // xdto-модель изделия
		КонецЕсли;
		
		i=i+1; // перейти к следующему файлу
	КонецЦикла;
	
	Возврат ЗависимыеФайлы;
	
КонецФункции

#КонецОбласти

#КонецЕсли

