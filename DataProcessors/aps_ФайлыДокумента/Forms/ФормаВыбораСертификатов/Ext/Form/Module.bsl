
#Если НЕ МобильноеПриложениеКлиент Тогда

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если НЕ aps_РаботаСФайлами.aps_ПодключитьРасширениеРаботыСКриптографией() Тогда 
		Отказ = Истина; Возврат;
	КонецЕсли;
	
	ПерсональныеНастройки = aps_РаботаСФайламиСервер.aps_ПерсональныеНастройки();
	ПараметрыКриптографии = ПерсональныеНастройки.ПараметрыКриптографии;

	МенеджерКриптографии = aps_РаботаСФайлами.aps_ПолучитьМенеджерКриптографии(ПараметрыКриптографии);
	Если МенеджерКриптографии = Неопределено Тогда 
		Отказ = Истина; Возврат;
	КонецЕсли;
	
	СписокХранилищ = Новый СписокЗначений;	
	СписокХранилищ.Добавить(ТипХранилищаСертификатовКриптографии.СертификатыПолучателей);
	СписокХранилищ.Добавить(ТипХранилищаСертификатовКриптографии.ПерсональныеСертификаты);
	
	Для Каждого ХранилищеСертификата Из СписокХранилищ Цикл
		СертификатыХранилища = МенеджерКриптографии.ПолучитьХранилищеСертификатов(ХранилищеСертификата.Значение).ПолучитьВсе();
			
		Для Каждого Сертификат Из СертификатыХранилища Цикл
			ДвДанныеСертификата = Сертификат.Выгрузить();
			
			Если СертификатыПолучателей.НайтиПоЗначению(ДвДанныеСертификата) = Неопределено Тогда
				НовыйСертификат = СертификатыПолучателей.Добавить();
				НовыйСертификат.Представление = aps_РаботаСФайлами.aps_ПредставлениеСертификата(Сертификат, Истина);
				НовыйСертификат.Картинка = БиблиотекаКартинок.aps_Сертификат;
				НовыйСертификат.Значение = ДвДанныеСертификата;
			КонецЕсли;
		КонецЦикла;                      
	КонецЦикла;
	
	СертификатыПолучателей.СортироватьПоПредставлению();
КонецПроцедуры

#КонецОбласти

	
#Область ОбработчикиКомандФормы	

&НаКлиенте
Процедура Выбрать(Команда)
	МассивСертификатов = Новый Массив;
	Для Каждого ЭлементСписка Из СертификатыПолучателей Цикл
		Если ЭлементСписка.Пометка Тогда
			Сертификат = Новый СертификатКриптографии(ЭлементСписка.Значение);
			МассивСертификатов.Добавить(Сертификат);
		КонецЕсли;
	КонецЦикла;
	
	Если МассивСертификатов.Количество() = 0 Тогда 
		Предупреждение(НСтр("ru = 'Выберите сертификаты получателей!'; en_US = 'Please select user certificates!'"));
	Иначе // вернуть выбранные сертификаты
		Закрыть(МассивСертификатов);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#КонецЕсли

