
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.СписокФайлов = Неопределено Или Параметры.СписокФайлов.Количество() = 0 Тогда 
		Отказ = Истина; Возврат;
	КонецЕсли;
	
	СписокДокументов = Параметры.СписокДокументов;
	ВКаталоге = Параметры.ВКаталоге;
	
	Для Каждого ПолноеИмяФайла Из Параметры.СписокФайлов Цикл 
		СтрокаСпискаФайлов = СписокНовыхФайлов.Добавить();
		СтрокаСпискаФайлов.ПолноеИмяФайла = Сред(ПолноеИмяФайла, СтрДлина(ВКаталоге)+1);
		
		РасширениеФайла = aps_РаботаСФайлами.aps_ВспомПолучитьРасширениеФайлаПоИмени(ПолноеИмяФайла);
		СтрокаСпискаФайлов.ИндексКартинки = aps_РаботаСФайлами.aps_ПолучитьПиктограммуФайлаПоРасширению(РасширениеФайла);
		
		Если СписокДокументов.Количество() = 1 Тогда 
			СтрокаСпискаФайлов.Документ = СписокДокументов[0];
			СтрокаСпискаФайлов.ИндексКартинкиДокумента = СписокДокументов[0].ВидЭлемента.ИндексКартинки;
		КонецЕсли;
	КонецЦикла;
	
	Если СписокДокументов.Количество() = 1 Тогда 
		Элементы.СписокНовыхФайловГруппаДокумент.Видимость = Ложь;
	Иначе // выбор из списка
		Элементы.СписокНовыхФайловДокумент.СписокВыбора.ЗагрузитьЗначения(СписокДокументов);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОтметитьВсе(Команда)
	Для Каждого Строка Из СписокНовыхФайлов Цикл 
		Строка.Выбран = (Команда.Имя = "ОтметитьВсе");
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьФайлы(Команда)
	Для Каждого СтрокаСпискаФайлов Из СписокНовыхФайлов Цикл 
		Если СтрокаСпискаФайлов.Выбран И Не ЗначениеЗаполнено(СтрокаСпискаФайлов.Документ) Тогда 
			Предупреждение(НСтр("ru = ""Укажите документ(ы) для новых файлов!'' en_US = ""Please specify document(s) for new files"""));
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
	// соответствие документов и файлов для помещения
	СоответствиеДокументовИФайлов = Новый Соответствие;
	Для Каждого СтрокаСпискаФайлов Из СписокНовыхФайлов Цикл 
		Если СтрокаСпискаФайлов.Выбран Тогда 
			Если СоответствиеДокументовИФайлов[СтрокаСпискаФайлов.Документ] = Неопределено Тогда 
				СоответствиеДокументовИФайлов.Вставить(СтрокаСпискаФайлов.Документ, Новый Массив);
			КонецЕсли;
			
			МассивНовыхФайлов = СоответствиеДокументовИФайлов[СтрокаСпискаФайлов.Документ];
			МассивНовыхФайлов.Добавить(ВКаталоге+СтрокаСпискаФайлов.ПолноеИмяФайла);
		КонецЕсли;
	КонецЦикла;
	
	Закрыть(СоответствиеДокументовИФайлов);
КонецПроцедуры

&НаКлиенте
Процедура Игнорировать(Команда)
	Закрыть(Новый Соответствие);
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	Закрыть();
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиЭлементовФормы

&НаКлиенте
Процедура СписокНовыхФайловДокументОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	ОбработкаВыбораДокументаСервер(Элементы.СписокНовыхФайлов.ТекущаяСтрока, ВыбранноеЗначение);
КонецПроцедуры

#КонецОбласти


#Область ПрочиеПроцедурыИФункции

&НаСервере
Процедура ОбработкаВыбораДокументаСервер(ИдСтроки, СсылкаНаДокумент)
	СписокНовыхФайлов.НайтиПоИдентификатору(ИдСтроки).ИндексКартинкиДокумента = СсылкаНаДокумент.ВидЭлемента.ИндексКартинки;
КонецПроцедуры

#КонецОбласти
