
#Если НЕ МобильноеПриложениеКлиент Тогда
	
#Область ОбработчикиСобытийФормыНаКлиенте	
	
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	#Если ВебКлиент Тогда 
		Элементы.ГруппаАрхивация.Видимость = Ложь; // в веб-клиенте ЗаписьZipФайла недоступна
	#Иначе
		ЗапаковатьВАрхивПриИзменении(Элементы.ЗапаковатьВАрхив);
		ЗадатьПарольПриИзменении(Элементы.ЗадатьПароль);
	#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии()
	ПриЗакрытииСервер();
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиЭлементовФормы

&НаКлиенте
Процедура ВыборКаталогаВыгрузкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ВыборКаталога=Новый ДиалогВыбораФайла( РежимДиалогаВыбораФайла.ВыборКаталога );
	ВыборКаталога.ПолноеИмяФайла=КаталогВыгрузки;
	Если ВыборКаталога.Выбрать()=Истина Тогда
		КаталогВыгрузки=ВыборКаталога.Каталог;
	    Если Элемент.СписокВыбора.НайтиПоЗначению(КаталогВыгрузки)=Неопределено Тогда
	    	Элемент.СписокВыбора.Вставить(0, КаталогВыгрузки);
		КонецЕсли;
		
		Пока Элемент.СписокВыбора.Количество() > 5 Цикл 
			Элемент.СписокВыбора.Удалить(5);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗапаковатьВАрхивПриИзменении(Элемент)
	Элементы.ГруппаПодготовкиАрхива.Доступность = ЗапаковатьВАрхив;
	Элементы.ИмяАрхива.Доступность = ЗапаковатьВАрхив;
КонецПроцедуры

&НаКлиенте
Процедура ЗадатьПарольПриИзменении(Элемент)
	Элементы.Пароль.Доступность = ЗадатьПароль;
	Элементы.ПодтверждениеПароля.Доступность = ЗадатьПароль;
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Выгрузить(Команда)
	Если СписокФайлов.НайтиСтроки(Новый Структура("Выбран", Истина)).Количество() = 0 Тогда
		Предупреждение(НСтр("ru = ""Выберите файл(ы)!""; en_US = ""No file is selected!""")); Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(КаталогВыгрузки) Тогда
		Предупреждение(НСтр("ru = ""Укажите каталог для выгрузки файлов!""; en_US = ""Download directory is not specified!""")); Возврат;
	КонецЕсли;
	
	Если ЗапаковатьВАрхив И ПустаяСтрока(ИмяАрхива) Тогда
		Предупреждение(НСтр("ru = ""Укажите имя архива!""; en_US = ""Please specify archive name!""")); Возврат;
	КонецЕсли;
	
	Каталог = Новый Файл(КаталогВыгрузки);
	Если НЕ Каталог.Существует() Тогда
		Попытка
			СоздатьКаталог(КаталогВыгрузки);
		Исключение
			Предупреждение(НСтр("ru = 'Невозможно создать каталог ""'; en_US = 'Cannot create the ""'")+КаталогВыгрузки+НСтр("ru = '"". Неправильно указан путь или отсутствует доступ к родительской папке.'; en_US = '"" directory. The path is incorrectly specified or access to the parent directory is denied.'"));
			Возврат;
		КонецПопытки;
	КонецЕсли;
	
	МассивФайловВозврата = Новый Массив;
	Для Каждого СтрокаСпискаФайлов Из СписокФайлов Цикл 
		Если СтрокаСпискаФайлов.Выбран Тогда 
			МассивФайловВозврата.Добавить(СтрокаСпискаФайлов.Ссылка);
		КонецЕсли;
	КонецЦикла;
	
	Закрыть(МассивФайловВозврата); // массив выбранных файлов
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)
	Если Команда.Имя = "ОтметитьДокументыВида" Тогда
		СписокУникальныхЗначенийВидовДокументов=Новый СписокЗначений();
		Для Каждого СтрокаФайлов из СписокФайлов Цикл 
			Если СписокУникальныхЗначенийВидовДокументов.НайтиПоЗначению(СтрокаФайлов.ВидДокумента)=Неопределено Тогда 
				СписокУникальныхЗначенийВидовДокументов.Добавить(СтрокаФайлов.ВидДокумента,?(ЗначениеЗаполнено(СтрокаФайлов.ВидДокумента),СтрокаФайлов.ВидДокумента,НСтр("ru = 'Отсутствует'; en_US = 'No type'")),,?(ЗначениеЗаполнено(СтрокаФайлов.ВидДокумента),БиблиотекаКартинок.aps_Документ,Неопределено));
			КонецЕсли;
		КонецЦикла;
		СписокУникальныхЗначенийВидовДокументов.СортироватьПоЗначению();
		Если НЕ СписокУникальныхЗначенийВидовДокументов.ОтметитьЭлементы(НСтр("ru = 'Выберите виды документов'; en_US = 'Select the document types'")) Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	Для Каждого Строка Из СписокФайлов Цикл 
		Строка.Выбран = ?(Команда.Имя = "ОтметитьДокументыВида",СписокУникальныхЗначенийВидовДокументов.НайтиПоЗначению(Строка.ВидДокумента).Пометка,(Команда.Имя = "ОтметитьВсе"));
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьЭтотДокумент(Команда)
	// вызов экспортной функции формы-владельца
	Если Команда.Имя = "ОтметитьЭтотДокументСЗависимыми" Тогда 
		МассивЗависимыхДокументов = Новый Массив();
		ФайлыДокументаСЗависимыми = ВладелецФормы.ПолучитьФайлыДокумента(Истина, МассивЗависимыхДокументов);
	Иначе 
		ФайлыДокументаСЗависимыми = ВладелецФормы.ПолучитьФайлыДокумента();
	КонецЕсли;
	Для Каждого Строка Из СписокФайлов Цикл 
		Строка.Выбран = (ФайлыДокументаСЗависимыми.Найти(Строка.Ссылка) <> Неопределено);
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#КонецЕсли

#Если НЕ МобильноеПриложениеСервер Тогда

#Область ОбработчикиСобытийФормыНаСервере	
	
&НаСервере
Процедура ПриЗакрытииСервер()
	КаталогВыгрузки=aps_РаботаСФайлами.aps_ДобавитьПоследнийСлэш(КаталогВыгрузки);
	ХранилищеНастроекДанныхФорм.Сохранить("Обработка.aps_ФайлыДокумента.Форма.ФормаВыгружаемыхФайлов", "МассивПапокВыгрузки", Элементы.ВыборКаталогаВыгрузки.СписокВыбора.ВыгрузитьЗначения());
	
	ХранилищеНастроекДанныхФорм.Сохранить("Обработка.aps_ФайлыДокумента.Форма.ФормаВыгружаемыхФайлов", "Расшифровать", Расшифровать);
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.СписокФайлов = Неопределено Или Параметры.СписокФайлов.Количество() = 0 Тогда 
		Отказ = Истина; Возврат;
	КонецЕсли;
	
	Элементы.ГруппаАрхивация.Видимость = Параметры.ВозможностьАрхивации;
	
	Если Параметры.Режим = 1 Тогда 
		Заголовок = НСтр("ru = ""Список файлов для просмотра""; en_US = ""File list to view""");
		Элементы.КнопкаПросмотреть.Видимость = Истина;
		Элементы.КнопкаПросмотреть.КнопкаПоУмолчанию = Истина;
	ИначеЕсли Параметры.Режим = 2 Тогда 
		Заголовок = НСтр("ru = ""Список файлов для редактирования""; en_US = ""File list to edit""");
		Элементы.КнопкаРедактировать.Видимость = Истина;
		Элементы.КнопкаРедактировать.КнопкаПоУмолчанию = Истина;
	ИначеЕсли Параметры.Режим = 3 Тогда 
		Заголовок = НСтр("ru = ""Список файлов для выгрузки""; en_US = ""File list to download""");
		Элементы.КнопкаВыгрузить.Видимость = Истина;
		Элементы.КнопкаВыгрузить.КнопкаПоУмолчанию = Истина;
	КонецЕсли;
	
	Если Параметры.Свойство("КаталогВыгрузки") Тогда 
		// каталог выгрузки уже задан
		КаталогВыгрузки=Параметры.КаталогВыгрузки;
		Элементы.ГруппаКаталогВыгрузки.Видимость=Ложь;
	КонецЕсли;
	
	Если Параметры.Свойство("БезЗависимостей") И Параметры.БезЗависимостей = Истина Тогда 
		Элементы.СписокФайловОтметитьЭтотДокумент.Видимость = Ложь;
		Элементы.СписокФайловОтметитьЭтотДокументСЗависимыми.Видимость = Ложь;
	КонецЕсли;
	
	ЕстьЗашифрованныеФайлы = Ложь;
	Для Каждого ФайлСсылка Из Параметры.СписокФайлов Цикл 
		// добавить файл в список для выгрузки
		СтрокаСпискаФайлов = СписокФайлов.Добавить();
		СтрокаСпискаФайлов.Ссылка = ФайлСсылка;
		
		Если ФайлСсылка.Редактируется=ПараметрыСеанса.ТекущийПользователь Тогда
			СтрокаСпискаФайлов.ИндексКартинкиСостояния=0;
		ИначеЕсли НЕ ФайлСсылка.Редактируется.Пустая() Тогда
			СтрокаСпискаФайлов.ИндексКартинкиСостояния=1;
		Иначе 
			СтрокаСпискаФайлов.ИндексКартинкиСостояния=2;
		КонецЕсли;
		
		СтрокаСпискаФайлов.ИндексКартинкиФайла=aps_РаботаСФайлами.aps_ПолучитьПиктограммуФайлаПоРасширению(ФайлСсылка.Расширение);

		СтрокаСпискаФайлов.Документ = ФайлСсылка.Владелец;
		Для Каждого СтрокаПараметра Из ФайлСсылка.Владелец.Параметры Цикл
			Если СтрокаПараметра.Параметр.Свойство = ПланыВидовХарактеристик.aps_Свойства.ВидДокумента Тогда
				СтрокаСпискаФайлов.ВидДокумента = СтрокаПараметра.Параметр.Значение;
			КонецЕсли;
		КонецЦикла;
		
		СтрокаСпискаФайлов.ИндексКартинкиДокумента = ФайлСсылка.Владелец.ВидЭлемента.ИндексКартинки;
		
		Если ФайлСсылка.Зашифрован Тогда 
			ЕстьЗашифрованныеФайлы = Истина;
		КонецЕсли;
	КонецЦикла;
	
	МассивПапокВыгрузки = ХранилищеНастроекДанныхФорм.Загрузить("Обработка.aps_ФайлыДокумента.Форма.ФормаВыгружаемыхФайлов", "МассивПапокВыгрузки");
	Если МассивПапокВыгрузки <> Неопределено И ТипЗнч(МассивПапокВыгрузки) = Тип("Массив") Тогда 
		Элементы.ВыборКаталогаВыгрузки.СписокВыбора.ЗагрузитьЗначения(МассивПапокВыгрузки);
	КонецЕсли;
	
	Если ЕстьЗашифрованныеФайлы Тогда 
		Расшифровать = ХранилищеНастроекДанныхФорм.Загрузить("Обработка.aps_ФайлыДокумента.Форма.ФормаВыгружаемыхФайлов", "Расшифровать");
	Иначе 
		Расшифровать = Ложь;
	КонецЕсли;
	
	Элементы.Расшифровать.Видимость = ЕстьЗашифрованныеФайлы;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли