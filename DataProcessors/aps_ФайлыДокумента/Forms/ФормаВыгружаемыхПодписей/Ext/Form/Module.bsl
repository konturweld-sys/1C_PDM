#Если НЕ МобильноеПриложениеКлиент Тогда
	
#Область ОбработчикиСобытийФормыНаКлиенте	
	
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Отметить(Команды.Найти("Отметить"));
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиЭлементовФормы

&НаКлиенте
Процедура ВыборКаталогаВыгрузкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ВыборКаталога = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Если ВыборКаталога.Выбрать() = Истина Тогда
		КаталогВыгрузки = ВыборКаталога.Каталог;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Выгрузить(Команда)
	Если Подписи.НайтиСтроки(Новый Структура("Выбран", Истина)).Количество() = 0 Тогда 
		Предупреждение(НСтр("ru = 'Выберите подписи'; en_US = 'Select e-signatures'")); Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(КаталогВыгрузки) Тогда
		Предупреждение(НСтр("ru = ""Укажите каталог для выгрузки файлов!""; en_US = ""Download directory is not specified!""")); Возврат;
	КонецЕсли;
	
	ВыгружаемыеФайлы = Новый Массив;
	Для Каждого СтрокаПодписи Из Подписи Цикл
		Если СтрокаПодписи.Выбран Тогда 
			ПолныйПуть = aps_РаботаСФайлами.aps_ДобавитьПоследнийСлэш(КаталогВыгрузки) + СтрокаПодписи.ИмяФайлаВыгрузки;
			
			Описание = Новый ОписаниеПередаваемогоФайла(ПолныйПуть, СтрокаПодписи.АдресПодписи);
			ВыгружаемыеФайлы.Добавить(Описание);
		КонецЕсли;
	КонецЦикла;
	
	ВыгруженныеФайлы = Новый Массив;
	ПолучитьФайлы(ВыгружаемыеФайлы, ВыгруженныеФайлы,, Ложь);
	
	СохранитьКаталогВыгрузкиСервер();
	
	СтрокаСообщения = НСтр("ru = 'Подписи выгружены в каталог ""'; en_US = 'Signature uploaded to the ""'");
	ПоказатьОповещениеПользователя(СтрокаСообщения+КаталогВыгрузки+"""");
	Закрыть(Истина);
КонецПроцедуры

&НаКлиенте
Процедура Отметить(Команда)
	Для Каждого СтрокаПодписи Из Подписи Цикл 
		СтрокаПодписи.Выбран = (Команда.Имя = "Отметить");
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#КонецЕсли


#Если НЕ МобильноеПриложениеСервер Тогда

#Область ОбработчикиСобытийФормыНаСервере

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если НЕ Параметры.Свойство("ФайлСсылка") Тогда 
		Отказ=Истина; Возврат;
	КонецЕсли;
	
	КаталогВыгрузки = ХранилищеОбщихНастроек.Загрузить("КаталогВыгрузкиЭЦП");
	
	ФайлСсылка = Параметры.ФайлСсылка;
	
	МассивСтруктурЭЦП = aps_РаботаСФайламиСервер.aps_ПолучитьВсеЭЦПФайла(ФайлСсылка);
	Для Каждого СтруктураЭЦП Из МассивСтруктурЭЦП Цикл
		СтрокаПодписи = Подписи.Добавить();
		СтрокаПодписи.АдресПодписи = ПоместитьВоВременноеХранилище(СтруктураЭЦП.ДвоичныеДанные, ЭтаФорма.УникальныйИдентификатор);
		// имя файла подписи для выгрузки
		СтрокаПодписи.ИмяФайлаВыгрузки= СтрокаПодписи.КомуВыданСертификат+" "+ФайлСсылка.ИмяФайла+".p7s";
		ЗаполнитьЗначенияСвойств(СтрокаПодписи, СтруктураЭЦП);
	КонецЦикла;
КонецПроцедуры

#КонецОбласти


#Область ПрочиеПроцедурыИФункцииНаСервере

&НаСервере
Процедура СохранитьКаталогВыгрузкиСервер()
	ХранилищеОбщихНастроек.Сохранить("КаталогВыгрузкиЭЦП",, КаталогВыгрузки);
КонецПроцедуры

#КонецОбласти

#КонецЕсли
