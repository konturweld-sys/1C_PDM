	МассивДоступныхВидов.Добавить(Справочники.aps_ВидыЭлементов.АктивныйДокументДетальSolidWorks);
	МассивДоступныхВидов.Добавить(Справочники.aps_ВидыЭлементов.АктивныйДокументСборкаSolidWorks);
	МассивДоступныхВидов.Добавить(Справочники.aps_ВидыЭлементов.АктивныйДокументЧертежКОМПАС);
	МассивДоступныхВидов.Добавить(Справочники.aps_ВидыЭлементов.АктивныйДокументДетальКОМПАС);
	МассивДоступныхВидов.Добавить(Справочники.aps_ВидыЭлементов.АктивныйДокументСборкаКОМПАС);
	МассивДоступныхВидов.Добавить(Справочники.aps_ВидыЭлементов.АктивныйДокументЧертежAutoCAD);
	МассивДоступныхВидов.Добавить(Справочники.aps_ВидыЭлементов.АктивныйДокументДетальAutoCAD);
	МассивДоступныхВидов.Добавить(Справочники.aps_ВидыЭлементов.АктивныйДокументСборкаAutoCAD);
	МассивДоступныхВидов.Добавить(Справочники.aps_ВидыЭлементов.АктивныйДокументЧертежInventor);
	МассивДоступныхВидов.Добавить(Справочники.aps_ВидыЭлементов.АктивныйДокументДетальInventor);
	МассивДоступныхВидов.Добавить(Справочники.aps_ВидыЭлементов.АктивныйДокументСборкаInventor);
	МассивДоступныхВидов.Добавить(Справочники.aps_ВидыЭлементов.АктивныйДокументЧертежSolidEdge);
	МассивДоступныхВидов.Добавить(Справочники.aps_ВидыЭлементов.АктивныйДокументДетальSolidEdge);
	МассивДоступныхВидов.Добавить(Справочники.aps_ВидыЭлементов.АктивныйДокументСборкаSolidEdge);
	ДоступныеВидыЭлементов.ЗагрузитьЗначения(МассивДоступныхВидов);
	
	СписокФайлов.Параметры.УстановитьЗначениеПараметра("ТекущийПользователь", ПараметрыСеанса.ТекущийПользователь);
КонецПроцедуры

#КонецОбласти


#Область ПрочиеПроцедурыИФункцииНаСервере

&НаСервереБезКонтекста
Функция РазыменоватьСервер(Ссылка, Поле)
	Возврат Ссылка[Поле];
КонецФункции

&НаСервереБезКонтекста
Функция ФайлРедактируетсяМной(ФайлСсылка)
	Возврат ФайлСсылка.Редактируется = ПараметрыСеанса.ТекущийПользователь;
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьПутьКВыгруженному(ФайлСсылка)
	КаталогСессии = "";
	ПолучитьИдентификаторСессии(ФайлСсылка.Владелец, КаталогСессии);
	Возврат КаталогСессии+СтрЗаменить(ФайлСсылка.ПолноеНаименование(),"/","\");
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьФайлыДокументаСервер(ДокументСсылка, Знач ЗависимыеДокументы = Неопределено, ТолькоЗависимыеФайлы = Ложь)
	ФайлыДокумента = aps_РаботаСФайламиСервер.aps_ПолучитьФайлыДокумента(ДокументСсылка);
	Если ЗависимыеДокументы=Неопределено Тогда 
		Возврат ФайлыДокумента.ВыгрузитьКолонку("Ссылка"); // без зависимостей
	КонецЕсли;
	
	i=0; МодульПравДоступа = Обработки.aps_ПраваДоступа.Создать();
	Пока i < ЗависимыеДокументы.Количество()-1 Цикл  
		Если НЕ МодульПравДоступа.aps_ПроверитьОбъектПрава(Справочники.aps_Права.Просмотр,ЗависимыеДокументы[i],ЗависимыеДокументы[i].GMOD) Тогда 
			ЗависимыеДокументы.Удалить(i); Продолжить;
		КонецЕсли;
		i=i+1;
	КонецЦикла;
	
	Если ТолькоЗависимыеФайлы Тогда 
		ЗависимыеРасширения = aps_РаботаСФайламиСервер.aps_ПолучитьЗависимыеРасширения(ФайлыДокумента.ВыгрузитьКолонку("Расширение"));
		ЗависимыеФайлы = aps_РаботаСФайламиСервер.aps_ПолучитьЗависимыеФайлыДокумента(ЗависимыеДокументы, ЗависимыеРасширения);
	Иначе // все файлы
		ЗависимыеФайлы = aps_РаботаСФайламиСервер.aps_ПолучитьФайлыДокумента(ЗависимыеДокументы);
	КонецЕсли;
	
	// добавить файлы текущего документа в общий список файлов
	Для i=0 По ФайлыДокумента.Количество()-1 Цикл 
		Если ЗависимыеФайлы.Найти(ФайлыДокумента[i].Ссылка)=Неопределено Тогда 
			ЗаполнитьЗначенияСвойств(ЗависимыеФайлы.Вставить(i), ФайлыДокумента[i]);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ЗависимыеФайлы.ВыгрузитьКолонку("Ссылка");
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьИдентификаторСессии(ДокументСсылка, возвКаталогРедактирования = "")
	ФайлыДокумента = aps_РаботаСФайламиСервер.aps_ПолучитьФайлыДокумента(ДокументСсылка);	
	Для Каждого ФайлДокумента Из ФайлыДокумента Цикл 
		Если НЕ ПустаяСтрока(ФайлДокумента.ИдентификаторCheckOut) Тогда 
			ИдентификаторСессии = ФайлДокумента.ИдентификаторCheckOut;
			
			Если ПустаяСтрока(возвКаталогРедактирования) Тогда 
				возвКаталогРедактирования = aps_РаботаСФайламиСервер.aps_ПерсональныеНастройки().РабочийКаталог;
			КонецЕсли;
			
			возвКаталогРедактирования = aps_РаботаСФайлами.aps_ДобавитьПоследнийСлэш(возвКаталогРедактирования);
			возвКаталогРедактирования = возвКаталогРедактирования+"{"+Сред(ИдентификаторСессии, Найти(ИдентификаторСессии, "/")+1)+"}"+"\";
			Возврат ИдентификаторСессии;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

&НаСервере
Процедура ОбновитьСписокДокументовСервер(МассивДокументов)
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	Документы.Ссылка КАК Документ,
	                      |	Документы.Ссылка.Наименование КАК Представление,
	                      |	Документы.Ссылка.ВидЭлемента.ИндексКартинки КАК Картинка,
	                      |	Документы.Ссылка.ВидЭлемента.Код КАК КодВидаЭлемента,
	                      |	КОЛИЧЕСТВО(ФайлыДокумента.Ссылка) КАК КоличествоФайлов
	                      |ИЗ
	                      |	(ВЫБРАТЬ
	                      |		aps_ЭлементыИзделия.Ссылка КАК Ссылка
	                      |	ИЗ
	                      |		Справочник.aps_ЭлементыИзделия КАК aps_ЭлементыИзделия
	                      |	ГДЕ
	                      |		(НЕ aps_ЭлементыИзделия.ПометкаУдаления)
	                      |		И aps_ЭлементыИзделия.Ссылка В(&Документы)
	                      |	
	                      |	ОБЪЕДИНИТЬ ВСЕ
	                      |	
	                      |	ВЫБРАТЬ
	                      |		aps_ЭлементыСправочников.Ссылка
	                      |	ИЗ
	                      |		Справочник.aps_ЭлементыСправочников КАК aps_ЭлементыСправочников
	                      |	ГДЕ
	                      |		(НЕ aps_ЭлементыСправочников.ПометкаУдаления)
	                      |		И aps_ЭлементыСправочников.Ссылка В(&Документы)
	                      |	
	                      |	ОБЪЕДИНИТЬ ВСЕ
	                      |	
	                      |	ВЫБРАТЬ
	                      |		aps_ЭлементыТехнологии.Ссылка
	                      |	ИЗ
	                      |		Справочник.aps_ЭлементыТехнологии КАК aps_ЭлементыТехнологии
	                      |	ГДЕ
	                      |		(НЕ aps_ЭлементыТехнологии.ПометкаУдаления)
	                      |		И aps_ЭлементыТехнологии.Ссылка В(&Документы)) КАК Документы
	                      |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	                      |			aps_Файлы.Ссылка КАК Ссылка,
	                      |			aps_Файлы.Владелец КАК Владелец
	                      |		ИЗ
	                      |			Справочник.aps_Файлы КАК aps_Файлы
	                      |		ГДЕ
	                      |			(НЕ aps_Файлы.ЭтоГруппа)
	                      |			И aps_Файлы.Владелец В(&Документы)) КАК ФайлыДокумента
	                      |		ПО Документы.Ссылка = ФайлыДокумента.Владелец
	                      |
	                      |СГРУППИРОВАТЬ ПО
	                      |	Документы.Ссылка,
	                      |	Документы.Ссылка.ВидЭлемента.ИндексКартинки,
	                      |	Документы.Ссылка.Наименование,
	                      |	Документы.Ссылка.ВидЭлемента.Код
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	КодВидаЭлемента,
	                      |	Представление");
	Запрос.УстановитьПараметр("Документы", МассивДокументов);
	ТаблицаРезультат = Запрос.Выполнить().Выгрузить();
	Для Каждого СтрокаРезультата Из ТаблицаРезультат Цикл 
		Если СтрокаРезультата.КоличествоФайлов > 0 Тогда 
			СтрокаРезультата.Представление=СтрокаРезультата.Представление+" ("+Строка(СтрокаРезультата.КоличествоФайлов)+")";
		КонецЕсли;
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ТаблицаРезультат, "СписокДокументов");
	Элементы.НадписьДокументов.Заголовок=НСтр("ru = ""Документов (""; en_US = ""Documents (""")+Строка(СписокДокументов.Количество())+")";
КонецПроцедуры

&НаСервере
Процедура ОбновлениеИнформацииВОкне()
	ЭтотОбъектИБ = РеквизитФормыВЗначение("Объект");
	Если ЗначениеЗаполнено(ЭтотОбъектИБ.item) Тогда 
		ПравоИзменения	  =ЭтотОбъектИБ.МодульПравДоступа.aps_ПроверитьОбъектПрава(Справочники.aps_Права.Изменение,ЭтотОбъектИБ.item,ЭтотОбъектИБ.item.GMOD);
		ПравоПросмотра	  =ЭтотОбъектИБ.МодульПравДоступа.aps_ПроверитьОбъектПрава(Справочники.aps_Права.Просмотр,ЭтотОбъектИБ.item,ЭтотОбъектИБ.item.GMOD);
		
		РедактирующийПользователь = ЭтотОбъектИБ.item.РедактирующийПользователь;
		
		Редактируется	  =НЕ РедактирующийПользователь.Пустая();
		РедактируетсяМной =Редактируется И РедактирующийПользователь=ПараметрыСеанса.ТекущийПользователь;
		
		Элементы.СписокФайловКоманднаяПанель.Доступность=ПравоПросмотра;
		
		Если ПравоПросмотра Тогда 
			СписокФайлов.Отбор.Элементы[0].ПравоеЗначение = ЭтотОбъектИБ.item;
			
			Элементы.СоздатьПапку.Доступность		=ПравоИзменения И НЕ Редактируется;
			Элементы.ИмпортПапки.Доступность		=ПравоИзменения И НЕ Редактируется;
			Элементы.ИмпортФайлов.Доступность		=ПравоИзменения И НЕ Редактируется;
			Элементы.Удалить.Доступность			=ПравоИзменения И НЕ Редактируется;
			Элементы.Редактировать.Доступность		=ПравоИзменения И НЕ Редактируется;
			Элементы.Сохранить.Доступность			=ПравоИзменения И РедактируетсяМной;
			Элементы.СохранитьРевизией.Доступность	=ПравоИзменения И РедактируетсяМной;
			Элементы.Отменить.Доступность			=ПравоИзменения И РедактируетсяМной;
			Элементы.Получить.Доступность			=ПравоИзменения И РедактируетсяМной;
			Элементы.Поместить.Доступность			=ПравоИзменения И РедактируетсяМной;
			// группа ЭЦП
			Элементы.Подписать.Доступность			=ПравоИзменения И НЕ Редактируется;
			Элементы.УдалитьПодпись.Доступность		=ПравоИзменения И НЕ Редактируется;
			Элементы.Зашифровать.Доступность		=ПравоИзменения И НЕ Редактируется;
			Элементы.Расшифровать.Доступность		=ПравоИзменения И НЕ Редактируется;
		Иначе 
			СписокФайлов.Отбор.Элементы[0].ПравоеЗначение = Справочники.aps_ЭлементыИзделия.ПустаяСсылка();
		КонецЕсли;
		
		Элементы.ГруппаРедактируется.Видимость = Редактируется;
		Элементы.ОткрытьКаталогРедактирования.Видимость = РедактируетсяМной;
		
	Иначе 
		СписокФайлов.Отбор.Элементы[0].ПравоеЗначение = Справочники.aps_ЭлементыИзделия.ПустаяСсылка();
		Элементы.СписокФайловКоманднаяПанель.Доступность=Ложь;
		
		Элементы.ГруппаРедактируется.Видимость = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьИмяОбъектаПоСсылке(ФайлСсылка, ОписаниеОшибки, Строка)
	ФайлОбъект=ФайлСсылка.ПолучитьОбъект();
	ФайлОбъект.Родитель=Строка;
    Возврат ФайлОбъект.ПроверитьИмя(ОписаниеОшибки);
КонецФункции

&НаСервереБезКонтекста
Функция УдалитьФайлСервер(Ссылка)
	Попытка
		Ссылка.ПолучитьОбъект().Удалить();
	Исключение
	КонецПопытки;
КонецФункции

#КонецОбласти

