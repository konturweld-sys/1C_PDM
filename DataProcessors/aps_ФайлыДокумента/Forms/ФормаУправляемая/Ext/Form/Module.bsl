#Если НЕ МобильноеПриложениеКлиент Тогда

#Область ОписаниеПеременных	
	
&НаКлиенте
Перем ФормаИсточник;			// Источник оповещения
&НаКлиенте
Перем ДеревоРодителя Экспорт;	// Дерево родителя. Необходимо для ассоциативной выгрузки файлов, а также для построения списка документов

#КонецОбласти


#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	#Если ВебКлиент Тогда 
	Элементы.ИмпортПапки.Видимость				=Ложь;
	Элементы.ГруппаРедактировать.Видимость		=Ложь;
	Элементы.ГруппаПолучитьПоместить.Видимость	=Ложь;
	#КонецЕсли
	
	ОбработкаОповещения("AppiusWindowGeneralNotify", aps_СтруктураПараметровОповещения,?(aps_СтруктураПараметровОповещения.Свойство("ФормаИсточник"),aps_СтруктураПараметровОповещения.ФормаИсточник,Неопределено));
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия="AppiusWindowGeneralNotify" Тогда
		// Не реагировать на оповещение от подчиненной формы и от самой себя
		ВладелецФормыИсточника = Источник;
		Пока ВладелецФормыИсточника <> Неопределено Цикл 
			Если ВладелецФормыИсточника = ЭтаФорма Тогда 
				Возврат;
			КонецЕсли;
			Если ТипЗнч(ВладелецФормыИсточника)=Тип("УправляемаяФорма") Тогда 
				ВладелецФормыИсточника = ВладелецФормыИсточника.ВладелецФормы;
			Иначе 
				ВладелецФормыИсточника = Неопределено;
			КонецЕсли;
		КонецЦикла;
		
		Если Параметр.Свойство("item") И ЗначениеЗаполнено(Параметр.item) И 
				ДоступныеВидыЭлементов.НайтиПоЗначению(РазыменоватьСервер(Параметр.item, "ВидЭлемента")) <> Неопределено Тогда 
					
			Объект.item=Параметр.item;
			ДеревоРодителя=?(Параметр.Свойство("parentItemTree"), Параметр.parentItemTree, Неопределено);
			ФормаИсточник=Неопределено;
			
			ОбновлениеИнформацииВОкне();
			Заголовок=НСтр("ru = ""Файлы: ""; en_US = ""Files: """)+Строка(Объект.item);

			ПереключитьсяНаСтраницу("СтраницаФайлов");
			
		ИначеЕсли Параметр.Свойство("ФормаИсточник") И Параметр.Свойство("itemTree") Тогда
			
			Объект.item=Неопределено;
			ДеревоРодителя=Параметр.itemTree;
			ФормаИсточник=Параметр.ФормаИсточник;
			
			Заголовок=НСтр("ru = ""Документы: ""; en_US = ""Documents: """)+ДеревоРодителя.Представление;
			ОбновитьСписокДокументов();
			
			ПереключитьсяНаСтраницу("СтраницаДокументов");
			
		Иначе 
			Заголовок=НСтр("ru = ""Документы и файлы""; en_US = ""Documents and files""");
			ПереключитьсяНаСтраницу("СтраницаПустая");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыгрузитьФайлы(Команда)
	Если НЕ aps_РаботаСФайлами.aps_ПодключитьРасширениеРаботыСФайлами() Тогда
		Возврат;
	КонецЕсли;
	
	МассивЗависимыхДокументов = Новый Массив();
	// в параметр формы передаем массив файлов всех документов, полученных по дереву родителя
	МассивФайловКВыгрузке = ПолучитьФайлыДокумента(Ложь, МассивЗависимыхДокументов);
	Если МассивФайловКВыгрузке.Количество() = 0 Тогда 
		Предупреждение(НСтр("ru = ""Не найдено ни одного файла!""; en_US = ""No file was found!"""));
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("СписокФайлов"			, МассивФайловКВыгрузке);
	ПараметрыФормы.Вставить("Режим"					, 3);
	ПараметрыФормы.Вставить("ВозможностьАрхивации"	, Истина);
	ФормаСпискаФайлов = ПолучитьФорму("Обработка.aps_ФайлыДокумента.Форма.ФормаВыгружаемыхФайлов", ПараметрыФормы, ЭтаФорма);
	МассивФайловКВыгрузке = ФормаСпискаФайлов.ОткрытьМодально();
	Если МассивФайловКВыгрузке = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КаталогВыгрузкиФайлов = ФормаСпискаФайлов.КаталогВыгрузки;
	
	Если ФормаСпискаФайлов.ЗапаковатьВАрхив Тогда 
		#Если Не ВебКлиент Тогда 
		// выгрузка во временный каталог и создание архива 
		ВремКаталогАрхивации = КаталогВременныхФайлов()+"{"+Строка(Новый УникальныйИдентификатор())+"}";
		
		Попытка
			СоздатьКаталог(ВремКаталогАрхивации);
		Исключение
			Предупреждение(НСтр("ru = 'Не удалось создать каталог ""' en_US = 'Cannot create the ""'")+ВремКаталогАрхивации+НСтр("ru = '"" по причине:'; en_US = '"" directory: '")+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Возврат;
		КонецПопытки;

		// параметры выгрузки по умолчанию
		ПараметрыВыгрузки = aps_РаботаСФайлами.aps_СформироватьСтруктуруПараметровВыгрузки();
		ПараметрыВыгрузки.ТолькоЧтение = Ложь;
		ПараметрыВыгрузки.Расшифровать = ФормаСпискаФайлов.Расшифровать;
		aps_РаботаСФайлами.aps_ВыгрузкаФайловНаДиск(ВремКаталогАрхивации, МассивФайловКВыгрузке, ПараметрыВыгрузки);
		
		СтруктураZipАрхива = Новый Структура;
		СтруктураZipАрхива.Вставить("ПолноеИмяФайла", КаталогВыгрузкиФайлов+ФормаСпискаФайлов.ИмяАрхива+".zip");
		СтруктураZipАрхива.Вставить("Пароль"		, ФормаСпискаФайлов.Пароль);
		
		aps_РаботаСФайлами.aps_АрхивацияФайлов(ВремКаталогАрхивации, СтруктураZipАрхива);
		// удалить папку и файлы после архивации
		УдалитьФайлы(ВремКаталогАрхивации);
		#КонецЕсли
	Иначе // выгрузка в указанный каталог
		ПараметрыВыгрузки = aps_РаботаСФайлами.aps_СформироватьСтруктуруПараметровВыгрузки();
		ПараметрыВыгрузки.ТолькоЧтение = Ложь;
		ПараметрыВыгрузки.Расшифровать = ФормаСпискаФайлов.Расшифровать;
		aps_РаботаСФайлами.aps_ВыгрузкаФайловНаДиск(КаталогВыгрузкиФайлов, МассивФайловКВыгрузке, ПараметрыВыгрузки);
	КонецЕсли;
	
	aps_РаботаСФайлами.aps_ЗапуститьПриложение("explorer "+КаталогВыгрузкиФайлов);
	
КонецПроцедуры

&НаКлиенте
Процедура ИмпортПапки(Команда)
	Если НЕ aps_РаботаСФайлами.aps_ПодключитьРасширениеРаботыСФайлами() Тогда
		Возврат;
	КонецЕсли;
	
	ДиалогВыбораФайлов = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Если ДиалогВыбораФайлов.Выбрать() Тогда
		Если РазыменоватьСервер(ТекущийФайлИлиПапка, "ЭтоГруппа") Тогда
			ТекущаяПапка=ТекущийФайлИлиПапка;
		Иначе
			ТекущаяПапка=РазыменоватьСервер(ТекущийФайлИлиПапка, "Родитель");
		КонецЕсли;
		
		aps_РаботаСФайлами.aps_ИмпортФайловИКаталоговСДиска(Объект.item, ТекущаяПапка, НайтиФайлы(ДиалогВыбораФайлов.Каталог, "*.*"));
		
		Элементы.СписокФайлов.Обновить();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ИмпортФайлов(Команда)
	Если НЕ aps_РаботаСФайлами.aps_ПодключитьРасширениеРаботыСФайлами() Тогда
		Возврат;
	КонецЕсли;
	
	ДиалогВыбораФайлов = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбораФайлов.МножественныйВыбор = Истина;
	ДиалогВыбораФайлов.Фильтр = 
		НСтр("ru='Все файлы (*.*)|*.*|Сборки SolidEdge (*.ASM)|*.ASM|Детали SolidEdge (*.PRT)|*.PRT|Сборки SolidWorks (*.SLDASM)|*.SLDASM|Детали SolidWorks (*.SLDPRT)|*.SLDPRT|Сборки КОМПАС (*.A3D)|*.A3D|Детали КОМПАС (*.M3D)|*.M3D';en_US='All files (*.*)|*.*|SolidEdge assemblies (*.ASM)|*.ASM|SolidEdge parts (*.PRT)|*.PRT|SolidWorks assemblies (*.SLDASM)|*.SLDASM|SolidWorks parts (*.SLDPRT)|*.SLDPRT|KOMPAS assemblies (*.A3D)|*.A3D|KOMPAS parts (*.M3D)|*.M3D'"+
			 "en_US = ""All files (*.*)|*.*|SolidEdge assemblies (*.ASM)|*.ASM|SolidEdge parts (*.PRT)|*.PRT|SolidWorks assemblies (*.SLDASM)|*.SLDASM|SolidWorks parts (*.SLDPRT)|*.SLDPRT|KOMPAS assemblies (*.A3D)|*.A3D|KOMPAS parts (*.M3D)|*.M3D""");
		
	Если ДиалогВыбораФайлов.Выбрать() Тогда
		
		Если РазыменоватьСервер(ТекущийФайлИлиПапка, "ЭтоГруппа") Тогда
			ТекущаяПапка=ТекущийФайлИлиПапка;
		Иначе
			ТекущаяПапка=РазыменоватьСервер(ТекущийФайлИлиПапка, "Родитель");
		КонецЕсли;
	
		МассивФайловДляИмпорта = Новый Массив;
		Для Каждого ВыбранныйФайл Из ДиалогВыбораФайлов.ВыбранныеФайлы Цикл 
			МассивФайловДляИмпорта.Добавить(Новый Файл(ВыбранныйФайл));
		КонецЦикла;		
		
		aps_РаботаСФайлами.aps_ИмпортФайловИКаталоговСДиска(Объект.item, ТекущаяПапка, МассивФайловДляИмпорта);
		
		Элементы.СписокФайлов.Обновить();		
			
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КСпискуДокументов(Команда)
	Если ДеревоРодителя<>Неопределено Тогда
		Объект.item = Неопределено;
		ОбновитьСписокДокументов();
		ПереключитьсяНаСтраницу("СтраницаДокументов");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Редактировать(Команда)
	ПерсональныеНастройки = aps_РаботаСФайламиСервер.aps_ПерсональныеНастройки();
	Если ПустаяСтрока(ПерсональныеНастройки.РабочийКаталог) Тогда 
		Предупреждение(НСтр("ru = ""Необходимо указать рабочий каталог в персональных настройках!""; en_US = ""Working catalog must be specified in personal settings!"""));
		Возврат;
	КонецЕсли;
	
	СисИнфо = Новый СистемнаяИнформация();
	ИдентификаторСессии = Строка(СисИнфо.ИдентификаторКлиента)+"/"+Строка(Новый УникальныйИдентификатор());
	
	КаталогСессии = aps_РаботаСФайлами.aps_ДобавитьПоследнийСлэш(ПерсональныеНастройки.РабочийКаталог);
	КаталогСессии = КаталогСессии+"{"+Сред(ИдентификаторСессии, Найти(ИдентификаторСессии, "/")+1)+"}"+"\";
	
	МассивЗависимыхДокументов = Новый Массив();
	// в параметр формы передаем массив файлов этого документа с зависимыми файлами
	МассивФайловКВыгрузке = ПолучитьФайлыДокумента(Истина, МассивЗависимыхДокументов);
	Если МассивФайловКВыгрузке.Количество() = 0 Тогда 
		Предупреждение(НСтр("ru = ""Не найдено ни одного файла!""; en_US = ""No file was found!"""));
		Возврат;
	КонецЕсли;
	
	Если МассивФайловКВыгрузке.Количество() > 1 Тогда 
		КодЗакрытия = aps_ПолныеПрава.aps_ПараметрСеанса("aps_РежимВыгрузкиФайлов");
		Если КодЗакрытия = 0 Тогда 
			// показать форму режима выгрузки файлов
			ФормаРежимаВыгрузки = ПолучитьФорму("Обработка.aps_ФайлыДокумента.Форма.ФормаРежимаВыгрузки",, ЭтаФорма);
			КодЗакрытия = ФормаРежимаВыгрузки.ОткрытьМодально();
			Если КодЗакрытия = Неопределено Тогда
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		Если КодЗакрытия = 1 Тогда // только этот файл
			МассивФайловКВыгрузке.Очистить();
			МассивФайловКВыгрузке.Добавить(ТекущийФайлИлиПапка);
			
		ИначеЕсли КодЗакрытия = 2 Тогда // выбор файлов для просмотра вручную
			ПараметрыФормы = Новый Структура();
			ПараметрыФормы.Вставить("СписокФайлов"		, МассивФайловКВыгрузке);
			ПараметрыФормы.Вставить("Режим"				, 2);
			ПараметрыФормы.Вставить("КаталогВыгрузки"	, КаталогСессии);
			
			ФормаСпискаФайлов = ПолучитьФорму("Обработка.aps_ФайлыДокумента.Форма.ФормаВыгружаемыхФайлов", ПараметрыФормы, ЭтаФорма);
			МассивФайловКВыгрузке = ФормаСпискаФайлов.ОткрытьМодально();
			Если МассивФайловКВыгрузке = Неопределено Тогда
				Возврат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Попытка
		СоздатьКаталог(КаталогСессии);
	Исключение
		Предупреждение(НСтр("ru = 'Невозможно создать каталог ""'; en_US = 'Cannot create the ""'")+КаталогСессии+НСтр("ru = '"".'; en_US = '"" directory.'")+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	
	// выгрузка в указанный каталог
	ПараметрыВыгрузки = aps_РаботаСФайлами.aps_СформироватьСтруктуруПараметровВыгрузки();
	ПараметрыВыгрузки.ИдентификаторСессии	= ИдентификаторСессии;
	ПараметрыВыгрузки.УстановитьБлокировки	= Истина;
	Если ФормаСпискаФайлов = Неопределено Тогда 
		Если РазыменоватьСервер(МассивФайловКВыгрузке[0], "Зашифрован")
				И Вопрос(НСтр("ru = 'Файл ""'; en_US = 'The ""'")+Строка(МассивФайловКВыгрузке[0])+НСтр("ru = '"" зашифрован. Расшифровать локальную копию файла?'; en_US = '"" file is encrypted. Decrypt the local copy of file?'"), РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда 
			ПараметрыВыгрузки.Расшифровать = Истина;
		Иначе 
			ПараметрыВыгрузки.Расшифровать = Ложь;
		КонецЕсли;
	Иначе 
		ПараметрыВыгрузки.Расшифровать = ФормаСпискаФайлов.Расшифровать;
	КонецЕсли;
	
	Если ПараметрыВыгрузки.Расшифровать Тогда 
		МенеджерКриптографии = aps_РаботаСФайлами.aps_ПолучитьМенеджерКриптографии(ПерсональныеНастройки.ПараметрыКриптографии);
		Если МенеджерКриптографии = Неопределено Тогда 
			Возврат;
		КонецЕсли;
		
		ПараметрыВыгрузки.МенеджерКриптографии = МенеджерКриптографии;
	КонецЕсли;
	
	ВыгруженныеФайлы = aps_РаботаСФайлами.aps_ВыгрузкаФайловНаДиск(КаталогСессии, МассивФайловКВыгрузке, ПараметрыВыгрузки);
	Если ВыгруженныеФайлы <> Неопределено Тогда 
		ПолноеИмяФайла = ВыгруженныеФайлы.Получить(ТекущийФайлИлиПапка);
		Если ПолноеИмяФайла <> Неопределено Тогда 
			aps_РаботаСФайлами.aps_ЗапуститьПриложение(ПолноеИмяФайла);
		КонецЕсли;
	КонецЕсли;
	
	ОбновлениеИнформацииВОкне();
КонецПроцедуры

&НаКлиенте
Процедура Отменить(Команда)
	КаталогСессии = "";
	ИдентификаторСессии = ПолучитьИдентификаторСессии(Объект.item, КаталогСессии);
	
	aps_РаботаСФайлами.aps_ОтменитьИзмененияРедактирования(ИдентификаторСессии, КаталогСессии);
	ОбновлениеИнформацииВОкне();
КонецПроцедуры

&НаКлиенте
Процедура Получить(Команда)
	ПерсональныеНастройки = aps_РаботаСФайламиСервер.aps_ПерсональныеНастройки();
	
	КаталогСессии = ПерсональныеНастройки.РабочийКаталог;
	ИдентификаторСессии = ПолучитьИдентификаторСессии(Объект.item, КаталогСессии);
	
	МассивЗависимыхДокументов = Новый Массив();
	// в параметр формы передаем массив файлов этого документа с зависимыми файлами
	МассивФайловКВыгрузке = ПолучитьФайлыДокумента(Истина, МассивЗависимыхДокументов);
	Если МассивФайловКВыгрузке.Количество() = 0 Тогда 
		Предупреждение(НСтр("ru = ""Не найдено ни одного файла!""; en_US = ""No file was found!"""));
		Возврат;
	КонецЕсли;
	
	Если МассивФайловКВыгрузке.Количество() > 1 Тогда 
		ПараметрыФормы = Новый Структура();
		ПараметрыФормы.Вставить("СписокФайлов"			, МассивФайловКВыгрузке);
		ПараметрыФормы.Вставить("Режим"					, 3);
		ПараметрыФормы.Вставить("КаталогВыгрузки"		, КаталогСессии);
		ПараметрыФормы.Вставить("ИдентификаторСессии"	, ИдентификаторСессии);

		ФормаСпискаФайлов = ПолучитьФорму("Обработка.aps_ФайлыДокумента.Форма.ФормаВыгружаемыхФайлов", ПараметрыФормы, ЭтаФорма);
		МассивФайловКВыгрузке = ФормаСпискаФайлов.ОткрытьМодально();
		Если МассивФайловКВыгрузке = Неопределено Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Попытка
		СоздатьКаталог(КаталогСессии);
	Исключение
		Предупреждение(НСтр("ru = 'Невозможно создать каталог ""' en_US = 'Cannot create the ""'")+КаталогСессии+НСтр("ru = '"".'; en_US = '"" directory.'")+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	
	// выгрузка в указанный каталог
	ПараметрыВыгрузки = aps_РаботаСФайлами.aps_СформироватьСтруктуруПараметровВыгрузки();
	ПараметрыВыгрузки.ИдентификаторСессии	= ИдентификаторСессии;
	ПараметрыВыгрузки.УстановитьБлокировки	= Ложь;
	Если ФормаСпискаФайлов = Неопределено Тогда 
		Если РазыменоватьСервер(МассивФайловКВыгрузке[0], "Зашифрован")
				И Вопрос(НСтр("ru = 'Файл ""'; en_US = 'The ""'")+Строка(МассивФайловКВыгрузке[0])+НСтр("ru = '"" зашифрован. Расшифровать локальную копию файла?'; en_US = '"" file is encrypted. Decrypt the local copy of file?'"), РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда 
			ПараметрыВыгрузки.Расшифровать = Истина;
		Иначе 
			ПараметрыВыгрузки.Расшифровать = Ложь;
		КонецЕсли;
	Иначе 
		ПараметрыВыгрузки.Расшифровать = ФормаСпискаФайлов.Расшифровать;
	КонецЕсли;
	
	Если ПараметрыВыгрузки.Расшифровать Тогда 
		МенеджерКриптографии = aps_РаботаСФайлами.aps_ПолучитьМенеджерКриптографии(ПерсональныеНастройки.ПараметрыКриптографии);
		Если МенеджерКриптографии = Неопределено Тогда 
			Возврат;
		КонецЕсли;

		ПараметрыВыгрузки.МенеджерКриптографии = МенеджерКриптографии;
	КонецЕсли;
	
	aps_РаботаСФайлами.aps_ВыгрузкаФайловНаДиск(КаталогСессии, МассивФайловКВыгрузке, ПараметрыВыгрузки);
КонецПроцедуры

&НаКлиенте
Процедура Поместить(Команда)
	Сохранить(Команда);
КонецПроцедуры

&НаКлиенте
Процедура Сохранить(Команда)
	КаталогСессии = "";
	ИдентификаторСессии = ПолучитьИдентификаторСессии(Объект.item, КаталогСессии);
	
	aps_РаботаСФайлами.aps_СохранитьИзмененияРедактирования(ИдентификаторСессии, КаталогСессии, Команда.Имя = "Сохранить");
	ОбновлениеИнформацииВОкне();
КонецПроцедуры

&НаКлиенте
Процедура СохранитьРевизией(Команда)
	КаталогСессии = "";
	ИдентификаторСессии = ПолучитьИдентификаторСессии(Объект.item, КаталогСессии);
	
	aps_РаботаСФайлами.aps_СохранитьИзмененияРедактирования(ИдентификаторСессии, КаталогСессии, Истина, Истина);
	ОбновлениеИнформацииВОкне();
КонецПроцедуры

&НаКлиенте
Процедура Свойства(Команда)
	Если НЕ ТекущийФайлИлиПапка.Пустая() Тогда
		ПараметрыФормы = Новый Структура("Ключ", ТекущийФайлИлиПапка);
		Если РазыменоватьСервер(ТекущийФайлИлиПапка, "ЭтоГруппа") Тогда 
			Форма = ПолучитьФорму("Справочник.aps_Файлы.ФормаГруппы", ПараметрыФормы);
		Иначе 
			Форма = ПолучитьФорму("Справочник.aps_Файлы.ФормаОбъекта", ПараметрыФормы);
		КонецЕсли;
		
		Форма.ОткрытьМодально();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СоздатьПапку(Команда)
	Если РазыменоватьСервер(ТекущийФайлИлиПапка, "ЭтоГруппа") Тогда
		ТекущаяПапка=ТекущийФайлИлиПапка;
	Иначе
		ТекущаяПапка=РазыменоватьСервер(ТекущийФайлИлиПапка, "Родитель");
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("ЭтоГруппа", Истина);
	ПараметрыФормы.Вставить("Владелец", Объект.item);
	ПараметрыФормы.Вставить("Родитель", ТекущаяПапка);
	ОткрытьФорму("Справочник.aps_Файлы.Форма.ФормаГруппы", ПараметрыФормы);
КонецПроцедуры

&НаКлиенте
Процедура Удалить(Команда)
	ВыделенныеСтроки = Элементы.СписокФайлов.ВыделенныеСтроки;
	Если ВыделенныеСтроки.Количество()=0 Тогда
		Возврат;
	КонецЕсли;
	
	МассивВыделенныхФайлов=Новый Массив();
	Для i=0 По ВыделенныеСтроки.Количество()-1 Цикл 
		МассивВыделенныхФайлов.Добавить(Элементы.СписокФайлов.ДанныеСтроки(ВыделенныеСтроки[i]).Ссылка);
	КонецЦикла;
	
	Если МассивВыделенныхФайлов.Количество()>1 Тогда
		СтрокаСообщения = НСтр("ru = ""Удалить выделенные файлы (""; en_US = ""Delete selected items (""")+Строка(МассивВыделенныхФайлов.Количество())+")?";
	Иначе
		Если РазыменоватьСервер(МассивВыделенныхФайлов[0], "ЭтоГруппа") Тогда
			СтрокаСообщения = НСтр("ru = 'Удалить папку ""'; en_US = 'Delete the ""'")+Строка(МассивВыделенныхФайлов[0])+НСтр("ru = '""?' en_US = '"" folder?'");
		ИначеЕсли ЗначениеЗаполнено(МассивВыделенныхФайлов[0]) Тогда 
			СтрокаСообщения = НСтр("ru = 'Удалить файл ""'; en_US = 'Delete the ""'")+Строка(МассивВыделенныхФайлов[0])+НСтр("ru = '""?'; en_US = '"" file?'");
		Иначе
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если Вопрос(СтрокаСообщения,РежимДиалогаВопрос.ДаНет)<>КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ФайлСсылка Из МассивВыделенныхФайлов Цикл
		Если РазыменоватьСервер(ФайлСсылка, "ЭтоГруппа") Тогда 
			Состояние(НСтр("ru = 'Удаление папки ""'; en_US = 'Deleting the ""'")+Строка(ФайлСсылка)+НСтр("ru = '"" из базы данных...'; en_US = '"" folder from database...'"));
		Иначе 
			Состояние(НСтр("ru = 'Удаление файла ""'; en_US = 'Deleting the ""'")+Строка(ФайлСсылка)+НСтр("ru = '"" из базы данных...'; en_US = '"" file from database...'"));
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ФайлСсылка) Тогда 
			УдалитьФайлСервер(ФайлСсылка);
		КонецЕсли;
	КонецЦикла;
	
	Состояние(НСтр("ru = ""Удаление файлов завершено.""; en_US = ""File deleting is complete."""));
	
	Элементы.СписокФайлов.Обновить();
КонецПроцедуры


&НаКлиенте
Процедура СоздатьДокумент(Команда)
	// установить доступные для создания виды
	ВидыДляСоздания = Новый Массив;
	ВидыДляСоздания.Добавить(ДоступныеВидыЭлементов[0].Значение); // документ
	ПараметрыФормы = Новый Структура("ВидыДляСоздания", ВидыДляСоздания);
	МассивСозданных = ПолучитьФорму("Обработка.aps_СозданиеОбъектов.Форма.ФормаСозданияИРазмещения", ПараметрыФормы, ЭтаФорма).ОткрытьМодально();
	Если МассивСозданных <> Неопределено Тогда 
		ЭлементФормыИсточника = ФормаИсточник.Элементы.Дерево;
		ФормаИсточник.ДеревоПеретаскивание(ЭлементФормыИсточника, Новый Структура("Значение", МассивСозданных), Ложь, ЭлементФормыИсточника.ТекущаяСтрока, Неопределено);
	КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура Подписать(Команда)
	Если НЕ aps_РаботаСФайлами.aps_ПодключитьРасширениеРаботыСКриптографией() Тогда
		Возврат;
	КонецЕсли;
	
	ФайлыДокумента = ПолучитьФайлыДокументаСервер(Объект.item);
	
	ПерсональныеНастройки = aps_РаботаСФайламиСервер.aps_ПерсональныеНастройки();
	ПараметрыКриптографии = ПерсональныеНастройки.ПараметрыКриптографии;

	СертификатДляПодписиДвоичныеДанные = ПараметрыКриптографии.СертификатДляПодписи;
	Если СертификатДляПодписиДвоичныеДанные = Неопределено Тогда 
		Предупреждение(НСтр("ru = ""Необходимо указать сертификат электронной цифровой подписи в персональных настройках!""; en_US = ""Certificate of digital signature must be specified in personal settings!"""));
		Возврат;
	КонецЕсли;
	
	МенеджерКриптографии = aps_РаботаСФайлами.aps_ПолучитьМенеджерКриптографии(ПараметрыКриптографии);	
	Если МенеджерКриптографии = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Если Вопрос(НСтр("ru = ""Подписать все файлы этого документа Вашим сертификатом?""; en_US = ""Sign all files of this document with your certificate?"""), РежимДиалогаВопрос.ДаНет)<>КодВозвратаДиалога.Да Тогда 
		Возврат;
	КонецЕсли;
	
	СертификатДляПодписи = Новый СертификатКриптографии(СертификатДляПодписиДвоичныеДанные);
	aps_РаботаСФайлами.aps_ПодписатьНесколькоФайлов(МенеджерКриптографии, СертификатДляПодписи, ФайлыДокумента);
	
	Элементы.СписокФайлов.Обновить();
КонецПроцедуры

&НаКлиенте
Процедура УдалитьПодпись(Команда)
	Если Вопрос(НСтр("ru = ""Удалить Вашу подпись у всех файлов этого документа?""; en_US = ""Delete your signature from all files of this document?"""), РежимДиалогаВопрос.ДаНет)<>КодВозвратаДиалога.Да Тогда 
		Возврат;
	КонецЕсли;
	
	ФайлыДокумента = ПолучитьФайлыДокументаСервер(Объект.item);
	
	ТекущийПользователь = aps_ПолныеПрава.aps_ПараметрСеанса("ТекущийПользователь");
	УдаляемыеПодписи = Новый Соответствие;
	
	Попытка
		Для Каждого ФайлСсылка Из ФайлыДокумента Цикл 
			Состояние(НСтр("ru = 'Обрабатывается файл ""'; en_US = 'The ""'")+Строка(ФайлСсылка)+НСтр("ru = '""...'; en_US = '"" file processing...'"));
			
			i=0;
			МассивСтруктурПодписей = aps_РаботаСФайламиСервер.aps_ПолучитьВсеЭЦПФайла(ФайлСсылка);
			Пока i < МассивСтруктурПодписей.Количество() Цикл 
				Если МассивСтруктурПодписей[i].АвторПодписи <> ТекущийПользователь Тогда 
					МассивСтруктурПодписей.Удалить(i); Продолжить;
				КонецЕсли;
				i=i+1;
			КонецЦикла;
			
			Если МассивСтруктурПодписей.Количество() > 0 Тогда 
				УдаляемыеПодписи.Вставить(ФайлСсылка, МассивСтруктурПодписей);
			КонецЕсли;
		КонецЦикла;
		
		Состояние(НСтр("ru = ""Удаление подписей у файлов...""; en_US = ""Deleting signatures from files..."""));
		aps_РаботаСФайламиСервер.aps_УдалитьДанныеЭЦПДляНесколькихФайлов(УдаляемыеПодписи);
	Исключение
		Сообщить(aps_ПолныеПрава.aps_ПараметрСеанса("aps_ИмяПродукта")
			+НСтр("ru = ""Не удалось удалить подписи у файлов по причине:""; en_US = ""Cannot delete signatures from files:""")+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), СтатусСообщения.Внимание);
		Возврат;
	КонецПопытки;
	
	Состояние(НСтр("ru = ""Процесс удаления подписей у файлов завершен.""; en_US = ""Deleting signatures from files is complete."""));
	Элементы.СписокФайлов.Обновить();
КонецПроцедуры

&НаКлиенте
Процедура Зашифровать(Команда)
	Если НЕ aps_РаботаСФайлами.aps_ПодключитьРасширениеРаботыСКриптографией() Тогда
		Возврат;
	КонецЕсли;
	
	ФайлыДокумента = ПолучитьФайлыДокументаСервер(Объект.item);
	
	ПерсональныеНастройки = aps_РаботаСФайламиСервер.aps_ПерсональныеНастройки();
	ПараметрыКриптографии = ПерсональныеНастройки.ПараметрыКриптографии;

	МенеджерКриптографии = aps_РаботаСФайлами.aps_ПолучитьМенеджерКриптографии(ПараметрыКриптографии);	
	Если МенеджерКриптографии = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Если Вопрос(НСтр("ru = ""Зашифровать все файлы этого документа?""; en_US = ""Encrypt all files of this document?"""), РежимДиалогаВопрос.ДаНет)<>КодВозвратаДиалога.Да Тогда 
		Возврат;
	КонецЕсли;
	
	aps_РаботаСФайлами.aps_ЗашифроватьНесколькоФайлов(МенеджерКриптографии, ФайлыДокумента);
	
	Элементы.СписокФайлов.Обновить();
КонецПроцедуры

&НаКлиенте
Процедура Расшифровать(Команда)
	Если НЕ aps_РаботаСФайлами.aps_ПодключитьРасширениеРаботыСКриптографией() Тогда
		Возврат;
	КонецЕсли;
	
	ФайлыДокумента = ПолучитьФайлыДокументаСервер(Объект.item);
	
	ПерсональныеНастройки = aps_РаботаСФайламиСервер.aps_ПерсональныеНастройки();
	ПараметрыКриптографии = ПерсональныеНастройки.ПараметрыКриптографии;

	МенеджерКриптографии = aps_РаботаСФайлами.aps_ПолучитьМенеджерКриптографии(ПараметрыКриптографии);	
	Если МенеджерКриптографии = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Если Вопрос(НСтр("ru = ""Расшифровать все файлы этого документа?""; en_US = ""Decrypt all files of this document?"""), РежимДиалогаВопрос.ДаНет)<>КодВозвратаДиалога.Да Тогда 
		Возврат;
	КонецЕсли;
	
	aps_РаботаСФайлами.aps_РасшифроватьНесколькоФайлов(МенеджерКриптографии, ФайлыДокумента);
	
	Элементы.СписокФайлов.Обновить();
КонецПроцедуры

&НаКлиенте
Процедура ПерсональныеНастройки(Команда)
	ОткрытьФорму("Обработка.aps_ФайлыДокумента.Форма.ФормаПерсональныхНастроек");
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьКаталогРедактирования(Команда)
	Если НЕ aps_РаботаСФайлами.aps_ПодключитьРасширениеРаботыСФайлами() Тогда 
		Возврат;
	КонецЕсли;
	
	КаталогСессии = "";
	ИдентификаторСессии = ПолучитьИдентификаторСессии(Объект.item, КаталогСессии);
	
	КаталогНаДиске = Новый Файл(КаталогСессии);
	Если НЕ КаталогНаДиске.Существует() Тогда 
		Предупреждение(НСтр("ru = 'Каталог ""'; en_US = 'The ""'")+КаталогСессии+НСтр("ru = '"" не обнаружен на данном компьютере!'; en_US = '"" directory is not found on this computer!'"));
		Возврат;
	КонецЕсли;

	aps_РаботаСФайлами.aps_ЗапуститьПриложение("explorer "+КаталогСессии);
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийСпискаФайлов

&НаКлиенте
Процедура СписокФайловПриАктивизацииСтроки(Элемент)
	ТекущаяСтрока = Элемент.ТекущиеДанные;
	Если ТекущаяСтрока<>Неопределено Тогда 
		ТекущийФайлИлиПапка = ТекущаяСтрока.Ссылка;
	Иначе 
		ТекущийФайлИлиПапка = Неопределено;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СписокФайловОкончаниеПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка)
	Элемент.ТолькоПросмотр = Истина;
КонецПроцедуры

&НаКлиенте
Процедура СписокФайловНачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка)
	Элемент.ТолькоПросмотр = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура СписокФайловПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	МассивФайлов=ПараметрыПеретаскивания.Значение;
	Для Каждого ФайлСсылка Из МассивФайлов Цикл 
		Если ФайлСсылка.Пустая() Тогда 
			Продолжить;
		КонецЕсли;
		
		ОписаниеОшибки="";
		Если НЕ ПроверитьИмяОбъектаПоСсылке(ФайлСсылка, ОписаниеОшибки, Строка) Тогда 
			ПараметрыПеретаскивания.Действие=ДействиеПеретаскивания.Отмена;
			Предупреждение(НСтр("ru = ""Недопустимое имя! ""; en_US = ""Impermissble name! """)+ОписаниеОшибки);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СписокФайловВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если ТекущийФайлИлиПапка.Пустая() Или РазыменоватьСервер(ТекущийФайлИлиПапка, "ЭтоГруппа") Тогда 
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь; // отключить стандартную обработку выбора
	
	Если НЕ aps_РаботаСФайлами.aps_ПодключитьРасширениеРаботыСФайлами() Тогда 
		Возврат;
	КонецЕсли;
	
	Если ФайлРедактируетсяМной(ТекущийФайлИлиПапка) Тогда 
		ПолноеИмяФайла = ПолучитьПутьКВыгруженному(ТекущийФайлИлиПапка);
		ФайлНаДиске = Новый Файл(ПолноеИмяФайла);
		Если ФайлНаДиске.Существует() Тогда 
			aps_РаботаСФайлами.aps_ЗапуститьПриложение(ФайлНаДиске.ПолноеИмя);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	ПерсональныеНастройки = aps_РаботаСФайламиСервер.aps_ПерсональныеНастройки();
	Если ПустаяСтрока(ПерсональныеНастройки.РабочийКаталог) Тогда 
		Предупреждение(НСтр("ru = ""Необходимо указать рабочий каталог в персональных настройках!""; en_US = ""Working directory must be specified in personal settings!"""));
		Возврат;
	КонецЕсли;
	
	СисИнфо = Новый СистемнаяИнформация();
	// каталог просмотра файлов свой для каждого пользователя операционной системы данного компьютера
	КаталогСессии = aps_РаботаСФайлами.aps_ДобавитьПоследнийСлэш(ПерсональныеНастройки.РабочийКаталог)+"{"+Строка(СисИнфо.ИдентификаторКлиента)+"}"+"\";
	
	МассивЗависимыхДокументов = Новый Массив();
	// в параметр формы передаем массив файлов этого документа с зависимыми файлами
	МассивФайловКВыгрузке = ПолучитьФайлыДокумента(Истина, МассивЗависимыхДокументов);
	Если МассивФайловКВыгрузке.Количество() > 1 Тогда 
		КодЗакрытия = aps_ПолныеПрава.aps_ПараметрСеанса("aps_РежимВыгрузкиФайлов");
		Если КодЗакрытия = 0 Тогда 
			// показать форму режима выгрузки файлов
			ФормаРежимаВыгрузки = ПолучитьФорму("Обработка.aps_ФайлыДокумента.Форма.ФормаРежимаВыгрузки",, ЭтаФорма);
			КодЗакрытия = ФормаРежимаВыгрузки.ОткрытьМодально();
			Если КодЗакрытия = Неопределено Тогда
				Возврат;
			КонецЕсли;
		КонецЕсли;
		
		Если КодЗакрытия = 1 Тогда // только этот файл
			МассивФайловКВыгрузке.Очистить();
			МассивФайловКВыгрузке.Добавить(ТекущийФайлИлиПапка);
			
		ИначеЕсли КодЗакрытия = 2 Тогда // выбор файлов для просмотра вручную
			ПараметрыФормы = Новый Структура();
			ПараметрыФормы.Вставить("СписокФайлов"		, МассивФайловКВыгрузке);
			ПараметрыФормы.Вставить("Режим"				, 1);
			ПараметрыФормы.Вставить("КаталогВыгрузки"	, КаталогСессии);
			
			ФормаСпискаФайлов = ПолучитьФорму("Обработка.aps_ФайлыДокумента.Форма.ФормаВыгружаемыхФайлов", ПараметрыФормы, ЭтаФорма);
			МассивФайловКВыгрузке = ФормаСпискаФайлов.ОткрытьМодально();
			Если МассивФайловКВыгрузке = Неопределено Тогда
				Возврат;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Попытка
		СоздатьКаталог(КаталогСессии);
	Исключение
		Предупреждение(НСтр("ru = 'Невозможно создать каталог ""'; en_US = 'Cannot create the ""'")+КаталогСессии+НСтр("ru = '"".'; en_US = '"" directory.'")+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	
	// выгрузка в указанный каталог
	ПараметрыВыгрузки = aps_РаботаСФайлами.aps_СформироватьСтруктуруПараметровВыгрузки();
	ПараметрыВыгрузки.ТолькоЧтение		= Истина;
	ПараметрыВыгрузки.РежимПерезаписи	= 2; // перезаписать все
	Если ФормаСпискаФайлов = Неопределено Тогда 
		Если РазыменоватьСервер(МассивФайловКВыгрузке[0], "Зашифрован")
				И Вопрос(НСтр("ru = 'Файл ""'; en_US = 'The ""'")+Строка(МассивФайловКВыгрузке[0])+НСтр("ru = '"" зашифрован. Расшифровать локальную копию файла?'; en_US = '"" file is encrypted. Decrypt the local copy of file?'"), РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Да Тогда 
			ПараметрыВыгрузки.Расшифровать = Истина;
		Иначе 
			ПараметрыВыгрузки.Расшифровать = Ложь;
		КонецЕсли;
	Иначе 
		ПараметрыВыгрузки.Расшифровать = ФормаСпискаФайлов.Расшифровать;
	КонецЕсли;
	
	Если ПараметрыВыгрузки.Расшифровать Тогда 
		МенеджерКриптографии = aps_РаботаСФайлами.aps_ПолучитьМенеджерКриптографии(ПерсональныеНастройки.ПараметрыКриптографии);
		Если МенеджерКриптографии = Неопределено Тогда 
			Возврат;
		КонецЕсли;
		
		ПараметрыВыгрузки.МенеджерКриптографии = МенеджерКриптографии;
	КонецЕсли;
	
	ВыгруженныеФайлы = aps_РаботаСФайлами.aps_ВыгрузкаФайловНаДиск(КаталогСессии, МассивФайловКВыгрузке, ПараметрыВыгрузки);
	Если ВыгруженныеФайлы <> Неопределено Тогда 
		ПолноеИмяФайла = ВыгруженныеФайлы.Получить(ТекущийФайлИлиПапка);
		Если ПолноеИмяФайла <> Неопределено Тогда 
			aps_РаботаСФайлами.aps_ЗапуститьПриложение(ПолноеИмяФайла);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийСпискаДокументов

&НаКлиенте
Процедура СписокДокументовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Объект.item=СписокДокументов.НайтиПоИдентификатору(ВыбраннаяСтрока).Документ;
	ОбновлениеИнформацииВОкне();
	ПереключитьсяНаСтраницу("СтраницаФайлов");
КонецПроцедуры

#КонецОбласти


#Область ПрочиеПроцедурыИФункцииНаКлиенте

&НаКлиенте
Процедура ПереключитьсяНаСтраницу(ИмяСтраницы)
	Для Каждого Страница Из Элементы.ГруппаСтраниц.ПодчиненныеЭлементы Цикл 
		Страница.Видимость = (Страница.Имя = ИмяСтраницы);
	КонецЦикла;
	
	Если Элементы.СтраницаФайлов.Видимость И ФормаИсточник<>Неопределено Тогда 
		Элементы.НазадКСпискуДокументов.Видимость=Истина;
	Иначе
		Элементы.НазадКСпискуДокументов.Видимость=Ложь;
	КонецЕсли;
	
	Если Элементы.СтраницаФайлов.Видимость Тогда 
		Заголовок=НСтр("ru = ""Файлы: ""; en_US = ""Files: """)+Строка(Объект.item);
	ИначеЕсли Элементы.СтраницаДокументов.Видимость Тогда 
		Заголовок=НСтр("ru = ""Документы: ""; en_US = ""Documents: """)+ДеревоРодителя.Представление;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ПолучитьФайлыДокумента(ТолькоЗависимыеФайлы = Ложь, возвМассивЗависимыхДокументов = Неопределено) Экспорт 
	
	Если ДеревоРодителя <> Неопределено Тогда 
		// обход дерева родителя и формирование списка файлов
		ОбщийМассивСтрок = Новый Массив;
		ОбщийМассивСтрок.Добавить(ДеревоРодителя);
		Для Каждого Строка Из ОбщийМассивСтрок Цикл 
			МассивДокументов = НайтиДокументыВПодстроках(Строка);
			Для Каждого ДокументСсылка Из МассивДокументов Цикл 
				Если возвМассивЗависимыхДокументов<>Неопределено И возвМассивЗависимыхДокументов.Найти(ДокументСсылка)=Неопределено И ДокументСсылка<>Объект.item Тогда 
					возвМассивЗависимыхДокументов.Добавить(ДокументСсылка);
				КонецЕсли;
			КонецЦикла;
			
			Подстроки = Строка.ПолучитьЭлементы();
			Для Каждого Подстрока Из Подстроки Цикл 
				Если Подстрока.ЭлементСсылка<>Неопределено Тогда 
					ОбщийМассивСтрок.Добавить(Подстрока);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	Возврат ПолучитьФайлыДокументаСервер(Объект.item, возвМассивЗависимыхДокументов, ТолькоЗависимыеФайлы);
	
КонецФункции

&НаКлиенте
Функция НайтиДокументыВПодстроках(СтрокаДерева)
	МассивДокументов = Новый Массив;	
	Строки = СтрокаДерева.ПолучитьЭлементы();
	Для Каждого Строка Из Строки Цикл 
		Если Строка.ЭлементСсылка <> Неопределено Тогда 
			Если ДоступныеВидыЭлементов.НайтиПоЗначению(Строка.ВидЭлемента) <> Неопределено Тогда 
				МассивДокументов.Добавить(Строка.ЭлементСсылка);
			КонецЕсли;
		Иначе // группировка горизонтальных связей
			Подстроки = Строка.ПолучитьЭлементы();
			Для Каждого Подстрока Из Подстроки Цикл 
				Если ДоступныеВидыЭлементов.НайтиПоЗначению(Подстрока.ВидЭлемента) <> Неопределено Тогда 
					МассивДокументов.Добавить(Подстрока.ЭлементСсылка);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	Возврат МассивДокументов;
КонецФункции

&НаКлиенте
Процедура ОбновитьСписокДокументов()
	МассивДокументов = НайтиДокументыВПодстроках(ДеревоРодителя);
	ОбновитьСписокДокументовСервер(МассивДокументов);
КонецПроцедуры

#КонецОбласти

#КонецЕсли

#Область ОбработчикиСобытийФормыНаСервере

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	МассивДоступныхВидов = Новый Массив;
	МассивДоступныхВидов.Добавить(Справочники.aps_ВидыЭлементов.Документ);
