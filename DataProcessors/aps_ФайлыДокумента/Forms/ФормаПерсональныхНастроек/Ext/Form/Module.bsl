#Если Не МобильноеПриложениеКлиент Тогда
	
#Область ОбработчикиСобытийФормыНаКлиенте	
	
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если НЕ aps_РаботаСФайлами.aps_ПодключитьРасширениеРаботыСКриптографией() Тогда 
		Отказ = Истина; Возврат;
	КонецЕсли;
	
	ПерсональныеНастройки = aps_РаботаСФайламиСервер.aps_ПерсональныеНастройки();
	ПараметрыКриптографии = ПерсональныеНастройки.ПараметрыКриптографии;

	МенеджерКриптографии = aps_РаботаСФайлами.aps_ПолучитьМенеджерКриптографии(ПараметрыКриптографии);
	Если МенеджерКриптографии = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	СписокХранилищ = Новый СписокЗначений;	
	СписокХранилищ.Добавить(ТипХранилищаСертификатовКриптографии.ПерсональныеСертификаты);
	
	ДвДанныеСертификатаЭЦП = ПолучитьИзВременногоХранилища(АдресДвДанныхСертификатаЭЦП);
	Если ДвДанныеСертификатаЭЦП <> Неопределено Тогда 
		СертификатЭЦП = Новый СертификатКриптографии(ДвДанныеСертификатаЭЦП);
		ОтпечатокСертификатаЭЦП = СертификатЭЦП.Отпечаток;
	КонецЕсли;
	
	// список выбора сертификата ЭЦП
	Для Каждого ХранилищеСертификата Из СписокХранилищ Цикл
		СертификатыХранилища = МенеджерКриптографии.ПолучитьХранилищеСертификатов(ХранилищеСертификата.Значение).ПолучитьВсе();
			
		Для Каждого Сертификат Из СертификатыХранилища Цикл
			Если Сертификат.Отпечаток = ОтпечатокСертификатаЭЦП Тогда 
				АдресДвДанныхСертификата = АдресДвДанныхСертификатаЭЦП;
			Иначе 
				АдресДвДанныхСертификата = ПоместитьВоВременноеХранилище(Сертификат.Выгрузить(), ЭтаФорма.УникальныйИдентификатор);
			КонецЕсли;
			
			СтроковоеПредставлениеСертификата = aps_РаботаСФайлами.aps_ПредставлениеСертификата(Сертификат);
			Элементы.СертификатЭЦП.СписокВыбора.Добавить(АдресДвДанныхСертификата, СтроковоеПредставлениеСертификата);
		КонецЦикла;
	КонецЦикла;
	
	ОбновитьОтображениеДанных();
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сохранить(Команда)
	СохранитьПараметрыПользователя();
	Закрыть(Истина);
КонецПроцедуры

&НаКлиенте
Процедура СписокСертификатов(Команда)
	Если НЕ aps_РаботаСФайлами.aps_ПодключитьРасширениеРаботыСФайлами() Тогда 
		Возврат;
	КонецЕсли;
	
	aps_РаботаСФайлами.aps_ЗапуститьПриложение("certmgr.msc");
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьРабочийКаталог(Команда)
	Если НЕ aps_РаботаСФайлами.aps_ПодключитьРасширениеРаботыСФайлами() Тогда 
		Возврат;
	КонецЕсли;
	
	КаталогНаДиске = Новый Файл(РабочийКаталог);
	Если НЕ КаталогНаДиске.Существует() Тогда 
		Предупреждение(НСтр("ru = 'Каталог ""'; en_US = 'The ""'")+РабочийКаталог+НСтр("ru = '"" не обнаружен на данном компьютере!' en_US = '"" directory is not found on this computer!'"));
		Возврат;
	КонецЕсли;

	aps_РаботаСФайлами.aps_ЗапуститьПриложение("explorer "+РабочийКаталог);
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиЭлементовФормы

&НаКлиенте
Процедура РабочийКаталогНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ВыборКаталога=Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	ВыборКаталога.ПолноеИмяФайла=РабочийКаталог;
	Если ВыборКаталога.Выбрать()=Истина Тогда
		РабочийКаталог=ВыборКаталога.Каталог;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#КонецЕсли

#Если НЕ МобильноеПриложениеСервер Тогда

#Область ОбработчикиСобытийФормыНаСервере	

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	РабочийКаталог = ХранилищеОбщихНастроек.Загрузить("РабочийКаталог");
	
	ДвДанныеСертификатаЭЦП = ХранилищеОбщихНастроек.Загрузить("СертификатДляПодписи");
	ПарольКЗакрытомуКлючу = ХранилищеОбщихНастроек.Загрузить("ПарольКЗакрытомуКлючу");
	АдресДвДанныхСертификатаЭЦП = ПоместитьВоВременноеХранилище(ДвДанныеСертификатаЭЦП, ЭтаФорма.УникальныйИдентификатор);
КонецПроцедуры

#КонецОбласти


#Область ПрочиеПроцедурыИФункцииНаСервере

&НаСервере
Процедура СохранитьПараметрыПользователя()
	ХранилищеОбщихНастроек.Сохранить("РабочийКаталог"			,, РабочийКаталог);
	
	ХранилищеОбщихНастроек.Сохранить("СертификатДляПодписи"		,, ПолучитьИзВременногоХранилища(АдресДвДанныхСертификатаЭЦП));
	ХранилищеОбщихНастроек.Сохранить("ПарольКЗакрытомуКлючу"	,, ПарольКЗакрытомуКлючу);
КонецПроцедуры

#КонецОбласти

#КонецЕсли