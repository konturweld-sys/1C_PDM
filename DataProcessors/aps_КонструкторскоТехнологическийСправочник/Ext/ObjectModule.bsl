#Если НЕ МобильноеПриложениеСервер Тогда

#Область ОписаниеПеременных

Перем ФормаОбработки Экспорт; // Основная форма обработки

Перем СсылкаНеклассифицированные Экспорт; // Ссылка справочника "Элементы справочников", виртуальный каталог "Неклассифицированные элементы"

#КонецОбласти


#Область ПрограммныйИнтерфейс

// Процедура обновляет модель данных для данного объекта
// Параметры:
//		parentXDTO - ОбъектXDTO, объект модели XDTO
//		ПравилоУправления - СправочникСсылка.aps_ПравилаУправления, Строка
// Пример:
//		aps_ОбновитьМодельXDTO(itemXDTO, ПравилоУправления);
Процедура aps_ОбновитьМодельXDTO( parentXDTO, Знач ПравилоУправления = Неопределено ) Экспорт 
	
	Если parentXDTO.element = СсылкаНеклассифицированные Тогда	
		
		// запрос элементов, которые применяются в составе и(или) технологии, но которых нет в справочнике
		Запрос = Новый Запрос("ВЫБРАТЬ
		                      |	НеклассифицированныеЭлементы.ЭлементСсылка КАК ЭлементСсылка,
		                      |	НеклассифицированныеЭлементы.ЭлементСсылка.ВидЭлемента КАК ВидЭлемента,
		                      |	НеклассифицированныеЭлементы.ЭлементСсылка.Наименование КАК ПредставлениеЭлемента,
		                      |	ВЫБОР
		                      |		КОГДА НеклассифицированныеЭлементы.ЭлементСсылка.ИндексКартинки = 0
		                      |			ТОГДА НеклассифицированныеЭлементы.ЭлементСсылка.ВидЭлемента.ИндексКартинки
		                      |		ИНАЧЕ НеклассифицированныеЭлементы.ЭлементСсылка.ИндексКартинки
		                      |	КОНЕЦ КАК Картинка
		                      |ИЗ
		                      |	(ВЫБРАТЬ РАЗЛИЧНЫЕ
		                      |		ЭлементныеСвязи.ПотомокСсылка КАК ЭлементСсылка
		                      |	ИЗ
		                      |		Справочник.aps_ЭлементыСвязей КАК ЭлементныеСвязи
		                      |	ГДЕ
		                      |		НЕ ЭлементныеСвязи.ПометкаУдаления
		                      |		И ЭлементныеСвязи.ПотомокСсылка.ВидЭлемента В(&ВидыЭлементов)) КАК НеклассифицированныеЭлементы
		                      |
		                      |УПОРЯДОЧИТЬ ПО
		                      |	НеклассифицированныеЭлементы.ЭлементСсылка.ВидЭлемента.Код,
		                      |	НеклассифицированныеЭлементы.ЭлементСсылка.Наименование,
		                      |	НеклассифицированныеЭлементы.ЭлементСсылка.Дата УБЫВ");
							  
		ВидСвязиРесурсы = Справочники.aps_ШаблоныТехнологическихСвязей.Ресурсы;					  
		Запрос.УстановитьПараметр("ВидыЭлементов"	, ВидСвязиРесурсы.ПодчиненныеВидыЭлементов.ВыгрузитьКолонку(0));
		
		НеклассифицированныеЭлементы = Запрос.Выполнить().Выгрузить();
		
		МассивРодителей = aps_ПолучитьКорневыеПапкиСправочника();
		МассивВидовСвязей = Новый Массив;
		МассивВидовСвязей.Добавить(Перечисления.aps_ВидыСвязей.Справочник);
		МассивВидовСвязей.Добавить(Справочники.aps_ШаблоныТехнологическихСвязей.Ресурсы);
		МассивРезультатовОтбора = Обработки.aps_Применяемость.Создать().aps_ФильтрЭлементовПоПрименяемости(НеклассифицированныеЭлементы.ВыгрузитьКолонку("ЭлементСсылка"), МассивРодителей, МассивВидовСвязей);
		
		Для i=0 По НеклассифицированныеЭлементы.Количество()-1 Цикл 
			Если МассивРезультатовОтбора.Найти(НеклассифицированныеЭлементы[i].ЭлементСсылка) <> Неопределено Тогда 
				Продолжить;
			КонецЕсли;
			
			itemXDTO = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("http://appius.ru/pdm", "item"));
			itemXDTO.element		= СериализаторXDTO.ЗаписатьXDTO(НеклассифицированныеЭлементы[i].ЭлементСсылка);
			itemXDTO.elementType	= НеклассифицированныеЭлементы[i].ВидЭлемента;
			itemXDTO.description	= НеклассифицированныеЭлементы[i].ПредставлениеЭлемента;
			itemXDTO.pictureIndex	= НеклассифицированныеЭлементы[i].Картинка;
			itemXDTO.refLinkGroup	= Ложь;
			
			parentXDTO.items.Добавить(itemXDTO);
		КонецЦикла;
		
	ИначеЕсли ЗначениеЗаполнено( parentXDTO.element ) Тогда
		
		parentXDTOArray=Новый Массив;
		parentXDTOArray.Добавить(parentXDTO);
		Проводник.aps_ОбновитьМодельXDTOРек(parentXDTOArray, ПравилоУправления, 1);
		
	КонецЕсли;
	
КонецПроцедуры

// Процедура рекурсивно обновляет модель данных для массива объектов
// Параметры:
//		parentXDTOArray - массив объектов XDTO-модели
//		ПравилоУправления - СправочникСсылка.aps_ПравилаУправления, Строка
//		КолУровней (необязательный) - Число или Неопределено, число уровней для построения
// Пример:
//		aps_ОбновитьМодельXDTOРек(parentXDTOArray, ПравилоУправления, 1);
Процедура aps_ОбновитьМодельXDTOРек( parentXDTOArray, Знач ПравилоУправления = Неопределено, КолУровней = Неопределено, ВключаяПараметры = Истина ) Экспорт 
	Проводник.aps_ОбновитьМодельXDTOРек(parentXDTOArray, ПравилоУправления, КолУровней, ВключаяПараметры);
КонецПроцедуры

// Процедура обновляет дерево представления по модели данных
// Параметры:
//		parentXDTO - объект модели XDTO
//		СтрокиДереваПредставления - строки дерева представления формы для обновления (необязательный)
//		ПараметрыОтображения - структура параметров отображения дерева (необязательный)
// Пример:
//		aps_ОбновитьДеревоПоМоделиXDTO( itemXDTO, СтрокаДереваПредставления.Строки, СтруктураПараметровОтображения );
Процедура aps_ОбновитьДеревоПоМоделиXDTO( parentXDTO, СтрокиДереваПредставления, ПараметрыОтображения = Неопределено ) Экспорт 
	Проводник.aps_ОбновитьДеревоПоМоделиXDTO(parentXDTO, СтрокиДереваПредставления, ПараметрыОтображения);
КонецПроцедуры

// Процедура обновляет дерево представления по модели данных целиком
// Параметры:
//		parentXDTO - объект модели XDTO
//		СтрокиДереваПредставления - строки дерева представления формы для обновления (необязательный)
// Пример:
//		aps_ОбновитьДеревоПоМоделиXDTOРек( itemXDTO, СтрокаДереваПредставления.Строки, СтруктураПараметровОтображения );
Процедура aps_ОбновитьДеревоПоМоделиXDTOРек( parentXDTO, СтрокиДереваПредставления, ПараметрыОтображения = Неопределено ) Экспорт 
	Проводник.aps_ОбновитьДеревоПоМоделиXDTOРек(parentXDTO, СтрокиДереваПредставления, ПараметрыОтображения);
КонецПроцедуры

// Функция создает новый элемент определенного вида
// Параметры:
//		parentItem - СправочникСсылка.aps_ЭлементыИзделия, aps_ЭлементыТехнологии, aps_ЭлементыСправочников
//		ВидСоздаваемого  - СправочникСсылка.aps_ВидыЭлементов
//		ШаблонДляСоздания - ссылка на элемент, на основании которого нужно создать новый элемент
// Возвращаемое значение:
//		Массив ссылок на созданные элементы
// Пример:
//		СозданныеЭлементы = aps_ИнтерактивноеСозданиеЭлемента(parentItem, ВидСоздаваемого, ШаблонДляСоздания);
Функция aps_ИнтерактивноеСозданиеЭлемента( parentItem, ВидСоздаваемого, ШаблонДляСоздания=Неопределено ) Экспорт 
	СозданныеЭлементы = Новый Массив();
	
	Если ВидСоздаваемого = Справочники.aps_ВидыЭлементов.ПапкаСправочника Тогда 
		// Создать папку
		НаименованиеПапки = МодульСозданияОбъектов.ПолучитьФорму("ФормаСозданияПапки").ОткрытьМодально();
		Если НЕ ПустаяСтрока(НаименованиеПапки) Тогда
			Попытка
				НачатьТранзакцию();
				    ДеревоСвойствПапки = Новый ДеревоЗначений;
					МодульСозданияОбъектов.aps_ОбновитьДеревоСвойств( ВидСоздаваемого, ДеревоСвойствПапки );
					
					СтрокаСвойства = ДеревоСвойствПапки.Строки.Найти(ПланыВидовХарактеристик.aps_Свойства.Наименование, "Свойство", Истина);
					Если СтрокаСвойства <> Неопределено Тогда 
						СтрокаСвойства.Значение = НаименованиеПапки;
					Иначе // Добавить свойство "Наименование" в дерево в случае отсутствия
						МодульСозданияОбъектов.aps_НеинтерактивноеДобавлениеСвойстваВДерево(ПланыВидовХарактеристик.aps_Свойства.Наименование, НаименованиеПапки,,, ДеревоСвойствПапки);
					КонецЕсли;
					
					СозданныйОбъект = МодульСозданияОбъектов.aps_СозданиеОбъектаPDM( Справочники.aps_ВидыЭлементов.ПапкаСправочника,
																									   ДеревоСвойствПапки );
																									
				ЗафиксироватьТранзакцию();
				
				СозданныеЭлементы.Добавить(СозданныйОбъект.Ссылка);
			Исключение
				ОтменитьТранзакцию();
				Сообщить(ПараметрыСеанса.aps_ИмяПродукта+НСтр("ru = ""Не удалось создать папку:""; en_US = ""Cannot create folder:""")+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), СтатусСообщения.Внимание);
			КонецПопытки;
		КонецЕсли;
		
	ИначеЕсли ВидСоздаваемого = Справочники.aps_ВидыЭлементов.Ресурс Тогда 
		// Создать новый ресурс
		ФормаСозданияРесурса = МодульСозданияОбъектов.ПолучитьФорму("ФормаСозданияРесурса");
		Если ФормаСозданияРесурса.ОткрытьМодально() = Истина Тогда 
			Попытка
				НачатьТранзакцию();
					ВидРесурса				= ФормаСозданияРесурса.ВидРесурса;
					ПредставлениеРесурса	= ФормаСозданияРесурса.ПредставлениеРесурса;
					ДеревоСвойствРесурса	= ФормаСозданияРесурса.ДеревоСвойств;
					
					СозданныйОбъект = МодульСозданияОбъектов.aps_СозданиеОбъектаPDM( Справочники.aps_ВидыЭлементов.Ресурс,
																											ДеревоСвойствРесурса );
					// Набор параметров элементов ресурса
					СозданныйОбъект.ПараметрыЭлементовРесурса.Загрузить(СозданныйОбъект.Параметры.Выгрузить());
					Для Каждого СтрокаПараметра Из СозданныйОбъект.ПараметрыЭлементовРесурса Цикл
						СтрокаПараметра.Общедоступный = ДеревоСвойствРесурса.Строки.НайтиСтроки(Новый Структура("Имя, Свойство, Общедоступный", СтрокаПараметра.Параметр.Наименование, СтрокаПараметра.Параметр.Свойство, Истина), Истина).Количество() > 0;
					КонецЦикла;

					// Создать представление элементов ресурса по виду
					Для Каждого СтрокаПредставления Из ВидРесурса.ПредставлениеЭлемента Цикл
						Если ТипЗнч(СтрокаПредставления.Свойство) = Тип("Строка") Тогда 
							СозданныйОбъект.ПредставлениеЭлементовРесурса.Добавить().Параметр = СтрокаПредставления.Свойство;
						Иначе 
							ПараметрСсылка = МодульСозданияПараметров.aps_ВспомНайтиПараметрПоСвойству(СозданныйОбъект, СтрокаПредставления.Свойство);
							Если НЕ ПараметрСсылка.Пустая() Тогда 
								СозданныйОбъект.ПредставлениеЭлементовРесурса.Добавить().Параметр = ПараметрСсылка;
							КонецЕсли;
						КонецЕсли;
					КонецЦикла;

					// Параметры самого ресурса
					ДеревоСвойствРесурса = Новый ДеревоЗначений;
					МодульСозданияОбъектов.aps_ОбновитьДеревоСвойств(Справочники.aps_ВидыЭлементов.Ресурс, ДеревоСвойствРесурса);
					СтрокаСвойства = ДеревоСвойствРесурса.Строки.Найти(ПланыВидовХарактеристик.aps_Свойства.ВидРесурса, "Свойство", Истина);
					Если СтрокаСвойства <> Неопределено Тогда 
						СтрокаСвойства.Значение = ВидРесурса;
					Иначе // Добавить свойство "Вид ресурса" в дерево в случае отсутствия
						МодульСозданияОбъектов.aps_НеинтерактивноеДобавлениеСвойстваВДерево(ПланыВидовХарактеристик.aps_Свойства.ВидРесурса, ВидРесурса,,, ДеревоСвойствРесурса);
					КонецЕсли;
					
					СозданныйОбъект.Параметры.Очистить();
					МодульСозданияОбъектов.aps_СозданиеПараметровПоДереву(ДеревоСвойствРесурса.Строки, СозданныйОбъект);
					
					// Создать представление ресурса
					СозданныйОбъект.ПредставлениеЭлемента.Очистить();
					СозданныйОбъект.ПредставлениеЭлемента.Добавить().Параметр = ПредставлениеРесурса;
					
					СозданныйОбъект.Записать();
				ЗафиксироватьТранзакцию();
				
				СозданныеЭлементы.Добавить(СозданныйОбъект.Ссылка);
			Исключение
				ОтменитьТранзакцию();
				Сообщить(ПараметрыСеанса.aps_ИмяПродукта+НСтр("ru = ""Не удалось создать ресурс:""; en_US = ""Cannot create resource:""")+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), СтатусСообщения.Внимание);
			КонецПопытки;
		КонецЕсли;
		
	ИначеЕсли ШаблонДляСоздания <> Неопределено Тогда //создать элемент на основании существующего
		МодульСозданияОбъектов.ВидыДляСоздания.Очистить();
		МодульСозданияОбъектов.ВидыДляСоздания.Добавить().ВидДляСоздания = ВидСоздаваемого;
		ФормаСозданияЭлемента = МодульСозданияОбъектов.ПолучитьФорму("ФормаСозданияИРазмещения");
		ФормаСозданияЭлемента.ШаблонДляСоздания = ШаблонДляСоздания;
		ФормаСозданияЭлемента.ОткрытьМодально();
		СозданныеЭлементы = МодульСозданияОбъектов.СозданныеЭлементы.ВыгрузитьКолонку(0);
		
	Иначе 
		// Создать элемент ресурса
		Попытка
			НачатьТранзакцию();
			
				СозданныйОбъект = МодульСозданияОбъектов.aps_СозданиеОбъектаPDM(ВидСоздаваемого, Новый ДеревоЗначений);
				// заполнение параметров элемента по параметрам ресурса
				aps_СоздатьНаборПараметровЭлементаРесурса(СозданныйОбъект, parentItem);
				
				Если parentItem.ПредставлениеЭлементовРесурса.Количество() > 0 Тогда 
					// использовать представление ресурса
					aps_СоздатьПредставлениеЭлементаРесурса(СозданныйОбъект, parentItem);
				Иначе 
					// использовать представление вида элемента
					МодульСозданияОбъектов.aps_СоздатьПредставление(СозданныйОбъект);
				КонецЕсли;
				
				СозданныйОбъект.ДополнительныеСвойства.Вставить("ПроверитьУникальность", Ложь);
				СозданныйОбъект.Записать();
			ЗафиксироватьТранзакцию();
			
			СозданныеЭлементы.Добавить(СозданныйОбъект.Ссылка);
		Исключение
			ОтменитьТранзакцию();
			//СуществующийЭлемент=Неопределено;
			//Если СозданныйОбъект.ДополнительныеСвойства.Свойство("СуществующийЭлемент", СуществующийЭлемент) Тогда 
			//	СозданныеЭлементы.Добавить(СуществующийЭлемент);
			//Иначе 
				Сообщить(ПараметрыСеанса.aps_ИмяПродукта+НСтр("ru = ""Не удалось создать элемент ресурса:""; en_US = ""Cannot create resource item:""")+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), СтатусСообщения.Внимание);
			//КонецЕсли;
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат СозданныеЭлементы;
КонецФункции

// Функция создает новую элементную связь данного вида
// Параметры:
//		item			 - СправочникСсылка.aps_ЭлементыИзделия, aps_ЭлементыТехнологии, aps_ЭлементыСправочников
//		parentItem		 - СправочникСсылка.aps_ЭлементыИзделия, aps_ЭлементыТехнологии, aps_ЭлементыСправочников
//		ВидСвязи		 - СправочникСсылка.aps_ШаблоныТехнологическихСвязей, ПеречислениеСсылка.aps_ВидыСвязей
//		МодельИсточник 	 - ОбъектXDTO, источник данных для заполнения параметров связи
// Возвращаемое значение:
//		СправочникСсылка.aps_ВертикальныеСвязи,
//		СправочникСсылка.aps_ЭлементыСвязей,
//		Неопределено (элемент был добавлен в ресурс), 
//		Ложь (элемент не был добавлен)
// Пример:
//		СозданнаяСвязь=aps_ИнтерактивноеДобавлениеЭлемента(МассивПеретаскивания[i].element, parentItem, ВыбШаблонСвязи, МассивПеретаскивания[i]);
Функция aps_ИнтерактивноеДобавлениеЭлемента( item, parentItem, ВидСвязи, МодельИсточник = Неопределено ) Экспорт 
	
	Если ВидСвязи = Перечисления.aps_ВидыСвязей.Справочник Тогда 
		
		Попытка	
			СозданнаяСвязь = МодульСозданияОбъектов.aps_СозданиеВертикальнойСвязи( parentItem, item, ВидСвязи );
			Возврат СозданнаяСвязь.Ссылка;
		Исключение
			Сообщить(ПараметрыСеанса.aps_ИмяПродукта+НСтр("ru = ""Не удалось заимствовать <""; en_US = ""Cannot adopt the <""")+item.Наименование+">:"+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), СтатусСообщения.Внимание);
		КонецПопытки;
		
	ИначеЕсли ВидСвязи = Справочники.aps_ШаблоныТехнологическихСвязей.Ресурсы Тогда 
				
		Попытка
			ОбъектРесурса = parentItem.ПолучитьОбъект();
			НовоеПодчинение = ОбъектРесурса.ЭлементыРесурса.Добавить();
			НовоеПодчинение.ЭлементСсылка = item;
			НовоеПодчинение.ВидСвязи	  = ВидСвязи;
			ОбъектРесурса.Записать();
			Возврат Неопределено;
		Исключение
			Сообщить(ПараметрыСеанса.aps_ИмяПродукта+НСтр("ru = ""Не удалось заимствовать <""; en_US = ""Cannot adopt the <""")+item.Наименование+">:"+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), СтатусСообщения.Внимание);
		КонецПопытки;
		
	ИначеЕсли ТипЗнч(ВидСвязи)=Тип("СправочникСсылка.aps_ШаблоныТехнологическихСвязей") И ВидСвязи.ГоризонтальнаяСвязь Тогда 
		
		Попытка
			НачатьТранзакцию();
				ДеревоСвойствСвязи = Новый ДеревоЗначений;
				МодульСозданияОбъектов.aps_ОбновитьДеревоСвойств(Справочники.aps_ВидыЭлементов.СвязьТехнологии, ДеревоСвойствСвязи, ВидСвязи);
				
				Если МодельИсточник <> Неопределено Тогда // заполнение дерева свойств связи по параметрам связи источника
					МассивПараметровXDTO=aps_СформироватьМассивПараметровИзМоделиXDTO(МодельИсточник);
					Для Каждого parameterXDTO Из МассивПараметровXDTO Цикл 
						Если parameterXDTO.linkParameter=Истина И parameterXDTO.property<>Неопределено Тогда 
							СтрокаСвойства = ДеревоСвойствСвязи.Строки.Найти(parameterXDTO.property, "Свойство", Истина);
							Если СтрокаСвойства <> Неопределено Тогда 
								СтрокаСвойства.Значение			= ?(ЗначениеЗаполнено(parameterXDTO.value), parameterXDTO.value, СтрокаСвойства.Значение);
								СтрокаСвойства.ЕдиницаИзмерения	= ?(ЗначениеЗаполнено(parameterXDTO.unit), parameterXDTO.unit, СтрокаСвойства.ЕдиницаИзмерения);
							КонецЕсли;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
				
				СозданнаяСвязь=МодульСозданияОбъектов.aps_СозданиеЭлементнойСвязи( Справочники.aps_ВидыЭлементов.СвязьТехнологии, parentItem, item, ВидСвязи, ДеревоСвойствСвязи );
				
			ЗафиксироватьТранзакцию();
			Возврат СозданнаяСвязь.Ссылка;
		Исключение
			ОтменитьТранзакцию();
			Сообщить(ПараметрыСеанса.aps_ИмяПродукта+НСтр("ru = ""Не удалось заимствовать элемент по связи <""; en_US = ""Cannot adopt item by the <""")+Строка(ВидСвязи)+НСтр("ru = "">:""; en_US = ""> link:""")+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), СтатусСообщения.Внимание);
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат Ложь;
КонецФункции

// Процедура создает представление элемента по параметрам ресурса
// Параметры:
//		itemObject - СправочникОбъект.aps_ЭлементыСправочников
//		itemResource - СправочникСсылка.aps_ЭлементыСправочников
// Пример:
//		aps_СоздатьПредставлениеЭлементаРесурса(СозданныйОбъект, parentXDTO.element);
Процедура aps_СоздатьПредставлениеЭлементаРесурса(
    itemObject,
    itemResource) Экспорт

    itemObject.ПредставлениеЭлемента.Очистить();

    Для Каждого СтрокаПредставления
        Из itemResource.ПредставлениеЭлементовРесурса Цикл

        Если ТипЗнч(СтрокаПредставления.Параметр) = Тип("Строка") Тогда

            itemObject.ПредставлениеЭлемента.Добавить().Параметр =
                СтрокаПредставления.Параметр;

        ИначеЕсли
            ТипЗнч(СтрокаПредставления.Параметр) =
                Тип("СправочникСсылка.aps_ПараметрыЭлементовИзделия")
            Или
            ТипЗнч(СтрокаПредставления.Параметр) =
                Тип("СправочникСсылка.aps_ПараметрыЭлементовТехнологии") Тогда

            ПараметрЭлементаРесурса =
                МодульСозданияПараметров
                    .aps_ВспомНайтиПараметрПоСвойствуИИмени(
                        itemObject,
                        СтрокаПредставления.Параметр.Свойство,
                        СтрокаПредставления.Параметр.Наименование);

            Если НЕ ПараметрЭлементаРесурса.Пустая() Тогда

                itemObject.ПредставлениеЭлемента.Добавить().Параметр =
                    ПараметрЭлементаРесурса;

            КонецЕсли;

        КонецЕсли;

    КонецЦикла;

КонецПроцедуры

// Процедура создает набор параметров элемента по параметрам ресурса
// Параметры:
//		itemObject - СправочникОбъект.aps_ЭлементыСправочников
//		itemResource - СправочникСсылка.aps_ЭлементыСправочников
// Пример:
//		aps_СоздатьНаборПараметровЭлементаРесурса(СозданныйОбъект, parentXDTO.element);
Процедура aps_СоздатьНаборПараметровЭлементаРесурса( itemObject, itemResource ) Экспорт 
	СписокПараметров=Новый Массив();
	
	СоответствиеГруппПараметров=Новый Соответствие();
	Для Каждого СтрокаПараметраРесурса Из itemResource.ПараметрыЭлементовРесурса Цикл 
		ПараметрРесурса = СтрокаПараметраРесурса.Параметр;
		
		Если СтрокаПараметраРесурса.Общедоступный Тогда 
			// наследовать параметр ресурса
			СуществующийПараметр=МодульСозданияПараметров.aps_СозданиеПараметра(itemObject, ПараметрРесурса.Наименование, ПараметрРесурса.Свойство,,,,, ПараметрРесурса);
			
		Иначе
			СуществующийПараметр = МодульСозданияПараметров.aps_ВспомНайтиПараметрПоСвойствуИИмени(itemObject, ПараметрРесурса.Свойство, ПараметрРесурса.Наименование);
			Если СуществующийПараметр.Пустая() ИЛИ СуществующийПараметр=ПараметрРесурса Тогда 
				ГруппаПараметров = СоответствиеГруппПараметров.Получить(ПараметрРесурса.Родитель);
				Если ГруппаПараметров=Неопределено И ЗначениеЗаполнено(ПараметрРесурса.Родитель) Тогда 
					ГруппаПараметров = Неопределено;
					// найти аналогичную группу в параметрах элемента по имени
					Для Каждого СтрокаПараметра Из itemObject.Параметры Цикл 
						ПараметрЭлемента = СтрокаПараметра.Параметр;
						Если ЗначениеЗаполнено(ПараметрЭлемента.Родитель) И ПараметрЭлемента.Родитель.Наименование=ПараметрРесурса.Родитель.Наименование Тогда 
							ГруппаПараметров = ПараметрЭлемента.Родитель;
							Прервать;
						КонецЕсли;
					КонецЦикла;
					Если ГруппаПараметров = Неопределено Тогда // если не найдена, создать
						ГруппаПараметров = МодульСозданияПараметров.aps_СозданиеПараметра(itemObject, ПараметрРесурса.Родитель.Наименование,,, Истина);
					КонецЕсли;
					
					СоответствиеГруппПараметров.Вставить(ПараметрРесурса.Родитель, ГруппаПараметров);
				КонецЕсли;					
				
				// создать новый параметр
				СуществующийПараметр=МодульСозданияПараметров.aps_СозданиеПараметра(itemObject, ПараметрРесурса.Наименование, ПараметрРесурса.Свойство, ПараметрРесурса.Значение,, ГруппаПараметров);
			КонецЕсли;
		КонецЕсли;
		
		СписокПараметров.Добавить(СуществующийПараметр);
	КонецЦикла;
		
	i=0;
	Пока i < itemObject.Параметры.Количество() Цикл 
		Если СписокПараметров.Найти(itemObject.Параметры[i].Параметр)=Неопределено Тогда 
			itemObject.Параметры.Удалить(i);
		Иначе 
			i=i+1;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Процедура создает копию ресурса
// Параметры:
//		itemResourceSample - СправочникСсылка.aps_ЭлементыСправочников, ресурс-образец
// Пример:
//		НовыйРесурс = aps_СкопироватьРесурс(itemXDTOSample.element);
Функция aps_СкопироватьРесурс( itemResourceSample ) Экспорт 
	Попытка
		НачатьТранзакцию();
			ВидСоздаваемого = Справочники.aps_ВидыЭлементов.Ресурс;
			itemObject = МодульСозданияОбъектов.aps_СозданиеОбъектаPDM(ВидСоздаваемого, Новый ДеревоЗначений);
			
			СоответствиеГруппПараметров=Новый Соответствие(); СоответствиеПараметров=Новый Соответствие();
			// скопировать набор параметров самого ресурса
			itemObject.Параметры.Очистить();
			Для Каждого СтрокаПараметраРесурса Из itemResourceSample.Параметры Цикл 
				ПараметрРесурса = СтрокаПараметраРесурса.Параметр;
				
				ГруппаПараметров = СоответствиеГруппПараметров.Получить(ПараметрРесурса.Родитель);
				Если ГруппаПараметров=Неопределено И ЗначениеЗаполнено(ПараметрРесурса.Родитель) Тогда 
					ГруппаПараметров = МодульСозданияПараметров.aps_СозданиеПараметра(itemObject, ПараметрРесурса.Родитель.Наименование,,, Истина);
					СоответствиеГруппПараметров.Вставить(ПараметрРесурса.Родитель, ГруппаПараметров);
				КонецЕсли;					
				// создать новый параметр
				ПараметрНовогоРесурса=МодульСозданияПараметров.aps_СозданиеПараметра(itemObject, ПараметрРесурса.Наименование, ПараметрРесурса.Свойство, ПараметрРесурса.Значение,, ГруппаПараметров);
				СоответствиеПараметров.Вставить(ПараметрРесурса, ПараметрНовогоРесурса);
			КонецЦикла;
			
			// скопировать представление самого ресурса
			itemObject.ПредставлениеЭлемента.Очистить();
			Для Каждого СтрокаПредставленияРесурса Из itemResourceSample.ПредставлениеЭлемента Цикл
				Если ТипЗнч(СтрокаПредставленияРесурса.Параметр) = Тип("Строка") Тогда 
					itemObject.ПредставлениеЭлемента.Добавить().Параметр = СтрокаПредставленияРесурса.Параметр;
				ИначеЕсли ТипЗнч(СтрокаПредставленияРесурса.Параметр) = Тип("СправочникСсылка.aps_ПараметрыЭлементовИзделия")
							Или ТипЗнч(СтрокаПредставленияРесурса.Параметр) = Тип("СправочникСсылка.aps_ПараметрыЭлементовТехнологии") Тогда 
					ПараметрНовогоРесурса = СоответствиеПараметров.Получить(СтрокаПредставленияРесурса.Параметр);
					Если ПараметрНовогоРесурса <> Неопределено Тогда
						itemObject.ПредставлениеЭлемента.Добавить().Параметр = ПараметрНовогоРесурса;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
				
			СоответствиеГруппПараметров=Новый Соответствие(); СоответствиеПараметров=Новый Соответствие();
			// скопировать набор параметров элементов, входящих в ресурс
			itemObject.ПараметрыЭлементовРесурса.Очистить();
			Для Каждого СтрокаПараметраРесурса Из itemResourceSample.ПараметрыЭлементовРесурса Цикл 
				ПараметрРесурса = СтрокаПараметраРесурса.Параметр;
				
				ГруппаПараметров = СоответствиеГруппПараметров.Получить(ПараметрРесурса.Родитель);
				Если ГруппаПараметров=Неопределено И ЗначениеЗаполнено(ПараметрРесурса.Родитель) Тогда 
					ГруппаПараметров = МодульСозданияПараметров.aps_СозданиеПараметра(itemObject, ПараметрРесурса.Родитель.Наименование,,, Истина);
					СоответствиеГруппПараметров.Вставить(ПараметрРесурса.Родитель, ГруппаПараметров);
				КонецЕсли;					
					
				// создать новый параметр
				ПараметрНовогоРесурса=МодульСозданияПараметров.aps_СозданиеПараметра(itemObject, ПараметрРесурса.Наименование, ПараметрРесурса.Свойство, ПараметрРесурса.Значение,, ГруппаПараметров);
				itemObject.Параметры.Удалить(itemObject.Параметры.Количество()-1);
				
				СтрокаПараметраНовогоРесурса = itemObject.ПараметрыЭлементовРесурса.Добавить();
				СтрокаПараметраНовогоРесурса.Параметр		= ПараметрНовогоРесурса;
				СтрокаПараметраНовогоРесурса.Общедоступный	= СтрокаПараметраРесурса.Общедоступный;
				
				СоответствиеПараметров.Вставить(ПараметрРесурса, ПараметрНовогоРесурса);
			КонецЦикла;
			
			// скопировать представление элементов, входящих в ресурс
			itemObject.ПредставлениеЭлементовРесурса.Очистить();
			Для Каждого СтрокаПредставленияРесурса Из itemResourceSample.ПредставлениеЭлементовРесурса Цикл
				Если ТипЗнч(СтрокаПредставленияРесурса.Параметр) = Тип("Строка") Тогда 
					itemObject.ПредставлениеЭлементовРесурса.Добавить().Параметр = СтрокаПредставленияРесурса.Параметр;
				ИначеЕсли ТипЗнч(СтрокаПредставленияРесурса.Параметр) = Тип("СправочникСсылка.aps_ПараметрыЭлементовИзделия")
							Или ТипЗнч(СтрокаПредставленияРесурса.Параметр) = Тип("СправочникСсылка.aps_ПараметрыЭлементовТехнологии") Тогда 
					ПараметрНовогоРесурса = СоответствиеПараметров.Получить(СтрокаПредставленияРесурса.Параметр);
					Если ПараметрНовогоРесурса <> Неопределено Тогда
						itemObject.ПредставлениеЭлементовРесурса.Добавить().Параметр = ПараметрНовогоРесурса;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			
			itemObject.ДополнительныеСвойства.Вставить("ПроверитьУникальность", Ложь);
			itemObject.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Сообщить(ПараметрыСеанса.aps_ИмяПродукта+НСтр("ru = ""Не удалось создать ресурс:""; en_US = ""Cannot create resource:""")+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), СтатусСообщения.Внимание);
	КонецПопытки;
	
	Возврат itemObject.Ссылка;
КонецФункции

// Процедура импортирует данные из внешнего источника в режиме рабочей копии
// Параметры:
//		parentXDTO - объект модели XDTO
//		ТаблицаИмпорта - ТаблицаЗначений, таблица данных импорта
// Пример:
//		aps_ИмпортДанныхВКТС(parentXDTO, Параметр, СоответствиеКолонокРесурсов[parentItem]);
Процедура aps_ИмпортДанныхВКТС( parentXDTO, ТаблицаИмпорта, ТаблицаКолонокРесурса ) Экспорт 
	Если ТаблицаКолонокРесурса=Неопределено Тогда 
		Возврат;
	КонецЕсли;
	ТаблицаКолонок=ТаблицаКолонокРесурса.Скопировать(новый Структура("Видимость",Истина));
	Если ТаблицаКолонок.Количество()=0 Тогда 
		Возврат;
	КонецЕсли;	
	МассивРодителей=Новый Массив();
	МассивРодителей.Добавить( parentXDTO );
	itemXDTO=Неопределено;
	ТекущийУровень=1;
	ВидЭлементовРесурса=МодульСозданияПараметров.aps_ПолучитьЗначениеПараметраПоСвойствуВXDTO(parentXDTO,ПланыВидовХарактеристик.aps_Свойства.ВидРесурса,Ложь );
	Для i=0 По ТаблицаИмпорта.Количество()-1 Цикл 
		СтрокаИмпорта=ТаблицаИмпорта[i];
		ВидЭлементаИмпорта = СтрокаИмпорта.ВидЭлемента;
		Если ВидЭлементовРесурса<>ВидЭлементаИмпорта Тогда
			Продолжить;
		КонецЕсли;		
		Если ТипЗнч(ВидЭлементаИмпорта)<>Тип("СправочникСсылка.aps_ВидыЭлементов") Тогда 
			itemXDTO = aps_СоздатьОбъектМоделиXDTO(ВидЭлементаИмпорта);
		Иначе
			
			Попытка
				НачатьТранзакцию();
				СозданныйОбъект = МодульСозданияОбъектов.aps_СозданиеОбъектаPDM(ВидЭлементаИмпорта, Новый ДеревоЗначений);
				// заполнение параметров элемента по параметрам ресурса
				aps_СоздатьНаборПараметровЭлементаРесурса(СозданныйОбъект, parentXDTO.element);
				Если parentXDTO.element.ПредставлениеЭлементовРесурса.Количество() > 0 Тогда 
					// использовать представление ресурса
					aps_СоздатьПредставлениеЭлементаРесурса(СозданныйОбъект, parentXDTO.element);
				Иначе 
					// использовать представление вида элемента
					МодульСозданияОбъектов.aps_СоздатьПредставление(СозданныйОбъект);
				КонецЕсли;
				
				/////////////////////////////////////////////////////
				// заполнение значений параметров по таблице (для элемента)
				Для Каждого СтрокаПараметра Из СозданныйОбъект.Параметры Цикл 
					КолонкаРесурса = ТаблицаКолонок.Найти(СтрокаПараметра.Параметр.Свойство);
					Если КолонкаРесурса <> Неопределено Тогда 
						ИндексКолонки = ТаблицаКолонок.Индекс(КолонкаРесурса);
						Если ИндексКолонки < ТаблицаИмпорта.Колонки.Количество()-2 Тогда 
							ТипЗначенияСвойства = СтрокаПараметра.Параметр.Свойство.ТипЗначения;
							ЗначениеПараметра = aps_ПреобразоватьЗначениеПараметра(СтрокаИмпорта[ИндексКолонки+2], ТипЗначенияСвойства);
							ОбъектПараметра = СтрокаПараметра.Параметр.ПолучитьОбъект();
							ОбъектПараметра.Значение = ЗначениеПараметра;
							ОбъектПараметра.Записать();
						КонецЕсли;
					КонецЕсли; // Если КолонкаРесурса <> Неопределено Тогда 
				КонецЦикла;
				
				СозданныйОбъект.ДополнительныеСвойства.Вставить("ПроверитьУникальность", Ложь);
				СозданныйОбъект.Записать();
				itemXDTO = aps_СоздатьОбъектМоделиXDTO(СозданныйОбъект.Ссылка);
				itemXDTO.created = Истина;
				aps_ЗаполнитьПредставлениеМоделиПоТабЧасти(itemXDTO, СозданныйОбъект.ПредставлениеЭлемента);
				ОтменитьТранзакцию(); // отмена транзации после создания xdto-модели
			Исключение
				ОтменитьТранзакцию();
				Сообщить(ПараметрыСеанса.aps_ИмяПродукта+НСтр("ru = ""Не удалось импортировать элемент:""; en_US = ""Cannot import the item:""")+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), СтатусСообщения.Внимание);
				Продолжить;
			КонецПопытки;						
		КонецЕсли;
	
					
		itemXDTO.linkType = СериализаторXDTO.ЗаписатьXDTO(Справочники.aps_ШаблоныТехнологическихСвязей.Ресурсы);
		
		itemXDTO.added	  =Истина;
		itemXDTO.modified =Истина;
		
		aps_ОбновитьПредставлениеВМоделиXDTO(itemXDTO);
		
		
		currentParentXDTO=МассивРодителей[МассивРодителей.Количество()-1];
		
		ПозДляВставки=Неопределено; // определить позицию для вставки объекта
		aps_НайтиВМассивеXDTO(currentParentXDTO.items, Новый Структура("refLinkGroup", Истина), ПозДляВставки);
		
		Если ПозДляВставки <> Неопределено Тогда 
			currentParentXDTO.items.Вставить(ПозДляВставки, itemXDTO);
			ПозДляВставки = ПозДляВставки + 1;
		Иначе 
			currentParentXDTO.items.Добавить(itemXDTO);
		КонецЕсли;
		
		currentParentXDTO.modified=Истина;
	КонецЦикла; // Для i=0 По ТаблицаИмпорта.Количество()-1 Цикл
КонецПроцедуры

#КонецОбласти


