
#Область ПрограммныйИнтерфейс

// Функция возвращает штрихкод документа
// Параметры:
//		item - ссылка на документ
// Возвращаемое значение:
//		Число, штрихкод
// Пример:
//		Штрихкод = aps_ПолучитьШтрихкод(item);
//
Функция aps_ПолучитьШтрихкод(item) Экспорт
	
	ЗапросСущШтрихкода = Новый Запрос("ВЫБРАТЬ
		                               |	aps_ШтрихкодыДокументов.Штрихкод КАК Штрихкод,
		                               |	aps_ШтрихкодыДокументов.ЭлементСсылка
		                               |ИЗ
		                               |	РегистрСведений.aps_ШтрихкодыДокументов КАК aps_ШтрихкодыДокументов
		                               |ГДЕ
		                               |	aps_ШтрихкодыДокументов.ЭлементСсылка = &ЭлементСсылка
		                               |	И aps_ШтрихкодыДокументов.Штрихкод <> 0");
	ЗапросСущШтрихкода.УстановитьПараметр("ЭлементСсылка", item);
	Результат = ЗапросСущШтрихкода.Выполнить().Выгрузить();
	Если Результат.Количество() > 0 Тогда
		Возврат Результат[0].Штрихкод;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
КонецФункции

// Функция возвращает ссылку на документ по штрихкоду
// Параметры:
//		Штрихкод - Число
// Возвращаемое значение:
//		ссылка на документ
// Пример:
//		Документ = РаботаСоШтрихкодами.aps_ПолучитьДокументПоШтрихкоду(Штрихкод);
//
Функция aps_ПолучитьДокументПоШтрихкоду(Штрихкод) Экспорт
	ЗапросСущШтрихкода = Новый Запрос("ВЫБРАТЬ
	                                  |	aps_ШтрихкодыДокументов.Штрихкод КАК Штрихкод,
	                                  |	aps_ШтрихкодыДокументов.ЭлементСсылка
	                                  |ИЗ
	                                  |	РегистрСведений.aps_ШтрихкодыДокументов КАК aps_ШтрихкодыДокументов
	                                  |ГДЕ
	                                  |	aps_ШтрихкодыДокументов.Штрихкод = &Штрихкод");
	ЗапросСущШтрихкода.УстановитьПараметр("Штрихкод", Штрихкод);
	Результат = ЗапросСущШтрихкода.Выполнить().Выгрузить();
	Если Результат.Количество() > 0 Тогда
		Возврат Результат[0].ЭлементСсылка;
	Иначе
		Сообщить(ПараметрыСеанса.aps_ИмяПродукта+НСтр("ru = 'Штрихкод '; en_US = 'Bar code '")+Штрихкод+НСтр("ru = '. Документ не найден!'; en_US = '. Document not found!'"));
		Возврат Неопределено;
	КонецЕсли;
КонецФункции


#Если Клиент Тогда

// Процедура открывает макет штрихкода для печати
// Параметры:
//		item - ссылка на документ
//
Процедура aps_НапечататьШтрихкод(item) Экспорт
	Штрихкод = aps_ПолучитьШтрихкод(item);
	
	Если Штрихкод <> Неопределено Тогда
		Макет = ПолучитьМакет("Макет");
		
		Макет.Рисунки.Штрихкод.Объект.Сообщение = Штрихкод;
		Макет.ПолучитьОбласть("ПолеНадписи").Параметры.Изделие = item.Наименование;
		
		Макет.Показать();
	КонецЕсли;
КонецПроцедуры

//-------------------------------- Работа со сканером штрихкода ------------------------------------

// Функция возвращает внешний объект драйвера сканера штрихкодов
// Параметры:
//		нет
// Возвращаемое значение:
//		объект драйвера
Функция ПолучитьОбъектДрайвера() Экспорт

	Попытка
		ПрогИД = "AddIn.Scanner";
		ПодключитьВнешнююКомпоненту(ПрогИД);
		Драйвер = Новый (ПрогИД);
	Исключение
		//ОписаниеОшибки = "Невозможно подключить внешнюю компоненту сканирования штрихкода.";
		
		Возврат Неопределено;
	КонецПопытки;

	Возврат Драйвер;
КонецФункции

// Функция осуществляет подключение устройства.
//
// Параметры:
//        Объект - объект драйвера торгового оборудования.
//
Процедура ПодключитьСканер(Драйвер) Экспорт
	Если Драйвер = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Драйвер.Состояние = 1 Тогда
		Если Драйвер.Подсоединить("Сканер штрихкода") <> 0 Тогда
			Возврат;
		КонецЕсли;
		
		Драйвер.ИмяСобытия = "ПолученШтрихкод";
		Драйвер.БитДанных  = 8;
		Драйвер.Порт       = COMПорт;
		Драйвер.Скорость   = 9600;
		Драйвер.СтопБит    = 0;
		Драйвер.СтопСимвол = 13;
		Драйвер.ЗапрещениеСобытий=0;
	КонецЕсли;

	Если Драйвер.УстройствоЗанято = 0 Тогда
		Попытка
			Если Драйвер.Занять(Истина) = 0 Тогда
				Драйвер.УстройствоВключено = 1;
				Драйвер.ПосылкаДанных      = 1;
				Драйвер.ОчиститьВход();
				Драйвер.ОчиститьВыход();
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

// Процедура осуществляет отключение устройства.
//
// Параметры:
//      Объект - объект драйвера торгового оборудования.
//
Процедура ОтключитьСканер(Драйвер) Экспорт
	Если Драйвер = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Драйвер.УстройствоВключено = 0;
	Драйвер.Освободить();
	Драйвер.Отсоединить();

КонецПроцедуры

// Функция осуществляет обработку внешних событий оборудования.
// Параметры:
//		Драйвер - объект драйвера
//		Данные -  данные для обработки
// Возвращаемое значение:
//		число (штрихкод)
// Пример:
//		Штрихкод = РаботаСоШтрихкодами.ОбработатьСобытиеСШК(Драйвер, Данные);
Функция ОбработатьСобытиеСШК(Драйвер, Данные) Экспорт
	
	Штрихкод = Число(СокрЛП(Данные));
	
	Драйвер.ПосылкаДанных = 0;
	
	Возврат Штрихкод;
	
КонецФункции

// Процедура вызывается, когда система готова принять следующее событие от устройства.
// Параметры:
//		Драйвер - объект драйвера
Процедура СобытиеОбработано(Драйвер) Экспорт

	Драйвер.ПосылкаДанных = 1;

КонецПроцедуры

#КонецЕсли

#КонецОбласти


