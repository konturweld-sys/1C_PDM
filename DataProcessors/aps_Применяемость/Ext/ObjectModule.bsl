
#Область ПрограммныйИнтерфейс

// Процедура строит применяемость для текущего элемента
// Параметры:
//		item	- ссылка на элемент,
//		Строки	- КоллекцияСтрокДереваЗначений
// Пример:
//		aps_ОбновитьДеревоПрименяемости(НоваяСтрока.ЭлементСсылка, НоваяСтрока.Строки, Рекурсивно, МестоПоиска, МассивСвязей);
//
Процедура aps_ОбновитьДеревоПрименяемости( item, Знач Строки, Рекурсивно = Ложь, МестоПоиска = Неопределено, МассивСвязей=Неопределено ) Экспорт 
	Если ТипЗнч(item)=Тип("СправочникСсылка.aps_ПараметрыЭлементовИзделия") 
			Или ТипЗнч(item)=Тип("СправочникСсылка.aps_ПараметрыЭлементовТехнологии") Тогда 
		// получить применяемость параметра
		Применяемость = aps_Итераторы.aps_ПрименяемостьПараметра( item );
		Применяемость.Колонки.Добавить("ВидСвязи");
	Иначе 
		// получить применяемость элемента
		Применяемость = aps_Итераторы.aps_Применяемость( item );
	КонецЕсли;
	
	// Где искать
	Если ЗначениеЗаполнено(МестоПоиска)  Тогда
		МассивРодителей = Применяемость.ВыгрузитьКолонку("ЭлементСсылка");
		МассивРезультатовОтбора = aps_ФильтрЭлементовПоПрименяемости(МассивРодителей, МестоПоиска, МассивСвязей);
		Если МассивРодителей.Найти(МестоПоиска) <> Неопределено Тогда 
			МассивРезультатовОтбора.Добавить(МестоПоиска);
		КонецЕсли;
	КонецЕсли;

	
	Для i=0 По Применяемость.Количество()-1 Цикл 
		Если МассивРезультатовОтбора<>Неопределено И МассивРезультатовОтбора.Найти(Применяемость[i].ЭлементСсылка)=Неопределено Тогда 
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(item)<>Тип("СправочникСсылка.aps_ПараметрыЭлементовИзделия") И ТипЗнч(item)<>Тип("СправочникСсылка.aps_ПараметрыЭлементовТехнологии")
				И ТипЗнч(МассивСвязей)=Тип("Массив") И МассивСвязей.Найти(Применяемость[i].ВидСвязи)=Неопределено Тогда 
			Продолжить;
		КонецЕсли;	
		СтрокаРодителя = Строки.Родитель;
		Пока СтрокаРодителя <> Неопределено Цикл 
			Если СтрокаРодителя.ЭлементСсылка = Применяемость[i].ЭлементСсылка Тогда 
				Прервать;
			КонецЕсли;
			СтрокаРодителя = СтрокаРодителя.Родитель;
		КонецЦикла;
		
		Если СтрокаРодителя <> Неопределено Тогда 
			Прервать;
		КонецЕсли;
		
		НоваяСтрока = Строки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Применяемость[i]);
		Если Рекурсивно Тогда 
			aps_ОбновитьДеревоПрименяемости(НоваяСтрока.ЭлементСсылка, НоваяСтрока.Строки, Рекурсивно, МестоПоиска, МассивСвязей);
			НоваяСтрока.ВетвьПостроена=Истина;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

// Фильтрует массив элементов по применяемости в переданном родителе.
// Возвращает только те элементы, которые применяются в переданном родителе на каком-то из уровней.
// Параметры:
//		МассивЭлементов	- массив элементов, для которых проверяется применяемость в родителе
//		parentItem		- ссылка на родителя или массив
// Пример:
//		МассивРезультатовОтбора = aps_ФильтрЭлементовПоПрименяемости(МассивРодителей, МестоПоиска, МассивСвязей);
//
Функция aps_ФильтрЭлементовПоПрименяемости( МассивЭлементов, parentItem, Знач ВидСвязи = Неопределено ) Экспорт 
	МассивРезультатовОтбора = Новый Массив();
	
	ПрименяемостьЭлементов = aps_Итераторы.aps_Применяемость(МассивЭлементов,, ВидСвязи);
	МассивУровней = Новый Массив();
	МассивУровней.Добавить(ПрименяемостьЭлементов);
	
	i=0;
	Пока i < МассивУровней.Количество() Цикл
		МассивРодителей = Новый Массив();
		
		Применяемость = МассивУровней[i];
		Для Каждого СтрокаПрименяемости Из Применяемость Цикл 
			Если МассивРодителей.Найти(СтрокаПрименяемости.ЭлементСсылка)=Неопределено Тогда 
				МассивРодителей.Добавить(СтрокаПрименяемости.ЭлементСсылка);
			КонецЕсли;
		КонецЦикла;
		
		ПрименяемостьРодителей = aps_Итераторы.aps_Применяемость(МассивРодителей,, ВидСвязи);
		Если ПрименяемостьРодителей.Количество() > 0 Тогда
			// следующий уровень
			МассивУровней.Добавить(ПрименяемостьРодителей);
		КонецЕсли;
		
		i=i+1;
	КонецЦикла;
	
	Для Каждого ЭлементДляПроверки Из МассивЭлементов Цикл
		ФлагПрерывания = Ложь;
		ПотомкиДляПоискаРодителей = Новый Массив();
		ПотомкиДляПоискаРодителей.Добавить(ЭлементДляПроверки);
		
		Для i=0 По МассивУровней.Количество()-1 Цикл
			ОбщийМассивСтрокРодителей = Новый Массив();
			Для Каждого Потомок	Из ПотомкиДляПоискаРодителей Цикл
				МассивСтрокРодителей = МассивУровней[i].НайтиСтроки(Новый Структура("ПотомокСсылка", Потомок));
				Для Каждого СтрокаРодителя Из МассивСтрокРодителей Цикл
					ОбщийМассивСтрокРодителей.Добавить(СтрокаРодителя);
					// проверка совпадения родителя
					Если (ТипЗнч(parentItem)=Тип("Массив") И parentItem.Найти(СтрокаРодителя.ЭлементСсылка)<>Неопределено) Или СтрокаРодителя.ЭлементСсылка = parentItem Тогда
						Если МассивРезультатовОтбора.Найти(ЭлементДляПроверки) = Неопределено Тогда
							МассивРезультатовОтбора.Добавить(ЭлементДляПроверки);
						КонецЕсли;
						ФлагПрерывания = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				Если ФлагПрерывания Тогда Прервать; КонецЕсли;
			КонецЦикла;
			Если ФлагПрерывания Тогда Прервать; КонецЕсли;
			
			// следующий уровень
			ПотомкиДляПоискаРодителей.Очистить();
			Для Каждого СтрокаРодителя Из ОбщийМассивСтрокРодителей Цикл
				ПотомкиДляПоискаРодителей.Добавить(СтрокаРодителя.ЭлементСсылка);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	Возврат МассивРезультатовОтбора;
КонецФункции

#КонецОбласти
