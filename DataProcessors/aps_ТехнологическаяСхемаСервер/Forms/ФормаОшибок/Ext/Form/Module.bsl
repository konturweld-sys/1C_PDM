
#Область ОбработчикиСобытийФормыНаСервере

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("СоответствиеОшибок") Тогда
		локТаблицаОшибок = РеквизитФормыВЗначение("ТаблицаОшибок");
		НомерОшибки = 0;
		Для Каждого КлючИЗначение Из Параметры.СоответствиеОшибок Цикл
			Для Каждого СтрокаОшибки Из КлючИЗначение.Значение Цикл
				НомерОшибки = НомерОшибки + 1;
				НоваяСтрока = локТаблицаОшибок.Добавить();
				НоваяСтрока.ЭлементИлиСтрока = КлючИЗначение.Ключ;
				НоваяСтрока.СтрокаОшибки = СтрокаОшибки;
				НоваяСтрока.ИндексКартинки = КлючИЗначение.Ключ.ВидЭлемента.ИндексКартинки;
				НоваяСтрока.НомерОшибки = НомерОшибки;
			КонецЦикла;
		КонецЦикла;
		
		ЗначениеВРеквизитФормы(локТаблицаОшибок, "ТаблицаОшибок");
		
		Заголовок = "Ошибки (" + Строка(НомерОшибки) + ")";
	Иначе 
		Отказ = Истина;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти