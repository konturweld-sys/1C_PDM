&НаСервереБезКонтекста
Функция ПолучитьОшибкиИПредупреждения(КлючЗаписи)
	МассивОшибок = Новый Массив();
	
	Если КлючЗаписи.Статус = Перечисления.СтатусФормированияERP.ОстановленПоОшибке 
		 ИЛИ КлючЗаписи.Статус = Перечисления.СтатусФормированияERP.Предупреждения Тогда
		НаборЗаписей = РегистрыСведений.aps_КэшированныеДанные.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ЭлементСсылка.Установить(КлючЗаписи.ЭлементСсылка);
		НаборЗаписей.Прочитать();
		Для Каждого ЗаписьНабора Из НаборЗаписей Цикл
			СоответствиеОшибок = ЗаписьНабора.ОшибкиИПредупреждения.Получить();
			Если ТипЗнч(СоответствиеОшибок) = Тип("Соответствие")
				 И СоответствиеОшибок.Количество() > 0 Тогда 
				Для Каждого КлючИЗначение Из СоответствиеОшибок Цикл
					ЭлементСОшибкой = Неопределено;
					Если КлючИЗначение.Ключ = Перечисления.ПредупрежденияИОшибкиERP.ПредупреждениеНезаполненоШтучноеВремя 
						 ИЛИ КлючИЗначение.Ключ = Перечисления.ПредупрежденияИОшибкиERP.ПредупреждениеНезаполненРабочийЦентр
						 ИЛИ КлючИЗначение.Ключ = Перечисления.ПредупрежденияИОшибкиERP.НезаполненВидОперации
						 ИЛИ КлючИЗначение.Ключ = Перечисления.ПредупрежденияИОшибкиERP.НезаполненаНормаВремениВВидеОперации Тогда
						Префикс = "Операция <"; 
						ЭлементСОшибкой = ЗаписьНабора.ЭлементСсылка2; // ошибка относится к операции
					ИначеЕсли КлючИЗначение.Ключ = Перечисления.ПредупрежденияИОшибкиERP.НесвязанСНоменклатурой
						 ИЛИ КлючИЗначение.Ключ = Перечисления.ПредупрежденияИОшибкиERP.КоличествоРавноНулю
						 ИЛИ КлючИЗначение.Ключ = Перечисления.ПредупрежденияИОшибкиERP.НезаданаЕдиницаИзмерения
						 ИЛИ КлючИЗначение.Ключ = Перечисления.ПредупрежденияИОшибкиERP.НетЕдиницыДляНоменклатуры
						 ИЛИ КлючИЗначение.Ключ = Перечисления.ПредупрежденияИОшибкиERP.СостояниеЭлементаНеАрхив Тогда
						Если ЗаписьНабора.ВидНабора = Перечисления.ERPКорпВидыНаборов.ВыходноеИзделие Тогда
							Префикс = "Выходное изделие <";
							ЭлементСОшибкой = ЗаписьНабора.ЭлементСсылка;
						Иначе
							Если ЗаписьНабора.ВидСвязи = Справочники.aps_ШаблоныТехнологическихСвязей.ОсновныеМатериалы Тогда
								Префикс = "Основной материал <";
							ИначеЕсли ЗаписьНабора.ВидСвязи = Справочники.aps_ШаблоныТехнологическихСвязей.Комплектование Тогда
								Префикс = "Комплектующая <";
							КонецЕсли;
							ЭлементСОшибкой = ЗаписьНабора.ЭлементСсылка3;
						КонецЕсли;
					КонецЕсли;
					СтрокаОшибки = Префикс + Строка(ЭлементСОшибкой) + ">: " + Строка(КлючИЗначение.Ключ);
					Если МассивОшибок.Найти(СтрокаОшибки) = Неопределено Тогда
						МассивОшибок.Добавить(СтрокаОшибки);
					КонецЕсли;	
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат МассивОшибок;
КонецФункции

