&НаСервереБезКонтекста
Процедура ЗапуститьОбработкуЭлементов(МассивЭлементов)
	ТаблицаЭлементов = Новый ТаблицаЗначений();
	ТаблицаЭлементов.Колонки.Добавить("ЭлементСсылка", Новый ОписаниеТипов("СправочникСсылка.aps_ЭлементыИзделия, СправочникСсылка.aps_ЭлементыСправочников, СправочникСсылка.aps_ЭлементыТехнологии"));
	Для Каждого ЭлементМассива Из МассивЭлементов Цикл
		ТаблицаЭлементов.Добавить().ЭлементСсылка=ЭлементМассива;
	КонецЦикла;
	ТаблицаЭлементов.Свернуть("ЭлементСсылка");
	
	Для Каждого СтрокаТаблицы Из ТаблицаЭлементов Цикл
		НаборЗаписей = РегистрыСведений.aps_ДанныеВыполненияФоновыхЗаданий.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ЭлементСсылка.Установить(СтрокаТаблицы.ЭлементСсылка);
		ЗаписьЭлемента = НаборЗаписей.Добавить();
		ЗаписьЭлемента.ЭлементСсылка = СтрокаТаблицы.ЭлементСсылка;
		ЗаписьЭлемента.Статус = Перечисления.СтатусФормированияERP.Ожидает;
		НаборЗаписей.Записать();
	КонецЦикла;
	
	Если Константы.aps_ТехСхемаКэшироватьСостав.Получить()=Истина Тогда
		НаборЗаписейКЗапуску=РегистрыСведений.aps_ДанныеВыполненияФоновыхЗаданий.СоздатьНаборЗаписей();
		НаборЗаписейКЗапуску.Отбор.Статус.Установить(Перечисления.СтатусФормированияERP.Ожидает);
		НаборЗаписейКЗапуску.Прочитать();
		Если Найти(Врег(СтрокаСоединенияИнформационнойБазы()), "FILE=") = 1 Тогда 
			aps_ТехнологическаяСхемаКэш.КэшированиеТолькоСоставРек_ФЗ( НаборЗаписейКЗапуску.Выгрузить() );
		Иначе
			МассивПараметров = Новый Массив();
			МассивПараметров.Добавить( НаборЗаписейКЗапуску.Выгрузить() );
			ФоновоеЗадание = ФоновыеЗадания.Выполнить("aps_ТехнологическаяСхемаКэш.КэшированиеТолькоСоставРек_ФЗ",
														МассивПараметров, , "Состав: Кэширование...");
		КонецЕсли;
	КонецЕсли;							
	
	КлючЗадания = Строка(Новый УникальныйИдентификатор());
	Если Найти(Врег(СтрокаСоединенияИнформационнойБазы()), "FILE=") = 1 Тогда 
		aps_ТехнологическаяСхемаКэш.КэшированиеВсего_ФЗ( КлючЗадания );
	Иначе
		МассивПараметров = Новый Массив();
		МассивПараметров.Добавить(КлючЗадания);
		ФоновоеЗадание = ФоновыеЗадания.Выполнить("aps_ТехнологическаяСхемаКэш.КэшированиеВсего_ФЗ", МассивПараметров, КлючЗадания, "Технология: Кэширование...");
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОстановитьОбработкуЭлементов()
	СтруктураОтбора = Новый Структура();
	СтруктураОтбора.Вставить("Состояние", СостояниеФоновогоЗадания.Активно);
	
		
	СтруктураОтбора.Вставить("ИмяМетода", "ERPКорп.ERPКорпЗаполнитьКеширующийРегистр");
	МассивЗаданий = ФоновыеЗадания.ПолучитьФоновыеЗадания(СтруктураОтбора);
	Для Каждого Задание Из МассивЗаданий Цикл
		Задание.Отменить();
	КонецЦикла;

	
	СтруктураОтбора.Вставить("ИмяМетода", "ERPКорп.ERPКорпОбработкаИзделия");
	МассивЗаданий = ФоновыеЗадания.ПолучитьФоновыеЗадания(СтруктураОтбора);
	Для Каждого Задание Из МассивЗаданий Цикл
		Задание.Отменить();
	КонецЦикла;
	
	СтруктураОтбора.Вставить("ИмяМетода", "ERPКорп.ERPКорпСпецификацииФЗ");
	МассивЗаданий = ФоновыеЗадания.ПолучитьФоновыеЗадания(СтруктураОтбора);
	Для Каждого Задание Из МассивЗаданий Цикл
		Задание.Отменить();
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьВсеОшибки()
	СоответствиеОшибок = Новый Соответствие();
	
	НаборЗаписей = РегистрыСведений.aps_ДанныеВыполненияФоновыхЗаданий.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Статус.Установить(Перечисления.СтатусФормированияERP.ОстановленПоОшибке);
	НаборЗаписей.Прочитать();
	Для Каждого ЗаписьНабора Из НаборЗаписей Цикл
		локМассивОшибок = ПолучитьОшибкиИПредупреждения(ЗаписьНабора);
		СоответствиеОшибок.Вставить(ЗаписьНабора.ЭлементСсылка, локМассивОшибок);
	КонецЦикла;
	
	НаборЗаписей = РегистрыСведений.aps_ДанныеВыполненияФоновыхЗаданий.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Статус.Установить(Перечисления.СтатусФормированияERP.Предупреждения);
	НаборЗаписей.Прочитать();
	Для Каждого ЗаписьНабора Из НаборЗаписей Цикл
		локМассивОшибок = ПолучитьОшибкиИПредупреждения(ЗаписьНабора);
		СоответствиеОшибок.Вставить(ЗаписьНабора.ЭлементСсылка, локМассивОшибок);
	КонецЦикла;
	
	Возврат СоответствиеОшибок;
КонецФункции

&НаСервереБезКонтекста
Процедура УстановитьСтатус(стрСтатус, Знач НаборКлючей)
	НовыйСтатус = Перечисления.СтатусФормированияERP[стрСтатус];
	Для Каждого КлючЗаписи Из НаборКлючей Цикл
		МенеджерЗаписи = РегистрыСведений.aps_ДанныеВыполненияФоновыхЗаданий.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МенеджерЗаписи, КлючЗаписи);
		МенеджерЗаписи.Прочитать();
		МенеджерЗаписи.Статус = НовыйСтатус;
		МенеджерЗаписи.Записать();
		МенеджерЗаписи.Статус = КлючЗаписи.Статус; // удалить запись со старым статусом
		МенеджерЗаписи.Удалить();
	КонецЦикла;
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СоздатьСпецификации()
	Если Найти(Врег(СтрокаСоединенияИнформационнойБазы()), "FILE=") = 1 Тогда 
		aps_ТехнологическаяСхема.ФормированиеРСиМК_ФЗ();
	Иначе
		ФоновыеЗадания.Выполнить("aps_ТехнологическаяСхема.ФормированиеРСиМК_ФЗ",,, "Создание спецификаций");
	КонецЕсли; 
КонецПроцедуры

