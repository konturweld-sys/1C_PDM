#Если НЕ МобильноеПриложениеКлиент Тогда
	
#Область ОписаниеПеременных	
	
&НаКлиенте
Перем ЭтоФайловаяБаза;

#КонецОбласти


#Область ОбработчикиСобытийФормыНаКлиенте

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ЭтоФайловаяБаза = ( Найти(Врег(СтрокаСоединенияИнформационнойБазы()), "FILE=") = 1 );
	
	Если НЕ ЭтоФайловаяБаза Тогда
		ПодключитьОбработчикОжидания("ОбработчикПроверкиЗапускаФоновыхЗаданий", 2);
	КонецЕсли;
	
	ОбновитьСписокЭлементов(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	ДобавитьЭлементы(ВыбранноеЗначение);
	ОбновитьСписокЭлементов(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	Если КоличествоЗаписейРегистра( СтатусФормированияERPЗавершен )>0 Тогда
		КодВозвДиалога=Вопрос("В списке имеются завершенные элементы! Перенести их в периодический регистр перед выходом?", РежимДиалогаВопрос.ДаНетОтмена );
		Если КодВозвДиалога=КодВозвратаДиалога.Отмена Тогда
			Отказ=Истина;
		ИначеЕсли КодВозвДиалога=КодВозвратаДиалога.Да Тогда
			КнопкаОчиститьРегистр( Неопределено );
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КнопкаДобавитьЭлементы(Команда)
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	
	МассивДоступныхВидов = Новый Массив();
	МассивДоступныхВидов.Добавить(ВидЭлементаДеталь);
	МассивДоступныхВидов.Добавить(ВидЭлементаКомплекс);
	МассивДоступныхВидов.Добавить(ВидЭлементаКомплект);
	МассивДоступныхВидов.Добавить(ВидЭлементаМатериал);
	МассивДоступныхВидов.Добавить(ВидЭлементаПрИзд);
	МассивДоступныхВидов.Добавить(ВидЭлементаСбЕдиница);
	МассивДоступныхВидов.Добавить(ВидЭлементаСтИзд);
	ПараметрыФормы.Вставить("ДоступныеВидыЭлементов", МассивДоступныхВидов);
		
	ВыборЭлемента = ОткрытьФорму("Обработка.aps_Проводник.Форма.ФормаУправляемая", ПараметрыФормы, ЭтаФорма, "");
КонецПроцедуры

&НаКлиенте
Процедура КнопкаОчиститьРегистр(Команда)
	ЗначениеДаты=ТекущаяДата();
	Если ВвестиДату( ЗначениеДаты, "Введите дату помещения данных..." ) Тогда
		ПередатьВРегистрКэша( ЗначениеДаты );
	КонецЕсли;
	ОбновитьСписокЭлементов(Неопределено);
КонецПроцедуры 

&НаКлиенте
Процедура КнопкаЗапустить(Команда)
	ТаблицаЭлементов = Новый Массив();
	Для Каждого ВыделеннаяСтрока Из Элементы.СписокЭлементов.ВыделенныеСтроки Цикл
		ТаблицаЭлементов.Добавить(ВыделеннаяСтрока.ЭлементСсылка);
	КонецЦикла;
	ЗапуститьОбработкуЭлементов(ТаблицаЭлементов);
	ОбновитьСписокЭлементов(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура КнопкаОстановить(Команда)
	ОстановитьОбработкуЭлементов();
	ОбновитьСписокЭлементов(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьОшибки(Команда)
	СоответствиеОшибок = ПолучитьВсеОшибки();
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("СоответствиеОшибок", СоответствиеОшибок);
	ОткрытьФормуМодально("Обработка.aps_ТехнологическаяСхемаСервер.Форма.ФормаОшибок", ПараметрыФормы, ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура КнопкаСоздатьСпецификации(Команда)
	СоздатьСпецификации();
	ОбновитьСписокЭлементов(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура КнопкаИзменениеФильтра(Команда)
	ТекущаяКнопка = Элементы[Команда.Имя];
	Если НЕ ТекущаяКнопка.Пометка Тогда
		Для Каждого Кнопка Из Элементы.ФильтрПоСтатусу.ПодчиненныеЭлементы Цикл
			Кнопка.Пометка = Ложь;
		КонецЦикла;
		
		ТекущаяКнопка.Пометка = Истина;
	КонецЕсли;
	
	ЗначениеОтбора = Неопределено;
	Если Элементы.ОтображатьСоСтатусомЗавершено.Пометка Тогда
		ЗначениеОтбора = СтатусФормированияERPЗавершен;
	ИначеЕсли Элементы.ОтображатьСоСтатусомОжидает.Пометка Тогда
		ЗначениеОтбора = СтатусФормированияERPОжидает;
	ИначеЕсли Элементы.ОтображатьСоСтатусомСпецификацииСформированы.Пометка Тогда
		ЗначениеОтбора = СтатусФормированияERPСпецификацииСформированы;
	КонецЕсли;
	
	СписокЭлементов.Отбор.Элементы.Очистить();
	Если ЗначениеОтбора <> Неопределено Тогда 
		ЭлементОтбора = СписокЭлементов.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Статус");
		ЭлементОтбора.ПравоеЗначение = ЗначениеОтбора;
		ЭлементОтбора.Использование = Истина;
	КонецЕсли;
	ОбновитьСписокЭлементов(Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОкноСвойств(Команда)
	ОткрытьФорму("Обработка.aps_ИнформацияОбЭлементе.Форма.ФормаУправляемая");
КонецПроцедуры

&НаКлиенте
Процедура КнопкаУстановитьСтатус(Команда)
	стрСтатус = СтрЗаменить(Команда.Имя, "УстановитьСтатус", "");
	
	// выделенные строки = набор ключей записей
	УстановитьСтатус(стрСтатус, Элементы.СписокЭлементов.ВыделенныеСтроки);
	ОбновитьСписокЭлементов(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура КнопкаУдалитьЭлементы(Команда)
	УдалитьВыделенныеЭлементы(Элементы.СписокЭлементов.ВыделенныеСтроки);
	ОбновитьСписокЭлементов(Неопределено);
КонецПроцедуры


&НаКлиенте
Процедура ФЗОбновить(Команда)
	ОбновитьСписокФоновыхЗаданий();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписокЭлементов(Команда)
	Элементы.СписокЭлементов.Обновить();
	
	ЗначениеОтбора = Неопределено;
	Если Элементы.ОтображатьСоСтатусомЗавершено.Пометка Тогда
		ЗначениеОтбора = СтатусФормированияERPЗавершен;
	ИначеЕсли Элементы.ОтображатьСоСтатусомОжидает.Пометка Тогда
		ЗначениеОтбора = СтатусФормированияERPОжидает;
	ИначеЕсли Элементы.ОтображатьСоСтатусомСпецификацииСформированы.Пометка Тогда
		ЗначениеОтбора = СтатусФормированияERPСпецификацииСформированы;
	КонецЕсли;
	
	СловоПослеЧисла = "";
	КоличествоЗаписей = КоличествоЗаписейРегистра(ЗначениеОтбора);
	ОстатокОтДеленияНа100 = КоличествоЗаписей % 100;
	Если ОстатокОтДеленияНа100 >= 11 И ОстатокОтДеленияНа100 <= 19 Тогда 
		СловоПослеЧисла = "ов";
	Иначе
		ОстатокОтДеленияНа10 = КоличествоЗаписей % 10;
		Если ОстатокОтДеленияНа10 = 1 Тогда
			СловоПослеЧисла = "";	
		ИначеЕсли ОстатокОтДеленияНа10 > 1 И ОстатокОтДеленияНа10 < 5 Тогда
			СловоПослеЧисла = "а";
		Иначе
			СловоПослеЧисла = "ов";
		КонецЕсли;
	КонецЕсли;
	Элементы.ФормаКнопкаКоличество.Заголовок = Строка(КоличествоЗаписей) + " элемент" + СловоПослеЧисла;
	
	Если ЭтоФайловаяБаза = Ложь Тогда
		ОбработчикПроверкиЗапускаФоновыхЗаданий();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВызовОкнаПараметров(Команда)
	ОткрытьФормуМодально("Обработка.aps_ТехнологическаяСхемаСервер.Форма.Настройка", , ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура УтвердитьНаДату(Команда)
	ВариантыОтветов=Новый СписокЗначений;
	ВариантыОтветов.Добавить(1,"Утвердить только вновь созданные",,);
	ВариантыОтветов.Добавить(2,"Утвердить вновь созданные и неутверждённые",,);
	ВариантыОтветов.Добавить(3,"Утвердить все",,);
	ВариантыОтветов.Добавить(КодВозвратаДиалога.Отмена,"Отмена",,);
	Ответ=Вопрос("Внимание! Утверждение спецификации повлечет за собой установку активности и Вас в качестве ответственного."+Символы.ПС+Символы.ПС+
				"Продолжить для выбранных элементов ("+КоличествоЗаписейРегистра()+")"+"?", ВариантыОтветов);
	Если Ответ=КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	ДатаУтверждения = ТекущаяДата();
	Если Не ВвестиДату(ДатаУтверждения, "Утвердить на дату", ЧастиДаты.Дата) Тогда
	    Возврат;
	КонецЕсли;
	
	УтвердитьСпецификацииРегистра(Ответ, ДатаУтверждения);
	
	Элементы.СписокФоновыхЗаданий.Обновить();
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОсновнымиНаДату(Команда)
	ВариантыОтветов=Новый СписокЗначений;
	ВариантыОтветов.Добавить(1,"Установить только вновь созданные",,);
	ВариантыОтветов.Добавить(2,"Установить вновь созданные и установленные ранее",,);
	ВариантыОтветов.Добавить(3,"Установить все",,);
	ВариантыОтветов.Добавить(КодВозвратаДиалога.Отмена,"Отмена",,);
	
	Ответ=Вопрос("Внимание! Спецификации номенклатуры будут установлены основными на выбранную дату."+Символы.ПС+Символы.ПС+
				"Продолжить для выбранных элементов ("+КоличествоЗаписейРегистра()+")"+"?", ВариантыОтветов);
	Если Ответ=КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	ДатаУстановкиОсновными = ТекущаяДата();
	Если Не ВвестиДату(ДатаУстановкиОсновными, "Установить на дату", ЧастиДаты.Дата) Тогда
	    Возврат;
	КонецЕсли;
	
	ДатаУстановкиОсновнымиСтарая = Неопределено;	
	Если Ответ=2 тогда
		ДатаУстановкиОсновнымиСтарая = ТекущаяДата();
		Если Не ВвестиДату(ДатаУстановкиОсновнымиСтарая, "Установить для всех установленных ранее", ЧастиДаты.Дата) Тогда
		    ДатаУстановкиОсновнымиСтарая = ТекущаяДата();
		КонецЕсли;
	КонецЕсли;
	
	УстановитьСпецификацииРегистраОсновнымиНаДату(Ответ, ДатаУстановкиОсновными, ДатаУстановкиОсновнымиСтарая);
	

КонецПроцедуры

&НаКлиенте
Процедура ФЗЗаПериод(Команда)
	Элементы.СписокФоновыхЗаданийЗаПериод.Пометка = НЕ Элементы.СписокФоновыхЗаданийЗаПериод.Пометка;
	ОбновитьСписокФоновыхЗаданий();
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиЭлементовФормы

&НаКлиенте
Процедура СписокЭлементовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	
	ОшибкиИПредупреждения = ПолучитьОшибкиИПредупреждения(ВыбраннаяСтрока);
	Если ОшибкиИПредупреждения.Количество() > 0 Тогда
		СтандартнаяОбработка = Ложь;
		СтрокаОшибок = "";
		Для Каждого СтрокаОшибки Из ОшибкиИПредупреждения Цикл 
			СтрокаОшибок = СтрокаОшибок + СтрокаОшибки + Символы.ПС;
		КонецЦикла;
		Предупреждение(СтрокаОшибок, , Строка(ВыбраннаяСтрока.ЭлементСсылка));
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СписокЭлементовПриАктивизацииСтроки(Элемент)
	Если Элементы.СписокЭлементов.ТекущиеДанные <> Неопределено Тогда
		aps_СтруктураПараметровОповещения.Очистить();
		aps_СтруктураПараметровОповещения.Вставить("item", Элементы.СписокЭлементов.ТекущиеДанные.ЭлементСсылка);
		aps_СтруктураПараметровОповещения.Вставить("ФормаИсточник", ЭтаФорма);
		
		Оповестить("AppiusWindowGeneralNotify", aps_СтруктураПараметровОповещения, ЭтаФорма);
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти


#Область ПрочиеПроцедурыИФункцииНаКлиенте

&НаКлиенте
Процедура ОбработчикПроверкиЗапускаФоновыхЗаданий()
	НетАктивныхЗаданий=НЕ ЕстьАктивныеЗадания();
	Элементы.ФормаЗапуститьОбработкуЭлементов.Доступность = НетАктивныхЗаданий;
	Элементы.ФормаДобавитьЭлемент.Доступность = НетАктивныхЗаданий;
КонецПроцедуры

#КонецОбласти

#КонецЕсли

#Если НЕ МобильноеПриложениеСервер Тогда

#Область ОбработчикиСобытийФормыНаСервере

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Найти(Врег(СтрокаСоединенияИнформационнойБазы()), "FILE=") = 1 Тогда
		// это файловая база
		Элементы.СписокФоновыхЗаданий.Видимость = Ложь;
	КонецЕсли;
	
	ВидЭлементаДеталь 	= Справочники.aps_ВидыЭлементов.Деталь;
	ВидЭлементаКомплекс = Справочники.aps_ВидыЭлементов.Комплекс;
	ВидЭлементаКомплект = Справочники.aps_ВидыЭлементов.Комплект;
	ВидЭлементаМатериал = Справочники.aps_ВидыЭлементов.Материал;
	ВидЭлементаПрИзд 	= Справочники.aps_ВидыЭлементов.ПрИзд;
	ВидЭлементаСбЕдиница= Справочники.aps_ВидыЭлементов.СбЕдиница;
	ВидЭлементаСтИзд	= Справочники.aps_ВидыЭлементов.СтИзд;
	
	СтатусФормированияERPЗавершен = Перечисления.СтатусФормированияERP.Завершен;
	СтатусФормированияERPОжидает = Перечисления.СтатусФормированияERP.Ожидает;
	СтатусФормированияERPСпецификацииСформированы = Перечисления.СтатусФормированияERP.СпецификацииСформированы;
КонецПроцедуры

#КонецОбласти


#Область ПрочиеПроцедурыИФункцииНаСервере

&НаСервере
Процедура ОбновитьСписокФоновыхЗаданий()
	ТекущийИдентификатор = Неопределено;
	ФоновыеЗаданияСоответствие = Новый Соответствие();
	
	ТекущаяСтрока = Элементы.СписокФоновыхЗаданий.ТекущаяСтрока;
	Если ТекущаяСтрока <> Неопределено Тогда
		ТекущийИдентификатор = СписокФоновыхЗаданий.НайтиПоИдентификатору(ТекущаяСтрока).Идентификатор;
	КонецЕсли;
	
	Идентификаторы = Новый Массив;
	
	ВыделенныеСтроки = Элементы.СписокФоновыхЗаданий.ВыделенныеСтроки;
	Для Каждого ВыделеннаяСтрока из ВыделенныеСтроки Цикл
		Идентификаторы.Добавить(СписокФоновыхЗаданий.НайтиПоИдентификатору(ВыделеннаяСтрока).Идентификатор);
	КонецЦикла;
	
	СписокФоновыхЗаданий.Очистить();
	
	Если Элементы.СписокФоновыхЗаданийЗаПериод.Пометка Тогда
		ОтборНачало = ТекущаяДата() - 300; // за последние пять минут
		Отбор = Новый Структура("ИмяМетода, Начало", "aps_ТехнологическаяСхемаКэш.КэшированиеВсего_ФЗ", ОтборНачало);
		Отбор1 = Новый Структура("ИмяМетода, Начало", "aps_ТехнологическаяСхемаКэш.КэшированиеТолькоСоставРек_ФЗ", ОтборНачало);
		Отбор2 = Новый Структура("ИмяМетода, Начало", "aps_ТехнологическаяСхема.ФормированиеРСиМК_ФЗ", ОтборНачало);
	Иначе
		Отбор = Новый Структура("ИмяМетода", "aps_ТехнологическаяСхемаКэш.КэшированиеВсего_ФЗ");
		Отбор1 = Новый Структура("ИмяМетода", "aps_ТехнологическаяСхемаКэш.КэшированиеТолькоСоставРек_ФЗ");
		Отбор2 = Новый Структура("ИмяМетода", "aps_ТехнологическаяСхема.ФормированиеРСиМК_ФЗ");
	КонецЕсли;	
		
	Фоновые = ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор);
	Фоновые1 = ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор1);
	Фоновые2 = ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор2);
	Для Каждого Фоновое1 Из Фоновые1 Цикл
		Фоновые.Добавить(Фоновое1);
	КонецЦикла;
	Для Каждого Фоновое2 Из Фоновые2 Цикл
		Фоновые.Добавить(Фоновое2);
	КонецЦикла;

	Для Каждого Фоновое из Фоновые Цикл
		НоваяСтрока = СписокФоновыхЗаданий.Добавить();
		
		РегламентноеЗадание = Фоновое.РегламентноеЗадание;
		Если РегламентноеЗадание <> Неопределено Тогда
			Строка = РегламентноеЗадание.Метаданные.Представление();
			Если РегламентноеЗадание.Наименование <> "" Тогда
				Строка = Строка + ":" +	РегламентноеЗадание.Наименование;
			КонецЕсли;
			
			НоваяСтрока.Регламентное = Строка;
		КонецЕсли;
			
		НоваяСтрока.Наименование = Фоновое.Наименование;
		НоваяСтрока.Ключ = Фоновое.Ключ;
		НоваяСтрока.Метод = Фоновое.ИмяМетода;
		НоваяСтрока.Состояние = Фоновое.Состояние;
		НоваяСтрока.Начало = Фоновое.Начало;
		НоваяСтрока.Конец = Фоновое.Конец;
		НоваяСтрока.Сервер = Фоновое.Расположение;
		
		Если Фоновое.ИнформацияОбОшибке <> Неопределено Тогда
			НоваяСтрока.Ошибки = ПодробноеПредставлениеОшибки(Фоновое.ИнформацияОбОшибке);
		КонецЕсли;
		
		НоваяСтрока.Идентификатор = Фоновое.УникальныйИдентификатор;
		НоваяСтрока.СостояниеЗадания = Фоновое.Состояние;
		
		ФоновыеЗаданияСоответствие[Строка(Фоновое.УникальныйИдентификатор)] = Фоновое;
	КонецЦикла;
	
	Если ТекущийИдентификатор <> Неопределено Тогда
		Строки = СписокФоновыхЗаданий.НайтиСтроки(Новый Структура("Идентификатор", ТекущийИдентификатор));
		Если Строки.Количество() > 0 Тогда
			Элементы.СписокФоновыхЗаданий.ТекущаяСтрока = Строки[0].ПолучитьИдентификатор();
		КонецЕсли;
	КонецЕсли;
	
	Если Идентификаторы.Количество() > 0 Тогда
		ВыделенныеСтроки.Очистить();
	КонецЕсли;
		
	Для Каждого Идентификатор из Идентификаторы Цикл
		Строки = СписокФоновыхЗаданий.НайтиСтроки(Новый Структура("Идентификатор", Идентификатор));
		Если Строки.Количество() > 0 Тогда
			ВыделенныеСтроки.Добавить(Строки[0].ПолучитьИдентификатор());
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

