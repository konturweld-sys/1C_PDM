
#Область ОбработчикиСобытийФормыНаКлиенте

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "AppiusWindowGeneralNotify" Тогда 
		// Не реагировать на оповещение от подчиненной формы и от самой себя
		ВладелецФормыИсточника = Источник;
		Пока ВладелецФормыИсточника <> Неопределено Цикл 
			Если ВладелецФормыИсточника = ЭтаФорма Тогда 
				Возврат;
			КонецЕсли;
			Если ТипЗнч(ВладелецФормыИсточника)=Тип("УправляемаяФорма") Тогда 
				ВладелецФормыИсточника = ВладелецФормыИсточника.ВладелецФормы;
			Иначе 
				ВладелецФормыИсточника = Неопределено;
			КонецЕсли;
		КонецЦикла;
		
		Модифицированность = Ложь;
		
		Если Параметр.Свойство("item") И ЗначениеЗаполнено(Параметр.item) Тогда 
			item = Параметр.item;
		Иначе 
			Возврат;
		КонецЕсли;

		Если Параметр.Свойство("item") И ЗначениеЗаполнено(Параметр.item) Тогда 
			Объект.item = Параметр.item;
		ИначеЕсли Источник <> Неопределено Тогда 
			Возврат;
		КонецЕсли;
		
		ОбновлениеИнформацииВОкне();
		
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ПрочиеПроцедурыИФункцииНаКлиенте

&НаКлиенте
Процедура ОбновлениеИнформацииВОкне()
	ОбновлениеИнформацииВОкнеСервер();
	Если ЗначениеЗаполнено( Объект.item ) Тогда 
		Заголовок = НСтр("ru = 'Просмотр: '; en_US = 'View: '")+Строка(Объект.item);
	Иначе 
		Заголовок = НСтр("ru = 'Просмотр'; en_US = 'View'");
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийФормыНаСервере

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Объект.item = Справочники.aps_ЭлементыИзделия.ПустаяСсылка();
КонецПроцедуры

#КонецОбласти

#Область ПрочиеПроцедурыИФункцииНаСервере

&НаСервере
Процедура ОбновлениеИнформацииВОкнеСервер()
	ЭтотОбъектИБ = РеквизитФормыВЗначение("Объект");
	Если ЗначениеЗаполнено( Объект.item ) Тогда 
		Просмотр = ЭтотОбъектИБ.МодульПравДоступа.aps_ПроверитьОбъектПрава( Справочники.aps_Права.Просмотр, Объект.item, Объект.item.GMOD );
		АдресИзображения=?(Просмотр, ПолучитьНавигационнуюСсылку(Объект.item, "ОсновноеИзображение"), "");
	КонецЕсли;
КонецПроцедуры

#КонецОбласти


