#Область ОбработчикиЭлементовФормы

&НаКлиенте
Процедура НепереведенныеЭлементыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	НепереведенныеЭлементыПриАктивизацииСтроки(Элемент); // для оповещения
	
	Если Объект.Выполнена Тогда 
		Возврат;
	КонецЕсли;
	
	Данные = Элементы.НепереведенныеЭлементы.ТекущиеДанные;
	Предупреждение(НСтр("ru = ""Элемент <""; en_US = ""The <""")+Строка(Данные.ЭлементСсылка)+НСтр("ru = ""> не был переведен в состояние <""; en_US = ""> item was not translated to the <""")
					+Строка(Данные.ЦелевоеСостояние)+НСтр("ru = ""> по причине:""; en_US = ""> status:""")+Символы.ПС
					+Данные.Причина);
КонецПроцедуры

&НаКлиенте
Процедура НепереведенныеЭлементыПриАктивизацииСтроки(Элемент)
	ТекущаяСтрока = Элемент.ТекущиеДанные;
	Если ТекущаяСтрока <> Неопределено Тогда 
		// Нотификация информационных окон 
		aps_СтруктураПараметровОповещения.Очистить();
		aps_СтруктураПараметровОповещения.Вставить("item", ТекущаяСтрока.ЭлементСсылка);
		
		Оповестить("AppiusWindowGeneralNotify", aps_СтруктураПараметровОповещения, ЭтаФорма);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияБПНажатие(Элемент)
	Объект.БизнесПроцесс.ПолучитьФорму().Открыть();
КонецПроцедуры

#КонецОбласти

#КонецЕсли

#Если НЕ МобильноеПриложениеСервер Тогда
	
#Область ОбработчикиСобытийФормыНаСервере	
	
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Объект.ТочкаМаршрута = БизнесПроцессы.aps_ИзменениеСостояния.ТочкиМаршрута.Согласовать Тогда 
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаЭлемента Из Объект.Состояния Цикл
		СтрокаЭлемента.ИндексКартинки = ?(ЗначениеЗаполнено(СтрокаЭлемента.ЭлементСсылка.ИндексКартинки), СтрокаЭлемента.ЭлементСсылка.ИндексКартинки, СтрокаЭлемента.ЭлементСсылка.ВидЭлемента.ИндексКартинки);
	КонецЦикла;
	
	Элементы.Надпись.Видимость = НЕ Объект.Выполнена;
	Элементы.НадписьВыполнена.Видимость = Объект.Выполнена;
		
	Элементы.Надпись.ЦветТекста = Новый Цвет(240,0,0);
	Элементы.НадписьВыполнена.ЦветТекста = Новый Цвет(0,200,0);
	
	Элементы.ФормаКнопкаПеревестиЭлементы.Видимость = (НЕ Объект.Выполнена) И (Объект.БизнесПроцесс.ОтветственныйЗаВыполнение = ПараметрыСеанса.ТекущийПользователь);
	Элементы.ДекорацияБП.Заголовок = Строка(Объект.БизнесПроцесс);
КонецПроцедуры

#КонецОбласти

#КонецЕсли
