
#Если НЕ МобильноеПриложениеКлиент Тогда

#Область ОбработчикиКомандФормы	
	
&НаКлиенте
Процедура ПеревестиЭлементы(Команда)
	Попытка
		Записать(Новый Структура("ВыполнитьЗадачу", Истина));
	Исключение
		Сообщить(aps_ПолныеПрава.aps_ПараметрСеанса("aps_ИмяПродукта")+НСтр("ru = ""Не удалось выполнить задачу по причине:""; en_US = ""Cannot execute the task:""")+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), СтатусСообщения.Внимание);
		Возврат;
	КонецПопытки;
	
	Прочитать();
	
	Если Объект.Состояния.Количество() = 0 Тогда // все переведены
		ПоказатьОповещениеПользователя(НСтр("ru = ""Изменение состояний элементов выполнено!""; en_US = ""Change of items statuses is completed!"""));
	КонецЕсли;
	
	// отображение элементов формы
	ПриСозданииНаСервере(Неопределено, Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура Информация(Команда)
	ОткрытьФорму("Обработка.aps_ИнформацияОбЭлементе.Форма.Форма");
КонецПроцедуры

&НаКлиенте
Процедура УправлениеИзделиями(Команда)
	#Если ТолстыйКлиентОбычноеПриложение Тогда
	МассивЭлементов = Новый Массив;
	Для Каждого Строка Из Элементы.НепереведенныеЭлементы.ВыделенныеСтроки Цикл
		МассивЭлементов.Добавить(Элементы.НепереведенныеЭлементы.ДанныеСтроки(Строка).ЭлементСсылка);
	КонецЦикла;
	aps_ОткрытьВОкнеУправленияИзделиями(МассивЭлементов);
	#КонецЕсли
КонецПроцедуры

