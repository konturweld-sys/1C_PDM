#Область ОбработчикиСобытий	
	
Процедура ПриВыполнении(Отказ) 
	Если УведомитьОПрочтении Тогда
		СтрокаТемы			= НСтр("ru = 'Уведомление о прочтении'; en_US = 'User read the message'");
		
		СтрокаСодержания_ru	= "Уведомление " + Наименование + " прочитано пользователем " + Получатель.Наименование + " " + ТекущаяДата();
		СтрокаСодержания_en	= "The message " + Наименование + " readed by " + Получатель.Наименование + " on " + ТекущаяДата();
		СтрокаСодержания	= НСтр("ru = '"+СтрокаСодержания_ru+"'; en_US = '"+СтрокаСодержания_en+"'");
		
		aps_СоздатьУведомление(, Отправитель,, СтрокаТемы, СтрокаСодержания,,,, ,, Истина);
	КонецЕсли;
КонецПроцедуры

Процедура ПередЗаписью(Отказ)
	i=0;
	Пока i < Вложения.Количество() Цикл 
		Если НЕ ЗначениеЗаполнено(Вложения[i].Вложение) Тогда 
			Вложения.Удалить(i); Продолжить;
		КонецЕсли;
		i=i+1;
	КонецЦикла;
КонецПроцедуры

