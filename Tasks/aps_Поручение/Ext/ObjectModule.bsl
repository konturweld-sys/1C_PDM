#Если НЕ МобильноеПриложениеСервер Тогда

#Область ОписаниеПеременных	
	
#Если Сервер Тогда 	
Перем aps_СтруктураПараметровОповещенияНаСервере Экспорт; // Описание структуры параметров событий/оповещений 1C:PDM на сервере
#КонецЕсли

#КонецОбласти


#Область ОбработчикиСобытий

Процедура ПриВыполнении(Отказ)
	Если НЕ ЗначениеЗаполнено(ДатаВыполнения) Тогда 
		ТекДата = ТекущаяДата();
		Если ЗначениеЗаполнено(СрокСогласования) И СрокСогласования <= ТекДата Тогда 
			ДатаВыполнения = СрокСогласования;
		Иначе 
			ДатаВыполнения = ТекДата;
		КонецЕсли;
	КонецЕсли;
	
	#Если Клиент Или ВнешнееСоединение Тогда 
		// гл. переменная
	#Иначе
		aps_СтруктураПараметровОповещения=aps_СтруктураПараметровОповещенияНаСервере;
	#КонецЕсли
	
	aps_СтруктураПараметровОповещения.Вставить("itemObject",ЭтотОбъект);
	aps_ОбработчикиСобытий.aps_ВыполнитьСобытие(Перечисления.aps_События.ПриВыполненииПоручения, aps_СтруктураПараметровОповещения);
КонецПроцедуры

Процедура ОбработкаПроверкиВыполнения(Результат)
	Результат = Ложь;
	ТекДата = ТекущаяДата();
	
	Если ЗначениеЗаполнено(СрокСогласования) И СрокСогласования <= ТекДата Тогда
		// выполнить поручение автоматически
		ВзятоНаРассмотрение = Истина;
		Комментарий = НСтр("ru = ""Срок поручения истек.""; en_US = ""The term of task is expired.""");
		Результат = Истина;
		
	ИначеЕсли НЕ ВзятоНаРассмотрение И ЗначениеЗаполнено(Заместитель) И СрокОтправкиЗаместителю <= ТекДата Тогда 
		// найти другие поручения по БП, которые нужно перенаправить заместителю
		Запрос = Новый Запрос();
		Запрос.Текст = "ВЫБРАТЬ
		               |	aps_Поручение.Ссылка
		               |ИЗ
		               |	Задача.aps_Поручение КАК aps_Поручение
		               |ГДЕ
		               |	aps_Поручение.БизнесПроцесс = &БизнесПроцесс
		               |	И aps_Поручение.Исполнитель = &Исполнитель
		               |	И aps_Поручение.Заместитель = &Заместитель
		               |	И aps_Поручение.СрокОтправкиЗаместителю = &СрокОтправкиЗаместителю
		               |	И НЕ aps_Поручение.Выполнена";
		Запрос.УстановитьПараметр("БизнесПроцесс", БизнесПроцесс);
		Запрос.УстановитьПараметр("Исполнитель", Исполнитель);
		Запрос.УстановитьПараметр("Заместитель", Заместитель);
		Запрос.УстановитьПараметр("СрокОтправкиЗаместителю", СрокОтправкиЗаместителю);
		МассивПорученийПоБизнесПроцессу = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
		Попытка
			НачатьТранзакцию();
				// перенаправить заместителю
				Для Каждого Поручение Из МассивПорученийПоБизнесПроцессу Цикл
					ПоручениеОбъект = Поручение.ПолучитьОбъект();
					ПоручениеОбъект.Исполнитель = Заместитель;
					ПоручениеОбъект.Исполнители.Очистить();
					ПоручениеОбъект.Исполнители.Добавить().Пользователь = Заместитель;
					ПоручениеОбъект.Заместитель = Справочники.Пользователи.ПустаяСсылка();
					ПоручениеОбъект.СрокОтправкиЗаместителю = '00010101';
					ПоручениеОбъект.Записать();
				КонецЦикла;
				aps_ОтправитьПоручения(Исполнитель, Заместитель, БизнесПроцесс.ВедущаяЗадача.БизнесПроцесс, МассивПорученийПоБизнесПроцессу);
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
		КонецПопытки;
	КонецЕсли;      
КонецПроцедуры

#КонецОбласти


#Область Инициализация

#Если Сервер Тогда 
aps_СтруктураПараметровОповещенияНаСервере=Новый Структура();
#КонецЕсли

#КонецОбласти

#КонецЕсли
