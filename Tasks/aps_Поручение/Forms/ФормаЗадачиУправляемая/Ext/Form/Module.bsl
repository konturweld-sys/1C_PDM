КонецПроцедуры

&НаКлиенте
Процедура Перенаправить(Команда)
	Для Каждого Элемент Из Элементы.ГруппаКоманднаяПанель.ПодчиненныеЭлементы Цикл
		Элемент.Видимость = Ложь;
	КонецЦикла;
	Элементы.ФормаКнопкаЗакрыть.Видимость = Ложь;
	Элементы.ФормаКнопкаЗаписатьИЗакрыть.Видимость = Ложь;
	Элементы.НадписьДействия.Заголовок = НСтр("ru = ""Выберите пользователя или группу исполнителей, которым Вы хотите перенаправить поручение:""; en_US = ""Select user or exclusive group to redirect the task to:""");
		
	НовыйИсполнитель = ?(ПараметрСеанса("ТекущийПользователь")=Объект.Заместитель, ПолучитьПустуюСсылку(), Объект.Заместитель);
	Элементы.ПолеКомментария.Видимость		 = Ложь;
	Элементы.ПолеНовыйИсполнитель.Видимость  = Истина;
	Элементы.ФормаКнопкаOK.Видимость 		 = Истина;
	Элементы.ФормаКнопкаOK.КнопкаПоУмолчанию = Истина;
	Элементы.ФормаКнопкаОтмена.Видимость 	 = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ПеренаправитьНовомуИсполнителю(Команда)
	
	Если НЕ ЗначениеЗаполнено(НовыйИсполнитель) Тогда 
		Предупреждение(НСтр("ru = ""Не указан новый исполнитель!""; en_US = ""A new performer is not specified!"""));
		Возврат; 
	КонецЕсли;
		
	Если ТипЗнч(НовыйИсполнитель) = Тип("СправочникСсылка.Пользователи") Тогда
		Если НовыйИсполнитель = Объект.Заместитель Тогда 
			Объект.Заместитель = ПолучитьПустуюСсылку();
			Объект.СрокОтправкиЗаместителю = '00010101';
		КонецЕсли;
		Объект.Исполнитель = НовыйИсполнитель;
		Объект.Исполнители.Очистить();
		Объект.Исполнители.Добавить().Пользователь = НовыйИсполнитель;
	Иначе // группа исполнителей
		Объект.Исполнитель = ПолучитьПустуюСсылку();
		Объект.Исполнители.Очистить();
		Для Каждого СтрокаПользователя Из НовыйИсполнитель.Исполнители Цикл
			Объект.Исполнители.Добавить().Пользователь = СтрокаПользователя.Пользователь;
		КонецЦикла;
	КонецЕсли;
	
	Объект.ВзятоНаРассмотрение = Ложь;
	Объект.ДатаНачалаВыполнения = '00010101';
	Записать();
	
	МассивВложений = Новый Массив;
	МассивВложений.Добавить(Объект.Ссылка);
	
	Если ТипЗнч(НовыйИсполнитель) = Тип("СправочникСсылка.Пользователи") Тогда
		ОтправитьПоручения(НовыйИсполнитель, МассивВложений);	
	Иначе // группа исполнителей
		Для Каждого СтрокаПользователя Из НовыйИсполнитель.Исполнители Цикл 
			ОтправитьПоручения(СтрокаПользователя.Пользователь, МассивВложений);
		КонецЦикла;
	КонецЕсли;
	
	Закрыть();
	
КонецПроцедуры

