#Область ПрочиеПроцедурыИФункцииНаКлиенте

&НаКлиенте
Процедура ОбновитьНадпись()
	ТекПользователь = ПараметрСеанса("ТекущийПользователь");
	ИсполнительПоручения = Объект.Исполнитель;
	ПоручениеСогласовано = Объект.Согласовано;
	
	ФорматВремяДата = НСтр("ru = 'ДФ=""""Ч:мм д ММММ гггг'' г.''""""'; en_US = 'ДФ=""""дд-ММ-гггг Ч:мм""""'");
	ФорматВремяДата = СтрЗаменить(ФорматВремяДата, """""", """");
	ФорматДатаВремя = НСтр("ru = 'ДФ=""""д ММММ гггг'' г. в ''Ч:мм""""'; en_US = 'ДФ=""""дд-ММ-гггг'' at ''Ч:мм""""'");
	ФорматДатаВремя = СтрЗаменить(ФорматДатаВремя, """""", """");
	
	Если Объект.Выполнена Тогда
		Если ЗначениеЗаполнено(Объект.СрокСогласования) И Объект.ДатаВыполнения >= Объект.СрокСогласования Тогда
			// поручение выполнено автоматически
			ДатаВыполнения = Формат(Объект.ДатаВыполнения, ФорматДатаВремя)+" (срок поручения истек).";
			СтрокаИсполнителя = НСтр("ru = ""автоматически ""; en_US = ""automatically """);
		Иначе
			ДатаВыполнения = Формат(Объект.ДатаВыполнения, ФорматДатаВремя)+".";
			СтрокаИсполнителя = ?(ТекПользователь = ИсполнительПоручения, НСтр("ru = ""Вами ""; en_US = ""by you """), НСтр("ru = ""пользователем <""; en_US = ""by <""")+ИсполнительПоручения+"> ");
		КонецЕсли;	
		НадписьДействия = НСтр("ru = ""Изменение ""; en_US = ""The change was """)+?(ПоручениеСогласовано, НСтр("en_US='approved';ru='принято'"), НСтр("ru = ""отклонено""; en_US = ""refused"""))+НСтр("ru = "". Поручение выполнено ""; en_US = "". The task was completed """)+СтрокаИсполнителя+ДатаВыполнения;
		ЦветНадписи = ?(ПоручениеСогласовано, Новый Цвет(0,200,0), Новый Цвет(240,0,0));
		Элементы.НадписьДействия.ЦветТекста = ЦветНадписи;
		
	ИначеЕсли Объект.ВзятоНаРассмотрение Тогда
		Если ТекПользователь = ИсполнительПоручения Тогда
			НадписьДействия = НСтр("ru = ""Поручение взято Вами на рассмотрение ""; en_US = ""The task was taken to consideration by you """)+Формат(Объект.ДатаНачалаВыполнения, ФорматДатаВремя)+"."+Символы.ПС+
							НСтр("en_US='You can approve or refuse the change';ru='Вы можете принять изменение или отклонить его'")+
							?(ЗначениеЗаполнено(Объект.СрокСогласования), НСтр("ru = "" до ""; en_US = "" till """)+Формат(Объект.СрокСогласования, ФорматВремяДата), ".");
		Иначе
			НадписьДействия = НСтр("ru = ""Поручение находится на рассмотрении у пользователя <""; en_US = ""The task is considered by <""")+ИсполнительПоручения+"> с "+Формат(Объект.ДатаНачалаВыполнения, ФорматДатаВремя)+".";
		КонецЕсли;
		
	Иначе
		Если Объект.Исполнители.НайтиСтроки(Новый Структура("Пользователь", ТекПользователь)).Количество() > 0 Тогда 
			
			Если ЗначениеЗаполнено(Объект.СрокОтправкиЗаместителю) Тогда 
				СтрокаСрокаОтправки = НСтр("ru = "" до ""; en_US = "" till """)+Формат(Объект.СрокОтправкиЗаместителю, ФорматВремяДата)+НСтр("ru = "" По истечении этого срока поручение будет перенаправлено пользователю <""; en_US = "" On the expiration of this term the task wiil be redirected to <""")+Объект.Заместитель+">.";
			ИначеЕсли ЗначениеЗаполнено(Объект.СрокСогласования) Тогда
				СтрокаСрокаОтправки = НСтр("ru = "" до ""; en_US = "" till """)+Формат(Объект.СрокСогласования, ФорматВремяДата)+НСтр("ru = "" По истечении этого срока изменение состояния элемента будет отклонено автоматически.""; en_US = "" On the expiration of this term the change of item status will be refused automatically.""");
			Иначе
				СтрокаСрокаОтправки = ".";
			КонецЕсли;
			НадписьДействия = НСтр("ru = ""Вы можете взять поручение на рассмотрение или перенаправить его другому пользователю""; en_US = ""You can take the task to consideration or redirect it to another user""")+СтрокаСрокаОтправки;
		Иначе
			СтрокаИсполнитель = ?(ЗначениеЗаполнено(ИсполнительПоручения), НСтр("ru = ""пользователю <""; en_US = ""to <""")+Строка(ИсполнительПоручения)+">", НСтр("ru = ""группе исполнителей""; en_US = ""to exclusive group"""));
			НадписьДействия = НСтр("ru = ""Поручение направлено ""; en_US = ""The task is sent """)+СтрокаИсполнитель+НСтр("ru = "" и ещё не взято на рассмотрение.""; en_US = "" and is not taken to consideration yet.""");
		КонецЕсли;
	КонецЕсли;
	
	Элементы.НадписьДействия.Заголовок = НадписьДействия;
		
	Для Каждого СтрокаЭлемента Из Объект.Состояния Цикл
		ЭлементСсылка = СтрокаЭлемента.ЭлементСсылка;
		СтрокаЭлемента.ИндексКартинки = ?(ЭлементСсылка.ИндексКартинки=0, ЭлементСсылка.ВидЭлемента.ИндексКартинки, ЭлементСсылка.ИндексКартинки);
	КонецЦикла;
	
	// заголовок формы
	Заголовок = НСтр("ru = ""Поручение ""; en_US = ""The task """)+Объект.Наименование+НСтр("ru = "" от ""; en_US = "" dated """)+Формат(Объект.Дата, "ДФ=""дд.ММ.гггг ЧЧ:мм""");
КонецПроцедуры

#КонецОбласти

#КонецЕсли


#Если НЕ МобильноеПриложениеСервер Тогда
	
#Область ОбработчикиСобытийФормыНаСервере	

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если НЕ Объект.Ссылка.Пустая() И НЕ Объект.Выполнена Тогда
		ЭтотОбъектИБ = РеквизитФормыВЗначение("Объект");
		Если ЭтотОбъектИБ.ПроверитьВыполнение() Тогда 
			ЭтотОбъектИБ.ВыполнитьЗадачу();
		КонецЕсли;
		Прочитать();
	КонецЕсли;
	
	Элементы.ДекорацияБП.Заголовок = Строка(Объект.БизнесПроцесс.ВедущаяЗадача.БизнесПроцесс);
КонецПроцедуры

#КонецОбласти


#Область ПрочиеПроцедурыИФункцииНаСервере

&НаСервереБезКонтекста
Функция ПараметрСеанса(ИмяПараметра)
	Возврат ПараметрыСеанса[ИмяПараметра];
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьПустуюСсылку()
	Возврат Справочники.Пользователи.ПустаяСсылка();
КонецФункции

&НаСервере
Процедура ОтправитьПоручения(Получатель, МассивПоручений)
	aps_ОтправитьПоручения(ПараметрыСеанса.ТекущийПользователь, Получатель, Объект.БизнесПроцесс.ВедущаяЗадача.БизнесПроцесс, МассивПоручений);
КонецПроцедуры

#КонецОбласти

#КонецЕсли
