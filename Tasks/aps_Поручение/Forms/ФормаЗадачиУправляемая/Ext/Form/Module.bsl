#Если НЕ МобильноеПриложениеКлиент Тогда
	
#Область ОбработчикиСобытийФормыНаКлиенте	
	
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ТекПользователь = ПараметрСеанса("ТекущийПользователь");
	
	Если Объект.Выполнена Тогда
		ВзятьНаРассмотрениеВидимость = Ложь;
		СогласованоВидимость = Ложь;
	ИначеЕсли Объект.ВзятоНаРассмотрение Тогда 
		ВзятьНаРассмотрениеВидимость = Ложь;
		СогласованоВидимость = (ТекПользователь = Объект.Исполнитель);
	Иначе 
		Если Объект.Исполнители.НайтиСтроки(Новый Структура("Пользователь", ТекПользователь)).Количество() > 0 Тогда 
			ВзятьНаРассмотрениеВидимость = Истина;
		Иначе 
			ВзятьНаРассмотрениеВидимость = Ложь;
		КонецЕсли;		
		СогласованоВидимость = Ложь;
	КонецЕсли;
	
	ТолькоПросмотр = НЕ (СогласованоВидимость ИЛИ ВзятьНаРассмотрениеВидимость);
	
	Элементы.ФормаКнопкаВзятьНаРассмотрение.Видимость 		  = ВзятьНаРассмотрениеВидимость;
	Элементы.ФормаКнопкаВзятьНаРассмотрение.КнопкаПоУмолчанию = ВзятьНаРассмотрениеВидимость;
	Элементы.ФормаКнопкаПеренаправить.Видимость		 		  = ВзятьНаРассмотрениеВидимость;
	Элементы.ФормаКнопкаСогласовано.Видимость				  = СогласованоВидимость;
	Элементы.ФормаКнопкаНеСогласовано.Видимость		  		  = СогласованоВидимость;
	Элементы.ФормаКнопкаЗаписатьИЗакрыть.Видимость			  = СогласованоВидимость;
	
	Элементы.ПолеКомментария.ТолькоПросмотр = НЕ СогласованоВидимость;
	Элементы.ПолеКомментария.Видимость   	= Объект.ВзятоНаРассмотрение ИЛИ Объект.Выполнена;
	Элементы.ПолеКомментария.Заголовок	 	= ?(СогласованоВидимость, НСтр("ru = ""При необходимости укажите Ваши замечания""; en_US = ""Write your comment if necessary"""), НСтр("ru = 'Замечания'; en_US = 'Comment'"));
	
	Элементы.ПолеНовыйИсполнитель.Видимость = Ложь;
	Элементы.ФормаКнопкаOK.Видимость 		= Ложь;
	Элементы.ФормаКнопкаОтмена.Видимость 	= Ложь;
	Элементы.ФормаКнопкаЗакрыть.Видимость	= Истина;
	
	Заголовок = НСтр("ru = ""Поручение ""; en_US = ""Task """) + Объект.Наименование;
	
	ОбновитьНадпись();
	СостоянияПриАктивизацииСтроки(Элементы.Состояния);
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	ОповеститьОЗаписиНового(Объект.Ссылка);
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиЭлементовФормы

&НаКлиенте
Процедура СостоянияПриАктивизацииСтроки(Элемент)
	ТекущаяСтрока = Элемент.ТекущиеДанные;
	Если ТекущаяСтрока <> Неопределено Тогда 
		// Нотификация информационных окон 
		aps_СтруктураПараметровОповещения.Очистить();
		aps_СтруктураПараметровОповещения.Вставить("item", ТекущаяСтрока.ЭлементСсылка);
		
		Оповестить("AppiusWindowGeneralNotify", aps_СтруктураПараметровОповещения, ЭтаФорма);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СостоянияПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ПолеНовыйИсполнительОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Если ВыбранноеЗначение = ПараметрСеанса("ТекущийПользователь") Тогда
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияБПНажатие(Элемент)
	ФормаБП = Объект.БизнесПроцесс.ВедущаяЗадача.БизнесПроцесс.ПолучитьФорму();
	ФормаБП.АктивноеПоручение = Объект.Ссылка;
	ФормаБП.Открыть();
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Согласовано(Команда)
	Если Вопрос(НСтр("en_US='Approve change of item status?';ru='Принять изменение состояния элемента?'"), РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		Объект.Согласовано = Истина;
		Объект.ДатаВыполнения = ТекущаяДата(); // дата выполнения задачи фиксируется в форме
		Записать(Новый Структура("ВыполнитьЗадачу", Истина));
		ПоказатьОповещениеПользователя(НСтр("ru = ""Изменение состояния элемента принято!""; en_US = ""Change of item status is approved!"""));
	Исключение
		Сообщить(ПараметрСеанса("aps_ИмяПродукта")+НСтр("ru = ""Не удалось выполнить задачу по причине:""; en_US = ""Cannot execute the task:""")+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), СтатусСообщения.Внимание);
		Возврат;
	КонецПопытки;
	
	Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура НеСогласовано(Команда)
	Если Вопрос(НСтр("ru = ""Отклонить изменение состояния элемента?""; en_US = ""Refuse the item status change?"""), РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		Объект.Согласовано = Ложь;
		Объект.ДатаВыполнения = ТекущаяДата(); // дата выполнения задачи фиксируется в форме
		Записать(Новый Структура("ВыполнитьЗадачу", Истина));
		ПоказатьОповещениеПользователя(НСтр("ru = ""Изменение состояния элемента отклонено!""; en_US = ""Item status change is refused!"""));
	Исключение
		Сообщить(ПараметрСеанса("aps_ИмяПродукта")+НСтр("ru = ""Не удалось выполнить задачу по причине:""; en_US = ""Cannot execute the task:""")+Символы.ПС+КраткоеПредставлениеОшибки(ИнформацияОбОшибке()), СтатусСообщения.Внимание);
		Возврат;
	КонецПопытки;
	
	Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура ВзятьНаРассмотрение(Команда)
	Если Вопрос(НСтр("ru = ""Время взятия поручения на рассмотрение будет зафиксировано. Взять на рассмотрение?""; en_US = ""Time of taking the task to consideration will be fixed. Begin to consider the task?"""), РежимДиалогаВопрос.ДаНет) = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	Объект.ВзятоНаРассмотрение = Истина;
	Объект.ДатаНачалаВыполнения = ТекущаяДата();
	Объект.Исполнитель = ПараметрСеанса("ТекущийПользователь");
	Записать();
	
	Элементы.ФормаКнопкаВзятьНаРассмотрение.Видимость = Ложь;
	Элементы.ФормаКнопкаСогласовано.Видимость		  = Истина;
	Элементы.ФормаКнопкаНеСогласовано.Видимость		  = Истина;
	
	ПриОткрытии(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ИнформацияОбЭлементе(Команда)
