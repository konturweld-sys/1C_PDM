
#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	СкомпоноватьРезультат();
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиЭлементовФормы

&НаКлиенте
Процедура БыстрыйОтборПриИзменении(Элемент)
	ЭлементыОтбора = Отчет.КомпоновщикНастроек.Настройки.Отбор.Элементы;
	Для Каждого ЭлементОтбора Из ЭлементыОтбора Цикл 
		Если Строка(ЭлементОтбора.ЛевоеЗначение) = "Размер" Тогда 
			ЭлементОтбора.ПравоеЗначение	= РазмерФайла;
			ЭлементОтбора.Использование		= ЗначениеЗаполнено(РазмерФайла);
		ИначеЕсли Строка(ЭлементОтбора.ЛевоеЗначение) = "Владелец" Тогда 
			ЭлементОтбора.ПравоеЗначение	= ВладелецФайла;
			ЭлементОтбора.Использование		= ЗначениеЗаполнено(ВладелецФайла);
		ИначеЕсли Строка(ЭлементОтбора.ЛевоеЗначение) = "ДатаСоздания" И ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.БольшеИлиРавно Тогда 
			ЭлементОтбора.ПравоеЗначение	= СозданНеРанее;
			ЭлементОтбора.Использование		= ЗначениеЗаполнено(СозданНеРанее);
		ИначеЕсли Строка(ЭлементОтбора.ЛевоеЗначение) = "ДатаСоздания" И ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно Тогда 
			ЭлементОтбора.ПравоеЗначение	= СозданНеПозже;
			ЭлементОтбора.Использование		= ЗначениеЗаполнено(СозданНеПозже);
		КонецЕсли;
	КонецЦикла;
	
	СкомпоноватьРезультат();
КонецПроцедуры

#КонецОбласти

