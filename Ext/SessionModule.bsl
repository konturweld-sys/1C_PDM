#Если НЕ МобильноеПриложениеСервер Тогда
	
#Область ОбработчикиСобытий	
	
// Процедура - обработчик события инициализации параметров сеанса
// Параметры:
//		ТребуемыеПараметры - массив устанавливаемых идентификаторов параметров сеанса, которые нужно инициализировать
//
Процедура УстановкаПараметровСеанса(ТребуемыеПараметры)
	apsВыполнитьПриУстановкеПараметровСеанса(ТребуемыеПараметры);
КонецПроцедуры

#КонецОбласти


#Область ПроцедурыИнициализации

// Процедура инициализации параметров сеанса
// Параметры:
//		ТребуемыеПараметры - массив устанавливаемых идентификаторов параметров сеанса, которые нужно инициализировать
// Пример:
//		apsВыполнитьПриУстановкеПараметровСеанса(ТребуемыеПараметры);
//
Процедура apsВыполнитьПриУстановкеПараметровСеанса(ТребуемыеПараметры)
	Если ТребуемыеПараметры = Неопределено Тогда 
		ПараметрыСеанса.aps_ИмяПродукта="PDM: ";
		ПараметрыСеанса.aps_РежимВыгрузкиФайлов=0;
		ПараметрыСеанса.aps_БуферКопирования=Новый ФиксированныйМассив(Новый Массив());
		
		ПараметрыСеанса.aps_НедавниеМестаВыбора=Новый ФиксированныйМассив(Новый Массив());
		// можно отключить проверку уникальности элементов для сеанса
		ПараметрыСеанса.aps_ПроверкаУникальностиВключена=Истина;
		
		Обработки.aps_ПраваДоступа.Создать().aps_ОбновитьПолитикуТекущегоПользователя();
	Иначе 
		Если ТребуемыеПараметры.Найти("ТекущийПользователь") <> Неопределено Тогда 
			ПараметрыСеанса.ТекущийПользователь = Обработки.aps_ПраваДоступа.Создать().aps_ОпределитьТекущегоПользователя(ИмяПользователя(), ПолноеИмяПользователя());
		КонецЕсли;
		// получаем таблицу системных событий
		Если ТребуемыеПараметры.Найти("aps_КэшСобытий") <> Неопределено Тогда 
			ПараметрыСеанса.aps_КэшСобытий=Новый ХранилищеЗначения(aps_ПолучитьСобытия());
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#КонецЕсли