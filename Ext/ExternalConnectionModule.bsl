// Размещает содержимое файла в документе
//
// Параметры:
//		itemXDTOСтрока - строка
//		ПолныйПутьКФайлу - строка
//		CRC - число
//		Невыгружаемый - булево
// Возвращаемое значение:
//		нет
// Пример:
//
Функция aps_extcadРазместитьСодержимое( itemXDTOСтрока, ПолныйПутьКФайлу, CRC, Невыгружаемый ) Экспорт
	Если aps_extcadРазрешенаВозможностьИзменения( itemXDTOСтрока ) Тогда 
		itemXDTO = Строка2XDTO(itemXDTOСтрока);
		ФайлНаДиске=Новый Файл(ПолныйПутьКФайлу);
		
		СтруктураДанныхФайла = Новый Структура;
		СтруктураДанныхФайла.Вставить("ИмяБезРасширения"	, ФайлНаДиске.ИмяБезРасширения);
		СтруктураДанныхФайла.Вставить("ПолноеИмя"			, ФайлНаДиске.ПолноеИмя);
		СтруктураДанныхФайла.Вставить("Расширение"			, ФайлНаДиске.Расширение);
		СтруктураДанныхФайла.Вставить("ДатаМодификации"		, ФайлНаДиске.ПолучитьВремяИзменения());
		СтруктураДанныхФайла.Вставить("ТолькоЧтение"		, ФайлНаДиске.ПолучитьТолькоЧтение());
		СтруктураДанныхФайла.Вставить("Размер"				, ФайлНаДиске.Размер());
		
		СтруктураДанныхФайла.Вставить("АдресДвоичныхДанных"	, ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ПолныйПутьКФайлу)));

		СуществующийФайл=Справочники.aps_Файлы.НайтиПоНаименованию(ФайлНаДиске.Имя, Истина,, itemXDTO.element);
		Если СуществующийФайл.Пустая() Тогда 
			aps_РаботаСФайламиСервер.aps_ИмпортФайла(itemXDTO.element,, СтруктураДанныхФайла, CRC);
		Иначе 
			aps_РаботаСФайламиСервер.aps_ОбновитьСодержимоеФайла(СуществующийФайл, СтруктураДанныхФайла, CRC);
		КонецЕсли;
	КонецЕсли;
КонецФункции

// Добавляет параметр в таблицу параметров (смотрите описание к функции внутри)
//
// Параметры:
//		ТаблицаПараметров
//		ИмяПараметра
//		ЗначениеПараметра
// Возвращаемое значение:
//		ТаблицаЗначений
// Пример:
//
Функция aps_extcadДобавитьКПараметрам( ТаблицаПараметров, ИмяПараметра, ЗначениеПараметра ) Экспорт
	// Условие для Inventor
	Если ТипЗнч(ЗначениеПараметра)=Тип("Число") Или
		 ТипЗнч(ЗначениеПараметра)=Тип("Строка") Тогда
		Возврат aps_Сервер1.aps_cadДобавитьКПараметрам( ТаблицаПараметров, ИмяПараметра, ЗначениеПараметра );
	Иначе
		Возврат aps_Сервер1.aps_cadДобавитьКПараметрам( ТаблицаПараметров, ИмяПараметра, "" );
	КонецЕсли;
КонецФункции

// Создает изделие (смотрите описание к функции внутри)
//
// Параметры:
//		ТипИзделия - число
//		ТаблицаПараметров - ТаблицаЗначений
//		НайденСуществующий - булево (необязательный)
//		elementTypeID - число (необязательный)
// Возвращаемое значение:
//		Строка XDTO
