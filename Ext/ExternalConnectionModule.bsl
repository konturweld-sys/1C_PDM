КонецФункции

// Функция преобразует XML-ссылку в XDTO-строку
//
// Параметры:
//		itemXDTO 
// Возвращаемое значение:
// 		XML
// Пример:
//
Функция aps_extcadObject2XDTO ( xmlObject )  Экспорт
	itemXDTO = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("http://appius.ru/pdm", "item"));
	itemXDTO.element = СериализаторXDTO.ЗаписатьXDTO(Строка2Object1С( xmlObject ));
    Возврат XDTO2Строка( itemXDTO );
КонецФункции

// Функция осуществляет поиск активных документов
//
// Параметры:
//		ТипCAD, ТипАктивногоДокумента - число, СтрокаПоиска - строка
// Возвращаемое значение:
// 		Массив XDTO
// Пример:
//
Функция aps_extcadНайтиАктивныеДокументы( ТипCAD, ТипАктивногоДокумента=0, СтрокаПоиска ) Экспорт
	СтруктураУсловий = Новый Структура();
	СтруктураУсловий.Вставить("СтрокаПоиска", СтрокаПоиска);
	
	Если ТипCAD=1 Тогда 
		Если ТипАктивногоДокумента=1 Тогда
			СтруктураУсловий.Вставить("ВидЭлемента", Справочники.aps_ВидыЭлементов.АктивныйДокументЧертежSolidWorks);
		ИначеЕсли ТипАктивногоДокумента=2 Тогда 
			СтруктураУсловий.Вставить("ВидЭлемента", Справочники.aps_ВидыЭлементов.АктивныйДокументСборкаSolidWorks);
		ИначеЕсли ТипАктивногоДокумента=3 Тогда 
			СтруктураУсловий.Вставить("ВидЭлемента", Справочники.aps_ВидыЭлементов.АктивныйДокументДетальSolidWorks);
		ИначеЕсли ТипАктивногоДокумента=0 Тогда 
			МассивВидов=Новый Массив();
			МассивВидов.Добавить(Справочники.aps_ВидыЭлементов.АктивныйДокументЧертежSolidWorks);
			МассивВидов.Добавить(Справочники.aps_ВидыЭлементов.АктивныйДокументСборкаSolidWorks);
			МассивВидов.Добавить(Справочники.aps_ВидыЭлементов.АктивныйДокументДетальSolidWorks);
			СтруктураУсловий.Вставить("ВидЭлемента", МассивВидов);
		КонецЕсли;
	ИначеЕсли ТипCAD=2 Тогда 
		Если ТипАктивногоДокумента=1 Тогда
			СтруктураУсловий.Вставить("ВидЭлемента", Справочники.aps_ВидыЭлементов.АктивныйДокументЧертежКОМПАС);
		ИначеЕсли ТипАктивногоДокумента=2 Тогда 
			СтруктураУсловий.Вставить("ВидЭлемента", Справочники.aps_ВидыЭлементов.АктивныйДокументСборкаКОМПАС);
		ИначеЕсли ТипАктивногоДокумента=3 Тогда 
			СтруктураУсловий.Вставить("ВидЭлемента", Справочники.aps_ВидыЭлементов.АктивныйДокументДетальКОМПАС);
		ИначеЕсли ТипАктивногоДокумента=0 Тогда 
			МассивВидов=Новый Массив();
			МассивВидов.Добавить(Справочники.aps_ВидыЭлементов.АктивныйДокументЧертежКОМПАС);
			МассивВидов.Добавить(Справочники.aps_ВидыЭлементов.АктивныйДокументСборкаКОМПАС);
			МассивВидов.Добавить(Справочники.aps_ВидыЭлементов.АктивныйДокументДетальКОМПАС);
			СтруктураУсловий.Вставить("ВидЭлемента", МассивВидов);
		КонецЕсли;
	ИначеЕсли ТипCAD=3 Тогда 
		Если ТипАктивногоДокумента=1 Тогда
			СтруктураУсловий.Вставить("ВидЭлемента", Справочники.aps_ВидыЭлементов.АктивныйДокументЧертежAutoCAD);
		ИначеЕсли ТипАктивногоДокумента=2 Тогда 
			СтруктураУсловий.Вставить("ВидЭлемента", Справочники.aps_ВидыЭлементов.АктивныйДокументСборкаAutoCAD);
		ИначеЕсли ТипАктивногоДокумента=3 Тогда 
			СтруктураУсловий.Вставить("ВидЭлемента", Справочники.aps_ВидыЭлементов.АктивныйДокументДетальAutoCAD);
		ИначеЕсли ТипАктивногоДокумента=0 Тогда 
			МассивВидов=Новый Массив();
			МассивВидов.Добавить(Справочники.aps_ВидыЭлементов.АктивныйДокументЧертежAutoCAD);
			МассивВидов.Добавить(Справочники.aps_ВидыЭлементов.АктивныйДокументСборкаAutoCAD);
			МассивВидов.Добавить(Справочники.aps_ВидыЭлементов.АктивныйДокументДетальAutoCAD);
			СтруктураУсловий.Вставить("ВидЭлемента", МассивВидов);
		КонецЕсли;
	ИначеЕсли ТипCAD=4 Тогда 
		Если ТипАктивногоДокумента=1 Тогда
			СтруктураУсловий.Вставить("ВидЭлемента", Справочники.aps_ВидыЭлементов.АктивныйДокументЧертежInventor);
		ИначеЕсли ТипАктивногоДокумента=2 Тогда 
			СтруктураУсловий.Вставить("ВидЭлемента", Справочники.aps_ВидыЭлементов.АктивныйДокументСборкаInventor);
		ИначеЕсли ТипАктивногоДокумента=3 Тогда 
			СтруктураУсловий.Вставить("ВидЭлемента", Справочники.aps_ВидыЭлементов.АктивныйДокументДетальInventor);
		ИначеЕсли ТипАктивногоДокумента=0 Тогда 
			МассивВидов=Новый Массив();
			МассивВидов.Добавить(Справочники.aps_ВидыЭлементов.АктивныйДокументЧертежInventor);
			МассивВидов.Добавить(Справочники.aps_ВидыЭлементов.АктивныйДокументСборкаInventor);
			МассивВидов.Добавить(Справочники.aps_ВидыЭлементов.АктивныйДокументДетальInventor);
			СтруктураУсловий.Вставить("ВидЭлемента", МассивВидов);
		КонецЕсли;
	ИначеЕсли ТипCAD=5 Тогда 
		Если ТипАктивногоДокумента=1 Тогда
			СтруктураУсловий.Вставить("ВидЭлемента", Справочники.aps_ВидыЭлементов.АктивныйДокументЧертежSolidEdge);
		ИначеЕсли ТипАктивногоДокумента=2 Тогда 
			СтруктураУсловий.Вставить("ВидЭлемента", Справочники.aps_ВидыЭлементов.АктивныйДокументСборкаSolidEdge);
		ИначеЕсли ТипАктивногоДокумента=3 Тогда 
			СтруктураУсловий.Вставить("ВидЭлемента", Справочники.aps_ВидыЭлементов.АктивныйДокументДетальSolidEdge);
		ИначеЕсли ТипАктивногоДокумента=0 Тогда 
			МассивВидов=Новый Массив();
			МассивВидов.Добавить(Справочники.aps_ВидыЭлементов.АктивныйДокументЧертежSolidEdge);
			МассивВидов.Добавить(Справочники.aps_ВидыЭлементов.АктивныйДокументСборкаSolidEdge);
			МассивВидов.Добавить(Справочники.aps_ВидыЭлементов.АктивныйДокументДетальSolidEdge);
			СтруктураУсловий.Вставить("ВидЭлемента", МассивВидов);
		КонецЕсли;
	Иначе 
		// остальные CAD
	КонецЕсли;
	
	МассивXDTO = Новый Массив();
	Если СтруктураУсловий.Свойство("ВидЭлемента") Тогда 
		Результат = Обработки.aps_Поиск.Создать().aps_Поиск(СтруктураУсловий);
		
		Для i = 0 По Результат.Количество() - 1 Цикл
			itemXDTO = ФабрикаXDTO.Создать(ФабрикаXDTO.Тип("http://appius.ru/pdm", "item"));
			itemXDTO.pictureIndex	= Результат[i].Картинка;
			itemXDTO.description	= Результат[i].ПредставлениеЭлемента;
			itemXDTO.element		= СериализаторXDTO.ЗаписатьXDTO(Результат[i].ЭлементСсылка);
			
			МассивXDTO.Добавить(itemXDTO);
		КонецЦикла;
	КонецЕсли;
	
	Возврат МассивXDTO;
КонецФункции

// Функция выгружает файлы на диск (не используется с 2.0.2.1)
//
// Параметры:
//		activeDocXDTOСтрока, ПапкаДляВыгрузкиИлиФайл, ПравилоУправления (необязательный)
// Возвращаемое значение:
//		Строка
// Пример:
//
Функция aps_extcadВыгрузитьФайлИзPDM( activeDocXDTOСтрока, ПапкаДляВыгрузкиИлиФайл, ПравилоУправления=Неопределено ) Экспорт
	ФайлыДляВыгрузки=aps_extcadПолучитьЗависимыеФайлы(activeDocXDTOСтрока, ПравилоУправления);
	Возврат aps_extcadВыгрузитьФайлы(activeDocXDTOСтрока, ПапкаДляВыгрузкиИлиФайл, ФайлыДляВыгрузки);
КонецФункции

