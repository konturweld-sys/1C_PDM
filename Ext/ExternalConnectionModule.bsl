// Добавление предварительного просмотра
//
// Параметры:
//		itemXDTOСтрока - строка
//		ФайлИзображения - строка - путь к файлу изображения
// Возвращаемое значение:
//		Булево
// Пример:
//
Функция aps_extcadДобавитьPreview( itemXDTOСтрока, ФайлИзображения ) Экспорт
	
	ФайлКартинка=Новый файл(ФайлИзображения);
	Если НЕ ФайлКартинка.Существует() Тогда
		Возврат Ложь;
	КонецЕсли;	
	item = Строка2XDTO(itemXDTOСтрока).element;
	itemObject=item.Получитьобъект();
	itemObject.ОсновноеИзображение=Новый ХранилищеЗначения( Новый Картинка(ФайлИзображения) );
	Попытка
		itemObject.Записать();
	Исключение
		ВызватьИсключение КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	Возврат Истина;
КонецФункции

// Выгрузка изображения предварительного просмотра в файл
//
// Параметры:
//		itemXDTOСтрока - строка
//		ПутьИФайлВыгрузки - строка - путь к файлу изображения
// Возвращаемое значение:
//		Картинка
// Пример:
//
Функция aps_extcadВыгрузитьPreview( itemXDTOСтрока, ПутьИФайлВыгрузки ) Экспорт
	item = Строка2XDTO(itemXDTOСтрока).element;
	Картинка=item.ОсновноеИзображение.Получить();
	
	Возврат Картинка;
	Если Картинка.ВидКартинки<>ВидКартинки.Пустая Тогда
	
		Если Картинка.Формат=ФорматКартинки.BMP Тогда
			ПутьИФайлВыгрузки=ПутьИФайлВыгрузки+".bmp";
		ИначеЕсли Картинка.Формат=ФорматКартинки.GIF Тогда
			ПутьИФайлВыгрузки=ПутьИФайлВыгрузки+".gif";
		ИначеЕсли Картинка.Формат=ФорматКартинки.PNG Тогда
			ПутьИФайлВыгрузки=ПутьИФайлВыгрузки+".png";
		ИначеЕсли Картинка.Формат=ФорматКартинки.JPEG Тогда
			ПутьИФайлВыгрузки=ПутьИФайлВыгрузки+".jpg";
		ИначеЕсли Картинка.Формат=ФорматКартинки.EMF Тогда
			ПутьИФайлВыгрузки=ПутьИФайлВыгрузки+".emf";
		ИначеЕсли Картинка.Формат=ФорматКартинки.WMF Тогда
			ПутьИФайлВыгрузки=ПутьИФайлВыгрузки+".wmf";
		КонецЕсли;
	
	КонецЕсли;
	Картинка.Записать(ПутьИФайлВыгрузки);
КонецФункции


