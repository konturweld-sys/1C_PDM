//
// Параметры:
//		activeDocXDTOСтрока - строка
//		ПравилоУправления - СправочникСсылка.aps_ПравилаУправления
// Возвращаемое значение:
//      ТаблицаЗначений
// Пример:
//
Функция aps_extcadПолучитьЗависимыеФайлы( activeDocXDTOСтрока, ПравилоУправления=Неопределено ) Экспорт 
	Возврат aps_Сервер1.aps_cadПолучитьЗависимыеФайлы( activeDocXDTOСтрока, ПравилоУправления );
КонецФункции

// Функция выгружает файлы в папку
//
// Параметры:
//		ВыгружаемыеФайлы - массив, возвращаемый функцией aps_extcadПолучитьЗависимыеФайлы
// Возвращаемое значение:
//		Строка
// Пример:
//
Функция aps_extcadВыгрузитьФайлы( activeDocXDTOСтрока, ПапкаДляВыгрузки, ВыгружаемыеФайлы ) Экспорт 
	АктивныйДокумент=Строка2XDTO(activeDocXDTOСтрока).element;
	
	ПутьКФайлуДляОткрытия="";
	
	Для i=0 По ВыгружаемыеФайлы.Количество()-1 Цикл 
		СтруктураДанныхФайла=aps_РаботаСФайламиСервер.aps_ПодготовитьСтруктуруДанныхФайлаПоСсылке(ВыгружаемыеФайлы[i].Ссылка);
		
		ПолныйПуть=aps_РаботаСФайлами.aps_ДобавитьПоследнийСлэш(ПапкаДляВыгрузки)+СтруктураДанныхФайла.Имя;
		СтруктураДанныхФайла.ДвоичныеДанные.Записать(ПолныйПуть);
		
		ВыгруженныйФайл=Новый Файл(ПолныйПуть);
		ВыгруженныйФайл.УстановитьВремяИзменения(СтруктураДанныхФайла.ДатаМодификации);
		ВыгруженныйФайл.УстановитьТолькоЧтение(Ложь);

		Если ПустаяСтрока(ПутьКФайлуДляОткрытия) И ВыгружаемыеФайлы[i].Документ=АктивныйДокумент Тогда 
			ПутьКФайлуДляОткрытия=ПолныйПуть;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ПутьКФайлуДляОткрытия;
КонецФункции

// Получает имя и расширение файла, прикрепленного к документу (файл должен быть один)
//
// Параметры:
//      activeDocXDTOСтрока
// Возвращаемое значение:
//		Строка - имя файла
// Пример:
//
Функция aps_extcadПолучитьИмяСРасширениемАктДокумента( activeDocXDTOСтрока ) Экспорт
	АктивныйДокумент = Строка2XDTO(activeDocXDTOСтрока).element;
	ФайлыДокумента=aps_РаботаСФайламиСервер.aps_ПолучитьФайлыДокумента(АктивныйДокумент);
	Если ФайлыДокумента.Количество()>0 Тогда 
		Возврат ФайлыДокумента[0].Наименование;
	Иначе 
		Возврат "";
	КонецЕсли;	
КонецФункции

// Определяет является ли файл документа невыгружаемым
//		
// Параметры:
//		activeDocXDTOСтрока
// Возвращаемое значение:
//		Булево
// Пример:
//
Функция aps_extcadФайлНеВыгружаемый( activeDocXDTOСтрока ) Экспорт
	АктивныйДокумент = Строка2XDTO(activeDocXDTOСтрока).element;
	ФайлыДокумента=aps_РаботаСФайламиСервер.aps_ПолучитьФайлыДокумента(АктивныйДокумент);
	Если ФайлыДокумента.Количество()>0 Тогда 
		Возврат ФайлыДокумента[0].Невыгружаемый;
	Иначе 
		Возврат Ложь;
	КонецЕсли;	
КонецФункции

