// Функция возвращает отсутствующие в хранилище двоичных данных CRC-коды
//
// Параметры:
//		COMSafeArray - исходный массив CRC-кодов для проверки
// Возвращаемое значение:
//		COMSafeArray
// Пример:
//
Функция aps_extcadПолучитьНовыеCRC( COMSafeArrayCRC ) Экспорт
	// исходный массив CRC
	МассивCRC = COMSafeArrayCRC.Выгрузить();
	
	ТаблицаCRC = Новый ТаблицаЗначений();
	ТаблицаCRC.Колонки.Добавить("CRC", Новый ОписаниеТипов("Число"));
	Для i=0 По МассивCRC.Количество()-1 Цикл 
		ТаблицаCRC.Добавить().CRC = МассивCRC[i];
	КонецЦикла;
	
	МенеджерВТ=Новый МенеджерВременныхТаблиц;
	
	Запрос=Новый Запрос;
	Запрос.МенеджерВременныхТаблиц=МенеджерВТ;
	// Текст запроса для построения временной таблицы
	Запрос.Текст="ВЫБРАТЬ
	             |	ТаблицаCRC.CRC КАК CRC
	             |ПОМЕСТИТЬ ВремТаблицаCRC
	             |ИЗ
	             |	&Данные КАК ТаблицаCRC";
	Запрос.УстановитьПараметр("Данные",ТаблицаCRC);
	Запрос.Выполнить();
	
	// Получаем таблицу из менеджера временных таблиц запроса
	Запрос.Текст="ВЫБРАТЬ
	             |	ВремТаблицаCRC.CRC
	             |ИЗ
	             |	ВремТаблицаCRC КАК ВремТаблицаCRC
	             |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.aps_ДвоичныеДанные КАК aps_ДвоичныеДанные
	             |		ПО ВремТаблицаCRC.CRC = aps_ДвоичныеДанные.CRC
	             |			И (НЕ aps_ДвоичныеДанные.ПометкаУдаления)
	             |ГДЕ
	             |	aps_ДвоичныеДанные.CRC ЕСТЬ NULL ";
	// массив CRC, отсутствующих в базе
	МассивCRC = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку(0);
	Если МассивCRC.Количество()>0 Тогда
		Возврат Новый COMSafeArray(МассивCRC, "VT_UI4");
	Иначе
		Возврат Новый COMSafeArray("VT_UI4",0);
	КонецЕсли;
КонецФункции


// Функция выбирает материал из Инженерного справочника (ИС не ниже 2.6.2)
// Параметры:
//		ИмяSLDMAT - строка
// Возвращаемое значение:
//		Строка
// Пример:
//
Функция aps_extcadВыбратьМатериал( ИмяSLDMAT ) Экспорт 
	СтрокаСоединения = Константы.aps_СтрокаСоединенияИС.Получить();
	Если ПустаяСтрока(СтрокаСоединения) Тогда 
		ВызватьИсключение "Параметры подключения к Инженерному справочнику не заданы! Запустите 1C:PDM и осуществите настройку.";
	КонецЕсли;

	V82c_Application = Новый COMОбъект("V82c.Application"); 
	 
	СоединениеУстановлено = V82c_Application.Connect( СтрокаСоединения );
	Если Не СоединениеУстановлено Тогда 
		Возврат "";
	КонецЕсли;
	
	V82c_Application.Visible = Ложь;
	
	
	
	ПараметрыФормы = V82c_Application.NewObject("Структура");
	ПараметрыФормы.Вставить("ОткрытьПрименяемость"	, Истина);
	ПараметрыФормы.Вставить("РежимВыбора"			, Истина);
	ПараметрыФормы.Вставить("ОдиночныйВыбор"		, Истина);
	ПараметрыФормы.Вставить("ВыбиратьXDTO"			, Истина);
	ПараметрыФормы.Вставить("ВнешнееСоединение"		, Истина);
	
	МассивДоступныхВидов = V82c_Application.NewObject("СписокЗначений");
	МассивДоступныхВидов.Добавить(Object1С2Строка(Справочники.aps_ВидыЭлементов.Материал));
	ПараметрыФормы.Вставить("ДоступныеВидыЭлементов", МассивДоступныхВидов);
	
	ФормаПроводника = V82c_Application.ПолучитьФорму("Обработка.aps_Проводник.Форма", ПараметрыФормы);
	
	
	
	МассивВыбораCOM = ФормаПроводника.ОткрытьМодально();
	
	
	ДокументXML=Новый ТекстовыйДокумент();
	ДокументXML.УстановитьТекст(ФормаПроводника.aps_ПолучитьСтрокуSLDMAT());
	ДокументXML.Записать( ИмяSLDMAT );

	
	Если ТипЗнч(МассивВыбораCOM)<>Тип("Строка") Тогда 
		Возврат "";
	Иначе
		Возврат МассивВыбораCOM;
	КонецЕсли;
КонецФункции

Функция aps_extcadSWПроверитьНаличиеТестовогоЭлементаКТС() Экспорт

    Результат = "";

    Попытка

        СсылкаТест =
            Справочники.aps_ЭлементыСправочников.НайтиПоНаименованию(
                "__SW_KTS_DIAGNOSTIC_ROLLBACK__",
                Истина);

        Если ЗначениеЗаполнено(СсылкаТест) Тогда
            Результат = Результат
                + "DIAGNOSTIC_NAME=FOUND"
                + Символы.ПС
                + "DIAGNOSTIC_REF="
                + Строка(СсылкаТест);
        Иначе
            Результат = Результат + "DIAGNOSTIC_NAME=NOT_FOUND";
        КонецЕсли;

    Исключение

        Результат = Результат
            + "DIAGNOSTIC_SEARCH_ERROR="
            + ОписаниеОшибки();

    КонецПопытки;

    Результат = Результат + Символы.ПС;

    Попытка

        СсылкаКТС =
            Справочники.aps_ЭлементыСправочников.НайтиПоНаименованию(
                "Болт M6x ГОСТ 7798-70",
                Истина);

        Если ЗначениеЗаполнено(СсылкаКТС) Тогда
            Результат = Результат
                + "KTS_NAME=FOUND"
                + Символы.ПС
                + "KTS_REF="
                + Строка(СсылкаКТС);
        Иначе
            Результат = Результат + "KTS_NAME=NOT_FOUND";
        КонецЕсли;

    Исключение

        Результат = Результат
            + "KTS_SEARCH_ERROR="
            + ОписаниеОшибки();

    КонецПопытки;

    Возврат Результат;

КонецФункции

