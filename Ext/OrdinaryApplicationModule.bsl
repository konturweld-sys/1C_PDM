#Область ОписаниеПеременных

Перем АдресРесурсовОбозревателя Экспорт; // Адрес интернет-ресурса конфигурации 1C:PDM

Перем aps_СтруктураПараметровОповещения Экспорт; // Описание структуры параметров событий/оповещений 1C:PDM
// "item" item - ссылка на текущий элемент PDM
// "itemXDTO" itemXDTO - XDTO объект текущего элемента
// "itemObject" itemObject - объект item или объект элементной связи (может быть НЕОПРЕДЕЛЕНО)
// 				   itemObject чаще всего приходит в событие ПриСозданииЭлемента когда объект еще не создан и требуется назначить политику
// "parameter" - ссылка на параметр (может быть НЕОПРЕДЕЛЕНО)
// "parameterObject" - объект параметра (может быть НЕОПРЕДЕЛЕНО)
// "ФормаИсточник" - Форма обработки, которая сформировала структуру параметров (может быть НЕОПРЕДЕЛЕНО)

#КонецОбласти


#Область ОбработчикиСобытий

// Процедура возникает перед завершением работы в режиме ОбычноеПриложение до закрытия главного окна
// Параметры:
//		Отказ - Булево, признак отказа от выхода из программы
Процедура ПередЗавершениемРаботыСистемы(Отказ)
	Если ВопросПользователюПередЗавершениемРаботыСистемы(Отказ) Тогда
		Возврат;
	КонецЕсли;
	
	apsВыполнитьПередЗавершением1С(Отказ);

КонецПроцедуры

// Процедура возникает перед завершением работы
// Параметры:
//		Нет
Процедура ПриЗавершенииРаботыСистемы()
	МенеджерОбъектовСЛК.Стоп();
КонецПроцедуры

// Процедура возникает при запуске в режиме 1С:Предприятие после открытия главного окна
// Параметры:
//		Нет
Процедура ПриНачалеРаботыСистемы()
	aps_СтруктураПараметровОповещения = Новый Структура();
	
	apsВыполнитьПриСтарте1С();
	
	АдресРесурсовОбозревателя = "PDM";
	
	Если Найти(Врег(СтрокаСоединенияИнформационнойБазы()), "FILE=") = 1 Тогда 
		ПользовательДляВыполненияРеглЗаданий = Константы.ПользовательДляВыполненияРегламентныхЗаданийВФайловомВарианте.Получить();
		Если ПараметрыСеанса.ТекущийПользователь = ПользовательДляВыполненияРеглЗаданий Тогда
			// с интервалом секунд вызываем процедуру работы с регламентными заданиями
			ПоддержкаРегламентныхЗаданийДляФайловойВерсии();
			
			ИнтервалДляОпроса = Константы.ИнтервалДляОпросаРегламентныхЗаданийВФайловомВарианте.Получить();
			
			Если ИнтервалДляОпроса = Неопределено
				ИЛИ ИнтервалДляОпроса = 0 Тогда
				
				ИнтервалДляОпроса = 60;	
			КонецЕсли;
			
			ПодключитьОбработчикОжидания("ПоддержкаРегламентныхЗаданийДляФайловойВерсии", ИнтервалДляОпроса);
		КонецЕсли;
	КонецЕсли;
	

КонецПроцедуры

#КонецОбласти


#Область ПрограммныйИнтерфейс

// Процедура служит для поддержки работы регламентных заданий в файловой версии
// Параметры:
//		нет
// Пример:
//		ПоддержкаРегламентныхЗаданийДляФайловойВерсии();
//
Процедура ПоддержкаРегламентныхЗаданийДляФайловойВерсии() Экспорт
	
	ВыполнитьОбработкуЗаданий();
	
КонецПроцедуры

#КонецОбласти

